class MeshError(Exception):
    """A user-facing failure: printed without a traceback, exit status 1."""


class PaneRefused(MeshError):
    """This session isn't the agent its pane maps to: it gets this error, never a run of its own."""


class SwapNotStarted(MeshError):
    """A model swap that stopped before touching the worker: it still runs, on its old model."""


class HerdrError(MeshError):
    def __init__(self, code: str, message: str):
        super().__init__(f"herdr {code}: {message}")
        self.code = code
        self.message = message


# ── paths ────────────────────────────────────────────────────────────────


def mesh_home() -> Path:
    return Path(os.environ.get("MESH_HOME") or Path.home() / ".local/state/agent-mesh")


def worktree_root() -> Path:
    return Path(os.environ.get("MESH_WORKTREES") or Path.home() / ".local/share/agent-mesh/worktrees")


def run_dir(run_id: str) -> Path:
    return mesh_home() / run_id


def inbox_dir(run_id: str, name: str) -> Path:
    return run_dir(run_id) / "inbox" / name


def pane_key(pane_id: str) -> str:
    return pane_id.replace(":", "_")


# ── subprocess helpers ───────────────────────────────────────────────────


def herdr(*args: str, timeout: float | None = None) -> dict:
    """Run a herdr CLI command and return its JSON `result`."""
    binary = os.environ.get("MESH_HERDR") or "herdr"
    try:
        proc = subprocess.run([binary, *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        raise HerdrError("timeout", f"{' '.join(args[:2])} timed out") from exc
    except FileNotFoundError as exc:
        raise MeshError(f"herdr not found ({binary}); mesh must run inside herdr") from exc
    if proc.returncode != 0:
        raw = (proc.stderr or proc.stdout).strip()
        try:
            err = json.loads(raw)["error"]
            raise HerdrError(err.get("code", "error"), err.get("message", ""))
        except (ValueError, KeyError, TypeError):
            raise HerdrError("cli_error", raw) from None
    out = proc.stdout.strip()
    return json.loads(out).get("result", {}) if out else {}


def git(*args: str, cwd: str | Path) -> str:
    proc = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if proc.returncode != 0:
        raise MeshError(f"git {' '.join(args)}: {proc.stderr.strip()}")
    return proc.stdout.strip()


def run_cli(argv: list[str], cwd: str | Path | None = None, env: dict[str, str] | None = None,
            timeout: float | None = 120, input: str | None = None,
            started: Callable[[int], None] | None = None) -> subprocess.CompletedProcess:
    """Run an agent CLI (`claude`, `agy`, `copilot`) to completion; one that can't start or times out is a failed run.

    With `started`, the CLI runs in a session of its own and `started` gets its pid once it runs, for the
    caller to record: a caller killed outright leaves it running, and then the record is what shows it busy.
    A timeout or an exception here (Ctrl-C, or a signal signals_raise turned into one) kills its whole
    process group, tools it started included.
    """
    try:
        proc = subprocess.Popen(argv, cwd=cwd, env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                stdin=subprocess.PIPE if input is not None else None,
                                start_new_session=started is not None)
    except FileNotFoundError:
        return subprocess.CompletedProcess(argv, 127, "", f"{argv[0]} not found")
    except OSError as exc:  # e.g. an argument over the kernel's per-argument limit
        return subprocess.CompletedProcess(argv, 126, "", f"{argv[0]} could not start: {exc}")

    def kill() -> None:
        try:
            os.killpg(proc.pid, signal.SIGKILL) if started else proc.kill()
        except OSError:
            pass  # gone already
        # Not communicate(): a grandchild outside the group (or any, without `started`) may still hold
        # the pipes, and reading them to EOF would wait for it (as subprocess.run does).
        proc.wait()
        for pipe in (proc.stdin, proc.stdout, proc.stderr):
            if pipe:
                try:
                    pipe.close()
                except OSError:
                    pass

    try:
        if started:
            started(proc.pid)
        out, err = proc.communicate(input, timeout=timeout)
    except subprocess.TimeoutExpired:
        kill()
        return subprocess.CompletedProcess(argv, 124, "", f"{argv[0]} timed out after {timeout:.0f}s")
    except BaseException:
        kill()
        raise
    return subprocess.CompletedProcess(argv, proc.returncode, out, err)


def claude_bin() -> str:
    return os.environ.get("MESH_CLAUDE") or "claude"


def claude_agents() -> list[dict]:
    """Claude Code's own session list (`claude agents --json --all`): background sessions carry a `status`
    (busy / idle / waiting) while their process runs, and keep their entry after they exit."""
    proc = run_cli([claude_bin(), "agents", "--json", "--all"], env=claude_env(), timeout=30)
    try:
        rows = json.loads(proc.stdout) if proc.returncode == 0 else []
    except ValueError:
        return []
    return rows if isinstance(rows, list) else []


def parent_pid(pid: int) -> int:
    try:
        return int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def agent_processes() -> list[dict]:
    """Every running `claude` / `agy` process this user can see ({pid, argv, cwd}), from /proc ([] without it),
    leaving out this command's own ancestors (the agent that runs it isn't some worker's holder)."""
    proc = Path("/proc")
    if not proc.is_dir():
        return []
    mine, pid = set(), os.getpid()
    while pid > 1 and pid not in mine:
        mine.add(pid)
        pid = parent_pid(pid)
    found = []
    for folder in proc.iterdir():
        if not folder.name.isdigit() or int(folder.name) in mine:
            continue
        try:
            argv = (folder / "cmdline").read_bytes().decode(errors="replace").split("\0")
            if not agent_binary(argv):
                continue
            found.append({"pid": int(folder.name), "argv": [a for a in argv if a], "cwd": os.readlink(folder / "cwd")})
        except OSError:
            continue  # exited as we looked, or not ours
    return found


def socket_address(pid: int | None) -> str | None:
    """The cross-session address (`uds:…/cc-socks/<pid>.sock`) of a running Claude Code process, if it has one."""
    if not pid:
        return None
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    sock = Path(os.environ.get("MESH_CC_SOCKS") or Path(runtime) / "cc-socks") / f"{pid}.sock"
    return f"uds:{sock}" if sock.exists() else None


def claude_pid() -> int | None:
    """The pid of the Claude Code process this command runs under, which Claude Code gives its tools."""
    try:
        return int(os.environ.get("CLAUDE_PID") or 0) or None
    except ValueError:
        return None


def claude_address() -> str | None:
    """The cross-session address of the Claude Code session this command runs under.

    Session names change as Claude retitles a conversation, so other sessions reach it by this socket, which
    belongs to the process. That's `CLAUDE_PID`'s; without it, the first socket up the process tree, where a
    stale one left at a reused pid could come first. None outside Claude Code (an agy root) or where /proc
    can't be walked.
    """
    if pid := claude_pid():
        return socket_address(pid)
    pid = os.getpid()
    for _ in range(16):
        if pid <= 1:
            break
        if address := socket_address(pid):
            return address
        pid = parent_pid(pid)
    return None


def address_alive(address: str | None) -> bool:
    return bool(address) and (not address.startswith("uds:") or Path(address[4:]).exists())


# ── run state ────────────────────────────────────────────────────────────


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


@contextmanager
def file_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def run_lock(run_id: str):
    return file_lock(run_dir(run_id) / ".lock")


def load_run(run_id: str) -> dict:
    path = run_dir(run_id) / "run.json"
    if not path.exists():
        raise MeshError(f"unknown run {run_id} (no {path})")
    return json.loads(path.read_text())


def save_run(run_id: str, data: dict) -> None:
    write_atomic(run_dir(run_id) / "run.json", json.dumps(data, indent=2) + "\n")


@contextmanager
def editing_run(run_id: str):
    """Load run.json under the run lock, yield it for changes, save it."""
    with run_lock(run_id):
        data = load_run(run_id)
        yield data
        save_run(run_id, data)


def log_event(run_id: str, event: str, **fields) -> None:
    line = json.dumps({"time": now_iso(), "event": event, **fields}) + "\n"
    fd = os.open(run_dir(run_id) / "log.jsonl", os.O_RDWR | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        # A write cut short (a kill, a full disk) leaves a line with no newline: end it first, or this event
        # is glued onto the fragment and lost with it. Two writers sealing at once leave an empty line.
        size = os.fstat(fd).st_size
        if size and os.pread(fd, 1, size - 1) != b"\n":
            line = "\n" + line
        os.write(fd, line.encode())
    finally:
        os.close(fd)


TORN_WARNED: set[str] = set()  # log files whose unreadable lines were reported, once per process


def parse_log_lines(lines: list[str], path: Path, first: int = 1) -> list[dict]:
    """The events in `lines` (line `first` onwards of `path`), skipping any that don't parse: one torn line
    must not break every reader. The first time a file has some, a warning says so on stderr."""
    events, bad = [], []
    for number, line in enumerate(lines, first):
        if not line.strip():
            continue
        try:
            event = json.loads(line)
        except ValueError:
            event = None
        if isinstance(event, dict):
            events.append(event)
        else:
            bad.append(number)
    if bad and str(path) not in TORN_WARNED:
        TORN_WARNED.add(str(path))
        print(f"mesh: skipped {len(bad)} unreadable line(s) in {path} (line {bad[0]}: a write cut short?)",
              file=sys.stderr)
    return events


def read_log(run_id: str) -> list[dict]:
    path = run_dir(run_id) / "log.jsonl"
    if not path.exists():
        return []
    return parse_log_lines(path.read_text().splitlines(), path)


# ── identity ─────────────────────────────────────────────────────────────


def identity(args: argparse.Namespace) -> tuple[str, str]:
    """Return (run_id, own agent name) from flags, the environment or the pane map."""
    flag_run, flag_name = getattr(args, "run", None), getattr(args, "as_", None)
    run_id = flag_run or os.environ.get("MESH_RUN")
    name = flag_name or os.environ.get("MESH_SELF")
    run, ignored, refused = None, None, False
    if run_id and name and not flag_name:  # a name you pass is taken as given
        run = maybe_run(run_id)
        if ignored := inherited_identity(run_id, name, run):
            run_id, name, run = None, None, None
    if not (run_id and name):
        pane = os.environ.get("HERDR_PANE_ID")
        mapping = mesh_home() / "by-pane" / f"{pane_key(pane)}.json" if pane else None
        if mapping and mapping.exists():
            entry = json.loads(mapping.read_text())
            if foreign := foreign_to_pane(entry["run"], entry["name"], pane):
                ignored, refused = f"{ignored}; {foreign}" if ignored else foreign, True
            elif ignored:  # this pane's identity, all of it, or none
                if flag_run and flag_run != entry["run"]:
                    raise MeshError(f"{ignored}; this pane is {entry['name']} of run {entry['run']}, "
                                    f"not of run {flag_run}")
                run_id, name = entry["run"], entry["name"]
                print(f"mesh: {ignored}; acting as {name}, this pane's agent", file=sys.stderr)
                log_event(run_id, "identity_ignored", name=name, reason=ignored)
            else:
                run_id = run_id or entry["run"]
                name = name or entry["name"]
    if not (run_id and name):
        error = PaneRefused if refused else MeshError
        raise error(f"not in a mesh run{f' ({ignored})' if ignored else ''}: run `mesh init` first, or pass "
                    "--run and --as (`mesh agents` lists past and present workers, `mesh status --run <id>` "
                    "shows a run's agents)")
    refresh_root_address(run_id, name, run)
    return run_id, name


def maybe_run(run_id: str) -> dict | None:
    try:
        return load_run(run_id)
    except (MeshError, OSError, ValueError):
        return None


# A launch records its new session when it returns; past this, a `starting` entry is a launch that failed.
STARTING_GRACE = 300


def inherited_identity(run_id: str, name: str, run: dict | None) -> str | None:
    """Why the MESH_RUN / MESH_SELF in the environment aren't this session's, or None if they may be.

    A process can inherit another agent's identity: a background session runs in a spare process forked with
    whatever environment started Claude Code's daemon (see `worker_settings`), and the daemon can outlive the run.
    Claude Code tells its tools which session they run in, and a Claude worker's entry records its session, so
    a mismatch gives it away, except while a launch is recording a new one (`starting`). A pane worker's
    session can change legitimately (`/clear`, plan mode's "clear context"): when this session's process is the
    one running in the pane (`pane_runs_this_claude`), the entry is brought up to date.
    """
    current = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not current:
        return None
    if run is None:
        if (run_dir(run_id) / "run.json").exists():
            return None  # unreadable right now: not evidence either way
        return f"ignored MESH_RUN={run_id}: no such run (stopped?)"
    entry = run["agents"].get(name) or {}
    if entry.get("kind") and entry["kind"] != "claude":  # a Claude session is never an agy or Copilot agent
        return (f"ignored MESH_SELF={name} of run {run_id}: that agent is {entry['kind']}, and this is "
                f"Claude session {current}")
    recorded = entry.get("session")
    if not recorded or recorded == current:
        return None
    if entry.get("status") == "starting" and seconds_since(last_launch(entry)) < STARTING_GRACE:
        return None
    if entry.get("pane") and entry["pane"] == os.environ.get("HERDR_PANE_ID"):
        in_pane = pane_runs_this_claude(entry["pane"])
        if in_pane is None:
            return None  # herdr can't say: trust the pane
        if in_pane:
            with editing_run(run_id) as data:
                data["agents"][name]["session"] = current
            log_event(run_id, "rebind", name=name, session=current)
            entry["session"] = current
            return None
    return (f"ignored MESH_SELF={name} of run {run_id}: that agent is Claude session {recorded}, and this is "
            f"{current}, which inherited its environment (pass --run {run_id} --as {name} if it should act as "
            "that agent)")


def foreign_to_pane(run_id: str, name: str, pane: str) -> str | None:
    """Why this Claude session isn't the root that the pane map names for its pane, or None if it may be.

    Anything started in the root's pane carries its `HERDR_PANE_ID`: a background session whose daemon the user
    started there, or a Claude started by one of the root's tools. Only the pane's foreground process is the
    root (`pane_runs_this_claude`); when herdr can't say, the pane is trusted.
    """
    current = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not current:
        return None
    entry = ((maybe_run(run_id) or {}).get("agents") or {}).get(name) or {}
    if entry.get("kind") and entry["kind"] != "claude":
        return (f"pane {pane} is {name} of run {run_id}, which is {entry['kind']}, and this is "
                f"Claude session {current}")
    if pane_runs_this_claude(pane) is False:
        return (f"pane {pane} is {name} of run {run_id}, and Claude session {current} isn't the process running "
                f"there (pass --run {run_id} --as {name} if it should act as that agent; {NOT_LEADER_HINT})")
    return None


# Why a root's own Claude can fail `pane_runs_this_claude`: it doesn't lead the pane's foreground group.
NOT_LEADER_HINT = ("a launcher script that runs claude without `exec`, or tmux/zellij inside the pane, "
                   "puts another process there; use `exec claude` in the script")


def pane_runs_this_claude(pane: str) -> bool | None:
    """Whether this command's Claude process is the one running in the pane, or None if herdr can't say.

    herdr's `agent_session` can't tell: its hook reports whatever session starts with the pane's ids, and herdr
    takes a `resume`, `clear` or `compact` report from any of them (a nested `claude -c -p`, say). The kernel
    can: the pane's agent leads its foreground process group, while Claude runs each tool in a session of its
    own and background sessions run under its daemon. Members alone aren't enough, as MCP servers share it.
    """
    pid = claude_pid()
    if not pid:
        return None
    try:
        info = herdr("pane", "process-info", "--pane", pane, timeout=10).get("process_info") or {}
    except MeshError:
        return None
    if leader := info.get("foreground_process_group_id"):
        return leader == pid
    members = {p.get("pid") for p in info.get("foreground_processes") or []}
    return pid in members if members else None


def last_launch(entry: dict) -> str | None:
    """When the entry's session last (re)started: its spawn, or its latest model change."""
    times = [entry.get("spawned"), *(m.get("at") for m in entry.get("models") or [])]
    return max((t for t in times if t), default=None)


def seconds_since(iso: str | None) -> float:
    try:
        return (datetime.now(timezone.utc) - datetime.fromisoformat(iso)).total_seconds()
    except (TypeError, ValueError):
        return float("inf")


def refresh_root_address(run_id: str, name: str, run: dict | None = None) -> None:
    """Re-record a Claude root's socket when it was reopened: the socket belongs to the process, not the
    conversation, so a resumed root has a new one and its workers would otherwise ring its pane."""
    run = run or maybe_run(run_id)
    entry = (run or {}).get("agents", {}).get(name, {})
    if entry.get("role") != "root" or entry.get("kind") != "claude":
        return
    address = claude_address()
    if address and address != entry.get("address"):
        with editing_run(run_id) as data:
            data["agents"][name]["address"] = address
        log_event(run_id, "rebind", name=name, address=address)


def agent_name(repo: str, suffix: str, taken: set[str]) -> str:
    """A readable herdr name such as `shop-api-restocked-at`, made unique with -2, -3…"""
    suffix = slugify(suffix, 20)
    base = re.sub(r"^[^a-z]+", "", f"{slugify(repo, 32 - len(suffix) - 4)}-{suffix}") or "agent"
    name, n = base, 2
    while name in taken:
        name, n = f"{base}-{n}", n + 1
    return name


def live_agent_names() -> set[str]:
    """herdr names must be unique among live agents, including other runs' and your own."""
    return {a["name"] for a in herdr("agent", "list").get("agents", []) if a.get("name")}


def repo_name(path: str | None) -> str:
    if not path:
        return "agent"
    try:
        return Path(git("rev-parse", "--show-toplevel", cwd=path)).name
    except (MeshError, OSError):
        return Path(path).name or "agent"


def agent_entry(run: dict, name: str) -> dict:
    try:
        return run["agents"][name]
    except KeyError:
        raise MeshError(f"no agent {name} in run {run['id']}") from None


# ── herdr topology ───────────────────────────────────────────────────────


def inside(path: str | None, top: Path) -> bool:
    if not path:
        return False
    resolved = Path(path).resolve()
    return resolved == top or top in resolved.parents


def find_or_create_workspace(repo_top: Path) -> tuple[str, bool]:
    """The project's one herdr workspace: by label, then by a pane inside the repo, else a new one."""
    # Locked across runs, so two workers spawning at once can't both create one.
    with file_lock(mesh_home() / ".workspace.lock"):
        workspaces = herdr("workspace", "list").get("workspaces", [])
        for ws in workspaces:
            if (ws.get("label") or "").lower() == repo_top.name.lower():
                return ws["workspace_id"], False
        for ws in workspaces:
            panes = herdr("pane", "list", "--workspace", ws["workspace_id"]).get("panes", [])
            if any(inside(p.get("cwd"), repo_top) or inside(p.get("foreground_cwd"), repo_top) for p in panes):
                return ws["workspace_id"], False
        created = herdr("workspace", "create", "--cwd", str(repo_top), "--label", repo_top.name, "--no-focus")
        return created["workspace"]["workspace_id"], True


def env_flags(env: dict[str, str]) -> list[str]:
    flags: list[str] = []
    for key, value in env.items():
        flags += ["--env", f"{key}={value}"]
    return flags


def split_direction(rect: dict) -> str:
    # Terminal cells are roughly twice as tall as wide: split wide panes sideways.
    return "right" if rect["width"] >= 2.2 * rect["height"] else "down"


def tab_label(run: dict) -> str:
    """The run's tab: `mesh: add restockedAt to shop-api`, from the request's first words."""
    words, label = (run.get("request") or "").split(), ""
    for word in words:
        if len(label) + len(word) + 1 > 28:
            break
        label = f"{label} {word}".strip()
    return f"mesh: {label or (words[0][:28] if words else run['id'])}"


SIDE_PANES = 3  # workers beside the root before the rest go to the run's tab


def side_panes() -> int:
    return int(os.environ.get("MESH_SIDE_PANES") or SIDE_PANES)


def area(pane: dict) -> int:
    return pane["rect"]["width"] * pane["rect"]["height"]


def split_at(pane: dict, cwd: Path, env: dict[str, str]) -> str:
    """Split a pane from `pane layout`, along its longer side, and return the new pane."""
    split = herdr(
        "pane", "split", pane["pane_id"], "--direction", split_direction(pane["rect"]),
        "--cwd", str(cwd), *env_flags(env), "--no-focus",
    )
    return split["pane"]["pane_id"]


def beside_root(run_id: str, name: str, cwd: Path, env: dict[str, str],
                replacing: str | None = None) -> tuple[str, str, str] | None:
    """A pane in the root's own tab for agent `name`, so the user sees it next to the root; None when that tab is full.

    The first worker splits the root pane, later ones split the biggest worker pane, so the root keeps its half.
    A swap (`replacing` its old pane) splits that pane, so the worker reopens where it was whatever the count.
    Parallel `mesh` calls (reviewers started in one turn, a Copilot peek pane) would all count the same panes and
    split the same one, so counting, splitting and recording the new pane on `name` happen under one lock.
    """
    with file_lock(run_dir(run_id) / ".panes.lock"):
        beside = _beside_root(run_id, cwd, env, replacing)
        if beside:
            with editing_run(run_id) as run:
                entry = run["agents"][name]
                entry.update(pane=beside[0], tab=beside[1], workspace=beside[2])
                if entry.get("view") == "bg":  # a background launch that fell back to a pane
                    entry["view"] = "pane"
        return beside


def _beside_root(run_id: str, cwd: Path, env: dict[str, str], replacing: str | None) -> tuple[str, str, str] | None:
    run = load_run(run_id)
    root = run["agents"][run["root"]]
    tab = root.get("tab")
    if not (tab and root.get("pane") and root.get("workspace")):
        return None
    try:
        live = {p["pane_id"]: p for p in herdr("pane", "layout", "--pane", root["pane"])["layout"]["panes"]}
    except (HerdrError, KeyError):
        return None  # the root's tab is gone or unusable: use the run's tab
    if replacing:
        target = live.get(replacing)
    else:
        # Live panes only: a pane the user closed by hand frees its place.
        workers = [live[a["pane"]] for a in run["agents"].values()
                   if a["role"] != "root" and a.get("pane") in live and a.get("view") != "bg"
                   and a.get("status") != "retired"]
        if len(workers) >= side_panes():
            return None
        target = max(workers, key=area) if workers else live.get(root["pane"])
    if not target:
        return None
    try:
        return split_at(target, cwd, env), tab, root["workspace"]
    except HerdrError:
        return None


def place_pane(run_id: str, name: str, repo_top: Path, cwd: Path,
               env: dict[str, str]) -> tuple[str, str, str, bool]:
    """(pane, tab, workspace, workspace created) for a new worker pane: beside the root, else the run's tab."""
    if beside := beside_root(run_id, name, cwd, env):
        return *beside, False
    workspace_id, created_ws = find_or_create_workspace(repo_top)
    return *new_pane(run_id, workspace_id, cwd, env), workspace_id, created_ws


def new_pane(run_id: str, workspace_id: str, cwd: Path, env: dict[str, str]) -> tuple[str, str]:
    """A fresh shell pane for an agent, in this run's tab of the workspace."""
    run = load_run(run_id)
    tab_id = run.get("tabs", {}).get(workspace_id)
    if tab_id:
        anchor = next(
            (a["pane"] for a in run["agents"].values() if a.get("tab") == tab_id and a.get("status") != "retired"),
            None,
        )
        if anchor:
            try:
                return split_at(max(herdr("pane", "layout", "--pane", anchor)["layout"]["panes"], key=area),
                                cwd, env), tab_id
            except HerdrError:
                pass  # the tab is gone or unusable: open a new one below
    created = herdr(
        "tab", "create", "--workspace", workspace_id, "--cwd", str(cwd),
        "--label", tab_label(run), *env_flags(env), "--no-focus",
    )
    tab_id = created["tab"]["tab_id"]
    with editing_run(run_id) as run:
        run.setdefault("tabs", {})[workspace_id] = tab_id
    return created["root_pane"]["pane_id"], tab_id


def herdr_text(*args: str) -> str | None:
    """A herdr command whose output is plain text (e.g. `agent read`), or None if it failed or hung."""
    try:
        proc = subprocess.run([os.environ.get("MESH_HERDR") or "herdr", *args], capture_output=True, text=True,
                              timeout=HERDR_READ_TIMEOUT)
    except (subprocess.TimeoutExpired, OSError):
        return None
    return proc.stdout if proc.returncode == 0 else None


def pane_lines(target: str, lines: int = PANE_READ_LINES, ansi: bool = False) -> list[str] | None:
    """The pane's recent lines, trailing blanks dropped; None if herdr can't read it (not the same as no lines)."""
    text = herdr_text("agent", "read", target, "--source", "recent", "--lines", str(lines), *(["--ansi"] if ansi else []))
    if text is None:
        return None
    rows = text.splitlines()
    while rows and not SGR_RE.sub("", rows[-1]).strip():
        rows.pop()
    return rows


def strip_sgr(line: str) -> str:
    return SGR_RE.sub("", OSC_RE.sub("", line))


def input_box_at(lines: list[str]) -> int | None:
    """The index of the agent's input line (the prompt at column 0 under a rule line), searched from the bottom.

    A panel can follow the box (agy's background tasks), so the box is found from the bottom, not by counting rules.
    """
    for i in range(len(lines) - 2, -1, -1):
        if RULE_RE.match(lines[i]) and INPUT_RE.match(lines[i + 1]):
            return i + 1
    return None


def above_input_box(lines: list[str]) -> list[str]:
    """The lines above the agent's input box, so not what is typed in it.

    No box found, no lines: what can't be told apart from the input box never confirms a doorbell.
    """
    at = input_box_at(lines)
    return lines[:at - 1] if at is not None else []


def visible_chars(row: str) -> list[tuple[str, bool]]:
    """Each visible character of an ANSI row, with whether it is drawn dim (SGR 2), as ghost text is."""
    chars, dim, pos = [], False, 0
    for match in [*SGR_RE.finditer(row), None]:
        end = match.start() if match else len(row)
        chars.extend((c, dim) for c in row[pos:end])
        if not match:
            break
        pos = match.end()
        params = [int(p) if p.isdigit() else 0 for p in match.group(1).split(";")]
        i = 0
        while i < len(params):
            p = params[i]
            if p in (38, 48, 58):  # an extended colour: its index or RGB values aren't attributes
                i += 3 if params[i + 1:i + 2] == [5] else 5 if params[i + 1:i + 2] == [2] else 1
                continue
            if p in (0, 22):
                dim = False
            elif p == 2:
                dim = True
            i += 1
    return chars


def typed_text(lines: list[str]) -> str | None:
    """What is typed in the agent's input box, from an ANSI read: "" when it's empty, None when it can't be told.

    The input line is the prompt glyph, a space (an NBSP in Claude Code) and the text; a long text wraps onto rows
    with a gutter, down to the box's closing rule. Dim text is ghost text (Claude's "Try …" placeholder), not
    typed; any other styling counts as typed (Claude colours a slash command). No box, no closing rule (what
    follows may be a footer) or an escape other than SGR and OSC in the box: None.
    """
    plain = [strip_sgr(line) for line in lines]
    at = input_box_at(plain)
    if at is None:
        return None
    typed = []
    for n, row in enumerate(lines[at:]):
        if n and RULE_RE.match(plain[at + n]):
            return squeeze(" ".join(typed))
        row = OSC_RE.sub("", row)
        if "\x1b" in SGR_RE.sub("", row):
            return None
        chars = visible_chars(row)
        if not n:
            chars = chars[1:]  # the glyph
        typed.append("".join(c if not dim else " " for c, dim in chars))
    return None


def human_draft(lines: list[str] | None) -> bool:
    """Whether a pane positively shows a human's draft in its input box; anything unclear isn't one (design §3).

    A doorbell left in the box by an earlier try is ours: typing after it fuses two doorbells, which one
    `mesh inbox` answers.
    """
    text = typed_text(lines) if lines is not None else None
    return bool(text) and not text.startswith(DOORBELL_PREFIX)


def squeeze(text: str) -> str:
    return " ".join(text.split())


def ring_needle(token: str) -> str:
    """What marks one doorbell in a pane, compared with all whitespace removed, so no wrap can split it."""
    return f"ref{token}"


def doorbells_shown(lines: list[str] | None, needle: str) -> int | None:
    """Copies of the doorbell above the input box in a plain read, or None if the pane couldn't be read."""
    if lines is None:
        return None
    return "".join("".join(above_input_box(lines)).split()).count(needle)


def pane_tail(target: str, count: int = ALERT_TAIL_LINES) -> str:
    """The pane's last non-empty lines, indented, for an alert; empty if it can't be read."""
    return screen_tail(pane_lines(target, 40) or [], count)


def screen_tail(rows: list[str], count: int = ALERT_TAIL_LINES) -> str:
    """The last non-empty lines of a screen, indented, for an alert."""
    rows = [line.rstrip() for line in rows if line.strip()][-count:]
    return "\n".join("    " + (line if len(line) <= 160 else line[:159] + "…") for line in rows)


def usage_limit(lines: list[str] | None) -> str | None:
    """The reset time ("" if not shown) when the pane's last LIMIT_LINES lines show Claude's usage limit, else None."""
    tail = (lines or [])[-LIMIT_LINES:]
    if not any(LIMIT_RE.search(line) for line in tail):
        return None
    reset = next((m for m in map(LIMIT_RESET_RE.search, reversed(tail)) if m), None)
    return reset.group(1).strip() if reset else ""


def agent_binary(argv: list[str] | None) -> str | None:
    """`claude` or `agy` when the command line runs one of them (directly, or as a script under node), else None."""
    argv = [a for a in argv or [] if a]
    if not argv:
        return None
    first = Path(argv[0]).name
    if first in INTERPRETERS and len(argv) > 1:
        first = Path(argv[1]).name
    return first if first in AGENT_BINARIES else None


def pane_probe(pane: str | None, kind: str | None) -> str | None:
    """What the pane's process table says about its worker: `missing` (no such pane), `alive` (a `kind` agent runs
    in its foreground), `dead` (only something else, such as the bare shell), or None when herdr can't say."""
    if not pane:
        return "missing"
    try:
        info = herdr("pane", "process-info", "--pane", pane, timeout=10).get("process_info") or {}
    except HerdrError as exc:
        return "missing" if exc.code == "pane_not_found" else None
    except MeshError:
        return None
    procs = info.get("foreground_processes")
    if not procs:
        return None
    want = (kind,) if kind in AGENT_BINARIES else AGENT_BINARIES
    return "alive" if any(agent_binary(p.get("argv")) in want for p in procs) else "dead"


def trust_keys(screen: str) -> list[str] | None:
    """Keys that select "Yes, … trust" in a folder-trust dialog, or None if it isn't one.

    The CLIs differ: agy highlights "Yes" by default, Claude Code highlights "No, exit".
    """
    if not TRUST_PROMPT_RE.search(screen):
        return None
    options = [line.strip() for line in screen.splitlines() if TRUST_OPTION_RE.match(line)]
    yes = next((i for i, line in enumerate(options) if line.lstrip("❯> ").startswith("Yes")), None)
    cursor = next((i for i, line in enumerate(options) if line[0] in "❯>"), None)
    if yes is None or cursor is None:
        return None
    step = "down" if yes > cursor else "up"
    return [step] * abs(yes - cursor) + ["enter"]


def startup_screen(screen: str) -> tuple[str, str | None]:
    """What a new agent waits at: ("trust", None), ("dialog", label) for one of STARTUP_DIALOGS, or ("unknown", None)."""
    if TRUST_PROMPT_RE.search(screen):
        return "trust", None
    for label, heading, option in STARTUP_DIALOGS:
        if heading.search(screen) and option.search(screen):
            return "dialog", label
    return "unknown", None


def startup_text(pane: str) -> str:
    """The pane's screen, read by pane, so it works before herdr has found the agent in it."""
    return herdr_text("pane", "read", pane, "--source", "detection", "--lines", "40") or ""


def startup_state(name: str, pane: str) -> str:
    """herdr's state for a starting agent; one herdr found without its name is given it."""
    try:
        return herdr("agent", "get", name)["agent"].get("agent_status", "unknown")
    except HerdrError as exc:
        if exc.code != "agent_not_found":
            return "unknown"
    try:
        state = herdr("agent", "get", pane)["agent"].get("agent_status", "unknown")
        herdr("agent", "rename", pane, name)
        return state
    except HerdrError:
        return "gone"


def accept_trust_prompt(pane: str, screen: str) -> bool:
    """Accept a folder-trust dialog (a directory mesh chose); False if the cursor never reaches "Yes".

    Claude Code highlights "No, exit", so the screen is read again after the arrows and Enter is pressed only
    with "Yes" selected: a lost arrow would otherwise quit the agent. The arrows are tried twice.
    """
    for attempt in range(3):
        keys = trust_keys(screen)
        if keys == ["enter"]:
            herdr("pane", "send-keys", pane, "enter")
            # The dialog itself reads `blocked`, so waiting for a state would return at once: first wait for
            # it to leave the screen, so a slow redraw isn't taken for another screen nor gets a second Enter.
            for _ in range(TRUST_GONE_READS):
                if not TRUST_PROMPT_RE.search(startup_text(pane)):
                    break
                time.sleep(0.5)
            else:
                return False
            try:  # `blocked` too: another startup screen can follow the trust dialog (a Settings Warning)
                herdr("agent", "wait", pane, "--until", "idle", "--until", "done", "--until", "blocked",
                      "--timeout", "60000")
            except HerdrError:
                pass  # clear_startup looks at the screen again
            time.sleep(3)  # the CLI redraws its welcome screen after the dialog; typing during it is lost
            return True
        if keys is None or attempt == 2:
            return False
        for key in keys[:-1]:
            herdr("pane", "send-keys", pane, key)
            time.sleep(0.3)
        screen = startup_text(pane)
    return False


def continue_selected(screen: str) -> bool:
    """A Settings Warning with its cursor on "Continue", which skips only the invalid settings."""
    return bool(SETTINGS_CONTINUE_RE.search(screen))


def continue_settings_warning(pane: str) -> bool:
    """Press Enter on a Settings Warning's "Continue" (a peer's: see clear_startup); True once it's gone."""
    herdr("pane", "send-keys", pane, "enter")
    for _ in range(TRUST_GONE_READS):
        if startup_screen(startup_text(pane)) != ("dialog", "Settings Warning"):
            time.sleep(3)  # as after the trust dialog: typing during the redraw is lost
            return True
        time.sleep(0.5)
    return False


def clear_startup(name: str, pane: str, peer: bool = False) -> dict:
    """Past `agent start`'s "not ready": accept folder-trust dialogs, then {} once the agent takes input, or
    {"held": label, "tail": …} for a screen only the user answers (see `hold`). A CLI that exited is an error.

    A peer asker (`peer`) also gets past a Settings Warning by its default "Continue": its repo is a clone
    of someone else's project that nobody here fixes, so the invalid rules are skipped as the user did by
    hand (design §14). Any other worker's repo is the user's to fix, so it holds there.
    """
    accepted, settle = 0, STARTUP_SETTLE_READS
    while True:
        screen = startup_text(pane)
        kind, label = startup_screen(screen)
        if kind == "trust":
            if accepted < STARTUP_SCREENS and accept_trust_prompt(pane, screen):
                accepted += 1
                continue
            label = "the folder-trust dialog"
        elif (peer and label == "Settings Warning" and accepted < STARTUP_SCREENS and continue_selected(screen)
              and continue_settings_warning(pane)):
            accepted += 1
            continue
        elif kind == "unknown":
            state = startup_state(name, pane)
            if state in ("idle", "done", "working"):
                return {}
            if settle:  # herdr may still show the last dialog's `blocked`, or not have found the agent yet
                settle -= 1
                time.sleep(1)
                continue
            if state == "gone":
                tail = screen_tail(screen.splitlines())
                raise MeshError(f"{name} exited during startup" + (f"; last lines of its pane:\n{tail}" if tail else ""))
            label = "a screen mesh doesn't know"
        return {"held": label, "tail": screen_tail(screen.splitlines())}


def start_agent(name: str, kind: str, pane: str, argv: list[str], attempts: int = 10, peer: bool = False) -> dict:
    """`herdr agent start`, retried while the new shell is still starting, then past any folder-trust dialog.

    {} once the agent takes input, or `clear_startup`'s {"held": …} when it waits at another startup screen.
    A `timeout` isn't retried: the CLI already runs in the pane.
    """
    last: HerdrError | None = None
    for _ in range(attempts):
        try:
            herdr("agent", "start", name, "--kind", kind, "--pane", pane, "--timeout", "120000", "--", *argv)
            return {}
        except HerdrError as exc:
            if exc.code in ("agent_not_ready", "timeout"):
                return clear_startup(name, pane, peer)
            last = exc
            time.sleep(1)
    raise MeshError(f"could not start {name}: {last}")


def hold(run_id: str, sender: str, name: str, mtype: str, body: str | None, started: dict,
         stored: Path | None = None) -> dict:
    """The delivery for a worker held at a startup screen: the message is stored now, and `release_held` rings
    its first doorbell once the agent takes input."""
    path = stored or (record(run_id, sender, name, mtype, body) if body else None)
    with editing_run(run_id) as run:
        run["agents"][name]["held"] = {"sender": sender, "type": mtype, "file": path.name if path else None,
                                       "screen": started["held"], "at": now_iso()}
    log_event(run_id, "held", name=name, screen=started["held"], file=path.name if path else None)
    return {"stored": str(path) if path else None, "rung": False, "type": mtype,
            "error": f"waiting at a startup screen ({started['held']})", "held": started["held"],
            "tail": started.get("tail", "")}


def held_alert(name: str, delivery: dict) -> str:
    """What a command that left a worker held prints, like watch's exit 4."""
    line = (f"ALERT {name} is waiting at a startup screen ({delivery['held']}) that mesh doesn't answer: "
            f"the user clears it in its pane (`herdr agent focus {name}`)")
    if delivery.get("stored"):
        line += (f". Its {delivery.get('type')} is stored, and a running `mesh watch` rings its doorbell once "
                 f"the screen is gone (or run `mesh ring {name}` then)")
    tail = delivery.get("tail")
    return f"{line}\n  last lines of its pane:\n{tail}" if tail else line


def report_held(name: str, delivery: dict | None) -> int | None:
    """Exit 4 with the alert when a start left the worker held; None otherwise."""
    if not (delivery or {}).get("held"):
        return None
    print(held_alert(name, delivery), file=sys.stderr)
    return 4


def held_doorbell(run: dict, name: str, held: dict, token: str) -> str:
    """The first doorbell, which says who the worker is: a held worker never heard it (agy's session lookup
    keys on it)."""
    return doorbell_text(run, held.get("sender"), name, held.get("type") or "messages", "", True, token)


def release_held(run_id: str, name: str, entry: dict, state: str) -> bool:
    """For a watch: ring a held worker's first doorbell once its startup screen is gone, if it has unread mail.

    True while the watch should stay quiet: still at the screen its start already reported (or working past
    it), or just rung. Gone (the user chose to exit) drops the hold, so the watch says so. A ring that fails
    keeps the hold, so the next poll or `mesh ring` tries the first doorbell again; after HELD_RING_TRIES
    polls the watch carries on, and its nudge (`deliver`) drops the stale hold and rings it.
    """
    if state not in ("idle", "done", "gone"):
        return True
    with editing_run(run_id) as run:  # whoever takes it rings: two watches don't both ring
        held = run["agents"][name].pop("held", None)
    if not held or state == "gone":
        return False
    paths = unread(run_id, name)
    if not paths:  # nothing waiting (it was read, or there never was a task)
        return True
    token = ring_token()
    rung = ring_stored(run_id, held.get("sender"), name, [name] + ([entry["pane"]] if entry.get("pane") else []),
                       held_doorbell(load_run(run_id), name, held, token), token, paths[-1],
                       read=tuple(paths))["rung"]
    log_event(run_id, "held_rung", name=name, rung=rung)
    with editing_run(run_id) as run:
        if rung:
            run["agents"][name].pop("swapped", None)
        else:
            run["agents"][name].setdefault("held", {**held, "tries": held.get("tries", 0) + 1})
    return rung or held.get("tries", 0) + 1 < HELD_RING_TRIES


# ── background sessions ──────────────────────────────────────────────────

# `claude agents` status of a running background session, in herdr's words.
BG_STATUS = {"busy": "working", "idle": "idle", "waiting": "blocked"}


class BgUntrusted(MeshError):
    """`claude --bg` refuses a folder Claude Code was never trusted in (a worktree of a trusted repo is fine)."""


def bg_row(entry: dict, rows: list[dict] | None = None) -> dict | None:
    session = entry.get("session")
    if not session:
        return None
    rows = claude_agents() if rows is None else rows
    return next((r for r in rows if r.get("sessionId") == session), None)


def bg_status(entry: dict, rows: list[dict] | None = None) -> str:
    """working / idle / blocked while the session's process runs; gone once it has exited or been stopped."""
    row = bg_row(entry, rows)
    if not row or not row.get("status"):
        return "gone"
    return BG_STATUS.get(row["status"], "unknown")


MESH_IDS = ("MESH_RUN", "MESH_SELF", "MESH_PARENT", "MESH_ROLE")
HERDR_IDS = ("HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID")
# Every MESH_* variable mesh reads as configuration; an empty one counts as unset.
MESH_CONFIG = ("MESH_HOME", "MESH_WORKTREES", "MESH_HERDR", "MESH_CLAUDE", "MESH_CC_SOCKS", "MESH_SIDE_PANES",
               "MESH_MIN_QUOTA", "MESH_COMPACT_AT", "MESH_AGY_COMPACT_AT", "MESH_AGY_SUMMARIES",
               "MESH_AGY_HISTORY", "MESH_AGY_CONVERSATIONS", "MESH_COPILOT_MODEL", "MESH_HANG_AFTER",
               "MESH_ROOT_RESET_AT", "MESH_ROOT_AUTORESET", "MESH_CACHE_TTL", "MESH_RESET_WAIT")
# What Claude Code sets for the one session a process runs under (its tools inherit it): never pass it on.
CLAUDE_SESSION_VARS = ("CLAUDECODE", "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_CHILD_SESSION", "CLAUDE_CODE_SESSION_KIND",
                       "CLAUDE_CODE_SESSION_ATTENDED", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN",
                       "CLAUDE_PID", "CLAUDE_EFFORT", "CLAUDE_JOB_DIR", "CLAUDE_BG_BACKEND",
                       "CLAUDE_BG_SOCKET_TOKENS_PATH")


def env_without_identity(keep_herdr: bool) -> dict[str, str]:
    """This process's environment with no mesh identity. Without `keep_herdr` it also loses the pane's herdr ids,
    which `identity()` would otherwise map back to whoever owns this pane (the root)."""
    return {k: v for k, v in os.environ.items()
            if k not in MESH_IDS and (keep_herdr or k not in HERDR_IDS)}


def claude_env(strip_mesh: bool = False) -> dict[str, str]:
    """The environment for a `claude` CLI call. Any of them may start Claude Code's daemon, whose spare processes
    then run later background sessions with this environment, so it carries no mesh identity, no herdr pane ids
    and nothing of the calling Claude session; with `strip_mesh`, no MESH_* configuration either."""
    return {k: v for k, v in env_without_identity(keep_herdr=False).items()
            if k not in CLAUDE_SESSION_VARS and not (strip_mesh and k.startswith("MESH_"))}


HOOK_TIMEOUT = 30  # seconds Claude Code gives a worker's hook
REMINDER_SOURCES = ("compact", "clear", "resume")  # SessionStart sources that get `mesh whoami --reminder`


def hook_command(*args: str) -> str:
    """A shell command running this script, by its absolute path, so a hook works whatever PATH the session has."""
    return shlex.join([str(Path(__file__).absolute()), *args])


def worker_hooks(run_id: str, name: str) -> dict:
    """The hooks a Claude worker is started with (design, "The Stop hook"). The command names the worker,
    as only the sessions mesh starts for it carry these hooks: nothing has to be read from the hook's
    environment. Claude Code adds them to the user's and the repo's own hooks."""
    ident = ("--run", run_id, "--as", name)

    def group(command: str, matcher: str | None = None) -> dict:
        hook = {"type": "command", "command": command, "timeout": HOOK_TIMEOUT}
        return {**({"matcher": matcher} if matcher else {}), "hooks": [hook]}

    return {"Stop": [group(hook_command("hook", "stop", *ident))],
            "SessionStart": [group(hook_command("whoami", "--reminder", source, *ident), source)
                             for source in REMINDER_SOURCES]}


def worker_settings(env: dict[str, str], bg: bool) -> str:
    """`--settings` JSON for a Claude worker: its hooks, and for a background one its environment.

    `claude --bg` runs the session in a spare process the daemon forked from its own environment, which is
    whoever's call started the daemon (an earlier worker, say), so the launch's own environment never reaches
    it. Settings `env` does, and overrides the spare's values, but can only set a variable: so every config
    key is set, empty when this launch has none, and the herdr ids are set empty, or a spare's stale values
    would stay (a pane id that `identity()` maps to its owner, another MESH_HOME). A pane has its environment.
    """
    settings: dict = {"hooks": worker_hooks(env["MESH_RUN"], env["MESH_SELF"])}
    if bg:
        settings["env"] = {**{k: "" for k in (*MESH_CONFIG, *HERDR_IDS)}, **env}
    return json.dumps(settings)


def settings_argv(kind: str, env: dict[str, str]) -> list[str]:
    """The `--settings` a pane worker of this kind starts with: Claude's hooks; agy has none."""
    return ["--settings", worker_settings(env, bg=False)] if kind == "claude" else []


def launch_bg(name: str, cwd: str | Path, model: str, effort: str, env: dict[str, str], prompt: str,
              resume: str | None = None, extra: list[str] | tuple[str, ...] = ()) -> tuple[str, str]:
    """Start a background Claude session and return (short id, session id).

    `--bg` picks its own session id. With `resume`, the flags make it start a *copy* of that conversation under
    a new id, which is what a resume needs: a copy gets this launch's model and settings (the identity, see
    `worker_settings`), while continuing the old id would bring back the options it was first started with.
    """
    argv = [claude_bin(), "--bg", *(["--resume", resume] if resume else []), "-n", name, "--model", model,
            "--effort", effort, *extra, "--settings", worker_settings(env, bg=True), "--dangerously-skip-permissions", prompt]
    # No MESH_* in the process itself, so a daemon this launch starts, and its spares, carry none.
    proc = run_cli(argv, cwd=cwd, env=claude_env(strip_mesh=True), timeout=120)
    out = f"{proc.stdout}\n{proc.stderr}".strip()
    if "Workspace not trusted" in out:
        raise BgUntrusted(f"Claude Code doesn't trust {cwd} yet, so it can't run in the background there")
    started = BG_STARTED_RE.search(out)
    if proc.returncode != 0 or not started:
        raise MeshError(f"`claude --bg` did not start {name}: {out[:300]}")
    short = started.group(1)
    for _ in range(10):
        row = next((r for r in claude_agents() if r.get("id") == short), None)
        if row and row.get("sessionId"):
            return short, row["sessionId"]
        time.sleep(1)
    run_cli([claude_bin(), "stop", short], env=claude_env(), timeout=30)  # a stray session would do the task twice
    raise MeshError(f"{name} started as background session {short}, but `claude agents` doesn't list it")


def stop_bg(entry: dict) -> bool:
    """Stop a background worker's process; its conversation is kept (never `claude rm`)."""
    if not entry.get("bg_id"):
        return False
    return run_cli([claude_bin(), "stop", entry["bg_id"]], env=claude_env(), timeout=30).returncode == 0


def wait_bg_idle(entry: dict, wait_ms: int, strict: bool) -> None:
    """Wait for a background worker's turn to end, as `herdr agent wait --until idle` does for a pane."""
    deadline = time.monotonic() + wait_ms / 1000
    while True:
        state = bg_status(entry)
        if state in ("idle", "gone"):
            return
        if time.monotonic() > deadline:
            if strict:
                raise SwapNotStarted(f"background session {entry.get('bg_id')} is still {state}")
            return
        time.sleep(2)


# ── models ───────────────────────────────────────────────────────────────


def parse_agy_id(model_id: str) -> tuple[str, tuple[int, ...], str] | None:
    """(family, version, effort) of an agy model id, e.g. ("opus", (5, 5), "high")."""
    match = GEMINI_ID_RE.match(model_id)
    if match:
        version, family, effort = match.groups()
    else:
        match = CLAUDE_ID_RE.match(model_id)
        if not match:
            return None
        family, version, effort = match.groups()
    return family, tuple(int(part) for part in re.findall(r"\d+", version)), effort


def listing_names(listing: str) -> dict[str, str]:
    """Model id -> display name, from `agy models` output."""
    names = {}
    for line in listing.splitlines():
        model_id, _, display = line.partition("\t")
        if model_id.strip():
            names[model_id.strip()] = display.strip()
    return names


def pick_agy_model(listing: str, family: str, effort: str) -> str:
    """The newest `<family>` id with that effort in `agy models` output (argon, flash, opus, sonnet, ...)."""
    ids = list(listing_names(listing))
    if family in ids:
        return family
    candidates = []
    for model_id in ids:
        parsed = parse_agy_id(model_id)
        if parsed and parsed[0] == family and parsed[2] == effort:
            candidates.append((parsed[1], model_id))
    if not candidates:
        raise MeshError(f"no agy model matches family={family} effort={effort}; see `agy models`")
    return max(candidates)[1]


def agy_model_listing() -> str:
    """`agy models` output, cached: the command fetches over the network and can hang."""
    cache = mesh_home() / "agy-models.txt"
    if cache.exists() and time.time() - cache.stat().st_mtime < AGY_MODELS_TTL:
        return cache.read_text()
    try:
        proc = subprocess.run(["agy", "models"], capture_output=True, text=True, timeout=45)
        if proc.returncode == 0 and any(parse_agy_id(model_id) for model_id in listing_names(proc.stdout)):
            write_atomic(cache, proc.stdout)
            return proc.stdout
        problem = proc.stderr.strip() or "no models listed"
    except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
        problem = type(exc).__name__
    if cache.exists():
        return cache.read_text()  # stale, but far better than failing the spawn
    raise MeshError(f"`agy models` failed ({problem}) and there is no cached list; pass an exact --model id")


def resolve_agy_model(family: str, effort: str) -> str:
    if parse_agy_id(family):
        return family  # an exact id needs no listing
    return pick_agy_model(agy_model_listing(), family, effort)


def parse_usage(text: str) -> list[dict]:
    """Rows of `agy -p /usage`: group, label, percent left and reset time, tab-separated."""
    rows = []
    for line in text.splitlines():
        fields = [f.strip() for f in line.split("\t")]
        if len(fields) >= 4 and re.fullmatch(r"\d+%", fields[2]):
            rows.append({"group": fields[0], "label": fields[1], "left": int(fields[2][:-1]), "resets": fields[3]})
    return rows


def agy_usage(force: bool = False) -> list[dict] | None:
    """agy's quota rows, cached for a few minutes; None when they can't be read."""
    cache = mesh_home() / "agy-usage.txt"
    failed = mesh_home() / "agy-usage.failed"
    if not force and cache.exists() and time.time() - cache.stat().st_mtime < AGY_USAGE_TTL:
        return parse_usage(cache.read_text()) or None
    if not force and failed.exists() and time.time() - failed.stat().st_mtime < AGY_USAGE_RETRY:
        return None  # a spawn must not wait on a command that just failed
    cache.parent.mkdir(parents=True, exist_ok=True)
    try:
        proc = subprocess.run(
            ["agy", "-p", "/usage", "--print-timeout", "40s", "--dangerously-skip-permissions"],
            capture_output=True, text=True, timeout=45, cwd=cache.parent,
        )
        rows = parse_usage(proc.stdout)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        rows = []
    if rows:
        write_atomic(cache, proc.stdout)
        failed.unlink(missing_ok=True)
    else:
        failed.touch()
    return rows or None


def quota_applies(group: str, model_id: str, display: str) -> bool:
    """"Claude and GPT models" covers ids by vendor prefix; "Gemini 4 Argon" covers that model by name."""
    if group.lower().endswith(" models"):
        vendors = group[: -len(" models")].lower().split(" and ")
        return any(model_id.startswith(f"{vendor.strip()}-") for vendor in vendors)
    return display.lower().startswith(group.lower())


def model_quota(model_id: str, display: str, rows: list[dict]) -> tuple[int, str] | None:
    """The tightest limit on a model: (percent left, reset time), or None if no row covers it."""
    limits = [(r["left"], r["resets"]) for r in rows if quota_applies(r["group"], model_id, display)]
    return min(limits) if limits else None


def min_quota() -> int:
    return int(os.environ.get("MESH_MIN_QUOTA") or 10)


def choose_agy_model(chain: tuple[str, ...], effort: str, skip: tuple[str, ...] = (), force: bool = False,
                     fallback: bool = True) -> tuple[str, list[str]]:
    """The first model of the chain with at least MESH_MIN_QUOTA% left, and notes on the ones passed over.

    Unreadable quotas count as available. With nothing above the threshold, `fallback` takes the
    model with the most left; without it the notes (with reset times) become the error.
    """
    rows = agy_usage(force)
    names = listing_names(agy_model_listing()) if rows else {}
    notes: list[str] = []
    best: tuple[int, str] | None = None
    for family in chain:
        model_id = resolve_agy_model(family, effort)
        if model_id in skip:
            continue
        quota = model_quota(model_id, names.get(model_id, ""), rows) if rows else None
        if quota is None or quota[0] >= min_quota():
            return model_id, notes
        notes.append(f"{model_id} has {quota[0]}% left (resets {quota[1]})")
        if best is None or quota[0] > best[0]:
            best = (quota[0], model_id)
    if fallback and best:
        return best[1], notes + [f"every model is under {min_quota()}%; using {best[1]}"]
    raise MeshError("no model with quota left: " + ("; ".join(notes) or "every candidate was already tried"))


def agent_argv(kind: str, model: str, effort: str, log: str | None = None) -> tuple[list[str], str, str | None]:
    """Native CLI arguments, the resolved model and the session id (Claude only) for a new agent."""
    if kind == "agy":
        resolved = resolve_agy_model(model, effort)
        return [*log_argv(log), "--model", resolved, "--dangerously-skip-permissions"], resolved, None
    # Choosing the session id up front is what lets `mesh resume` find the conversation later.
    session = str(uuid.uuid4())
    argv = ["--session-id", session, "--model", model, "--effort", effort, "--dangerously-skip-permissions"]
    return argv, model, session


def log_argv(log: str | None) -> list[str]:
    """agy writes its own log; one per worker is how `mesh watch` sees a quota hit."""
    return ["--log-file", log] if log else []


def resolve_model(kind: str, model: str, effort: str) -> str:
    """The id to start an agent of this kind with: agy families are resolved, Claude aliases pass through."""
    return resolve_agy_model(model, effort) if kind == "agy" else model


def claude_deny(entry: dict) -> list[str]:
    """`--disallowedTools` for a Claude worker on a read-only task (`read_only`) or planning one that `mesh approve`
    hasn't approved yet (`planning`), else nothing. The list is the same for both, so moving between the two
    reasons needs no reopen.

    Edits are denied by path, its worktree and the main checkout, so it can still write its report under
    `$(mesh dir)`; an `Edit` rule stops Write too. Deny rules win over `--dangerously-skip-permissions`, in
    a pane and in `--bg`, and aren't kept in the conversation: a reopen without them can edit (design §10).
    The flag takes several values, so callers put another flag after it.
    """
    if entry.get("kind") != "claude" or not (entry.get("read_only") or entry.get("planning")):
        return []
    paths = dict.fromkeys(str(Path(p).resolve()) for p in (entry.get("cwd"), entry.get("repo")) if p)
    return ["--disallowedTools", *(f"Edit(/{p}/**)" for p in paths), *(f"Bash({cmd}:*)" for cmd in PUBLISH_COMMANDS)]


def resume_argv(kind: str, session: str, model: str, effort: str) -> list[str]:
    """CLI arguments that reopen an agent's conversation (no permission flags)."""
    if kind == "agy":
        return ["--conversation", session, "--model", model]
    if kind == "copilot":
        return ["--resume", session, *copilot_model_argv(model, effort)]
    return ["--resume", session, "--model", model, "--effort", effort]


def resumed_model(entry: dict, model: str | None, effort: str | None) -> tuple[str, str]:
    """The model and effort a resumed agent runs on: what it had, unless overridden."""
    effort = effort or entry.get("effort") or DEFAULT_EFFORT
    if entry.get("kind") == "copilot":
        return model or entry.get("requested_model") or COPILOT_MODEL, effort
    if entry.get("kind") != "agy":
        return model or entry.get("model") or PLAN_CHAIN["claude"][0], effort
    if not model:
        parsed = parse_agy_id(entry.get("model") or "")
        if parsed and parsed[2] == effort:
            return entry["model"], effort  # the exact id it ran on; no listing needed
        model = parsed[0] if parsed else EXEC_MODEL["agy"]
    return resolve_agy_model(model, effort), effort


# ── sessions ─────────────────────────────────────────────────────────────


def first_doorbell(name: str) -> str:
    """How every first doorbell to an agent starts (see doorbell_text), without the emoji."""
    return f"You are {name} ("


@lru_cache(maxsize=4)
def agy_history(path: str, mtime: float) -> list[dict]:
    entries = []
    for line in Path(path).read_text(errors="replace").splitlines():
        try:
            entries.append(json.loads(line))
        except ValueError:
            continue
    return entries


@lru_cache(maxsize=4)
def agy_summaries(path: str, mtime: float) -> list[dict]:
    """agy's own index of its conversations: id, first prompt (`preview`) and workspace, oldest first.

    It has a conversation's id from its first prompt on, while history.jsonl only gets one with a later prompt.
    Opened read-only; agy keeps it in WAL mode, so reading never blocks it.
    """
    try:
        import sqlite3  # here, so a Python built without it only loses this lookup
    except ImportError:
        return []
    try:
        db = sqlite3.connect(f"{Path(path).resolve().as_uri()}?mode=ro", uri=True, timeout=2)
        try:
            # Top-level conversations only: agy's subagents (`nesting_depth` > 0) share the workspace.
            rows = db.execute("SELECT conversation_id, preview, workspace_uris FROM conversation_summaries "
                              "WHERE nesting_depth = 0 AND step_count > 0 ORDER BY last_modified_time").fetchall()
        finally:
            db.close()
    except (sqlite3.Error, ValueError):
        return []
    entries = []
    for conversation, preview, uris in rows:
        try:
            workspaces = [urllib.parse.unquote(urllib.parse.urlparse(uri).path) for uri in json.loads(uris)]
        except (ValueError, TypeError, AttributeError):
            workspaces = []
        entries.append({"conversationId": conversation, "display": preview or "", "workspaces": workspaces})
    return entries


def agy_conversation(name: str, run_id: str, cwd: str | None, pinned_only: bool = False) -> str | None:
    """agy's conversation id for an agent, from agy's conversation index, else the prompt history it keeps.

    The first doorbell names the agent and its run, so it pins the conversation even when
    a restart (`-2`) shares the worktree; the newest conversation in that directory is the fallback
    (not with `pinned_only`). agy sometimes replaces the index's first prompt with the conversation's
    title, which is why a worker's conversation is recorded once it first writes (see record_session).
    """
    home = Path.home() / AGY_HOME
    sources = ((os.environ.get("MESH_AGY_SUMMARIES") or home / "conversation_summaries.db", agy_summaries),
               (os.environ.get("MESH_AGY_HISTORY") or home / "history.jsonl", agy_history))
    run_re = re.compile(rf"\brun {re.escape(run_id)}\b")
    cwds = []
    for source, read in sources:
        path = Path(source)
        try:  # agy's db takes new rows in its write-ahead log first, so that file's mtime counts too
            mtime = max(f.stat().st_mtime for f in (path, path.with_name(path.name + "-wal")) if f.exists())
        except (OSError, ValueError):  # gone, or its log removed as we looked
            continue
        by_cwd = None
        for entry in read(str(path), mtime):
            conversation, display = entry.get("conversationId"), entry.get("display") or ""
            if not conversation:
                continue
            if display.startswith(f"📬 [mesh] {first_doorbell(name)}") and run_re.search(display):
                return conversation
            if cwd and cwd in entry.get("workspaces", [entry.get("workspace")]):
                by_cwd = conversation
        cwds.append(by_cwd)
    return None if pinned_only else next((c for c in cwds if c), None)


def claude_sessions_dir(cwd: str) -> Path:
    """Where Claude Code keeps the sessions it ran in `cwd`."""
    base = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    return base / "projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd)


def claude_session(name: str, cwd: str) -> str | None:
    """A Claude session id for agents spawned before mesh chose ids: Claude keeps sessions per cwd."""
    folder = claude_sessions_dir(cwd)
    if not folder.is_dir():
        return None
    for path in sorted(folder.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True):
        if first_doorbell(name) in path.read_text(errors="replace"):
            return path.stem
    return None


def find_session(run_id: str, name: str, entry: dict) -> str | None:
    if entry.get("session"):
        return entry["session"]
    cwd = entry.get("cwd")
    if entry.get("kind") == "agy":
        # A main checkout is shared with the user's own sessions: there only the doorbell counts.
        shared = bool(cwd and entry.get("repo")) and Path(cwd).resolve() == Path(entry["repo"]).resolve()
        return agy_conversation(name, run_id, None if shared else cwd)
    return claude_session(name, cwd) if cwd else None


def claude_transcript(entry: dict, session: str) -> Path | None:
    """A Claude worker's session file (JSONL, appended on every message, tool call and result), if it exists."""
    if not entry.get("cwd"):
        return None
    path = claude_sessions_dir(entry["cwd"]) / f"{session}.jsonl"
    return path if path.exists() else None


def agy_conversation_file(session: str) -> Path:
    base = os.environ.get("MESH_AGY_CONVERSATIONS") or Path.home() / AGY_HOME / "conversations"
    return Path(base) / f"{session}.db"


def progress_files(entry: dict, session: str | None) -> list[Path]:
    """The files a worker writes as it makes progress: Claude's session file; agy's conversation db (with the
    write-ahead log it takes new rows in first and its shared-memory index: the log vanishes at a checkpoint)
    and its own `--log-file`."""
    if entry.get("kind") == "agy":
        db = agy_conversation_file(session) if session else None
        files = [db, db.with_name(db.name + "-wal"), db.with_name(db.name + "-shm")] if db else []
        return [f for f in (*files, Path(entry["log"]) if entry.get("log") else None) if f]
    path = claude_transcript(entry, session) if session else None
    return [path] if path else []


def last_progress(entry: dict, session: str | None) -> float | None:
    """When the worker last wrote any of its `progress_files` (epoch seconds), or None if none can be read."""
    times = []
    for path in progress_files(entry, session):
        try:
            times.append(path.stat().st_mtime)
        except OSError:
            continue
    return max(times, default=None)


def transcript_limit(entry: dict, session: str | None, tail: int = 65536) -> str | None:
    """The reset time ("" if not shown) when a Claude worker's last reply is a usage-limit error, else None.

    Claude Code records an API error as a synthetic assistant entry (`isApiErrorMessage`, an `error` code such as
    `authentication_failed` or `server_error`, the text it showed). The code of a usage limit isn't known (no
    sample seen yet) and a plain rate limit may share it, so the text decides: it must match LIMIT_RE.
    """
    path = claude_transcript(entry, session) if session and entry.get("kind") == "claude" else None
    if not path:
        return None
    try:
        with open(path, "rb") as fh:
            fh.seek(max(0, fh.seek(0, os.SEEK_END) - tail))
            lines = fh.read().decode(errors="replace").splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        if '"assistant"' not in line:
            continue
        try:
            event = json.loads(line)
        except ValueError:
            continue  # the first line of the tail is usually cut
        if event.get("type") != "assistant":
            continue
        if not event.get("isApiErrorMessage"):
            return None
        content = (event.get("message") or {}).get("content")
        text = " ".join(c.get("text") or "" for c in content if isinstance(c, dict)) if isinstance(content, list) \
            else str(content or "")
        if not LIMIT_RE.search(text):
            return None
        reset = LIMIT_RESET_RE.search(text)
        return reset.group(1).strip() if reset else ""
    return None


def context_tokens(entry: dict, session: str) -> int | None:
    """A worker's context size: the prompt of its last reply since its last compaction (0 right after one).

    None when its conversation file can't be read.
    """
    if entry.get("kind") == "agy":
        return agy_context_tokens(session)
    path = claude_transcript(entry, session)
    return transcript_tokens(path) if path else None


def line_tokens(line: bytes) -> int | None:
    """A session file line's context size: 0 for a compaction, an assistant reply's prompt, else None."""
    if b'"compact_boundary"' not in line and b'"usage"' not in line:
        return None
    try:
        event = json.loads(line)
    except ValueError:
        return None
    if event.get("type") == "system" and event.get("subtype") == "compact_boundary":
        return 0
    if event.get("type") == "assistant" and (usage := (event.get("message") or {}).get("usage")):
        return sum(int(usage.get(key) or 0) for key in
                   ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
    return None


def transcript_tokens(path: Path, chunk: int = 1 << 20) -> int | None:
    """The newest reply's prompt in a Claude session file since its last compaction, read backwards from its
    end (a root's file grows to tens of MB, and every root command measures it). None when it has neither."""
    try:
        with open(path, "rb") as fh:
            end, rest = fh.seek(0, os.SEEK_END), b""
            while end > 0:
                start = max(0, end - chunk)
                fh.seek(start)
                lines = (fh.read(end - start) + rest).split(b"\n")
                rest = lines.pop(0) if start else b""  # cut by the chunk: it's finished with the next one
                for line in reversed(lines):
                    if (tokens := line_tokens(line)) is not None:
                        return tokens
                end = start
    except OSError:
        return None
    return None


AGY_COMPACTION_STEP = 23  # a step holding a compaction's <summary>: a `/compact`, or agy's own
AGY_STEP_DONE = 3  # a step's status once it has finished (tool steps that failed or were cancelled have others)


def protobuf_fields(blob: bytes) -> list[tuple[int, int | bytes]]:
    """(field number, value) of each field of one protobuf message: varints as ints, the rest as bytes.

    ValueError or IndexError when `blob` isn't one.
    """
    def varint(i: int) -> tuple[int, int]:
        n = shift = 0
        while True:
            byte = blob[i]
            n, i, shift = n | (byte & 0x7F) << shift, i + 1, shift + 7
            if not byte & 0x80:
                return n, i
    fields, i = [], 0
    while i < len(blob):
        key, i = varint(i)
        wire = key & 7
        if wire == 0:
            value, i = varint(i)
        elif wire in (1, 5):
            size = 8 if wire == 1 else 4
            value, i = blob[i:i + size], i + size
        elif wire == 2:
            size, i = varint(i)
            value, i = blob[i:i + size], i + size
        else:
            raise ValueError(f"protobuf wire type {wire}")
        if i > len(blob):
            raise ValueError("truncated protobuf")
        fields.append((key >> 3, value))
    return fields


def agy_context_tokens(session: str) -> int | None:
    """An agy conversation's context size: the prompt of its last model call since its last compaction.

    agy documents no format. Its conversation file is SQLite, and field 9 of a step's `metadata` protobuf is
    that call's usage: 2 the input read fresh, 5 the input read from cache, 3 the output. Checked against
    `agy -p --output-format json`, whose `usage` sums them over the whole conversation (so it can't tell
    the size). None when the file is missing or reads otherwise, and `--compact auto` falls back.
    """
    try:
        import sqlite3  # here, so a Python built without it only loses this reading
    except ImportError:
        return None
    path = agy_conversation_file(session)
    if not path.exists():
        return None
    try:
        db = sqlite3.connect(f"{path.resolve().as_uri()}?mode=ro", uri=True, timeout=2)
        try:
            # Newest first, read only as far as the first call or compaction.
            for step_type, status, metadata in db.execute("SELECT step_type, status, metadata FROM steps "
                                                          "ORDER BY idx DESC"):
                if step_type == AGY_COMPACTION_STEP and status == AGY_STEP_DONE:  # a failed one compacted nothing
                    return 0
                if not isinstance(metadata, bytes):
                    continue
                try:
                    usage = next((v for f, v in protobuf_fields(metadata) if f == 9 and isinstance(v, bytes)), b"")
                    counts = {f: v for f, v in protobuf_fields(usage) if isinstance(v, int)}
                except (ValueError, IndexError):
                    continue
                if 2 in counts:
                    return counts[2] + counts.get(5, 0)
        finally:
            db.close()
    except (sqlite3.Error, ValueError):
        return None
    return None


def compact_at(kind: str | None = None) -> int:
    key, default = ("MESH_AGY_COMPACT_AT", AGY_COMPACT_AT) if kind == "agy" else ("MESH_COMPACT_AT", COMPACT_AT)
    try:
        return int(os.environ.get(key) or default)
    except ValueError:
        return default


def should_compact(mode: str, entry: dict, tokens: int | None, read_only: bool, cross_run: bool,
                   peer: bool = False) -> bool:
    """`--compact auto`: compact a conversation that a resume would otherwise re-read in full, turn after turn.

    An old conversation's prompt cache has expired, so every turn of the follow-up pays for its whole
    context. A question or two doesn't repay a compaction, so read-only tasks get twice the threshold, except
    a standing peer asker's: it is asked question after question, each time cold (design §14).
    """
    if mode != "auto":
        return mode == "yes"
    if tokens is None and entry.get("kind") == "agy":
        return cross_run and not read_only  # no size to go on: compact what comes back from an earlier run
    return tokens is not None and tokens > compact_at(entry.get("kind")) * (2 if read_only and not peer else 1)


def compact_conversation(entry: dict, session: str, model: str, focus: str) -> tuple[bool, str]:
    """Compact a stopped worker's conversation headless, in its own directory, before it is reopened."""
    prompt = f"/compact {focus}"
    if entry.get("kind") == "agy":
        argv = ["agy", "--conversation", session, "--model", model, "--dangerously-skip-permissions", "-p", prompt]
    else:
        argv = [claude_bin(), "-p", "--resume", session, "--model", model, "--dangerously-skip-permissions", prompt]
    # No identity at all: the compaction turn must not message anyone, or pass for the root.
    proc = run_cli(argv, cwd=entry["cwd"], env=claude_env(), timeout=COMPACT_TIMEOUT)
    return proc.returncode == 0, (proc.stderr or proc.stdout).strip()[-300:]


# ── worktrees ────────────────────────────────────────────────────────────


def slugify(text: str, limit: int) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return slug[:limit].strip("-") or "x"


def default_base(repo_top: Path) -> str:
    try:
        return git("rev-parse", "--abbrev-ref", "origin/HEAD", cwd=repo_top)
    except MeshError:
        return "HEAD"


def add_worktree(run_id: str, repo_top: Path, slug: str, base: str | None) -> tuple[Path, str, str]:
    """A worktree on a new run branch; the base commit is kept so `mesh stop` can tell an untouched branch."""
    branch = f"mesh/{run_id}/{slug}"
    path = worktree_root() / run_id / f"{slugify(repo_top.name, 20)}-{slug}"
    sha = git("rev-parse", "--verify", f"{base or default_base(repo_top)}^{{commit}}", cwd=repo_top)
    path.parent.mkdir(parents=True, exist_ok=True)
    git("worktree", "add", "-b", branch, str(path), sha, cwd=repo_top)
    with editing_run(run_id) as run:
        run.setdefault("worktrees", []).append({"path": str(path), "repo": str(repo_top), "branch": branch, "base": sha})
    log_event(run_id, "worktree", path=str(path), branch=branch)
    return path, branch, sha


def entry_branch(run: dict, entry: dict) -> str | None:
    """An agent's branch; a restart with --cwd records none, so look its worktree up."""
    if entry.get("branch"):
        return entry["branch"]
    cwd = entry.get("cwd")
    return next((wt["branch"] for wt in run.get("worktrees", []) if cwd and Path(wt["path"]) == Path(cwd)), None)


def ensure_worktree(entry: dict, branch: str | None) -> bool:
    """Bring a removed worktree back at its old path, where Claude looks for the session. True if recreated."""
    path = Path(entry["cwd"])
    if path.exists():
        return False
    if not branch or not entry.get("repo"):
        raise MeshError(f"{path} is gone and no branch is recorded for it")
    try:
        git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", cwd=entry["repo"])
        new_branch = []
    except MeshError:
        if not entry.get("base"):
            raise MeshError(f"branch {branch} no longer exists in {entry['repo']}") from None
        new_branch = ["-b", branch]  # `mesh stop` deleted it because it had no commits: start it again at its base
    git("worktree", "prune", cwd=entry["repo"])
    path.parent.mkdir(parents=True, exist_ok=True)
    git("worktree", "add", *new_branch, str(path), *([entry["base"]] if new_branch else [branch]), cwd=entry["repo"])
    return True


# ── messaging ────────────────────────────────────────────────────────────


PREVIEW_DROP = str.maketrans({"`": None, "$": None, '"': None, "'": "’"})  # an apostrophe stays readable


def preview(body: str, limit: int = 100) -> str:
    """The body on one line, short, and with nothing a receiving agent could read as shell (backticks, `$`, quotes)."""
    line = " ".join(body.translate(PREVIEW_DROP).split())
    return line if len(line) <= limit else line[: limit - 1] + "…"


def store_message(run_id: str, sender: str, to: str, mtype: str, body: str) -> Path:
    path = inbox_dir(run_id, to) / f"{stamp()}-{sender}-{mtype}.md"
    header = f"---\nrun: {run_id}\nfrom: {sender}\nto: {to}\ntype: {mtype}\ntime: {now_iso()}\n---\n"
    write_atomic(path, header + body.rstrip() + "\n")
    return path


def was_read(path: Path) -> bool:
    return not path.exists() and (path.parent / "read" / path.name).exists()


@contextmanager
def ring_lock(key: str):
    """One ring at a time into a pane (herdr merges concurrent prompts), for at most RING_LOCK_WAIT, then unlocked.

    Yields whether it got the lock. flock releases it when its process dies, so a killed ring holds nothing.
    """
    path = mesh_home() / "locks" / f"ring-{re.sub(r'[^A-Za-z0-9_.-]', '_', key)}.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as fh:
        locked = False
        for _ in range(max(1, int(RING_LOCK_WAIT / RING_LOCK_POLL))):
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                locked = True
                break
            except BlockingIOError:
                time.sleep(RING_LOCK_POLL)
        try:
            yield locked
        finally:
            if locked:
                fcntl.flock(fh, fcntl.LOCK_UN)


def ring(targets: list[str], text: str, token: str, read: tuple[Path, ...] = (),
         delays: tuple[int, ...] = RING_DELAYS) -> dict:
    """Type the doorbell into the first reachable target, retrying while it is busy, and say how it got through.

    `via` is "working" (herdr saw the agent start), "pane" (the doorbell's token showed up above the input box),
    or "read" (the messages in `read` were read meanwhile, so nothing more is typed). herdr can miss that a busy
    agent queued the text (it returns stalled or timeout), hence the pane check, after such an error and before
    each retry; a pane that couldn't be read before the first try is never checked, since a later read can't
    tell what was there before. A human's draft in the input box holds the try (herdr would submit the doorbell
    fused to it); an unclear box doesn't. `tries` counts the prompts herdr took (not those it refused before
    typing: `agent_not_found`, `agent_blocked`). One attempt holds the pane's ring lock, keyed by the last
    target (the pane id), never the backoff sleeps.
    """
    needle = ring_needle(token)
    before: dict[str, int | None] = {}  # copies of the token above each target's input box before it was typed
    last_error, tries = None, 0
    for delay in (0, *delays):
        if delay:
            time.sleep(delay)
        if read and all(was_read(path) for path in read):
            return {"rung": True, "error": None, "via": "read", "tries": tries}
        with ring_lock(targets[-1]):
            for target in targets:
                lines = pane_lines(target, ansi=True)
                plain = None if lines is None else [strip_sgr(line) for line in lines]
                if target not in before:
                    before[target] = doorbells_shown(plain, needle)
                elif before[target] is not None and (doorbells_shown(plain, needle) or 0) > before[target]:
                    return {"rung": True, "error": None, "via": "pane", "tries": tries}  # queued after the last try
                if human_draft(lines):
                    last_error = "human_draft"
                    break
                try:
                    # --until working confirms delivery: an idle agent that doesn't start working
                    # within 5s never got the text (agent_prompt_stalled), so it is retried. A busy
                    # agent queues the doorbell for after its current turn, but herdr may not see it
                    # as working (agy between steps, Claude running a command): hence the pane check.
                    herdr("agent", "prompt", target, text, "--wait", "--until", "working", "--timeout", "15000",
                          timeout=30)
                    return {"rung": True, "error": None, "via": "working", "tries": tries + 1}
                except HerdrError as exc:
                    last_error = exc.code
                    if exc.code not in UNTYPED_RING_ERRORS:
                        tries += 1
                    if exc.code == "agent_not_found":
                        continue  # try the next target (the pane id)
                    if exc.code in TYPED_RING_ERRORS and before[target] is not None:
                        shown = doorbells_shown(pane_lines(target), needle)
                        if shown is not None and shown > before[target]:
                            return {"rung": True, "error": None, "via": "pane", "tries": tries}
                    if exc.code not in RETRYABLE_RING_ERRORS:
                        return {"rung": False, "error": exc.code, "via": None, "tries": tries}
                    break
    return {"rung": False, "error": last_error, "via": None, "tries": tries}


def ring_stored(run_id: str, sender: str, to: str, targets: list[str], text: str, token: str, path: Path,
                delays: tuple[int, ...] = RING_DELAYS, read: tuple[Path, ...] = ()) -> dict:
    """Ring for a stored message (or the unread ones in `read`), and log how it went.

    The event has no `type` field: a ring is never counted as a send.
    """
    result = ring(targets, text, token, read=read or (path,), delays=delays)
    if result["rung"]:
        log_event(run_id, "rung", sender=sender, to=to, file=path.name, via=result["via"], tries=result["tries"])
    else:
        log_event(run_id, "doorbell_failed", sender=sender, to=to, file=path.name, error=result["error"],
                  tries=result["tries"])
    return result


def ring_token() -> str:
    return secrets.token_hex(3)


def doorbell_text(run: dict, sender: str, to: str, mtype: str, body: str, first: bool, token: str | None = None) -> str:
    """The one-line doorbell; a rung one carries its `token`, which ring() looks for in the pane.

    The token goes early, where a CLI that shortens a long queued prompt keeps it. The start of a first doorbell,
    up to `run <id>`, is how resume finds an agent's conversation (first_doorbell, agy_conversation): keep it.
    """
    ref = f" (ref {token})" if token else ""
    if first:
        entry = run["agents"][to]
        if entry.get("swapped"):
            return (
                f"📬 [mesh] You are {to} ({entry['role']}) again in agent-mesh run {run['id']}{ref}, now on "
                f"{entry.get('model')} at {entry.get('effort')} effort; same parent and worktree. Run `mesh inbox` for your {mtype}."
            )
        if entry.get("resumed_from"):
            return (
                f"📬 [mesh] You are {to} ({entry['role']}) again, resumed into agent-mesh run {run['id']}{ref}; your "
                f"parent is {entry['parent']}. The run id, parent and paths changed, and background tasks from "
                f"before (`task-…` ids) are gone: re-read {PROTOCOL_PATH}, then run `mesh inbox` for your {mtype}."
            )
        return (
            f"📬 [mesh] You are {to} ({entry['role']}) in agent-mesh run {run['id']}{ref}; your parent is "
            f"{entry['parent']}. Read {PROTOCOL_PATH}, then run `mesh inbox` for your {mtype}."
        )
    return f"📬 [mesh] {mtype} from {sender}{ref}: {preview(body)} (run `mesh inbox`)"


def record(run_id: str, sender: str, to: str, mtype: str, body: str) -> Path:
    """Store a message in `to`'s mailbox and log it, without telling anyone."""
    path = store_message(run_id, sender, to, mtype, body)
    log_event(run_id, "send", sender=sender, to=to, type=mtype, file=path.name)
    return path


def native_route(run: dict, sender: str, to: str) -> str | None:
    """The address a Claude sender passes to SendMessage instead of ringing `to`'s pane, or None to ring it.

    Claude to Claude only: a worker reaches a Claude root by its socket, so nothing is typed into the pane the
    user works in, and a background worker, which has no pane, is reached by its own socket while it runs.
    """
    if run["agents"].get(sender, {}).get("kind") != "claude":
        return None
    entry = run["agents"][to]
    if entry.get("role") == "root":
        return entry["address"] if address_alive(entry.get("address")) else None
    if entry.get("view") == "bg":
        row = bg_row(entry)
        if row and row.get("status"):
            return socket_address(row.get("pid")) or to
    return None


def delivered(delivery: dict) -> bool:
    """Rung, handed back as a SendMessage, the opening prompt of a background session (`launched`), or a report
    a fan-out collects (`collected`)."""
    return bool(delivery.get("rung") or "send_message" in delivery or delivery.get("launched")
                or delivery.get("collected"))


def refuse_headless(name: str, entry: dict, what: str) -> None:
    """A Copilot asker has no pane, mailbox reader or model swap: only `mesh ask` reaches it."""
    if entry.get("view") == "headless":
        raise MeshError(f"{name} is a headless Copilot asker, which {what} doesn't reach: "
                        f"ask it again with `mesh ask {name} --body …`")


def deliver(run_id: str, sender: str, to: str, mtype: str, body: str, first: bool = False,
            stored=None, delays: tuple[int, ...] = RING_DELAYS) -> dict:
    """Store the message, then ring `to`'s doorbell, or hand back the SendMessage that tells it (`send_message`).

    `stored()` runs between the two: what the recipient may act on must be recorded before it hears.
    """
    run = load_run(run_id)
    entry = agent_entry(run, to)
    refuse_headless(to, entry, f"a `{mtype}` message")
    path = record(run_id, sender, to, mtype, body)
    if stored:
        stored()
        run = load_run(run_id)
    if mtype in FINAL_TYPES and collecting(run["agents"].get(sender) or {}, to):
        # `mesh ask --peers` collects it from the mailbox into one file: no doorbell, no SendMessage
        log_event(run_id, "collected", sender=sender, to=to, file=path.name)
        return {"stored": str(path), "rung": False, "error": None, "collected": True}
    if entry.get("held"):  # at a startup screen: typing would answer it; release_held rings once it's gone
        try:
            at_screen = agent_status(to, entry) in ("blocked", "unknown")
        except HerdrError:
            at_screen = True  # can't tell: holding never types into a dialog
        with editing_run(run_id) as run:
            held = run["agents"][to].get("held") if at_screen else run["agents"][to].pop("held", None)
            if held and at_screen and not held.get("file"):  # nothing stored to ring for yet: this one is
                held.update(sender=sender, type=mtype, file=path.name)
        if held and at_screen:
            return {"stored": str(path), "rung": False, "type": mtype, "held": held["screen"],
                    "error": f"waiting at a startup screen ({held['screen']})"}
        first = first or bool(held)  # the screen is gone but its first doorbell never rang
    first = first or bool(entry.get("swapped"))  # until a doorbell rings, the worker hasn't heard it was reopened
    route = native_route(run, sender, to)
    if route:  # no token: nothing reads a pane for it
        log_event(run_id, "native", sender=sender, to=to, address=route, file=path.name)
        return {"stored": str(path), "rung": False, "error": None,
                "send_message": {"to": route, "message": doorbell_text(run, sender, to, mtype, body, first)}}
    if entry.get("view") == "bg":
        error = f"{to} is not running; `mesh resume {to}` brings it back to read it"
        log_event(run_id, "doorbell_failed", sender=sender, to=to, file=path.name, error=error)
        return {"stored": str(path), "rung": False, "error": error}
    token = ring_token()
    targets = [to] + ([entry["pane"]] if entry.get("pane") else [])
    result = ring_stored(run_id, sender, to, targets, doorbell_text(run, sender, to, mtype, body, first, token),
                         token, path, delays)
    if result["rung"] and entry.get("swapped"):
        with editing_run(run_id) as run:
            run["agents"][to].pop("swapped", None)
    return {"stored": str(path), "rung": result["rung"], "error": result["error"], "via": result["via"]}


def collector(me: str) -> dict:
    """What `ask --peers` marks its askers with: who collects their answers, and the fan-out's process."""
    return {"to": me, "pid": os.getpid(), "start": proc_start(os.getpid())}


def collecting(entry: dict, to: str) -> bool:
    """A fan-out that is still running collects this worker's answer to `to`; a killed one's mark is stale."""
    mark = entry.get("collect")
    return isinstance(mark, dict) and mark.get("to") == to and pid_alive(mark.get("pid"), mark.get("start"))


def unread(run_id: str, name: str) -> list[Path]:
    folder = inbox_dir(run_id, name)
    return sorted(p for p in folder.glob("*.md")) if folder.exists() else []


def mark_read(path: Path) -> None:
    read = path.parent / "read"
    read.mkdir(parents=True, exist_ok=True)
    os.replace(path, read / path.name)


def parse_message(path: Path) -> tuple[dict, str]:
    text = path.read_text()
    meta: dict[str, str] = {}
    body = text
    if text.startswith("---\n"):
        head, _, body = text[4:].partition("\n---\n")
        for line in head.splitlines():
            key, _, value = line.partition(": ")
            meta[key] = value
    return meta, body


def unread_received(run_id: str, name: str) -> list[dict]:
    """The tasks and answers still unread in `name`'s mailbox: what it has yet to act on."""
    found = []
    for path in unread(run_id, name):
        if path.stem.rsplit("-", 1)[-1] not in RECEIVED_TYPES:
            continue
        meta, body = parse_message(path)
        found.append({"type": meta.get("type"), "from": meta.get("from"), "time": meta.get("time"),
                      "gist": first_line(body.strip(), 100)})
    return found


# ── commands ─────────────────────────────────────────────────────────────


def emit(data, as_json: bool = True) -> None:
    print(json.dumps(data, indent=2) if as_json else data)


def init_run(mode: str | None, request: str | None, run_id: str | None = None) -> dict:
    """Start a run with this pane's agent as its root (mode None: the root's own CLI)."""
    pane = os.environ.get("HERDR_PANE_ID")
    if os.environ.get("HERDR_ENV") != "1" or not pane:
        raise MeshError("mesh init must run inside a herdr pane (HERDR_ENV=1)")
    run_id = run_id or "m" + secrets.token_hex(2)
    if not NAME_RE.match(run_id) or len(run_id) > 12:
        raise MeshError("run id must be short, lowercase, start with a letter")
    if run_dir(run_id).exists():
        raise MeshError(f"run {run_id} already exists")
    agents = herdr("agent", "list").get("agents", [])
    me = next((a for a in agents if a.get("pane_id") == pane), None)
    if me is None:
        raise MeshError(f"herdr sees no agent in pane {pane}")
    if os.environ.get("CLAUDE_CODE_SESSION_ID") and pane_runs_this_claude(pane) is False:
        raise MeshError(f"Claude session {os.environ['CLAUDE_CODE_SESSION_ID']} isn't the process running in pane "
                        f"{pane}, so it can't be its root ({NOT_LEADER_HINT})")
    mode = mode or (me.get("agent") if me.get("agent") in MODES else "agy")
    # A root you already named keeps its name; otherwise it becomes `<repo>-lead`.
    name = me.get("name") or agent_name(repo_name(me.get("cwd")), "lead", {a["name"] for a in agents if a.get("name")})
    if name != me.get("name"):
        herdr("agent", "rename", pane, name)
    run = {
        "id": run_id,
        "version": VERSION,
        "mode": mode,
        "created": now_iso(),
        "root": name,
        "request": request or "",
        "agents": {
            name: {
                "role": "root",
                "kind": me.get("agent"),
                "pane": pane,
                "tab": me.get("tab_id"),
                "workspace": me.get("workspace_id"),
                "cwd": me.get("cwd"),
                "parent": None,
                "status": "running",
                "renamed": name != me.get("name"),
                # Claude workers report to a Claude root with SendMessage, at this address (see native_route).
                "address": claude_address() if me.get("agent") == "claude" else None,
            }
        },
        "tabs": {},
        "worktrees": [],
    }
    with run_lock(run_id):
        save_run(run_id, run)
    write_atomic(mesh_home() / "by-pane" / f"{pane_key(pane)}.json", json.dumps({"run": run_id, "name": name}))
    log_event(run_id, "init", name=name, mode=mode)
    return {"run": run_id, "name": name, "dir": str(run_dir(run_id)), "mode": mode,
            "address": run["agents"][name]["address"]}


def cmd_init(args: argparse.Namespace) -> int:
    emit(init_run(args.mode, args.request, args.run_id))
    return 0


def spawn_suffix(args: argparse.Namespace, run: dict) -> str:
    """A worker is named for its worktree slug, so the name says what it works on."""
    if args.name:
        return args.name
    if args.worktree:
        return args.worktree
    if args.cwd:  # a restart in an earlier worker's worktree: reuse its slug (agent_name adds -2)
        cwd = Path(args.cwd).expanduser().resolve()
        for wt in run.get("worktrees", []):
            if Path(wt["path"]).resolve() == cwd:
                return wt["branch"].rsplit("/", 1)[-1]
    return f"worker{sum(a['role'] == 'worker' for a in run['agents'].values()) + 1}"


def worker_log(run_id: str, name: str) -> str:
    """Where an agy worker's log goes (`mesh watch` reads quota errors from it)."""
    path = run_dir(run_id) / "logs" / f"{name}.log"
    path.parent.mkdir(parents=True, exist_ok=True)
    return str(path)


def mesh_env(run_id: str, name: str, parent: str, role: str) -> dict[str, str]:
    """A worker's identity, and the configuration this process runs with (only the keys that are set)."""
    env = {"MESH_RUN": run_id, "MESH_SELF": name, "MESH_PARENT": parent, "MESH_ROLE": role}
    env.update({key: os.environ[key] for key in MESH_CONFIG if os.environ.get(key)})
    return env


def cmd_spawn(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    result = spawn_worker(args, run_id, me)
    emit(result)
    held = report_held(result["name"], result.get("delivery"))  # the alert first: only the user can clear it
    warn_unwatched(run_id)
    return held or 0


def spawn_worker(args: argparse.Namespace, run_id: str, me: str) -> dict:
    repo_top = Path(git("rev-parse", "--show-toplevel", cwd=Path(args.repo).expanduser())).resolve()
    run = load_run(run_id)
    taken = set(run["agents"]) | live_agent_names()
    name = getattr(args, "agent", None) or agent_name(repo_top.name, spawn_suffix(args, run), taken)
    if getattr(args, "agent", None) and name in taken:
        raise MeshError(f"{name} is taken in this run or by a live agent")
    peer = getattr(args, "peer", None)

    # Resolve the model before any side effect, so a failed lookup leaves no orphan worktree.
    size = getattr(args, "size", None) or "large"
    sized = SIZE_DEFAULTS.get((args.kind, size))
    user_review = getattr(args, "plan_review", None) == "user"
    if (sized or user_review) and (args.exec_model or args.exec_effort):
        raise MeshError(f"a {'user-reviewed' if user_review else size} task has no execution phase: "
                        "drop --exec-model / --exec-effort")
    if user_review and (args.kind != "claude" or sized):
        raise MeshError("--plan-review user is for a large Claude task (Opus in plan mode, in a pane)")
    named = args.model if args.model != "auto" else None  # `auto` names the plan chain, which these tasks skip
    if sized:  # one model for the whole task, and no plan phase
        auto, exec_model, exec_effort = False, None, None
        model, effort, notes = named or sized["model"], args.effort or sized["effort"], []
    elif user_review:  # Claude Code leaves plan mode when the user approves the plan, on the same model
        auto, exec_model, exec_effort = False, None, None
        model, effort, notes = named or USER_REVIEW_MODEL, args.effort or DEFAULT_EFFORT, []
    else:
        # `auto` plans on the best model with quota and switches to the exec model at `mesh approve`.
        auto = (args.model or "auto") == "auto"
        exec_model = args.exec_model or (EXEC_MODEL[args.kind] if auto else None)
        if args.exec_effort and not exec_model:
            raise MeshError("--exec-effort needs an execution phase: drop --model, or add --exec-model")
        # A named --effort covers the whole task; --exec-effort alone overrides the execution phase.
        effort = args.effort or DEFAULT_EFFORT
        exec_effort = (args.exec_effort or args.effort or EXEC_EFFORT) if exec_model else None
        if exec_model:
            resolve_model(args.kind, exec_model, exec_effort)  # fail now, not after a whole planning phase
        model, notes = plan_model(args.kind, effort) if auto else (args.model, [])
    view = getattr(args, "view", None) or (sized["view"] if sized else "pane")
    if view == "bg" and (args.kind != "claude" or user_review):
        if getattr(args, "view", None):
            raise MeshError("--view bg is for Claude workers (agy has no background sessions; a user-reviewed "
                            "plan needs a pane)")
        view = "pane"
    if view == "bg" and not address_alive(run["agents"][run["root"]].get("address")):
        notes.append("background needs a Claude root that background workers can message; starting a pane")
        view = "pane"
    # A named model or effort with no exec phase covers the whole task, a later one included (has_phases).
    # `mesh ask` says itself whether its effort was named (a sized reviewer's REVIEW_EFFORT isn't).
    pinned = getattr(args, "pinned", None)
    pinned = not exec_model and bool(named or args.effort if pinned is None else pinned)
    log = worker_log(run_id, name) if args.kind == "agy" else None
    argv, model, session = agent_argv(args.kind, model, effort, log)
    if user_review:
        argv = [a for a in argv if a != "--dangerously-skip-permissions"]
        argv += ["--permission-mode", "plan", "--allow-dangerously-skip-permissions"]
    branch = base = None
    if args.worktree:
        cwd, branch, base = add_worktree(run_id, repo_top, slugify(args.worktree, 24), args.base)
    elif args.cwd:
        cwd = Path(args.cwd).expanduser().resolve()
    else:
        cwd = repo_top

    parent = args.parent or me
    task = read_body(args.task, args.task_file)
    if task and (sized or user_review) and not task.startswith(READ_ONLY_STARTS):
        task = f"{DIRECT_PREFIX if sized else USER_REVIEW_PREFIX}\n\n{task}"
    read_only = args.kind == "claude" and read_only_task(task)
    # A large task plans first, under the deny list until `mesh approve` lifts it; with no task yet, it will.
    planning = args.kind == "claude" and not (sized or user_review or read_only) and (not task or planned_task(task))
    deny = claude_deny({"kind": args.kind, "read_only": read_only, "planning": planning, "cwd": cwd, "repo": repo_top})
    env = mesh_env(run_id, name, parent, args.role)
    with editing_run(run_id) as run:
        run["agents"][name] = {
            "role": args.role, "kind": args.kind, "model": model, "effort": effort, "size": size, "view": view,
            "plan_review": "user" if user_review else None, "pinned": pinned, "read_only": read_only,
            "planning": planning,
            "repo": str(repo_top), "cwd": str(cwd), "branch": branch, "base": base, "session": session, "pane": None,
            "tab": None, "workspace": None, "parent": parent, "status": "starting", "spawned": now_iso(),
            "log": log, "phase": "plan" if exec_model else None, "exec_model": exec_model, "exec_effort": exec_effort,
            "models": [{"model": model, "effort": effort, "at": now_iso(), "why": "spawn"}],
            **({"peer": peer} if peer else {}),
            **({"collect": args.collect} if getattr(args, "collect", None) else {}),
        }
    result = {"name": name, "cwd": str(cwd), "branch": branch, "model": model, "effort": effort, "size": size,
              "exec_model": exec_model, "notes": notes}

    task_path = None
    if view == "bg":
        # The task waits in the mailbox; the first doorbell is the session's opening prompt.
        task_path = record(run_id, me, name, "task", task) if task else None
        prompt = doorbell_text(load_run(run_id), me, name, "task", task or "", first=True)
        try:
            bg_id, session = launch_bg(name, cwd, model, effort, env, prompt, extra=deny)
        except MeshError as exc:  # untrusted folder, or a launch that didn't take
            notes.append(f"{exc}; starting a pane instead")
            view = "pane"
        else:
            with editing_run(run_id) as run:
                run["agents"][name].update(bg_id=bg_id, session=session, status="running")
            log_event(run_id, "spawn", name=name, kind=args.kind, role=args.role, model=model, view="bg",
                      bg_id=bg_id, parent=parent)
            result.update(view="bg", bg_id=bg_id, session=session)
            if task_path:
                result["delivery"] = {"stored": str(task_path), "rung": False, "error": None, "launched": True}
            return result

    pane, tab, workspace_id, created_ws = place_pane(run_id, name, repo_top, cwd, env)
    with editing_run(run_id) as run:
        run["agents"][name].update(view="pane", pane=pane, tab=tab, workspace=workspace_id)
    log_event(run_id, "spawn", name=name, kind=args.kind, role=args.role, model=model, pane=pane, parent=parent)

    started = start_agent(name, args.kind, pane, [*deny, *argv, *settings_argv(args.kind, env)], peer=bool(peer))
    with editing_run(run_id) as run:
        run["agents"][name]["status"] = "running"

    result.update(view="pane", pane=pane, workspace=workspace_id, workspace_created=created_ws)
    if started.get("held"):  # at a startup screen: no ring now, the watch rings once it's gone
        result["delivery"] = hold(run_id, me, name, "task", task, started, stored=task_path)
    elif task_path:  # stored before a background launch that fell back to this pane
        token = ring_token()
        rang = ring_stored(run_id, me, name, [name, pane],
                           doorbell_text(load_run(run_id), me, name, "task", task, True, token), token, task_path)
        result["delivery"] = {"stored": str(task_path), "rung": rang["rung"], "error": rang["error"], "via": rang["via"]}
    elif task:
        result["delivery"] = deliver(run_id, me, name, "task", task, first=True)
    return result


def plan_model(kind: str, effort: str) -> tuple[str, list[str]]:
    if kind == "agy":
        return choose_agy_model(PLAN_CHAIN["agy"], effort)
    return PLAN_CHAIN["claude"][0], []


def swap_bg(run_id: str, name: str, entry: dict, session: str, model: str, effort: str, why: str,
            wait_ms: int, strict: bool, message: tuple[str, str, str], lift: bool) -> dict:
    """swap_model for a background worker: stop it, then start a copy of its conversation on the new model.

    The message goes into its mailbox first, since the copy's opening prompt is the doorbell for it.
    """
    wait_bg_idle(entry, wait_ms, strict)
    sender, mtype, body = message
    path = record(run_id, sender, name, mtype, body)
    with editing_run(run_id) as run:  # "starting" before the stop, so `mesh watch` doesn't take the gap for an exit
        e = run["agents"][name]
        e.update(model=model, effort=effort, status="starting", swapped=True, **lifted(entry, lift))
        e.setdefault("models", []).append({"model": model, "effort": effort, "at": now_iso(), "why": why})
    stop_bg(entry)
    prompt = doorbell_text(load_run(run_id), sender, name, mtype, body, first=True)
    try:
        bg_id, new_session = launch_bg(name, entry["cwd"], model, effort,
                                       mesh_env(run_id, name, entry["parent"], entry["role"]), prompt, resume=session,
                                       extra=claude_deny({**entry, **lifted(entry, lift)}))
    except MeshError as exc:
        with editing_run(run_id) as run:
            e = run["agents"][name]
            e.update(model=entry.get("model"), effort=entry.get("effort"), status="swap_failed",
                     **lifted(entry, False))
            e.pop("swapped", None)
            e["models"].pop()
        log_event(run_id, "swap_failed", name=name, model=model, effort=effort, why=why, error=str(exc))
        raise MeshError(f"{name} was not reopened on {model} ({exc}); its {mtype} is in its mailbox, retry") from exc
    with editing_run(run_id) as run:
        e = run["agents"][name]
        e.update(bg_id=bg_id, session=new_session, status="running")
        e.pop("swapped", None)
        e.setdefault("sessions", []).append(session)  # the conversation it was copied from
    log_event(run_id, "swap", name=name, model=model, effort=effort, why=why, bg_id=bg_id, session=new_session)
    return {"name": name, "model": model, "bg_id": bg_id, "previous": entry.get("model"),
            "delivery": {"stored": str(path), "rung": False, "error": None, "launched": True}}


def lifted(entry: dict, lift: bool) -> dict:
    """The deny-list reasons (claude_deny) a reopen records: none when it lifts the list, else the entry's own."""
    return {key: False if lift else bool(entry.get(key)) for key in ("read_only", "planning")}


def swap_model(run_id: str, name: str, model: str, effort: str, why: str, wait_ms: int = 600_000,
               strict: bool = True, message: tuple[str, str, str] | None = None,
               lift: bool = False) -> dict:
    """Restart a worker on another model or effort in the same conversation, pane by pane, keeping its name.

    Waits up to `wait_ms` for the worker's turn to end. `strict` fails if it doesn't; a worker that
    hit a quota is not strict, since its turn is already dead whatever herdr shows. A background worker
    gets `message` (sender, type, body) as its opening prompt (the result's `delivery`); for a pane the
    caller delivers it once the pane is back. `lift` reopens it without its deny list (claude_deny), clearing
    both of its reasons; otherwise it keeps whatever it had.
    """
    entry = agent_entry(load_run(run_id), name)
    refuse_headless(name, entry, "a model swap")
    session = find_session(run_id, name, entry)
    if not session:
        raise SwapNotStarted(f"can't find {name}'s {entry.get('kind')} conversation, so its model can't be switched; "
                             f"start a fresh worker with `mesh spawn --cwd {entry.get('cwd')}` if it must change")
    if entry.get("view") == "bg":
        return swap_bg(run_id, name, entry, session, model, effort, why, wait_ms, strict,
                       message or ("mesh", "info", f"You are now on {model} at {effort} effort."), lift)
    try:  # never cut a turn short: the conversation is only safe to reopen between turns
        herdr("agent", "wait", name, "--until", "idle", "--until", "done", "--timeout", str(wait_ms),
              timeout=wait_ms / 1000 + 10)
    except HerdrError as exc:
        if exc.code != "agent_not_found" and (strict or exc.code not in ("timeout", "cli_error")):
            if exc.code == "timeout":
                raise SwapNotStarted(f"{name} didn't finish its turn ({exc})") from exc
            raise
    # The new pane opens beside the old one before that closes, so its tab survives: the root's, else the run's.
    env = mesh_env(run_id, name, entry["parent"], entry["role"])
    run = load_run(run_id)
    side = bool(entry.get("tab")) and entry["tab"] == run["agents"][run["root"]].get("tab")
    beside = side and beside_root(run_id, name, Path(entry["cwd"]), env, replacing=entry.get("pane"))
    if beside:
        pane, tab, workspace_id = beside
    else:  # a side worker's recorded workspace is the root's, so it goes to its project's
        workspace_id = (not side and entry.get("workspace")) or find_or_create_workspace(Path(entry["repo"]))[0]
        pane, tab = new_pane(run_id, workspace_id, Path(entry["cwd"]), env)
    with editing_run(run_id) as run:  # "starting" first, so `mesh watch` doesn't take the gap for an exit
        e = run["agents"][name]
        e.update(model=model, effort=effort, pane=pane, tab=tab, workspace=workspace_id, session=session,
                 status="starting", swapped=True, **lifted(entry, lift))
        e.setdefault("models", []).append({"model": model, "effort": effort, "at": now_iso(), "why": why})
    argv = [*log_argv(entry.get("log")), *claude_deny({**entry, **lifted(entry, lift)}),
            *resume_argv(entry["kind"], session, model, effort), "--dangerously-skip-permissions",
            *settings_argv(entry["kind"], env)]
    try:
        try:
            herdr("pane", "close", entry["pane"])
        except HerdrError as exc:
            if exc.code not in ("pane_not_found", "agent_not_found"):
                raise
        log_event(run_id, "swap", name=name, model=model, effort=effort, why=why, pane=pane, session=session)
        started = start_agent(name, entry["kind"], pane, argv, peer=bool(entry.get("peer")))
    except MeshError as exc:
        with editing_run(run_id) as run:  # the old model is still the recorded one, so a retry swaps again
            e = run["agents"][name]
            e.update(model=entry.get("model"), effort=entry.get("effort"), status="swap_failed",
                     **lifted(entry, False))
            e.pop("swapped", None)
            e["models"].pop()
        log_event(run_id, "swap_failed", name=name, model=model, effort=effort, why=why, error=str(exc))
        raise MeshError(f"{name} was not reopened on {model} ({exc}); look at it with "
                        f"`herdr agent read {name}`, then retry") from exc
    with editing_run(run_id) as run:
        run["agents"][name]["status"] = "running"
    result = {"name": name, "model": model, "pane": pane, "previous": entry.get("model")}
    if started.get("held") and message:  # the caller would ring a pane at a startup screen: hold it instead
        result["delivery"] = hold(run_id, message[0], name, message[1], message[2], started)
    return result


def require_parent(run: dict, me: str, name: str, command: str) -> dict:
    """`name`'s entry, if `me` may run `mesh <command>` on it: its parent, or the run's root.

    `--as` is taken as given: what this stops is the accidental call, such as a worker approving its own plan.
    """
    entry = agent_entry(run, name)
    if entry.get("role") == "root":
        raise MeshError(f"{name} is the run's root, and `mesh {command}` acts on a worker "
                        "(`mesh stop` ends the run)")
    if me in (entry.get("parent"), run["root"]):
        return entry
    log_event(run["id"], "refused", name=me, command=command, agent=name)
    if me == name:
        raise MeshError(f"`mesh {command}` is for your parent ({entry.get('parent')}), not for you: send it a "
                        "`plan` or a `question` with `mesh send parent`, and wait for its answer")
    raise MeshError(f"only {name}'s parent ({entry.get('parent')}) runs `mesh {command}` on it, and this is {me} "
                    f"(acting for the parent from another terminal: pass --run {run['id']} --as {entry.get('parent')})")


def refuse_no_plan(run_id: str, name: str, entry: dict) -> None:
    """Approve only a plan that waits for its answer: the worker's newest report since its last task or answer.

    A worker whose bg swap failed at approval was already sent its approval, before the launch (`swap_bg`):
    the retry that ORCHESTRATE offers approves it again. Only that swap: a failed `mesh switch` while planning
    leaves the same status, with nothing approved. A pinned planner has no phase, but its `planning` says it.
    """
    events = read_log(run_id)
    if entry.get("status") == "swap_failed" and (entry.get("phase") == "plan" or entry.get("planning")):
        failed = [e for e in events if e.get("event") == "swap_failed" and e.get("name") == name]
        if failed and failed[-1].get("why") == "plan approved":
            return
    report, received = last_report(events, name)
    if report and report.get("type") == "plan":
        return
    if report:
        what = (f"answer it with `mesh send {name} --type answer`, and approve the plan it then sends again"
                if report["type"] == "question" else "there is nothing to approve")
        raise MeshError(f"{name} has no plan waiting: its newest report, at {report.get('time')}, is a "
                        f"{report['type']}; {what}")
    if received:
        hint = (f" (if that was the approval and its doorbell didn't ring, `mesh ring {name}`)"
                if received.get("type") == "answer" else "")
        raise MeshError(f"{name} has no plan waiting: it hasn't reported since the {received.get('type')} it got "
                        f"from {received.get('sender')} at {received.get('time')}{hint}")
    raise MeshError(f"{name} has no plan waiting: it hasn't sent one")


def cmd_approve(args: argparse.Namespace) -> int:
    """Approve a worker's plan; a worker on `auto` moves to its exec model first, keeping its conversation."""
    run_id, me = identity(args)
    entry = require_parent(load_run(run_id), me, args.agent, "approve")
    refuse_headless(args.agent, entry, "`mesh approve`")
    refuse_no_plan(run_id, args.agent, entry)
    result: dict = {"name": args.agent, "model": entry.get("model")}
    extra = read_body(args.body, args.file)
    body = "approved" + (f"\n\n{extra.strip()}" if extra and extra.strip() else "")
    # A Claude planner runs with its deny list until now: whatever else happens, the reopen lifts it (design §9).
    denied = bool(entry.get("planning") and claude_deny(entry))
    model, effort = entry.get("model"), entry.get("effort")
    if entry.get("phase") == "plan" and entry.get("exec_model"):
        if args.keep_model:  # asked for, never a fallback: it executes on what it planned on
            if not denied:  # else the reopen below records it, and logs this once it has started
                with editing_run(run_id) as run:
                    run["agents"][args.agent].setdefault("models", []).append(
                        {"model": entry.get("model"), "effort": entry.get("effort"), "at": now_iso(),
                         "why": "plan approved", "kept": True})
                log_event(run_id, "approve_kept_model", name=args.agent, model=entry.get("model"))
            result["kept_model"] = True
        else:
            effort = entry.get("exec_effort") or EXEC_EFFORT
            model = resolve_model(entry["kind"], entry["exec_model"], effort)
    if denied or (model, effort) != (entry.get("model"), entry.get("effort")):
        try:
            result["swap"] = swap_model(run_id, args.agent, model, effort, "plan approved",
                                        message=(me, "answer", body), lift=True)
        except SwapNotStarted as exc:
            if denied:  # --keep-model reopens it too: nothing gets its edits back but a reopen
                raise MeshError(f"{exc}. Nothing was sent. {args.agent} plans with its edits denied, and only "
                                f"reopening its conversation lifts that: run `mesh approve {args.agent}` again once "
                                "its turn has ended") from exc
            raise MeshError(f"{exc}. Nothing was sent. To approve it on {entry.get('model')} instead, run "
                            f"`mesh approve {args.agent} --keep-model`: it is then recorded as executing, so a "
                            f"later `mesh switch` moves it to {entry['exec_model']}") from exc
        result["model"] = model
        if result.get("kept_model"):
            log_event(run_id, "approve_kept_model", name=args.agent, model=model)
    if entry.get("phase") == "plan" and entry.get("exec_model"):
        with editing_run(run_id) as run:
            run["agents"][args.agent]["phase"] = "exec"
    result["delivery"] = (result.get("swap") or {}).pop("delivery", None) or deliver(
        run_id, me, args.agent, "answer", body, first="swap" in result)
    emit(result)
    held = report_held(args.agent, result["delivery"])
    warn_unwatched(run_id)
    return held or (0 if delivered(result["delivery"]) else 2)


def models_tried(entry: dict) -> tuple[str, ...]:
    """Every model the worker has run on in its current phase: `switch` never goes back to one."""
    models = entry.get("models", [])
    marker = "plan approved" if entry.get("phase") == "exec" else "planned task"
    start = next((i for i in range(len(models) - 1, -1, -1) if models[i].get("why") == marker), 0)
    return tuple({entry.get("model"), *(m["model"] for m in models[start:])})


def cmd_switch(args: argparse.Namespace) -> int:
    """Move a worker that hit a quota to the next model with quota left, and tell it to carry on."""
    run_id, me = identity(args)
    entry = require_parent(load_run(run_id), me, args.agent, "switch")
    refuse_headless(args.agent, entry, "`mesh switch`")
    effort = entry.get("effort") or DEFAULT_EFFORT
    if entry.get("phase") == "exec" and not args.model:  # after `approve --keep-model` it still has the plan's
        effort = entry.get("exec_effort") or EXEC_EFFORT
    notes: list[str] = []
    if args.model:
        model = resolve_model(entry["kind"], args.model, effort)
        parsed = parse_agy_id(model) if entry["kind"] == "agy" else None
        effort = parsed[2] if parsed else effort  # an exact id carries its own effort
    elif entry["kind"] != "agy":
        raise MeshError("only agy quotas are known to mesh; pass --model for a claude worker")
    else:
        chain = PLAN_CHAIN["agy"] if entry.get("phase") != "exec" else (entry.get("exec_model") or EXEC_MODEL["agy"],)
        model, notes = choose_agy_model(chain, effort, skip=models_tried(entry), force=True, fallback=False)
    body = (f"Your previous model ({entry.get('model')}) hit its quota; you are now on {model}, in the same "
            "conversation. Continue exactly where you stopped.")
    swap = swap_model(run_id, args.agent, model, effort, "quota", wait_ms=60_000, strict=False,
                      message=(me, "task", body))
    delivery = swap.pop("delivery", None) or deliver(run_id, me, args.agent, "task", body, first=True)
    emit({**swap, "notes": notes, "delivery": delivery})
    held = report_held(args.agent, delivery)
    warn_unwatched(run_id)
    return held or (0 if delivered(delivery) else 2)


def quota_hit(log: str | None, offset: int) -> tuple[str | None, int]:
    """(reset time or None, new offset): the reset time ("" if unknown) of a quota error agy logged after `offset`.

    Reads only the new bytes. A log that is shorter than `offset` was truncated by a restarted agy: read it afresh.
    """
    if not log or not Path(log).exists():
        return None, offset
    with open(log, "rb") as fh:
        size = fh.seek(0, os.SEEK_END)
        offset = 0 if size < offset else offset
        fh.seek(offset)
        hit = QUOTA_RE.search(fh.read().decode(errors="replace"))
    if not hit:
        return None, size
    reset = RESET_RE.search(hit.group(0))
    return (reset.group(1) if reset else ""), size


def read_body(body: str | None, file: str | None) -> str | None:
    if file == "-":
        return sys.stdin.read()
    if file:
        return Path(file).expanduser().read_text()
    return body


def lift_read_only(run_id: str, me: str, to: str, mtype: str, body: str) -> dict | None:
    """A change task for a Claude worker under its deny list (claude_deny): the list follows the task.

    A task it plans first keeps the list until `mesh approve` lifts it: a read-only asker's reason just becomes
    `planning`, with no reopen. A direct task reopens its conversation without the list, on the same model and
    effort, by `swap_model` as `mesh approve` does, then delivers. None when it delivers as usual: not a task,
    a question or a review again, no deny list, or a planned task. `send` never reopens a worker to add the list.
    """
    if mtype != "task" or read_only_task(body):
        return None
    entry = agent_entry(load_run(run_id), to)
    if entry.get("peer"):
        raise MeshError(f"{to} is a peer asker, which only answers questions about its project. Nothing was sent: "
                        f"ask it with `mesh ask {entry['peer']}`, and give a change to a worker in that repo")
    if entry.get("role") != "worker" or not claude_deny(entry):
        return None
    asker = bool(entry.get("read_only"))
    what = "a read-only asker" if asker else "planning"
    if entry.get("status") == "retired":  # `mesh ask` retires its askers: bring it back the usual way, not by a swap
        raise MeshError(f"{to} is retired, and was {what} under a deny list. Nothing was sent: give it the change "
                        f"with `mesh resume {to} --task-file …`, which compacts it if it's large and reopens it "
                        "with its deny list only while it plans")
    if planned_task(body):
        if asker:
            with editing_run(run_id) as run:
                run["agents"][to].update(read_only=False, planning=True)
            log_event(run_id, "deny_reason", name=to, reason="planning")
            print(f"mesh: {to} was a read-only asker; it plans this task under the same deny list, which "
                  "`mesh approve` lifts", file=sys.stderr)
        return None
    try:
        swap = swap_model(run_id, to, entry["model"], entry["effort"], "read-only lifted" if asker else "deny lifted",
                          message=(me, "task", body), lift=True)
    except SwapNotStarted as exc:
        raise MeshError(f"{exc}. Nothing was sent: {to} is {what}, under a deny list that a direct task "
                        f"reopens it without once its turn has ended; send it again then") from exc
    except MeshError as exc:
        if entry.get("view") != "bg":
            raise  # a pane is given its task only once it's back, so nothing was stored
        # A background worker's task went into its mailbox first, as the copy's opening prompt. That task is a
        # direct one, so neither reason holds any more: the resume this points to reopens it without the list.
        with editing_run(run_id) as run:
            run["agents"][to].update(read_only=False, planning=False)
        raise MeshError(f"{exc}. The task is stored, so don't send it again: `mesh resume {to}` (no task) "
                        "reopens it without its deny list to read it") from exc
    log_event(run_id, "read_only_lifted" if asker else "deny_lifted", name=to)
    print(f"mesh: {to} was {what}; reopened it in the same conversation without its deny list, "
          "so it can now edit and push", file=sys.stderr)
    return {**(swap.pop("delivery", None) or deliver(run_id, me, to, "task", body, first=True)),
            "read_only_lifted" if asker else "deny_lifted": True, "reopened": swap}


def cmd_send(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    body = read_body(args.body, args.file)
    if not body or not body.strip():
        raise MeshError("empty message: pass --body TEXT or --file PATH (- for stdin)")
    to = me_parent(run_id, me) if args.to == "parent" else args.to
    if args.type == "wait" or getattr(args, "until", None):
        return send_wait(args, run_id, me, to, body)
    if args.type in REPORT_TYPES and not args.unread_ok:
        refuse_stale_report(run_id, me, args.type)
    def stored() -> None:  # before the doorbell, so a root that approves at once sees the plan phase
        record_session(run_id, me)
        if args.type == "plan":
            enter_plan_phase(run_id, me, to)

    result = lift_read_only(run_id, me, to, args.type, body) or deliver(run_id, me, to, args.type, body,
                                                                        stored=stored)
    emit(result)
    if "send_message" in result:
        print(f"mesh: stored; now tell {to} with SendMessage: `to` and `message` exactly as in send_message",
              file=sys.stderr)
        return 0
    if not delivered(result):
        print(f"warning: stored, but the doorbell did not ring ({result['error']}); "
              f"{to} will see it on its next `mesh inbox`", file=sys.stderr)
        return 2
    return 0


def parse_until(text: str, now: datetime | None = None) -> datetime:
    """A wait's end, in UTC: a duration (`45m`, `1h30m`, `90s`), a local clock time (`14:30`, the next one), or
    ISO 8601 (local time without an offset)."""
    now = now or datetime.now(timezone.utc)
    text = text.strip()
    spans = UNTIL_RE.match(text.lower())
    if text and spans and any(spans.groups()):
        h, m, sec = (int(g or 0) for g in spans.groups())
        try:
            return now + timedelta(hours=h, minutes=m, seconds=sec)
        except OverflowError as exc:
            raise MeshError(f"--until {text} is more than {MAX_WAIT // 3600} h away") from exc
    if clock := re.fullmatch(r"(\d{1,2}):(\d{2})", text):
        local = now.astimezone()
        try:
            # naive local times, each given its own offset: tomorrow's may differ from today's across a DST change
            today = datetime(local.year, local.month, local.day, int(clock.group(1)), int(clock.group(2)))
        except ValueError as exc:
            raise MeshError(f"--until {text}: not a time of day") from exc
        at = today.astimezone()
        if at <= local:
            at = (today + timedelta(days=1)).astimezone()
        return at.astimezone(timezone.utc)
    try:
        at = datetime.fromisoformat(text[:-1] + "+00:00" if text[-1:] in "zZ" and text else text)  # 3.10 has no Z
    except ValueError as exc:
        raise MeshError(f"--until {text}: give a duration (45m, 1h30m), a local time (14:30) or ISO 8601") from exc
    return (at if at.tzinfo else at.astimezone()).astimezone(timezone.utc)


def send_wait(args: argparse.Namespace, run_id: str, me: str, to: str, body: str) -> int:
    """A worker declares a deliberate wait for its current task: until then the watch neither nudges nor
    alerts it for a silent stop, and its Stop hook lets its turn end. Not a report, and no doorbell: it asks
    nothing of the parent, who sees it in `mesh inbox` (`declared_wait` reads it from the log)."""
    if args.type != "wait":
        raise MeshError("--until is for `--type wait`")
    if not args.until:
        raise MeshError("a wait needs --until: a duration (45m, 1h30m), a local time (14:30) or ISO 8601")
    entry = agent_entry(load_run(run_id), me)
    if entry.get("role") != "worker" or to != entry.get("parent"):
        raise MeshError("a wait is a worker's note to its parent: `mesh send parent --type wait`")
    until = parse_until(args.until)
    ahead = (until - datetime.now(timezone.utc)).total_seconds()
    if ahead <= 0:
        raise MeshError(f"--until {args.until} is in the past")
    if ahead > MAX_WAIT:
        raise MeshError(f"--until {args.until} is more than {MAX_WAIT // 3600} h away: wait at most that long, and "
                        "send another wait then if you still need one")
    received = unread_received(run_id, me)
    if received:  # it would be the wait of a task it hasn't read
        raise MeshError(f"not sent: your mailbox has {len(received)} unread task/answer message(s); run "
                        "`mesh inbox` and act on them first")
    stamp_iso = until.isoformat(timespec="seconds")
    text = f"Waiting until {until.astimezone():%H:%M} ({stamp_iso}): {body.strip()}"
    path = store_message(run_id, me, to, "wait", text)
    log_event(run_id, "send", sender=me, to=to, type="wait", file=path.name, until=stamp_iso)
    record_session(run_id, me)
    emit({"stored": str(path), "until": stamp_iso, "rung": False})
    print(f"mesh: stored for {to}, without a doorbell. Until {until.astimezone():%H:%M} the watch won't nudge or "
          "alert you for ending your turn; report as usual when you're done", file=sys.stderr)
    return 0


def refuse_stale_report(run_id: str, me: str, mtype: str) -> None:
    """A report sent while a task or answer is unread would count as the reply to it (`since_last_task`), so
    the worker's next silent stop would go unnoticed. PROTOCOL rule 2 (read your mailbox right before
    reporting), in code."""
    waiting = unread_received(run_id, me)
    if not waiting:
        return
    lines = "\n".join(f"  - {m['type']} from {m['from']} at {m['time']}: {m['gist']}" for m in waiting)
    raise MeshError(
        f"not sent: your mailbox has {len(waiting)} unread task/answer message(s), and a {mtype} sent now would "
        f"count as your reply to them:\n{lines}\nRun `mesh inbox` (not --peek) and act on them, then send one "
        f"{mtype} that covers them too. Send anything that can't wait as `--type info`; pass --unread-ok to send "
        "this as it is anyway")


def pinned(entry: dict) -> bool:
    """Whether a named model or effort covers the worker's whole task (spawn and resume record it).

    A worker spawned before mesh recorded it: a large one with no exec model had its model named (`auto`
    always gives one), while a sized one ran on its size's defaults. A resumed one most likely got a task
    with no plan phase, which also leaves no exec model, so it isn't taken for pinned.
    """
    if "pinned" in entry:
        return bool(entry["pinned"])
    return not entry.get("exec_model") and entry.get("size") not in ("trivial", "small") \
        and not entry.get("resumed_from")


def has_phases(entry: dict | None) -> bool:
    """A worker that may plan and then execute on its exec model: not one whose model or effort was named
    for the whole task (`pinned`), nor one whose plan the user approves in its pane."""
    return bool(entry) and entry.get("role") == "worker" and entry.get("kind") in KINDS \
        and not pinned(entry) and entry.get("plan_review") != "user"


def enter_plan_phase(run_id: str, name: str, to: str) -> None:
    """A worker that sends its parent a plan while not planning (a small asker given a change, a worker that
    finished and got a new task) enters a plan phase, as `mesh resume` gives one, so `mesh approve` moves it
    to its exec model and effort. It is planning on the model it is on: `send` never reopens a worker.

    The trigger is the plan itself, not the task: a fix the worker just does keeps its exec phase.
    """
    entry = load_run(run_id)["agents"].get(name)
    if not has_phases(entry) or entry.get("phase") == "plan" or entry.get("parent") != to:
        return
    with editing_run(run_id) as run:
        entry = run["agents"][name]
        entry.update(phase="plan", exec_model=entry.get("exec_model") or EXEC_MODEL[entry["kind"]],
                     exec_effort=entry.get("exec_effort") or EXEC_EFFORT)
        # where this plan phase starts, for models_tried
        entry.setdefault("models", []).append({"model": entry.get("model"), "effort": entry.get("effort"),
                                               "at": now_iso(), "why": "planned task"})
    log_event(run_id, "plan_phase", name=name, exec_model=entry["exec_model"])


def record_session(run_id: str, name: str) -> None:
    """Record an agy worker's conversation on its first message, while agy's index still holds its first
    doorbell: agy may later replace that with a title, and the worktree fallback can pick a restart's."""
    entry = load_run(run_id)["agents"].get(name)
    if not entry or entry.get("kind") != "agy" or entry.get("session") or entry.get("role") != "worker":
        return
    session = agy_conversation(name, run_id, None, pinned_only=True)
    if session:
        with editing_run(run_id) as run:
            e = run["agents"][name]
            e["session"] = e.get("session") or session
        log_event(run_id, "session", name=name, session=session)


def me_parent(run_id: str, me: str) -> str:
    parent = agent_entry(load_run(run_id), me).get("parent")
    if not parent:
        raise MeshError(f"{me} has no parent (it is the run's root)")
    return parent


RESET_SOURCES = ("clear", "compact")  # session starts that may have lost the task (`mesh inbox` shows it again)


def current_task(run_id: str, name: str, events: list[dict]) -> list[Path]:
    """The message files of `name`'s current task: the last `task` sent to it, and every `answer` since."""
    files: list[str] = []
    for e in events:
        if e.get("event") == "send" and e.get("to") == name and e.get("file"):
            if e.get("type") == "task":
                files = [e["file"]]
            elif e.get("type") == "answer" and files:
                files.append(e["file"])
    folder = inbox_dir(run_id, name)
    found = (next((f for f in (folder / file, folder / "read" / file) if f.exists()), None) for file in files)
    return [f for f in found if f]


def session_reset(events: list[dict], name: str) -> bool:
    """Whether `name`'s session was cleared or compacted (a `rebind`, or a `reminder` from one of those) since
    its last task or answer, and `mesh inbox` hasn't shown that task again since."""
    reset = False
    for e in events:
        if e.get("name") == name and (e.get("event") == "rebind" and e.get("session")
                                      or e.get("event") == "reminder" and e.get("source") in RESET_SOURCES):
            reset = True
        elif e.get("name") == name and e.get("event") == "inbox_again" \
                or e.get("event") == "send" and e.get("to") == name and e.get("type") in RECEIVED_TYPES:
            reset = False
    return reset


def cmd_inbox(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    folder = inbox_dir(run_id, me)
    paths = unread(run_id, me)
    if args.all and (folder / "read").exists():
        paths = sorted((folder / "read").glob("*.md")) + paths
    again: list[Path] = []
    if not args.peek and session_reset(events := read_log(run_id), me):
        # a task it already reported done or failed on needs no reminding; `--all` shows it in its place
        report, _ = last_report(events, me)
        if (report["type"] if report else None) not in FINAL_TYPES:
            again = current_task(run_id, me, events)
        log_event(run_id, "inbox_again", name=me, files=[p.name for p in again])
    shown = {p.name for p in paths}
    messages = []
    for path in (p for p in again if p.name not in shown):
        meta, body = parse_message(path)
        messages.append({"file": str(path), **meta, "body": body.strip(), "again": True})
    for path in paths:
        meta, body = parse_message(path)
        messages.append({"file": str(path), **meta, "body": body.strip(),
                         **({"again": True} if path in again and path.parent.name == "read" else {})})
        if not args.peek and path.parent == folder:
            mark_read(path)
    if args.json:
        emit(messages)
    elif not messages:
        print("No unread messages.")
    else:
        for msg in messages:
            note = " (again: your session was cleared or compacted since you read it)" if msg.get("again") else ""
            print(f"── {msg.get('type')} from {msg.get('from')} at {msg.get('time')}{note} ──")
            print(msg["body"], end="\n\n")
    if (maybe_run(run_id) or {}).get("root") == me:
        root_hint(run_id)
    return 0


def cmd_ring(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    run = load_run(run_id)
    entry = agent_entry(run, args.agent)
    refuse_headless(args.agent, entry, "a doorbell")
    count = len(unread(run_id, args.agent))
    held = entry.get("held")
    if not count:
        if held:  # spawned with no task: nothing to ring, and nothing left to hold
            with editing_run(run_id) as data:
                data["agents"][args.agent].pop("held", None)
        print(f"{args.agent} has no unread messages" + ("; its startup hold is cleared." if held else "."))
        return 0
    text = f"you have {count} unread message(s) (run `mesh inbox`)"
    route = native_route(run, me, args.agent)
    if route:
        emit({"rung": False, "unread": count, "send_message": {"to": route, "message": f"📬 [mesh] {text}"}})
        return 0
    token = ring_token()
    targets = [args.agent] + ([entry["pane"]] if entry.get("pane") else [])
    paths = unread(run_id, args.agent)
    # A held worker never heard its first doorbell, which says who it is.
    doorbell = held_doorbell(run, args.agent, held, token) if held else f"📬 [mesh] (ref {token}) {text}"
    result = ring_stored(run_id, me, args.agent, targets, doorbell, token, paths[-1], read=tuple(paths))
    if result["rung"] and held:
        with editing_run(run_id) as data:
            data["agents"][args.agent].pop("held", None)
            data["agents"][args.agent].pop("swapped", None)
    emit({**result, "unread": count})
    return 0 if result["rung"] else 2


def agent_status(name: str, entry: dict | None = None, bg_rows: list[dict] | None = None) -> str:
    """herdr's state for an agent's pane (working / idle / done / blocked / gone); a background worker's from Claude.

    herdr can lose a live agent's registration (seen after a Claude Code auto-update), so a pane worker herdr
    doesn't know is `gone` only unless its pane still runs its CLI (`pane_probe`): then it is `unknown`, which
    the watch neither nudges nor reports gone. When the pane can't be read, herdr's word stands.
    """
    if entry and entry.get("view") == "bg":
        return bg_status(entry, bg_rows)
    if entry and entry.get("view") == "headless":
        # A Copilot asker works while the `mesh ask` that asks it, or the copilot that one started, lives.
        return "working" if live_holder(name, entry) else "gone"
    try:
        return herdr("agent", "get", name)["agent"].get("agent_status", "unknown")
    except HerdrError as exc:
        if exc.code == "agent_not_found":
            return "unknown" if entry and pane_probe(entry.get("pane"), entry.get("kind")) == "alive" else "gone"
        raise


def ago(seconds: float) -> str:
    """A short age: 45s, 12m, 3h05m, 2d3h."""
    if seconds == float("inf"):
        return "?"
    s = max(0, int(seconds))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h{s % 3600 // 60:02d}m"
    return f"{s // 86400}d{s % 86400 // 3600}h"


def message_file(run_id: str, to: str, file: str | None) -> Path | None:
    """A logged message's file in `to`'s mailbox, unread or read."""
    if not file:
        return None
    folder = inbox_dir(run_id, to)
    return next((p for p in (folder / file, folder / "read" / file) if p.exists()), None)


def message_body(run_id: str, event: dict | None) -> str:
    path = message_file(run_id, event.get("to"), event.get("file")) if event else None
    return parse_message(path)[1] if path else ""


PR_STATE_TTL = 120  # seconds `mesh status` reuses a PR's state from `<run>/pr-state.json`
PR_RETRY_TTL = 60  # seconds before a PR whose state `gh` couldn't read is tried again
PR_STATE_TIMEOUT = 10  # seconds one `gh pr view` may take: `mesh status` waits for it
CHECK_FAILED = ("FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE")


def checks_summary(rollup: list[dict] | None) -> str | None:
    """`gh`'s statusCheckRollup as one word: failing, pending or pass (None with no checks)."""
    seen = set()
    for check in rollup or ():
        if "conclusion" in check or "status" in check:  # a check run
            done = (check.get("status") or "").upper() == "COMPLETED"
            outcome = (check.get("conclusion") or "").upper()
        else:  # a commit status
            outcome = (check.get("state") or "").upper()
            done = outcome not in ("PENDING", "EXPECTED")
        seen.add("pending" if not done else "failing" if outcome in CHECK_FAILED else "pass")
    return next((word for word in ("failing", "pending", "pass") if word in seen), None)


def pr_state(url: str) -> dict | None:
    result = run_cli(["gh", "pr", "view", url, "--json", "state,isDraft,statusCheckRollup"], timeout=PR_STATE_TIMEOUT)
    try:
        data = json.loads(result.stdout) if result.returncode == 0 else None
    except ValueError:
        data = None
    if not isinstance(data, dict) or not data.get("state"):
        return None
    return {"state": data["state"].lower(), "draft": bool(data.get("isDraft")),
            "checks": checks_summary(data.get("statusCheckRollup"))}


def pr_states(run_id: str, urls: list[str]) -> dict[str, dict]:
    """Each PR's state, checks and draft flag from `gh`, fetched side by side and cached for PR_STATE_TTL.
    A failed fetch keeps the last state seen, else `unknown`, and is tried again after PR_RETRY_TTL, so a `gh`
    that can't reach GitHub slows `mesh status` once a minute, not on every call."""
    path = run_dir(run_id) / "pr-state.json"
    try:
        cache = json.loads(path.read_text())
    except (OSError, ValueError):
        cache = {}
    cache = {u: c for u, c in cache.items() if isinstance(c, dict)} if isinstance(cache, dict) else {}
    unknown = {"state": "unknown", "draft": False, "checks": None}

    def stale(url: str) -> bool:
        cached = cache.get(url, {})
        return time.time() - cached.get("at", 0) > (PR_STATE_TTL if cached.get("ok", True) else PR_RETRY_TTL)

    fetch = [u for u in dict.fromkeys(urls) if stale(u)]
    if fetch:
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(max_workers=min(8, len(fetch))) as pool:
            for url, state in zip(fetch, pool.map(pr_state, fetch)):
                last = {k: v for k, v in cache.get(url, unknown).items() if k in unknown}
                cache[url] = {**(state or last), "at": time.time(), "ok": bool(state)}
        write_atomic(path, json.dumps(cache, indent=2) + "\n")
    return {u: {k: cache.get(u, unknown).get(k, unknown[k]) for k in unknown} for u in urls}


def last_task(events: list[dict], name: str) -> dict | None:
    return next((e for e in reversed(events) if e.get("event") == "send" and e.get("to") == name
                 and e.get("type") == "task"), None)


def report_prs(run_id: str, name: str, entry: dict, report: dict, events: list[dict]) -> list[str]:
    """The PRs a `done` names (not ones the worker reviewed), else those of its newest earlier `done` that
    named any: a fix round's report may not repeat the link. Plans and questions don't count."""
    reviewed = set(entry.get("reviews") or ())
    dones = [e for e in events if e.get("event") == "send" and e.get("sender") == name and e.get("type") == "done"]
    for done in reversed(dones[: dones.index(report) + 1] if report in dones else [report]):
        prs = [u for u in dict.fromkeys(PR_RE.findall(message_body(run_id, done))) if u not in reviewed]
        if prs:
            return prs
    return []


def reviewing_pr(run_id: str, entry: dict, events: list[dict], name: str) -> str | None:
    """The PR a reviewer's current task reviews: the one its last task names, or its newest review; None
    when that task isn't a review. `reviews` keeps every PR it ever reviewed."""
    body = message_body(run_id, last_task(events, name)).lstrip()
    if not body.startswith("Review (read-only)"):
        return None
    named = REVIEW_GIST_RE.match(body)
    pr = PR_RE.search(named.group(1)) if named else None
    reviews = entry.get("reviews") or []
    return pr.group(0) if pr else (reviews[-1] if reviews else None)


def doorbell_failed(events: list[dict], name: str, file: str | None) -> bool:
    """Whether the doorbell for this message failed, and no doorbell has rung for `name` since (a `rung`
    event, from `mesh ring` or a later send)."""
    failed = False
    for e in events:
        if e.get("event") == "doorbell_failed" and e.get("to") == name and e.get("file") == file:
            failed = True
        elif e.get("event") == "rung" and e.get("to") == name:
            failed = False
    return failed


def waiting_rows(run_id: str, run: dict, rows: list[dict], events: list[dict]) -> None:
    """Add to each status row what the worker owes or waits on, derived from the log, mailboxes, git and `gh`:
    `waiting` (what to show), `needs` (who acts next: root, worker or None), `since`, `report`, and for a
    `done` or `failed` its `prs` and work evidence."""
    folds = {r["name"]: last_report(events, r["name"]) for r in rows if r["role"] != "root"}
    pending = {}  # a done's PRs, fetched together below
    for row in rows:
        row.update(waiting="", needs=None, since=None, report=None)
        name, entry = row["name"], run["agents"][row["name"]]
        if row["role"] == "root":
            continue
        report, received = folds[name]
        if report and report.get("type") in FINAL_TYPES:
            row.update(work_evidence(run, entry))
            read_only = message_body(run_id, last_task(events, name)).lstrip().startswith(READ_ONLY_STARTS)
            if report["type"] == "done" and not read_only:
                pending[name] = report_prs(run_id, name, entry, report, events)
            row["read_only"] = read_only
    states = pr_states(run_id, [u for urls in pending.values() for u in urls]) if pending else {}
    reviewing: dict[str, list[str]] = {}  # PR → reviewers that haven't reported since their last task
    for name, entry in run["agents"].items():
        report = folds.get(name, (None, None))[0]
        if entry.get("reviews") and entry.get("status") != "retired" \
                and not (report and report.get("type") in FINAL_TYPES):
            if url := reviewing_pr(run_id, entry, events, name):
                reviewing.setdefault(url, []).append(name)
    for row in rows:
        if row["role"] == "root":
            continue
        name, entry = row["name"], run["agents"][row["name"]]
        report, received = folds[name]
        retired = row["state"] == "retired"
        if report:
            mtype, since = report["type"], report.get("time")
            unread_note = ", unread" if (inbox_dir(run_id, report["to"]) / str(report.get("file"))).exists() else ""
            needs = "root"
            if mtype in ("plan", "question"):
                text = f"{mtype} unanswered {ago(age_seconds(since))}{unread_note}"
            elif mtype == "failed":
                text = f"failed {ago(age_seconds(since))}{unread_note}"
            elif row.pop("read_only", False):
                text = f"answered {ago(age_seconds(since))}{unread_note}"
            else:
                urls = pending.get(name, [])
                row["prs"] = [{"url": u, "number": int(u.rsplit("/", 1)[1]), **states[u]} for u in urls]
                parts = [f"PR #{p['number']} {p['state']}" + (", draft" if p["draft"] else "")
                         + (f", checks {p['checks']}" if p["checks"] else "") for p in row["prs"]]
                if not urls:
                    commits = row.get("commits")
                    parts.append("no commits" if commits == 0 else f"{commits} commit(s)" if commits else "")
                    if commits and row.get("pushed") is False:
                        parts.append("not pushed")
                    parts.append("no PR")
                if row.get("dirty"):
                    parts.append("worktree dirty")
                reviewers = [r for u in urls for r in reviewing.get(u, []) if r != name]
                if reviewers:
                    parts.append(f"in review ({', '.join(dict.fromkeys(reviewers))})")
                    needs = "worker"
                text = f"done {ago(age_seconds(since))}{unread_note}: " + ", ".join(p for p in parts if p)
            row.pop("read_only", None)
        elif not received:
            text, since, needs = "no task", None, None
        else:
            mtype, since = received["type"], received.get("time")
            if retired:
                text, needs = "retired before reporting", None
            elif (inbox_dir(run_id, name) / str(received.get("file"))).exists():
                text, needs = f"{mtype} unread {ago(age_seconds(since))}", "worker"
                if doorbell_failed(events, name, received.get("file")):
                    text, needs = f"{text}, doorbell failed", "root"
            else:
                text, needs = f"on {mtype} {ago(age_seconds(since))}", "worker"
                if until := waiting_until(events, name):  # a declared wait (`mesh send --type wait`)
                    text += f", waiting until {datetime.fromtimestamp(until).astimezone():%H:%M}"
            if needs == "worker" and (row["state"] in ("gone", "blocked") or entry.get("status") == "swap_failed"):
                needs = "root"  # it owes a report it can't send
                text += " (swap failed)" if entry.get("status") == "swap_failed" else ""
        row.update(waiting=text, needs=None if retired else needs, since=since, report=report and report["type"])


def status_rows(run_id: str, run: dict) -> list[dict]:
    """`mesh status`'s rows: each agent's live state and what it owes or waits on, needing the root first."""
    rows = []
    bg_rows = claude_agents() if any(e.get("view") == "bg" for e in run["agents"].values()) else []
    for name, entry in run["agents"].items():
        live = "retired" if entry.get("status") == "retired" else agent_status(name, entry, bg_rows)
        rows.append({
            "name": name, "role": entry["role"], "kind": entry.get("kind"), "model": entry.get("model") or "",
            "size": entry.get("size") or "", "view": entry.get("view") or ("pane" if entry.get("pane") else ""),
            "state": live, "unread": len(unread(run_id, name)), "parent": entry.get("parent") or "",
            "branch": entry.get("branch") or "",
        })
    waiting_rows(run_id, run, rows, read_log(run_id))
    # What needs the root first, longest-waiting first; then what waits on a worker; the root's own row last.
    rank = {"root": 0, "worker": 1, None: 2}
    rows.sort(key=lambda r: (3 if r["role"] == "root" else rank[r["needs"]], r["since"] or "~"))
    return rows


def cmd_status(args: argparse.Namespace) -> int:
    run_id, me = caller(args, args.run_id)
    run = load_run(run_id)
    rows = status_rows(run_id, run)
    context = quietly(root_context, run, as_root=me == run["root"])
    if args.json:
        emit({"run": run_id, "mode": run["mode"], "agents": rows,
              "needs_root": [r["name"] for r in rows if r["needs"] == "root"], "root_context": context})
    else:
        print(f"run {run_id} ({run['mode']}), {run_dir(run_id)}" + (f" · {context_text(context)}" if context else ""))
        print_table(rows, ("name", "role", "kind", "model", "size", "view", "state", "unread", "waiting", "branch"))
    if me == run["root"]:
        root_hint(run_id)
    return 0


def log_path(run_id: str) -> Path:
    """A run's log, live or archived."""
    for folder in (run_dir(run_id), mesh_home() / "archive" / run_id):
        if (folder / "run.json").exists():
            return folder / "log.jsonl"
    raise MeshError(f"unknown run {run_id} (no {run_dir(run_id)}, nor one in {mesh_home() / 'archive'})")


REVIEW_GIST_RE = re.compile(r"^(Review \(read-only\) of \S+?):\s")
LOG_SKIP = ("time", "event", "name", "sender", "to", "type", "file")


def log_line(event: dict, folder: Path) -> str:
    """One event as a timeline line: local time, event, who, and the rest; a message shows its gist."""
    try:
        when = datetime.fromisoformat(event["time"]).astimezone().strftime("%H:%M:%S")
    except (KeyError, TypeError, ValueError):
        when = "--:--:--"
    kind = event.get("event", "?")
    if kind == "send":
        who = f"{event.get('sender')} → {event.get('to')}  {event.get('type')}"
        path = next((p for p in (folder / "inbox" / str(event.get("to")) / sub / str(event.get("file"))
                                 for sub in ("", "read")) if p.is_file()), None)
        body = parse_message(path)[1].strip() if path else ""
        review = REVIEW_GIST_RE.match(body)  # a review's notes may be only its diff: name the PR instead
        rest = review.group(1) if review else task_gist(body, 100)
    else:
        who = event.get("name") or (f"{event.get('sender')} → {event.get('to')}" if event.get("to") else "")
        rest = " ".join(f"{k}={v if isinstance(v, str) else json.dumps(v)}" for k, v in event.items()
                        if k not in LOG_SKIP and v not in (None, "", [], {}))
    return "  ".join(part for part in (when, f"{kind:<15}", who, rest) if part).rstrip()


def log_day(event: dict) -> str | None:
    try:
        return datetime.fromisoformat(event["time"]).astimezone().strftime("%Y-%m-%d")
    except (KeyError, TypeError, ValueError):
        return None


def cmd_log(args: argparse.Namespace) -> int:
    """The run's log.jsonl as a timeline; --follow keeps printing until the run stops."""
    run_id = args.run_id or identity(args)[0]
    path = log_path(run_id)

    if args.lines < 0:
        raise MeshError("--lines takes a count of events (0: all)")
    day = None

    def show(events: list[dict], last: int = 0) -> bool:
        """Print the events naming --agent (only the last `last` of them, if given); True once the run
        stopped, whoever an event names: `stop` names nobody."""
        nonlocal day
        shown = [e for e in events if not args.agent or args.agent in (e.get("name"), e.get("sender"), e.get("to"))]
        for event in shown[-last:] if last else shown:
            if log_day(event) and log_day(event) != day:
                day = log_day(event)
                print(f"── {day} ──")
            print(log_line(event, path.parent), flush=True)
        return any(e.get("event") == "stop" for e in events)

    text = path.read_text() if path.exists() else ""
    complete = text[: text.rfind("\n") + 1]  # a line still being written waits for its newline
    stopped = show(parse_log_lines(complete.splitlines(), path), args.lines)
    stopped = stopped or path.parent.parent == mesh_home() / "archive"  # nothing more comes
    if not args.follow:
        return 0
    offset, lineno = len(complete.encode()), complete.count("\n") + 1
    try:
        while not stopped:
            time.sleep(1)
            if not path.exists():  # `mesh stop` archived the run
                print("(run archived)")
                break
            with open(path, "rb") as fh:
                fh.seek(offset)
                chunk = fh.read()
            ended = chunk[: chunk.rfind(b"\n") + 1]
            if not ended:
                continue
            offset += len(ended)
            lines = ended.decode(errors="replace").splitlines()
            stopped = show(parse_log_lines(lines, path, lineno))
            lineno += len(lines)
    except KeyboardInterrupt:
        pass
    return 0


def sends_from(run_id: str, name: str, types: tuple[str, ...] = TYPES, events: list[dict] | None = None) -> int:
    events = read_log(run_id) if events is None else events
    return sum(1 for e in events if e.get("event") == "send" and e.get("sender") == name and e.get("type") in types)


def cmd_watch(args: argparse.Namespace) -> int:
    """Block until a child reports done/failed (exit 0) or something looks wrong (non-zero)."""
    run_id, me = caller(args, args.run_id)
    every, alerts = getattr(args, "any", False), getattr(args, "alerts", False)
    root = me == (maybe_run(run_id) or {}).get("root")  # the root's own watch may reset it (MESH_ROOT_AUTORESET)
    if bool(args.agent) == bool(every):
        raise MeshError("watch whom? name a worker, or pass --any for every live worker of the run")
    if every:
        run = load_run(run_id)
        workers = {name: e for name, e in run["agents"].items() if e["role"] != "root" and e.get("status") != "retired"}
        for name, e in workers.items():  # a gone worker's unread report is news too
            if kind := unread_report(run_id, e.get("parent"), name):
                print(unread_line(name, kind))
                return 0
        bg_rows = claude_agents() if any(e.get("view") == "bg" for e in workers.values()) else []
        names = [name for name, e in workers.items() if agent_status(name, e, bg_rows) != "gone"]
        if not names:
            print("no live workers to watch")
            return 0
    else:
        names = [args.agent]
    status, line = watch_agents(run_id, names, args.timeout, args.interval, args.grace, alerts_only=alerts,
                                hang=getattr(args, "hang", None), autoreset=root and autoreset_on())
    print(line)
    if root:
        root_hint(run_id)
    return status


def since_last_task(events: list[dict], name: str) -> tuple[int, int, str | None]:
    """(tasks and answers `name` has received, reports it has sent since the last of them, that last one's time)."""
    received = sent = 0
    at = None
    for event in events:
        if event.get("event") != "send":
            continue
        if event.get("to") == name and event.get("type") in RECEIVED_TYPES:
            received, sent, at = received + 1, 0, event.get("time")
        elif event.get("sender") == name and event.get("type") in REPORT_TYPES:
            sent += 1
    return received, sent, at


def last_report(events: list[dict], name: str) -> tuple[dict | None, dict | None]:
    """(the newest report `name` sent since its last task or answer, that last task or answer), as log events."""
    report = received = None
    for event in events:
        if event.get("event") != "send":
            continue
        if event.get("to") == name and event.get("type") in RECEIVED_TYPES:
            report, received = None, event
        elif event.get("sender") == name and event.get("type") in REPORT_TYPES:
            report = event
    return report, received


def declared_wait(events: list[dict], name: str) -> dict | None:
    """The wait `name` declared for its current task (its `send` event, `until` in ISO): sent since its last task
    or answer and after its newest report. A new task or answer, or a report, ends it."""
    found = None
    for event in events:
        if event.get("event") != "send":
            continue
        if (event.get("to") == name and event.get("type") in RECEIVED_TYPES) or (
                event.get("sender") == name and event.get("type") in REPORT_TYPES):
            found = None
        elif event.get("sender") == name and event.get("type") == "wait":
            found = event
    return found


def waiting_until(events: list[dict], name: str) -> float | None:
    """The epoch a deliberate wait of `name`'s current task ends, while it hasn't yet."""
    wait = declared_wait(events, name)
    until = epoch(wait.get("until")) if wait else 0.0
    return until if until > time.time() else None


def nudge_of(events: list[dict], name: str, received: int) -> dict | None:
    """The logged nudge for `name`'s current task, with `rung` once its doorbell was tried."""
    found = None
    for e in events:
        if e.get("name") == name and e.get("received") == received:
            if e.get("event") == "nudge":
                found = dict(e)
            elif e.get("event") == "nudge_rung" and found:
                found["rung"] = e.get("rung")
    return found


def claim_nudge(run_id: str, name: str, received: int, via: str | None = None) -> bool:
    """Log the nudge for this task unless a watch or the worker's Stop hook already did (checked and logged
    under the run lock). A hook's nudge (`via`) is delivered as it is claimed."""
    with run_lock(run_id):
        if nudge_of(read_log(run_id), name, received):
            return False
        log_event(run_id, "nudge", name=name, received=received, **({"via": via, "rung": True} if via else {}))
        return True


HOOK_NUDGE = ("agent-mesh: you're ending your turn without a `mesh send` since your last task or answer. If the "
              "task is finished, run `mesh inbox`, then report `done` or `failed` with `mesh send parent`; if you're "
              "stuck, send a `question`. If you're deliberately waiting (a background command you started will "
              "wake you), declare it with `mesh send parent --type wait --until <time> --body …` and end your "
              "turn: this reminder comes once per task.")


def stop_hook(run_id: str, name: str, payload: dict) -> str | None:
    """The reason a Claude worker's Stop hook keeps its turn going, or None to let it end.

    Once per task (the task's nudge, shared with the watch) or per new unread mail, never in plan mode (a plan
    the user approves in the pane, or a talk with the user), and only for a worker that got a task and has
    unread mail or hasn't reported since its last one. A turn that already continues because of a hook
    (`stop_hook_active`) can still get the nudge a mail block kept, but no mail block without new mail.
    """
    active = bool(payload.get("stop_hook_active"))
    if payload.get("permission_mode") == "plan":
        return None
    entry = ((maybe_run(run_id) or {}).get("agents") or {}).get(name)
    if not entry or entry.get("role") != "worker" or entry.get("status") in ("retiring", "retired"):
        return None
    if entry.get("plan_review") == "user" and "permission_mode" not in payload:
        return None  # can't tell whether it is still in plan mode: the watch judges it
    events = read_log(run_id)
    received, sent, _ = since_last_task(events, name)
    paths = unread(run_id, name)
    mail = [parse_message(p)[0].get("type") or "message" for p in paths]
    sent = sent or bool(waiting_until(events, name))  # a declared wait lets the turn end until its deadline
    if not received or (sent and not mail):
        return None
    if mail and (sent or last_received_unread(run_id, name, events)):
        # Mail alone: the task's one nudge is kept for a silent turn end after the worker has read its task.
        # A mail block is deduped by the unread files instead, so the same mail never blocks twice.
        files = sorted(p.name for p in paths)
        with run_lock(run_id):
            last = next((e for e in reversed(read_log(run_id))
                         if e.get("event") == "hook_mail" and e.get("name") == name), None)
            if last and (set(files) <= set(last.get("files") or ()) if active else last.get("files") == files):
                return None  # nothing new since the last mail block (in this continuation: no new file)
            log_event(run_id, "hook_mail", name=name, files=files)
        return mail_reason(mail)
    if not claim_nudge(run_id, name, received, via="stop-hook"):
        return None
    reasons = [mail_reason(mail)] if mail else []
    reasons.append(HOOK_NUDGE)
    return "\n\n".join(reasons)


def mail_reason(mail: list[str]) -> str:
    kinds = ", ".join(dict.fromkeys(mail))
    return (f"agent-mesh: you have {len(mail)} unread mesh message{'s' if len(mail) > 1 else ''} ({kinds}): run "
            f"`mesh inbox` and handle {'them' if len(mail) > 1 else 'it'} before ending your turn.")


def last_received_unread(run_id: str, name: str, events: list[dict]) -> bool:
    """Whether the last task or answer `name` received is still in its mailbox, unread."""
    last = next((e for e in reversed(events) if e.get("event") == "send" and e.get("to") == name
                 and e.get("type") in RECEIVED_TYPES), None)
    return bool(last and last.get("file") and (inbox_dir(run_id, name) / last["file"]).exists())


def cmd_hook(args: argparse.Namespace) -> int:
    """A Claude worker's hook (`worker_hooks`). It always exits 0: a hook must never break a session."""
    try:
        payload = json.loads(sys.stdin.read() or "{}")
        payload = payload if isinstance(payload, dict) else {}
    except (ValueError, OSError):
        payload = {}
    try:
        reason = stop_hook(*identity(args), payload)
    except Exception as exc:  # noqa: BLE001 - anything else would show up in the worker's session as a hook error
        print(f"mesh hook {args.event}: {exc}", file=sys.stderr)
        return 0
    if reason:
        print(json.dumps({"decision": "block", "reason": reason}))
    return 0


def alerted(events: list[dict], name: str, received: int, kind: str = "stopped") -> bool:
    """Whether a watch already raised this alert for `name`'s current task: `stopped` (exit 3, the kind of an
    alert logged without one), `gone` (exit 5), `limit` (a Claude usage limit, exit 7) or `hung` (exit 8)."""
    return any(e.get("event") == "alert" and e.get("name") == name and e.get("received") == received
               and e.get("kind", "stopped") == kind for e in events)


def record_alert(run_id: str, name: str, received: int, kind: str = "stopped") -> None:
    """Log this alert for this task, once (checked and logged under the run lock)."""
    with run_lock(run_id):
        if not alerted(read_log(run_id), name, received, kind):
            log_event(run_id, "alert", name=name, received=received, kind=kind)


def nudge(run_id: str, name: str, entry: dict, received: int) -> bool:
    """Remind a worker whose turn ended silently to report, through `deliver`, with a short ring schedule."""
    delivery = deliver(run_id, entry.get("parent") or me_parent(run_id, name), name, "info", NUDGE_BODY,
                       delays=NUDGE_RING_DELAYS)
    rung = bool(delivery.get("rung"))
    log_event(run_id, "nudge_rung", name=name, received=received, rung=rung)
    return rung


def age_seconds(stamp_iso: str | None) -> float:
    try:
        return (datetime.now(timezone.utc) - datetime.fromisoformat(stamp_iso)).total_seconds()
    except (TypeError, ValueError):
        return float("inf")


def unread_report(run_id: str, parent: str | None, name: str) -> str | None:
    """The type of the oldest report (`plan`, `question`, `done`, `failed`) from `name` still unread by `parent`."""
    for path in unread(run_id, parent) if parent else ():
        meta, _ = parse_message(path)
        if meta.get("from") == name and meta.get("type") in REPORT_TYPES:
            return meta["type"]
    return None


def unread_line(name: str, kind: str) -> str:
    return f"{name} sent a {kind} you haven't read yet: read it with `mesh inbox`"


def epoch(stamp_iso: str | None) -> float:
    try:
        return datetime.fromisoformat(stamp_iso).timestamp()
    except (TypeError, ValueError):
        return 0.0


def work_evidence(run: dict, entry: dict) -> dict:
    """What a worker's branch and worktree show of its work: commits past its base, whether the tip is pushed,
    whether the worktree has uncommitted changes. None where it can't be told (no branch, base or worktree)."""
    repo, branch, base, cwd = entry.get("repo"), entry_branch(run, entry), entry.get("base"), entry.get("cwd")
    found: dict = {"commits": None, "pushed": None, "dirty": None}
    if repo and branch:
        try:
            tip = git("rev-parse", f"refs/heads/{branch}", cwd=repo)
            if base:
                found["commits"] = int(git("rev-list", "--count", f"{base}..{tip}", cwd=repo))
            try:
                found["pushed"] = git("rev-parse", f"{branch}@{{upstream}}", cwd=repo) == tip
            except MeshError:
                found["pushed"] = False  # no upstream
        except (MeshError, ValueError):
            pass
    if cwd and Path(cwd).is_dir():
        try:
            found["dirty"] = bool(git("status", "--porcelain", cwd=cwd))
        except MeshError:
            pass
    return found


PR_LIST_TIMEOUT = 10  # seconds the `gh pr list` of an alert's evidence may take


def open_pr(run: dict, entry: dict) -> str | None:
    """`PR #n open` for an open PR from the worker's branch, `no open PR`, or `PR unknown` when gh can't say."""
    branch = entry_branch(run, entry)
    if not branch or not entry.get("repo"):
        return None
    result = run_cli(["gh", "pr", "list", "--head", branch, "--state", "open", "--json", "number,url"],
                     cwd=entry["repo"], timeout=PR_LIST_TIMEOUT)
    try:
        prs = json.loads(result.stdout) if result.returncode == 0 else None
    except ValueError:
        prs = None
    if not isinstance(prs, list):
        return "PR unknown"
    return ", ".join(f"PR #{pr.get('number')} open" for pr in prs if isinstance(pr, dict)) or "no open PR"


def evidence_line(run: dict, entry: dict) -> str:
    """What an exit 3/5 alert adds about the worker's work: commits past its base, pushed, an open PR (asked of
    gh only when there are commits), a dirty worktree. Empty when none of it can be told."""
    found = work_evidence(run, entry)
    commits, parts = found["commits"], []
    if commits is not None:
        parts.append("no commits past its base" if commits == 0 else f"{commits} commit(s) past its base")
    if commits and found["pushed"] is not None:
        parts.append("pushed" if found["pushed"] else "not pushed")
    if commits and (pr := open_pr(run, entry)):
        parts.append(pr)
    if found["dirty"] is not None:
        parts.append("worktree dirty" if found["dirty"] else "worktree clean")
    return f"\n  its work: {', '.join(parts)}" if parts else ""


def wait_note(events: list[dict], name: str) -> str:
    """Says so when the worker's current task had a declared wait, now over."""
    wait = declared_wait(events, name)
    if not wait:
        return ""
    over = max(0, int(age_seconds(wait.get("until")) // 60))
    return f"; its wait until {wait.get('until')} ended {over} min ago"


class Watch:
    """One child's watchdog state between polls (see watch_agents)."""

    def __init__(self, run_id: str, name: str, grace: float, finals_at_start: int | None = None,
                 hang: float = HANG_AFTER):
        entry = agent_entry(load_run(run_id), name)
        self.run_id, self.name, self.grace, self.hang = run_id, name, grace, hang
        self.start_grace = max(START_GRACE_FACTOR * grace, SETTLE_GRACE)
        # Final sends before the watch started (or before its task was delivered) don't count.
        self.finals_at_start = sends_from(run_id, name, FINAL_TYPES) if finals_at_start is None else finals_at_start
        # ...but a report its parent hasn't read yet is news, whenever it was sent (not for `mesh ask`, whose
        # baseline is the count before its question, and which reads the reply itself).
        self.unread_report = None if finals_at_start is not None else unread_report(run_id, entry.get("parent"), name)
        self.log = entry.get("log")
        self.log_offset = Path(self.log).stat().st_size if self.log and Path(self.log).exists() else 0
        self.session: str | None = None  # its conversation, once found (see conversation)
        self.session_tried: float | None = None
        self.prev: str | None = None
        self.worked = False  # seen working since it last reported (or since it was nudged)
        self.idle_for: float | None = None  # seconds it has read idle in a row
        self.wait_idle = 0.0  # the same during a declared wait, when only a usage limit is looked for
        self.blocked_polls = 0
        self.nudged: int | None = None  # the task (count of tasks and answers received) this watch nudged for
        self.reopening = 0.0  # seconds spent excusing a "gone" worker that is being reopened
        self.reported = False  # it reported since the watch started (an --alerts watch carries on)
        self.retired = False  # the root is retiring it, or has: whatever it does next is no news
        self.finished = False  # it reported, then its pane closed or its session ended; or it was retired

    def tick(self, interval: float, alerts_only: bool = False, bg_rows: list[dict] | None = None,
             events: list[dict] | None = None) -> tuple[int, str] | None:
        """(status, line) once there is something to say, else None. `events` is this poll's read of the log."""
        run_id, name = self.run_id, self.name
        events = read_log(run_id) if events is None else events
        event = self.report_event(events, alerts_only) or self.quota_event()
        if event:
            return event
        entry = agent_entry(load_run(run_id), name)
        state = agent_status(name, entry, bg_rows)
        if agent_entry(load_run(run_id), name).get("status") in ("retiring", "retired"):  # read after the state
            self.retired = self.finished = True  # the root is closing it on purpose, report or not
            return None
        if self.retired:  # its retire failed, or it was resumed: watch it again
            self.retired = self.finished = False
        if entry.get("held") and release_held(run_id, name, entry, state):
            return None  # at the startup screen its start already reported (exit 4), or its doorbell just rang
        if (state == "gone" and self.reopening < SWAP_GRACE
                and agent_entry(load_run(run_id), name).get("status") == "starting"):  # read after the state
            self.reopening += interval  # `mesh approve` / `mesh switch` is reopening it on another model
            return None  # nothing to judge meanwhile: its idle time doesn't count either
        if state != "gone":
            self.reopening = 0.0
        if state == "gone":
            if self.reported:
                self.finished = True  # nothing to alert
                return None
            record_alert(run_id, name, since_last_task(events, name)[0], "gone")
            return 5, (f"ALERT {name} is gone (pane closed or agent exited) without reporting done/failed"
                       + evidence_line(load_run(run_id), entry))
        bg = entry.get("view") == "bg"
        self.blocked_polls = self.blocked_polls + 1 if state == "blocked" else 0
        if self.blocked_polls >= 2 and entry.get("plan_review") != "user":  # that one waits for the user's approval
            reset = self.limited(entry, bg)
            if reset is not None:  # Claude's usage-limit menu
                return self.limit_alert(entry, bg, reset, events)
            look = f"`claude attach {entry['bg_id']}`" if bg else f"`herdr agent read {name}`"
            return 4, self.with_tail(f"ALERT {name} is blocked on a UI prompt; inspect it with {look}", bg, entry)
        self.prev = state
        if waiting_until(events, name):  # a declared wait: a silent stop or a quiet transcript is expected
            self.idle_for = None
            self.worked = self.worked or state == "working"
            if state not in ("idle", "done") or entry.get("kind") != "claude":
                self.wait_idle = 0.0
                return None
            self.wait_idle += interval  # ...but not a usage limit: look once per `grace` of idle
            if self.wait_idle < self.grace:
                return None
            self.wait_idle = 0.0
            reset = self.limited(entry, bg)
            return self.limit_alert(entry, bg, reset, events) if reset is not None else None
        if state in ("idle", "done"):
            # One idle reading isn't the end of a turn: agy shows no spinner for a few seconds between steps.
            self.idle_for = 0.0 if self.idle_for is None else self.idle_for + interval
            if self.idle_for >= self.grace and (self.worked or self.idle_from_start(events)):
                return self.stopped(entry, bg, events)
            return None
        self.idle_for = None
        if state == "working":
            self.worked = True
        if state in ("working", "unknown"):
            return self.hung(entry, bg, state, events)
        return None

    def report_event(self, events: list[dict], alerts_only: bool) -> tuple[int, str] | None:
        """A report nobody has read yet (first tick only), or a `done`/`failed` sent since the watch started."""
        run_id, name = self.run_id, self.name
        if self.unread_report:
            kind, self.unread_report = self.unread_report, None
            return 0, unread_line(name, kind)
        finals = sends_from(run_id, name, FINAL_TYPES, events)
        if finals > self.finals_at_start:
            last = [e for e in events if e.get("event") == "send" and e.get("sender") == name][-1]
            if not alerts_only:
                return 0, f"{name} reported {last['type']}: read it with `mesh inbox`"
            self.finals_at_start, self.reported = finals, True
        return None

    def quota_event(self) -> tuple[int, str] | None:
        """A quota error agy logged since the last poll."""
        reset, self.log_offset = quota_hit(self.log, self.log_offset)
        if reset is None:
            return None
        model = agent_entry(load_run(self.run_id), self.name).get("model")
        return 7, (f"ALERT {self.name} hit its quota on {model}" + (f" (resets in {reset})" if reset else "")
                   + f"; move it to the next model with `mesh switch {self.name}`")

    def conversation(self, entry: dict) -> str | None:
        """Its session or conversation id: recorded, or looked up (at most once every SESSION_RETRY seconds)."""
        if entry.get("session") or self.session:
            return entry.get("session") or self.session
        now = time.time()
        if self.session_tried is None or now - self.session_tried >= SESSION_RETRY:
            self.session_tried = now
            self.session = find_session(self.run_id, self.name, entry)
        return self.session

    def limited(self, entry: dict, bg: bool) -> str | None:
        """The reset time ("" if not shown) when a Claude worker is at its usage limit, else None: from the
        pane's last lines, or its session file's last reply (which a background worker has too)."""
        if entry.get("kind") != "claude":
            return None
        if not bg:
            lines = pane_lines(self.name)
            if lines is None and entry.get("pane"):
                lines = pane_lines(entry["pane"])
            reset = usage_limit(lines)
            if reset is not None:
                return reset
        return transcript_limit(entry, self.conversation(entry))

    def limit_alert(self, entry: dict, bg: bool, reset: str, events: list[dict]) -> tuple[int, str] | None:
        """Exit 7 for a Claude usage limit, once per task; None when this task's limit was already alerted on."""
        received = since_last_task(events, self.name)[0]
        if alerted(events, self.name, received, "limit"):
            return None  # the root knows, and sends a new task at the reset, which re-arms this
        record_alert(self.run_id, self.name, received, "limit")
        when = f" (resets {reset})" if reset else ""
        relay = " and pass its send_message on" if bg else ""
        return 7, (f"ALERT {self.name} hit Claude's usage limit{when}; it can't go on until then: wait for the "
                   f"reset, then `mesh send {self.name} --type task --body \"The usage limit has reset: continue "
                   f"where you stopped.\"`{relay}")

    def hung(self, entry: dict, bg: bool, state: str, events: list[dict]) -> tuple[int, str] | None:
        """Exit 8, once per task, when it reads working (or herdr lost it) with nothing reported since its last task
        or answer, and its transcript hasn't changed for `hang` seconds since then. The watch never stops it."""
        if not self.hang:
            return None
        run_id, name = self.run_id, self.name
        received, sent, at = since_last_task(events, name)
        if sent or alerted(events, name, received, "hung") or alerted(events, name, received, "limit"):
            return None  # it reported (herdr's `working` may be stale); or this task was already alerted on
        progress = last_progress(entry, self.conversation(entry))
        if progress is None:
            return None  # nothing to judge it by
        quiet = time.time() - max(progress, epoch(at))
        if quiet < self.hang:
            return None
        if not bg and pane_probe(entry.get("pane"), entry.get("kind")) in ("missing", "dead"):
            if self.reported:
                self.finished = True  # as in tick's gone branch: nothing to alert
                return None
            record_alert(run_id, name, received, "gone")
            return 5, (f"ALERT {name} is gone: herdr still reads it {state}, but its pane runs no "
                       f"{entry.get('kind') or 'agent'} process (it exited without reporting done/failed)"
                       + evidence_line(load_run(run_id), entry))
        reset = self.limited(entry, bg)
        if reset is not None:
            return self.limit_alert(entry, bg, reset, events)
        record_alert(run_id, name, received, "hung")
        what = "herdr has lost track of it" if state == "unknown" else "it reads working"
        look = (f"`claude logs {entry['bg_id']}`" if bg
                else f"`herdr agent read {name} --source recent-unwrapped --lines 80`")
        line = (f"ALERT {name} may be hung: {what}, and its transcript hasn't changed for {int(quiet // 60)} min "
                f"(a tool call that never returns, such as a test or a server in watch mode?); inspect it with "
                f"{look}. The watch won't stop it, and won't raise this again for this task")
        return 8, self.with_tail(line, bg, entry)

    def idle_from_start(self, events: list[dict]) -> bool:
        """Never seen working, but its last task or answer is `start_grace` old (in the log, so a watch started
        late still judges it) with nothing reported since: its turn ended, or never began. A task some watch
        already alerted on isn't judged again (a restarted watch would re-alert every `--grace`); a new task or
        answer, or a `working` reading, re-arms it."""
        received, sent, at = since_last_task(events, self.name)
        # A worker held at a startup screen heard its task only once its released doorbell rang.
        released = next((e.get("time") for e in reversed(events)
                         if e.get("event") == "held_rung" and e.get("name") == self.name and e.get("rung")), None)
        return (bool(received) and not sent and min(age_seconds(at), age_seconds(released)) >= self.start_grace
                and not alerted(events, self.name, received))

    def stopped(self, entry: dict, bg: bool, events: list[dict]) -> tuple[int, str] | None:
        """Its turn has ended: fine if it reported since its last task or answer, else nudge it once, then alert."""
        run_id, name = self.run_id, self.name
        received, sent, _ = since_last_task(events, name)
        self.worked, self.idle_for = False, None
        if sent:
            return None  # a report, or a plan or question waiting for its answer
        reset = self.limited(entry, bg)
        if reset is not None:  # nothing to nudge: it can't go on until the reset
            return self.limit_alert(entry, bg, reset, events)
        def work() -> str:  # git and gh calls: only for an alert
            return wait_note(events, name) + evidence_line(load_run(run_id), entry)

        if bg:  # the watch can't reach a background session: only its Stop hook nudges it
            record_alert(run_id, name, received)
            if (nudge_of(events, name, received) or {}).get("via"):
                return 3, (f"ALERT {name} stopped working without sending a message (its Stop hook nudged it once"
                           f"{self.unread_note()}); inspect it with `claude logs {entry['bg_id']}`{work()}")
            return 3, (f"ALERT {name} stopped working without sending a message{self.unread_note(' (', ')')}; "
                       f"inspect it with `claude logs {entry['bg_id']}`, or nudge it once with `mesh send {name} --type info "
                       f"--body \"Report with mesh send\"` and pass its send_message on{work()}")
        if claim_nudge(run_id, name, received):
            self.nudged = received
            nudge(run_id, name, entry, received)
            self.worked, self.idle_for = True, 0.0  # alert if it stays idle, or goes idle again without a report
            return None
        done = nudge_of(read_log(run_id), name, received) or {}
        if self.nudged != received and age_seconds(done.get("time")) < self.grace:
            # another watch just nudged it: give it the same time the nudger gives it
            self.worked, self.idle_for = True, 0.0
            return None
        how = ("nudged once by its Stop hook" if done.get("via") else "nudged once" if done.get("rung")
               else "its nudge was not delivered")
        how += self.unread_note()
        line = (f"ALERT {name} stopped working without sending a message ({how}); inspect it with "
                f"`herdr agent read {name} --source recent-unwrapped --lines 80`{work()}")
        record_alert(run_id, name, received)
        return 3, self.with_tail(line, bg, entry)

    def unread_note(self, before: str = ", ", after: str = "") -> str:
        """Says so when a task or answer is still in its mailbox: it never picked it up."""
        types = {m["type"] for m in unread_received(self.run_id, self.name)}
        kinds = [t for t in RECEIVED_TYPES if t in types]
        if not kinds:
            return ""
        return f"{before}its {' and '.join(kinds)} {'are' if len(kinds) > 1 else 'is'} still unread{after}"

    def with_tail(self, line: str, bg: bool, entry: dict) -> str:
        tail = "" if bg else pane_tail(self.name) or (pane_tail(entry["pane"]) if entry.get("pane") else "")
        return f"{line}\n  last lines of its pane:\n{tail}" if tail else line


def watch_agents(run_id: str, names: list[str], timeout: float = 0, interval: float = 5.0, grace: float = SETTLE_GRACE,
                 finals_at_start: int | None = None, alerts_only: bool = False,
                 hang: float | None = None, autoreset: bool = False) -> tuple[int, str]:
    """Wait for the first of `names` to report done/failed (0) or raise an alert (3-8), with the line that says which.

    A report one of them sent that its parent hasn't read yet returns 0 at once. `finals_at_start` (one name only)
    is the child's count of final sends before its task was delivered, so a report that lands before the watch
    starts still counts (and an unread one isn't news). `alerts_only` keeps watching through reports. `hang` is
    the transcript silence that raises exit 8 (default HANG_AFTER, or MESH_HANG_AFTER; 0 turns it off).
    `autoreset` (the root's own watch, with MESH_ROOT_AUTORESET=1) resets an idle root whose cache went cold.
    """
    hang = hang_after() if hang is None else hang
    watches = [Watch(run_id, name, grace, finals_at_start, hang) for name in names]
    deadline = time.monotonic() + timeout if timeout else None
    held = hold_watch(run_id, names)
    try:
        return poll_watches(run_id, watches, timeout, interval, deadline, alerts_only, autoreset)
    finally:
        for handle in held:
            handle.close()


def poll_watches(run_id: str, watches: list["Watch"], timeout: float, interval: float, deadline: float | None,
                 alerts_only: bool, autoreset: bool = False) -> tuple[int, str]:
    checked = float("-inf")  # when the root was last checked for an idle reset
    while True:
        run = load_run(run_id)
        # One `claude agents` call per poll, shared by every background worker.
        bg_rows = claude_agents() if any(run["agents"].get(w.name, {}).get("view") == "bg" for w in watches) else None
        events = read_log(run_id)  # one read per poll, shared by every watch
        if autoreset and time.monotonic() - checked >= AUTORESET_EVERY:
            checked = time.monotonic()
            quietly(maybe_autoreset, run_id, run, events)
        for watch in watches:
            event = watch.tick(interval, alerts_only, bg_rows, events)
            if event:
                return event
        if all(w.finished for w in watches):  # without --alerts only a retired worker finishes without returning
            retired = [w.name for w in watches if w.retired and not w.reported]
            if not retired:
                return 0, "every watched worker reported and has ended; nothing left to watch"
            rest = "" if len(retired) == len(watches) else "; the rest reported and have ended"
            return 0, f"retired {', '.join(retired)}{rest}; nothing left to watch"
        if deadline and time.monotonic() > deadline:
            waiting = [w for w in watches if not w.reported and not w.retired]
            if not waiting:
                return 0, (f"every watched worker reported{' or was retired' if any(w.retired for w in watches) else ''} "
                           f"within {timeout}s")
            states = ", ".join(f"{w.name}: {w.prev}" for w in waiting)
            who = waiting[0].name if len(waiting) == 1 else f"{len(waiting)} workers"
            return 6, f"ALERT {who} has not reported within {timeout}s ({states})"
        time.sleep(interval)


def watch_lock(run_id: str, name: str) -> Path:
    return run_dir(run_id) / "watching" / f"{name}.lock"


def hold_watch(run_id: str, names: list[str]) -> list:
    """A shared lock on each watched worker's lock file, held while the watch runs: the kernel drops it when the
    process dies, so `watched` never trusts a stale pid file."""
    held = []
    for name in names:
        path = watch_lock(run_id, name)
        path.parent.mkdir(parents=True, exist_ok=True)
        handle = path.open("a")
        fcntl.flock(handle, fcntl.LOCK_SH)
        held.append(handle)
    return held


def watched(run_id: str, name: str) -> bool:
    """Whether some running `mesh watch` (or `mesh ask`) watches `name`."""
    path = watch_lock(run_id, name)
    if not path.exists():
        return False
    with path.open("a") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(handle, fcntl.LOCK_UN)
    return False


def unwatched(run_id: str, skip: tuple[str, ...] = ()) -> list[str]:
    """The run's workers that owe a report (a task or answer with no report since) and that no watch covers,
    skipping one a watch already raised as gone (exit 5) on that task. No herdr or `claude` calls."""
    run = maybe_run(run_id)
    if not run:
        return []
    events = read_log(run_id)
    owing = []
    for name, entry in run["agents"].items():
        if (entry.get("role") != "worker" or name in skip or entry.get("view") == "headless"
                or entry.get("status") in ("retiring", "retired")):
            continue
        received, sent, _ = since_last_task(events, name)
        if received and not sent and not alerted(events, name, received, "gone") and not watched(run_id, name):
            owing.append(name)
    return owing


def warn_unwatched(run_id: str, skip: tuple[str, ...] = ()) -> None:
    """Root-side commands warn when a worker that owes a report has no watch, so a silent stop goes unseen. Only
    those are asked whether they're gone: `mesh watch --any` leaves a gone worker out, so it needs other advice.
    These commands start or hand out work, so the root is about to wait: the moment a reset pays most."""
    root_hint(run_id, about_to_wait=True)
    try:
        names = unwatched(run_id, skip)
    except (OSError, MeshError):
        return  # a warning must never fail the command that just did its work
    if not names:
        return

    def looks_gone(name: str, entry: dict, bg_rows: list[dict]) -> bool:
        try:
            return agent_status(name, entry, bg_rows) == "gone"
        except Exception:  # noqa: BLE001 - can't tell: warn as for a live one
            return False

    agents = load_run(run_id)["agents"]
    try:
        bg_rows = claude_agents() if any(agents[n].get("view") == "bg" for n in names) else []
    except Exception:  # noqa: BLE001
        bg_rows = []
    gone = [n for n in names if looks_gone(n, agents[n], bg_rows)]
    live = [n for n in names if n not in gone]
    if live:
        each = "each owes" if len(live) > 1 else "it owes"
        print(f"warning: no `mesh watch` covers {', '.join(live)} ({each} a report): start "
              f"`mesh watch --any --alerts` in the background; a running --any watch doesn't pick up workers "
              "spawned after it started", file=sys.stderr)
    for name in gone:
        print(f"warning: {name} looks gone without a report: `mesh watch {name}` (exit 5), or `mesh resume` / "
              f"`mesh retire` it", file=sys.stderr)


def hang_after() -> float:
    try:
        return float(os.environ.get("MESH_HANG_AFTER") or HANG_AFTER)
    except ValueError:
        return HANG_AFTER


def watch_agent(run_id: str, name: str, timeout: float = 0, interval: float = 5.0, grace: float = SETTLE_GRACE,
                finals_at_start: int | None = None) -> tuple[int, str]:
    return watch_agents(run_id, [name], timeout, interval, grace, finals_at_start)


def cmd_retire(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    entry = require_parent(load_run(run_id), me, args.agent, "retire")
    retire_worker(run_id, args.agent, entry)
    emit({"retired": args.agent, "cwd": entry.get("cwd"), "branch": entry.get("branch")})
    return 0


def retire_worker(run_id: str, name: str, entry: dict) -> None:
    """Close a worker's pane (or stop its background session); its conversation stays resumable."""
    with editing_run(run_id) as run:  # first, so a watch never takes the closing pane for a crash
        agent = run["agents"][name]
        before, agent["status"] = agent.get("status"), "retiring"
    try:
        if entry.get("view") == "bg":
            stop_bg(entry)
        elif entry.get("pane"):  # none if its pane never opened
            try:  # let it end the turn it reported in, so its conversation is saved whole (as in swap_model)
                herdr("agent", "wait", name, "--until", "idle", "--until", "done", "--timeout", str(RETIRE_WAIT_MS),
                      timeout=RETIRE_WAIT_MS / 1000 + 10)
            except HerdrError:
                pass  # gone already, or still busy: close it anyway
            try:
                herdr("pane", "close", entry["pane"])
            except HerdrError as exc:
                if exc.code not in ("pane_not_found", "agent_not_found"):
                    raise
    except BaseException:
        with editing_run(run_id) as run:  # still open: it isn't retired
            run["agents"][name]["status"] = before
        raise
    with editing_run(run_id) as run:
        run["agents"][name]["status"] = "retired"
    log_event(run_id, "retire", name=name)


# ── past workers: agents, resume, open ───────────────────────────────────


def all_runs() -> list[tuple[dict, Path]]:
    """Every run, live and archived, newest first, with its directory."""
    home = mesh_home()
    runs = []
    for path in (*home.glob("*/run.json"), *home.glob("archive/*/run.json")):
        try:
            runs.append((json.loads(path.read_text()), path.parent))
        except (OSError, ValueError):
            continue
    return sorted(runs, key=lambda r: r[0].get("created", ""), reverse=True)


def worker_prs(folder: Path, name: str, entry: dict | None = None) -> list[str]:
    """PR links in the messages a worker sent; its `done` reports carry them. PRs it only reviewed don't count."""
    reviewed = set((entry or {}).get("reviews") or ())
    prs: list[str] = []
    for path in sorted((folder / "inbox").glob("**/*.md")):
        meta, body = parse_message(path)
        if meta.get("from") == name:
            prs += PR_RE.findall(body)
    return [url for url in dict.fromkeys(prs) if url not in reviewed]


def gh_json(argv: list[str], cwd: str | Path | None = None) -> tuple[object, str | None]:
    """`gh <argv>` with `--json` fields: what it printed, parsed, or None and why gh couldn't answer."""
    result = run_cli(["gh", *argv], cwd=cwd, timeout=30)
    if result.returncode:
        return None, (result.stderr.strip().splitlines() or [f"gh exited {result.returncode}"])[-1]
    try:
        return json.loads(result.stdout), None
    except ValueError:
        return None, "gh printed no JSON"


def github_repos(repo: str | Path) -> set[str] | None:
    """`owner/name` of each GitHub remote of `repo` (lowercase): empty when its remotes are elsewhere, None when
    it has none or git can't read them (the repo is gone)."""
    try:
        remotes = git("remote", cwd=repo).split()
        urls = [git("remote", "get-url", remote, cwd=repo) for remote in remotes]
    except MeshError:
        return None
    return {f"{m.group(1)}/{m.group(2)}".lower() for m in map(GITHUB_REMOTE_RE.search, urls) if m} if urls else None


def pr_head_branch(pr: str) -> str | None:
    """The branch a PR was opened from (`gh pr view`), or None when gh can't say."""
    data, _ = gh_json(["pr", "view", pr, "--json", "headRefName"])
    return data.get("headRefName") if isinstance(data, dict) else None


def worktree_branch(entry: dict) -> str | None:
    """The branch a worker's own worktree is on now (it may follow its repo's naming), not a main checkout's."""
    cwd, repo = entry.get("cwd"), entry.get("repo")
    if not cwd or not Path(cwd).is_dir() or (repo and Path(cwd).resolve() == Path(repo).resolve()):
        return None
    try:
        return git("branch", "--show-current", cwd=cwd) or None
    except MeshError:
        return None


def opened_pr(pr: str, head: str, run: dict, entry: dict, live_branch: bool = False) -> bool:
    """Whether this worker's branch is the PR's head, in the PR's repo (unless the worker's repo has no remotes)."""
    if live_branch and pr in (entry.get("reviews") or ()):
        return False  # a reviewer that checked the PR's branch out isn't its author (one reviewing its own PR is)
    branch = worktree_branch(entry) if live_branch else entry_branch(run, entry)
    if not branch or branch != head:
        return False
    repos = github_repos(entry["repo"]) if entry.get("repo") else None
    owner_repo = pr.split("github.com/", 1)[1].rsplit("/pull/", 1)[0].lower()
    return repos is None or owner_repo in repos


def find_worker(ref: str, from_run: str | None = None) -> tuple[dict, Path, str, dict]:
    """The newest worker whose name, branch or PR link is `ref`.

    A PR link names the worker whose branch is the PR's head (asked of `gh`): its recorded branch first, then
    the branch its worktree is on. Only when gh can't answer, or no branch matches, do the PR links in the
    workers' own messages count.
    """
    pr = PR_RE.search(ref)
    workers = [(run, folder, name, entry) for run, folder in all_runs() if not from_run or run["id"] == from_run
               for name, entry in reversed(run["agents"].items())  # a restart beats the agent it replaced
               if entry.get("role") != "root"]
    found = next((w for w in workers if ref in (w[2], entry_branch(w[0], w[3]))), None)
    head = pr_head_branch(pr.group(0)) if pr and not found else None
    for live_branch in (False, True) if head else ():
        found = found or next((w for w in workers if opened_pr(pr.group(0), head, w[0], w[3], live_branch)), None)
    if pr and not found:
        found = next((w for w in workers if pr.group(0) in worker_prs(w[1], w[2], w[3])), None)
    if found:
        return found
    raise MeshError(f"no worker matches {ref}" + (f" in run {from_run}" if from_run else "") + "; see `mesh agents`")


def proc_start(pid: int) -> str | None:
    """When a process started, which tells it from a later one given the same pid: its start time in clock
    ticks from /proc (field 22 of `stat`), else what `ps` says. None when it can't be read (or it's gone)."""
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        if Path("/proc/self/stat").exists():
            return None  # a /proc without this pid: it's gone
    try:
        out = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.strip() or None


def pid_alive(pid: int | None, start: str | None = None) -> bool:
    """Whether `pid` runs, and is still the process that started at `start` (proc_start) when that was recorded."""
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass  # alive, just not ours
    return not start or proc_start(pid) in (start, None)


def live_holder(name: str, entry: dict, agents: list[dict] | None = None,
                bg_rows: list[dict] | None = None, procs: list[dict] | None = None) -> dict | None:
    """A live agent that may hold this worker's conversation already.

    A background worker's own session, while it runs. Then any herdr agent in its own worktree (the user
    may have reopened it with `mesh open`); in a main checkout, which other sessions share, only an agent
    still carrying its name. herdr can lose a live agent's registration, so then any process that may hold
    it (`process_holder`). `procs` is one `agent_processes()` read, shared by a caller checking many workers.
    """
    if entry.get("view") == "bg":
        row = bg_row(entry, bg_rows)
        if row and row.get("status"):
            return {"name": name, "pane_id": None, "bg_id": row.get("id")}
    if entry.get("view") == "headless":
        # Busy while the `mesh ask` running it lives, or the copilot it started, which a killed one leaves
        # running (copilot_ask); a `running` they both left is stale.
        if entry.get("status") != "running":
            return None
        for key, answering in (("pid", "mesh process"), ("copilot_pid", "copilot process")):
            if pid_alive(entry.get(key), entry.get(f"{key}_start")):
                return {"name": name, "pane_id": None, "pid": entry[key], "answering": answering}
        return None
    cwd = entry.get("cwd")
    if agents is None:
        try:
            agents = herdr("agent", "list").get("agents", [])
        except HerdrError:
            raise  # herdr is there but failed: don't guess
        except MeshError:
            agents = []  # outside herdr (`mesh open` from a plain terminal): only the processes can tell
    if not cwd or (entry.get("repo") and Path(cwd).resolve() == Path(entry["repo"]).resolve()):
        return next((a for a in agents if a.get("name") == name), None) or process_holder(name, entry, None, procs)
    top = Path(cwd).resolve()
    return (next((a for a in agents if inside(a.get("cwd"), top) or inside(a.get("foreground_cwd"), top)), None)
            or process_holder(name, entry, top, procs))


def process_holder(name: str, entry: dict, top: Path | None, procs: list[dict] | None = None) -> dict | None:
    """A running `claude` / `agy` process of the worker's kind that may hold its conversation, herdr or not.

    In its own worktree (`top`), any one working there; in a shared checkout (`top` None), only one whose command
    line names its session. Without /proc, the pane it last ran in, if that still runs its CLI.
    """
    kind, session = entry.get("kind"), entry.get("session")
    if kind not in AGENT_BINARIES:
        return None  # a Copilot asker holds its session through its `mesh ask` pid (claim_copilot)
    procs = agent_processes() if procs is None else procs
    for proc in procs:
        if agent_binary(proc.get("argv")) != kind:
            continue
        if (inside(proc.get("cwd"), top) if top else bool(session) and session in proc.get("argv", [])):
            return {"name": name, "pane_id": None, "process": proc["pid"], "cwd": proc.get("cwd")}
    if top and not Path("/proc").is_dir() and pane_probe(entry.get("pane"), kind) == "alive":
        return {"name": name, "pane_id": entry["pane"]}
    return None


def print_table(rows: list[dict], cols: tuple[str, ...]) -> None:
    widths = {c: max(len(c), *(len(str(r[c])) for r in rows)) for c in cols}
    print("  ".join(c.upper().ljust(widths[c]) for c in cols))
    for row in rows:
        print("  ".join(str(row[c]).ljust(widths[c]) for c in cols))


def cmd_agents(args: argparse.Namespace) -> int:
    try:
        live = herdr("agent", "list").get("agents", [])
    except MeshError:
        live = []  # outside herdr: every agent shows as gone
    query = (args.query or "").lower()
    pr = PR_RE.search(args.query or "")
    head = pr_head_branch(pr.group(0)) if pr else None  # a PR link also finds its author by the PR's branch
    rows = []
    runs = all_runs()
    bg_rows = claude_agents() if any(e.get("view") == "bg" for r, _ in runs for e in r["agents"].values()) else []
    procs = agent_processes()
    for run, folder in runs:
        if args.run and run["id"] != args.run:
            continue  # by run id, not branch: a worker resumed into a run keeps its old run's branch
        for name, entry in run["agents"].items():
            if entry.get("role") == "root":
                continue
            cwd, branch, prs = entry.get("cwd") or "", entry_branch(run, entry) or "", worker_prs(folder, name, entry)
            if head and pr.group(0) not in prs and any(opened_pr(pr.group(0), head, run, entry, live)
                                                       for live in (False, True)):
                prs.append(pr.group(0))
            reviews = entry.get("reviews") or []
            if query and not (any(query in str(v).lower() for v in (name, entry.get("repo"), branch, *prs, *reviews))
                              or (pr and pr.group(0) in prs)):
                continue
            rows.append({
                "name": name, "run": run["id"], "archived": folder.parent.name == "archive",
                "kind": entry.get("kind"), "model": entry.get("model") or "", "view": entry.get("view") or "pane",
                "repo": Path(entry["repo"]).name if entry.get("repo") else "", "branch": branch,
                "worktree": "present" if cwd and Path(cwd).exists() else "removed",
                "state": "live" if live_holder(name, entry, live, bg_rows, procs) else "gone",
                "session": "found" if find_session(run["id"], name, entry) else "missing",
                "prs": " ".join(prs), "reviews": " ".join(reviews), "cwd": cwd,
            })
    if args.json:
        emit(rows)
    elif not rows:
        scope = (f" match {args.query}" if query else "") + (f" in run {args.run}" if args.run else "")
        print(f"No workers{scope or ' found'}.")
    else:
        print_table(rows, ("name", "run", "kind", "model", "view", "repo", "branch", "worktree", "state", "session",
                           "prs", "reviews"))
    return 0


def resumable(ref: str, from_run: str | None, live_hint) -> tuple[dict, str, dict, str]:
    """Find a past worker and its conversation, refusing one that is still running."""
    run, _, name, entry = find_worker(ref, from_run)
    session = find_session(run["id"], name, entry)
    if not session:
        raise MeshError(
            f"can't find {name}'s {entry.get('kind')} conversation; start a fresh worker with "
            f"`mesh spawn --cwd {entry.get('cwd')}` and give it the old plan and report"
        )
    holder = live_hint(name, entry)
    if holder and holder.get("pid"):
        raise MeshError(f"{name} is still answering in {holder['answering']} {holder['pid']}; "
                        "ask it again once that finishes")
    if holder and holder.get("process"):
        raise MeshError(f"{name}'s conversation may still be open in process {holder['process']} (a {entry.get('kind')} "
                        f"running in {holder.get('cwd')}, which herdr doesn't list); see it with "
                        f"`ps -o pid,args -p {holder['process']}`, and resume once it has ended")
    if holder:
        where = (f"background session {holder['bg_id']}" if holder.get("bg_id")
                 else f"pane {holder.get('pane_id')}")
        raise MeshError(f"{name} is still running in {where}; {holder['hint']}")
    return run, name, entry, session


def cmd_resume(args: argparse.Namespace) -> int:
    """Bring a past worker back, conversation and all, as a worker of this run."""
    run_id, me = identity(args)
    result = resume_worker(args, run_id, me)
    emit(result)
    held = report_held(result["name"], result.get("delivery"))  # the alert first: only the user can clear it
    warn_unwatched(run_id)
    return held or 0


READ_ONLY_STARTS = ("Question (read-only)", "Review (read-only)")


def read_only_task(task: str | None) -> bool:
    """A question or a review from `mesh ask` (PROTOCOL.md rule 7)."""
    return bool(task) and task.lstrip().startswith(READ_ONLY_STARTS)


def first_line(text: str | None, limit: int = 160) -> str:
    line = next((ln.strip() for ln in (text or "").splitlines() if ln.strip()), "")
    return line[:limit]


DIRECT_STARTS = ("Direct task (no plan)", "Plan review by the user")


def planned_task(task: str | None) -> bool:
    """A task the worker plans first: not a question, a review or a direct task."""
    return bool(task) and not task.lstrip().startswith(READ_ONLY_STARTS + DIRECT_STARTS)


def task_gist(task: str | None, limit: int = 160) -> str:
    """The line that says what a task is: the first one past the standard prefixes, without a heading's `#`."""
    for paragraph in re.split(r"\n\s*\n", task or ""):
        paragraph = paragraph.strip()
        if not paragraph or paragraph.startswith(READ_ONLY_STARTS + DIRECT_STARTS):
            continue
        line = first_line(paragraph.lstrip("#").strip())
        if line:
            return line[:limit]
    return ""


def maybe_compact(args: argparse.Namespace, entry: dict, session: str, model: str, task: str | None,
                  cross_run: bool, peer: bool = False) -> dict:
    """`--compact`: compact the conversation before it is reopened, if it's worth it (see should_compact)."""
    mode = getattr(args, "compact", None) or "auto"
    read_only = getattr(args, "read_only", False) or read_only_task(task)
    tokens = context_tokens(entry, session)
    report: dict = {"context_tokens": tokens, "compacted": False}
    if not should_compact(mode, entry, tokens, read_only, cross_run, peer):
        return report
    focus = getattr(args, "focus", None) or (
        PEER_FOCUS.format(repo=Path(entry.get("repo") or entry["cwd"]).name) if peer else COMPACT_FOCUS.format(
            task=task_gist(task) or "the follow-up task you are about to get"))
    ok, output = compact_conversation(entry, session, model, focus)
    report["compacted"] = ok
    if ok:
        report["context_tokens_after"] = context_tokens(entry, session)
    else:
        report["note"] = f"compaction failed, so it resumes as it was: {output}"
    return report


def finished_pr(repo: str | Path, branch: str, base: str | None = None) -> tuple[dict | None, str | None]:
    """The newest PR from `branch` once none from it is open (merged or closed), and why gh couldn't say.

    A PR counts only when its head commit is in the branch and not in `base`, the commit the worker started
    from, so an old PR from a reused branch name doesn't, merged into the default branch or not. One whose head
    commit isn't here (squash-merged and never fetched) still counts: telling would take a fetch.
    """
    data, error = gh_json(["pr", "list", "--head", branch, "--state", "all", "--json", "number,url,state,headRefOid"],
                          cwd=repo)
    if error or not isinstance(data, list):
        return None, error or "gh printed no list"

    def is_ancestor(oid: str, ref: str) -> bool:
        try:
            git("merge-base", "--is-ancestor", oid, ref, cwd=repo)
            return True
        except MeshError:
            return False

    def on_branch(pr: dict) -> bool:
        oid = pr.get("headRefOid")
        try:
            git("cat-file", "-e", f"{oid}^{{commit}}", cwd=repo)
        except MeshError:
            return True  # not here to compare
        return is_ancestor(oid, f"refs/heads/{branch}") and not (base and is_ancestor(oid, base))
    data = [pr for pr in data if pr.get("state") == "OPEN" or on_branch(pr)]
    if not data or any(pr.get("state") == "OPEN" for pr in data):
        return None, None
    return max(data, key=lambda pr: pr.get("number") or 0), None


def fetch_remote(repo: Path, remote: str, *refspecs: str) -> bool:
    """`git fetch`, never stopping for credentials and giving up after a minute (offline: the local copy will do)."""
    try:
        return subprocess.run(["git", "fetch", "-q", remote, *refspecs], cwd=repo, capture_output=True,
                              stdin=subprocess.DEVNULL, env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
                              timeout=60).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def pr_remote(repo: Path, pr: str) -> str | None:
    """The remote of `repo` that a PR link belongs to (`upstream` in a fork, say), if any."""
    match = re.search(r"github\.com/([\w.-]+/[\w.-]+)/pull/", pr)
    try:
        for remote in git("remote", cwd=repo).split():
            github = GITHUB_REMOTE_RE.search(git("remote", "get-url", remote, cwd=repo))
            if match and github and f"{github.group(1)}/{github.group(2)}".lower() == match.group(1).lower():
                return remote
    except MeshError:
        pass
    return None


def remote_default(repo: Path, remote: str, pr: str) -> str | None:
    """`<remote>/<its default branch>`: from `<remote>/HEAD`, else from `gh repo view`; None when neither says."""
    try:
        return git("rev-parse", "--abbrev-ref", f"{remote}/HEAD", cwd=repo)
    except MeshError:
        pass
    owner_repo = pr.split("github.com/", 1)[-1].rsplit("/pull/", 1)[0]
    data, _ = gh_json(["repo", "view", owner_repo, "--json", "defaultBranchRef"], cwd=repo)
    name = ((data or {}).get("defaultBranchRef") or {}).get("name") if isinstance(data, dict) else None
    try:
        return git("rev-parse", "--abbrev-ref", f"{remote}/{name}", cwd=repo) if name else None
    except MeshError:
        return None


def leave_finished_pr(args: argparse.Namespace, run_id: str, entry: dict, branch: str | None,
                      task: str | None) -> dict:
    """A change task for a worker whose PR is merged or closed goes on a new branch.

    Pushing to the old branch would update a dead PR (or recreate a branch deleted on merge). The worktree
    moves to `mesh/<run>/<slug>`: after a merge at the freshly fetched default branch, when the worktree is
    clean; after a close (the work never landed) at the old branch's tip, so its commits come along. In a main
    checkout, or a dirty worktree after a merge, the task tells the worker to do it. Only a resume with a change
    task is checked: without a task the worker would never hear of it, and the next resume with one checks again.
    Returns {} when there's nothing to say, else a `note` for the resume output, `task_note` for the task, and
    `branch` / `base` when the worktree moved. gh missing or failing never blocks a resume: it goes on as before,
    with a note.
    """
    read_only = getattr(args, "read_only", False) or read_only_task(task)
    current = worktree_branch(entry) or branch
    if not task or read_only or not current or not entry.get("repo") or not github_repos(entry["repo"]):
        return {}  # a question or review stays put; a repo off GitHub has no PR to check
    pr, error = finished_pr(entry["repo"], current, entry.get("base"))
    if error:
        return {"note": f"couldn't check whether {current} has a merged or closed PR (gh: {error}); "
                        f"resuming on it as before"}
    if not pr:
        return {}
    merged = pr.get("state") == "MERGED"
    what = f"PR #{pr.get('number')} ({pr.get('url')}) from `{current}` is {'merged' if merged else 'closed'}"
    cwd, repo = Path(entry["cwd"]), Path(entry["repo"])
    main_checkout = cwd.resolve() == repo.resolve()
    try:
        dirty = not main_checkout and bool(git("status", "--porcelain", cwd=cwd))
    except MeshError:
        dirty = True
    start = "the repo's default branch (fetch it first)" if merged else f"the tip of `{current}`"
    if main_checkout or (dirty and merged):
        why = "it runs in the main checkout" if main_checkout else "the worktree has uncommitted changes"
        return {"note": f"{what}, but {why}, so it stays on {current}; the task tells the worker to start a new branch",
                "task_note": f"Note from mesh: {what}. Don't push to that branch: start a new one from {start} "
                             f"and open a new PR for this task"
                             + (", and decide what to do with the uncommitted changes." if dirty else ".")}
    remote, oid = pr_remote(repo, pr.get("url") or ""), pr.get("headRefOid")

    def have(commit: str, inside: str | None = None) -> bool:
        try:
            git("cat-file", "-e", f"{commit}^{{commit}}", cwd=cwd)
            if inside:
                git("merge-base", "--is-ancestor", commit, inside, cwd=cwd)
            return True
        except MeshError:
            return False
    if merged:
        fetch_remote(repo, remote or "origin")
        start = (remote and remote_default(repo, remote, pr.get("url") or "")) or default_base(repo)
        told = f"`{start}`"
    else:
        # a dirty worktree keeps its changes: the new branch starts at the same commit
        start, told = "HEAD", f"the tip of `{current}`, so its commits come along"
        if oid and not have(oid, "HEAD"):  # its branch was deleted and recreated at its base: get the PR's head
            if remote:
                fetch_remote(repo, remote, f"pull/{pr.get('number')}/head")
            if have(oid):
                start, told = oid, f"the closed PR's head ({oid[:12]}, fetched from GitHub), so its commits come along"
            else:
                told = (f"the tip of `{current}`, but the closed PR's commits aren't here: its branch is gone and "
                        f"`pull/{pr.get('number')}/head` couldn't be fetched")
    sha = git("rev-parse", "--verify", f"{start}^{{commit}}", cwd=cwd)

    def taken(name: str) -> bool:
        try:
            git("rev-parse", "--verify", "--quiet", f"refs/heads/{name}", cwd=repo)
            return True
        except MeshError:
            return False
    slug = slugify(current.rsplit("/", 1)[-1], 24)
    slug, n = re.sub(r"-\d+$", "", slug) or slug, 2  # `fix-2` again makes `fix-3`, not `fix-2-2`
    new = f"mesh/{run_id}/{slug}"
    while new == current or taken(new):
        new, n = f"mesh/{run_id}/{slug}-{n}", n + 1
    try:
        git("switch", "-q", "-c", new, sha, cwd=cwd)
    except MeshError as exc:  # uncommitted changes that clash with the new start
        return {"note": f"{what}, but switching to a new branch failed ({exc}), so it stays on {current}; "
                        f"the task tells the worker to start a new branch",
                "task_note": f"Note from mesh: {what}. Don't push to that branch: start a new one from {told} "
                             f"and open a new PR for this task, and decide what to do with the uncommitted changes."}
    log_event(run_id, "branch", path=str(cwd), branch=new, left=current, pr=pr.get("url"))
    return {"branch": new, "base": sha, "pr": pr.get("url"),
            "note": f"{what}: {cwd} is now on a new branch, {new}, from {told}; {current} is kept",
            "task_note": f"Note from mesh: {what}, so this worktree is now on a new branch, `{new}`, started from "
                         f"{told}. Push that branch and open a new PR for this task; don't push to `{current}`"
                         + (" (its commits are still there if you need them)." if merged else ".")}


def resume_worker(args: argparse.Namespace, run_id: str, me: str) -> dict:
    current = load_run(run_id)

    def live_hint(name, entry):
        holder = live_holder(name, entry)
        if holder:
            held = holder.get("name")
            holder["hint"] = (f"send it the task: `mesh send {held} --type task`" if held in current["agents"]
                              else f"attach to it with `mesh open {held}`" if holder.get("bg_id")
                              else f"go there with `herdr agent focus {held or holder.get('pane_id')}`")
        return holder

    old_run, old_name, old, session = resumable(args.ref, args.from_run, live_hint)
    # By the entry too: a resume that was given a `-2` name is still that peer.
    peer_name = getattr(args, "peer", None) or old.get("peer") or (old_name if peer_of(old_name, old) else None)
    peer = load_peers()["peers"].get(peer_name) if peer_name else None
    if old["kind"] == "copilot":
        raise MeshError(f"{old_name} is a Copilot asker, which only answers: ask it again with `mesh ask {old_name}`, "
                        "or give the change to the PR's author or a fresh worker")
    task = read_body(args.task, args.task_file)
    if peer and task and not read_only_task(task):
        raise MeshError(f"{old_name} is a peer asker, which only answers questions about its project: ask it with "
                        f"`mesh ask {peer_name}`, and give a change to a worker in that repo")
    # A task it plans first plans where a spawn on `auto` would, whatever it last ran on, and gets the
    # execution phase, so `mesh approve` moves it on; a named model or effort covers the whole task, as in spawn.
    planned = planned_task(task) and not (args.model or args.effort)
    notes: list[str] = []
    if planned:
        effort = DEFAULT_EFFORT
        model, notes = plan_model(old["kind"], effort)
    else:
        model, effort = resumed_model(old, args.model, args.effort)
    view = getattr(args, "view", None) or old.get("view") or "pane"
    if view == "bg" and old["kind"] != "claude":
        raise MeshError("--view bg is for Claude workers; agy has no background sessions")
    if view == "bg" and not address_alive(current["agents"][current["root"]].get("address")):
        if getattr(args, "view", None):
            raise MeshError("a background worker needs a Claude root it can message (see `mesh init`)")
        notes.append("background needs a Claude root that background workers can message; reopening in a pane")
        view = "pane"
    branch = entry_branch(old_run, old)
    taken = live_agent_names() | (set(current["agents"]) - ({old_name} if old_run["id"] == run_id else set()))
    name, n = old_name, 2
    while name in taken:
        name, n = f"{old_name[:29]}-{n}", n + 1

    cwd, repo_top = old["cwd"], Path(old["repo"])
    if peer:  # its own detached worktree, which outlives runs: no branch, and no run's `mesh stop` removes it
        branch, recreated, moved = None, ensure_peer_worktree({**peer, "cwd": cwd}), {}
    else:
        recreated = ensure_worktree(old, branch)
        moved = leave_finished_pr(args, run_id, old, branch, task)
    if moved.get("note"):
        notes.append(moved["note"])
    if moved.get("task_note") and task:
        task = f"{task.rstrip()}\n\n{moved['task_note']}"
    branch, base_sha = moved.get("branch") or branch, moved.get("base") or old.get("base")
    with editing_run(run_id) as run:
        worktrees = run.setdefault("worktrees", [])
        known = next((w for w in worktrees if Path(w["path"]) == Path(cwd)), None)
        if known and moved.get("branch"):
            known.update(branch=branch, base=base_sha)
        elif branch and Path(cwd).resolve() != repo_top.resolve() and not known and not peer:
            # so this run's stop cleans it up (and drops the branch if it still has no commits)
            base = {"base": base_sha} if base_sha else {}
            worktrees.append({"path": cwd, "repo": str(repo_top), "branch": branch, **base})
    compaction = maybe_compact(args, old, session, model, task, cross_run=old_run["id"] != run_id, peer=bool(peer))
    if compaction.get("note"):
        notes.append(compaction["note"])

    log = worker_log(run_id, name) if old["kind"] == "agy" else None
    env = mesh_env(run_id, name, me, "worker")
    # A question or a review is held by the deny list, and so is a task it plans first (a named model doesn't
    # skip the plan), until `mesh approve`; with no task, it carries on as it was. A direct task gets no list.
    read_only = old["kind"] == "claude" and (getattr(args, "read_only", False) or read_only_task(task) or bool(peer))
    planning = old["kind"] == "claude" and not read_only and (planned_task(task) if task else bool(old.get("planning")))
    deny = claude_deny({**old, "read_only": read_only, "planning": planning})
    exec_model = (old.get("exec_model") or EXEC_MODEL[old["kind"]]) if planned else None
    exec_effort = (old.get("exec_effort") or EXEC_EFFORT) if planned else None
    with editing_run(run_id) as run:
        run["agents"][name] = {
            "role": "worker", "kind": old["kind"], "model": model, "effort": effort, "base": base_sha,
            "size": old.get("size"), "view": view, "reviews": list(old.get("reviews") or []),
            "review_heads": dict(old.get("review_heads") or {}), "read_only": read_only, "planning": planning,
            "repo": str(repo_top), "cwd": cwd, "branch": branch, "session": session, "pane": None, "tab": None,
            "workspace": None, "parent": me, "status": "starting", "spawned": now_iso(),
            "resumed_from": {"run": old_run["id"], "name": old_name}, "log": log,
            "phase": "plan" if planned else None, "exec_model": exec_model, "exec_effort": exec_effort,
            "pinned": bool(args.model or args.effort) or (not planned and bool(old.get("pinned"))),
            "models": [{"model": model, "effort": effort, "at": now_iso(), "why": "resume"}],
            **({"peer": peer_name} if peer else {}),
            **({"collect": args.collect} if getattr(args, "collect", None) else {}),
        }
    result = {"name": name, "view": view, "cwd": cwd, "branch": branch, "model": model,
              "resumed_from": {"run": old_run["id"], "name": old_name}, "worktree_recreated": recreated,
              "compaction": compaction, "notes": notes, **({"left_pr": moved["pr"]} if moved.get("pr") else {})}

    if view == "bg":
        # A copy of the conversation, so it gets this run's identity (see launch_bg); the task waits in its mailbox.
        path = record(run_id, me, name, "task", task) if task else None
        prompt = doorbell_text(load_run(run_id), me, name, "task", task or "", first=True)
        try:
            bg_id, new_session = launch_bg(name, cwd, model, effort, env, prompt, resume=session, extra=deny)
        except MeshError as exc:  # as in spawn_worker: the conversation reopens in a pane instead
            notes.append(f"{exc}; reopening in a pane instead")
        else:
            with editing_run(run_id) as run:
                run["agents"][name].update(bg_id=bg_id, session=new_session, sessions=[session], status="running")
            log_event(run_id, "resume", name=name, kind=old["kind"], model=model, view="bg", bg_id=bg_id, parent=me,
                      from_run=old_run["id"], from_name=old_name, session=new_session)
            result.update(bg_id=bg_id, session=new_session)
            if path:
                result["delivery"] = {"stored": str(path), "rung": False, "error": None, "launched": True}
            return result
    else:
        path = None

    pane, tab, workspace_id, _ = place_pane(run_id, name, repo_top, Path(cwd), env)
    with editing_run(run_id) as run:
        run["agents"][name].update(view="pane", pane=pane, tab=tab, workspace=workspace_id)
    result["view"] = "pane"
    log_event(run_id, "resume", name=name, kind=old["kind"], model=model, pane=pane, parent=me,
              from_run=old_run["id"], from_name=old_name, session=session)

    started = start_agent(name, old["kind"], pane, [*log_argv(log), *deny, *resume_argv(old["kind"], session, model, effort),
                                                    "--dangerously-skip-permissions", *settings_argv(old["kind"], env)],
                          peer=bool(peer))
    with editing_run(run_id) as run:
        run["agents"][name]["status"] = "running"

    result.update(pane=pane, workspace=workspace_id, session=session)
    if started.get("held"):  # as in spawn_worker
        result["delivery"] = hold(run_id, me, name, "task", task, started, stored=path)
    elif path:  # stored before a background launch that fell back to this pane
        token = ring_token()
        rang = ring_stored(run_id, me, name, [name, pane],
                           doorbell_text(load_run(run_id), me, name, "task", task, True, token), token, path)
        result["delivery"] = {"stored": str(path), "rung": rang["rung"], "error": rang["error"], "via": rang["via"]}
    elif task:
        result["delivery"] = deliver(run_id, me, name, "task", task, first=True)
    return result


def cmd_open(args: argparse.Namespace) -> int:
    """Reopen a past worker's conversation in this terminal, outside any run, for the user.

    A background worker that is still running is attached to instead (`claude attach`): that is how the
    user watches one, or types into it, from any herdr pane.
    """
    _, _, name, entry = find_worker(args.ref, args.from_run)
    holder = live_holder(name, entry, agents=[]) if entry.get("view") == "bg" else None
    if holder and holder.get("bg_id"):
        print(f"mesh: attaching to {name}, a background session ({holder['bg_id']}); detaching leaves it running",
              file=sys.stderr)
        os.execvp(claude_bin(), [claude_bin(), "attach", holder["bg_id"]])

    def live_hint(name, entry):
        try:
            holder = live_holder(name, entry)
        except MeshError:
            return None  # outside herdr: nothing to check against
        if holder:
            holder["hint"] = f"go there with `herdr agent focus {holder.get('name') or holder.get('pane_id')}`"
        return holder

    run, name, entry, session = resumable(args.ref, args.from_run, live_hint)
    model, effort = resumed_model(entry, args.model, args.effort)
    branch = entry_branch(run, entry)
    recreated = ensure_worktree(entry, branch)
    extra = args.extra[1:] if args.extra[:1] == ["--"] else args.extra
    argv = [entry["kind"], *resume_argv(entry["kind"], session, model, effort), *extra]
    note = f"; the worktree was recreated, remove it with `git worktree remove {entry['cwd']}` when done" if recreated else ""
    print(f"mesh: opening {name} from run {run['id']} ({entry['kind']} {model}) in {entry['cwd']}"
          f" on {branch or 'its checkout'}{note}", file=sys.stderr)
    env = {k: v for k, v in os.environ.items() if not k.startswith("MESH_")}
    os.chdir(entry["cwd"])
    os.execvpe(argv[0], argv, env)
    return 0  # not reached


# ── questions and reviews ────────────────────────────────────────────────


def pr_ref(review: str, repo: Path) -> tuple[str, int]:
    """A PR's link and number, from a link or from a number and the repo's GitHub remote."""
    match = PR_RE.search(review)
    if match:
        return match.group(0), int(match.group(0).rsplit("/", 1)[1])
    if not review.lstrip("#").isdigit():
        raise MeshError(f"--review takes a PR link or number, not {review}")
    try:
        remote = git("remote", "get-url", "origin", cwd=repo)
    except MeshError:
        remote = "none"
    github = GITHUB_REMOTE_RE.search(remote)
    if not github:
        raise MeshError(f"{repo}'s origin ({remote}) is not on GitHub; pass the PR link")
    number = int(review.lstrip("#"))
    return f"https://github.com/{github.group(1)}/{github.group(2)}/pull/{number}", number


def pr_head(repo: Path, pr: str, number: int) -> str:
    """Fetch a PR's head commit from the remote it belongs to (`upstream` in a fork), refusing another repo's PR."""
    github_remotes = {}
    for remote in git("remote", cwd=repo).split():
        github = GITHUB_REMOTE_RE.search(git("remote", "get-url", remote, cwd=repo))
        if github:
            github_remotes[remote] = f"github.com/{github.group(1)}/{github.group(2)}/pull/".lower()
    remote = next((r for r, prefix in github_remotes.items() if prefix in pr.lower()), None)
    if not remote:
        if github_remotes:
            raise MeshError(f"{pr} is not a PR of {repo.name} (remotes: {', '.join(github_remotes)}); "
                            f"pass that PR's repo")
        remote = "origin"  # not on GitHub (a mirror, say): trust that it serves pull/<n>/head
    git("fetch", "-q", remote, f"pull/{number}/head", cwd=repo)
    return git("rev-parse", "FETCH_HEAD", cwd=repo)


ASK_SLUG_SKIP = {"a", "an", "and", "are", "can", "do", "does", "for", "how", "in", "is", "it", "of", "on", "the",
                 "to", "we", "what", "when", "where", "which", "who", "why", "with"}


def free_slug(run_id: str, repo_top: Path, slug: str) -> str:
    """`slug`, or `slug-2`, `-3`… when its run branch already exists (a retired asker keeps its branch), or
    another ask of this run has claimed it but not yet made the branch.

    A named one (`--name`) too, since `/delegate-review` always passes one. Picked and claimed under the run
    lock, so two asks of one kind for one PR started at the same moment get different slugs, and with them
    different agent names.
    """
    def taken(candidate: str, claimed: list[str]) -> bool:
        if candidate in claimed:
            return True
        try:
            git("rev-parse", "--verify", "--quiet", f"refs/heads/mesh/{run_id}/{candidate}", cwd=repo_top)
            return True
        except MeshError:
            return False
    slug = slugify(slug, 24)
    with editing_run(run_id) as run:
        claimed = run.setdefault("slugs", {}).setdefault(str(repo_top), [])
        found, n = slug, 2
        while taken(found, claimed):  # cut to fit `-N` in an agent name's suffix, so the name differs too
            found, n = f"{slug[:19 - len(str(n))].rstrip('-')}-{n}", n + 1
        claimed.append(found)
    return found


def ask_slug(body: str) -> str:
    """`ask-` plus the question's first telling words, within an agent name's 20-character suffix."""
    slug = "ask"
    for word in re.findall(r"[a-z0-9]+", body.lower()):
        if word in ASK_SLUG_SKIP:
            continue
        if len(slug) + 1 + len(word) > 20:
            break
        slug += f"-{word}"
    return slug


def pr_diff(pr: str) -> str:
    """The PR's diff for a review task, so the reviewer starts from the whole change; a note when it doesn't fit."""
    result = run_cli(["gh", "pr", "diff", pr], timeout=60)
    if result.returncode or not result.stdout.strip():
        return ""
    if len(result.stdout) > REVIEW_DIFF_MAX:
        return f"The diff is too long to include here ({len(result.stdout):,} characters): read it with `gh pr diff {pr}`."
    return f"The change (`gh pr diff {pr}`):\n\n````diff\n{result.stdout.rstrip()}\n````"


def ask_task(body: str, pr: str | None, number: int | None, fresh: bool, head: str | None = None,
             last: str | None = None, kind: str | None = None, narrow: bool = True) -> str:
    """The read-only task; a review names the head it is of, and `last`, the head this reviewer read before
    (`narrow`: the commits since are only fixes, see `fix_commits`). A Claude reviewer with the head is also asked
    to run `/code-review`."""
    skill = ""
    if pr:
        own = REVIEW_OWN_AT if head else REVIEW_OWN
        where = (REVIEW_FRESH if fresh else own).format(pr=pr, n=number, head=head)
        again = bool(last and head and last != head)
        if again:
            where += " " + (REVIEW_AGAIN if narrow else REVIEW_AGAIN_WHOLE).format(last=last, head=head)
        task = REVIEW_PREFIX.format(pr=pr, at=f" at {head}" if head else "", where=where)
        if kind == "claude" and head:
            skill = CODE_REVIEW.format(target=f"{last}..{head}" if again and narrow else number)
            skill += (CODE_REVIEW_AGAIN if again and narrow else "")
            skill += "" if fresh else CODE_REVIEW_OWN.format(head=head)
    else:
        task = ASK_PREFIX
    diff = pr_diff(pr) if pr else ""
    return task + "".join(f"\n\n{part}" for part in (skill, body, diff) if part)


def fix_commits(repo: Path, last: str, head: str) -> bool:
    """Whether `last..head` holds only commits on top of what was reviewed: `last` is an ancestor of `head` and
    no merge came in between (a merged base would bring its changes along). False when git can't tell."""
    try:
        git("merge-base", "--is-ancestor", last, head, cwd=repo)
        return not git("rev-list", "--merges", f"{last}..{head}", cwd=repo)
    except (MeshError, OSError):
        return False


def record_review(run_id: str, name: str, pr: str, head: str | None) -> None:
    """The PR in `reviews`, so `mesh resume <pr>` still finds the author, not the reviewer, and the head it
    read in `review_heads`, so asking it again names what changed since."""
    with editing_run(run_id) as run:
        entry = run["agents"][name]
        reviews = entry.setdefault("reviews", [])
        if pr not in reviews:
            reviews.append(pr)
        if head:
            entry.setdefault("review_heads", {})[pr] = head


def take_reply(run_id: str, me: str, sender: str) -> tuple[dict, str] | None:
    """The last done/failed `sender` sent me, marked read. Found through the log, since the doorbell
    it rang may already have had me read it with `mesh inbox`."""
    sends = [e for e in read_log(run_id) if e.get("event") == "send" and e.get("sender") == sender
             and e.get("to") == me and e.get("type") in FINAL_TYPES]
    if not sends:
        return None
    folder = inbox_dir(run_id, me)
    path = next((p for p in (folder / sends[-1]["file"], folder / "read" / sends[-1]["file"]) if p.exists()), None)
    if not path:
        return None
    meta, body = parse_message(path)
    if path.parent == folder:
        mark_read(path)
    return meta, body.strip()


def copilot_model_argv(model: str, effort: str) -> list[str]:
    # Auto picks the model per prompt and refuses an effort; it takes a routing profile instead.
    return ["--model", model, *(["--auto-tier", COPILOT_TIER] if model == "auto" else ["--reasoning-effort", effort])]


def copilot_answer(stdout: str) -> tuple[str, str | None]:
    """The last thing Copilot said and the model it said it on, from its `--output-format json` lines."""
    text, model = "", None
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(event, dict):
            continue
        data = event.get("data")
        if event.get("type") == "assistant.message" and isinstance(data, dict) and (data.get("content") or "").strip():
            text, model = data["content"].strip(), data.get("model") or model
    return text, model


@contextmanager
def signals_raise(*signums: int):
    """Turn these signals into SystemExit while inside, so `finally` and `except` clauses (run_cli's
    kill) run as they do on Ctrl-C; the previous handlers come back after. Outside the main thread, a no-op."""
    def interrupted(signum, frame):
        raise SystemExit(128 + signum)
    try:
        previous = {signum: signal.signal(signum, interrupted) for signum in signums}
    except ValueError:  # not the main thread
        previous = {}
    try:
        yield
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)


def copilot_ask(run_id: str, me: str, name: str, task: str, timeout: float) -> None:
    """Put one read-only task to a Copilot asker, headless, and file its answer as its `done` (or `failed`).

    The caller has marked the entry `running` with this process's pid (`claim_copilot`), and copilot's own
    pid joins it while it runs, in a session of its own: a killed `mesh ask` leaves it answering, and
    live_holder then still finds it busy. Every task goes
    under the session id recorded at spawn, which starts the session the first time and
    resumes it after, so the asker keeps what it read. The prompt goes on stdin: a review's diff can be
    larger than one command-line argument may be.
    """
    entry = agent_entry(load_run(run_id), name)
    mark_read(record(run_id, me, name, "task", task))  # kept as the record; it reaches Copilot as the prompt
    argv = ["copilot", "--output-format", "json", "--allow-all-tools", "--deny-tool", *COPILOT_DENY, "--no-ask-user",
            "--session-id", entry["session"], *copilot_model_argv(entry["requested_model"], entry["effort"])]
    log_event(run_id, "copilot", name=name)

    def started(pid: int) -> None:
        with editing_run(run_id) as run:
            run["agents"][name].update(copilot_pid=pid, copilot_pid_start=proc_start(pid))

    # No mesh identity: it answers through its output, never with `mesh send`.
    with signals_raise(signal.SIGTERM, signal.SIGHUP):  # so a killed or hung-up `mesh ask` takes copilot with it
        result = run_cli(argv, cwd=entry["cwd"], env=env_without_identity(keep_herdr=False),
                         timeout=timeout or None, input=f"{task}\n\n{COPILOT_NOTE}", started=started)
    text, model = copilot_answer(result.stdout)
    answered = bool(text) and result.returncode == 0
    # The answer is filed while the entry still counts as working, so a `mesh watch` on it sees the report.
    if answered:
        record(run_id, name, me, "done", text)
    elif result.returncode == 0:
        record(run_id, name, me, "failed", "copilot gave no answer (exit 0)")
    else:
        error = result.stderr.strip().splitlines()[-1:] or [f"exit {result.returncode}"]
        record(run_id, name, me, "failed", f"copilot exited {result.returncode}: {error[0]}")
    with editing_run(run_id) as run:
        agent = run["agents"][name]
        agent["status"] = "retired"
        for key in PROCESS_KEYS:
            agent.pop(key, None)
        if answered:
            agent["model"] = model or agent["model"]


def refuse_busy(name: str, entry: dict) -> None:
    holder = live_holder(name, entry)
    if holder and holder.get("pid"):
        raise MeshError(f"{name} is still answering in {holder['answering']} {holder['pid']}; "
                        "ask it again once that finishes")


def claim_copilot(entry: dict) -> None:
    """Mark a Copilot asker busy for this `mesh ask` (see live_holder); copilot_ask releases it."""
    for key in PROCESS_KEYS:
        entry.pop(key, None)  # a copilot a killed `mesh ask` left is gone by now (refuse_busy)
    entry.update(status="running", pid=os.getpid(), pid_start=proc_start(os.getpid()))


def open_peek(run_id: str, name: str, cwd: Path) -> str | None:
    """A pane beside the root that follows a Copilot asker (`mesh peek --follow`), so the user sees it work.

    Only beside the root, where the user is looking; None when that tab is full or gone, or herdr refuses.
    """
    if stale := agent_entry(load_run(run_id), name).get("pane"):  # left by a `mesh ask` that was killed
        close_peek(run_id, name, stale)
    env = {key: os.environ[key] for key in ("MESH_HOME", "COPILOT_HOME") if os.environ.get(key)}
    try:
        beside = beside_root(run_id, name, cwd, env)
    except MeshError:
        return None
    if not beside:
        return None
    pane, tab, workspace = beside
    try:
        herdr("pane", "rename", pane, f"{name} (Copilot)")
        herdr("pane", "run", pane, shlex.join(["mesh", "peek", name, "--from-run", run_id, "--follow"]))
    except MeshError:
        close_peek(run_id, name, pane)
        return None
    with editing_run(run_id) as run:
        run["agents"][name].update(pane=pane, tab=tab, workspace=workspace)
    return pane


def close_peek(run_id: str, name: str, pane: str) -> None:
    try:
        herdr("pane", "close", pane)
    except MeshError:
        pass  # the user closed it already
    with editing_run(run_id) as run:
        run["agents"][name].update(pane=None, tab=None, workspace=None)


def ask_copilot(args: argparse.Namespace, run_id: str, me: str, repo: Path, target, task: str,
                pr: str | None, number: int | None, base: str | None, body: str, head: str | None = None) -> int:
    """`mesh ask` for Copilot: no pane and no doorbell, the answer is what `copilot` prints (copilot_ask)."""
    ignored = [flag for flag, on in (("--keep", args.keep), ("--no-wait", args.no_wait), ("--wait", args.wait),
                                     ("--view", args.view), ("--compact", args.compact != "auto"),
                                     ("--focus", args.focus)) if on]
    if ignored:
        print(f"mesh: {', '.join(ignored)} don't apply to a headless Copilot asker", file=sys.stderr)
    if target:
        old_run, _, old_name, old = target
        if old_run["id"] != run_id:
            refuse_busy(old_name, old)
        branch = entry_branch(old_run, old)
        ensure_worktree(old, branch)
        name = old_name
        with editing_run(run_id) as run:
            if old_run["id"] != run_id:
                # A Copilot asker from an earlier run comes back as this run's, as `mesh resume` brings a worker.
                taken, n = set(run["agents"]) | live_agent_names(), 2
                while name in taken:
                    name, n = f"{old_name[:29]}-{n}", n + 1
                run["agents"][name] = {**old, "parent": me, "resumed_from": {"run": old_run["id"], "name": old_name}}
                worktrees = run.setdefault("worktrees", [])
                if branch and not any(Path(w["path"]) == Path(old["cwd"]) for w in worktrees):
                    base_sha = {"base": old["base"]} if old.get("base") else {}
                    worktrees.append({"path": old["cwd"], "repo": old["repo"], "branch": branch, **base_sha})
            else:
                refuse_busy(name, run["agents"][name])  # checked and claimed under one lock (below)
            if args.model or args.effort:
                run["agents"][name].update(requested_model=args.model or old["requested_model"],
                                           effort=args.effort or old["effort"])
            claim_copilot(run["agents"][name])
        how = "asked"
    else:
        taken = set(load_run(run_id)["agents"]) | live_agent_names()
        slug = free_slug(run_id, repo, args.name or (f"review-{number}-copilot" if pr else ask_slug(body)))
        name = agent_name(repo.name, slug, taken)
        cwd, branch, base = add_worktree(run_id, repo, slugify(slug, 24), base)
        model = args.model or os.environ.get("MESH_COPILOT_MODEL") or COPILOT_MODEL
        size = args.size or "small"
        effort = args.effort or COPILOT_EFFORT[size]
        with editing_run(run_id) as run:
            run["agents"][name] = {
                "role": "worker", "kind": "copilot", "model": model, "requested_model": model, "effort": effort,
                "size": size, "view": "headless", "repo": str(repo), "cwd": str(cwd), "branch": branch,
                "base": base, "session": str(uuid.uuid4()), "pane": None, "tab": None, "workspace": None,
                "parent": me, "status": "starting", "spawned": now_iso(), "log": None, "phase": None,
                "models": [{"model": model, "effort": effort, "at": now_iso(), "why": "spawn"}],
            }
            claim_copilot(run["agents"][name])
        log_event(run_id, "spawn", name=name, kind="copilot", role="worker", model=model, view="headless", parent=me)
        how = "started"
    if pr:
        record_review(run_id, name, pr, head)
    peek = open_peek(run_id, name, Path(agent_entry(load_run(run_id), name)["cwd"]))
    follow = f"in pane {peek}" if peek else f"with `mesh peek {name} --follow`"
    print(f"mesh: {how} {name} (Copilot, headless); waiting for its answer (follow it {follow})", file=sys.stderr)
    try:
        copilot_ask(run_id, me, name, task, args.timeout)
    finally:
        if peek:
            close_peek(run_id, name, peek)
    meta, text = take_reply(run_id, me, name)
    print(f"── {meta.get('type')} from {name} ──\n{text}\n")
    print(f"(ask again: `mesh ask {name} --body …`, which resumes its Copilot session)")
    return 0 if meta.get("type") == "done" else 1


def copilot_events(entry: dict) -> Path:
    """The file Copilot writes every event of an asker's session to."""
    home = Path(os.environ.get("COPILOT_HOME") or Path.home() / ".copilot")
    return home / "session-state" / entry["session"] / "events.jsonl"


def peek_line(line: str) -> str | None:
    """One Copilot event as a line of `mesh peek`: a tool it started, or something it said."""
    try:
        event = json.loads(line)
    except json.JSONDecodeError:
        return None
    if not isinstance(event, dict) or not isinstance(event.get("data"), dict):
        return None
    data, at = event["data"], str(event.get("timestamp") or "")[11:19]
    if event.get("type") == "tool.execution_start":
        args = data.get("arguments") if isinstance(data.get("arguments"), dict) else {}
        what = next((args[k] for k in ("description", "command", "path", "pattern") if args.get(k)), "")
        return f"{at} {data.get('toolName')}: {first_line(str(what), 140)}"
    if event.get("type") == "assistant.message" and (data.get("content") or "").strip():
        return f"{at} says: {first_line(data['content'], 140)}"
    return None


def cmd_peek(args: argparse.Namespace) -> int:
    """Show what a Copilot asker is doing, from its session's events, since it has no pane to look at."""
    _, folder, name, entry = find_worker(args.ref, args.from_run)
    if entry.get("kind") != "copilot":
        look = f"`claude attach {entry['bg_id']}`" if entry.get("bg_id") else f"`herdr agent read {name}`"
        raise MeshError(f"{name} is a {entry.get('kind')} worker; look at it with {look}")
    path = copilot_events(entry)
    while args.follow and not path.exists() and agent_status(name, entry) == "working":
        time.sleep(1)  # Copilot writes the file once the session starts
        entry = json.loads((folder / "run.json").read_text())["agents"][name]
    if not path.exists():
        raise MeshError(f"{name} has no Copilot session yet ({path})")
    with path.open() as f:
        lines = [shown for shown in map(peek_line, f) if shown]
        offset = f.tell()
    for shown in lines[-args.lines:]:
        print(shown)
    if not args.follow:
        return 0
    pending = ""  # a line Copilot is still writing
    while True:
        with path.open() as f:
            f.seek(offset)
            pending += f.read()
            offset = f.tell()
        *complete, pending = pending.split("\n")
        for shown in map(peek_line, complete):
            if shown:
                print(shown, flush=True)
        entry = json.loads((folder / "run.json").read_text())["agents"][name]
        if agent_status(name, entry) != "working":
            print(f"({name} is not answering now: its answer is what `mesh ask` printed, or `mesh inbox`)")
            return 0
        time.sleep(1)


def ask_identity(args: argparse.Namespace, body: str, mode: str | None) -> tuple[str, str]:
    """The asking root, with a run started for it when there is none (`mode` None: the root's own)."""
    try:
        run_id, me = identity(args)
    except MeshError as err:
        if getattr(args, "run", None) or isinstance(err, PaneRefused):
            raise
        started = init_run(mode, (body.splitlines() or ["a question"])[0][:200])
        run_id, me = started["run"], started["name"]
        print(f"mesh: started run {run_id}", file=sys.stderr)
    if agent_entry(load_run(run_id), me)["role"] != "root":
        raise MeshError("only the root asks: a worker sends its parent a `question` instead")
    return run_id, me


def reach_worker(args: argparse.Namespace, run_id: str, me: str, target: tuple, task: str, gist: str,
                 peer: str | None = None, collect: dict | None = None) -> tuple[dict, int, str]:
    """Give a worker `ask` found its read-only task: send it to a live one, else resume it. (result, its count of
    final sends before the task, how: "asked" or "resumed")."""
    old_run, _, name, entry = target
    state = (agent_status(name, entry) if old_run["id"] == run_id and entry.get("status") != "retired"
             else "gone")
    if state != "gone":
        finals = sends_from(run_id, name, FINAL_TYPES)
        if state == "working" and not args.no_wait:
            # Its next `done` would be for the task it's on, not this question.
            print(f"mesh: {name} is busy, so its answer will come after its current task", file=sys.stderr)
            args.no_wait = True
        if not collect and collecting(entry, me):
            raise MeshError(f"{name} is answering a `mesh ask --peers` (process {entry['collect']['pid']}), which "
                            "collects its answer: ask it again once that has finished")
        with editing_run(run_id) as run:  # a single ask clears a stale mark, so its answer rings as usual
            if collect:
                run["agents"][name]["collect"] = collect
            else:
                run["agents"][name].pop("collect", None)
        return {"name": name, "delivery": deliver(run_id, me, name, "task", task)}, finals, "asked"
    # Counted before the task goes out, so a quick answer still counts (a same-run resume keeps the name).
    finals = sends_from(run_id, name, FINAL_TYPES) if old_run["id"] == run_id else 0
    # A peer compacts with PEER_FOCUS (maybe_compact) unless the root named a focus.
    focus = args.focus or (None if peer else COMPACT_FOCUS.format(task=gist))
    resume = argparse.Namespace(ref=name, from_run=old_run["id"], model=args.model, effort=args.effort,
                                task=task, task_file=None, view=args.view, compact=args.compact,
                                focus=focus, read_only=True, peer=peer, collect=collect)
    result = resume_worker(resume, run_id, me)
    return result, finals if result["name"] == name else 0, "resumed"


def spawn_peer(args: argparse.Namespace, run_id: str, me: str, name: str, peer: dict, task: str,
               collect: dict | None = None) -> dict:
    """A peer's first asker: a fresh worker in the peer's own worktree, under the peer's name."""
    spawn = argparse.Namespace(
        kind=peer.get("kind") or "claude", role="worker", repo=peer["repo"], model=args.model, exec_model=None,
        effort=args.effort, exec_effort=None, name=None, agent=name, worktree=None, cwd=peer["cwd"], base=None,
        parent=None, task=task, task_file=None, size=args.size, view=args.view, plan_review=None,
        pinned=bool((args.model and args.model != "auto") or args.effort), peer=name, collect=collect)
    return spawn_worker(spawn, run_id, me)


def cmd_ask(args: argparse.Namespace) -> int:
    """Ask a worker, or a fresh agent in a repo, a question or for a PR review, and wait for the answer."""
    if getattr(args, "peers", None):
        return ask_peers(args)
    if bool(args.ref) == bool(args.repo):
        raise MeshError("ask whom? pass a worker (name, branch or PR link, see `mesh agents`), --repo for a fresh "
                        "agent, or --peers for the peer askers")
    if args.kind and args.ref:
        raise MeshError("--kind is for a fresh agent (--repo); a worker keeps its own CLI")
    copilot = args.kind == "copilot"
    body = (read_body(args.body, args.file) or "").strip()
    if not body and not args.review:
        raise MeshError("empty question: pass --body TEXT or --file PATH (- for stdin), or --review PR")

    # Resolve everything that can fail before anything is started.
    target = peer = prep = None
    if args.repo:
        repo = Path(git("rev-parse", "--show-toplevel", cwd=Path(args.repo).expanduser())).resolve()
    elif args.ref in load_peers()["peers"]:
        peer = load_peers()["peers"][args.ref]
        if args.review:
            raise MeshError(f"{args.ref} is a peer asker, which answers questions about its project; a review goes "
                            "to a reviewer (`mesh ask --repo <path> --review <PR>`)")
        target, repo = peer_worker(args.ref, peer), Path(peer["repo"])
    else:
        target = find_worker(args.ref)
        repo = Path(target[3]["repo"]) if target[3].get("repo") else Path.cwd()
        copilot = target[3].get("kind") == "copilot"
    pr, number = pr_ref(args.review, repo) if args.review else (None, None)
    head = last = None
    if pr and args.repo:
        head = pr_head(repo, pr, number)  # what the fresh reviewer's worktree starts at
    elif pr:
        try:  # into the shared object store, so the worker can read it; a review without it still goes out
            head = pr_head(repo, pr, number) if target[3].get("repo") else None
        except (MeshError, OSError):
            pass
        last = (target[3].get("review_heads") or {}).get(pr)
    gist = first_line(body) or f"a review of {pr}"
    # a Copilot asker's run is in the root's own mode
    run_id, me = ask_identity(args, body or f"review {pr}", None if copilot else args.kind or "agy")
    if peer:  # only once the caller is known to be a root: it fetches and moves the peer's checkout
        prep = prepare_peer(args.ref, peer, refresh=not args.no_refresh)
        body = f"{body}\n\n{prep['note']}"
    # A worker keeps its CLI; a fresh agent is of --kind, else the run's mode.
    kind = "copilot" if copilot else ((target[3].get("kind") if target else None) or args.kind
                                      or load_run(run_id)["mode"])
    narrow = not (last and head and last != head) or fix_commits(repo, last, head)
    task = ask_task(body, pr, number, fresh=bool(args.repo), head=head, last=last, kind=kind, narrow=narrow)
    base = head if args.repo else None
    if copilot:
        return ask_copilot(args, run_id, me, repo, target, task, pr, number, base, body, head)

    if args.repo:
        slug = free_slug(run_id, repo, args.name or (f"review-{number}-{kind}" if pr else ask_slug(body)))
        # A large reviewer already plans at DEFAULT_EFFORT; passing REVIEW_EFFORT there would read as a named
        # effort and carry into the execution phase of a fix it is later given.
        sized = (kind, args.size or "large") in SIZE_DEFAULTS
        spawn = argparse.Namespace(
            kind=kind, role="worker", repo=str(repo), model=args.model,
            exec_model=None, effort=args.effort or (REVIEW_EFFORT if pr and sized else None), exec_effort=None,
            name=args.name and slug, worktree=slug,  # a taken --name gets the same -2 as its branch
            cwd=None, base=base, parent=None, task=task, task_file=None, size=args.size,
            view=args.view or ("pane" if pr else None), plan_review=None,  # the user watches a review
            pinned=bool((args.model and args.model != "auto") or args.effort))
        result, finals, how = spawn_worker(spawn, run_id, me), 0, "started"
    elif peer and not target:
        result, finals, how = spawn_peer(args, run_id, me, args.ref, peer, task), 0, "started"
    else:
        result, finals, how = reach_worker(args, run_id, me, target, task, gist, peer=args.ref if peer else None)
    name = result["name"]
    if pr:
        record_review(run_id, name, pr, head)
    if peer:
        record_peer_ask(args.ref, prep, run_id, name)

    delivery = result.get("delivery") or {}
    if "send_message" in delivery:
        emit(result)
        warn_unwatched(run_id)
        print(f"mesh: stored; now send it to {name} with SendMessage (`to` and `message` as in send_message). "
              "Its answer comes back the same way.", file=sys.stderr)
        return 0
    if delivery.get("held"):  # only the user can clear it: say so now rather than wait silently
        emit(result)
        status = report_held(name, delivery)
        print(f"mesh: `mesh watch {name}` rings it once the screen is gone, and waits for its answer", file=sys.stderr)
        return status
    if not delivered(delivery):
        emit(result)
        print(f"warning: stored, but the doorbell did not ring ({delivery.get('error')}); "
              f"retry with `mesh ring {name}`, then `mesh watch {name}`", file=sys.stderr)
        return 2
    entry = agent_entry(load_run(run_id), name)
    if (not args.wait and entry.get("kind") == "claude"
            and native_route(load_run(run_id), name, me)):  # the answer comes as a SendMessage from the worker
        args.no_wait = True
    warn_unwatched(run_id, skip=() if args.no_wait else (name,))  # without --no-wait this call watches it
    if args.no_wait:
        emit(result)
        return 0
    print(f"mesh: {how} {name}; waiting for its answer", file=sys.stderr)
    status, line = watch_agent(run_id, name, args.timeout, finals_at_start=finals)
    reply = take_reply(run_id, me, name) if status == 0 else None
    if not reply:
        print(line)
        return status
    meta, text = reply
    print(f"── {meta.get('type')} from {name} ──\n{text}\n")
    if how != "asked" and not args.keep:  # an asker this call opened is done; one already at work stays
        retire_worker(run_id, name, agent_entry(load_run(run_id), name))
        print(f"({name} is closed. Ask again with `mesh ask {name} --body …`, which reopens its conversation; "
              f"give it a change with `mesh resume {name} --task-file …`)")
    else:
        print(f"(ask again: `mesh ask {name} --body …`; give it a change to make: `mesh send {name} --type task`)")
    return 0


def watch_each(run_id: str, finals: dict[str, int], timeout: float = 0, interval: float = 5.0,
               grace: float = SETTLE_GRACE, on_outcome: Callable[[str, int, str], None] | None = None
               ) -> dict[str, tuple[int, str]]:
    """watch_agents for a fan-out: every name gets its own outcome, (0, …) for a done/failed or the watch's
    alert (3-8), and the rest are watched on. A plan or question it sends instead ends its watch too (3), as
    does the timeout (6). `finals` is each one's count of final sends before its task was delivered."""
    hang = hang_after()
    watches = {name: Watch(run_id, name, grace, count, hang) for name, count in finals.items()}
    outcomes: dict[str, tuple[int, str]] = {}
    deadline = time.monotonic() + timeout if timeout else None

    def decide(name: str, outcome: tuple[int, str]) -> None:
        outcomes[name] = outcome
        watches.pop(name)
        if on_outcome:
            on_outcome(name, *outcome)

    held = hold_watch(run_id, list(watches))
    try:
        while watches:
            run = load_run(run_id)
            bg_rows = claude_agents() if any(run["agents"].get(n, {}).get("view") == "bg" for n in watches) else None
            events = read_log(run_id)
            for name, watch in list(watches.items()):
                event = watch.tick(interval, False, bg_rows, events)
                report, _ = last_report(events, name)
                if not event and report and report.get("type") not in FINAL_TYPES:
                    event = 3, (f"ALERT {name} sent a {report['type']} instead of an answer: read it with "
                                f"`mesh inbox`, answer it with `mesh send {name} --type answer`")
                if not event and watch.finished:
                    event = 5, f"ALERT {name} was retired before it answered"
                if event:
                    decide(name, event)
            if watches and deadline and time.monotonic() > deadline:
                for name, watch in list(watches.items()):
                    decide(name, (6, f"ALERT {name} has not answered within {timeout}s ({watch.prev})"))
            if watches:
                time.sleep(interval)
    finally:
        for handle in held:
            handle.close()
    return outcomes


def ask_peers(args: argparse.Namespace) -> int:
    """`mesh ask --peers`: one question to several peer askers at once, each told what changed
    upstream, their answers collected into one file and a line each printed (design §14)."""
    if args.ref or args.repo or args.review or args.kind:
        raise MeshError("--peers asks the peer askers: drop the worker, --repo, --review and --kind")
    body = (read_body(args.body, args.file) or "").strip()
    if not body:
        raise MeshError("empty question: pass --body TEXT or --file PATH (- for stdin)")
    registry = load_peers()["peers"]
    names = select_peers(registry, args.peers)
    run_id, me = ask_identity(args, body, None)
    mark = collector(me)
    asked: dict[str, str] = {}  # peer → the name its asker has in this run
    try:
        with signals_raise(signal.SIGTERM, signal.SIGHUP):  # a killed fan-out still clears its marks
            return fan_out(args, run_id, me, body, registry, names, mark, asked)
    finally:
        for asker in asked.values():
            with editing_run(run_id) as run:  # their next report rings as usual
                run["agents"][asker].pop("collect", None)


def owes_answer(run_id: str, name: str, entry: dict) -> bool:
    """A worker of this run still on its last task: it got one and has reported nothing since (by the log,
    which a stale pane state can't fool), or it reads working."""
    if entry.get("status") == "retired":
        return False
    received, sent, _ = since_last_task(read_log(run_id), name)
    return bool(received and not sent) or agent_status(name, entry) == "working"


def fan_out(args: argparse.Namespace, run_id: str, me: str, body: str, registry: dict, names: list[str],
            mark: dict, asked: dict[str, str]) -> int:
    """ask_peers' work; `asked` is filled in as peers are reached, for its caller to clear their marks."""
    from concurrent.futures import ThreadPoolExecutor

    def prepare(name: str) -> dict:
        try:
            return prepare_peer(name, registry[name], refresh=not args.no_refresh)
        except MeshError as exc:
            return {"failed": str(exc)}

    def reach(name: str) -> tuple:
        prep, peer = preps[name], registry[name]
        try:
            task = ask_task(f"{body}\n\n{prep['note']}", None, None, fresh=False)
            target = peer_worker(name, peer)
            if target and target[0]["id"] == run_id and owes_answer(run_id, target[2], target[3]):
                # Its next `done` answers the question it's on: filing that as this one's would be wrong.
                return None, 0, "busy with its previous question; ask again once it answers"
            ask = argparse.Namespace(**{**vars(args), "no_wait": True})  # the fan-out watches them all
            if target:
                result, finals, how = reach_worker(ask, run_id, me, target, task, first_line(body), peer=name,
                                                   collect=mark)
            else:
                result, finals, how = spawn_peer(ask, run_id, me, name, peer, task, collect=mark), 0, "started"
        except MeshError as exc:
            return None, 0, str(exc)
        record_peer_ask(name, prep, run_id, result["name"])
        return result, finals, how

    def reached_one(name: str) -> tuple:
        result = reach(name)
        if result[0]:
            asked[name] = result[0]["name"]
        return result

    with ThreadPoolExecutor(max_workers=min(PEER_THREADS, len(names))) as pool:
        preps = dict(zip(names, pool.map(prepare, names)))
        ready = [n for n in names if "failed" not in preps[n]]
        reached = dict(zip(ready, pool.map(reached_one, ready)))

    outcomes: dict[str, tuple[int, str]] = {n: (1, f"{n}: {preps[n]['failed']}") for n in names if n not in ready}
    finals: dict[str, int] = {}
    for name, (result, count, how) in reached.items():
        if result is None:
            outcomes[name] = 1, f"{name}: not asked ({how})"
            continue
        finals[result["name"]] = count
        delivery = result.get("delivery") or {}
        if delivery.get("held"):  # only the user can clear it; the watch rings it once they have
            print(held_alert(result["name"], delivery), file=sys.stderr)
        elif not delivered(delivery):
            print(f"warning: {result['name']}'s question is stored, but its doorbell did not ring "
                  f"({delivery.get('error')}); `mesh ring {result['name']}` retries it", file=sys.stderr)
    opened = {asked[n] for n, (_, _, how) in reached.items() if n in asked and how != "asked"}
    warn_unwatched(run_id, skip=tuple(finals))
    if finals:
        print(f"mesh: asked {', '.join(finals)}; waiting for their answers", file=sys.stderr)
    by_asker = {v: k for k, v in asked.items()}
    watched = watch_each(run_id, finals, args.timeout,
                         on_outcome=lambda n, status, line: status and print(line.splitlines()[0], file=sys.stderr))
    for asker, outcome in watched.items():
        outcomes[by_asker[asker]] = outcome

    replies: dict[str, tuple[dict, str] | None] = {}
    for name in names:
        asker = asked.get(name)
        replies[name] = take_reply(run_id, me, asker) if asker and outcomes[name][0] == 0 else None
        if replies[name] and asker in opened and not args.keep:
            retire_worker(run_id, asker, agent_entry(load_run(run_id), asker))

    folder = run_dir(run_id) / "reports"
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"peers-{stamp()}.md"
    asked_groups = {registry[n].get("group") for n in names}
    group_about = ((load_peers().get("groups") or {}).get(next(iter(asked_groups))) or {}).get("about") \
        if len(asked_groups) == 1 else None
    parts = [f"# Peer answers: {first_line(body, 120)}", "",
             f"Asked {now_iso()} in run {run_id}, of {len(names)} peer{'s' if len(names) > 1 else ''}: "
             f"{', '.join(names)}.", *(["", f"{next(iter(asked_groups))}: {group_about}"] if group_about else []),
             "", "## Question", "", body, ""]
    lines = []
    for name in names:
        prep, reply = preps[name], replies[name]
        status, line = outcomes[name]
        where = f"{Path(registry[name]['repo']).name}"
        if prep.get("head"):
            where += f" at {prep['head'][:9]}" + (f", upstream +{prep['new']} since last asked" if prep.get("new") else "")
        about = registry[name].get("about")
        parts += [f"## {name}", "", f"*{where}*", *(["", f"*{about}*"] if about else []), ""]
        if reply:
            meta, text = reply
            parts += [text if meta.get("type") == "done" else f"**{meta.get('type')}:** {text}", ""]
            what = f"{meta.get('type')}, {len(text.split()):,} words"
        else:
            parts += [f"No answer: {line}", ""]
            what = line.splitlines()[0]
        lines.append(f"  {name:<28} {what}" + (f"  (upstream +{prep['new']})" if prep.get("new") else ""))
    write_atomic(path, "\n".join(parts))
    with editing_peers() as data:  # `mesh peers` names it, so it's found without remembering the run
        data["answers"] = str(path)
    answered = sum(1 for r in replies.values() if r)
    print(f"{answered} of {len(names)} peers answered: {first_line(body, 100)}")
    print("\n".join(lines))
    print(f"answers: {path}")
    if answered < len(names):
        print("(a peer that didn't answer is still open: follow it up as its line says, then `mesh retire` it)")
    failed = [outcomes[n][0] for n in names if not replies[n]]
    return failed[0] if failed else 0


# ── peers: standing askers ───────────────────────────────────────────────


def peers_path() -> Path:
    return mesh_home() / "peers.json"


def load_peers() -> dict:
    """The registry of standing peer askers (design §14): config that outlives runs, nothing a run records."""
    path = peers_path()
    data = json.loads(path.read_text()) if path.exists() else {}
    data.setdefault("peers", {})
    return data


@contextmanager
def editing_peers():
    with file_lock(mesh_home() / "locks" / "peers.lock"):
        data = load_peers()
        yield data
        write_atomic(peers_path(), json.dumps(data, indent=2) + "\n")


def peers_dir() -> Path:
    return Path(os.environ.get("MESH_PEERS_DIR") or Path.home() / "research").expanduser()


def peer_upstream(repo: Path) -> dict:
    """The remote and branch a clone follows: `origin` (else its first remote) and that remote's HEAD branch, else
    the branch checked out. No remote: the clone's own branch, which nothing moves."""
    remotes = git("remote", cwd=repo).split()
    remote = "origin" if "origin" in remotes else (remotes[0] if remotes else None)
    branch = None
    if remote:
        try:
            branch = git("symbolic-ref", "--short", f"refs/remotes/{remote}/HEAD", cwd=repo).split("/", 1)[1]
        except (MeshError, IndexError):
            pass
    branch = branch or git("branch", "--show-current", cwd=repo) or "main"
    url = git("remote", "get-url", remote, cwd=repo) if remote else None
    return {"remote": remote, "branch": branch, "url": url}


def upstream_ref(peer: dict) -> str:
    up = peer["upstream"]
    return f"refs/remotes/{up['remote']}/{up['branch']}" if up.get("remote") else f"refs/heads/{up['branch']}"


def upstream_head(peer: dict) -> str | None:
    """The upstream commit as of the last fetch, from local refs only."""
    try:
        return git("rev-parse", "--verify", "--quiet", f"{upstream_ref(peer)}^{{commit}}", cwd=peer["repo"])
    except MeshError:
        return None


def fetch_peer(peer: dict) -> str | None:
    """`git fetch` the clone's upstream; None, or why it failed (which never stops an ask)."""
    remote = peer["upstream"].get("remote")
    if not remote:
        return None
    result = run_cli(["git", "fetch", "--quiet", remote], cwd=peer["repo"], timeout=FETCH_TIMEOUT)
    if result.returncode:
        return (result.stderr.strip().splitlines() or [f"git fetch exited {result.returncode}"])[-1]
    return None


def commits_between(repo: str, old: str | None, new: str | None) -> int:
    if not old or not new or old == new:
        return 0
    try:
        return int(git("rev-list", "--count", f"{old}..{new}", cwd=repo))
    except (MeshError, ValueError):
        return 0


def ensure_peer_worktree(peer: dict) -> bool:
    """The asker's own worktree, detached (no branch to keep or delete), at the commit it last read. True if
    it had to be (re)created; its path never changes, since Claude keys the conversation by it."""
    cwd = Path(peer["cwd"])
    if cwd.exists() or peer.get("in_clone"):
        return False
    at = peer.get("seen") or upstream_head(peer) or git("rev-parse", "HEAD", cwd=peer["repo"])
    git("worktree", "prune", cwd=peer["repo"])
    cwd.parent.mkdir(parents=True, exist_ok=True)
    git("worktree", "add", "--detach", str(cwd), at, cwd=peer["repo"])
    return True


def prepare_peer(name: str, peer: dict, refresh: bool = True) -> dict:
    """Before a peer is asked: fetch its upstream, move its clean worktree to the new head, and write the note
    that tells it what changed since it last looked. Returns {note, head (what it reads), upstream, new, error}."""
    repo, seen = peer["repo"], peer.get("seen")
    error = fetch_peer(peer) if refresh else None
    ensure_peer_worktree(peer)
    cwd = peer["cwd"]
    head = upstream_head(peer) or seen
    at = git("rev-parse", "HEAD", cwd=cwd)
    seen = seen or at
    dirty = bool(git("status", "--porcelain", cwd=cwd))
    in_clone = bool(peer.get("in_clone"))  # it runs in the clone's own checkout, which mesh never moves
    if head and head != at and not dirty and not in_clone:
        git("checkout", "--quiet", "--detach", head, cwd=cwd)
        at = head
    up = peer["upstream"]
    where = f"{up['remote']}/{up['branch']}" if up.get("remote") else up["branch"]
    new = commits_between(repo, seen, head)
    lines = []
    if error:
        lines.append(f"Couldn't fetch {up.get('url') or where} ({error}), so this is upstream as of the last fetch.")
    if new:
        log = git("log", "--oneline", "--no-decorate", f"-{PEER_LOG_LINES}", f"{seen}..{head}", cwd=repo)
        more = f"\n… and {new - PEER_LOG_LINES} more" if new > PEER_LOG_LINES else ""
        stat = git("diff", "--shortstat", seen, head, cwd=repo)
        lines.append(f"Upstream moved since you last looked: {new} commit{'s' if new > 1 else ''} on {where}, "
                     f"{seen[:9]}..{head[:9]} ({stat or 'no file changes'}). Re-check what your answer relies on "
                     f"against them (`git log --stat {seen[:9]}..{head[:9]}`):\n\n```\n{log}{more}\n```")
    elif not error:
        lines.append(f"Upstream ({where}) hasn't changed since you last looked.")
    if at == head:
        lines.append(f"Your checkout is at {at[:9]}.")
    elif in_clone:
        lines.append(f"You run in the clone's own checkout, which stays at {at[:9]}; upstream is at "
                     f"{(head or '?')[:9]}: read the newer code with `git show {(head or '')[:9]}:<path>`.")
    else:
        lines.append(f"Your checkout has local changes, so it stays at {at[:9]}; upstream is at {(head or '?')[:9]}: "
                     f"read the newer code with `git show {(head or '')[:9]}:<path>`.")
    return {"note": "\n\n".join(lines), "head": at, "upstream": head, "new": new, "error": error}


def peer_of(name: str, entry: dict) -> dict | None:
    """The registry entry of the peer this worker is, if it is one (same name, same clone)."""
    peer = load_peers()["peers"].get(name)
    if peer and entry.get("repo") and Path(entry["repo"]).resolve() == Path(peer["repo"]).resolve():
        return peer
    return None


def peer_worker(name: str, peer: dict) -> tuple[dict, Path, str, dict] | None:
    """The peer's newest conversation: the entry its last ask left (`run`, `as`), else the newest worker by its
    name in its clone. None while it was never asked."""
    for ref, run_id in ((peer.get("as") or name, peer.get("run")), (name, None)):
        try:
            found = find_worker(ref, run_id)
        except MeshError:
            continue
        if found[3].get("repo") and Path(found[3]["repo"]).resolve() == Path(peer["repo"]).resolve():
            return found
    return None


def record_peer_ask(name: str, prep: dict, run_id: str, as_name: str) -> None:
    """What the asker has now been told: the upstream commit, and where its conversation lives on."""
    with editing_peers() as data:
        peer = data["peers"].get(name)
        if peer is not None:
            peer.update(seen=prep.get("upstream") or prep.get("head") or peer.get("seen"), run=run_id, asked=now_iso())
            peer["as"] = as_name


NO_PEERS = "no peers yet: add one with `mesh peers add <git-url | path>`"


def about_text(text: str | None) -> str:
    """A peer's or group's description, one paragraph, at most ABOUT_MAX characters."""
    text = " ".join((text or "").split())
    if len(text) > ABOUT_MAX:
        raise MeshError(f"--about is {len(text)} characters; keep it to {ABOUT_MAX}: what the project is, its shape in "
                        "a line, and what it's worth asking about")
    return text


def github_about(url: str | None) -> str | None:
    """The upstream's GitHub description, as a peer's default `about`; None off GitHub or when gh can't say."""
    github = GITHUB_REMOTE_RE.search(url or "")
    if not github:
        return None
    data, _ = gh_json(["repo", "view", f"{github.group(1)}/{github.group(2)}", "--json", "description"])
    text = " ".join(((data or {}).get("description") or "").split()) if isinstance(data, dict) else ""
    return text[:ABOUT_MAX] or None


def peer_groups(data: dict) -> set[str]:
    return {p.get("group") for p in data["peers"].values()} | set(data.get("groups") or {})


def select_peers(registry: dict, spec: str) -> list[str]:
    """`all`, or a comma list of peer names and groups, in registry order."""
    if not registry:
        raise MeshError(NO_PEERS)
    wanted = {part.strip() for part in spec.split(",") if part.strip()}
    if "all" in wanted:
        return list(registry)
    unknown = wanted - set(registry) - {p.get("group") for p in registry.values()}
    if unknown:
        raise MeshError(f"no peer or group named {', '.join(sorted(unknown))}; see `mesh peers`")
    return [n for n, p in registry.items() if n in wanted or p.get("group") in wanted]


def same_url(a: str | None, b: str) -> bool:
    """Whether two remote URLs name the same repo, ignoring a trailing `/` or `.git`."""
    def norm(url: str) -> str:  # git@github.com:o/r and https://github.com/o/r are the same repo
        github = GITHUB_REMOTE_RE.search(url.strip())
        return f"github:{github.group(1)}/{github.group(2)}".lower() if github else re.sub(r"(\.git)?/*$", "", url.strip())
    return bool(a) and norm(a) == norm(b)


def clone_target(url: str, group: str) -> Path:
    stem = re.sub(r"\.git$", "", url.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1]) or "repo"
    return peers_dir() / group / stem


def release_worktree(run_id: str, cwd: Path) -> None:
    """Take an adopted asker's worktree off its live run's `mesh stop` list. Its run branch goes too when
    untouched, as `mesh stop` would delete it: the peer's worktree is detached from now on."""
    with editing_run(run_id) as run:
        mine = [w for w in run.get("worktrees", []) if Path(w["path"]).resolve() == cwd.resolve()]
        run["worktrees"] = [w for w in run.get("worktrees", []) if w not in mine]
    for wt in mine:
        if wt.get("branch") and untouched_branch(wt) and cwd.exists():
            git("checkout", "--quiet", "--detach", cwd=cwd)
            git("branch", "-D", wt["branch"], cwd=wt["repo"])


def peers_add(args: argparse.Namespace) -> int:
    if len(args.targets) != 1:
        raise MeshError("add what? `mesh peers add <git-url | path>`")
    source, group = args.targets[0], args.group or "peers"
    path = Path(source).expanduser()
    if not path.exists():  # a URL: clone it, unless it was cloned there already
        path = clone_target(source, group)
        if path.exists():
            try:
                there = git("remote", "get-url", "origin", cwd=path)
            except MeshError:
                there = None
            if not same_url(there, source):
                raise MeshError(f"{path} is already a clone of {there or 'something else'}: add this one with "
                                "another --group, or clone it yourself and `mesh peers add <path>`")
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            result = run_cli(["git", "clone", "--quiet", source, str(path)], timeout=CLONE_TIMEOUT)
            if result.returncode:
                raise MeshError(f"git clone {source}: {result.stderr.strip()[-300:]}")
            print(f"mesh: cloned {source} into {path}", file=sys.stderr)
    repo = Path(git("rev-parse", "--show-toplevel", cwd=path)).resolve()
    name = args.name or agent_name(repo.name, "research", set())
    if not NAME_RE.match(name):
        raise MeshError(f"bad peer name {name!r} (lowercase letters, digits, - and _, at most 32)")
    if name in load_peers()["peers"]:
        raise MeshError(f"{name} is a peer already; see `mesh peers`")
    peer = {"repo": str(repo), "group": group, "upstream": peer_upstream(repo), "added": now_iso()}
    try:
        old_run, folder, _, entry = find_worker(name)
    except MeshError:
        entry = None
    adopted = bool(entry and entry.get("repo") and Path(entry["repo"]).resolve() == repo and entry.get("cwd"))
    live_run = adopted and folder.parent.name != "archive"
    if live_run and entry.get("status") != "retired":
        # prepare_peer would move its worktree under it, and its run would lose track of it
        raise MeshError(f"{name} is still open in run {old_run['id']}: `mesh retire {name}` there first, then add it")
    if adopted:  # its conversation is the valuable part: keep it, at the path Claude keys it by
        peer.update(kind=entry.get("kind"), cwd=entry["cwd"], seen=entry.get("base"))
        if Path(entry["cwd"]).resolve() == repo:  # it ran in the clone itself: never a worktree to move or remove
            peer["in_clone"] = True
        elif live_run:  # a live run's `mesh stop` would remove the worktree it now keeps
            release_worktree(old_run["id"], Path(entry["cwd"]))
    else:
        peer.update(kind=args.kind or "claude", cwd=str(worktree_root() / "peers" / name), seen=upstream_head(peer))
    if args.about:
        peer["about"] = about_text(args.about)
    else:
        about = github_about(peer["upstream"].get("url"))
        if about:  # a project's own pitch: `mesh peers edit` replaces it with what its asker found
            peer.update(about=about, about_from="github")
    ensure_peer_worktree(peer)
    peer["seen"] = peer.get("seen") or git("rev-parse", "HEAD", cwd=peer["cwd"])
    with editing_peers() as data:
        if name in data["peers"]:
            raise MeshError(f"{name} is a peer already; see `mesh peers`")
        data["peers"][name] = peer
    emit({"name": name, "adopted": adopted, **peer})
    if args.body or args.file:  # the first research brief
        argv = ["ask", name, "--size", args.size or "large", *(["--body", args.body] if args.body else []),
                *(["--file", args.file] if args.file else []), *(["--run", args.run] if args.run else []),
                *(["--as", args.as_] if args.as_ else [])]
        return cmd_ask(build_parser().parse_args(argv))
    if not adopted:
        print(f"mesh: give {name} its first research brief with `mesh ask {name} --size large --file brief.md`",
              file=sys.stderr)
    return 0


def peers_remove(args: argparse.Namespace) -> int:
    if not args.targets:
        raise MeshError("remove which peer? `mesh peers remove <name>`")
    for name in args.targets:
        peer = load_peers()["peers"].get(name)
        if not peer:
            raise MeshError(f"no peer named {name}; see `mesh peers`")
        cwd, kept = Path(peer["cwd"]), None
        if peer.get("in_clone"):
            kept = "it is the clone's own checkout"
        elif cwd.exists():
            if git("status", "--porcelain", cwd=cwd):
                kept = "it has local changes"
            else:
                git("worktree", "remove", str(cwd), cwd=peer["repo"])
        with editing_peers() as data:
            data["peers"].pop(name, None)
        print(f"{name}: removed; its clone stays at {peer['repo']}"
              + (f", and its checkout at {cwd} ({kept})" if kept else "")
              + f". Its conversation is still there: `mesh ask {name}` finds it as a past worker.")
    return 0


def peers_edit(args: argparse.Namespace) -> int:
    """`mesh peers edit <peer|group> [--about] [--group]`: a peer's description or group, or a group's description."""
    if len(args.targets) != 1:
        raise MeshError("edit what? `mesh peers edit <peer | group> --about TEXT`")
    target = args.targets[0]
    if args.about is None and not args.group:
        raise MeshError("nothing to change: pass --about TEXT, or --group G for a peer")
    with editing_peers() as data:
        is_peer, is_group = target in data["peers"], target in peer_groups(data)
        if is_peer and is_group:
            raise MeshError(f"{target} is both a peer and a group; rename one with `mesh peers edit <peer> --group`")
        if is_peer:
            peer = data["peers"][target]
            if args.about is not None:
                peer["about"] = about_text(args.about)
                peer.pop("about_from", None)
            if args.group:
                peer["group"] = args.group
            changed = {k: peer.get(k) for k in ("group", "about")}
        elif is_group:
            if args.group:
                raise MeshError(f"{target} is a group: --group moves a peer, not a group")
            data.setdefault("groups", {}).setdefault(target, {})["about"] = about_text(args.about)
            changed = {"about": data["groups"][target]["about"]}
        else:
            raise MeshError(f"no peer or group named {target}; see `mesh peers`")
    emit({"name": target, "kind": "peer" if is_peer else "group", **changed})
    return 0


def peers_refresh(args: argparse.Namespace) -> int:
    registry = load_peers()["peers"]
    names = select_peers(registry, ",".join(args.targets) or "all")
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=min(PEER_THREADS, len(names))) as pool:
        errors = dict(zip(names, pool.map(lambda n: fetch_peer(registry[n]), names)))
    for name in names:
        peer = registry[name]
        head, seen = upstream_head(peer), peer.get("seen")
        new = commits_between(peer["repo"], seen, head)
        what = (f"fetch failed ({errors[name]})" if errors[name]
                else f"+{new} commit{'s' if new != 1 else ''} since it last looked ({(seen or '?')[:9]}..{(head or '?')[:9]})"
                if new else "unchanged")
        print(f"{name}: {what}")
    return 0


def peer_row(name: str, peer: dict) -> dict:
    """One `mesh peers` row: the registry entry, with what its conversation and upstream say now."""
    found = peer_worker(name, peer)
    session = find_session(found[0]["id"], found[2], found[3]) if found else None
    tokens = context_tokens(found[3], session) if session else None
    head, up = upstream_head(peer), peer["upstream"]
    return {
        "name": name, "group": peer.get("group") or "", "kind": peer.get("kind") or "",
        "upstream": f"{up['remote']}/{up['branch']}" if up.get("remote") else up["branch"],
        "seen": (peer.get("seen") or "")[:9], "new": commits_between(peer["repo"], peer.get("seen"), head),
        "context": f"{tokens // 1000}k" if tokens else "", "session": "found" if session else "none yet",
        "worktree": "present" if Path(peer["cwd"]).exists() else "removed", "asked": (peer.get("asked") or "")[:16],
        "about": peer.get("about") or "", "repo": peer["repo"], "cwd": peer["cwd"],
    }


def peers_list(args: argparse.Namespace) -> int:
    data = load_peers()
    rows = []
    for name, peer in data["peers"].items():
        try:
            rows.append(peer_row(name, peer))
        except (MeshError, OSError, KeyError, TypeError, AttributeError) as exc:  # a hand-edited or torn entry
            rows.append({"name": name, "group": peer.get("group") or "", "kind": peer.get("kind") or "",
                         "upstream": "", "seen": "", "new": "", "context": "", "session": "",
                         "worktree": f"broken ({type(exc).__name__}: {exc})"[:60], "asked": "",
                         "about": peer.get("about") or "", "repo": peer.get("repo"), "cwd": peer.get("cwd")})
    groups = data.get("groups") or {}
    if args.json:
        emit({"peers": rows, "groups": groups, "answers": data.get("answers")})
        return 0
    if not rows:
        print(f"{NO_PEERS[0].upper()}{NO_PEERS[1:]}.")
        return 0
    for n, group in enumerate(dict.fromkeys(r["group"] for r in rows)):
        about = (groups.get(group) or {}).get("about")
        print(("\n" if n else "") + f"{group or '(no group)'}" + (f": {about}" if about else ""))
        mine = [r for r in rows if r["group"] == group]
        print_table(mine, ("name", "kind", "upstream", "seen", "new", "context", "session", "worktree", "asked"))
        described = [r for r in mine if r["about"]]
        if described:
            print("\nAbout:")
            for row in described:
                print(textwrap.fill(row["about"], 116, initial_indent=f"  {row['name']}: ", subsequent_indent="    "))
    if data.get("answers"):
        print(f"\nnewest answers: {data['answers']}")
    return 0


def cmd_peers(args: argparse.Namespace) -> int:
    return {"list": peers_list, "add": peers_add, "edit": peers_edit, "remove": peers_remove,
            "refresh": peers_refresh}[args.action](args)


def cmd_worktree(args: argparse.Namespace) -> int:
    run_id, _ = identity(args)
    repo_top = Path(git("rev-parse", "--show-toplevel", cwd=Path(args.repo).expanduser())).resolve()
    path, branch, _ = add_worktree(run_id, repo_top, slugify(args.slug, 24), args.base)
    emit({"path": str(path), "branch": branch})
    return 0


def untouched_branch(wt: dict) -> bool:
    """A run branch still at the commit it started from and never pushed: deleting it loses nothing,
    and `ensure_worktree` can start it again from that base."""
    if not wt.get("base"):
        return False  # runs before 0.6 recorded no base
    try:
        if git("rev-parse", f"refs/heads/{wt['branch']}", cwd=wt["repo"]) != wt["base"]:
            return False
    except MeshError:
        return False
    try:
        git("rev-parse", "--abbrev-ref", f"{wt['branch']}@{{upstream}}", cwd=wt["repo"])
        return False
    except MeshError:
        return True


def merge_conflicts(repo: str, ours: str, theirs: str) -> list[str] | None:
    """Files that conflict when `theirs` merges into `ours`, without touching any checkout; None if it's clean."""
    proc = subprocess.run(["git", "merge-tree", "--write-tree", "--name-only", "--no-messages", ours, theirs],
                          cwd=repo, capture_output=True, text=True)
    if proc.returncode == 0:
        return None
    if proc.returncode == 1:
        return [line for line in proc.stdout.splitlines()[1:] if line.strip()]
    if "write-tree" in proc.stderr or "usage" in proc.stderr:
        raise MeshError("`mesh conflicts` needs git 2.38 or newer (`git merge-tree --write-tree`)")
    raise MeshError(f"git merge-tree {ours} {theirs}: {proc.stderr.strip()}")


def contains(repo: str, ancestor: str, ref: str) -> bool:
    return subprocess.run(["git", "merge-base", "--is-ancestor", ancestor, ref], cwd=repo).returncode == 0


def changed_files(repo: str, wt: dict, target: str) -> set[str]:
    """Paths a worker has touched: its own commits, plus, while its worktree exists, what is staged,
    unstaged or untracked there. Its commits start at its recorded base, so a stacked worker doesn't
    claim its parent's files, or the commits of a base it shares with others; a branch since rebased
    onto a newer `target` starts there instead."""
    branch = wt["branch"]
    start = git("merge-base", target, branch, cwd=repo)
    if wt.get("base"):
        own = git("merge-base", wt["base"], branch, cwd=repo)
        if not contains(repo, own, start):
            start = own
    # Raw NUL-separated paths, as `status -z` gives them, and both sides of a rename.
    diff = subprocess.run(["git", "diff", "--name-only", "-z", "--no-renames", start, branch],
                          cwd=repo, capture_output=True, text=True)
    if diff.returncode != 0:
        raise MeshError(f"git diff {start} {branch}: {diff.stderr.strip()}")
    files = set(diff.stdout.split("\0"))
    if Path(wt["path"]).is_dir():
        out = subprocess.run(["git", "status", "--porcelain=v2", "-z", "--untracked-files=all"],
                             cwd=wt["path"], capture_output=True, text=True).stdout
        fields = iter(out.split("\0"))
        for field in fields:
            kind = field[:1]
            if kind == "1":  # changed: 8 fields, then the path
                files.add(field.split(" ", 8)[-1])
            elif kind == "2":  # renamed or copied: 9 fields and the path, then the path it came from
                files.add(field.split(" ", 9)[-1])
                files.add(next(fields, ""))
            elif kind == "u":  # unmerged: 10 fields, then the path
                files.add(field.split(" ", 10)[-1])
            elif kind == "?":
                files.add(field[2:])
    return {f for f in files if f}


def stacked(repo: str, parent: dict, child: dict, target: str) -> bool:
    """Whether `child` is built on `parent`'s commits: it contains them, or it started from a commit
    on `parent`'s branch past `parent`'s own start (which still holds once `parent` commits again).
    What it builds on must lie past `target`: a worker started from `target` after `parent` was rebased
    onto it, or after `parent` fast-forwarded to it, isn't stacked."""
    if (parent["committed"] and not contains(repo, parent["branch"], target)
            and contains(repo, parent["branch"], child["branch"])):
        return True
    base, own = child.get("base"), parent.get("base")
    return bool(base and own and base != own and contains(repo, own, base)
                and not contains(repo, base, target) and contains(repo, base, parent["branch"]))


def cmd_conflicts(args: argparse.Namespace) -> int:
    """Which run branches with commits conflict with their repo's default branch, or with each other,
    and which workers' changes, committed or not, touch the same files."""
    run_id = args.run_id or identity(args)[0]
    by_repo: dict[str, dict[str, dict]] = {}  # repo -> branch -> its worktree record
    for wt in load_run(run_id).get("worktrees", []):
        try:
            tip = git("rev-parse", f"refs/heads/{wt['branch']}", cwd=wt["repo"])
        except MeshError:
            continue  # deleted
        seen = by_repo.setdefault(wt["repo"], {})
        if wt["branch"] not in seen or Path(wt["path"]).is_dir():  # a resumed worker's live worktree wins
            seen[wt["branch"]] = {**wt, "committed": tip != wt.get("base")}
    rows, overlaps = [], []
    for repo, wts in by_repo.items():
        target = default_base(Path(repo))
        branches = list(wts)
        committed = [b for b in branches if wts[b]["committed"]]
        # Stacked branches (one built on the other's commits) are meant to overlap: skip those pairs.
        # Two branches still at the same commit contain each other, but aren't stacked.
        apart = [(a, b) for i, a in enumerate(branches) for b in branches[i + 1:]
                 if not stacked(repo, wts[a], wts[b], target) and not stacked(repo, wts[b], wts[a], target)]
        pairs = [(b, target) for b in committed]
        pairs += [(a, b) for i, a in enumerate(committed) for b in committed[i + 1:]
                  if not contains(repo, a, b) and not contains(repo, b, a)]
        conflicting: dict[tuple[str, str], list[str]] = {}
        for branch, against in pairs:
            files = merge_conflicts(repo, against, branch)
            if files is not None:
                rows.append({"repo": Path(repo).name, "branch": branch, "against": against, "files": files})
                conflicting[(branch, against)] = files
        # Overlap is an early warning: it also sees uncommitted work, which merge-tree can't.
        touched: dict[str, set[str]] = {}
        for b in branches:
            try:
                touched[b] = changed_files(repo, wts[b], target)
            except MeshError as e:  # e.g. its recorded base was garbage-collected
                print(f"mesh conflicts: no overlap check for {b}: {e}", file=sys.stderr)
        for a, b in apart:
            if a not in touched or b not in touched:
                continue
            shared = sorted((touched[a] & touched[b]) - set(conflicting.get((a, b), [])))
            if shared:
                overlaps.append({"repo": Path(repo).name, "branch": a, "against": b, "files": shared,
                                 "kind": "overlap"})
    if args.json:
        emit([{**r, "kind": "conflict"} for r in rows] + overlaps)
        return 0
    if rows:
        print_table([{**r, "files": " ".join(r["files"])} for r in rows], ("repo", "branch", "against", "files"))
    else:
        checked = sum(wt["committed"] for wts in by_repo.values() for wt in wts.values())
        print(f"No conflicts among {checked} branch(es) with commits.")
    if overlaps:
        print("\nWarning: these workers change the same files (committed or not), so their branches may "
              "conflict once they commit or merge:")
        print_table([{**r, "files": " ".join(r["files"])} for r in overlaps], ("repo", "branch", "against", "files"))
    return 0


def is_worker(run_id: str | None, name: str | None) -> bool:
    return bool(run_id and name) and (((maybe_run(run_id) or {}).get("agents") or {}).get(name) or {}).get(
        "role") == "worker"


def stopping_worker(args: argparse.Namespace) -> tuple[str, str, str]:
    """(run to stop, caller's run, caller's name): a worker never stops a run (its root does).

    With a run id to stop, the caller only has to be told apart from a worker, so it's read from the flags and
    the environment, without `identity`'s side effects: the pane map names only roots, so a caller found
    there is never a worker. It is refused as a worker of any run it names (`--run`, `MESH_RUN`) or of the
    target. With neither a name nor a run, it's the user in a plain shell. Without a run id, the caller's
    identity is the run.
    """
    if not args.run_id:
        run_id, me = identity(args)
        return run_id, run_id, me
    flag_run = getattr(args, "run", None)
    if flag_run and flag_run != args.run_id:
        raise MeshError(f"--run {flag_run} names another run than the one to stop ({args.run_id})")
    name = getattr(args, "as_", None) or os.environ.get("MESH_SELF")
    runs = dict.fromkeys(r for r in (flag_run, os.environ.get("MESH_RUN"), args.run_id) if r)
    return args.run_id, next((r for r in runs if is_worker(r, name)), ""), name or ""


def cmd_stop(args: argparse.Namespace) -> int:
    run_id, caller_run, caller = stopping_worker(args)
    if is_worker(caller_run, caller):
        log_event(caller_run, "refused", name=caller, command="stop", run=run_id)
        raise MeshError(f"{caller} is a worker of run {caller_run}, and only a root stops a run: report "
                        "`done` to your parent, which stops it (the root, if this isn't a worker: pass --as <root>)")
    run = load_run(run_id)
    for name, entry in run["agents"].items():
        if entry.get("view") == "headless":
            # Removing its worktree and archiving the run under it would lose the answer.
            holder = live_holder(name, entry)
            if holder:
                kill = "kill it" if holder["answering"] == "mesh process" else f"kill it with `kill -- -{holder['pid']}`"
                raise MeshError(f"{name} is still answering in {holder['answering']} {holder['pid']}; wait for "
                                f"it to finish (or {kill}), then stop the run")
    closed, kept, removed, deleted = [], [], [], []
    for name, entry in run["agents"].items():
        if entry.get("view") == "headless" and entry.get("pane"):  # a peek pane a killed `mesh ask` left open
            close_peek(run_id, name, entry["pane"])
        if entry["role"] == "root" or entry.get("status") == "retired" or entry.get("view") == "headless":
            continue
        if entry.get("view") == "bg":
            if stop_bg(entry):  # the conversation is kept, so it can be resumed
                closed.append(name)
            continue
        try:
            herdr("pane", "close", entry["pane"])
            closed.append(name)
        except HerdrError:
            pass
    for tab in run.get("tabs", {}).values():
        try:
            herdr("tab", "close", tab)
        except HerdrError:
            pass
    for wt in run.get("worktrees", []):
        path = Path(wt["path"])
        if not path.exists():
            continue
        dirty = subprocess.run(["git", "status", "--porcelain"], cwd=path, capture_output=True, text=True).stdout.strip()
        if dirty or args.keep_worktrees:
            kept.append({"path": str(path), "branch": wt["branch"], "dirty": bool(dirty)})
            continue
        git("worktree", "remove", str(path), cwd=wt["repo"])
        removed.append({"path": str(path), "branch": wt["branch"]})
        if untouched_branch(wt):
            git("branch", "-D", wt["branch"], cwd=wt["repo"])
            deleted.append(wt["branch"])
    run_worktrees = worktree_root() / run_id
    if run_worktrees.is_dir() and not any(run_worktrees.iterdir()):
        run_worktrees.rmdir()
    root = run["agents"][run["root"]]
    if root.get("renamed", True):
        try:
            herdr("agent", "rename", root["pane"], "--clear")
        except HerdrError:
            pass
    (mesh_home() / "by-pane" / f"{pane_key(root['pane'])}.json").unlink(missing_ok=True)
    log_event(run_id, "stop", closed=closed, kept=[k["path"] for k in kept])
    archive = mesh_home() / "archive" / run_id
    archive.parent.mkdir(parents=True, exist_ok=True)
    os.replace(run_dir(run_id), archive)
    emit({"run": run_id, "closed": closed, "worktrees_removed": removed, "worktrees_kept": kept,
          "archive": str(archive), "branches_deleted": deleted,
          "branches_kept": [w["branch"] for w in run.get("worktrees", []) if w["branch"] not in deleted]})
    return 0


def worker_phase(entry: dict, events: list[dict], name: str, task: str | None) -> str:
    """Where a worker stands on its current task, in a line it can act on."""
    report, _ = last_report(events, name)
    if last := report["type"] if report else None:
        return {"plan": "your plan is waiting for its answer: change nothing until it says approved",
                "question": "your question is waiting for its answer"}.get(
            last, f"you reported `{last}` on it: wait for a new task or answer")
    if (task or "").startswith(READ_ONLY_STARTS):
        return "a read-only task: change nothing, and report one `done` with the answer"
    if (task or "").startswith(DIRECT_STARTS[1]):  # before the direct task: it plans first
        return ("a plan the user reviews: if the user hasn't approved your plan in your pane yet, plan in plan "
                "mode and change nothing; once it's approved, make the change, verify it, open the PR and report "
                "`done`")
    if (task or "").startswith(DIRECT_STARTS):
        return "a direct task (no plan review by your parent): make the change, verify it, open the PR, report `done`"
    if entry.get("phase") == "plan" or entry.get("planning"):
        return "planning: research, then send a `plan`, and change nothing until it is approved" + (
            " (until then mesh denies edits to your worktree and `git push`: a denial is expected, not something to "
            "work around)" if claude_deny(entry) else "")
    if entry.get("phase") == "exec":
        return "executing your approved plan: finish, verify, open the PR, then report `done`"
    return "working on it: report `done` or `failed` with `mesh send parent` when it's finished"


def reminder(run_id: str, me: str, source: str) -> str:
    """What `mesh whoami --reminder` prints, for a session that may have lost its context (SessionStart hook).
    Its wording must not match `first_doorbell`, which agy's conversation lookup searches for."""
    run = load_run(run_id)
    entry = agent_entry(run, me)
    events = read_log(run_id)
    files = current_task(run_id, me, events)
    task = parse_message(files[0])[1].strip() if files else None
    lines = [f"agent-mesh reminder ({source}): you are {me}, a {entry['role']} in run {run_id}, and your parent is "
             f"{entry.get('parent')}. Run dir: {run_dir(run_id)}. Protocol: {PROTOCOL_PATH}."]
    if files:
        meta = parse_message(files[-1])[0]
        lines.append(f"Current task: {task_gist(task) or '(see the file)'} ({files[0]}"
                     + (f"; latest answer {files[-1]}, from {meta.get('from')} at {meta.get('time')}" if len(files) > 1
                        else f", from {meta.get('from')} at {meta.get('time')}") + ").")
        lines.append(f"Phase: {worker_phase(entry, events, me, task)}.")
    else:
        lines.append("No task yet.")
    report, _ = last_report(events, me)
    again = (" (it shows your current task again)" if files and source in RESET_SOURCES
             and (report["type"] if report else None) not in FINAL_TYPES else "")
    ident = f"--run {run_id} --as {me}"  # a background session cleared has a new id and no pane to rebind by
    lines.append(f"Report with `mesh send parent {ident} …`. Run `mesh inbox {ident}` now{again}.")
    return "\n".join(lines)


def cmd_whoami(args: argparse.Namespace) -> int:
    if args.reminder:  # a SessionStart hook: never an error that would break the session
        try:
            run_id, me = identity(args)
            text = reminder(run_id, me, args.reminder)
            log_event(run_id, "reminder", name=me, source=args.reminder)
        except Exception as exc:  # noqa: BLE001
            print(f"mesh whoami --reminder: {exc}", file=sys.stderr)
            return 0
        print(text)
        return 0
    run_id, me = identity(args)
    entry = agent_entry(load_run(run_id), me)
    run = load_run(run_id)
    to_parent = native_route(run, me, entry["parent"]) if entry.get("parent") in run["agents"] else None
    emit({"run": run_id, "name": me, "role": entry["role"], "parent": entry.get("parent"),
          "dir": str(run_dir(run_id)), "unread": len(unread(run_id, me)), "view": entry.get("view"),
          "reports_by": "SendMessage" if to_parent else "doorbell"})
    return 0


def cmd_dir(args: argparse.Namespace) -> int:
    print(run_dir(identity(args)[0]))
    return 0


def cmd_model(args: argparse.Namespace) -> int:
    if (args.model or "auto") == "auto":
        model, notes = plan_model(args.kind, args.effort)
        for note in notes:
            print(f"mesh: {note}", file=sys.stderr)
    else:
        model = args.model
    print(agent_argv(args.kind, model, args.effort)[1])
    return 0


def cmd_usage(args: argparse.Namespace) -> int:
    rows = agy_usage(force=args.refresh)
    if rows is None:
        raise MeshError("`agy -p /usage` gave no quota rows")
    plan, notes = choose_agy_model(PLAN_CHAIN["agy"], args.effort)
    execute = resolve_agy_model(EXEC_MODEL["agy"], args.exec_effort)
    names = listing_names(agy_model_listing())
    exec_quota = model_quota(execute, names.get(execute, ""), rows)
    if args.json:
        emit({"rows": rows, "plan": plan, "exec": execute, "exec_left": exec_quota and exec_quota[0],
              "notes": notes, "min_quota": min_quota()})
        return 0
    print_table(rows, ("group", "label", "left", "resets"))
    print(f"\nplan on {plan}, execute on {execute}"
          + (f" ({exec_quota[0]}% left)" if exec_quota else "") + f"; threshold {min_quota()}%")
    for note in notes:
        print(f"  {note}")
    return 0


# ── root context: measuring, resetting and briefing the root ─────────────


CACHE_TTL = 3600  # seconds a prompt cache lives (Claude Code subscriptions; API keys get 300: MESH_CACHE_TTL)
ROOT_RESET_AT = 300_000  # root context tokens past which mesh suggests `mesh reset`
RESET_WAIT = 1800  # seconds a reset waits for the root's turn to end and its input box to empty
RESET_POLL = 2.0
RESET_QUIET_READS = 2  # idle reads in a row before typing: a gap between two tool calls isn't the turn's end
CLEAR_CONFIRM = 15  # seconds for a typed /clear to show up as a new session
AUTORESET_EVERY = 60  # seconds between a root watch's idle-reset checks
BLOCKING_TYPES = ("plan", "question")  # unread reports that keep the root from resetting: a worker waits on them
QUIET_STATES = ("idle", "done")
# herdr's `--lines N` is the screen's last N rows, blank ones under the content included: on a tall pane with
# little on it (a root just cleared) the box sits higher than PANE_READ_LINES reaches.
RESET_READ_LINES = 200


def quietly(fn, *args, **kwargs):
    """`fn(...)`, or None if it fails: for readings and hints that must never fail the command that asked."""
    try:
        return fn(*args, **kwargs)
    except Exception:  # noqa: BLE001
        return None


def caller(args: argparse.Namespace, run_id: str | None) -> tuple[str, str | None]:
    """(run, own name) for a command that may name another run than the caller's: the name is None unless the
    caller is an agent of that run. Its own identity is resolved as any command's, so nothing of the named run
    is touched (no rebind, no address) when it isn't the caller's."""
    if not run_id:
        return identity(args)
    try:
        own_run, name = identity(args)
    except MeshError:
        return run_id, None
    return run_id, name if own_run == run_id else None


def env_int(key: str, default: int) -> int:
    try:
        return int(os.environ.get(key) or default)
    except ValueError:
        return default


def cache_ttl() -> int:
    return env_int("MESH_CACHE_TTL", CACHE_TTL)


def root_reset_at() -> int:
    return env_int("MESH_ROOT_RESET_AT", ROOT_RESET_AT)


def autoreset_on() -> bool:
    return os.environ.get("MESH_ROOT_AUTORESET") == "1"


def pane_agent(pane: str) -> dict:
    """herdr's record of a pane's agent ({} if it has none)."""
    try:
        return herdr("agent", "get", pane).get("agent") or {}
    except HerdrError:
        return {}


def root_session(entry: dict, as_root: bool = False) -> str | None:
    """The root's current conversation. Claude: what herdr's Claude integration reports for the root's pane (it
    follows a /clear: seen live); a command the root itself runs (`as_root`) may use the session it runs under
    when herdr agrees or can't say. When they disagree, either can be stale: a root watch that outlived a
    reset runs under the old session, and herdr takes a session report from anything in the pane (a nested
    `claude -c -p`). The root's is then the one whose session file was written last: a root command runs inside
    a live turn, which has just written its own. Never the caller's session otherwise: a worker's isn't the
    root's. agy: the one its last `mesh reset` recorded, as nothing ties an agy conversation to a pane before."""
    if entry.get("kind") == "agy":
        return entry.get("session")
    reported = (pane_agent(entry["pane"]).get("agent_session") or {}).get("value") if entry.get("pane") else None
    own = os.environ.get("CLAUDE_CODE_SESSION_ID") if as_root else None
    if not own or reported in (None, own):
        return own or reported

    def written(session: str) -> float:
        path = root_transcript(entry, session)
        try:
            return path.stat().st_mtime if path else float("-inf")
        except OSError:
            return float("-inf")

    return max((own, reported), key=written)


def root_transcript(entry: dict, session: str) -> Path | None:
    """A Claude root's session file: under its cwd's project folder, else wherever Claude started it."""
    if path := claude_transcript(entry, session):
        return path
    base = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "projects"
    return next(iter(sorted(base.glob(f"*/{session}.jsonl"))), None)


def root_context(run: dict, as_root: bool = False) -> dict | None:
    """The root's context size and cache state, or None when it can't be read (an agy root before its first
    reset, a session file not found). The cache is cold once the conversation has been still for its TTL: its
    next turn then re-reads every token at full price, where a warm one pays a twentieth."""
    entry = run["agents"].get(run.get("root")) or {}
    session = root_session(entry, as_root) if entry.get("pane") else None
    if not session:
        return None
    if entry.get("kind") == "agy":
        tokens, files = agy_context_tokens(session), progress_files({"kind": "agy"}, session)
        transcript = agy_conversation_file(session)
    else:
        transcript = root_transcript(entry, session)
        tokens, files = (transcript_tokens(transcript), [transcript]) if transcript else (None, [])
    if tokens is None:
        return None
    last = max((f.stat().st_mtime for f in files if f.exists()), default=None)
    idle = time.time() - last if last else None
    return {"kind": entry.get("kind"), "session": session, "transcript": str(transcript), "tokens": tokens,
            "last_turn": datetime.fromtimestamp(last, timezone.utc).isoformat(timespec="seconds") if last else None,
            "idle": round(idle) if idle is not None else None,
            "cold": idle is not None and idle > cache_ttl(), "reset_at": root_reset_at()}


def kilo(tokens: int) -> str:
    return f"{tokens / 1000:.0f}k"


def context_text(context: dict) -> str:
    """`root context 452k, cache cold since 14:02` (or warm, with how long it has been still)."""
    text = f"root context {kilo(context['tokens'])}"
    if context.get("last_turn") is None:
        return text
    if context["cold"]:
        since = datetime.fromisoformat(context["last_turn"]) + timedelta(seconds=cache_ttl())
        return f"{text}, cache cold since {since.astimezone():%H:%M}"
    return f"{text}, cache warm ({ago(context['idle'])} since its last turn)"


def root_mail(run_id: str, root: str, types: tuple[str, ...] = REPORT_TYPES) -> list[dict]:
    """The root's unread reports of these types (who sent which), oldest first."""
    found = []
    for path in unread(run_id, root):
        meta, _ = parse_message(path)
        if meta.get("type") in types:
            found.append(meta)
    return found


def mail_text(mail: list[dict]) -> str:
    return ", ".join(f"a {m.get('type')} from {m.get('from')}" for m in mail)


# `reset_noted`: a root command showed the root that its last reset failed or was cancelled (once is enough).
RESET_EVENTS = ("reset_requested", "reset", "reset_failed", "reset_cancelled", "reset_noted")


def last_reset(events: list[dict]) -> dict | None:
    return next((e for e in reversed(events) if e.get("event") in RESET_EVENTS), None)


def reset_lock_path(run_id: str) -> Path:
    return run_dir(run_id) / "reset.lock"


def reset_pending(run_id: str) -> bool:
    """Whether a detached reset is running: it holds the run's reset lock until it ends."""
    path = reset_lock_path(run_id)
    if not path.exists():
        return False
    with path.open("a") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(handle, fcntl.LOCK_UN)
    return False


def root_line(run_id: str, about_to_wait: bool = False) -> tuple[str | None, bool]:
    """The hint a root command prints about the root's own context, or None (design §15).

    A `/clear` never re-reads the old context, so a reset costs the fresh session's small prefix whenever it
    happens; what it saves is the next turns of the big one: all of it at full price once the cache is cold,
    a twentieth of it while warm. Hence: reset now when cold, or when about to wait (the next report may well
    come after the cache expired); while warm, only when very big, at a quiet point. The second value says
    whether the line reports a failed or cancelled reset, which it does once.
    """
    run = load_run(run_id)
    events = read_log(run_id)
    notes = []
    last = last_reset(events)
    if reset_pending(run_id):
        return None, False
    failure = bool(last and last["event"] in ("reset_failed", "reset_cancelled"))
    if failure:
        what = "failed" if last["event"] == "reset_failed" else "was cancelled"
        notes.append(f"the last `mesh reset` {what} {ago(age_seconds(last['time']))}: {last.get('reason')}")
    context = root_context(run, as_root=True)
    at = root_reset_at()
    if context and context["tokens"] > at:
        reset = 'write notes.md, then run `mesh reset --next "<what you do next>"` and end your turn'
        waits = root_mail(run_id, run["root"])
        if context["cold"]:
            notes.append(f"{context_text(context)}: its next turn re-reads all of it; {reset}"
                         + (f", once you've handled {mail_text(waits)}" if waits else ""))
        elif about_to_wait and not waits:
            notes.append(f"{context_text(context)}, and you're about to wait on workers: a report that wakes you "
                         f"after the cache expires ({ago(cache_ttl())}) re-reads all of it at full price; {reset}")
        elif context["tokens"] > 2 * at:
            notes.append(f"{context_text(context)}: at your next quiet point (a phase boundary, nothing waiting "
                         f"on you), {reset}")
    return "; ".join(notes) or None, failure


def root_hint(run_id: str, about_to_wait: bool = False) -> None:
    """Print `root_line` on stderr; never fails the command (like `warn_unwatched`). For root commands only."""
    line, failure = quietly(root_line, run_id, about_to_wait) or (None, False)
    if line:
        print(f"mesh: {line} (see ORCHESTRATE.md, \"Your own context\")", file=sys.stderr)
    if failure:
        quietly(log_event, run_id, "reset_noted", name=(maybe_run(run_id) or {}).get("root"))


def start_reset(run_id: str, root: str, next_task: str | None, compact: str | None, via: str) -> int:
    """Start the detached process that resets the root once its turn ends, holding the run's reset lock.

    The lock is taken here and handed down (the child inherits the open file through `pass_fds` and holds it
    until it exits), so two `mesh reset` calls can't both start one. The child gets
    no Claude session variables: it is nobody's tool, and names the root with --run/--as.
    """
    path = reset_lock_path(run_id)
    handle = path.open("a")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        raise MeshError("a reset is already pending for this run (`mesh log` shows how it goes)")
    log = run_dir(run_id) / "logs" / "reset.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    argv = [sys.executable, str(Path(__file__).absolute()), "reset", "--run", run_id, "--as", root,
            "--detached", "--via", via,
            *(["--next", next_task] if next_task else []), *(["--compact", compact] if compact is not None else [])]
    env = {k: v for k, v in os.environ.items() if k not in CLAUDE_SESSION_VARS and k not in MESH_IDS}
    try:
        with open(log, "a") as out:
            proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, env=env,
                                    start_new_session=True, pass_fds=(handle.fileno(),))
    finally:
        handle.close()  # the child holds the lock now: same open file, its own descriptor
    log_event(run_id, "reset_requested", name=root, via=via, next=next_task, compact=compact, pid=proc.pid)
    return proc.pid


def cmd_reset(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    if args.detached:
        return reset_root(run_id, me, args.next, args.compact, args.via)
    run = load_run(run_id)
    entry = run["agents"].get(me) or {}
    if entry.get("role") != "root":
        raise MeshError("only a run's root resets itself: `mesh reset` clears its own pane (a worker's context "
                        "is compacted by `mesh resume`)")
    if entry.get("kind") not in KINDS or not entry.get("pane"):
        raise MeshError(f"{me} has no Claude or agy pane to reset")
    if waits := root_mail(run_id, me, BLOCKING_TYPES):
        raise MeshError(f"{mail_text(waits)} waits on you: answer it first (`mesh inbox`), then reset")
    pid = start_reset(run_id, me, args.next, args.compact, via="command")
    emit({"pending": True, "pid": pid, "next": args.next, "compact": args.compact,
          "log": str(run_dir(run_id) / "logs" / "reset.log"),
          "then": "end your turn now: once it has ended (and the box is empty), mesh types "
                  f"{'/compact' if args.compact is not None else '/clear'} into your pane, then a prompt that "
                  "points you at `mesh brief`"})
    return 0


def quiet_box(pane: str) -> tuple[bool, str]:
    """Whether the pane's agent has ended its turn with an empty input box, and if not, why not.

    Claude runs a typed /clear at once even mid-turn, throwing the turn away (live test, design §15), so the
    check is positive: herdr reads idle or done, and the box reads empty (ghost text is dim, not typed). A
    draft, or a box that can't be read, holds it.
    """
    agent = pane_agent(pane)
    status = agent.get("agent_status")
    if not agent:
        return False, "its pane has no agent"
    if status not in QUIET_STATES:
        return False, f"it reads {status}"
    lines = pane_lines(pane, RESET_READ_LINES, ansi=True)
    typed = typed_text(lines) if lines is not None else None
    if typed is None:
        return False, "its input box can't be read"
    if typed:
        return False, "a draft is in its input box"
    return True, ""


def agy_conversations() -> set[str]:
    folder = agy_conversation_file("x").parent
    return {p.stem for p in folder.glob("*.db")} if folder.is_dir() else set()


def cleared_session(entry: dict, before: str | None, agy_before: set[str]) -> set[str]:
    """The new conversation(s) a typed /clear started, once one shows: Claude's from herdr (its integration
    reports the clear), agy's as conversation files that weren't there before (another agy may have started one
    meanwhile: `agy_root_conversation` tells them apart); empty if none showed in time."""
    for _ in range(CLEAR_CONFIRM):
        if entry.get("kind") == "agy":
            if new := agy_conversations() - agy_before:
                return new
        else:
            current = (pane_agent(entry["pane"]).get("agent_session") or {}).get("value")
            if current and current != before:
                return {current}
        time.sleep(1)
    return set()


def agy_root_conversation(before: set[str], token: str) -> str | None:
    """Which new agy conversation (not in `before`) is the root's: the one whose first prompt (agy's index keeps
    it as `preview`) is the bootstrap carrying this reset's token. A lone new one isn't taken on trust: another
    agy may have started it while the root's own isn't indexed yet, so the index is polled for a while; None
    when it never shows."""
    source = Path(os.environ.get("MESH_AGY_SUMMARIES") or Path.home() / AGY_HOME / "conversation_summaries.db")
    for _ in range(CLEAR_CONFIRM):
        try:
            mtime = max(f.stat().st_mtime for f in (source, source.with_name(source.name + "-wal")) if f.exists())
        except (OSError, ValueError):
            mtime = None
        if mtime is not None:
            for row in agy_summaries(str(source), mtime):
                if row["conversationId"] not in before and f"(ref {token})" in row["display"]:
                    return row["conversationId"]
        time.sleep(1)
    return None


def bootstrap_text(run_id: str, root: str, next_task: str | None, compacted: bool, token: str,
                   via: str = "command") -> str:
    """The prompt a reset root wakes to. It is a doorbell (so `human_draft` takes a leftover copy for ours), but
    a root's: it has no parent to report to. After the watch's idle reset, the root may have been waiting on the
    user: ORCHESTRATE has it write such a question to notes.md, and the prompt says to look there."""
    what = "compacted your session" if compacted else "gave you a fresh session (your earlier context is gone)"
    then = next_task or "carry on from the next step in your notes"
    if via == "watch":
        then += ("; if notes.md says you were waiting on an answer from the user, ask the user again rather "
                 "than going on without it")
    return (f"{DOORBELL_PREFIX} (ref {token}) You are {root}, the root of agent-mesh run {run_id}, and `mesh reset` "
            f"just {what}. You have no parent to report to. Run `mesh brief` and rebuild your picture from it, "
            f"not from memory. Then: {then}")


def reset_root(run_id: str, root: str, next_task: str | None, compact: str | None, via: str = "command") -> int:
    """The detached half of `mesh reset`: wait for the root's turn to end, type /clear (or /compact), confirm it,
    then type the bootstrap prompt. Every outcome is a `reset*` event, which the root's next command shows."""
    run = load_run(run_id)
    entry = run["agents"][root]
    pane, kind = entry["pane"], entry.get("kind")
    context = quietly(root_context, run)
    deadline = time.monotonic() + env_int("MESH_RESET_WAIT", RESET_WAIT)
    quiet, why = 0, "it never read idle"

    def failed(event: str, reason: str) -> int:
        log_event(run_id, event, name=root, reason=reason)
        print(f"mesh reset: {event}: {reason}", flush=True)
        return 1

    while True:
        ok, why = quiet_box(pane)
        quiet = quiet + 1 if ok else 0
        if quiet >= RESET_QUIET_READS:
            with ring_lock(pane) as locked:  # nothing else types into the pane meanwhile
                ok, why = quiet_box(pane) if locked else (False, "another ring holds its pane")
                if ok:
                    if waits := root_mail(run_id, root, BLOCKING_TYPES):  # a report on its way rings after this
                        return failed("reset_cancelled", f"{mail_text(waits)} arrived")
                    before = entry.get("session") if kind == "agy" else \
                        (pane_agent(pane).get("agent_session") or {}).get("value")
                    agy_before = agy_conversations() if kind == "agy" else set()
                    command = f"/compact {compact}".strip() if compact is not None else "/clear"
                    try:
                        if compact is not None:  # a compaction is a turn: it starts working, then ends
                            herdr("agent", "prompt", pane, command, "--wait", "--until", "working",
                                  "--timeout", "15000", timeout=30)
                        else:  # a clear is no turn: herdr sees no change and would call it stalled
                            herdr("agent", "prompt", pane, command, timeout=30)
                    except HerdrError as exc:
                        return failed("reset_failed", f"typing {command} failed: {exc.code}")
                    break
            quiet = 0
        if time.monotonic() > deadline:
            return failed("reset_failed", f"gave up after waiting {ago(env_int('MESH_RESET_WAIT', RESET_WAIT))}: "
                                          f"{why}")
        time.sleep(RESET_POLL)
    if compact is not None:
        try:
            herdr("agent", "wait", pane, "--until", "idle", "--until", "done", "--timeout",
                  str(COMPACT_TIMEOUT * 1000), timeout=COMPACT_TIMEOUT + 30)
        except HerdrError as exc:
            return failed("reset_failed", f"the compaction didn't finish: {exc.code}")
        candidates = {before} if before else set()  # a compaction keeps the conversation
    else:
        candidates = cleared_session(entry, before, agy_before)
        if not candidates:
            return failed("reset_failed", "the /clear didn't show up as a new session; no prompt typed")
    token = ring_token()
    result = ring([pane], bootstrap_text(run_id, root, next_task, compact is not None, token, via), token)
    if not result["rung"]:
        return failed("reset_failed", f"its session was reset, but the prompt to run `mesh brief` didn't get "
                                      f"through ({result['error']})")
    note = None
    if compact is not None:
        new = before
    elif kind == "agy":
        new = agy_root_conversation(agy_before, token)
        if new is None:
            note = "couldn't tell which new agy conversation is the root's; it isn't measured until its next reset"
    else:
        new = next(iter(candidates), None)
    if kind == "agy":  # recorded so it is measured from now on; a guess would measure someone else's
        with editing_run(run_id) as data:
            data["agents"][root]["session"] = new
    log_event(run_id, "reset", name=root, via=via, compact=compact, next=next_task, old_session=before,
              new_session=new, tokens=(context or {}).get("tokens"),
              transcript=(context or {}).get("transcript"), **({"note": note} if note else {}))
    print(f"mesh reset: done ({before} → {new})", flush=True)
    return 0


def maybe_autoreset(run_id: str, run: dict, events: list[dict]) -> bool:
    """The root's own watch, with MESH_ROOT_AUTORESET=1: reset a root that is over the threshold, idle, cold and
    owed nothing. Stricter than `mesh reset`: any unread report holds it, since it acts without the root's say."""
    root = run.get("root")
    entry = run["agents"].get(root) or {}
    if entry.get("kind") not in KINDS or not entry.get("pane") or reset_pending(run_id):
        return False
    last = next((e for e in reversed(events) if e.get("event") == "reset_requested"), None)
    if last and age_seconds(last["time"]) < cache_ttl():
        return False  # one try per cache lifetime: a failing one shouldn't repeat every minute
    context = root_context(run)
    if not context or context["tokens"] <= root_reset_at() or not context["cold"] or root_mail(run_id, root):
        return False
    if pane_agent(entry["pane"]).get("agent_status") not in QUIET_STATES:
        return False
    start_reset(run_id, root, "carry on supervising: your watch reset you while you were idle with a cold cache",
                None, via="watch")
    return True


BRIEF_TEXT = 4000  # characters of board.md and of notes.md a brief carries
BRIEF_REQUEST = 1000  # characters of the run's request
BRIEF_ROWS = 25
BRIEF_MAIL = 10


def capped(text: str, limit: int, more: str) -> str:
    """`text` up to `limit` characters, cut at a line end, then what was left out and where to read it."""
    if len(text) <= limit:
        return text
    cut = text.rfind("\n", 0, limit)
    cut = cut if cut > limit // 2 else limit
    return f"{text[:cut].rstrip()}\n… {len(text) - cut} more characters: {more}"


def capped_list(items: list[str], limit: int, more: str) -> list[str]:
    return items if len(items) <= limit else [*items[:limit], f"… {len(items) - limit} more: {more}"]


def brief(run_id: str, me: str) -> dict:
    """What a fresh root needs, in one bounded read (design §15): the run's request and procedure, the notes and
    board it kept, each worker's derived state, what waits on it, its PRs, unread mail headers and the last
    reset. Each part is capped, and says where the rest is."""
    run = load_run(run_id)
    folder = run_dir(run_id)
    events = read_log(run_id)
    rows = status_rows(run_id, run)
    root = run.get("root")
    workers = [r for r in rows if r["role"] != "root"]
    lines = []
    for r in workers:
        line = f"{r['name']} ({r['kind']} {r['model'] or '?'}, {r['size'] or 'large'}, {r['view']}): {r['state']}"
        line += f"; {r['waiting']}" if r["waiting"] else ""
        line += " ← needs you" if r["needs"] == "root" else ""
        lines.append(line)
    prs = [f"{p['url']}: {p['state']}" + (f", checks {p['checks']}" if p.get("checks") else "")
           + f" (by {r['name']})" for r in workers for p in r.get("prs") or []]
    mail = []
    for path in unread(run_id, me):
        meta, body = parse_message(path)
        mail.append(f"{meta.get('type')} from {meta.get('from')} at {meta.get('time')}: {first_line(body, 120)}")
    texts = {}
    for name in ("notes.md", "board.md"):
        path = folder / name
        texts[name] = {"path": str(path),
                       "text": capped(path.read_text(errors="replace").strip(), BRIEF_TEXT, f"cat {path}")
                       if path.exists() else None}
    reset = next((e for e in reversed(events) if e.get("event") == "reset"), None)
    context = quietly(root_context, run, as_root=me == root)
    procedure = ("you are the run's root: follow ~/.config/agent-mesh/ORCHESTRATE.md (Root, and Task lists or "
                 "Questions and reviews as this run needs) and PROTOCOL.md; read them again now if this session "
                 "hasn't") if me == root else (f"you are {me}, not this run's root ({root}): this is its view of "
                                               "the run, and nothing in it is yours to act on")
    return {
        "run": run_id, "mode": run["mode"], "dir": str(folder), "you": me, "root": root,
        "request": capped(run.get("request") or "", BRIEF_REQUEST,
                          f"python3 -c 'import json; print(json.load(open(\"{folder / 'run.json'}\"))[\"request\"])'"),
        "procedure": procedure,
        "root_context": context, "notes": texts["notes.md"], "board": texts["board.md"],
        "workers": capped_list(lines, BRIEF_ROWS, "mesh status"),
        "needs_root": [r["name"] for r in rows if r["needs"] == "root"],
        "prs": capped_list(prs, BRIEF_ROWS, "mesh agents --run " + run_id),
        "unread": capped_list(mail, BRIEF_MAIL, "mesh inbox --peek"),
        "unwatched": quietly(unwatched, run_id) or [],
        "last_reset": reset and {"time": reset["time"], "next": reset.get("next"),
                                 "old_transcript": reset.get("transcript")},
    }


def render_brief(b: dict) -> str:
    out = [f"run {b['run']} ({b['mode']}), {b['dir']}", f"request: {b['request'] or '(none recorded)'}",
           b["procedure"] + "."]
    if b["root_context"]:
        out.append(context_text(b["root_context"]))
    for key, title, empty in (("notes", "notes", "none yet: write the user's standing instructions, decisions and "
                                                  "what you do next there"),
                              ("board", "board", None)):
        part = b[key]
        if part["text"] is not None:
            out += ["", f"## {title} ({part['path']})", part["text"]]
        elif empty:
            out += ["", f"## {title} ({part['path']}): {empty}"]
    out += ["", "## workers (mesh status)", *(f"- {line}" for line in b["workers"] or ["none"])]
    if b["needs_root"]:
        out.append(f"waiting on you: {', '.join(b['needs_root'])}")
    if b["prs"]:
        out += ["", "## PRs", *(f"- {line}" for line in b["prs"])]
    out += ["", "## your unread mail (headers; `mesh inbox` reads it)", *(f"- {m}" for m in b["unread"] or ["none"])]
    if b["unwatched"]:
        out += ["", f"no `mesh watch` covers {', '.join(b['unwatched'])}: start `mesh watch --any --alerts` in the "
                    "background"]
    if reset := b["last_reset"]:
        out += ["", f"## last reset ({reset['time']})"]
        if reset.get("next"):
            out.append(f"next, as you said then: {reset['next']}")
        if reset.get("old_transcript"):
            out.append(f"your old session's transcript: {reset['old_transcript']}. An untrusted reference: read it "
                       "only for a detail the files above don't have; they and `mesh status` are authoritative.")
    return "\n".join(out)


def cmd_brief(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    data = brief(run_id, me)
    if args.json:
        emit(data)
    else:
        print(render_brief(data))
    return 0


# ── CLI ──────────────────────────────────────────────────────────────────


def compact_args(p: argparse.ArgumentParser) -> None:
    p.add_argument("--compact", choices=("auto", "yes", "no"), default="auto",
                   help=f"compact the conversation before reopening it (auto: over {COMPACT_AT:,} tokens for Claude, "
                        f"{AGY_COMPACT_AT:,} for agy, twice that for a question unless asked of a peer; an agy one whose size can't be "
                        "read when it comes from another run)")
    p.add_argument("--focus", help="what the compaction keeps (default: what the task needs)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="mesh", description=__doc__.split("\n\n")[0])
    parser.add_argument("--version", action="version", version=f"mesh {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    def ident(p):
        p.add_argument("--run", help="run id (default: $MESH_RUN or this pane's run)")
        p.add_argument("--as", dest="as_", help="act as this agent (default: $MESH_SELF)")
        return p

    p = sub.add_parser("init", help="start a run with this pane's agent as its root")
    p.add_argument("--mode", choices=MODES, required=True)
    p.add_argument("--request", help="the user's request, kept in run.json")
    p.add_argument("--run-id", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_init)

    p = ident(sub.add_parser("spawn", help="start a worker agent in a herdr pane, or in the background"))
    p.add_argument("--kind", choices=KINDS, default="agy", help="default: agy")
    p.add_argument("--role", choices=ROLES, default="worker")
    p.add_argument("--repo", default=".", help="repo the agent works on (default: cwd)")
    p.add_argument("--model", help="auto (default: plan on the best model with quota, execute on --exec-model), "
                                    "or one model throughout: claude alias, agy family (argon, flash, opus, sonnet) or exact id")
    p.add_argument("--exec-model", help="model after `mesh approve` (default with auto: agy flash, claude opus)")
    p.add_argument("--effort", choices=EFFORTS,
                   help=f"effort for the whole task, planning and execution (default: {DEFAULT_EFFORT} planning, "
                        f"{EXEC_EFFORT} executing)")
    p.add_argument("--exec-effort", choices=EFFORTS,
                   help=f"effort after `mesh approve` (default: --effort, else {EXEC_EFFORT})")
    p.add_argument("--name", help="what goes after the repo in the agent's name (default: the worktree slug)")
    where = p.add_mutually_exclusive_group()
    where.add_argument("--worktree", metavar="SLUG", help="create a worktree on branch mesh/<run>/<SLUG>")
    where.add_argument("--cwd", help="start in an existing directory, e.g. an earlier worker's worktree")
    p.add_argument("--base", help="base ref for --worktree (default: origin/HEAD)")
    p.add_argument("--parent", help="parent agent (default: you)")
    p.add_argument("--task", help="first task message")
    p.add_argument("--task-file", help="first task message from a file (- for stdin)")
    p.add_argument("--size", choices=SIZES, help="trivial / small: one model, no plan phase (claude: opus, "
                                                  "in the background); large (default): plan, review, execute")
    p.add_argument("--view", choices=VIEWS, help="pane (herdr) or bg (`claude --bg`, Claude only; default by size)")
    p.add_argument("--plan-review", choices=("user",),
                   help="user: the user approves the plan in the worker's pane (claude, opus in plan mode)")
    p.set_defaults(func=cmd_spawn)

    p = ident(sub.add_parser("send", help="send a message (mailbox first, then the doorbell)"))
    p.add_argument("to", help="agent name, or `parent`")
    p.add_argument("--type", choices=TYPES, required=True)
    p.add_argument("--until", help="a `wait`'s end: a duration (45m, 1h30m), a local time (14:30) or ISO 8601")
    p.add_argument("--unread-ok", action="store_true",
                   help="send a plan/question/done/failed even though a task or answer is still unread")
    p.add_argument("--body")
    p.add_argument("--file", help="message body from a file (- for stdin)")
    p.set_defaults(func=cmd_send)

    p = ident(sub.add_parser("inbox", help="print unread messages and mark them read"))
    p.add_argument("--peek", action="store_true", help="do not mark as read")
    p.add_argument("--all", action="store_true", help="include already-read messages")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_inbox)

    p = ident(sub.add_parser("ring", help="re-ring an agent that has unread messages"))
    p.add_argument("agent")
    p.set_defaults(func=cmd_ring)

    p = ident(sub.add_parser("status", help="agents of a run with live herdr state"))
    p.add_argument("run_id", nargs="?")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_status)

    p = ident(sub.add_parser("log", help="the run's events as a timeline (sends, nudges, alerts, swaps…)"))
    p.add_argument("run_id", nargs="?", help="a live or archived run (default: yours)")
    p.add_argument("--agent", help="only events naming this agent")
    p.add_argument("--lines", type=int, default=0, help="only the last N events (default: all)")
    p.add_argument("--follow", action="store_true", help="keep printing new events until the run stops")
    p.set_defaults(func=cmd_log)

    p = ident(sub.add_parser("watch", help="watchdog: exits when a child reports or stalls"))
    p.add_argument("agent", nargs="?")
    p.add_argument("--any", action="store_true", help="every live worker of the run: exit on the first event")
    p.add_argument("--alerts", action="store_true",
                   help="alerts only: keep watching through done/failed (for workers that report by SendMessage)")
    p.add_argument("--run-id")
    p.add_argument("--timeout", type=int, default=0, help="seconds (0 = none)")
    p.add_argument("--interval", type=float, default=5.0)
    p.add_argument("--grace", type=float, default=SETTLE_GRACE,
                   help="seconds a worker must stay idle before it counts as stopped (default %(default)s)")
    p.add_argument("--hang", type=float, default=None,
                   help="seconds a worker may read working with its transcript unchanged before exit 8 "
                        f"(default MESH_HANG_AFTER or {int(HANG_AFTER)}; 0 = never)")
    p.set_defaults(func=cmd_watch)

    p = ident(sub.add_parser("approve", help="approve a worker's plan, moving an auto worker to its exec model"))
    p.add_argument("agent")
    p.add_argument("--body", help="notes to go with the approval")
    p.add_argument("--file", help="notes from a file (- for stdin)")
    p.add_argument("--keep-model", action="store_true",
                   help="execute on the current model: for when the swap can't start (no conversation found, busy)")
    p.set_defaults(func=cmd_approve)

    p = ident(sub.add_parser("switch", help="move a worker that hit a quota to the next model with quota left"))
    p.add_argument("agent")
    p.add_argument("--model", help="this model instead of the next in the chain")
    p.set_defaults(func=cmd_switch)

    p = ident(sub.add_parser("retire", help="close a child's pane (its worktree stays)"))
    p.add_argument("agent")
    p.set_defaults(func=cmd_retire)

    p = sub.add_parser("agents", help="past and present workers of every run, with branches and PRs")
    p.add_argument("query", nargs="?", help="filter on name, repo, branch or PR link")
    p.add_argument("--run", help="only this run's workers, resumed ones included")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_agents)

    p = ident(sub.add_parser("resume", help="bring a past worker back, with its conversation, into this run"))
    p.add_argument("ref", help="the worker's name, branch or PR link (see `mesh agents`)")
    p.add_argument("--from-run", help="look only in this run (default: the newest match)")
    p.add_argument("--model", help="override the model it ran on (same CLI)")
    p.add_argument("--effort", choices=EFFORTS)
    p.add_argument("--task", help="the follow-up task")
    p.add_argument("--task-file", help="the follow-up task from a file (- for stdin)")
    compact_args(p)
    p.add_argument("--view", choices=VIEWS, help="reopen in a pane or in the background (default: as before)")
    p.set_defaults(func=cmd_resume)

    p = sub.add_parser("open", help="reopen a past worker's conversation in this terminal, outside the mesh")
    p.add_argument("ref", help="the worker's name, branch or PR link (see `mesh agents`)")
    p.add_argument("--from-run", help="look only in this run (default: the newest match)")
    p.add_argument("--model", help="override the model it ran on")
    p.add_argument("--effort", choices=EFFORTS)
    p.add_argument("extra", nargs=argparse.REMAINDER, help="after --: more arguments for the CLI")
    p.set_defaults(func=cmd_open)

    p = sub.add_parser("peek", help="show what a Copilot asker is doing: its latest tool calls and messages")
    p.add_argument("ref", help="the asker's name or branch (see `mesh agents`)")
    p.add_argument("--from-run", help="look only in this run (default: the newest match)")
    p.add_argument("--lines", type=int, default=15, help="how many past events to show (default: 15)")
    p.add_argument("--follow", action="store_true", help="keep printing new events until it stops answering")
    p.set_defaults(func=cmd_peek)

    p = ident(sub.add_parser("ask", help="ask a worker, or a fresh agent in a repo, a question or for a PR review, "
                                         "and wait for the answer"))
    p.add_argument("ref", nargs="?", help="an existing worker: name, branch or PR link (see `mesh agents`)")
    p.add_argument("--repo", help="start a fresh agent in this repo instead")
    p.add_argument("--review", metavar="PR", help="ask for a review of this PR (link, or number in --repo)")
    p.add_argument("--body", help="the question, or notes for the review")
    p.add_argument("--file", help="the question from a file (- for stdin)")
    p.add_argument("--kind", choices=ASK_KINDS,
                   help="a fresh agent's CLI (default: the run's mode, or agy); copilot runs headless, read-only")
    p.add_argument("--model", help="a fresh agent's model (default: auto), or a resumed worker's")
    p.add_argument("--effort", choices=EFFORTS,
                   help=f"default: the size's, or {REVIEW_EFFORT} for a fresh reviewer (not Copilot)")
    p.add_argument("--name", help="what goes after the repo in a fresh agent's name (default: ask-<question>)")
    p.add_argument("--size", choices=SIZES, help="a fresh agent's size (see `mesh spawn --size`)")
    p.add_argument("--view", choices=VIEWS, help="a fresh or resumed agent's view")
    compact_args(p)
    p.add_argument("--no-wait", action="store_true", help="return once the task is delivered")
    p.add_argument("--keep", action="store_true",
                   help="leave the agent open after its answer (default: an agent this call opened is closed)")
    p.add_argument("--wait", action="store_true",
                   help="wait even for a Claude worker under a Claude root, whose answer comes by SendMessage")
    p.add_argument("--timeout", type=int, default=1800, help="seconds to wait for the answer (0 = none)")
    p.add_argument("--peers", metavar="all|GROUP|NAMES",
                   help="ask the peer askers at once (all, a group, or a comma list): one combined answer file")
    p.add_argument("--no-refresh", action="store_true", help="don't fetch a peer's upstream first")
    p.set_defaults(func=cmd_ask)

    p = ident(sub.add_parser("peers", help="the standing peer askers: list, add, refresh, remove"))
    p.add_argument("action", nargs="?", choices=("list", "add", "edit", "refresh", "remove"), default="list")
    p.add_argument("targets", nargs="*", help="add: a git URL or a clone's path; edit: a peer or a group; "
                                              "refresh, remove: peer names")
    p.add_argument("--about", help=f"add, edit: what the project (or group) is and what to ask it, at most "
                                   f"{ABOUT_MAX} characters (add's default: its GitHub description)")
    p.add_argument("--name", help="add: the asker's name (default: <repo>-research)")
    p.add_argument("--group", help="add, edit: a group to ask together (`mesh ask --peers <group>`; default: peers); "
                                   "a URL is cloned into $MESH_PEERS_DIR/<group> (default ~/research)")
    p.add_argument("--kind", choices=KINDS, help="add: a new asker's CLI (default: claude)")
    p.add_argument("--body", help="add: its first research brief, asked at once")
    p.add_argument("--file", help="add: the brief from a file (- for stdin)")
    p.add_argument("--size", choices=SIZES, help="add: the brief's size (default: large)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_peers)

    p = ident(sub.add_parser("worktree", help="create a run worktree, e.g. for integration"))
    p.add_argument("--repo", default=".")
    p.add_argument("--slug", required=True)
    p.add_argument("--base")
    p.set_defaults(func=cmd_worktree)

    p = ident(sub.add_parser("conflicts", help="which of the run's branches conflict with their base or each other, and which workers share files"))
    p.add_argument("run_id", nargs="?")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_conflicts)

    p = ident(sub.add_parser("stop", help="close the run's panes, remove clean worktrees, archive"))
    p.add_argument("run_id", nargs="?")
    p.add_argument("--keep-worktrees", action="store_true")
    p.set_defaults(func=cmd_stop)

    p = ident(sub.add_parser("whoami", help="this agent's run, name, role and parent"))
    p.add_argument("--reminder", nargs="?", const="manual", metavar="SOURCE",
                   help="print a reminder of who you are, your phase and your task instead (a SessionStart hook "
                        "passes compact, clear or resume)")
    p.set_defaults(func=cmd_whoami)
    p = ident(sub.add_parser("hook", help="a Claude worker's hook (Claude Code runs it)"))
    p.add_argument("event", choices=("stop",))
    p.set_defaults(func=cmd_hook)
    ident(sub.add_parser("dir", help="print the run directory")).set_defaults(func=cmd_dir)

    p = ident(sub.add_parser("reset", help="root only: once your turn ends, clear your own pane and point the "
                                           "fresh session at `mesh brief`"))
    p.add_argument("--next", help="what the fresh session does after `mesh brief` (default: the next step in "
                                  "notes.md)")
    p.add_argument("--compact", nargs="?", const="", metavar="FOCUS",
                   help="type /compact [FOCUS] instead of /clear: for a root with its own repo's work in flight")
    p.add_argument("--detached", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--via", default="command", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_reset)

    p = ident(sub.add_parser("brief", help="one bounded view of the run for a fresh root: request, notes, board, "
                                           "workers, PRs, unread mail"))
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_brief)

    p = sub.add_parser("model", help="resolve the model a spawn would use")
    p.add_argument("--kind", choices=KINDS, default="agy")
    p.add_argument("--model", help="default: auto")
    p.add_argument("--effort", default=DEFAULT_EFFORT, choices=EFFORTS)
    p.set_defaults(func=cmd_model)

    p = sub.add_parser("usage", help="agy quotas, and the models `auto` would plan and execute on")
    p.add_argument("--effort", default=DEFAULT_EFFORT, choices=EFFORTS, help="planning effort")
    p.add_argument("--exec-effort", default=EXEC_EFFORT, choices=EFFORTS)
    p.add_argument("--refresh", action="store_true", help="skip the 5-minute cache")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_usage)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except MeshError as exc:
        print(f"mesh: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
