# Folder-trust dialogs shown by agy and Claude Code on a first visit to a directory.
TRUST_PROMPT_RE = re.compile(
    r"trust (the contents of this project|the files in this folder|this folder)", re.IGNORECASE
)
TRUST_OPTION_RE = re.compile(r"^\s*[❯>]?\s*(Yes|No)\b")


class MeshError(Exception):
    """A user-facing failure: printed without a traceback, exit status 1."""


class PaneRefused(MeshError):
    """This session isn't the agent its pane maps to: it gets this error, never a run of its own."""


class SwapNotStarted(MeshError):
    """A model swap that stopped before touching the worker: it still runs, on its old model."""


class HerdrError(MeshError):
    def __init__(self, code: str, message: str):
        super().__init__(f"herdr {code}: {message}")
        self.code = code
        self.message = message


# ── paths ────────────────────────────────────────────────────────────────


def mesh_home() -> Path:
    return Path(os.environ.get("MESH_HOME") or Path.home() / ".local/state/agent-mesh")


def worktree_root() -> Path:
    return Path(os.environ.get("MESH_WORKTREES") or Path.home() / ".local/share/agent-mesh/worktrees")


def run_dir(run_id: str) -> Path:
    return mesh_home() / run_id


def inbox_dir(run_id: str, name: str) -> Path:
    return run_dir(run_id) / "inbox" / name


def pane_key(pane_id: str) -> str:
    return pane_id.replace(":", "_")


# ── subprocess helpers ───────────────────────────────────────────────────


def herdr(*args: str, timeout: float | None = None) -> dict:
    """Run a herdr CLI command and return its JSON `result`."""
    binary = os.environ.get("MESH_HERDR") or "herdr"
    try:
        proc = subprocess.run([binary, *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        raise HerdrError("timeout", f"{' '.join(args[:2])} timed out") from exc
    except FileNotFoundError as exc:
        raise MeshError(f"herdr not found ({binary}); mesh must run inside herdr") from exc
    if proc.returncode != 0:
        raw = (proc.stderr or proc.stdout).strip()
        try:
            err = json.loads(raw)["error"]
            raise HerdrError(err.get("code", "error"), err.get("message", ""))
        except (ValueError, KeyError, TypeError):
            raise HerdrError("cli_error", raw) from None
    out = proc.stdout.strip()
    return json.loads(out).get("result", {}) if out else {}


def git(*args: str, cwd: str | Path) -> str:
    proc = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if proc.returncode != 0:
        raise MeshError(f"git {' '.join(args)}: {proc.stderr.strip()}")
    return proc.stdout.strip()


def run_cli(argv: list[str], cwd: str | Path | None = None, env: dict[str, str] | None = None,
            timeout: float | None = 120, input: str | None = None) -> subprocess.CompletedProcess:
    """Run an agent CLI (`claude`, `agy`, `copilot`) to completion; one that can't start or times out is a failed run."""
    try:
        return subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True, timeout=timeout, input=input)
    except FileNotFoundError:
        return subprocess.CompletedProcess(argv, 127, "", f"{argv[0]} not found")
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "", f"{argv[0]} timed out after {timeout:.0f}s")
    except OSError as exc:  # e.g. an argument over the kernel's per-argument limit
        return subprocess.CompletedProcess(argv, 126, "", f"{argv[0]} could not start: {exc}")


def claude_bin() -> str:
    return os.environ.get("MESH_CLAUDE") or "claude"


def claude_agents() -> list[dict]:
    """Claude Code's own session list (`claude agents --json --all`): background sessions carry a `status`
    (busy / idle / waiting) while their process runs, and keep their entry after they exit."""
    proc = run_cli([claude_bin(), "agents", "--json", "--all"], env=claude_env(), timeout=30)
    try:
        rows = json.loads(proc.stdout) if proc.returncode == 0 else []
    except ValueError:
        return []
    return rows if isinstance(rows, list) else []


def parent_pid(pid: int) -> int:
    try:
        return int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def socket_address(pid: int | None) -> str | None:
    """The cross-session address (`uds:…/cc-socks/<pid>.sock`) of a running Claude Code process, if it has one."""
    if not pid:
        return None
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    sock = Path(os.environ.get("MESH_CC_SOCKS") or Path(runtime) / "cc-socks") / f"{pid}.sock"
    return f"uds:{sock}" if sock.exists() else None


def claude_pid() -> int | None:
    """The pid of the Claude Code process this command runs under, which Claude Code gives its tools."""
    try:
        return int(os.environ.get("CLAUDE_PID") or 0) or None
    except ValueError:
        return None


def claude_address() -> str | None:
    """The cross-session address of the Claude Code session this command runs under.

    Session names change as Claude retitles a conversation, so other sessions reach it by this socket, which
    belongs to the process. That's `CLAUDE_PID`'s; without it, the first socket up the process tree, where a
    stale one left at a reused pid could come first. None outside Claude Code (an agy root) or where /proc
    can't be walked.
    """
    if pid := claude_pid():
        return socket_address(pid)
    pid = os.getpid()
    for _ in range(16):
        if pid <= 1:
            break
        if address := socket_address(pid):
            return address
        pid = parent_pid(pid)
    return None


def address_alive(address: str | None) -> bool:
    return bool(address) and (not address.startswith("uds:") or Path(address[4:]).exists())


# ── run state ────────────────────────────────────────────────────────────


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


@contextmanager
def file_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def run_lock(run_id: str):
    return file_lock(run_dir(run_id) / ".lock")


def load_run(run_id: str) -> dict:
    path = run_dir(run_id) / "run.json"
    if not path.exists():
        raise MeshError(f"unknown run {run_id} (no {path})")
    return json.loads(path.read_text())


def save_run(run_id: str, data: dict) -> None:
    write_atomic(run_dir(run_id) / "run.json", json.dumps(data, indent=2) + "\n")


@contextmanager
def editing_run(run_id: str):
    """Load run.json under the run lock, yield it for changes, save it."""
    with run_lock(run_id):
        data = load_run(run_id)
        yield data
        save_run(run_id, data)


def log_event(run_id: str, event: str, **fields) -> None:
    line = json.dumps({"time": now_iso(), "event": event, **fields})
    with open(run_dir(run_id) / "log.jsonl", "a") as fh:
        fh.write(line + "\n")


def read_log(run_id: str) -> list[dict]:
    path = run_dir(run_id) / "log.jsonl"
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


# ── identity ─────────────────────────────────────────────────────────────


def identity(args: argparse.Namespace) -> tuple[str, str]:
    """Return (run_id, own agent name) from flags, the environment or the pane map."""
    flag_run, flag_name = getattr(args, "run", None), getattr(args, "as_", None)
    run_id = flag_run or os.environ.get("MESH_RUN")
    name = flag_name or os.environ.get("MESH_SELF")
    run, ignored, refused = None, None, False
    if run_id and name and not flag_name:  # a name you pass is taken as given
        run = maybe_run(run_id)
        if ignored := inherited_identity(run_id, name, run):
            run_id, name, run = None, None, None
    if not (run_id and name):
        pane = os.environ.get("HERDR_PANE_ID")
        mapping = mesh_home() / "by-pane" / f"{pane_key(pane)}.json" if pane else None
        if mapping and mapping.exists():
            entry = json.loads(mapping.read_text())
            if foreign := foreign_to_pane(entry["run"], entry["name"], pane):
                ignored, refused = f"{ignored}; {foreign}" if ignored else foreign, True
            elif ignored:  # this pane's identity, all of it, or none
                if flag_run and flag_run != entry["run"]:
                    raise MeshError(f"{ignored}; this pane is {entry['name']} of run {entry['run']}, "
                                    f"not of run {flag_run}")
                run_id, name = entry["run"], entry["name"]
                print(f"mesh: {ignored}; acting as {name}, this pane's agent", file=sys.stderr)
                log_event(run_id, "identity_ignored", name=name, reason=ignored)
            else:
                run_id = run_id or entry["run"]
                name = name or entry["name"]
    if not (run_id and name):
        error = PaneRefused if refused else MeshError
        raise error(f"not in a mesh run{f' ({ignored})' if ignored else ''}: run `mesh init` first, or pass "
                    "--run and --as (`mesh agents` lists past and present workers, `mesh status --run <id>` "
                    "shows a run's agents)")
    refresh_root_address(run_id, name, run)
    return run_id, name


def maybe_run(run_id: str) -> dict | None:
    try:
        return load_run(run_id)
    except (MeshError, OSError, ValueError):
        return None


# A launch records its new session when it returns; past this, a `starting` entry is a launch that failed.
STARTING_GRACE = 300


def inherited_identity(run_id: str, name: str, run: dict | None) -> str | None:
    """Why the MESH_RUN / MESH_SELF in the environment aren't this session's, or None if they may be.

    A process can inherit another agent's identity: a background session runs in a spare process forked with
    whatever environment started Claude Code's daemon (see `bg_settings`), and the daemon can outlive the run.
    Claude Code tells its tools which session they run in, and a Claude worker's entry records its session, so
    a mismatch gives it away, except while a launch is recording a new one (`starting`). A pane worker's
    session can change legitimately (`/clear`, plan mode's "clear context"): when this session's process is the
    one running in the pane (`pane_runs_this_claude`), the entry is brought up to date.
    """
    current = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not current:
        return None
    if run is None:
        if (run_dir(run_id) / "run.json").exists():
            return None  # unreadable right now: not evidence either way
        return f"ignored MESH_RUN={run_id}: no such run (stopped?)"
    entry = run["agents"].get(name) or {}
    if entry.get("kind") and entry["kind"] != "claude":  # a Claude session is never an agy or Copilot agent
        return (f"ignored MESH_SELF={name} of run {run_id}: that agent is {entry['kind']}, and this is "
                f"Claude session {current}")
    recorded = entry.get("session")
    if not recorded or recorded == current:
        return None
    if entry.get("status") == "starting" and seconds_since(last_launch(entry)) < STARTING_GRACE:
        return None
    if entry.get("pane") and entry["pane"] == os.environ.get("HERDR_PANE_ID"):
        in_pane = pane_runs_this_claude(entry["pane"])
        if in_pane is None:
            return None  # herdr can't say: trust the pane
        if in_pane:
            with editing_run(run_id) as data:
                data["agents"][name]["session"] = current
            log_event(run_id, "rebind", name=name, session=current)
            entry["session"] = current
            return None
    return (f"ignored MESH_SELF={name} of run {run_id}: that agent is Claude session {recorded}, and this is "
            f"{current}, which inherited its environment (pass --run {run_id} --as {name} if it should act as "
            "that agent)")


def foreign_to_pane(run_id: str, name: str, pane: str) -> str | None:
    """Why this Claude session isn't the root that the pane map names for its pane, or None if it may be.

    Anything started in the root's pane carries its `HERDR_PANE_ID`: a background session whose daemon the user
    started there, or a Claude started by one of the root's tools. Only the pane's foreground process is the
    root (`pane_runs_this_claude`); when herdr can't say, the pane is trusted.
    """
    current = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not current:
        return None
    entry = ((maybe_run(run_id) or {}).get("agents") or {}).get(name) or {}
    if entry.get("kind") and entry["kind"] != "claude":
        return (f"pane {pane} is {name} of run {run_id}, which is {entry['kind']}, and this is "
                f"Claude session {current}")
    if pane_runs_this_claude(pane) is False:
        return (f"pane {pane} is {name} of run {run_id}, and Claude session {current} isn't the process running "
                f"there (pass --run {run_id} --as {name} if it should act as that agent; {NOT_LEADER_HINT})")
    return None


# Why a root's own Claude can fail `pane_runs_this_claude`: it doesn't lead the pane's foreground group.
NOT_LEADER_HINT = ("a launcher script that runs claude without `exec`, or tmux/zellij inside the pane, "
                   "puts another process there; use `exec claude` in the script")


def pane_runs_this_claude(pane: str) -> bool | None:
    """Whether this command's Claude process is the one running in the pane, or None if herdr can't say.

    herdr's `agent_session` can't tell: its hook reports whatever session starts with the pane's ids, and herdr
    takes a `resume`, `clear` or `compact` report from any of them (a nested `claude -c -p`, say). The kernel
    can: the pane's agent leads its foreground process group, while Claude runs each tool in a session of its
    own and background sessions run under its daemon. Members alone aren't enough, as MCP servers share it.
    """
    pid = claude_pid()
    if not pid:
        return None
    try:
        info = herdr("pane", "process-info", "--pane", pane, timeout=10).get("process_info") or {}
    except MeshError:
        return None
    if leader := info.get("foreground_process_group_id"):
        return leader == pid
    members = {p.get("pid") for p in info.get("foreground_processes") or []}
    return pid in members if members else None


def last_launch(entry: dict) -> str | None:
    """When the entry's session last (re)started: its spawn, or its latest model change."""
    times = [entry.get("spawned"), *(m.get("at") for m in entry.get("models") or [])]
    return max((t for t in times if t), default=None)


def seconds_since(iso: str | None) -> float:
    try:
        return (datetime.now(timezone.utc) - datetime.fromisoformat(iso)).total_seconds()
    except (TypeError, ValueError):
        return float("inf")


def refresh_root_address(run_id: str, name: str, run: dict | None = None) -> None:
    """Re-record a Claude root's socket when it was reopened: the socket belongs to the process, not the
    conversation, so a resumed root has a new one and its workers would otherwise ring its pane."""
    run = run or maybe_run(run_id)
    entry = (run or {}).get("agents", {}).get(name, {})
    if entry.get("role") != "root" or entry.get("kind") != "claude":
        return
    address = claude_address()
    if address and address != entry.get("address"):
        with editing_run(run_id) as data:
            data["agents"][name]["address"] = address
        log_event(run_id, "rebind", name=name, address=address)


def agent_name(repo: str, suffix: str, taken: set[str]) -> str:
    """A readable herdr name such as `shop-api-restocked-at`, made unique with -2, -3…"""
    suffix = slugify(suffix, 20)
    base = re.sub(r"^[^a-z]+", "", f"{slugify(repo, 32 - len(suffix) - 4)}-{suffix}") or "agent"
    name, n = base, 2
    while name in taken:
        name, n = f"{base}-{n}", n + 1
    return name


def live_agent_names() -> set[str]:
    """herdr names must be unique among live agents, including other runs' and your own."""
    return {a["name"] for a in herdr("agent", "list").get("agents", []) if a.get("name")}


def repo_name(path: str | None) -> str:
    if not path:
        return "agent"
    try:
        return Path(git("rev-parse", "--show-toplevel", cwd=path)).name
    except (MeshError, OSError):
        return Path(path).name or "agent"


def agent_entry(run: dict, name: str) -> dict:
    try:
        return run["agents"][name]
    except KeyError:
        raise MeshError(f"no agent {name} in run {run['id']}") from None


# ── herdr topology ───────────────────────────────────────────────────────


def inside(path: str | None, top: Path) -> bool:
    if not path:
        return False
    resolved = Path(path).resolve()
    return resolved == top or top in resolved.parents


def find_or_create_workspace(repo_top: Path) -> tuple[str, bool]:
    """The project's one herdr workspace: by label, then by a pane inside the repo, else a new one."""
    # Locked across runs, so two workers spawning at once can't both create one.
    with file_lock(mesh_home() / ".workspace.lock"):
        workspaces = herdr("workspace", "list").get("workspaces", [])
        for ws in workspaces:
            if (ws.get("label") or "").lower() == repo_top.name.lower():
                return ws["workspace_id"], False
        for ws in workspaces:
            panes = herdr("pane", "list", "--workspace", ws["workspace_id"]).get("panes", [])
            if any(inside(p.get("cwd"), repo_top) or inside(p.get("foreground_cwd"), repo_top) for p in panes):
                return ws["workspace_id"], False
        created = herdr("workspace", "create", "--cwd", str(repo_top), "--label", repo_top.name, "--no-focus")
        return created["workspace"]["workspace_id"], True


def env_flags(env: dict[str, str]) -> list[str]:
    flags: list[str] = []
    for key, value in env.items():
        flags += ["--env", f"{key}={value}"]
    return flags


def split_direction(rect: dict) -> str:
    # Terminal cells are roughly twice as tall as wide: split wide panes sideways.
    return "right" if rect["width"] >= 2.2 * rect["height"] else "down"


def tab_label(run: dict) -> str:
    """The run's tab: `mesh: add restockedAt to shop-api`, from the request's first words."""
    words, label = (run.get("request") or "").split(), ""
    for word in words:
        if len(label) + len(word) + 1 > 28:
            break
        label = f"{label} {word}".strip()
    return f"mesh: {label or (words[0][:28] if words else run['id'])}"


SIDE_PANES = 3  # workers beside the root before the rest go to the run's tab


def side_panes() -> int:
    return int(os.environ.get("MESH_SIDE_PANES") or SIDE_PANES)


def area(pane: dict) -> int:
    return pane["rect"]["width"] * pane["rect"]["height"]


def split_at(pane: dict, cwd: Path, env: dict[str, str]) -> str:
    """Split a pane from `pane layout`, along its longer side, and return the new pane."""
    split = herdr(
        "pane", "split", pane["pane_id"], "--direction", split_direction(pane["rect"]),
        "--cwd", str(cwd), *env_flags(env), "--no-focus",
    )
    return split["pane"]["pane_id"]


def beside_root(run_id: str, name: str, cwd: Path, env: dict[str, str],
                replacing: str | None = None) -> tuple[str, str, str] | None:
    """A pane in the root's own tab for agent `name`, so the user sees it next to the root; None when that tab is full.

    The first worker splits the root pane, later ones split the biggest worker pane, so the root keeps its half.
    A swap (`replacing` its old pane) splits that pane, so the worker reopens where it was whatever the count.
    Parallel `mesh` calls (reviewers started in one turn, a Copilot peek pane) would all count the same panes and
    split the same one, so counting, splitting and recording the new pane on `name` happen under one lock.
    """
    with file_lock(run_dir(run_id) / ".panes.lock"):
        beside = _beside_root(run_id, cwd, env, replacing)
        if beside:
            with editing_run(run_id) as run:
                entry = run["agents"][name]
                entry.update(pane=beside[0], tab=beside[1], workspace=beside[2])
                if entry.get("view") == "bg":  # a background launch that fell back to a pane
                    entry["view"] = "pane"
        return beside


def _beside_root(run_id: str, cwd: Path, env: dict[str, str], replacing: str | None) -> tuple[str, str, str] | None:
    run = load_run(run_id)
    root = run["agents"][run["root"]]
    tab = root.get("tab")
    if not (tab and root.get("pane") and root.get("workspace")):
        return None
    try:
        live = {p["pane_id"]: p for p in herdr("pane", "layout", "--pane", root["pane"])["layout"]["panes"]}
    except (HerdrError, KeyError):
        return None  # the root's tab is gone or unusable: use the run's tab
    if replacing:
        target = live.get(replacing)
    else:
        # Live panes only: a pane the user closed by hand frees its place.
        workers = [live[a["pane"]] for a in run["agents"].values()
                   if a["role"] != "root" and a.get("pane") in live and a.get("view") != "bg"
                   and a.get("status") != "retired"]
        if len(workers) >= side_panes():
            return None
        target = max(workers, key=area) if workers else live.get(root["pane"])
    if not target:
        return None
    try:
        return split_at(target, cwd, env), tab, root["workspace"]
    except HerdrError:
        return None


def place_pane(run_id: str, name: str, repo_top: Path, cwd: Path,
               env: dict[str, str]) -> tuple[str, str, str, bool]:
    """(pane, tab, workspace, workspace created) for a new worker pane: beside the root, else the run's tab."""
    if beside := beside_root(run_id, name, cwd, env):
        return *beside, False
    workspace_id, created_ws = find_or_create_workspace(repo_top)
    return *new_pane(run_id, workspace_id, cwd, env), workspace_id, created_ws


def new_pane(run_id: str, workspace_id: str, cwd: Path, env: dict[str, str]) -> tuple[str, str]:
    """A fresh shell pane for an agent, in this run's tab of the workspace."""
    run = load_run(run_id)
    tab_id = run.get("tabs", {}).get(workspace_id)
    if tab_id:
        anchor = next(
            (a["pane"] for a in run["agents"].values() if a.get("tab") == tab_id and a.get("status") != "retired"),
            None,
        )
        if anchor:
            try:
                return split_at(max(herdr("pane", "layout", "--pane", anchor)["layout"]["panes"], key=area),
                                cwd, env), tab_id
            except HerdrError:
                pass  # the tab is gone or unusable: open a new one below
    created = herdr(
        "tab", "create", "--workspace", workspace_id, "--cwd", str(cwd),
        "--label", tab_label(run), *env_flags(env), "--no-focus",
    )
    tab_id = created["tab"]["tab_id"]
    with editing_run(run_id) as run:
        run.setdefault("tabs", {})[workspace_id] = tab_id
    return created["root_pane"]["pane_id"], tab_id


def herdr_text(*args: str) -> str | None:
    """A herdr command whose output is plain text (e.g. `agent read`), or None if it failed or hung."""
    try:
        proc = subprocess.run([os.environ.get("MESH_HERDR") or "herdr", *args], capture_output=True, text=True,
                              timeout=HERDR_READ_TIMEOUT)
    except (subprocess.TimeoutExpired, OSError):
        return None
    return proc.stdout if proc.returncode == 0 else None


def pane_lines(target: str, lines: int = PANE_READ_LINES) -> list[str] | None:
    """The pane's recent lines, trailing blanks dropped; None if herdr can't read it (not the same as no lines)."""
    text = herdr_text("agent", "read", target, "--source", "recent", "--lines", str(lines))
    if text is None:
        return None
    rows = text.splitlines()
    while rows and not rows[-1].strip():
        rows.pop()
    return rows


def above_input_box(lines: list[str]) -> list[str]:
    """The lines above the agent's input box (a rule line with the prompt under it), so not what is typed in it.

    A panel can follow the box (agy's background tasks), so the box is found from the bottom, not by counting rules.
    No box found, no lines: what can't be told apart from the input box never confirms a doorbell.
    """
    for i in range(len(lines) - 2, -1, -1):
        if RULE_RE.match(lines[i]) and INPUT_RE.match(lines[i + 1]):
            return lines[:i]
    return []


def squeeze(text: str) -> str:
    return " ".join(text.split())


def doorbell_needle(text: str) -> str:
    return squeeze(text)[:DOORBELL_NEEDLE]


def doorbells_shown(target: str, needle: str) -> int | None:
    """Copies of the doorbell above the target's input box (wrapped lines joined), or None if it can't be read."""
    lines = pane_lines(target)
    if lines is None:
        return None
    return squeeze(" ".join(above_input_box(lines))).count(needle)


def pane_tail(target: str, count: int = ALERT_TAIL_LINES) -> str:
    """The pane's last non-empty lines, indented, for an alert; empty if it can't be read."""
    rows = [line.rstrip() for line in pane_lines(target, 40) or [] if line.strip()][-count:]
    return "\n".join("    " + (line if len(line) <= 160 else line[:159] + "…") for line in rows)


def trust_keys(screen: str) -> list[str] | None:
    """Keys that select "Yes, … trust" in a folder-trust dialog, or None if it isn't one.

    The CLIs differ: agy highlights "Yes" by default, Claude Code highlights "No, exit".
    """
    if not TRUST_PROMPT_RE.search(screen):
        return None
    options = [line.strip() for line in screen.splitlines() if TRUST_OPTION_RE.match(line)]
    yes = next((i for i, line in enumerate(options) if line.lstrip("❯> ").startswith("Yes")), None)
    cursor = next((i for i, line in enumerate(options) if line[0] in "❯>"), None)
    if yes is None or cursor is None:
        return None
    step = "down" if yes > cursor else "up"
    return [step] * abs(yes - cursor) + ["enter"]


def accept_trust_prompt(name: str) -> bool:
    """Accept a folder-trust dialog (a directory mesh chose); refuse any other startup prompt."""
    screen = herdr_text("agent", "read", name, "--source", "detection", "--lines", "40") or ""
    keys = trust_keys(screen)
    if keys is None:
        return False
    for key in keys:
        herdr("agent", "send-keys", name, key)
        time.sleep(0.3)
    herdr("agent", "wait", name, "--until", "idle", "--until", "done", "--timeout", "60000")
    time.sleep(3)  # the CLI redraws its welcome screen after the dialog; typing during it is lost
    return True


def start_agent(name: str, kind: str, pane: str, argv: list[str], attempts: int = 10) -> dict:
    """`herdr agent start`, retried while the new shell is still starting."""
    last: HerdrError | None = None
    for _ in range(attempts):
        try:
            return herdr("agent", "start", name, "--kind", kind, "--pane", pane, "--timeout", "120000", "--", *argv)
        except HerdrError as exc:
            if exc.code == "agent_not_ready":
                if accept_trust_prompt(name):
                    return {"trust_accepted": True}
                raise MeshError(
                    f"{name} started but is waiting at a startup prompt; "
                    f"inspect it with `herdr agent read {name}`"
                ) from exc
            last = exc
            time.sleep(1)
    raise MeshError(f"could not start {name}: {last}")


# ── background sessions ──────────────────────────────────────────────────

# `claude agents` status of a running background session, in herdr's words.
BG_STATUS = {"busy": "working", "idle": "idle", "waiting": "blocked"}


class BgUntrusted(MeshError):
    """`claude --bg` refuses a folder Claude Code was never trusted in (a worktree of a trusted repo is fine)."""


def bg_row(entry: dict, rows: list[dict] | None = None) -> dict | None:
    session = entry.get("session")
    if not session:
        return None
    rows = claude_agents() if rows is None else rows
    return next((r for r in rows if r.get("sessionId") == session), None)


def bg_status(entry: dict, rows: list[dict] | None = None) -> str:
    """working / idle / blocked while the session's process runs; gone once it has exited or been stopped."""
    row = bg_row(entry, rows)
    if not row or not row.get("status"):
        return "gone"
    return BG_STATUS.get(row["status"], "unknown")


MESH_IDS = ("MESH_RUN", "MESH_SELF", "MESH_PARENT", "MESH_ROLE")
HERDR_IDS = ("HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID")
# Every MESH_* variable mesh reads as configuration; an empty one counts as unset.
MESH_CONFIG = ("MESH_HOME", "MESH_WORKTREES", "MESH_HERDR", "MESH_CLAUDE", "MESH_CC_SOCKS", "MESH_SIDE_PANES",
               "MESH_MIN_QUOTA", "MESH_COMPACT_AT", "MESH_AGY_COMPACT_AT", "MESH_AGY_SUMMARIES",
               "MESH_AGY_HISTORY", "MESH_AGY_CONVERSATIONS", "MESH_COPILOT_MODEL")
# What Claude Code sets for the one session a process runs under (its tools inherit it): never pass it on.
CLAUDE_SESSION_VARS = ("CLAUDECODE", "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_CHILD_SESSION", "CLAUDE_CODE_SESSION_KIND",
                       "CLAUDE_CODE_SESSION_ATTENDED", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN",
                       "CLAUDE_PID", "CLAUDE_EFFORT", "CLAUDE_JOB_DIR", "CLAUDE_BG_BACKEND",
                       "CLAUDE_BG_SOCKET_TOKENS_PATH")


def env_without_identity(keep_herdr: bool) -> dict[str, str]:
    """This process's environment with no mesh identity. Without `keep_herdr` it also loses the pane's herdr ids,
    which `identity()` would otherwise map back to whoever owns this pane (the root)."""
    return {k: v for k, v in os.environ.items()
            if k not in MESH_IDS and (keep_herdr or k not in HERDR_IDS)}


def claude_env(strip_mesh: bool = False) -> dict[str, str]:
    """The environment for a `claude` CLI call. Any of them may start Claude Code's daemon, whose spare processes
    then run later background sessions with this environment, so it carries no mesh identity, no herdr pane ids
    and nothing of the calling Claude session; with `strip_mesh`, no MESH_* configuration either."""
    return {k: v for k, v in env_without_identity(keep_herdr=False).items()
            if k not in CLAUDE_SESSION_VARS and not (strip_mesh and k.startswith("MESH_"))}


def bg_settings(env: dict[str, str]) -> str:
    """`--settings` JSON that gives a background worker its environment.

    `claude --bg` runs the session in a spare process the daemon forked from its own environment, which is
    whoever's call started the daemon (an earlier worker, say), so the launch's own environment never reaches
    it. Settings `env` does, and overrides the spare's values, but can only set a variable: so every config
    key is set, empty when this launch has none, and the herdr ids are set empty, or a spare's stale values
    would stay (a pane id that `identity()` maps to its owner, another MESH_HOME).
    """
    return json.dumps({"env": {**{k: "" for k in (*MESH_CONFIG, *HERDR_IDS)}, **env}})


def launch_bg(name: str, cwd: str | Path, model: str, effort: str, env: dict[str, str], prompt: str,
              resume: str | None = None) -> tuple[str, str]:
    """Start a background Claude session and return (short id, session id).

    `--bg` picks its own session id. With `resume`, the flags make it start a *copy* of that conversation under
    a new id, which is what a resume needs: a copy gets this launch's model and settings (the identity, see
    `bg_settings`), while continuing the old id would bring back the options it was first started with.
    """
    argv = [claude_bin(), "--bg", *(["--resume", resume] if resume else []), "-n", name, "--model", model,
            "--effort", effort, "--settings", bg_settings(env), "--dangerously-skip-permissions", prompt]
    # No MESH_* in the process itself, so a daemon this launch starts, and its spares, carry none.
    proc = run_cli(argv, cwd=cwd, env=claude_env(strip_mesh=True), timeout=120)
    out = f"{proc.stdout}\n{proc.stderr}".strip()
    if "Workspace not trusted" in out:
        raise BgUntrusted(f"Claude Code doesn't trust {cwd} yet, so it can't run in the background there")
    started = BG_STARTED_RE.search(out)
    if proc.returncode != 0 or not started:
        raise MeshError(f"`claude --bg` did not start {name}: {out[:300]}")
    short = started.group(1)
    for _ in range(10):
        row = next((r for r in claude_agents() if r.get("id") == short), None)
        if row and row.get("sessionId"):
            return short, row["sessionId"]
        time.sleep(1)
    run_cli([claude_bin(), "stop", short], env=claude_env(), timeout=30)  # a stray session would do the task twice
    raise MeshError(f"{name} started as background session {short}, but `claude agents` doesn't list it")


def stop_bg(entry: dict) -> bool:
    """Stop a background worker's process; its conversation is kept (never `claude rm`)."""
    if not entry.get("bg_id"):
        return False
    return run_cli([claude_bin(), "stop", entry["bg_id"]], env=claude_env(), timeout=30).returncode == 0


def wait_bg_idle(entry: dict, wait_ms: int, strict: bool) -> None:
    """Wait for a background worker's turn to end, as `herdr agent wait --until idle` does for a pane."""
    deadline = time.monotonic() + wait_ms / 1000
    while True:
        state = bg_status(entry)
        if state in ("idle", "gone"):
            return
        if time.monotonic() > deadline:
            if strict:
                raise SwapNotStarted(f"background session {entry.get('bg_id')} is still {state}")
            return
        time.sleep(2)


# ── models ───────────────────────────────────────────────────────────────


def parse_agy_id(model_id: str) -> tuple[str, tuple[int, ...], str] | None:
    """(family, version, effort) of an agy model id, e.g. ("opus", (5, 5), "high")."""
    match = GEMINI_ID_RE.match(model_id)
    if match:
        version, family, effort = match.groups()
    else:
        match = CLAUDE_ID_RE.match(model_id)
        if not match:
            return None
        family, version, effort = match.groups()
    return family, tuple(int(part) for part in re.findall(r"\d+", version)), effort


def listing_names(listing: str) -> dict[str, str]:
    """Model id -> display name, from `agy models` output."""
    names = {}
    for line in listing.splitlines():
        model_id, _, display = line.partition("\t")
        if model_id.strip():
            names[model_id.strip()] = display.strip()
    return names


def pick_agy_model(listing: str, family: str, effort: str) -> str:
    """The newest `<family>` id with that effort in `agy models` output (argon, flash, opus, sonnet, ...)."""
    ids = list(listing_names(listing))
    if family in ids:
        return family
    candidates = []
    for model_id in ids:
        parsed = parse_agy_id(model_id)
        if parsed and parsed[0] == family and parsed[2] == effort:
            candidates.append((parsed[1], model_id))
    if not candidates:
        raise MeshError(f"no agy model matches family={family} effort={effort}; see `agy models`")
    return max(candidates)[1]


def agy_model_listing() -> str:
    """`agy models` output, cached: the command fetches over the network and can hang."""
    cache = mesh_home() / "agy-models.txt"
    if cache.exists() and time.time() - cache.stat().st_mtime < AGY_MODELS_TTL:
        return cache.read_text()
    try:
        proc = subprocess.run(["agy", "models"], capture_output=True, text=True, timeout=45)
        if proc.returncode == 0 and any(parse_agy_id(model_id) for model_id in listing_names(proc.stdout)):
            write_atomic(cache, proc.stdout)
            return proc.stdout
        problem = proc.stderr.strip() or "no models listed"
    except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
        problem = type(exc).__name__
    if cache.exists():
        return cache.read_text()  # stale, but far better than failing the spawn
    raise MeshError(f"`agy models` failed ({problem}) and there is no cached list; pass an exact --model id")


def resolve_agy_model(family: str, effort: str) -> str:
    if parse_agy_id(family):
        return family  # an exact id needs no listing
    return pick_agy_model(agy_model_listing(), family, effort)


def parse_usage(text: str) -> list[dict]:
    """Rows of `agy -p /usage`: group, label, percent left and reset time, tab-separated."""
    rows = []
    for line in text.splitlines():
        fields = [f.strip() for f in line.split("\t")]
        if len(fields) >= 4 and re.fullmatch(r"\d+%", fields[2]):
            rows.append({"group": fields[0], "label": fields[1], "left": int(fields[2][:-1]), "resets": fields[3]})
    return rows


def agy_usage(force: bool = False) -> list[dict] | None:
    """agy's quota rows, cached for a few minutes; None when they can't be read."""
    cache = mesh_home() / "agy-usage.txt"
    failed = mesh_home() / "agy-usage.failed"
    if not force and cache.exists() and time.time() - cache.stat().st_mtime < AGY_USAGE_TTL:
        return parse_usage(cache.read_text()) or None
    if not force and failed.exists() and time.time() - failed.stat().st_mtime < AGY_USAGE_RETRY:
        return None  # a spawn must not wait on a command that just failed
    cache.parent.mkdir(parents=True, exist_ok=True)
    try:
        proc = subprocess.run(
            ["agy", "-p", "/usage", "--print-timeout", "40s", "--dangerously-skip-permissions"],
            capture_output=True, text=True, timeout=45, cwd=cache.parent,
        )
        rows = parse_usage(proc.stdout)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        rows = []
    if rows:
        write_atomic(cache, proc.stdout)
        failed.unlink(missing_ok=True)
    else:
        failed.touch()
    return rows or None


def quota_applies(group: str, model_id: str, display: str) -> bool:
    """"Claude and GPT models" covers ids by vendor prefix; "Gemini 4 Argon" covers that model by name."""
    if group.lower().endswith(" models"):
        vendors = group[: -len(" models")].lower().split(" and ")
        return any(model_id.startswith(f"{vendor.strip()}-") for vendor in vendors)
    return display.lower().startswith(group.lower())


def model_quota(model_id: str, display: str, rows: list[dict]) -> tuple[int, str] | None:
    """The tightest limit on a model: (percent left, reset time), or None if no row covers it."""
    limits = [(r["left"], r["resets"]) for r in rows if quota_applies(r["group"], model_id, display)]
    return min(limits) if limits else None


def min_quota() -> int:
    return int(os.environ.get("MESH_MIN_QUOTA") or 10)


def choose_agy_model(chain: tuple[str, ...], effort: str, skip: tuple[str, ...] = (), force: bool = False,
                     fallback: bool = True) -> tuple[str, list[str]]:
    """The first model of the chain with at least MESH_MIN_QUOTA% left, and notes on the ones passed over.

    Unreadable quotas count as available. With nothing above the threshold, `fallback` takes the
    model with the most left; without it the notes (with reset times) become the error.
    """
    rows = agy_usage(force)
    names = listing_names(agy_model_listing()) if rows else {}
    notes: list[str] = []
    best: tuple[int, str] | None = None
    for family in chain:
        model_id = resolve_agy_model(family, effort)
        if model_id in skip:
            continue
        quota = model_quota(model_id, names.get(model_id, ""), rows) if rows else None
        if quota is None or quota[0] >= min_quota():
            return model_id, notes
        notes.append(f"{model_id} has {quota[0]}% left (resets {quota[1]})")
        if best is None or quota[0] > best[0]:
            best = (quota[0], model_id)
    if fallback and best:
        return best[1], notes + [f"every model is under {min_quota()}%; using {best[1]}"]
    raise MeshError("no model with quota left: " + ("; ".join(notes) or "every candidate was already tried"))


def agent_argv(kind: str, model: str, effort: str, log: str | None = None) -> tuple[list[str], str, str | None]:
    """Native CLI arguments, the resolved model and the session id (Claude only) for a new agent."""
    if kind == "agy":
        resolved = resolve_agy_model(model, effort)
        return [*log_argv(log), "--model", resolved, "--dangerously-skip-permissions"], resolved, None
    # Choosing the session id up front is what lets `mesh resume` find the conversation later.
    session = str(uuid.uuid4())
    argv = ["--session-id", session, "--model", model, "--effort", effort, "--dangerously-skip-permissions"]
    return argv, model, session


def log_argv(log: str | None) -> list[str]:
    """agy writes its own log; one per worker is how `mesh watch` sees a quota hit."""
    return ["--log-file", log] if log else []


def resolve_model(kind: str, model: str, effort: str) -> str:
    """The id to start an agent of this kind with: agy families are resolved, Claude aliases pass through."""
    return resolve_agy_model(model, effort) if kind == "agy" else model


def resume_argv(kind: str, session: str, model: str, effort: str) -> list[str]:
    """CLI arguments that reopen an agent's conversation (no permission flags)."""
    if kind == "agy":
        return ["--conversation", session, "--model", model]
    if kind == "copilot":
        return ["--resume", session, *copilot_model_argv(model, effort)]
    return ["--resume", session, "--model", model, "--effort", effort]


def resumed_model(entry: dict, model: str | None, effort: str | None) -> tuple[str, str]:
    """The model and effort a resumed agent runs on: what it had, unless overridden."""
    effort = effort or entry.get("effort") or DEFAULT_EFFORT
    if entry.get("kind") == "copilot":
        return model or entry.get("requested_model") or COPILOT_MODEL, effort
    if entry.get("kind") != "agy":
        return model or entry.get("model") or PLAN_CHAIN["claude"][0], effort
    if not model:
        parsed = parse_agy_id(entry.get("model") or "")
        if parsed and parsed[2] == effort:
            return entry["model"], effort  # the exact id it ran on; no listing needed
        model = parsed[0] if parsed else EXEC_MODEL["agy"]
    return resolve_agy_model(model, effort), effort


# ── sessions ─────────────────────────────────────────────────────────────


def first_doorbell(name: str) -> str:
    """How every first doorbell to an agent starts (see doorbell_text), without the emoji."""
    return f"You are {name} ("


@lru_cache(maxsize=4)
def agy_history(path: str, mtime: float) -> list[dict]:
    entries = []
    for line in Path(path).read_text(errors="replace").splitlines():
        try:
            entries.append(json.loads(line))
        except ValueError:
            continue
    return entries


@lru_cache(maxsize=4)
def agy_summaries(path: str, mtime: float) -> list[dict]:
    """agy's own index of its conversations: id, first prompt (`preview`) and workspace, oldest first.

    It has a conversation's id from its first prompt on, while history.jsonl only gets one with a later prompt.
    Opened read-only; agy keeps it in WAL mode, so reading never blocks it.
    """
    try:
        import sqlite3  # here, so a Python built without it only loses this lookup
    except ImportError:
        return []
    try:
        db = sqlite3.connect(f"{Path(path).resolve().as_uri()}?mode=ro", uri=True, timeout=2)
        try:
            # Top-level conversations only: agy's subagents (`nesting_depth` > 0) share the workspace.
            rows = db.execute("SELECT conversation_id, preview, workspace_uris FROM conversation_summaries "
                              "WHERE nesting_depth = 0 AND step_count > 0 ORDER BY last_modified_time").fetchall()
        finally:
            db.close()
    except (sqlite3.Error, ValueError):
        return []
    entries = []
    for conversation, preview, uris in rows:
        try:
            workspaces = [urllib.parse.unquote(urllib.parse.urlparse(uri).path) for uri in json.loads(uris)]
        except (ValueError, TypeError, AttributeError):
            workspaces = []
        entries.append({"conversationId": conversation, "display": preview or "", "workspaces": workspaces})
    return entries


def agy_conversation(name: str, run_id: str, cwd: str | None, pinned_only: bool = False) -> str | None:
    """agy's conversation id for an agent, from agy's conversation index, else the prompt history it keeps.

    The first doorbell names the agent and its run, so it pins the conversation even when
    a restart (`-2`) shares the worktree; the newest conversation in that directory is the fallback
    (not with `pinned_only`). agy sometimes replaces the index's first prompt with the conversation's
    title, which is why a worker's conversation is recorded once it first writes (see record_session).
    """
    home = Path.home() / AGY_HOME
    sources = ((os.environ.get("MESH_AGY_SUMMARIES") or home / "conversation_summaries.db", agy_summaries),
               (os.environ.get("MESH_AGY_HISTORY") or home / "history.jsonl", agy_history))
    run_re = re.compile(rf"\brun {re.escape(run_id)}\b")
    cwds = []
    for source, read in sources:
        path = Path(source)
        try:  # agy's db takes new rows in its write-ahead log first, so that file's mtime counts too
            mtime = max(f.stat().st_mtime for f in (path, path.with_name(path.name + "-wal")) if f.exists())
        except (OSError, ValueError):  # gone, or its log removed as we looked
            continue
        by_cwd = None
        for entry in read(str(path), mtime):
            conversation, display = entry.get("conversationId"), entry.get("display") or ""
            if not conversation:
                continue
            if display.startswith(f"📬 [mesh] {first_doorbell(name)}") and run_re.search(display):
                return conversation
            if cwd and cwd in entry.get("workspaces", [entry.get("workspace")]):
                by_cwd = conversation
        cwds.append(by_cwd)
    return None if pinned_only else next((c for c in cwds if c), None)


def claude_sessions_dir(cwd: str) -> Path:
    """Where Claude Code keeps the sessions it ran in `cwd`."""
    base = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
    return base / "projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd)


def claude_session(name: str, cwd: str) -> str | None:
    """A Claude session id for agents spawned before mesh chose ids: Claude keeps sessions per cwd."""
    folder = claude_sessions_dir(cwd)
    if not folder.is_dir():
        return None
    for path in sorted(folder.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True):
        if first_doorbell(name) in path.read_text(errors="replace"):
            return path.stem
    return None


def find_session(run_id: str, name: str, entry: dict) -> str | None:
    if entry.get("session"):
        return entry["session"]
    cwd = entry.get("cwd")
    if entry.get("kind") == "agy":
        # A main checkout is shared with the user's own sessions: there only the doorbell counts.
        shared = bool(cwd and entry.get("repo")) and Path(cwd).resolve() == Path(entry["repo"]).resolve()
        return agy_conversation(name, run_id, None if shared else cwd)
    return claude_session(name, cwd) if cwd else None


def context_tokens(entry: dict, session: str) -> int | None:
    """A worker's context size: the prompt of its last reply since its last compaction (0 right after one).

    None when its conversation file can't be read.
    """
    if entry.get("kind") == "agy":
        return agy_context_tokens(session)
    if not entry.get("cwd"):
        return None
    path = claude_sessions_dir(entry["cwd"]) / f"{session}.jsonl"
    if not path.exists():
        return None
    tokens = None
    with open(path, errors="replace") as fh:
        for line in fh:
            if '"compact_boundary"' not in line and '"usage"' not in line:
                continue
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if event.get("type") == "system" and event.get("subtype") == "compact_boundary":
                tokens = 0
            elif event.get("type") == "assistant" and (usage := (event.get("message") or {}).get("usage")):
                tokens = sum(int(usage.get(key) or 0) for key in
                             ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
    return tokens


AGY_COMPACTION_STEP = 23  # a step holding a compaction's <summary>: a `/compact`, or agy's own
AGY_STEP_DONE = 3  # a step's status once it has finished (tool steps that failed or were cancelled have others)


def protobuf_fields(blob: bytes) -> list[tuple[int, int | bytes]]:
    """(field number, value) of each field of one protobuf message: varints as ints, the rest as bytes.

    ValueError or IndexError when `blob` isn't one.
    """
    def varint(i: int) -> tuple[int, int]:
        n = shift = 0
        while True:
            byte = blob[i]
            n, i, shift = n | (byte & 0x7F) << shift, i + 1, shift + 7
            if not byte & 0x80:
                return n, i
    fields, i = [], 0
    while i < len(blob):
        key, i = varint(i)
        wire = key & 7
        if wire == 0:
            value, i = varint(i)
        elif wire in (1, 5):
            size = 8 if wire == 1 else 4
            value, i = blob[i:i + size], i + size
        elif wire == 2:
            size, i = varint(i)
            value, i = blob[i:i + size], i + size
        else:
            raise ValueError(f"protobuf wire type {wire}")
        if i > len(blob):
            raise ValueError("truncated protobuf")
        fields.append((key >> 3, value))
    return fields


def agy_context_tokens(session: str) -> int | None:
    """An agy conversation's context size: the prompt of its last model call since its last compaction.

    agy documents no format. Its conversation file is SQLite, and field 9 of a step's `metadata` protobuf is
    that call's usage: 2 the input read fresh, 5 the input read from cache, 3 the output. Checked against
    `agy -p --output-format json`, whose `usage` sums them over the whole conversation (so it can't tell
    the size). None when the file is missing or reads otherwise, and `--compact auto` falls back.
    """
    try:
        import sqlite3  # here, so a Python built without it only loses this reading
    except ImportError:
        return None
    base = os.environ.get("MESH_AGY_CONVERSATIONS") or Path.home() / AGY_HOME / "conversations"
    path = Path(base) / f"{session}.db"
    if not path.exists():
        return None
    try:
        db = sqlite3.connect(f"{path.resolve().as_uri()}?mode=ro", uri=True, timeout=2)
        try:
            # Newest first, read only as far as the first call or compaction.
            for step_type, status, metadata in db.execute("SELECT step_type, status, metadata FROM steps "
                                                          "ORDER BY idx DESC"):
                if step_type == AGY_COMPACTION_STEP and status == AGY_STEP_DONE:  # a failed one compacted nothing
                    return 0
                if not isinstance(metadata, bytes):
                    continue
                try:
                    usage = next((v for f, v in protobuf_fields(metadata) if f == 9 and isinstance(v, bytes)), b"")
                    counts = {f: v for f, v in protobuf_fields(usage) if isinstance(v, int)}
                except (ValueError, IndexError):
                    continue
                if 2 in counts:
                    return counts[2] + counts.get(5, 0)
        finally:
            db.close()
    except (sqlite3.Error, ValueError):
        return None
    return None


def compact_at(kind: str | None = None) -> int:
    key, default = ("MESH_AGY_COMPACT_AT", AGY_COMPACT_AT) if kind == "agy" else ("MESH_COMPACT_AT", COMPACT_AT)
    try:
        return int(os.environ.get(key) or default)
    except ValueError:
        return default


def should_compact(mode: str, entry: dict, tokens: int | None, read_only: bool, cross_run: bool) -> bool:
    """`--compact auto`: compact a conversation that a resume would otherwise re-read in full, turn after turn.

    An old conversation's prompt cache has expired, so every turn of the follow-up pays for its whole
    context. A question or two doesn't repay a compaction, so read-only tasks get twice the threshold.
    """
    if mode != "auto":
        return mode == "yes"
    if tokens is None and entry.get("kind") == "agy":
        return cross_run and not read_only  # no size to go on: compact what comes back from an earlier run
    return tokens is not None and tokens > compact_at(entry.get("kind")) * (2 if read_only else 1)


def compact_conversation(entry: dict, session: str, model: str, focus: str) -> tuple[bool, str]:
    """Compact a stopped worker's conversation headless, in its own directory, before it is reopened."""
    prompt = f"/compact {focus}"
    if entry.get("kind") == "agy":
        argv = ["agy", "--conversation", session, "--model", model, "--dangerously-skip-permissions", "-p", prompt]
    else:
        argv = [claude_bin(), "-p", "--resume", session, "--model", model, "--dangerously-skip-permissions", prompt]
    # No identity at all: the compaction turn must not message anyone, or pass for the root.
    proc = run_cli(argv, cwd=entry["cwd"], env=claude_env(), timeout=COMPACT_TIMEOUT)
    return proc.returncode == 0, (proc.stderr or proc.stdout).strip()[-300:]


# ── worktrees ────────────────────────────────────────────────────────────


def slugify(text: str, limit: int) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return slug[:limit].strip("-") or "x"


def default_base(repo_top: Path) -> str:
    try:
        return git("rev-parse", "--abbrev-ref", "origin/HEAD", cwd=repo_top)
    except MeshError:
        return "HEAD"


def add_worktree(run_id: str, repo_top: Path, slug: str, base: str | None) -> tuple[Path, str, str]:
    """A worktree on a new run branch; the base commit is kept so `mesh stop` can tell an untouched branch."""
    branch = f"mesh/{run_id}/{slug}"
    path = worktree_root() / run_id / f"{slugify(repo_top.name, 20)}-{slug}"
    sha = git("rev-parse", "--verify", f"{base or default_base(repo_top)}^{{commit}}", cwd=repo_top)
    path.parent.mkdir(parents=True, exist_ok=True)
    git("worktree", "add", "-b", branch, str(path), sha, cwd=repo_top)
    with editing_run(run_id) as run:
        run.setdefault("worktrees", []).append({"path": str(path), "repo": str(repo_top), "branch": branch, "base": sha})
    log_event(run_id, "worktree", path=str(path), branch=branch)
    return path, branch, sha


def entry_branch(run: dict, entry: dict) -> str | None:
    """An agent's branch; a restart with --cwd records none, so look its worktree up."""
    if entry.get("branch"):
        return entry["branch"]
    cwd = entry.get("cwd")
    return next((wt["branch"] for wt in run.get("worktrees", []) if cwd and Path(wt["path"]) == Path(cwd)), None)


def ensure_worktree(entry: dict, branch: str | None) -> bool:
    """Bring a removed worktree back at its old path, where Claude looks for the session. True if recreated."""
    path = Path(entry["cwd"])
    if path.exists():
        return False
    if not branch or not entry.get("repo"):
        raise MeshError(f"{path} is gone and no branch is recorded for it")
    try:
        git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", cwd=entry["repo"])
        new_branch = []
    except MeshError:
        if not entry.get("base"):
            raise MeshError(f"branch {branch} no longer exists in {entry['repo']}") from None
        new_branch = ["-b", branch]  # `mesh stop` deleted it because it had no commits: start it again at its base
    git("worktree", "prune", cwd=entry["repo"])
    path.parent.mkdir(parents=True, exist_ok=True)
    git("worktree", "add", *new_branch, str(path), *([entry["base"]] if new_branch else [branch]), cwd=entry["repo"])
    return True


# ── messaging ────────────────────────────────────────────────────────────


def preview(body: str, limit: int = 100) -> str:
    line = " ".join(body.split())
    return line if len(line) <= limit else line[: limit - 1] + "…"


def store_message(run_id: str, sender: str, to: str, mtype: str, body: str) -> Path:
    path = inbox_dir(run_id, to) / f"{stamp()}-{sender}-{mtype}.md"
    header = f"---\nrun: {run_id}\nfrom: {sender}\nto: {to}\ntype: {mtype}\ntime: {now_iso()}\n---\n"
    write_atomic(path, header + body.rstrip() + "\n")
    return path


def ring(targets: list[str], text: str, delays: tuple[int, ...] = RING_DELAYS) -> tuple[bool, str | None]:
    """Type the doorbell into the first reachable target, retrying while it is busy.

    herdr can miss that a busy agent queued the text (it returns stalled or timeout), so after those errors the
    pane is read, and a doorbell that showed up above the input box since the first try counts as delivered.
    A pane that couldn't be read before the first try is never checked: a later read would count old doorbells.
    """
    needle = doorbell_needle(text)
    before: dict[str, int | None] = {}  # doorbells already in each target's pane before it was first typed into
    last_error = None
    for delay in (0, *delays):
        if delay:
            time.sleep(delay)
        for target in targets:
            if target not in before:
                before[target] = doorbells_shown(target, needle)
            try:
                # --until working confirms delivery: an idle agent that doesn't start working
                # within 5s never got the text (agent_prompt_stalled), so it is retried. A busy
                # agent queues the doorbell for after its current turn, but herdr may not see it
                # as working (agy between steps, Claude running a command): hence the pane check.
                herdr("agent", "prompt", target, text, "--wait", "--until", "working", "--timeout", "15000",
                      timeout=30)
                return True, None
            except HerdrError as exc:
                last_error = exc.code
                if exc.code == "agent_not_found":
                    continue  # try the next target (the pane id)
                if exc.code in TYPED_RING_ERRORS and before[target] is not None:
                    shown = doorbells_shown(target, needle)
                    if shown is not None and shown > before[target]:
                        return True, None
                if exc.code not in RETRYABLE_RING_ERRORS:
                    return False, exc.code
                break
    return False, last_error


def doorbell_text(run: dict, sender: str, to: str, mtype: str, body: str, first: bool) -> str:
    if first:
        entry = run["agents"][to]
        if entry.get("swapped"):
            return (
                f"📬 [mesh] You are {to} ({entry['role']}) again in agent-mesh run {run['id']}, now on "
                f"{entry.get('model')} at {entry.get('effort')} effort; same parent and worktree. Run `mesh inbox` for your {mtype}."
            )
        if entry.get("resumed_from"):
            return (
                f"📬 [mesh] You are {to} ({entry['role']}) again, resumed into agent-mesh run {run['id']}; your "
                f"parent is {entry['parent']}. The run id, parent and paths changed, and background tasks from "
                f"before (`task-…` ids) are gone: re-read {PROTOCOL_PATH}, then run `mesh inbox` for your {mtype}."
            )
        return (
            f"📬 [mesh] You are {to} ({entry['role']}) in agent-mesh run {run['id']}; your parent is "
            f"{entry['parent']}. Read {PROTOCOL_PATH}, then run `mesh inbox` for your {mtype}."
        )
    return f"📬 [mesh] {mtype} from {sender}: {preview(body)} (run `mesh inbox`)"


def record(run_id: str, sender: str, to: str, mtype: str, body: str) -> Path:
    """Store a message in `to`'s mailbox and log it, without telling anyone."""
    path = store_message(run_id, sender, to, mtype, body)
    log_event(run_id, "send", sender=sender, to=to, type=mtype, file=path.name)
    return path


def native_route(run: dict, sender: str, to: str) -> str | None:
    """The address a Claude sender passes to SendMessage instead of ringing `to`'s pane, or None to ring it.

    Claude to Claude only: a worker reaches a Claude root by its socket, so nothing is typed into the pane the
    user works in, and a background worker, which has no pane, is reached by its own socket while it runs.
    """
    if run["agents"].get(sender, {}).get("kind") != "claude":
        return None
    entry = run["agents"][to]
    if entry.get("role") == "root":
        return entry["address"] if address_alive(entry.get("address")) else None
    if entry.get("view") == "bg":
        row = bg_row(entry)
        if row and row.get("status"):
            return socket_address(row.get("pid")) or to
    return None


def delivered(delivery: dict) -> bool:
    """Rung, handed back as a SendMessage, or the opening prompt of a background session (`launched`)."""
    return bool(delivery.get("rung") or "send_message" in delivery or delivery.get("launched"))


def refuse_headless(name: str, entry: dict, what: str) -> None:
    """A Copilot asker has no pane, mailbox reader or model swap: only `mesh ask` reaches it."""
    if entry.get("view") == "headless":
        raise MeshError(f"{name} is a headless Copilot asker, which {what} doesn't reach: "
                        f"ask it again with `mesh ask {name} --body …`")


def deliver(run_id: str, sender: str, to: str, mtype: str, body: str, first: bool = False,
            stored=None, delays: tuple[int, ...] = RING_DELAYS) -> dict:
    """Store the message, then ring `to`'s doorbell, or hand back the SendMessage that tells it (`send_message`).

    `stored()` runs between the two: what the recipient may act on must be recorded before it hears.
    """
    run = load_run(run_id)
    entry = agent_entry(run, to)
    refuse_headless(to, entry, f"a `{mtype}` message")
    path = record(run_id, sender, to, mtype, body)
    if stored:
        stored()
        run = load_run(run_id)
    first = first or bool(entry.get("swapped"))  # until a doorbell rings, the worker hasn't heard it was reopened
    text = doorbell_text(run, sender, to, mtype, body, first)
    route = native_route(run, sender, to)
    if route:
        log_event(run_id, "native", sender=sender, to=to, address=route, file=path.name)
        return {"stored": str(path), "rung": False, "error": None, "send_message": {"to": route, "message": text}}
    if entry.get("view") == "bg":
        error = f"{to} is not running; `mesh resume {to}` brings it back to read it"
        log_event(run_id, "doorbell_failed", sender=sender, to=to, file=path.name, error=error)
        return {"stored": str(path), "rung": False, "error": error}
    targets = [to] + ([entry["pane"]] if entry.get("pane") else [])
    rung, error = ring(targets, text, delays)
    if rung and entry.get("swapped"):
        with editing_run(run_id) as run:
            run["agents"][to].pop("swapped", None)
    if not rung:
        log_event(run_id, "doorbell_failed", sender=sender, to=to, file=path.name, error=error)
    return {"stored": str(path), "rung": rung, "error": error}


def unread(run_id: str, name: str) -> list[Path]:
    folder = inbox_dir(run_id, name)
    return sorted(p for p in folder.glob("*.md")) if folder.exists() else []


def mark_read(path: Path) -> None:
    read = path.parent / "read"
    read.mkdir(parents=True, exist_ok=True)
    os.replace(path, read / path.name)


def parse_message(path: Path) -> tuple[dict, str]:
    text = path.read_text()
    meta: dict[str, str] = {}
    body = text
    if text.startswith("---\n"):
        head, _, body = text[4:].partition("\n---\n")
        for line in head.splitlines():
            key, _, value = line.partition(": ")
            meta[key] = value
    return meta, body


# ── commands ─────────────────────────────────────────────────────────────


def emit(data, as_json: bool = True) -> None:
    print(json.dumps(data, indent=2) if as_json else data)


def init_run(mode: str | None, request: str | None, run_id: str | None = None) -> dict:
    """Start a run with this pane's agent as its root (mode None: the root's own CLI)."""
    pane = os.environ.get("HERDR_PANE_ID")
    if os.environ.get("HERDR_ENV") != "1" or not pane:
        raise MeshError("mesh init must run inside a herdr pane (HERDR_ENV=1)")
    run_id = run_id or "m" + secrets.token_hex(2)
    if not NAME_RE.match(run_id) or len(run_id) > 12:
        raise MeshError("run id must be short, lowercase, start with a letter")
    if run_dir(run_id).exists():
        raise MeshError(f"run {run_id} already exists")
    agents = herdr("agent", "list").get("agents", [])
    me = next((a for a in agents if a.get("pane_id") == pane), None)
    if me is None:
        raise MeshError(f"herdr sees no agent in pane {pane}")
    if os.environ.get("CLAUDE_CODE_SESSION_ID") and pane_runs_this_claude(pane) is False:
        raise MeshError(f"Claude session {os.environ['CLAUDE_CODE_SESSION_ID']} isn't the process running in pane "
                        f"{pane}, so it can't be its root ({NOT_LEADER_HINT})")
    mode = mode or (me.get("agent") if me.get("agent") in MODES else "agy")
    # A root you already named keeps its name; otherwise it becomes `<repo>-lead`.
    name = me.get("name") or agent_name(repo_name(me.get("cwd")), "lead", {a["name"] for a in agents if a.get("name")})
    if name != me.get("name"):
        herdr("agent", "rename", pane, name)
    run = {
        "id": run_id,
        "version": VERSION,
        "mode": mode,
        "created": now_iso(),
        "root": name,
        "request": request or "",
        "agents": {
            name: {
                "role": "root",
                "kind": me.get("agent"),
                "pane": pane,
                "tab": me.get("tab_id"),
                "workspace": me.get("workspace_id"),
                "cwd": me.get("cwd"),
                "parent": None,
                "status": "running",
                "renamed": name != me.get("name"),
                # Claude workers report to a Claude root with SendMessage, at this address (see native_route).
                "address": claude_address() if me.get("agent") == "claude" else None,
            }
        },
        "tabs": {},
        "worktrees": [],
    }
    with run_lock(run_id):
        save_run(run_id, run)
    write_atomic(mesh_home() / "by-pane" / f"{pane_key(pane)}.json", json.dumps({"run": run_id, "name": name}))
    log_event(run_id, "init", name=name, mode=mode)
    return {"run": run_id, "name": name, "dir": str(run_dir(run_id)), "mode": mode,
            "address": run["agents"][name]["address"]}


def cmd_init(args: argparse.Namespace) -> int:
    emit(init_run(args.mode, args.request, args.run_id))
    return 0


def spawn_suffix(args: argparse.Namespace, run: dict) -> str:
    """A worker is named for its worktree slug, so the name says what it works on."""
    if args.name:
        return args.name
    if args.worktree:
        return args.worktree
    if args.cwd:  # a restart in an earlier worker's worktree: reuse its slug (agent_name adds -2)
        cwd = Path(args.cwd).expanduser().resolve()
        for wt in run.get("worktrees", []):
            if Path(wt["path"]).resolve() == cwd:
                return wt["branch"].rsplit("/", 1)[-1]
    return f"worker{sum(a['role'] == 'worker' for a in run['agents'].values()) + 1}"


def worker_log(run_id: str, name: str) -> str:
    """Where an agy worker's log goes (`mesh watch` reads quota errors from it)."""
    path = run_dir(run_id) / "logs" / f"{name}.log"
    path.parent.mkdir(parents=True, exist_ok=True)
    return str(path)


def mesh_env(run_id: str, name: str, parent: str, role: str) -> dict[str, str]:
    """A worker's identity, and the configuration this process runs with (only the keys that are set)."""
    env = {"MESH_RUN": run_id, "MESH_SELF": name, "MESH_PARENT": parent, "MESH_ROLE": role}
    env.update({key: os.environ[key] for key in MESH_CONFIG if os.environ.get(key)})
    return env


def cmd_spawn(args: argparse.Namespace) -> int:
    emit(spawn_worker(args, *identity(args)))
    return 0


def spawn_worker(args: argparse.Namespace, run_id: str, me: str) -> dict:
    repo_top = Path(git("rev-parse", "--show-toplevel", cwd=Path(args.repo).expanduser())).resolve()
    run = load_run(run_id)
    name = agent_name(repo_top.name, spawn_suffix(args, run), set(run["agents"]) | live_agent_names())

    # Resolve the model before any side effect, so a failed lookup leaves no orphan worktree.
    size = getattr(args, "size", None) or "large"
    sized = SIZE_DEFAULTS.get((args.kind, size))
    user_review = getattr(args, "plan_review", None) == "user"
    if (sized or user_review) and (args.exec_model or args.exec_effort):
        raise MeshError(f"a {'user-reviewed' if user_review else size} task has no execution phase: "
                        "drop --exec-model / --exec-effort")
    if user_review and (args.kind != "claude" or sized):
        raise MeshError("--plan-review user is for a large Claude task (Opus in plan mode, in a pane)")
    named = args.model if args.model != "auto" else None  # `auto` names the plan chain, which these tasks skip
    if sized:  # one model for the whole task, and no plan phase
        auto, exec_model, exec_effort = False, None, None
        model, effort, notes = named or sized["model"], args.effort or sized["effort"], []
    elif user_review:  # Claude Code leaves plan mode when the user approves the plan, on the same model
        auto, exec_model, exec_effort = False, None, None
        model, effort, notes = named or USER_REVIEW_MODEL, args.effort or DEFAULT_EFFORT, []
    else:
        # `auto` plans on the best model with quota and switches to the exec model at `mesh approve`.
        auto = (args.model or "auto") == "auto"
        exec_model = args.exec_model or (EXEC_MODEL[args.kind] if auto else None)
        if args.exec_effort and not exec_model:
            raise MeshError("--exec-effort needs an execution phase: drop --model, or add --exec-model")
        # A named --effort covers the whole task; --exec-effort alone overrides the execution phase.
        effort = args.effort or DEFAULT_EFFORT
        exec_effort = (args.exec_effort or args.effort or EXEC_EFFORT) if exec_model else None
        if exec_model:
            resolve_model(args.kind, exec_model, exec_effort)  # fail now, not after a whole planning phase
        model, notes = plan_model(args.kind, effort) if auto else (args.model, [])
    view = getattr(args, "view", None) or (sized["view"] if sized else "pane")
    if view == "bg" and (args.kind != "claude" or user_review):
        if getattr(args, "view", None):
            raise MeshError("--view bg is for Claude workers (agy has no background sessions; a user-reviewed "
                            "plan needs a pane)")
        view = "pane"
    if view == "bg" and not address_alive(run["agents"][run["root"]].get("address")):
        notes.append("background needs a Claude root that background workers can message; starting a pane")
        view = "pane"
    # A named model or effort with no exec phase covers the whole task, a later one included (has_phases).
    # `mesh ask` says itself whether its effort was named (a sized reviewer's REVIEW_EFFORT isn't).
    pinned = getattr(args, "pinned", None)
    pinned = not exec_model and bool(named or args.effort if pinned is None else pinned)
    log = worker_log(run_id, name) if args.kind == "agy" else None
    argv, model, session = agent_argv(args.kind, model, effort, log)
    if user_review:
        argv = [a for a in argv if a != "--dangerously-skip-permissions"]
        argv += ["--permission-mode", "plan", "--allow-dangerously-skip-permissions"]
    branch = base = None
    if args.worktree:
        cwd, branch, base = add_worktree(run_id, repo_top, slugify(args.worktree, 24), args.base)
    elif args.cwd:
        cwd = Path(args.cwd).expanduser().resolve()
    else:
        cwd = repo_top

    parent = args.parent or me
    task = read_body(args.task, args.task_file)
    if task and (sized or user_review) and not task.startswith(READ_ONLY_STARTS):
        task = f"{DIRECT_PREFIX if sized else USER_REVIEW_PREFIX}\n\n{task}"
    env = mesh_env(run_id, name, parent, args.role)
    with editing_run(run_id) as run:
        run["agents"][name] = {
            "role": args.role, "kind": args.kind, "model": model, "effort": effort, "size": size, "view": view,
            "plan_review": "user" if user_review else None, "pinned": pinned,
            "repo": str(repo_top), "cwd": str(cwd), "branch": branch, "base": base, "session": session, "pane": None,
            "tab": None, "workspace": None, "parent": parent, "status": "starting", "spawned": now_iso(),
            "log": log, "phase": "plan" if exec_model else None, "exec_model": exec_model, "exec_effort": exec_effort,
            "models": [{"model": model, "effort": effort, "at": now_iso(), "why": "spawn"}],
        }
    result = {"name": name, "cwd": str(cwd), "branch": branch, "model": model, "effort": effort, "size": size,
              "exec_model": exec_model, "notes": notes}

    task_path = None
    if view == "bg":
        # The task waits in the mailbox; the first doorbell is the session's opening prompt.
        task_path = record(run_id, me, name, "task", task) if task else None
        prompt = doorbell_text(load_run(run_id), me, name, "task", task or "", first=True)
        try:
            bg_id, session = launch_bg(name, cwd, model, effort, env, prompt)
        except MeshError as exc:  # untrusted folder, or a launch that didn't take
            notes.append(f"{exc}; starting a pane instead")
            view = "pane"
        else:
            with editing_run(run_id) as run:
                run["agents"][name].update(bg_id=bg_id, session=session, status="running")
            log_event(run_id, "spawn", name=name, kind=args.kind, role=args.role, model=model, view="bg",
                      bg_id=bg_id, parent=parent)
            result.update(view="bg", bg_id=bg_id, session=session)
            if task_path:
                result["delivery"] = {"stored": str(task_path), "rung": False, "error": None, "launched": True}
            return result

    pane, tab, workspace_id, created_ws = place_pane(run_id, name, repo_top, cwd, env)
    with editing_run(run_id) as run:
        run["agents"][name].update(view="pane", pane=pane, tab=tab, workspace=workspace_id)
    log_event(run_id, "spawn", name=name, kind=args.kind, role=args.role, model=model, pane=pane, parent=parent)

    start_agent(name, args.kind, pane, argv)
    with editing_run(run_id) as run:
        run["agents"][name]["status"] = "running"

    result.update(view="pane", pane=pane, workspace=workspace_id, workspace_created=created_ws)
    if task_path:  # stored before a background launch that fell back to this pane
        rung, error = ring([name, pane], doorbell_text(load_run(run_id), me, name, "task", task, first=True))
        result["delivery"] = {"stored": str(task_path), "rung": rung, "error": error}
    elif task:
        result["delivery"] = deliver(run_id, me, name, "task", task, first=True)
    return result


def plan_model(kind: str, effort: str) -> tuple[str, list[str]]:
    if kind == "agy":
        return choose_agy_model(PLAN_CHAIN["agy"], effort)
    return PLAN_CHAIN["claude"][0], []


def swap_bg(run_id: str, name: str, entry: dict, session: str, model: str, effort: str, why: str,
            wait_ms: int, strict: bool, message: tuple[str, str, str]) -> dict:
    """swap_model for a background worker: stop it, then start a copy of its conversation on the new model.

    The message goes into its mailbox first, since the copy's opening prompt is the doorbell for it.
    """
    wait_bg_idle(entry, wait_ms, strict)
    sender, mtype, body = message
    path = record(run_id, sender, name, mtype, body)
    with editing_run(run_id) as run:  # "starting" before the stop, so `mesh watch` doesn't take the gap for an exit
        e = run["agents"][name]
        e.update(model=model, effort=effort, status="starting", swapped=True)
        e.setdefault("models", []).append({"model": model, "effort": effort, "at": now_iso(), "why": why})
    stop_bg(entry)
    prompt = doorbell_text(load_run(run_id), sender, name, mtype, body, first=True)
    try:
        bg_id, new_session = launch_bg(name, entry["cwd"], model, effort,
                                       mesh_env(run_id, name, entry["parent"], entry["role"]), prompt, resume=session)
    except MeshError as exc:
        with editing_run(run_id) as run:
            e = run["agents"][name]
            e.update(model=entry.get("model"), effort=entry.get("effort"), status="swap_failed")
            e.pop("swapped", None)
            e["models"].pop()
        log_event(run_id, "swap_failed", name=name, model=model, effort=effort, error=str(exc))
        raise MeshError(f"{name} was not reopened on {model} ({exc}); its {mtype} is in its mailbox, retry") from exc
    with editing_run(run_id) as run:
        e = run["agents"][name]
        e.update(bg_id=bg_id, session=new_session, status="running")
        e.pop("swapped", None)
        e.setdefault("sessions", []).append(session)  # the conversation it was copied from
    log_event(run_id, "swap", name=name, model=model, effort=effort, why=why, bg_id=bg_id, session=new_session)
    return {"name": name, "model": model, "bg_id": bg_id, "previous": entry.get("model"),
            "delivery": {"stored": str(path), "rung": False, "error": None, "launched": True}}


def swap_model(run_id: str, name: str, model: str, effort: str, why: str, wait_ms: int = 600_000,
               strict: bool = True, message: tuple[str, str, str] | None = None) -> dict:
    """Restart a worker on another model or effort in the same conversation, pane by pane, keeping its name.

    Waits up to `wait_ms` for the worker's turn to end. `strict` fails if it doesn't; a worker that
    hit a quota is not strict, since its turn is already dead whatever herdr shows. A background worker
    gets `message` (sender, type, body) as its opening prompt (the result's `delivery`); for a pane the
    caller delivers it once the pane is back.
    """
    entry = agent_entry(load_run(run_id), name)
    refuse_headless(name, entry, "a model swap")
    session = find_session(run_id, name, entry)
    if not session:
        raise SwapNotStarted(f"can't find {name}'s {entry.get('kind')} conversation, so its model can't be switched; "
                             f"start a fresh worker with `mesh spawn --cwd {entry.get('cwd')}` if it must change")
    if entry.get("view") == "bg":
        return swap_bg(run_id, name, entry, session, model, effort, why, wait_ms, strict,
                       message or ("mesh", "info", f"You are now on {model} at {effort} effort."))
    try:  # never cut a turn short: the conversation is only safe to reopen between turns
        herdr("agent", "wait", name, "--until", "idle", "--until", "done", "--timeout", str(wait_ms),
              timeout=wait_ms / 1000 + 10)
    except HerdrError as exc:
        if exc.code != "agent_not_found" and (strict or exc.code not in ("timeout", "cli_error")):
            if exc.code == "timeout":
                raise SwapNotStarted(f"{name} didn't finish its turn ({exc})") from exc
            raise
    # The new pane opens beside the old one before that closes, so its tab survives: the root's, else the run's.
    env = mesh_env(run_id, name, entry["parent"], entry["role"])
    run = load_run(run_id)
    side = bool(entry.get("tab")) and entry["tab"] == run["agents"][run["root"]].get("tab")
    beside = side and beside_root(run_id, name, Path(entry["cwd"]), env, replacing=entry.get("pane"))
    if beside:
        pane, tab, workspace_id = beside
    else:  # a side worker's recorded workspace is the root's, so it goes to its project's
        workspace_id = (not side and entry.get("workspace")) or find_or_create_workspace(Path(entry["repo"]))[0]
        pane, tab = new_pane(run_id, workspace_id, Path(entry["cwd"]), env)
    with editing_run(run_id) as run:  # "starting" first, so `mesh watch` doesn't take the gap for an exit
        e = run["agents"][name]
        e.update(model=model, effort=effort, pane=pane, tab=tab, workspace=workspace_id, session=session,
                 status="starting", swapped=True)
        e.setdefault("models", []).append({"model": model, "effort": effort, "at": now_iso(), "why": why})
    argv = [*log_argv(entry.get("log")), *resume_argv(entry["kind"], session, model, effort),
            "--dangerously-skip-permissions"]
    try:
        try:
            herdr("pane", "close", entry["pane"])
        except HerdrError as exc:
            if exc.code not in ("pane_not_found", "agent_not_found"):
                raise
        log_event(run_id, "swap", name=name, model=model, effort=effort, why=why, pane=pane, session=session)
        start_agent(name, entry["kind"], pane, argv)
    except MeshError as exc:
        with editing_run(run_id) as run:  # the old model is still the recorded one, so a retry swaps again
            e = run["agents"][name]
            e.update(model=entry.get("model"), effort=entry.get("effort"), status="swap_failed")
            e.pop("swapped", None)
            e["models"].pop()
        log_event(run_id, "swap_failed", name=name, model=model, effort=effort, error=str(exc))
        raise MeshError(f"{name} was not reopened on {model} ({exc}); look at it with "
                        f"`herdr agent read {name}`, then retry") from exc
    with editing_run(run_id) as run:
        run["agents"][name]["status"] = "running"
    return {"name": name, "model": model, "pane": pane, "previous": entry.get("model")}


def cmd_approve(args: argparse.Namespace) -> int:
    """Approve a worker's plan; a worker on `auto` moves to its exec model first, keeping its conversation."""
    run_id, me = identity(args)
    entry = agent_entry(load_run(run_id), args.agent)
    refuse_headless(args.agent, entry, "`mesh approve`")
    result: dict = {"name": args.agent, "model": entry.get("model")}
    extra = read_body(args.body, args.file)
    body = "approved" + (f"\n\n{extra.strip()}" if extra and extra.strip() else "")
    if entry.get("phase") == "plan" and entry.get("exec_model"):
        effort = entry.get("exec_effort") or EXEC_EFFORT
        model = resolve_model(entry["kind"], entry["exec_model"], effort)
        if args.keep_model:  # asked for, never a fallback: it executes on what it planned on
            with editing_run(run_id) as run:
                run["agents"][args.agent].setdefault("models", []).append(
                    {"model": entry.get("model"), "effort": entry.get("effort"), "at": now_iso(),
                     "why": "plan approved", "kept": True})
            log_event(run_id, "approve_kept_model", name=args.agent, model=entry.get("model"))
            result["kept_model"] = True
        elif (model, effort) != (entry.get("model"), entry.get("effort")):
            try:
                result["swap"] = swap_model(run_id, args.agent, model, effort, "plan approved",
                                            message=(me, "answer", body))
            except SwapNotStarted as exc:
                raise MeshError(f"{exc}. Nothing was sent. To approve it on {entry.get('model')} instead, run "
                                f"`mesh approve {args.agent} --keep-model`: it is then recorded as executing, so a "
                                f"later `mesh switch` moves it to {entry['exec_model']}") from exc
            result["model"] = model
        with editing_run(run_id) as run:
            run["agents"][args.agent]["phase"] = "exec"
    result["delivery"] = (result.get("swap") or {}).pop("delivery", None) or deliver(
        run_id, me, args.agent, "answer", body, first="swap" in result)
    emit(result)
    return 0 if delivered(result["delivery"]) else 2


def models_tried(entry: dict) -> tuple[str, ...]:
    """Every model the worker has run on in its current phase: `switch` never goes back to one."""
    models = entry.get("models", [])
    marker = "plan approved" if entry.get("phase") == "exec" else "planned task"
    start = next((i for i in range(len(models) - 1, -1, -1) if models[i].get("why") == marker), 0)
    return tuple({entry.get("model"), *(m["model"] for m in models[start:])})


def cmd_switch(args: argparse.Namespace) -> int:
    """Move a worker that hit a quota to the next model with quota left, and tell it to carry on."""
    run_id, me = identity(args)
    entry = agent_entry(load_run(run_id), args.agent)
    refuse_headless(args.agent, entry, "`mesh switch`")
    effort = entry.get("effort") or DEFAULT_EFFORT
    if entry.get("phase") == "exec" and not args.model:  # after `approve --keep-model` it still has the plan's
        effort = entry.get("exec_effort") or EXEC_EFFORT
    notes: list[str] = []
    if args.model:
        model = resolve_model(entry["kind"], args.model, effort)
        parsed = parse_agy_id(model) if entry["kind"] == "agy" else None
        effort = parsed[2] if parsed else effort  # an exact id carries its own effort
    elif entry["kind"] != "agy":
        raise MeshError("only agy quotas are known to mesh; pass --model for a claude worker")
    else:
        chain = PLAN_CHAIN["agy"] if entry.get("phase") != "exec" else (entry.get("exec_model") or EXEC_MODEL["agy"],)
        model, notes = choose_agy_model(chain, effort, skip=models_tried(entry), force=True, fallback=False)
    body = (f"Your previous model ({entry.get('model')}) hit its quota; you are now on {model}, in the same "
            "conversation. Continue exactly where you stopped.")
    swap = swap_model(run_id, args.agent, model, effort, "quota", wait_ms=60_000, strict=False,
                      message=(me, "task", body))
    delivery = swap.pop("delivery", None) or deliver(run_id, me, args.agent, "task", body, first=True)
    emit({**swap, "notes": notes, "delivery": delivery})
    return 0 if delivered(delivery) else 2


def quota_hit(log: str | None, offset: int) -> tuple[str | None, int]:
    """(reset time or None, new offset): the reset time ("" if unknown) of a quota error agy logged after `offset`.

    Reads only the new bytes. A log that is shorter than `offset` was truncated by a restarted agy: read it afresh.
    """
    if not log or not Path(log).exists():
        return None, offset
    with open(log, "rb") as fh:
        size = fh.seek(0, os.SEEK_END)
        offset = 0 if size < offset else offset
        fh.seek(offset)
        hit = QUOTA_RE.search(fh.read().decode(errors="replace"))
    if not hit:
        return None, size
    reset = RESET_RE.search(hit.group(0))
    return (reset.group(1) if reset else ""), size


def read_body(body: str | None, file: str | None) -> str | None:
    if file == "-":
        return sys.stdin.read()
    if file:
        return Path(file).expanduser().read_text()
    return body


def cmd_send(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    body = read_body(args.body, args.file)
    if not body or not body.strip():
        raise MeshError("empty message: pass --body TEXT or --file PATH (- for stdin)")
    to = me_parent(run_id, me) if args.to == "parent" else args.to
    def stored() -> None:  # before the doorbell, so a root that approves at once sees the plan phase
        record_session(run_id, me)
        if args.type == "plan":
            enter_plan_phase(run_id, me, to)

    result = deliver(run_id, me, to, args.type, body, stored=stored)
    emit(result)
    if "send_message" in result:
        print(f"mesh: stored; now tell {to} with SendMessage: `to` and `message` exactly as in send_message",
              file=sys.stderr)
        return 0
    if not result["rung"]:
        print(f"warning: stored, but the doorbell did not ring ({result['error']}); "
              f"{to} will see it on its next `mesh inbox`", file=sys.stderr)
        return 2
    return 0


def pinned(entry: dict) -> bool:
    """Whether a named model or effort covers the worker's whole task (spawn and resume record it).

    A worker spawned before mesh recorded it: a large one with no exec model had its model named (`auto`
    always gives one), while a sized one ran on its size's defaults. A resumed one most likely got a task
    with no plan phase, which also leaves no exec model, so it isn't taken for pinned.
    """
    if "pinned" in entry:
        return bool(entry["pinned"])
    return not entry.get("exec_model") and entry.get("size") not in ("trivial", "small") \
        and not entry.get("resumed_from")


def has_phases(entry: dict | None) -> bool:
    """A worker that may plan and then execute on its exec model: not one whose model or effort was named
    for the whole task (`pinned`), nor one whose plan the user approves in its pane."""
    return bool(entry) and entry.get("role") == "worker" and entry.get("kind") in KINDS \
        and not pinned(entry) and entry.get("plan_review") != "user"


def enter_plan_phase(run_id: str, name: str, to: str) -> None:
    """A worker that sends its parent a plan while not planning (a small asker given a change, a worker that
    finished and got a new task) enters a plan phase, as `mesh resume` gives one, so `mesh approve` moves it
    to its exec model and effort. It is planning on the model it is on: `send` never reopens a worker.

    The trigger is the plan itself, not the task: a fix the worker just does keeps its exec phase.
    """
    entry = load_run(run_id)["agents"].get(name)
    if not has_phases(entry) or entry.get("phase") == "plan" or entry.get("parent") != to:
        return
    with editing_run(run_id) as run:
        entry = run["agents"][name]
        entry.update(phase="plan", exec_model=entry.get("exec_model") or EXEC_MODEL[entry["kind"]],
                     exec_effort=entry.get("exec_effort") or EXEC_EFFORT)
        # where this plan phase starts, for models_tried
        entry.setdefault("models", []).append({"model": entry.get("model"), "effort": entry.get("effort"),
                                               "at": now_iso(), "why": "planned task"})
    log_event(run_id, "plan_phase", name=name, exec_model=entry["exec_model"])


def record_session(run_id: str, name: str) -> None:
    """Record an agy worker's conversation on its first message, while agy's index still holds its first
    doorbell: agy may later replace that with a title, and the worktree fallback can pick a restart's."""
    entry = load_run(run_id)["agents"].get(name)
    if not entry or entry.get("kind") != "agy" or entry.get("session") or entry.get("role") != "worker":
        return
    session = agy_conversation(name, run_id, None, pinned_only=True)
    if session:
        with editing_run(run_id) as run:
            e = run["agents"][name]
            e["session"] = e.get("session") or session
        log_event(run_id, "session", name=name, session=session)


def me_parent(run_id: str, me: str) -> str:
    parent = agent_entry(load_run(run_id), me).get("parent")
    if not parent:
        raise MeshError(f"{me} has no parent (it is the run's root)")
    return parent


def cmd_inbox(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    folder = inbox_dir(run_id, me)
    paths = unread(run_id, me)
    if args.all and (folder / "read").exists():
        paths = sorted((folder / "read").glob("*.md")) + paths
    messages = []
    for path in paths:
        meta, body = parse_message(path)
        messages.append({"file": str(path), **meta, "body": body.strip()})
        if not args.peek and path.parent == folder:
            mark_read(path)
    if args.json:
        emit(messages)
    elif not messages:
        print("No unread messages.")
    else:
        for msg in messages:
            print(f"── {msg.get('type')} from {msg.get('from')} at {msg.get('time')} ──")
            print(msg["body"], end="\n\n")
    return 0


def cmd_ring(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    run = load_run(run_id)
    entry = agent_entry(run, args.agent)
    refuse_headless(args.agent, entry, "a doorbell")
    count = len(unread(run_id, args.agent))
    if not count:
        print(f"{args.agent} has no unread messages.")
        return 0
    text = f"📬 [mesh] you have {count} unread message(s) (run `mesh inbox`)"
    route = native_route(run, me, args.agent)
    if route:
        emit({"rung": False, "unread": count, "send_message": {"to": route, "message": text}})
        return 0
    targets = [args.agent] + ([entry["pane"]] if entry.get("pane") else [])
    rung, error = ring(targets, text)
    emit({"rung": rung, "error": error, "unread": count})
    return 0 if rung else 2


def agent_status(name: str, entry: dict | None = None, bg_rows: list[dict] | None = None) -> str:
    """herdr's state for an agent's pane (working / idle / done / blocked / gone); a background worker's from Claude."""
    if entry and entry.get("view") == "bg":
        return bg_status(entry, bg_rows)
    if entry and entry.get("view") == "headless":
        # A Copilot asker runs only inside the `mesh ask` that asks it, and works while that process lives.
        return "working" if entry.get("status") == "running" and pid_alive(entry.get("pid")) else "gone"
    try:
        return herdr("agent", "get", name)["agent"].get("agent_status", "unknown")
    except HerdrError as exc:
        if exc.code == "agent_not_found":
            return "gone"
        raise


def cmd_status(args: argparse.Namespace) -> int:
    run_id = args.run_id or identity(args)[0]
    run = load_run(run_id)
    rows = []
    bg_rows = claude_agents() if any(e.get("view") == "bg" for e in run["agents"].values()) else []
    for name, entry in run["agents"].items():
        live = "retired" if entry.get("status") == "retired" else agent_status(name, entry, bg_rows)
        rows.append({
            "name": name, "role": entry["role"], "kind": entry.get("kind"), "model": entry.get("model") or "",
            "size": entry.get("size") or "", "view": entry.get("view") or ("pane" if entry.get("pane") else ""),
            "state": live, "unread": len(unread(run_id, name)), "parent": entry.get("parent") or "",
            "branch": entry.get("branch") or "",
        })
    if args.json:
        emit({"run": run_id, "mode": run["mode"], "agents": rows})
        return 0
    print(f"run {run_id} ({run['mode']}), {run_dir(run_id)}")
    print_table(rows, ("name", "role", "kind", "model", "size", "view", "state", "unread", "parent", "branch"))
    return 0


def sends_from(run_id: str, name: str, types: tuple[str, ...] = TYPES, events: list[dict] | None = None) -> int:
    events = read_log(run_id) if events is None else events
    return sum(1 for e in events if e.get("event") == "send" and e.get("sender") == name and e.get("type") in types)


def cmd_watch(args: argparse.Namespace) -> int:
    """Block until a child reports done/failed (exit 0) or something looks wrong (non-zero)."""
    run_id = args.run_id or identity(args)[0]
    every, alerts = getattr(args, "any", False), getattr(args, "alerts", False)
    if bool(args.agent) == bool(every):
        raise MeshError("watch whom? name a worker, or pass --any for every live worker of the run")
    if every:
        run = load_run(run_id)
        bg_rows = claude_agents() if any(e.get("view") == "bg" for e in run["agents"].values()) else []
        names = [name for name, e in run["agents"].items() if e["role"] != "root" and e.get("status") != "retired"
                 and agent_status(name, e, bg_rows) != "gone"]
        if not names:
            print("no live workers to watch")
            return 0
    else:
        names = [args.agent]
    status, line = watch_agents(run_id, names, args.timeout, args.interval, args.grace, alerts_only=alerts)
    print(line)
    return status


def since_last_task(events: list[dict], name: str) -> tuple[int, int, str | None]:
    """(tasks and answers `name` has received, reports it has sent since the last of them, that last one's time)."""
    received = sent = 0
    at = None
    for event in events:
        if event.get("event") != "send":
            continue
        if event.get("to") == name and event.get("type") in RECEIVED_TYPES:
            received, sent, at = received + 1, 0, event.get("time")
        elif event.get("sender") == name and event.get("type") in REPORT_TYPES:
            sent += 1
    return received, sent, at


def nudge_of(events: list[dict], name: str, received: int) -> dict | None:
    """The logged nudge for `name`'s current task, with `rung` once its doorbell was tried."""
    found = None
    for e in events:
        if e.get("name") == name and e.get("received") == received:
            if e.get("event") == "nudge":
                found = dict(e)
            elif e.get("event") == "nudge_rung" and found:
                found["rung"] = e.get("rung")
    return found


def claim_nudge(run_id: str, name: str, received: int) -> bool:
    """Log the nudge for this task unless a watch already did (checked and logged under the run lock)."""
    with run_lock(run_id):
        if nudge_of(read_log(run_id), name, received):
            return False
        log_event(run_id, "nudge", name=name, received=received)
        return True


def alerted(events: list[dict], name: str, received: int) -> bool:
    """Whether a watch already raised the stopped alert (exit 3) for `name`'s current task."""
    return any(e.get("event") == "alert" and e.get("name") == name and e.get("received") == received for e in events)


def record_alert(run_id: str, name: str, received: int) -> None:
    """Log the stopped alert for this task, once (checked and logged under the run lock)."""
    with run_lock(run_id):
        if not alerted(read_log(run_id), name, received):
            log_event(run_id, "alert", name=name, received=received)


def nudge(run_id: str, name: str, entry: dict, received: int) -> bool:
    """Remind a worker whose turn ended silently to report, through `deliver`, with a short ring schedule."""
    delivery = deliver(run_id, entry.get("parent") or me_parent(run_id, name), name, "info", NUDGE_BODY,
                       delays=NUDGE_RING_DELAYS)
    rung = bool(delivery.get("rung"))
    log_event(run_id, "nudge_rung", name=name, received=received, rung=rung)
    return rung


def age_seconds(stamp_iso: str | None) -> float:
    try:
        return (datetime.now(timezone.utc) - datetime.fromisoformat(stamp_iso)).total_seconds()
    except (TypeError, ValueError):
        return float("inf")


class Watch:
    """One child's watchdog state between polls (see watch_agents)."""

    def __init__(self, run_id: str, name: str, grace: float, finals_at_start: int | None = None):
        entry = agent_entry(load_run(run_id), name)
        self.run_id, self.name, self.grace = run_id, name, grace
        self.start_grace = max(START_GRACE_FACTOR * grace, SETTLE_GRACE)
        # Final sends before the watch started (or before its task was delivered) don't count.
        self.finals_at_start = sends_from(run_id, name, FINAL_TYPES) if finals_at_start is None else finals_at_start
        self.log = entry.get("log")
        self.log_offset = Path(self.log).stat().st_size if self.log and Path(self.log).exists() else 0
        self.prev: str | None = None
        self.worked = False  # seen working since it last reported (or since it was nudged)
        self.idle_for: float | None = None  # seconds it has read idle in a row
        self.blocked_polls = 0
        self.nudged: int | None = None  # the task (count of tasks and answers received) this watch nudged for
        self.reopening = 0.0  # seconds spent excusing a "gone" worker that is being reopened
        self.reported = False  # it reported since the watch started (an --alerts watch carries on)
        self.retired = False  # the root is retiring it, or has: whatever it does next is no news
        self.finished = False  # it reported, then its pane closed or its session ended; or it was retired

    def tick(self, interval: float, alerts_only: bool = False, bg_rows: list[dict] | None = None,
             events: list[dict] | None = None) -> tuple[int, str] | None:
        """(status, line) once there is something to say, else None. `events` is this poll's read of the log."""
        run_id, name = self.run_id, self.name
        events = read_log(run_id) if events is None else events
        finals = sends_from(run_id, name, FINAL_TYPES, events)
        if finals > self.finals_at_start:
            last = [e for e in events if e.get("event") == "send" and e.get("sender") == name][-1]
            if not alerts_only:
                return 0, f"{name} reported {last['type']}: read it with `mesh inbox`"
            self.finals_at_start, self.reported = finals, True
        reset, self.log_offset = quota_hit(self.log, self.log_offset)
        if reset is not None:
            model = agent_entry(load_run(run_id), name).get("model")
            return 7, (f"ALERT {name} hit its quota on {model}" + (f" (resets in {reset})" if reset else "")
                       + f"; move it to the next model with `mesh switch {name}`")
        entry = agent_entry(load_run(run_id), name)
        state = agent_status(name, entry, bg_rows)
        if agent_entry(load_run(run_id), name).get("status") in ("retiring", "retired"):  # read after the state
            self.retired = self.finished = True  # the root is closing it on purpose, report or not
            return None
        if self.retired:  # its retire failed, or it was resumed: watch it again
            self.retired = self.finished = False
        if (state == "gone" and self.reopening < SWAP_GRACE
                and agent_entry(load_run(run_id), name).get("status") == "starting"):  # read after the state
            self.reopening += interval  # `mesh approve` / `mesh switch` is reopening it on another model
            return None  # nothing to judge meanwhile: its idle time doesn't count either
        if state != "gone":
            self.reopening = 0.0
        if state == "gone":
            if self.reported:
                self.finished = True  # nothing to alert
                return None
            return 5, f"ALERT {name} is gone (pane closed or agent exited) without reporting done/failed"
        bg = entry.get("view") == "bg"
        self.blocked_polls = self.blocked_polls + 1 if state == "blocked" else 0
        if self.blocked_polls >= 2 and entry.get("plan_review") != "user":  # that one waits for the user's approval
            look = f"`claude attach {entry['bg_id']}`" if bg else f"`herdr agent read {name}`"
            return 4, self.with_tail(f"ALERT {name} is blocked on a UI prompt; inspect it with {look}", bg, entry)
        self.prev = state
        if state in ("idle", "done"):
            # One idle reading isn't the end of a turn: agy shows no spinner for a few seconds between steps.
            self.idle_for = 0.0 if self.idle_for is None else self.idle_for + interval
            if self.idle_for >= self.grace and (self.worked or self.idle_from_start(events)):
                return self.stopped(entry, bg, events)
        else:
            self.idle_for = None
            if state == "working":
                self.worked = True
        return None

    def idle_from_start(self, events: list[dict]) -> bool:
        """Never seen working, but its last task or answer is `start_grace` old (in the log, so a watch started
        late still judges it) with nothing reported since: its turn ended, or never began. A task some watch
        already alerted on isn't judged again (a restarted watch would re-alert every `--grace`); a new task or
        answer, or a `working` reading, re-arms it."""
        received, sent, at = since_last_task(events, self.name)
        return (bool(received) and not sent and age_seconds(at) >= self.start_grace
                and not alerted(events, self.name, received))

    def stopped(self, entry: dict, bg: bool, events: list[dict]) -> tuple[int, str] | None:
        """Its turn has ended: fine if it reported since its last task or answer, else nudge it once, then alert."""
        run_id, name = self.run_id, self.name
        received, sent, _ = since_last_task(events, name)
        self.worked, self.idle_for = False, None
        if sent:
            return None  # a report, or a plan or question waiting for its answer
        if bg:
            record_alert(run_id, name, received)
            return 3, (f"ALERT {name} stopped working without sending a message{self.unread_note(' (', ')')}; "
                       f"inspect it with `claude logs {entry['bg_id']}`, or nudge it once with `mesh send {name} --type info "
                       f"--body \"Report with mesh send\"` and pass its send_message on")
        if claim_nudge(run_id, name, received):
            self.nudged = received
            nudge(run_id, name, entry, received)
            self.worked, self.idle_for = True, 0.0  # alert if it stays idle, or goes idle again without a report
            return None
        done = nudge_of(read_log(run_id), name, received) or {}
        if self.nudged != received and age_seconds(done.get("time")) < self.grace:
            # another watch just nudged it: give it the same time the nudger gives it
            self.worked, self.idle_for = True, 0.0
            return None
        how = "nudged once" if done.get("rung") else "its nudge was not delivered"
        how += self.unread_note()
        line = (f"ALERT {name} stopped working without sending a message ({how}); inspect it with "
                f"`herdr agent read {name} --source recent-unwrapped --lines 80`")
        record_alert(run_id, name, received)
        return 3, self.with_tail(line, bg, entry)

    def unread_note(self, before: str = ", ", after: str = "") -> str:
        """Says so when a task or answer is still in its mailbox: it never picked it up."""
        names = [p.name for p in unread(self.run_id, self.name)]
        kinds = [t for t in RECEIVED_TYPES if any(n.endswith(f"-{t}.md") for n in names)]
        if not kinds:
            return ""
        return f"{before}its {' and '.join(kinds)} {'are' if len(kinds) > 1 else 'is'} still unread{after}"

    def with_tail(self, line: str, bg: bool, entry: dict) -> str:
        tail = "" if bg else pane_tail(self.name) or (pane_tail(entry["pane"]) if entry.get("pane") else "")
        return f"{line}\n  last lines of its pane:\n{tail}" if tail else line


def watch_agents(run_id: str, names: list[str], timeout: float = 0, interval: float = 5.0, grace: float = SETTLE_GRACE,
                 finals_at_start: int | None = None, alerts_only: bool = False) -> tuple[int, str]:
    """Wait for the first of `names` to report done/failed (0) or raise an alert (3-7), with the line that says which.

    `finals_at_start` (one name only) is the child's count of final sends before its task was delivered, so a
    report that lands before the watch starts still counts. `alerts_only` keeps watching through reports.
    """
    watches = [Watch(run_id, name, grace, finals_at_start) for name in names]
    deadline = time.monotonic() + timeout if timeout else None
    while True:
        run = load_run(run_id)
        # One `claude agents` call per poll, shared by every background worker.
        bg_rows = claude_agents() if any(run["agents"].get(w.name, {}).get("view") == "bg" for w in watches) else None
        events = read_log(run_id)  # one read per poll, shared by every watch
        for watch in watches:
            event = watch.tick(interval, alerts_only, bg_rows, events)
            if event:
                return event
        if all(w.finished for w in watches):  # without --alerts only a retired worker finishes without returning
            retired = [w.name for w in watches if w.retired and not w.reported]
            if not retired:
                return 0, "every watched worker reported and has ended; nothing left to watch"
            rest = "" if len(retired) == len(watches) else "; the rest reported and have ended"
            return 0, f"retired {', '.join(retired)}{rest}; nothing left to watch"
        if deadline and time.monotonic() > deadline:
            waiting = [w for w in watches if not w.reported and not w.retired]
            if not waiting:
                return 0, (f"every watched worker reported{' or was retired' if any(w.retired for w in watches) else ''} "
                           f"within {timeout}s")
            states = ", ".join(f"{w.name}: {w.prev}" for w in waiting)
            who = waiting[0].name if len(waiting) == 1 else f"{len(waiting)} workers"
            return 6, f"ALERT {who} has not reported within {timeout}s ({states})"
        time.sleep(interval)


def watch_agent(run_id: str, name: str, timeout: float = 0, interval: float = 5.0, grace: float = SETTLE_GRACE,
                finals_at_start: int | None = None) -> tuple[int, str]:
    return watch_agents(run_id, [name], timeout, interval, grace, finals_at_start)


def cmd_retire(args: argparse.Namespace) -> int:
    run_id, _ = identity(args)
    entry = agent_entry(load_run(run_id), args.agent)
    if entry["role"] == "root":
        raise MeshError("the root is not retired; use `mesh stop`")
    retire_worker(run_id, args.agent, entry)
    emit({"retired": args.agent, "cwd": entry.get("cwd"), "branch": entry.get("branch")})
    return 0


def retire_worker(run_id: str, name: str, entry: dict) -> None:
    """Close a worker's pane (or stop its background session); its conversation stays resumable."""
    with editing_run(run_id) as run:  # first, so a watch never takes the closing pane for a crash
        agent = run["agents"][name]
        before, agent["status"] = agent.get("status"), "retiring"
    try:
        if entry.get("view") == "bg":
            stop_bg(entry)
        elif entry.get("pane"):  # none if its pane never opened
            try:  # let it end the turn it reported in, so its conversation is saved whole (as in swap_model)
                herdr("agent", "wait", name, "--until", "idle", "--until", "done", "--timeout", str(RETIRE_WAIT_MS),
                      timeout=RETIRE_WAIT_MS / 1000 + 10)
            except HerdrError:
                pass  # gone already, or still busy: close it anyway
            try:
                herdr("pane", "close", entry["pane"])
            except HerdrError as exc:
                if exc.code not in ("pane_not_found", "agent_not_found"):
                    raise
    except BaseException:
        with editing_run(run_id) as run:  # still open: it isn't retired
            run["agents"][name]["status"] = before
        raise
    with editing_run(run_id) as run:
        run["agents"][name]["status"] = "retired"
    log_event(run_id, "retire", name=name)


# ── past workers: agents, resume, open ───────────────────────────────────


def all_runs() -> list[tuple[dict, Path]]:
    """Every run, live and archived, newest first, with its directory."""
    home = mesh_home()
    runs = []
    for path in (*home.glob("*/run.json"), *home.glob("archive/*/run.json")):
        try:
            runs.append((json.loads(path.read_text()), path.parent))
        except (OSError, ValueError):
            continue
    return sorted(runs, key=lambda r: r[0].get("created", ""), reverse=True)


def worker_prs(folder: Path, name: str, entry: dict | None = None) -> list[str]:
    """PR links in the messages a worker sent; its `done` reports carry them. PRs it only reviewed don't count."""
    reviewed = set((entry or {}).get("reviews") or ())
    prs: list[str] = []
    for path in sorted((folder / "inbox").glob("**/*.md")):
        meta, body = parse_message(path)
        if meta.get("from") == name:
            prs += PR_RE.findall(body)
    return [url for url in dict.fromkeys(prs) if url not in reviewed]


def find_worker(ref: str, from_run: str | None = None) -> tuple[dict, Path, str, dict]:
    """The newest worker whose name, branch or PR link is `ref`."""
    pr = PR_RE.search(ref)
    for run, folder in all_runs():
        if from_run and run["id"] != from_run:
            continue
        for name, entry in reversed(run["agents"].items()):  # a restart beats the agent it replaced
            if entry.get("role") == "root":
                continue
            if ref in (name, entry_branch(run, entry)) or (pr and pr.group(0) in worker_prs(folder, name, entry)):
                return run, folder, name, entry
    raise MeshError(f"no worker matches {ref}" + (f" in run {from_run}" if from_run else "") + "; see `mesh agents`")


def pid_alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # alive, just not ours
    return True


def live_holder(name: str, entry: dict, agents: list[dict] | None = None,
                bg_rows: list[dict] | None = None) -> dict | None:
    """A live agent that may hold this worker's conversation already.

    A background worker's own session, while it runs. Then any herdr agent in its own worktree (the user
    may have reopened it with `mesh open`); in a main checkout, which other sessions share, only an agent
    still carrying its name.
    """
    if entry.get("view") == "bg":
        row = bg_row(entry, bg_rows)
        if row and row.get("status"):
            return {"name": name, "pane_id": None, "bg_id": row.get("id")}
    if entry.get("view") == "headless":
        # Busy only while the `mesh ask` running it is alive; a `running` left by a killed one is stale.
        pid = entry.get("pid")
        return {"name": name, "pane_id": None, "pid": pid} if entry.get("status") == "running" and pid_alive(pid) else None
    cwd = entry.get("cwd")
    if agents is None:
        agents = herdr("agent", "list").get("agents", [])
    if not cwd or (entry.get("repo") and Path(cwd).resolve() == Path(entry["repo"]).resolve()):
        return next((a for a in agents if a.get("name") == name), None)
    top = Path(cwd).resolve()
    return next((a for a in agents if inside(a.get("cwd"), top) or inside(a.get("foreground_cwd"), top)), None)


def print_table(rows: list[dict], cols: tuple[str, ...]) -> None:
    widths = {c: max(len(c), *(len(str(r[c])) for r in rows)) for c in cols}
    print("  ".join(c.upper().ljust(widths[c]) for c in cols))
    for row in rows:
        print("  ".join(str(row[c]).ljust(widths[c]) for c in cols))


def cmd_agents(args: argparse.Namespace) -> int:
    try:
        live = herdr("agent", "list").get("agents", [])
    except MeshError:
        live = []  # outside herdr: every agent shows as gone
    query = (args.query or "").lower()
    rows = []
    runs = all_runs()
    bg_rows = claude_agents() if any(e.get("view") == "bg" for r, _ in runs for e in r["agents"].values()) else []
    for run, folder in runs:
        if args.run and run["id"] != args.run:
            continue  # by run id, not branch: a worker resumed into a run keeps its old run's branch
        for name, entry in run["agents"].items():
            if entry.get("role") == "root":
                continue
            cwd, branch, prs = entry.get("cwd") or "", entry_branch(run, entry) or "", worker_prs(folder, name, entry)
            reviews = entry.get("reviews") or []
            if query and not any(query in str(v).lower() for v in (name, entry.get("repo"), branch, *prs, *reviews)):
                continue
            rows.append({
                "name": name, "run": run["id"], "archived": folder.parent.name == "archive",
                "kind": entry.get("kind"), "model": entry.get("model") or "", "view": entry.get("view") or "pane",
                "repo": Path(entry["repo"]).name if entry.get("repo") else "", "branch": branch,
                "worktree": "present" if cwd and Path(cwd).exists() else "removed",
                "state": "live" if live_holder(name, entry, live, bg_rows) else "gone",
                "session": "found" if find_session(run["id"], name, entry) else "missing",
                "prs": " ".join(prs), "reviews": " ".join(reviews), "cwd": cwd,
            })
    if args.json:
        emit(rows)
    elif not rows:
        scope = (f" match {args.query}" if query else "") + (f" in run {args.run}" if args.run else "")
        print(f"No workers{scope or ' found'}.")
    else:
        print_table(rows, ("name", "run", "kind", "model", "view", "repo", "branch", "worktree", "state", "session",
                           "prs", "reviews"))
    return 0


def resumable(ref: str, from_run: str | None, live_hint) -> tuple[dict, str, dict, str]:
    """Find a past worker and its conversation, refusing one that is still running."""
    run, _, name, entry = find_worker(ref, from_run)
    session = find_session(run["id"], name, entry)
    if not session:
        raise MeshError(
            f"can't find {name}'s {entry.get('kind')} conversation; start a fresh worker with "
            f"`mesh spawn --cwd {entry.get('cwd')}` and give it the old plan and report"
        )
    holder = live_hint(name, entry)
    if holder and holder.get("pid"):
        raise MeshError(f"{name} is still answering in mesh process {holder['pid']}; ask it again once that finishes")
    if holder:
        where = (f"background session {holder['bg_id']}" if holder.get("bg_id")
                 else f"pane {holder.get('pane_id')}")
        raise MeshError(f"{name} is still running in {where}; {holder['hint']}")
    return run, name, entry, session


def cmd_resume(args: argparse.Namespace) -> int:
    """Bring a past worker back, conversation and all, as a worker of this run."""
    emit(resume_worker(args, *identity(args)))
    return 0


READ_ONLY_STARTS = ("Question (read-only)", "Review (read-only)")


def first_line(text: str | None, limit: int = 160) -> str:
    line = next((ln.strip() for ln in (text or "").splitlines() if ln.strip()), "")
    return line[:limit]


DIRECT_STARTS = ("Direct task (no plan)", "Plan review by the user")


def planned_task(task: str | None) -> bool:
    """A task the worker plans first: not a question, a review or a direct task."""
    return bool(task) and not task.lstrip().startswith(READ_ONLY_STARTS + DIRECT_STARTS)


def task_gist(task: str | None, limit: int = 160) -> str:
    """The line that says what a task is: the first one past the standard prefixes, without a heading's `#`."""
    for paragraph in re.split(r"\n\s*\n", task or ""):
        paragraph = paragraph.strip()
        if not paragraph or paragraph.startswith(READ_ONLY_STARTS + DIRECT_STARTS):
            continue
        line = first_line(paragraph.lstrip("#").strip())
        if line:
            return line[:limit]
    return ""


def maybe_compact(args: argparse.Namespace, entry: dict, session: str, model: str, task: str | None,
                  cross_run: bool) -> dict:
    """`--compact`: compact the conversation before it is reopened, if it's worth it (see should_compact)."""
    mode = getattr(args, "compact", None) or "auto"
    read_only = getattr(args, "read_only", False) or bool(task and task.startswith(READ_ONLY_STARTS))
    tokens = context_tokens(entry, session)
    report: dict = {"context_tokens": tokens, "compacted": False}
    if not should_compact(mode, entry, tokens, read_only, cross_run):
        return report
    focus = getattr(args, "focus", None) or COMPACT_FOCUS.format(
        task=task_gist(task) or "the follow-up task you are about to get")
    ok, output = compact_conversation(entry, session, model, focus)
    report["compacted"] = ok
    if ok:
        report["context_tokens_after"] = context_tokens(entry, session)
    else:
        report["note"] = f"compaction failed, so it resumes as it was: {output}"
    return report


def resume_worker(args: argparse.Namespace, run_id: str, me: str) -> dict:
    current = load_run(run_id)

    def live_hint(name, entry):
        holder = live_holder(name, entry)
        if holder:
            held = holder.get("name")
            holder["hint"] = (f"send it the task: `mesh send {held} --type task`" if held in current["agents"]
                              else f"attach to it with `mesh open {held}`" if holder.get("bg_id")
                              else f"go there with `herdr agent focus {held or holder.get('pane_id')}`")
        return holder

    old_run, old_name, old, session = resumable(args.ref, args.from_run, live_hint)
    if old["kind"] == "copilot":
        raise MeshError(f"{old_name} is a Copilot asker, which only answers: ask it again with `mesh ask {old_name}`, "
                        "or give the change to the PR's author or a fresh worker")
    task = read_body(args.task, args.task_file)
    # A task it plans first plans where a spawn on `auto` would, whatever it last ran on, and gets the
    # execution phase, so `mesh approve` moves it on; a named model or effort covers the whole task, as in spawn.
    planned = planned_task(task) and not (args.model or args.effort)
    notes: list[str] = []
    if planned:
        effort = DEFAULT_EFFORT
        model, notes = plan_model(old["kind"], effort)
    else:
        model, effort = resumed_model(old, args.model, args.effort)
    view = getattr(args, "view", None) or old.get("view") or "pane"
    if view == "bg" and old["kind"] != "claude":
        raise MeshError("--view bg is for Claude workers; agy has no background sessions")
    if view == "bg" and not address_alive(current["agents"][current["root"]].get("address")):
        if getattr(args, "view", None):
            raise MeshError("a background worker needs a Claude root it can message (see `mesh init`)")
        notes.append("background needs a Claude root that background workers can message; reopening in a pane")
        view = "pane"
    branch = entry_branch(old_run, old)
    taken = live_agent_names() | (set(current["agents"]) - ({old_name} if old_run["id"] == run_id else set()))
    name, n = old_name, 2
    while name in taken:
        name, n = f"{old_name[:29]}-{n}", n + 1

    cwd, repo_top = old["cwd"], Path(old["repo"])
    recreated = ensure_worktree(old, branch)
    with editing_run(run_id) as run:
        worktrees = run.setdefault("worktrees", [])
        if branch and Path(cwd).resolve() != repo_top.resolve() and not any(Path(w["path"]) == Path(cwd) for w in worktrees):
            # so this run's stop cleans it up (and drops the branch if it still has no commits)
            base = {"base": old["base"]} if old.get("base") else {}
            worktrees.append({"path": cwd, "repo": str(repo_top), "branch": branch, **base})
    compaction = maybe_compact(args, old, session, model, task, cross_run=old_run["id"] != run_id)
    if compaction.get("note"):
        notes.append(compaction["note"])

    log = worker_log(run_id, name) if old["kind"] == "agy" else None
    env = mesh_env(run_id, name, me, "worker")
    exec_model = (old.get("exec_model") or EXEC_MODEL[old["kind"]]) if planned else None
    exec_effort = (old.get("exec_effort") or EXEC_EFFORT) if planned else None
    with editing_run(run_id) as run:
        run["agents"][name] = {
            "role": "worker", "kind": old["kind"], "model": model, "effort": effort, "base": old.get("base"),
            "size": old.get("size"), "view": view, "reviews": list(old.get("reviews") or []),
            "repo": str(repo_top), "cwd": cwd, "branch": branch, "session": session, "pane": None, "tab": None,
            "workspace": None, "parent": me, "status": "starting", "spawned": now_iso(),
            "resumed_from": {"run": old_run["id"], "name": old_name}, "log": log,
            "phase": "plan" if planned else None, "exec_model": exec_model, "exec_effort": exec_effort,
            "pinned": bool(args.model or args.effort) or (not planned and bool(old.get("pinned"))),
            "models": [{"model": model, "effort": effort, "at": now_iso(), "why": "resume"}],
        }
    result = {"name": name, "view": view, "cwd": cwd, "branch": branch, "model": model,
              "resumed_from": {"run": old_run["id"], "name": old_name}, "worktree_recreated": recreated,
              "compaction": compaction, "notes": notes}

    if view == "bg":
        # A copy of the conversation, so it gets this run's identity (see launch_bg); the task waits in its mailbox.
        path = record(run_id, me, name, "task", task) if task else None
        prompt = doorbell_text(load_run(run_id), me, name, "task", task or "", first=True)
        try:
            bg_id, new_session = launch_bg(name, cwd, model, effort, env, prompt, resume=session)
        except MeshError as exc:  # as in spawn_worker: the conversation reopens in a pane instead
            notes.append(f"{exc}; reopening in a pane instead")
        else:
            with editing_run(run_id) as run:
                run["agents"][name].update(bg_id=bg_id, session=new_session, sessions=[session], status="running")
            log_event(run_id, "resume", name=name, kind=old["kind"], model=model, view="bg", bg_id=bg_id, parent=me,
                      from_run=old_run["id"], from_name=old_name, session=new_session)
            result.update(bg_id=bg_id, session=new_session)
            if path:
                result["delivery"] = {"stored": str(path), "rung": False, "error": None, "launched": True}
            return result
    else:
        path = None

    pane, tab, workspace_id, _ = place_pane(run_id, name, repo_top, Path(cwd), env)
    with editing_run(run_id) as run:
        run["agents"][name].update(view="pane", pane=pane, tab=tab, workspace=workspace_id)
    result["view"] = "pane"
    log_event(run_id, "resume", name=name, kind=old["kind"], model=model, pane=pane, parent=me,
              from_run=old_run["id"], from_name=old_name, session=session)

    start_agent(name, old["kind"], pane, [*log_argv(log), *resume_argv(old["kind"], session, model, effort),
                                          "--dangerously-skip-permissions"])
    with editing_run(run_id) as run:
        run["agents"][name]["status"] = "running"

    result.update(pane=pane, workspace=workspace_id, session=session)
    if path:  # stored before a background launch that fell back to this pane
        rung, error = ring([name, pane], doorbell_text(load_run(run_id), me, name, "task", task, first=True))
        result["delivery"] = {"stored": str(path), "rung": rung, "error": error}
    elif task:
        result["delivery"] = deliver(run_id, me, name, "task", task, first=True)
    return result


def cmd_open(args: argparse.Namespace) -> int:
    """Reopen a past worker's conversation in this terminal, outside any run, for the user.

    A background worker that is still running is attached to instead (`claude attach`): that is how the
    user watches one, or types into it, from any herdr pane.
    """
    _, _, name, entry = find_worker(args.ref, args.from_run)
    holder = live_holder(name, entry, agents=[]) if entry.get("view") == "bg" else None
    if holder and holder.get("bg_id"):
        print(f"mesh: attaching to {name}, a background session ({holder['bg_id']}); detaching leaves it running",
              file=sys.stderr)
        os.execvp(claude_bin(), [claude_bin(), "attach", holder["bg_id"]])

    def live_hint(name, entry):
        try:
            holder = live_holder(name, entry)
        except MeshError:
            return None  # outside herdr: nothing to check against
        if holder:
            holder["hint"] = f"go there with `herdr agent focus {holder.get('name') or holder.get('pane_id')}`"
        return holder

    run, name, entry, session = resumable(args.ref, args.from_run, live_hint)
    model, effort = resumed_model(entry, args.model, args.effort)
    branch = entry_branch(run, entry)
    recreated = ensure_worktree(entry, branch)
    extra = args.extra[1:] if args.extra[:1] == ["--"] else args.extra
    argv = [entry["kind"], *resume_argv(entry["kind"], session, model, effort), *extra]
    note = f"; the worktree was recreated, remove it with `git worktree remove {entry['cwd']}` when done" if recreated else ""
    print(f"mesh: opening {name} from run {run['id']} ({entry['kind']} {model}) in {entry['cwd']}"
          f" on {branch or 'its checkout'}{note}", file=sys.stderr)
    env = {k: v for k, v in os.environ.items() if not k.startswith("MESH_")}
    os.chdir(entry["cwd"])
    os.execvpe(argv[0], argv, env)
    return 0  # not reached


# ── questions and reviews ────────────────────────────────────────────────


def pr_ref(review: str, repo: Path) -> tuple[str, int]:
    """A PR's link and number, from a link or from a number and the repo's GitHub remote."""
    match = PR_RE.search(review)
    if match:
        return match.group(0), int(match.group(0).rsplit("/", 1)[1])
    if not review.lstrip("#").isdigit():
        raise MeshError(f"--review takes a PR link or number, not {review}")
    try:
        remote = git("remote", "get-url", "origin", cwd=repo)
    except MeshError:
        remote = "none"
    github = GITHUB_REMOTE_RE.search(remote)
    if not github:
        raise MeshError(f"{repo}'s origin ({remote}) is not on GitHub; pass the PR link")
    number = int(review.lstrip("#"))
    return f"https://github.com/{github.group(1)}/{github.group(2)}/pull/{number}", number


def pr_head(repo: Path, pr: str, number: int) -> str:
    """Fetch a PR's head commit from the remote it belongs to (`upstream` in a fork), refusing another repo's PR."""
    github_remotes = {}
    for remote in git("remote", cwd=repo).split():
        github = GITHUB_REMOTE_RE.search(git("remote", "get-url", remote, cwd=repo))
        if github:
            github_remotes[remote] = f"github.com/{github.group(1)}/{github.group(2)}/pull/".lower()
    remote = next((r for r, prefix in github_remotes.items() if prefix in pr.lower()), None)
    if not remote:
        if github_remotes:
            raise MeshError(f"{pr} is not a PR of {repo.name} (remotes: {', '.join(github_remotes)}); "
                            f"pass that PR's repo")
        remote = "origin"  # not on GitHub (a mirror, say): trust that it serves pull/<n>/head
    git("fetch", "-q", remote, f"pull/{number}/head", cwd=repo)
    return git("rev-parse", "FETCH_HEAD", cwd=repo)


ASK_SLUG_SKIP = {"a", "an", "and", "are", "can", "do", "does", "for", "how", "in", "is", "it", "of", "on", "the",
                 "to", "we", "what", "when", "where", "which", "who", "why", "with"}


def free_slug(run_id: str, repo_top: Path, slug: str) -> str:
    """`slug`, or `slug-2`, `-3`… when its run branch already exists (a retired asker keeps its branch), or
    another ask of this run has claimed it but not yet made the branch.

    A named one (`--name`) too, since `/delegate-review` always passes one. Picked and claimed under the run
    lock, so two asks of one kind for one PR started at the same moment get different slugs, and with them
    different agent names.
    """
    def taken(candidate: str, claimed: list[str]) -> bool:
        if candidate in claimed:
            return True
        try:
            git("rev-parse", "--verify", "--quiet", f"refs/heads/mesh/{run_id}/{candidate}", cwd=repo_top)
            return True
        except MeshError:
            return False
    slug = slugify(slug, 24)
    with editing_run(run_id) as run:
        claimed = run.setdefault("slugs", {}).setdefault(str(repo_top), [])
        found, n = slug, 2
        while taken(found, claimed):  # cut to fit `-N` in an agent name's suffix, so the name differs too
            found, n = f"{slug[:19 - len(str(n))].rstrip('-')}-{n}", n + 1
        claimed.append(found)
    return found


def ask_slug(body: str) -> str:
    """`ask-` plus the question's first telling words, within an agent name's 20-character suffix."""
    slug = "ask"
    for word in re.findall(r"[a-z0-9]+", body.lower()):
        if word in ASK_SLUG_SKIP:
            continue
        if len(slug) + 1 + len(word) > 20:
            break
        slug += f"-{word}"
    return slug


def pr_diff(pr: str) -> str:
    """The PR's diff for a review task, so the reviewer starts from the whole change; a note when it doesn't fit."""
    result = run_cli(["gh", "pr", "diff", pr], timeout=60)
    if result.returncode or not result.stdout.strip():
        return ""
    if len(result.stdout) > REVIEW_DIFF_MAX:
        return f"The diff is too long to include here ({len(result.stdout):,} characters): read it with `gh pr diff {pr}`."
    return f"The change (`gh pr diff {pr}`):\n\n````diff\n{result.stdout.rstrip()}\n````"


def ask_task(body: str, pr: str | None, number: int | None, fresh: bool) -> str:
    if pr:
        where = (REVIEW_FRESH if fresh else REVIEW_OWN).format(pr=pr, n=number)
        task = REVIEW_PREFIX.format(pr=pr, where=where)
    else:
        task = ASK_PREFIX
    diff = pr_diff(pr) if pr else ""
    return task + "".join(f"\n\n{part}" for part in (body, diff) if part)


def take_reply(run_id: str, me: str, sender: str) -> tuple[dict, str] | None:
    """The last done/failed `sender` sent me, marked read. Found through the log, since the doorbell
    it rang may already have had me read it with `mesh inbox`."""
    sends = [e for e in read_log(run_id) if e.get("event") == "send" and e.get("sender") == sender
             and e.get("to") == me and e.get("type") in FINAL_TYPES]
    if not sends:
        return None
    folder = inbox_dir(run_id, me)
    path = next((p for p in (folder / sends[-1]["file"], folder / "read" / sends[-1]["file"]) if p.exists()), None)
    if not path:
        return None
    meta, body = parse_message(path)
    if path.parent == folder:
        mark_read(path)
    return meta, body.strip()


def copilot_model_argv(model: str, effort: str) -> list[str]:
    # Auto picks the model per prompt and refuses an effort; it takes a routing profile instead.
    return ["--model", model, *(["--auto-tier", COPILOT_TIER] if model == "auto" else ["--reasoning-effort", effort])]


def copilot_answer(stdout: str) -> tuple[str, str | None]:
    """The last thing Copilot said and the model it said it on, from its `--output-format json` lines."""
    text, model = "", None
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(event, dict):
            continue
        data = event.get("data")
        if event.get("type") == "assistant.message" and isinstance(data, dict) and (data.get("content") or "").strip():
            text, model = data["content"].strip(), data.get("model") or model
    return text, model


def copilot_ask(run_id: str, me: str, name: str, task: str, timeout: float) -> None:
    """Put one read-only task to a Copilot asker, headless, and file its answer as its `done` (or `failed`).

    The caller has marked the entry `running` with this process's pid (`claim_copilot`). Every task goes
    under the session id recorded at spawn, which starts the session the first time and
    resumes it after, so the asker keeps what it read. The prompt goes on stdin: a review's diff can be
    larger than one command-line argument may be.
    """
    entry = agent_entry(load_run(run_id), name)
    mark_read(record(run_id, me, name, "task", task))  # kept as the record; it reaches Copilot as the prompt
    argv = ["copilot", "--output-format", "json", "--allow-all-tools", "--deny-tool", *COPILOT_DENY, "--no-ask-user",
            "--session-id", entry["session"], *copilot_model_argv(entry["requested_model"], entry["effort"])]
    log_event(run_id, "copilot", name=name)
    # No mesh identity: it answers through its output, never with `mesh send`.
    result = run_cli(argv, cwd=entry["cwd"], env=env_without_identity(keep_herdr=False), timeout=timeout or None,
                     input=f"{task}\n\n{COPILOT_NOTE}")
    text, model = copilot_answer(result.stdout)
    answered = bool(text) and result.returncode == 0
    # The answer is filed while the entry still counts as working, so a `mesh watch` on it sees the report.
    if answered:
        record(run_id, name, me, "done", text)
    elif result.returncode == 0:
        record(run_id, name, me, "failed", "copilot gave no answer (exit 0)")
    else:
        error = result.stderr.strip().splitlines()[-1:] or [f"exit {result.returncode}"]
        record(run_id, name, me, "failed", f"copilot exited {result.returncode}: {error[0]}")
    with editing_run(run_id) as run:
        agent = run["agents"][name]
        agent["status"] = "retired"
        agent.pop("pid", None)
        if answered:
            agent["model"] = model or agent["model"]


def refuse_busy(name: str, entry: dict) -> None:
    holder = live_holder(name, entry)
    if holder and holder.get("pid"):
        raise MeshError(f"{name} is still answering in mesh process {holder['pid']}; ask it again once that finishes")


def claim_copilot(entry: dict) -> None:
    """Mark a Copilot asker busy for this `mesh ask` (see live_holder); copilot_ask releases it."""
    entry.update(status="running", pid=os.getpid())


def open_peek(run_id: str, name: str, cwd: Path) -> str | None:
    """A pane beside the root that follows a Copilot asker (`mesh peek --follow`), so the user sees it work.

    Only beside the root, where the user is looking; None when that tab is full or gone, or herdr refuses.
    """
    if stale := agent_entry(load_run(run_id), name).get("pane"):  # left by a `mesh ask` that was killed
        close_peek(run_id, name, stale)
    env = {key: os.environ[key] for key in ("MESH_HOME", "COPILOT_HOME") if os.environ.get(key)}
    try:
        beside = beside_root(run_id, name, cwd, env)
    except MeshError:
        return None
    if not beside:
        return None
    pane, tab, workspace = beside
    try:
        herdr("pane", "rename", pane, f"{name} (Copilot)")
        herdr("pane", "run", pane, shlex.join(["mesh", "peek", name, "--from-run", run_id, "--follow"]))
    except MeshError:
        close_peek(run_id, name, pane)
        return None
    with editing_run(run_id) as run:
        run["agents"][name].update(pane=pane, tab=tab, workspace=workspace)
    return pane


def close_peek(run_id: str, name: str, pane: str) -> None:
    try:
        herdr("pane", "close", pane)
    except MeshError:
        pass  # the user closed it already
    with editing_run(run_id) as run:
        run["agents"][name].update(pane=None, tab=None, workspace=None)


def ask_copilot(args: argparse.Namespace, run_id: str, me: str, repo: Path, target, task: str,
                pr: str | None, number: int | None, base: str | None, body: str) -> int:
    """`mesh ask` for Copilot: no pane and no doorbell, the answer is what `copilot` prints (copilot_ask)."""
    ignored = [flag for flag, on in (("--keep", args.keep), ("--no-wait", args.no_wait), ("--wait", args.wait),
                                     ("--view", args.view), ("--compact", args.compact != "auto"),
                                     ("--focus", args.focus)) if on]
    if ignored:
        print(f"mesh: {', '.join(ignored)} don't apply to a headless Copilot asker", file=sys.stderr)
    if target:
        old_run, _, old_name, old = target
        if old_run["id"] != run_id:
            refuse_busy(old_name, old)
        branch = entry_branch(old_run, old)
        ensure_worktree(old, branch)
        name = old_name
        with editing_run(run_id) as run:
            if old_run["id"] != run_id:
                # A Copilot asker from an earlier run comes back as this run's, as `mesh resume` brings a worker.
                taken, n = set(run["agents"]) | live_agent_names(), 2
                while name in taken:
                    name, n = f"{old_name[:29]}-{n}", n + 1
                run["agents"][name] = {**old, "parent": me, "resumed_from": {"run": old_run["id"], "name": old_name}}
                worktrees = run.setdefault("worktrees", [])
                if branch and not any(Path(w["path"]) == Path(old["cwd"]) for w in worktrees):
                    base_sha = {"base": old["base"]} if old.get("base") else {}
                    worktrees.append({"path": old["cwd"], "repo": old["repo"], "branch": branch, **base_sha})
            else:
                refuse_busy(name, run["agents"][name])  # checked and claimed under one lock (below)
            if args.model or args.effort:
                run["agents"][name].update(requested_model=args.model or old["requested_model"],
                                           effort=args.effort or old["effort"])
            claim_copilot(run["agents"][name])
        how = "asked"
    else:
        taken = set(load_run(run_id)["agents"]) | live_agent_names()
        slug = free_slug(run_id, repo, args.name or (f"review-{number}-copilot" if pr else ask_slug(body)))
        name = agent_name(repo.name, slug, taken)
        cwd, branch, base = add_worktree(run_id, repo, slugify(slug, 24), base)
        model = args.model or os.environ.get("MESH_COPILOT_MODEL") or COPILOT_MODEL
        size = args.size or "small"
        effort = args.effort or COPILOT_EFFORT[size]
        with editing_run(run_id) as run:
            run["agents"][name] = {
                "role": "worker", "kind": "copilot", "model": model, "requested_model": model, "effort": effort,
                "size": size, "view": "headless", "repo": str(repo), "cwd": str(cwd), "branch": branch,
                "base": base, "session": str(uuid.uuid4()), "pane": None, "tab": None, "workspace": None,
                "parent": me, "status": "starting", "spawned": now_iso(), "log": None, "phase": None,
                "models": [{"model": model, "effort": effort, "at": now_iso(), "why": "spawn"}],
            }
            claim_copilot(run["agents"][name])
        log_event(run_id, "spawn", name=name, kind="copilot", role="worker", model=model, view="headless", parent=me)
        how = "started"
    if pr:
        with editing_run(run_id) as run:
            reviews = run["agents"][name].setdefault("reviews", [])
            if pr not in reviews:
                reviews.append(pr)
    peek = open_peek(run_id, name, Path(agent_entry(load_run(run_id), name)["cwd"]))
    follow = f"in pane {peek}" if peek else f"with `mesh peek {name} --follow`"
    print(f"mesh: {how} {name} (Copilot, headless); waiting for its answer (follow it {follow})", file=sys.stderr)
    try:
        copilot_ask(run_id, me, name, task, args.timeout)
    finally:
        if peek:
            close_peek(run_id, name, peek)
    meta, text = take_reply(run_id, me, name)
    print(f"── {meta.get('type')} from {name} ──\n{text}\n")
    print(f"(ask again: `mesh ask {name} --body …`, which resumes its Copilot session)")
    return 0 if meta.get("type") == "done" else 1


def copilot_events(entry: dict) -> Path:
    """The file Copilot writes every event of an asker's session to."""
    home = Path(os.environ.get("COPILOT_HOME") or Path.home() / ".copilot")
    return home / "session-state" / entry["session"] / "events.jsonl"


def peek_line(line: str) -> str | None:
    """One Copilot event as a line of `mesh peek`: a tool it started, or something it said."""
    try:
        event = json.loads(line)
    except json.JSONDecodeError:
        return None
    if not isinstance(event, dict) or not isinstance(event.get("data"), dict):
        return None
    data, at = event["data"], str(event.get("timestamp") or "")[11:19]
    if event.get("type") == "tool.execution_start":
        args = data.get("arguments") if isinstance(data.get("arguments"), dict) else {}
        what = next((args[k] for k in ("description", "command", "path", "pattern") if args.get(k)), "")
        return f"{at} {data.get('toolName')}: {first_line(str(what), 140)}"
    if event.get("type") == "assistant.message" and (data.get("content") or "").strip():
        return f"{at} says: {first_line(data['content'], 140)}"
    return None


def cmd_peek(args: argparse.Namespace) -> int:
    """Show what a Copilot asker is doing, from its session's events, since it has no pane to look at."""
    _, folder, name, entry = find_worker(args.ref, args.from_run)
    if entry.get("kind") != "copilot":
        look = f"`claude attach {entry['bg_id']}`" if entry.get("bg_id") else f"`herdr agent read {name}`"
        raise MeshError(f"{name} is a {entry.get('kind')} worker; look at it with {look}")
    path = copilot_events(entry)
    while args.follow and not path.exists() and agent_status(name, entry) == "working":
        time.sleep(1)  # Copilot writes the file once the session starts
        entry = json.loads((folder / "run.json").read_text())["agents"][name]
    if not path.exists():
        raise MeshError(f"{name} has no Copilot session yet ({path})")
    with path.open() as f:
        lines = [shown for shown in map(peek_line, f) if shown]
        offset = f.tell()
    for shown in lines[-args.lines:]:
        print(shown)
    if not args.follow:
        return 0
    pending = ""  # a line Copilot is still writing
    while True:
        with path.open() as f:
            f.seek(offset)
            pending += f.read()
            offset = f.tell()
        *complete, pending = pending.split("\n")
        for shown in map(peek_line, complete):
            if shown:
                print(shown, flush=True)
        entry = json.loads((folder / "run.json").read_text())["agents"][name]
        if agent_status(name, entry) != "working":
            print(f"({name} is not answering now: its answer is what `mesh ask` printed, or `mesh inbox`)")
            return 0
        time.sleep(1)


def cmd_ask(args: argparse.Namespace) -> int:
    """Ask a worker, or a fresh agent in a repo, a question or for a PR review, and wait for the answer."""
    if bool(args.ref) == bool(args.repo):
        raise MeshError("ask whom? pass a worker (name, branch or PR link, see `mesh agents`) or --repo for a fresh agent")
    if args.kind and args.ref:
        raise MeshError("--kind is for a fresh agent (--repo); a worker keeps its own CLI")
    copilot = args.kind == "copilot"
    body = (read_body(args.body, args.file) or "").strip()
    if not body and not args.review:
        raise MeshError("empty question: pass --body TEXT or --file PATH (- for stdin), or --review PR")

    # Resolve everything that can fail before anything is started.
    target = None
    if args.repo:
        repo = Path(git("rev-parse", "--show-toplevel", cwd=Path(args.repo).expanduser())).resolve()
    else:
        target = find_worker(args.ref)
        repo = Path(target[3]["repo"]) if target[3].get("repo") else Path.cwd()
        copilot = target[3].get("kind") == "copilot"
    pr, number = pr_ref(args.review, repo) if args.review else (None, None)
    task = ask_task(body, pr, number, fresh=bool(args.repo))
    base = pr_head(repo, pr, number) if pr and args.repo else None

    try:
        run_id, me = identity(args)
    except MeshError as err:
        if getattr(args, "run", None) or isinstance(err, PaneRefused):
            raise
        mode = None if copilot else args.kind or "agy"  # a Copilot asker's run is in the root's own mode
        started = init_run(mode, (body.splitlines() or [f"review {pr}"])[0][:200])
        run_id, me = started["run"], started["name"]
        print(f"mesh: started run {run_id}", file=sys.stderr)
    if agent_entry(load_run(run_id), me)["role"] != "root":
        raise MeshError("only the root asks: a worker sends its parent a `question` instead")
    if copilot:
        return ask_copilot(args, run_id, me, repo, target, task, pr, number, base, body)

    if args.repo:
        kind = args.kind or load_run(run_id)["mode"]
        slug = free_slug(run_id, repo, args.name or (f"review-{number}-{kind}" if pr else ask_slug(body)))
        # A large reviewer already plans at DEFAULT_EFFORT; passing REVIEW_EFFORT there would read as a named
        # effort and carry into the execution phase of a fix it is later given.
        sized = (kind, args.size or "large") in SIZE_DEFAULTS
        spawn = argparse.Namespace(
            kind=kind, role="worker", repo=str(repo), model=args.model,
            exec_model=None, effort=args.effort or (REVIEW_EFFORT if pr and sized else None), exec_effort=None,
            name=args.name and slug, worktree=slug,  # a taken --name gets the same -2 as its branch
            cwd=None, base=base, parent=None, task=task, task_file=None, size=args.size,
            view=args.view or ("pane" if pr else None), plan_review=None,  # the user watches a review
            pinned=bool((args.model and args.model != "auto") or args.effort))
        finals, how = 0, "started"
    else:
        old_run, _, name, entry = target
        state = (agent_status(name, entry) if old_run["id"] == run_id and entry.get("status") != "retired"
                 else "gone")
        if state != "gone":
            finals, how, spawn = sends_from(run_id, name, FINAL_TYPES), "asked", None
            if state == "working" and not args.no_wait:
                # Its next `done` would be for the task it's on, not this question.
                print(f"mesh: {name} is busy, so its answer will come after its current task", file=sys.stderr)
                args.no_wait = True
        else:
            # Counted before the task goes out, so a quick answer still counts (a same-run resume keeps the name).
            finals, how, spawn = sends_from(run_id, name, FINAL_TYPES) if old_run["id"] == run_id else 0, "resumed", None
            resume = argparse.Namespace(ref=name, from_run=old_run["id"], model=args.model, effort=args.effort,
                                        task=task, task_file=None, view=args.view, compact=args.compact,
                                        focus=args.focus or COMPACT_FOCUS.format(
                                            task=first_line(body) or f"a review of {pr}"), read_only=True)
    if how == "started":
        result = spawn_worker(spawn, run_id, me)
    elif how == "resumed":
        result = resume_worker(resume, run_id, me)
        if result["name"] != name:
            finals = 0
    else:
        result = {"name": name, "delivery": deliver(run_id, me, name, "task", task)}
    name = result["name"]
    if pr:
        with editing_run(run_id) as run:
            reviews = run["agents"][name].setdefault("reviews", [])
            if pr not in reviews:
                reviews.append(pr)  # so `mesh resume <pr>` still finds the author, not the reviewer

    delivery = result.get("delivery") or {}
    if "send_message" in delivery:
        emit(result)
        print(f"mesh: stored; now send it to {name} with SendMessage (`to` and `message` as in send_message). "
              "Its answer comes back the same way.", file=sys.stderr)
        return 0
    if not delivered(delivery):
        emit(result)
        print(f"warning: stored, but the doorbell did not ring ({delivery.get('error')}); "
              f"retry with `mesh ring {name}`, then `mesh watch {name}`", file=sys.stderr)
        return 2
    entry = agent_entry(load_run(run_id), name)
    if (not args.wait and entry.get("kind") == "claude"
            and native_route(load_run(run_id), name, me)):  # the answer comes as a SendMessage from the worker
        args.no_wait = True
    if args.no_wait:
        emit(result)
        return 0
    print(f"mesh: {how} {name}; waiting for its answer", file=sys.stderr)
    status, line = watch_agent(run_id, name, args.timeout, finals_at_start=finals)
    reply = take_reply(run_id, me, name) if status == 0 else None
    if not reply:
        print(line)
        return status
    meta, text = reply
    print(f"── {meta.get('type')} from {name} ──\n{text}\n")
    if how != "asked" and not args.keep:  # an asker this call opened is done; one already at work stays
        retire_worker(run_id, name, agent_entry(load_run(run_id), name))
        print(f"({name} is closed. Ask again with `mesh ask {name} --body …`, which reopens its conversation; "
              f"give it a change with `mesh resume {name} --task-file …`)")
    else:
        print(f"(ask again: `mesh ask {name} --body …`; give it a change to make: `mesh send {name} --type task`)")
    return 0


def cmd_worktree(args: argparse.Namespace) -> int:
    run_id, _ = identity(args)
    repo_top = Path(git("rev-parse", "--show-toplevel", cwd=Path(args.repo).expanduser())).resolve()
    path, branch, _ = add_worktree(run_id, repo_top, slugify(args.slug, 24), args.base)
    emit({"path": str(path), "branch": branch})
    return 0


def untouched_branch(wt: dict) -> bool:
    """A run branch still at the commit it started from and never pushed: deleting it loses nothing,
    and `ensure_worktree` can start it again from that base."""
    if not wt.get("base"):
        return False  # runs before 0.6 recorded no base
    try:
        if git("rev-parse", f"refs/heads/{wt['branch']}", cwd=wt["repo"]) != wt["base"]:
            return False
    except MeshError:
        return False
    try:
        git("rev-parse", "--abbrev-ref", f"{wt['branch']}@{{upstream}}", cwd=wt["repo"])
        return False
    except MeshError:
        return True


def merge_conflicts(repo: str, ours: str, theirs: str) -> list[str] | None:
    """Files that conflict when `theirs` merges into `ours`, without touching any checkout; None if it's clean."""
    proc = subprocess.run(["git", "merge-tree", "--write-tree", "--name-only", "--no-messages", ours, theirs],
                          cwd=repo, capture_output=True, text=True)
    if proc.returncode == 0:
        return None
    if proc.returncode == 1:
        return [line for line in proc.stdout.splitlines()[1:] if line.strip()]
    if "write-tree" in proc.stderr or "usage" in proc.stderr:
        raise MeshError("`mesh conflicts` needs git 2.38 or newer (`git merge-tree --write-tree`)")
    raise MeshError(f"git merge-tree {ours} {theirs}: {proc.stderr.strip()}")


def contains(repo: str, ancestor: str, ref: str) -> bool:
    return subprocess.run(["git", "merge-base", "--is-ancestor", ancestor, ref], cwd=repo).returncode == 0


def cmd_conflicts(args: argparse.Namespace) -> int:
    """Which run branches with commits conflict with their repo's default branch, or with each other."""
    run_id = args.run_id or identity(args)[0]
    by_repo: dict[str, list[str]] = {}
    for wt in load_run(run_id).get("worktrees", []):
        try:
            tip = git("rev-parse", f"refs/heads/{wt['branch']}", cwd=wt["repo"])
        except MeshError:
            continue  # deleted
        if tip != wt.get("base") and wt["branch"] not in by_repo.get(wt["repo"], []):
            by_repo.setdefault(wt["repo"], []).append(wt["branch"])
    rows = []
    for repo, branches in by_repo.items():
        target = default_base(Path(repo))
        pairs = [(b, target) for b in branches]
        # Stacked branches (one built on the other) are meant to overlap: skip those pairs.
        pairs += [(a, b) for i, a in enumerate(branches) for b in branches[i + 1:]
                  if not contains(repo, a, b) and not contains(repo, b, a)]
        for branch, against in pairs:
            files = merge_conflicts(repo, against, branch)
            if files is not None:
                rows.append({"repo": Path(repo).name, "branch": branch, "against": against, "files": files})
    if args.json:
        emit(rows)
    elif not rows:
        print(f"No conflicts among {sum(len(b) for b in by_repo.values())} branch(es) with commits.")
    else:
        print_table([{**r, "files": " ".join(r["files"])} for r in rows], ("repo", "branch", "against", "files"))
    return 0


def cmd_stop(args: argparse.Namespace) -> int:
    run_id = args.run_id or identity(args)[0]
    run = load_run(run_id)
    for name, entry in run["agents"].items():
        if entry.get("view") == "headless":
            # Removing its worktree and archiving the run under it would lose the answer.
            holder = live_holder(name, entry)
            if holder:
                raise MeshError(f"{name} is still answering in mesh process {holder['pid']}; wait for that "
                                f"`mesh ask` to finish (or kill it), then stop the run")
    closed, kept, removed, deleted = [], [], [], []
    for name, entry in run["agents"].items():
        if entry.get("view") == "headless" and entry.get("pane"):  # a peek pane a killed `mesh ask` left open
            close_peek(run_id, name, entry["pane"])
        if entry["role"] == "root" or entry.get("status") == "retired" or entry.get("view") == "headless":
            continue
        if entry.get("view") == "bg":
            if stop_bg(entry):  # the conversation is kept, so it can be resumed
                closed.append(name)
            continue
        try:
            herdr("pane", "close", entry["pane"])
            closed.append(name)
        except HerdrError:
            pass
    for tab in run.get("tabs", {}).values():
        try:
            herdr("tab", "close", tab)
        except HerdrError:
            pass
    for wt in run.get("worktrees", []):
        path = Path(wt["path"])
        if not path.exists():
            continue
        dirty = subprocess.run(["git", "status", "--porcelain"], cwd=path, capture_output=True, text=True).stdout.strip()
        if dirty or args.keep_worktrees:
            kept.append({"path": str(path), "branch": wt["branch"], "dirty": bool(dirty)})
            continue
        git("worktree", "remove", str(path), cwd=wt["repo"])
        removed.append({"path": str(path), "branch": wt["branch"]})
        if untouched_branch(wt):
            git("branch", "-D", wt["branch"], cwd=wt["repo"])
            deleted.append(wt["branch"])
    run_worktrees = worktree_root() / run_id
    if run_worktrees.is_dir() and not any(run_worktrees.iterdir()):
        run_worktrees.rmdir()
    root = run["agents"][run["root"]]
    if root.get("renamed", True):
        try:
            herdr("agent", "rename", root["pane"], "--clear")
        except HerdrError:
            pass
    (mesh_home() / "by-pane" / f"{pane_key(root['pane'])}.json").unlink(missing_ok=True)
    log_event(run_id, "stop", closed=closed, kept=[k["path"] for k in kept])
    archive = mesh_home() / "archive" / run_id
    archive.parent.mkdir(parents=True, exist_ok=True)
    os.replace(run_dir(run_id), archive)
    emit({"run": run_id, "closed": closed, "worktrees_removed": removed, "worktrees_kept": kept,
          "archive": str(archive), "branches_deleted": deleted,
          "branches_kept": [w["branch"] for w in run.get("worktrees", []) if w["branch"] not in deleted]})
    return 0


def cmd_whoami(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    entry = agent_entry(load_run(run_id), me)
    run = load_run(run_id)
    to_parent = native_route(run, me, entry["parent"]) if entry.get("parent") in run["agents"] else None
    emit({"run": run_id, "name": me, "role": entry["role"], "parent": entry.get("parent"),
          "dir": str(run_dir(run_id)), "unread": len(unread(run_id, me)), "view": entry.get("view"),
          "reports_by": "SendMessage" if to_parent else "doorbell"})
    return 0


def cmd_dir(args: argparse.Namespace) -> int:
    print(run_dir(identity(args)[0]))
    return 0


def cmd_model(args: argparse.Namespace) -> int:
    if (args.model or "auto") == "auto":
        model, notes = plan_model(args.kind, args.effort)
        for note in notes:
            print(f"mesh: {note}", file=sys.stderr)
    else:
        model = args.model
    print(agent_argv(args.kind, model, args.effort)[1])
    return 0


def cmd_usage(args: argparse.Namespace) -> int:
    rows = agy_usage(force=args.refresh)
    if rows is None:
        raise MeshError("`agy -p /usage` gave no quota rows")
    plan, notes = choose_agy_model(PLAN_CHAIN["agy"], args.effort)
    execute = resolve_agy_model(EXEC_MODEL["agy"], args.exec_effort)
    names = listing_names(agy_model_listing())
    exec_quota = model_quota(execute, names.get(execute, ""), rows)
    if args.json:
        emit({"rows": rows, "plan": plan, "exec": execute, "exec_left": exec_quota and exec_quota[0],
              "notes": notes, "min_quota": min_quota()})
        return 0
    print_table(rows, ("group", "label", "left", "resets"))
    print(f"\nplan on {plan}, execute on {execute}"
          + (f" ({exec_quota[0]}% left)" if exec_quota else "") + f"; threshold {min_quota()}%")
    for note in notes:
        print(f"  {note}")
    return 0


# ── CLI ──────────────────────────────────────────────────────────────────


def compact_args(p: argparse.ArgumentParser) -> None:
    p.add_argument("--compact", choices=("auto", "yes", "no"), default="auto",
                   help=f"compact the conversation before reopening it (auto: over {COMPACT_AT:,} tokens for Claude, "
                        f"{AGY_COMPACT_AT:,} for agy, twice that for a question; an agy one whose size can't be "
                        "read when it comes from another run)")
    p.add_argument("--focus", help="what the compaction keeps (default: what the task needs)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="mesh", description=__doc__.split("\n\n")[0])
    parser.add_argument("--version", action="version", version=f"mesh {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    def ident(p):
        p.add_argument("--run", help="run id (default: $MESH_RUN or this pane's run)")
        p.add_argument("--as", dest="as_", help="act as this agent (default: $MESH_SELF)")
        return p

    p = sub.add_parser("init", help="start a run with this pane's agent as its root")
    p.add_argument("--mode", choices=MODES, required=True)
    p.add_argument("--request", help="the user's request, kept in run.json")
    p.add_argument("--run-id", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_init)

    p = ident(sub.add_parser("spawn", help="start a worker agent in a herdr pane, or in the background"))
    p.add_argument("--kind", choices=KINDS, default="agy", help="default: agy")
    p.add_argument("--role", choices=ROLES, default="worker")
    p.add_argument("--repo", default=".", help="repo the agent works on (default: cwd)")
    p.add_argument("--model", help="auto (default: plan on the best model with quota, execute on --exec-model), "
                                    "or one model throughout: claude alias, agy family (argon, flash, opus, sonnet) or exact id")
    p.add_argument("--exec-model", help="model after `mesh approve` (default with auto: agy flash, claude opus)")
    p.add_argument("--effort", choices=EFFORTS,
                   help=f"effort for the whole task, planning and execution (default: {DEFAULT_EFFORT} planning, "
                        f"{EXEC_EFFORT} executing)")
    p.add_argument("--exec-effort", choices=EFFORTS,
                   help=f"effort after `mesh approve` (default: --effort, else {EXEC_EFFORT})")
    p.add_argument("--name", help="what goes after the repo in the agent's name (default: the worktree slug)")
    where = p.add_mutually_exclusive_group()
    where.add_argument("--worktree", metavar="SLUG", help="create a worktree on branch mesh/<run>/<SLUG>")
    where.add_argument("--cwd", help="start in an existing directory, e.g. an earlier worker's worktree")
    p.add_argument("--base", help="base ref for --worktree (default: origin/HEAD)")
    p.add_argument("--parent", help="parent agent (default: you)")
    p.add_argument("--task", help="first task message")
    p.add_argument("--task-file", help="first task message from a file (- for stdin)")
    p.add_argument("--size", choices=SIZES, help="trivial / small: one model, no plan phase (claude: opus, "
                                                  "in the background); large (default): plan, review, execute")
    p.add_argument("--view", choices=VIEWS, help="pane (herdr) or bg (`claude --bg`, Claude only; default by size)")
    p.add_argument("--plan-review", choices=("user",),
                   help="user: the user approves the plan in the worker's pane (claude, opus in plan mode)")
    p.set_defaults(func=cmd_spawn)

    p = ident(sub.add_parser("send", help="send a message (mailbox first, then the doorbell)"))
    p.add_argument("to", help="agent name, or `parent`")
    p.add_argument("--type", choices=TYPES, required=True)
    p.add_argument("--body")
    p.add_argument("--file", help="message body from a file (- for stdin)")
    p.set_defaults(func=cmd_send)

    p = ident(sub.add_parser("inbox", help="print unread messages and mark them read"))
    p.add_argument("--peek", action="store_true", help="do not mark as read")
    p.add_argument("--all", action="store_true", help="include already-read messages")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_inbox)

    p = ident(sub.add_parser("ring", help="re-ring an agent that has unread messages"))
    p.add_argument("agent")
    p.set_defaults(func=cmd_ring)

    p = ident(sub.add_parser("status", help="agents of a run with live herdr state"))
    p.add_argument("run_id", nargs="?")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_status)

    p = ident(sub.add_parser("watch", help="watchdog: exits when a child reports or stalls"))
    p.add_argument("agent", nargs="?")
    p.add_argument("--any", action="store_true", help="every live worker of the run: exit on the first event")
    p.add_argument("--alerts", action="store_true",
                   help="alerts only: keep watching through done/failed (for workers that report by SendMessage)")
    p.add_argument("--run-id")
    p.add_argument("--timeout", type=int, default=0, help="seconds (0 = none)")
    p.add_argument("--interval", type=float, default=5.0)
    p.add_argument("--grace", type=float, default=SETTLE_GRACE,
                   help="seconds a worker must stay idle before it counts as stopped (default %(default)s)")
    p.set_defaults(func=cmd_watch)

    p = ident(sub.add_parser("approve", help="approve a worker's plan, moving an auto worker to its exec model"))
    p.add_argument("agent")
    p.add_argument("--body", help="notes to go with the approval")
    p.add_argument("--file", help="notes from a file (- for stdin)")
    p.add_argument("--keep-model", action="store_true",
                   help="execute on the current model: for when the swap can't start (no conversation found, busy)")
    p.set_defaults(func=cmd_approve)

    p = ident(sub.add_parser("switch", help="move a worker that hit a quota to the next model with quota left"))
    p.add_argument("agent")
    p.add_argument("--model", help="this model instead of the next in the chain")
    p.set_defaults(func=cmd_switch)

    p = ident(sub.add_parser("retire", help="close a child's pane (its worktree stays)"))
    p.add_argument("agent")
    p.set_defaults(func=cmd_retire)

    p = sub.add_parser("agents", help="past and present workers of every run, with branches and PRs")
    p.add_argument("query", nargs="?", help="filter on name, repo, branch or PR link")
    p.add_argument("--run", help="only this run's workers, resumed ones included")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_agents)

    p = ident(sub.add_parser("resume", help="bring a past worker back, with its conversation, into this run"))
    p.add_argument("ref", help="the worker's name, branch or PR link (see `mesh agents`)")
    p.add_argument("--from-run", help="look only in this run (default: the newest match)")
    p.add_argument("--model", help="override the model it ran on (same CLI)")
    p.add_argument("--effort", choices=EFFORTS)
    p.add_argument("--task", help="the follow-up task")
    p.add_argument("--task-file", help="the follow-up task from a file (- for stdin)")
    compact_args(p)
    p.add_argument("--view", choices=VIEWS, help="reopen in a pane or in the background (default: as before)")
    p.set_defaults(func=cmd_resume)

    p = sub.add_parser("open", help="reopen a past worker's conversation in this terminal, outside the mesh")
    p.add_argument("ref", help="the worker's name, branch or PR link (see `mesh agents`)")
    p.add_argument("--from-run", help="look only in this run (default: the newest match)")
    p.add_argument("--model", help="override the model it ran on")
    p.add_argument("--effort", choices=EFFORTS)
    p.add_argument("extra", nargs=argparse.REMAINDER, help="after --: more arguments for the CLI")
    p.set_defaults(func=cmd_open)

    p = sub.add_parser("peek", help="show what a Copilot asker is doing: its latest tool calls and messages")
    p.add_argument("ref", help="the asker's name or branch (see `mesh agents`)")
    p.add_argument("--from-run", help="look only in this run (default: the newest match)")
    p.add_argument("--lines", type=int, default=15, help="how many past events to show (default: 15)")
    p.add_argument("--follow", action="store_true", help="keep printing new events until it stops answering")
    p.set_defaults(func=cmd_peek)

    p = ident(sub.add_parser("ask", help="ask a worker, or a fresh agent in a repo, a question or for a PR review, "
                                         "and wait for the answer"))
    p.add_argument("ref", nargs="?", help="an existing worker: name, branch or PR link (see `mesh agents`)")
    p.add_argument("--repo", help="start a fresh agent in this repo instead")
    p.add_argument("--review", metavar="PR", help="ask for a review of this PR (link, or number in --repo)")
    p.add_argument("--body", help="the question, or notes for the review")
    p.add_argument("--file", help="the question from a file (- for stdin)")
    p.add_argument("--kind", choices=ASK_KINDS,
                   help="a fresh agent's CLI (default: the run's mode, or agy); copilot runs headless, read-only")
    p.add_argument("--model", help="a fresh agent's model (default: auto), or a resumed worker's")
    p.add_argument("--effort", choices=EFFORTS,
                   help=f"default: the size's, or {REVIEW_EFFORT} for a fresh reviewer (not Copilot)")
    p.add_argument("--name", help="what goes after the repo in a fresh agent's name (default: ask-<question>)")
    p.add_argument("--size", choices=SIZES, help="a fresh agent's size (see `mesh spawn --size`)")
    p.add_argument("--view", choices=VIEWS, help="a fresh or resumed agent's view")
    compact_args(p)
    p.add_argument("--no-wait", action="store_true", help="return once the task is delivered")
    p.add_argument("--keep", action="store_true",
                   help="leave the agent open after its answer (default: an agent this call opened is closed)")
    p.add_argument("--wait", action="store_true",
                   help="wait even for a Claude worker under a Claude root, whose answer comes by SendMessage")
    p.add_argument("--timeout", type=int, default=1800, help="seconds to wait for the answer (0 = none)")
    p.set_defaults(func=cmd_ask)

    p = ident(sub.add_parser("worktree", help="create a run worktree, e.g. for integration"))
    p.add_argument("--repo", default=".")
    p.add_argument("--slug", required=True)
    p.add_argument("--base")
    p.set_defaults(func=cmd_worktree)

    p = ident(sub.add_parser("conflicts", help="which of the run's branches conflict with their base or each other"))
    p.add_argument("run_id", nargs="?")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_conflicts)

    p = ident(sub.add_parser("stop", help="close the run's panes, remove clean worktrees, archive"))
    p.add_argument("run_id", nargs="?")
    p.add_argument("--keep-worktrees", action="store_true")
    p.set_defaults(func=cmd_stop)

    sub.add_parser("whoami", help="this agent's run, name, role and parent").set_defaults(func=cmd_whoami)
    ident(sub.choices["whoami"])
    ident(sub.add_parser("dir", help="print the run directory")).set_defaults(func=cmd_dir)

    p = sub.add_parser("model", help="resolve the model a spawn would use")
    p.add_argument("--kind", choices=KINDS, default="agy")
    p.add_argument("--model", help="default: auto")
    p.add_argument("--effort", default=DEFAULT_EFFORT, choices=EFFORTS)
    p.set_defaults(func=cmd_model)

    p = sub.add_parser("usage", help="agy quotas, and the models `auto` would plan and execute on")
    p.add_argument("--effort", default=DEFAULT_EFFORT, choices=EFFORTS, help="planning effort")
    p.add_argument("--exec-effort", default=EXEC_EFFORT, choices=EFFORTS)
    p.add_argument("--refresh", action="store_true", help="skip the 5-minute cache")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_usage)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except MeshError as exc:
        print(f"mesh: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
