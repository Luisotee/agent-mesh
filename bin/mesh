# Claude Code's usage-limit screens (Gas Town's patterns, from real panes), matched on the pane's last LIMIT_LINES
# lines only, so a limit that has scrolled up doesn't count: "  ⎿  You've hit your limit · resets 7pm (America/…)",
# or its options menu ("❯ 1. Stop and wait for limit to reset"). Each must start its line, after glyphs, numbers and
# spaces, so the agent's own output quoting one doesn't count (a quote mark or backtick before it, straight or curly,
# ends the prefix: SCREEN_START). A plain rate limit (`API Error: Rate limit reached`) is a transient error, not a
# usage limit, as for agy's QUOTA_RE.
QUOTES = "'\"`\u2018\u2019\u201c\u201d"
SCREEN_START = f"^[^A-Za-z{QUOTES}\\n]*"
LIMIT_RE = re.compile(SCREEN_START + r"(?:You've hit your .*limit|(?:\w[\w'-]*\s+){0,4}limit(?:\s+reached)?"
