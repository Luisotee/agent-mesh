# What agy logs when a turn stops on a quota: "... Individual quota reached. ... Resets in 138h17m29s."
QUOTA_RE = re.compile(r"RESOURCE_EXHAUSTED[^\n]*quota reached[^\n]*", re.IGNORECASE)  # not plain rate limits
RESET_RE = re.compile(r"Resets in ([\dhms]+)")
# What agy logs when its backend refuses every attempt with no quota named (Run: attempt 1..8 failed, retrying in
# ...s; then the final line): "agent executor error: generating and executing: RESOURCE_EXHAUSTED (code 429):
# Resource has been exhausted (e.g. check quota)." That line only, not each retry. A rate limit or a gateway's
# refusal, which /usage doesn't show: the model is held for AGY_RATE_HOLD (as OpenCode's 429s are).
RATE_RE = re.compile(r"agent executor error:[^\n]*RESOURCE_EXHAUSTED \(code 429\)[^\n]*", re.IGNORECASE)
AGY_RATE_HOLD = 30 * 60  # seconds an agy model counts as spent after a 429 with no quota named
# Claude Code's usage-limit screens (Gas Town's patterns, from real panes), matched on the pane's last LIMIT_LINES
# lines only, so a limit that has scrolled up doesn't count: "  ⎿  You've hit your limit · resets 7pm (America/…)",
# or its options menu ("❯ 1. Stop and wait for limit to reset"). Each must start its line, after glyphs, numbers and
# spaces, so the agent's own output quoting one doesn't count (a quote mark or backtick before it, straight or curly,
# ends the prefix: SCREEN_START). A plain rate limit (`API Error: Rate limit reached`) is a transient error, not a
# usage limit, as for agy's QUOTA_RE.
QUOTES = "'\"`\u2018\u2019\u201c\u201d"
SCREEN_START = f"^[^A-Za-z{QUOTES}\\n]*"
LIMIT_RE = re.compile(SCREEN_START + r"(?:You've hit your .*limit|(?:\w[\w'-]*\s+){0,4}limit(?:\s+reached)?"
                      r"\s*·\s*resets \d+[:\d]*\s*(?:am|pm)\b|Stop and wait for limit to reset"
                      r"|Add funds to continue with extra usage)",
                      re.IGNORECASE | re.MULTILINE)
LIMIT_RESET_RE = re.compile(r"\bresets\s+(.+)", re.IGNORECASE)
LIMIT_LINES = 20
# Claude Code's login errors, in the pane ("  ⎿  Login expired · Please run /login", "  ⎿  API Error: 401 {…} · Please
# run /login") and as the text of its session file's `authentication_failed` reply. Started as LIMIT_RE is, and its
# words (but for an API error's JSON) hold no quote mark, so the agent quoting one doesn't count.
LOGIN_RE = re.compile(SCREEN_START + f"(?:\\w[^·\\n{QUOTES}]*|API Error: 40[13]\\b[^\\n]*?)"
                      + r"·\s*Please run /login\b", re.IGNORECASE | re.MULTILINE)
LOGIN_ERROR = "authentication_failed"
# OpenCode's limits, on its pane while it retries ("Free usage exceeded, subscribe to Go [retrying in 4h attempt #1]",
# OpenCode Go's "<name> usage limit reached. It will reset in 3 hours …") or a 429 it is still retrying, from its
# third attempt (a passing rate limit retries away by then). Started as LIMIT_RE is, the Go limit's name as at most
# four words (`opencode/kimi-k2`, `Kimi K2 (Go)`; a `:` only inside a `provider/model:tag` token) and the 429
# after at most an error's name (`Error:`, `API Error: 429`): a bare `429` right before its `[retrying`, or
# `Too Many Requests` / `Rate limit reached|exceeded` with at most 160 characters to it, so a line quoting one in a
# sentence doesn't count.
OPENCODE_LIMIT_RE = re.compile(SCREEN_START + r"(?:Free usage exceeded[^\n]*|Free limit reached[^\n]*"
                               r"|(?:(?:[\w./-]+(?::[\w./-]+)?|\(\w[\w ]*\))\s+){0,4}"
                               r"usage limit reached\. It will reset in [^\n]*"
                               r"|(?P<rate>(?:(?:\w+ ?)?Error:?\s+)?(?:429(?:\s+Too Many Requests)?\s*"
                               r"|(?:Too Many Requests|Rate limit (?:reached|exceeded))[^\n\[]{0,160}?)"
                               r"\[retrying[^\]]*attempt #(?:[3-9]|[1-9]\d+)\]))",
                               re.IGNORECASE | re.MULTILINE)
# A limit's reset: "reset in", or the free tier's retry (OpenCode waits for its reset); a 429's retry delay says
# nothing of when the limit ends.
OPENCODE_RESET_RE = re.compile(r"(?:reset in|Free (?:usage exceeded|limit reached)[^\n]*retrying in) "
                               r"((?:\d+(?:\.\d+)?\s*[a-z]+\s*)+)", re.IGNORECASE)
