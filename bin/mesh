INIT_NAMES = ("init", "systemd")  # what an orphan is reparented to: pid 1, WSL's /init, a `systemd --user`


class MeshError(Exception):
    """A user-facing failure: printed without a traceback, exit status 1."""


class PaneRefused(MeshError):
    """This session isn't the agent its pane maps to: it gets this error, never a run of its own."""


class SwapNotStarted(MeshError):
    """A model swap that stopped before touching the worker: it still runs, on its old model."""


class HerdrError(MeshError):
    def __init__(self, code: str, message: str):
        super().__init__(f"herdr {code}: {message}")
        self.code = code
        self.message = message


# ── paths ────────────────────────────────────────────────────────────────


def mesh_home() -> Path:
    return Path(os.environ.get("MESH_HOME") or Path.home() / ".local/state/agent-mesh")


def worktree_root() -> Path:
    return Path(os.environ.get("MESH_WORKTREES") or Path.home() / ".local/share/agent-mesh/worktrees")


def run_dir(run_id: str) -> Path:
    return mesh_home() / run_id


def inbox_dir(run_id: str, name: str) -> Path:
    return run_dir(run_id) / "inbox" / name


def pane_key(pane_id: str) -> str:
    return pane_id.replace(":", "_")


# ── policy ───────────────────────────────────────────────────────────────
# The user's choices (models, efforts, reviewers, rounds, the reserve, folders) as data (design §21): every leaf
# below may be set in a JSON config file, nested by its dots, and the ones with an env var there too. An env var
# beats the file, which beats the built-in default here, leaf by leaf; with no file mesh behaves as these say.


def _sizes(kind: str) -> dict:
    return {f"models.{kind}.{size}.{field}": (SIZE_DEFAULTS[(kind, size)][field], check)
            for size in ("trivial", "small") for field, check in (("model", "str"), ("effort", "effort"),
                                                                  ("view", "view"))}


POLICY = {  # leaf: (built-in default, check)
    **{leaf: value for kind in KINDS for leaf, value in {
        f"models.{kind}.plan": (list(PLAN_CHAIN[kind]), "strs"),
        f"models.{kind}.exec": (EXEC_MODEL[kind], "str"),
        f"models.{kind}.plan_effort": (DEFAULT_EFFORT, "effort"),
        f"models.{kind}.exec_effort": (EXEC_EFFORT, "effort"),
        **_sizes(kind),
        # A Claude worker whose plan the user approves in its pane (`--plan-review user`) plans and executes on it.
        **({"models.claude.user_review": (USER_REVIEW_MODEL, "str")} if kind == "claude" else {})}.items()},
    "review.effort": (REVIEW_EFFORT, "effort"),
    **{f"review.level.{size}": (REVIEW_LEVEL[size], "effort") for size in SIZES},
    # Each slot takes its first candidate that is available and not picked yet (pick_reviewers).
    "review.reviewers.small": ([["agy", "copilot", "claude"]], "slots"),
    "review.reviewers.large": ([["claude"], ["agy", "copilot"]], "slots"),
    "review.re_review.skip": (["copilot"], "kinds"),  # Copilot's credits are kept for first looks
    "review.re_review.keep.small": ([], "kinds"),
    "review.re_review.keep.large": (["claude"], "kinds"),
    # Read by the root's procedure (ORCHESTRATE), not by code: shown by `mesh routing`.
    "review.rounds.small": (1, "int"),
    "review.rounds.large": (2, "int"),
    "review.tiny_pr_lines": (150, "int"),
    "quota_stop": (QUOTA_STOP, "percent"),
    "copilot_model": (COPILOT_MODEL, "str"),
    "peers_dir": ("~/research", "str"),
    "repos_dir": ([], "strs"),  # folders a bare `--repo <name>` is looked up in, in order
    "skip_permissions": (True, "bool"),  # workers start with --dangerously-skip-permissions
}
POLICY_ENV = {"quota_stop": "MESH_QUOTA_STOP", "copilot_model": "MESH_COPILOT_MODEL",
              "peers_dir": "MESH_PEERS_DIR", "repos_dir": "MESH_REPOS_DIR"}
POLICY_CHECKS = {
    "str": (lambda v: isinstance(v, str) and bool(v), "a non-empty string"),
    "strs": (lambda v: isinstance(v, list) and all(isinstance(s, str) and s for s in v), "a list of strings"),
    "effort": (lambda v: v in EFFORTS, "one of " + ", ".join(EFFORTS)),
    "view": (lambda v: v in VIEWS, "one of " + ", ".join(VIEWS)),
    "kinds": (lambda v: isinstance(v, list) and all(k in ASK_KINDS for k in v),
              "a list of " + ", ".join(ASK_KINDS)),
    "slots": (lambda v: isinstance(v, list) and all(isinstance(s, list) and s and all(k in ASK_KINDS for k in s)
                                                    for s in v),
              "a list of slots, each a non-empty list of " + ", ".join(ASK_KINDS)),
    "int": (lambda v: isinstance(v, int) and not isinstance(v, bool) and v >= 0, "a whole number, 0 or more"),
    "percent": (lambda v: isinstance(v, int) and not isinstance(v, bool) and 0 <= v <= 100, "a whole number 0-100"),
    "bool": (lambda v: isinstance(v, bool), "true or false"),
}


def config_path() -> Path:
    """The config file: MESH_CONFIG_FILE, else agent-mesh.json beside (not inside: that is the protocol link)
    `~/.config/agent-mesh`, under XDG_CONFIG_HOME when set."""
    if os.environ.get("MESH_CONFIG_FILE"):
        return Path(os.environ["MESH_CONFIG_FILE"]).expanduser()
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config").expanduser() / "agent-mesh.json"


@lru_cache(maxsize=8)
def _read_config(path: str, mtime: tuple[int, int]) -> dict:
    try:
        data = json.loads(Path(path).read_text())
    except ValueError as exc:
        raise MeshError(f"config {path} isn't valid JSON: {exc}") from None
    if not isinstance(data, dict):
        raise MeshError(f"config {path}: expected a JSON object")
    leaves: dict = {}

    def walk(node: dict, prefix: str) -> None:
        for key, value in node.items():
            if key.startswith("_"):  # a comment
                continue
            leaf = f"{prefix}{key}"
            if leaf in POLICY:
                ok, want = POLICY_CHECKS[POLICY[leaf][1]]
                if not ok(value):
                    raise MeshError(f"config {path}: {leaf} should be {want}, not {json.dumps(value)}")
                leaves[leaf] = value
            elif isinstance(value, dict) and any(k.startswith(leaf + ".") for k in POLICY):
                walk(value, leaf + ".")
            else:
                raise MeshError(f"config {path}: unknown key {leaf} (`mesh routing` lists the keys)")

    walk(data, "")
    return leaves


def load_config() -> dict:
    """The config file's leaves, checked (an unknown key or a wrong type is an error naming the file and the key,
    rather than a silent default); {} when there is no file. Read again when the file changes."""
    path = config_path()
    try:
        stat_ = path.stat()
        mtime = (stat_.st_mtime_ns, stat_.st_size)
    except OSError:
        return {}
    return _read_config(str(path), mtime)


def env_setting(leaf: str) -> tuple[object, str] | None:
    """The env var's value for a leaf, and its name, when one is set and parses."""
    if leaf == "quota_stop":
        for key, value in (("MESH_QUOTA_STOP", lambda n: n), ("MESH_MIN_QUOTA", lambda n: 100 - n)):
            try:
                if os.environ.get(key):
                    return value(int(os.environ[key])), key
            except ValueError:
                continue
        return None
    key = POLICY_ENV.get(leaf)
    if not key or not os.environ.get(key):
        return None
    if leaf == "repos_dir":
        return [p for p in os.environ[key].split(os.pathsep) if p], key
    return os.environ[key], key


def setting(leaf: str):
    """A policy leaf's value: env var, else config file, else built-in."""
    return setting_with_source(leaf)[0]


def setting_with_source(leaf: str) -> tuple[object, str]:
    found = env_setting(leaf)
    if found:
        return found[0], f"env {found[1]}"
    config = load_config()
    if leaf in config:
        return config[leaf], "config"
    return POLICY[leaf][0], "built-in"


def plan_chain(kind: str) -> tuple[str, ...]:
    """The models a task plans on: agy takes the first with quota; Claude its first (its quota isn't per model)."""
    return tuple(setting(f"models.{kind}.plan") or PLAN_CHAIN[kind])


def exec_model_for(kind: str) -> str:
    return setting(f"models.{kind}.exec")


def plan_effort_for(kind: str | None) -> str:
    return setting(f"models.{kind if kind in KINDS else 'claude'}.plan_effort")


def exec_effort_for(kind: str | None) -> str:
    return setting(f"models.{kind if kind in KINDS else 'claude'}.exec_effort")


def size_policy(kind: str, size: str | None) -> dict | None:
    """A trivial or small task's one model, effort and view (no plan phase); None for a large one."""
    if kind not in KINDS or size not in ("trivial", "small"):
        return None
    return {field: setting(f"models.{kind}.{size}.{field}") for field in ("model", "effort", "view")}


def repos_dirs() -> list[Path]:
    return [Path(p).expanduser() for p in setting("repos_dir")]


def skip_flags() -> list[str]:
    """What a worker's launch passes to skip permission prompts: nothing when `skip_permissions` is off."""
    return ["--dangerously-skip-permissions"] if setting("skip_permissions") else []


def resolve_repo(arg: str) -> Path:
    """`--repo`'s top folder: an existing path as given, else a bare name looked up in `repos_dir`."""
    path = Path(arg).expanduser()
    if not path.exists() and "/" not in arg:
        found = next((d / arg for d in repos_dirs() if (d / arg).is_dir()), None)
        if not found:
            where = ", ".join(str(d) for d in repos_dirs()) or "nowhere: `repos_dir` isn't set (`mesh routing`)"
            raise MeshError(f"no repo {arg} here or in {where}")
        path = found
    return Path(git("rev-parse", "--show-toplevel", cwd=path)).resolve()


CLI_NAMES = {"claude": "Claude Code", "agy": "agy", "copilot": "Copilot"}
SHORT_NAMES = {"claude": "Claude", "agy": "agy", "copilot": "Copilot"}  # in routing notes


def cli_binary(kind: str) -> str:
    return claude_bin() if kind == "claude" else kind


def installed(kind: str) -> bool:
    """Whether this kind's CLI is on PATH (MESH_CLAUDE for Claude)."""
    return bool(shutil.which(cli_binary(kind)))


def installed_text() -> str:
    found = [CLI_NAMES[k] for k in ASK_KINDS if installed(k)]
    return f"installed: {', '.join(found)}" if found else "none of Claude Code, agy or Copilot is on PATH"


def require_cli(kind: str, what: str) -> None:
    if not installed(kind):
        raise MeshError(f"{what} needs {CLI_NAMES[kind]} (`{cli_binary(kind)}`), which isn't on PATH "
                        f"({installed_text()})")


def default_kind(preferred: str = "agy") -> str:
    """A new agent's CLI when none is named: `preferred` when installed, else the other one."""
    for kind in (preferred, *(k for k in KINDS if k != preferred)):
        if installed(kind):
            return kind
    raise MeshError("neither Claude Code (`claude`) nor agy is on PATH: mesh needs at least one")


# ── subprocess helpers ───────────────────────────────────────────────────


def herdr(*args: str, timeout: float | None = None) -> dict:
    """Run a herdr CLI command and return its JSON `result`."""
    binary = os.environ.get("MESH_HERDR") or "herdr"
    try:
        proc = subprocess.run([binary, *args], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired as exc:
        raise HerdrError("timeout", f"{' '.join(args[:2])} timed out") from exc
    except FileNotFoundError as exc:
        raise MeshError(f"herdr not found ({binary}); mesh must run inside herdr") from exc
    if proc.returncode != 0:
        raw = (proc.stderr or proc.stdout).strip()
        try:
            err = json.loads(raw)["error"]
            raise HerdrError(err.get("code", "error"), err.get("message", ""))
        except (ValueError, KeyError, TypeError):
            raise HerdrError("cli_error", raw) from None
    out = proc.stdout.strip()
    return json.loads(out).get("result", {}) if out else {}


def git_env() -> dict[str, str]:
    """The environment of mesh's own git calls. They skip optional locks: `git status` otherwise refreshes the index
    and writes it back under `index.lock`, and in a worker's worktree that fails the worker's own `git add` or
    `commit` meanwhile ("index.lock: File exists")."""
    return {**os.environ, "GIT_OPTIONAL_LOCKS": "0"}


def git(*args: str, cwd: str | Path) -> str:
    proc = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, env=git_env())
    if proc.returncode != 0:
        raise MeshError(f"git {' '.join(args)}: {proc.stderr.strip()}")
    return proc.stdout.strip()


def run_cli(argv: list[str], cwd: str | Path | None = None, env: dict[str, str] | None = None,
            timeout: float | None = 120, input: str | None = None,
            started: Callable[[int], None] | None = None) -> subprocess.CompletedProcess:
    """Run an agent CLI (`claude`, `agy`, `copilot`) to completion; one that can't start or times out is a failed run.

    With `started`, the CLI runs in a session of its own and `started` gets its pid once it runs, for the
    caller to record: a caller killed outright leaves it running, and then the record is what shows it busy.
    A timeout or an exception here (Ctrl-C, or a signal signals_raise turned into one) kills its whole
    process group, tools it started included.
    """
    try:
        proc = subprocess.Popen(argv, cwd=cwd, env=env, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                stdin=subprocess.PIPE if input is not None else None,
                                start_new_session=started is not None)
    except FileNotFoundError:
        return subprocess.CompletedProcess(argv, 127, "", f"{argv[0]} not found")
    except OSError as exc:  # e.g. an argument over the kernel's per-argument limit
        return subprocess.CompletedProcess(argv, 126, "", f"{argv[0]} could not start: {exc}")

    def kill() -> None:
        try:
            os.killpg(proc.pid, signal.SIGKILL) if started else proc.kill()
        except OSError:
            pass  # gone already
        # Not communicate(): a grandchild outside the group (or any, without `started`) may still hold
        # the pipes, and reading them to EOF would wait for it (as subprocess.run does).
        proc.wait()
        for pipe in (proc.stdin, proc.stdout, proc.stderr):
            if pipe:
                try:
                    pipe.close()
                except OSError:
                    pass

    try:
        if started:
            started(proc.pid)
        out, err = proc.communicate(input, timeout=timeout)
    except subprocess.TimeoutExpired:
        kill()
        return subprocess.CompletedProcess(argv, 124, "", f"{argv[0]} timed out after {timeout:.0f}s")
    except BaseException:
        kill()
        raise
    return subprocess.CompletedProcess(argv, proc.returncode, out, err)


def claude_bin() -> str:
    return os.environ.get("MESH_CLAUDE") or "claude"


def claude_agents() -> list[dict]:
    """Claude Code's own session list (`claude agents --json --all`): background sessions carry a `status`
    (busy / idle / waiting) while their process runs, and keep their entry after they exit. No rows when the
    call fails (see read_claude_agents)."""
    rows = read_claude_agents()
    return [] if rows is None else rows


def read_claude_agents() -> list[dict] | None:
    """claude_agents, but None when the call fails (an error, a timeout, output that isn't a list), so a
    caller can tell that from no sessions."""
    proc = run_cli([claude_bin(), "agents", "--json", "--all"], env=claude_env(), timeout=30)
    try:
        rows = json.loads(proc.stdout) if proc.returncode == 0 else None
    except ValueError:
        return None
    return rows if isinstance(rows, list) else None


def parent_pid(pid: int) -> int:
    try:
        return int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
    except (OSError, ValueError, IndexError):
        return 0


def has_proc() -> bool:
    """Whether the process table can be read (/proc: Linux, not macOS)."""
    return Path("/proc").is_dir()


def agent_processes() -> list[dict]:
    """Every running `claude` / `agy` process this user can see ({pid, argv, cwd}), from /proc ([] without it),
    leaving out this command's own ancestors (the agent that runs it isn't some worker's holder)."""
    mine, pid = set(), os.getpid()
    while pid > 1 and pid not in mine:
        mine.add(pid)
        pid = parent_pid(pid)
    return [{"pid": p["pid"], "argv": p["argv"], "cwd": p["cwd"]} for p in process_table()
            if p["pid"] not in mine and p["cwd"] and agent_binary(p["argv"])]


def socket_address(pid: int | None) -> str | None:
    """The cross-session address (`uds:<socket>`) of a running Claude Code process, if it has one: the
    `messagingSocketPath` its own `sessions/<pid>.json` names, never a path rebuilt from the layout (Claude Code
    binds under `XDG_RUNTIME_DIR`, or a temp folder without it, or `/tmp/cc-socks-<uid>` past 103 bytes), and
    never one an earlier process at a reused pid left (`process_record` checks its start). `MESH_CC_SOCKS`, a
    folder of `<pid>.sock`, stands in for those files (tests)."""
    if not pid:
        return None
    if folder := os.environ.get("MESH_CC_SOCKS"):
        sock = Path(folder) / f"{pid}.sock"
    else:
        sock = Path((process_record(pid) or {}).get("messagingSocketPath") or "/nonexistent")
    return f"uds:{sock}" if sock.exists() else None


def claude_pid() -> int | None:
    """The pid of the Claude Code process this command runs under, which Claude Code gives its tools."""
    try:
        return int(os.environ.get("CLAUDE_PID") or 0) or None
    except ValueError:
        return None


def claude_process() -> dict:
    """The Claude Code session this command runs under: its cross-session `address`, the `pid` of its process
    and that process's `start` (each None when unknown).

    The socket is `CLAUDE_CODE_MESSAGING_SOCKET`, which Claude Code sets for its tools; else `CLAUDE_PID`'s; else
    the first one up the process tree. Session names change as Claude retitles a conversation, so other
    sessions reach it by this socket, which belongs to the process. None outside Claude Code (an agy root) or
    where /proc can't be walked.
    """
    pid = claude_pid()
    own = os.environ.get("CLAUDE_CODE_MESSAGING_SOCKET")
    if own and not os.environ.get("MESH_CC_SOCKS") and Path(own).exists():
        # Its process, for the pid-reuse check: CLAUDE_PID, else the ancestor whose record names this socket.
        pid = pid or next((p for p in ancestors() if (process_record(p) or {}).get("messagingSocketPath") == own),
                          None)
        address = f"uds:{own}"  # no such ancestor (no /proc): the path alone is checked (`root_reachable`)
    elif pid:
        address = socket_address(pid)
    else:
        pid, address = next(((p, a) for p in ancestors() if (a := socket_address(p))), (None, None))
    return {"address": address, "pid": pid if address else None,
            "start": proc_start(pid) if address and pid else None}


def ancestors(depth: int = 16):
    """This process, its parent, theirs and so on, up to `depth` of them (none past init)."""
    pid = os.getpid()
    for _ in range(depth):
        if pid <= 1:
            return
        yield pid
        pid = parent_pid(pid)


def claude_address() -> str | None:
    """The cross-session address of the Claude Code session this command runs under (`claude_process`)."""
    return claude_process()["address"]


def address_alive(address: str | None) -> bool:
    return bool(address) and (not address.startswith("uds:") or Path(address[4:]).exists())


def root_reachable(entry: dict) -> bool:
    """Whether a Claude root's recorded socket is still its own: the path exists, and the process recorded with
    it (an entry from before mesh recorded one has none) still runs, not a later one at the same pid."""
    return address_alive(entry.get("address")) and (not entry.get("pid") or pid_alive(entry["pid"], entry.get("start")))


# ── run state ────────────────────────────────────────────────────────────


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


@contextmanager
def file_lock(path: Path, create: bool = True):
    """An exclusive lock on `path`, making its folder unless `create` is False (then a missing one raises
    FileNotFoundError)."""
    if create:
        path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


# `folder` is a run's own folder where it may be archived (all_runs and find_worker give it); the default is
# the live one, run_dir(run_id).


def run_lock(run_id: str, folder: Path | None = None):
    """The run's lock. It never makes the run's folder: one `mesh stop` archived must not come back half-made
    (a watch's write mid-poll), so a missing run raises FileNotFoundError."""
    return file_lock((folder or run_dir(run_id)) / ".lock", create=False)


def load_run(run_id: str, folder: Path | None = None) -> dict:
    path = (folder or run_dir(run_id)) / "run.json"
    if not path.exists():
        raise MeshError(f"unknown run {run_id} (no {path})")
    return json.loads(path.read_text())


def save_run(run_id: str, data: dict, folder: Path | None = None) -> None:
    write_atomic((folder or run_dir(run_id)) / "run.json", json.dumps(data, indent=2) + "\n")


@contextmanager
def editing_run(run_id: str, folder: Path | None = None):
    """Load run.json under the run lock, yield it for changes, save it."""
    with run_lock(run_id, folder):
        data = load_run(run_id, folder)
        yield data
        save_run(run_id, data, folder)


def log_event(run_id: str, event: str, **fields) -> None:
    line = json.dumps({"time": now_iso(), "event": event, **fields}) + "\n"
    fd = os.open(run_dir(run_id) / "log.jsonl", os.O_RDWR | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        # A write cut short (a kill, a full disk) leaves a line with no newline: end it first, or this event
        # is glued onto the fragment and lost with it. Two writers sealing at once leave an empty line.
        size = os.fstat(fd).st_size
        if size and os.pread(fd, 1, size - 1) != b"\n":
            line = "\n" + line
        os.write(fd, line.encode())
    finally:
        os.close(fd)


TORN_WARNED: set[str] = set()  # log files whose unreadable lines were reported, once per process


def parse_log_lines(lines: list[str], path: Path, first: int = 1) -> list[dict]:
    """The events in `lines` (line `first` onwards of `path`), skipping any that don't parse: one torn line
    must not break every reader. The first time a file has some, a warning says so on stderr."""
    events, bad = [], []
    for number, line in enumerate(lines, first):
        if not line.strip():
            continue
        try:
            event = json.loads(line)
        except ValueError:
            event = None
        if isinstance(event, dict):
            events.append(event)
        else:
            bad.append(number)
    if bad and str(path) not in TORN_WARNED:
        TORN_WARNED.add(str(path))
        print(f"mesh: skipped {len(bad)} unreadable line(s) in {path} (line {bad[0]}: a write cut short?)",
              file=sys.stderr)
    return events


def read_log(run_id: str, folder: Path | None = None) -> list[dict]:
    path = (folder or run_dir(run_id)) / "log.jsonl"
    if not path.exists():
        return []
    return parse_log_lines(path.read_text().splitlines(), path)


# ── identity ─────────────────────────────────────────────────────────────


def identity(args: argparse.Namespace) -> tuple[str, str]:
    """Return (run_id, own agent name) from flags, the environment or the pane map."""
    flag_run, flag_name = getattr(args, "run", None), getattr(args, "as_", None)
    run_id = flag_run or os.environ.get("MESH_RUN")
    name = flag_name or os.environ.get("MESH_SELF")
    run, ignored, refused = None, None, False
    if run_id and name and not flag_name:  # a name you pass is taken as given
        run = maybe_run(run_id)
        if ignored := inherited_identity(run_id, name, run):
            run_id, name, run = None, None, None
    if not (run_id and name):
        pane = os.environ.get("HERDR_PANE_ID")
        mapping = mesh_home() / "by-pane" / f"{pane_key(pane)}.json" if pane else None
        if mapping and mapping.exists():
            entry = json.loads(mapping.read_text())
            if foreign := foreign_to_pane(entry["run"], entry["name"], pane):
                ignored, refused = f"{ignored}; {foreign}" if ignored else foreign, True
            elif ignored:  # this pane's identity, all of it, or none
                if flag_run and flag_run != entry["run"]:
                    raise MeshError(f"{ignored}; this pane is {entry['name']} of run {entry['run']}, "
                                    f"not of run {flag_run}")
                run_id, name = entry["run"], entry["name"]
                print(f"mesh: {ignored}; acting as {name}, this pane's agent", file=sys.stderr)
                log_event(run_id, "identity_ignored", name=name, reason=ignored)
            else:
                run_id = run_id or entry["run"]
                name = name or entry["name"]
        elif pane and (found := pane_worker(pane, flag_run or run_id)) and name in (None, found[1]):
            if ignored:
                print(f"mesh: {ignored}; acting as {found[1]}, this pane's worker", file=sys.stderr)
                log_event(found[0], "identity_ignored", name=found[1], reason=ignored)
            run_id, name = found
    if not (run_id and name):
        error = PaneRefused if refused else MeshError
        raise error(f"not in a mesh run{f' ({ignored})' if ignored else ''}: run `mesh init` first, or pass "
                    "--run and --as (`mesh agents` lists past and present workers, `mesh status --run <id>` "
                    "shows a run's agents)")
    refresh_root_address(run_id, name, run)
    return run_id, name


def maybe_run(run_id: str) -> dict | None:
    try:
        return load_run(run_id)
    except (MeshError, OSError, ValueError):
        return None


# A launch records its new session when it returns; past this, a `starting` entry is a launch that failed.
STARTING_GRACE = 300


def inherited_identity(run_id: str, name: str, run: dict | None) -> str | None:
    """Why the MESH_RUN / MESH_SELF in the environment aren't this session's, or None if they may be.

    A process can inherit another agent's identity: a background session runs in a spare process forked with
    whatever environment started Claude Code's daemon (see `worker_settings`), and the daemon can outlive the run.
    Claude Code tells its tools which session they run in, and a Claude worker's entry records its session, so
    a mismatch gives it away, except while a launch is recording a new one (`starting`). A pane worker's
    session can change legitimately (`/clear`, plan mode's "clear context"): when this session's process is the
    one running in the pane (`pane_runs_this_claude`), the entry is brought up to date.
    """
    current = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not current:
        return None
    if run is None:
        if (run_dir(run_id) / "run.json").exists():
            return None  # unreadable right now: not evidence either way
        return f"ignored MESH_RUN={run_id}: no such run (stopped?)"
    entry = run["agents"].get(name) or {}
    if entry.get("kind") and entry["kind"] != "claude":  # a Claude session is never an agy or Copilot agent
        return (f"ignored MESH_SELF={name} of run {run_id}: that agent is {entry['kind']}, and this is "
                f"Claude session {current}")
    recorded = entry.get("session")
    if not recorded or recorded == current:
        return None
    if entry.get("status") == "starting" and seconds_since(last_launch(entry)) < STARTING_GRACE:
        return None
    if entry.get("pane") and entry["pane"] == os.environ.get("HERDR_PANE_ID"):
        in_pane = pane_runs_this_claude(entry["pane"])
        if in_pane is None:
            return None  # herdr can't say: trust the pane
        if in_pane:
            with editing_run(run_id) as data:
                data["agents"][name]["session"] = current
            log_event(run_id, "rebind", name=name, session=current)
            entry["session"] = current
            return None
    return (f"ignored MESH_SELF={name} of run {run_id}: that agent is Claude session {recorded}, and this is "
            f"{current}, which inherited its environment (pass --run {run_id} --as {name} if it should act as "
            "that agent)")


def foreign_to_pane(run_id: str, name: str, pane: str) -> str | None:
    """Why this Claude session isn't the root that the pane map names for its pane, or None if it may be.

    Anything started in the root's pane carries its `HERDR_PANE_ID`: a background session whose daemon the user
    started there, or a Claude started by one of the root's tools. Only the pane's foreground process is the
    root (`pane_runs_this_claude`); when herdr can't say, the pane is trusted.
    """
    current = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not current:
        return None
    entry = ((maybe_run(run_id) or {}).get("agents") or {}).get(name) or {}
    if entry.get("kind") and entry["kind"] != "claude":
        return (f"pane {pane} is {name} of run {run_id}, which is {entry['kind']}, and this is "
                f"Claude session {current}")
    if pane_runs_this_claude(pane) is False:
        return (f"pane {pane} is {name} of run {run_id}, and Claude session {current} isn't the process running "
                f"there (pass --run {run_id} --as {name} if it should act as that agent; {NOT_LEADER_HINT})")
    return None


def pane_worker(pane: str, run_id: str | None = None) -> tuple[str, str] | None:
    """(run, name) of the Claude pane worker this session is, found by its pane when its environment carries no
    identity, or None.

    A herdr restore relaunches a pane's agent (`claude --resume <session>`) in the same pane id with herdr's
    variables but none of mesh's. The pane map names only roots, so a worker is matched on its live entry's pane
    and recorded session, and confirmed as the pane's process (`pane_runs_this_claude`), all three: a nested
    `claude -c -p` keeps the pane and the session, a pane id herdr reused after losing its session can match a
    stale entry, and a session resumed into another run is recorded in both. Unlike the pane map, a pane herdr
    can't vouch for is refused: this is only a fallback, and `--run`/`--as` stays the way past it.
    """
    found = pane_worker_entries(pane, run_id)
    if len(found) > 1:
        print(f"mesh: pane {pane} and session {os.environ.get('CLAUDE_CODE_SESSION_ID')} match several workers "
              f"({', '.join(f'{n} of run {r}' for r, n in found)}); pass --run and --as", file=sys.stderr)
    if len(found) != 1 or pane_runs_this_claude(pane) is not True:
        return None
    return found[0]


def pane_worker_entries(pane: str, run_id: str | None = None) -> list[tuple[str, str]]:
    """(run, name) of every live Claude worker entry recorded with this pane and this session, unconfirmed
    (`pane_worker`): in `run_id`, else in every live run."""
    current = os.environ.get("CLAUDE_CODE_SESSION_ID")
    if not (current and pane):
        return []
    found = []
    for path in [run_dir(run_id) / "run.json"] if run_id else sorted(mesh_home().glob("*/run.json")):
        try:
            agents = json.loads(path.read_text()).get("agents") or {}
            found += [(path.parent.name, name) for name, entry in agents.items()
                      if isinstance(entry, dict) and entry.get("role") == "worker" and entry.get("kind") == "claude"
                      and entry.get("pane") == pane and entry.get("session") == current
                      and entry.get("status") not in ("retiring", "retired")]
        except (OSError, ValueError, AttributeError):
            continue  # unreadable, or not a run
    return found


# Why a root's own Claude can fail `pane_runs_this_claude`: it doesn't lead the pane's foreground group.
NOT_LEADER_HINT = ("a launcher script that runs claude without `exec`, or tmux/zellij inside the pane, "
                   "puts another process there; use `exec claude` in the script")


def pane_runs_this_claude(pane: str) -> bool | None:
    """Whether this command's Claude process is the one running in the pane, or None if herdr can't say.

    herdr's `agent_session` can't tell: its hook reports whatever session starts with the pane's ids, and herdr
    takes a `resume`, `clear` or `compact` report from any of them (a nested `claude -c -p`, say). The kernel
    can: the pane's agent leads its foreground process group, while Claude runs each tool in a session of its
    own and background sessions run under its daemon. Members alone aren't enough, as MCP servers share it.
    """
    pid = claude_pid()
    if not pid:
        return None
    info = pane_process_info(pane)
    if info is None:
        return None
    if leader := info.get("foreground_process_group_id"):
        return leader == pid
    members = {p.get("pid") for p in info.get("foreground_processes") or []}
    return pid in members if members else None


def pane_process_info(pane: str) -> dict | None:
    """herdr's view of the pane's foreground processes, or None if it can't say."""
    try:
        return herdr("pane", "process-info", "--pane", pane, timeout=10).get("process_info") or {}
    except MeshError:
        return None


def claude_home() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")


def process_record(pid: int) -> dict | None:
    """The file a Claude Code process keeps about itself (`sessions/<pid>.json` under its config folder): its
    `sessionId`, which follows a /clear or a /resume, and its `status`. None: no such file, or one an earlier
    process with the same pid left (its `procStart` is that process's start; off Linux `proc_start` reads `ps`,
    which may never match, and then the callers fall back to herdr)."""
    try:
        data = json.loads((claude_home() / "sessions" / f"{pid}.json").read_text())
    except (OSError, ValueError):
        return None
    if not isinstance(data, dict) or data.get("pid") != pid or not data.get("procStart") \
            or str(data["procStart"]) != proc_start(pid):
        return None
    return data


def process_session(pid: int) -> str | None:
    """The session a Claude Code process is in now (`process_record`), or None."""
    return (process_record(pid) or {}).get("sessionId") or None


# Claude Code's managed settings on Linux: `managed-settings.json`, then `managed-settings.d/*.json` in name order.
CLAUDE_MANAGED = Path("/etc/claude-code")
INBOUND_RANK = {"accept": 0, "hold": 1, "refuse": 2}  # `crossSessionInbound`, loosest first
PROMPTING_MODES = ("default", "acceptEdits", "auto", "dontAsk")


def settings_inbound(path: Path) -> str | None:
    """A settings file's `crossSessionInbound`, or "invalid" for a value Claude Code doesn't know (a list, say)."""
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return None
    value = data.get("crossSessionInbound") if isinstance(data, dict) else None
    return None if value is None else value if isinstance(value, str) and value in INBOUND_RANK else "invalid"


def inbound_setting(cwd: str | Path | None, flag: str | None = None) -> tuple[str | None, str | None]:
    """(the `crossSessionInbound` a Claude session started in `cwd` with `--settings` `flag` runs with, where it
    comes from), as Claude Code 2.1.310 decides it (design §11): managed policy, then the flag, then the user's
    settings, the first that sets it; the repo's `.claude/settings*.json` may only tighten it. A value it doesn't
    know, in any of them, holds whatever else is set (its `N()`: the settings warning). Managed drop-ins are
    merged over the base file in name order, so the last that sets it wins. (None, None): unset, so the session's
    permission mode decides. Server-managed policy isn't read."""
    drop_ins = sorted((CLAUDE_MANAGED / "managed-settings.d").glob("*.json"))
    managed = [settings_inbound(path) for path in (CLAUDE_MANAGED / "managed-settings.json", *drop_ins)]
    user = settings_inbound(claude_home() / "settings.json")
    repo = [settings_inbound(Path(cwd) / ".claude" / name) for name in ("settings.local.json", "settings.json")] \
        if cwd else []
    invalid = "invalid" in (*managed, user, *repo)  # settled first: ranked below, only known values are
    managed, repo = [v for v in managed if v != "invalid"], [v for v in repo if v != "invalid"]
    user = None if user == "invalid" else user
    value = source = None
    for found in managed:
        if found:
            value, source = found, "managed"
    if value is None and flag:
        value, source = flag, "flag"
    if value is None and user:
        value, source = user, "user"
    for found in repo:
        if found and INBOUND_RANK[found] > INBOUND_RANK[value or "accept"]:
            value, source = found, "repo"
    if invalid and INBOUND_RANK[value or "accept"] < INBOUND_RANK["hold"]:  # the settings warning holds
        return "hold", "invalid"
    return value, source


def background_view(view: str, named: bool, root: dict, notes: list[str], doing: str) -> str:
    """`view`, or "pane" (with a note) where a background worker couldn't report: no Claude root it can message.
    A `--view bg` the caller `named` is refused instead. Checked before any side effect; `settings_view` checks
    the worker's folder once it exists. With `skip_permissions` off, a background session has no dialog to answer
    a permission prompt in, so it gets a pane too."""
    if view == "bg" and not skip_flags():
        return refuse_bg("skip_permissions is off, and a background worker can't answer a permission prompt",
                         named, notes, doing)
    if view != "bg" or root_reachable(root):
        return view
    return refuse_bg("a background worker needs a Claude root it can message (see `mesh init`)", named, notes, doing)


def settings_view(view: str, named: bool, cwd, notes: list[str], doing: str) -> str:
    """`view`, or "pane" (with a note, or refused when `named`) where Claude Code's settings in `cwd` hold
    cross-session messages (`worker_accepts`), which a background worker there would never see."""
    if view != "bg" or worker_accepts(cwd):
        return view
    return refuse_bg("Claude Code's settings there hold cross-session messages (crossSessionInbound), which a "
                     "background worker would never see", named, notes, doing)


def refuse_bg(why: str, named: bool, notes: list[str], doing: str) -> str:
    if named:
        raise MeshError(f"--view bg: {why}; use a pane")
    notes.append(f"{why}; {doing} a pane")
    return "pane"


def worker_accepts(cwd: str | Path | None) -> bool:
    """Whether a Claude worker in `cwd` takes cross-session messages unprompted: mesh starts it with `accept`
    (`worker_settings`), which only managed policy or a tightening repo overrides."""
    return inbound_setting(cwd, "accept")[0] == "accept"


def mode_class(mode: str | None) -> str | None:
    """Claude Code's permission class for cross-session messages: "bypass", "prompting", or None when it can't
    be told (`plan` counts as bypass only when bypass is available, which mesh can't see)."""
    return "bypass" if mode == "bypassPermissions" else "prompting" if mode in PROMPTING_MODES else None


def transcript_mode(path: Path | None, chunk: int = 1 << 20, most: int = 8 << 20) -> str | None:
    """The permission mode of the newest prompt in a Claude session file (each carries `permissionMode`), read
    backwards from its end, at most `most` bytes; None when not found."""
    if not path:
        return None
    try:
        with open(path, "rb") as fh:
            end, rest = fh.seek(0, os.SEEK_END), b""
            stop = max(0, end - most)
            while end > stop:
                start = max(stop, end - chunk)
                fh.seek(start)
                lines = (fh.read(end - start) + rest).split(b"\n")
                rest = lines.pop(0) if start else b""
                for line in reversed(lines):
                    if match := re.search(rb'"permissionMode":\s*"([A-Za-z]+)"', line):
                        return match.group(1).decode()
                end = start
    except OSError:
        return None
    return None


def leader_record(pane: str) -> dict | None:
    """The `process_record` of the Claude leading the pane's foreground group, or None if that can't be told.
    Unlike herdr's `agent_session`, nothing else started in the pane (a nested `claude -c -p`) can change it."""
    leader = (pane_process_info(pane) or {}).get("foreground_process_group_id")
    return process_record(leader) if leader else None


def leader_session(pane: str) -> str | None:
    """The session of the Claude process leading the pane's foreground group (`leader_record`), or None."""
    return (leader_record(pane) or {}).get("sessionId") or None


def foreground_leader(info: dict) -> dict | None:
    """The process leading the pane's foreground group (the pane's agent), or None when herdr names none."""
    leader = info.get("foreground_process_group_id")
    return next((p for p in info.get("foreground_processes") or [] if leader and p.get("pid") == leader), None)


def last_launch(entry: dict) -> str | None:
    """When the entry's session last (re)started: its spawn, or its latest model change."""
    times = [entry.get("spawned"), *(m.get("at") for m in entry.get("models") or [])]
    return max((t for t in times if t), default=None)


def seconds_since(iso: str | None) -> float:
    try:
        return (datetime.now(timezone.utc) - datetime.fromisoformat(iso)).total_seconds()
    except (TypeError, ValueError):
        return float("inf")


def refresh_root_address(run_id: str, name: str, run: dict | None = None) -> None:
    """Re-record a Claude root's socket when it was reopened: the socket belongs to the process, not the
    conversation, so a resumed root has a new one and its workers would otherwise ring its pane.

    Only the root's own process records it: a command run `--as` the root from another session (the user
    acting for it, from another terminal or a Claude elsewhere) runs outside its pane, or in it but not as the
    process leading it (a nested `claude -p`), and would point the workers at a socket that isn't the root's.
    In its pane, the root is the process leading it (when herdr can't say, the pane is trusted, as the pane map
    does: `foreign_to_pane`), which also keeps its recorded `session` current after a `/clear`. Outside it,
    only the root's own conversation counts, once its pane runs no Claude (`pane_probe`): a root reopened in
    another pane (`claude --resume`, then `--as`) still runs under its recorded session, but so does a
    `claude -c` the user starts beside a live root. A root inside tmux/zellij in its pane is neither, and isn't
    healed.
    """
    run = run or maybe_run(run_id)
    entry = (run or {}).get("agents", {}).get(name, {})
    if entry.get("role") != "root" or entry.get("kind") != "claude":
        return
    inbox, current = claude_process(), os.environ.get("CLAUDE_CODE_SESSION_ID")
    address = inbox["address"]
    # A command that can't name the process (no CLAUDE_PID) at the same socket hasn't moved it: keep its pid.
    same = address == entry.get("address") and inbox["pid"] in (None, entry.get("pid"))
    moved = bool(address) and not same
    cleared = bool(current) and current != entry.get("session")
    if not (moved or cleared):
        return
    pane = entry.get("pane")
    update = {}
    if pane and os.environ.get("HERDR_PANE_ID") == pane:
        leads = pane_runs_this_claude(pane)
        if leads is False:
            return
        update = {**(inbox if moved else {}), **({"session": current} if cleared else {})}
    elif moved and current and current == entry.get("session") and pane_probe(pane, "claude") in ("missing", "dead"):
        update = dict(inbox)
    if update:
        with editing_run(run_id) as data:
            data["agents"][name].update(update)
        log_event(run_id, "rebind", name=name, **update)


def agent_name(repo: str, suffix: str, taken: set[str]) -> str:
    """A readable herdr name such as `shop-api-restocked-at`, made unique with -2, -3…"""
    suffix = slugify(suffix, 20)
    base = re.sub(r"^[^a-z]+", "", f"{slugify(repo, 32 - len(suffix) - 4)}-{suffix}") or "agent"
    name, n = base, 2
    while name in taken:
        name, n = f"{base}-{n}", n + 1
    return name


def live_agent_names() -> set[str]:
    """herdr names must be unique among live agents, including other runs' and your own."""
    return {a["name"] for a in herdr("agent", "list").get("agents", []) if a.get("name")}


def repo_name(path: str | None) -> str:
    if not path:
        return "agent"
    try:
        return Path(git("rev-parse", "--show-toplevel", cwd=path)).name
    except (MeshError, OSError):
        return Path(path).name or "agent"


def agent_entry(run: dict, name: str) -> dict:
    try:
        return run["agents"][name]
    except KeyError:
        raise MeshError(f"no agent {name} in run {run['id']}") from None


# ── herdr topology ───────────────────────────────────────────────────────


def inside(path: str | None, top: Path) -> bool:
    if not path:
        return False
    resolved = Path(path).resolve()
    return resolved == top or top in resolved.parents


def find_or_create_workspace(repo_top: Path) -> tuple[str, bool]:
    """The project's one herdr workspace: by label, then by a pane inside the repo, else a new one."""
    # Locked across runs, so two workers spawning at once can't both create one.
    with file_lock(mesh_home() / ".workspace.lock"):
        workspaces = herdr("workspace", "list").get("workspaces", [])
        for ws in workspaces:
            if (ws.get("label") or "").lower() == repo_top.name.lower():
                return ws["workspace_id"], False
        for ws in workspaces:
            panes = herdr("pane", "list", "--workspace", ws["workspace_id"]).get("panes", [])
            if any(inside(p.get("cwd"), repo_top) or inside(p.get("foreground_cwd"), repo_top) for p in panes):
                return ws["workspace_id"], False
        created = herdr("workspace", "create", "--cwd", str(repo_top), "--label", repo_top.name, "--no-focus")
        return created["workspace"]["workspace_id"], True


def env_flags(env: dict[str, str]) -> list[str]:
    flags: list[str] = []
    for key, value in env.items():
        flags += ["--env", f"{key}={value}"]
    return flags


def split_direction(rect: dict) -> str:
    # Terminal cells are roughly twice as tall as wide: split wide panes sideways.
    return "right" if rect["width"] >= 2.2 * rect["height"] else "down"


def tab_label(run: dict) -> str:
    """The run's tab: `mesh: add restockedAt to shop-api`, from the request's first words."""
    words, label = (run.get("request") or "").split(), ""
    for word in words:
        if len(label) + len(word) + 1 > 28:
            break
        label = f"{label} {word}".strip()
    return f"mesh: {label or (words[0][:28] if words else run['id'])}"


SIDE_PANES = 3  # workers beside the root before the rest go to the run's tab


def side_panes() -> int:
    return int(os.environ.get("MESH_SIDE_PANES") or SIDE_PANES)


def area(pane: dict) -> int:
    return pane["rect"]["width"] * pane["rect"]["height"]


def split_at(pane: dict, cwd: Path, env: dict[str, str]) -> str:
    """Split a pane from `pane layout`, along its longer side, and return the new pane."""
    split = herdr(
        "pane", "split", pane["pane_id"], "--direction", split_direction(pane["rect"]),
        "--cwd", str(cwd), *env_flags(env), "--no-focus",
    )
    return split["pane"]["pane_id"]


def beside_root(run_id: str, name: str, cwd: Path, env: dict[str, str],
                replacing: str | None = None) -> tuple[str, str, str] | None:
    """A pane in the root's own tab for agent `name`, so the user sees it next to the root; None when that tab is full.

    The first worker splits the root pane, later ones split the biggest worker pane, so the root keeps its half.
    A swap (`replacing` its old pane) splits that pane, so the worker reopens where it was whatever the count.
    Parallel `mesh` calls (reviewers started in one turn, a Copilot peek pane) would all count the same panes and
    split the same one, so counting, splitting and recording the new pane on `name` happen under one lock.
    """
    with file_lock(run_dir(run_id) / ".panes.lock"):
        beside = _beside_root(run_id, cwd, env, replacing)
        if beside:
            record_pane(run_id, name, *beside)
        return beside


def record_pane(run_id: str, name: str, pane: str, tab: str, workspace_id: str) -> None:
    """Record agent `name`'s new pane, under `.panes.lock`, so the next caller counts it."""
    with editing_run(run_id) as run:
        entry = run["agents"][name]
        entry.update(pane=pane, tab=tab, workspace=workspace_id)
        if entry.get("view") == "bg":  # a background launch that fell back to a pane
            entry["view"] = "pane"


def _beside_root(run_id: str, cwd: Path, env: dict[str, str], replacing: str | None) -> tuple[str, str, str] | None:
    run = load_run(run_id)
    root = run["agents"][run["root"]]
    tab = root.get("tab")
    if not (tab and root.get("pane") and root.get("workspace")):
        return None
    try:
        live = {p["pane_id"]: p for p in herdr("pane", "layout", "--pane", root["pane"])["layout"]["panes"]}
    except (HerdrError, KeyError):
        return None  # the root's tab is gone or unusable: use the run's tab
    if replacing:
        target = live.get(replacing)
    else:
        # Live panes only: a pane the user closed by hand frees its place.
        workers = [live[a["pane"]] for a in run["agents"].values()
                   if a["role"] != "root" and a.get("pane") in live and a.get("view") != "bg"
                   and a.get("status") != "retired"]
        if len(workers) >= side_panes():
            return None
        target = max(workers, key=area) if workers else live.get(root["pane"])
    if not target:
        return None
    try:
        return split_at(target, cwd, env), tab, root["workspace"]
    except HerdrError:
        return None


def worker_workspace(run_id: str, repo_top: Path, peer: bool = False) -> tuple[str, bool]:
    """(workspace, created) for a worker's tab: its project's, but a peer asker's goes in the root's.

    A peer is a clone the user never works in, so a workspace per peer would only clutter herdr.
    """
    if peer:
        root = (run := load_run(run_id))["agents"][run["root"]]
        if root.get("workspace"):
            return root["workspace"], False
        repo_top = Path(root.get("cwd") or repo_top)
    return find_or_create_workspace(repo_top)


def place_pane(run_id: str, name: str, repo_top: Path, cwd: Path,
               env: dict[str, str], peer: bool = False) -> tuple[str, str, str, bool]:
    """(pane, tab, workspace, workspace created) for a new worker pane: beside the root, else the run's tab."""
    if beside := beside_root(run_id, name, cwd, env):
        return *beside, False
    workspace_id, created_ws = worker_workspace(run_id, repo_top, peer)
    return *new_pane(run_id, name, workspace_id, cwd, env), workspace_id, created_ws


def new_pane(run_id: str, name: str, workspace_id: str, cwd: Path, env: dict[str, str]) -> tuple[str, str]:
    """A fresh shell pane for agent `name`, in this run's tab of the workspace.

    Parallel calls (a fan-out's threads) would each find no tab and create one, the second overwriting the
    first's record, so the lookup, the create and recording the tab and the pane on `name` happen under one lock.
    """
    with file_lock(run_dir(run_id) / ".panes.lock"):
        pane, tab_id = _new_pane(run_id, workspace_id, cwd, env)
        record_pane(run_id, name, pane, tab_id, workspace_id)
        return pane, tab_id


def _new_pane(run_id: str, workspace_id: str, cwd: Path, env: dict[str, str]) -> tuple[str, str]:
    run = load_run(run_id)
    tab_id = run.get("tabs", {}).get(workspace_id)
    if tab_id:
        anchor = next(
            (a["pane"] for a in run["agents"].values() if a.get("tab") == tab_id and a.get("status") != "retired"),
            None,
        )
        if anchor:
            try:
                return split_at(max(herdr("pane", "layout", "--pane", anchor)["layout"]["panes"], key=area),
                                cwd, env), tab_id
            except (HerdrError, KeyError, ValueError):
                pass  # the tab is gone or unusable (as in _beside_root): open a new one below
    created = herdr(
        "tab", "create", "--workspace", workspace_id, "--cwd", str(cwd),
        "--label", tab_label(run), *env_flags(env), "--no-focus",
    )
    tab_id = created["tab"]["tab_id"]
    with editing_run(run_id) as run:
        run.setdefault("tabs", {})[workspace_id] = tab_id
    return created["root_pane"]["pane_id"], tab_id


def herdr_text(*args: str) -> str | None:
    """A herdr command whose output is plain text (e.g. `agent read`), or None if it failed or hung."""
    try:
        proc = subprocess.run([os.environ.get("MESH_HERDR") or "herdr", *args], capture_output=True, text=True,
                              timeout=HERDR_READ_TIMEOUT)
    except (subprocess.TimeoutExpired, OSError):
        return None
    return proc.stdout if proc.returncode == 0 else None


def pane_lines(target: str, lines: int = PANE_READ_LINES, ansi: bool = False) -> list[str] | None:
    """The pane's recent lines, trailing blanks dropped; None if herdr can't read it (not the same as no lines)."""
    text = herdr_text("agent", "read", target, "--source", "recent", "--lines", str(lines), *(["--ansi"] if ansi else []))
    if text is None:
        return None
    rows = text.splitlines()
    while rows and not SGR_RE.sub("", rows[-1]).strip():
        rows.pop()
    return rows


def strip_sgr(line: str) -> str:
    return SGR_RE.sub("", OSC_RE.sub("", line))


def input_box_at(lines: list[str]) -> int | None:
    """The index of the agent's input line (the prompt at column 0 under a rule line), searched from the bottom.

    A panel can follow the box (agy's background tasks), so the box is found from the bottom, not by counting rules.
    """
    for i in range(len(lines) - 2, -1, -1):
        if RULE_RE.match(lines[i]) and INPUT_RE.match(lines[i + 1]):
            return i + 1
    return None


def above_input_box(lines: list[str]) -> list[str]:
    """The lines above the agent's input box, so not what is typed in it.

    No box found, no lines: what can't be told apart from the input box never confirms a doorbell.
    """
    at = input_box_at(lines)
    return lines[:at - 1] if at is not None else []


def visible_chars(row: str) -> list[tuple[str, bool]]:
    """Each visible character of an ANSI row, with whether it is drawn dim (SGR 2), as ghost text is."""
    chars, dim, pos = [], False, 0
    for match in [*SGR_RE.finditer(row), None]:
        end = match.start() if match else len(row)
        chars.extend((c, dim) for c in row[pos:end])
        if not match:
            break
        pos = match.end()
        params = [int(p) if p.isdigit() else 0 for p in match.group(1).split(";")]
        i = 0
        while i < len(params):
            p = params[i]
            if p in (38, 48, 58):  # an extended colour: its index or RGB values aren't attributes
                i += 3 if params[i + 1:i + 2] == [5] else 5 if params[i + 1:i + 2] == [2] else 1
                continue
            if p in (0, 22):
                dim = False
            elif p == 2:
                dim = True
            i += 1
    return chars


def typed_text(lines: list[str]) -> str | None:
    """What is typed in the agent's input box, from an ANSI read: "" when it's empty, None when it can't be told.

    The input line is the prompt glyph, a space (an NBSP in Claude Code) and the text; a long text wraps onto rows
    with a gutter, down to the box's closing rule. Dim text is ghost text (Claude's "Try …" placeholder), not
    typed; any other styling counts as typed (Claude colours a slash command). No box, no closing rule (what
    follows may be a footer) or an escape other than SGR and OSC in the box: None.
    """
    plain = [strip_sgr(line) for line in lines]
    at = input_box_at(plain)
    if at is None:
        return None
    typed = []
    for n, row in enumerate(lines[at:]):
        if n and RULE_RE.match(plain[at + n]):
            return squeeze(" ".join(typed))
        row = OSC_RE.sub("", row)
        if "\x1b" in SGR_RE.sub("", row):
            return None
        chars = visible_chars(row)
        if not n:
            chars = chars[1:]  # the glyph
        typed.append("".join(c if not dim else " " for c, dim in chars))
    return None


def human_draft(lines: list[str] | None) -> bool:
    """Whether a pane positively shows a human's draft in its input box; anything unclear isn't one (design §3).

    A doorbell left in the box by an earlier try is ours: typing after it fuses two doorbells, which one
    `mesh inbox` answers.
    """
    text = typed_text(lines) if lines is not None else None
    return bool(text) and not text.startswith(DOORBELL_PREFIX)


def squeeze(text: str) -> str:
    return " ".join(text.split())


def ring_needle(token: str) -> str:
    """What marks one doorbell in a pane, compared with all whitespace removed, so no wrap can split it."""
    return f"ref{token}"


def doorbells_shown(lines: list[str] | None, needle: str) -> int | None:
    """Copies of the doorbell above the input box in a plain read, or None if the pane couldn't be read."""
    if lines is None:
        return None
    return "".join("".join(above_input_box(lines)).split()).count(needle)


def pane_tail(target: str, count: int = ALERT_TAIL_LINES) -> str:
    """The pane's last non-empty lines, indented, for an alert; empty if it can't be read."""
    return screen_tail(pane_lines(target, 40) or [], count)


def screen_tail(rows: list[str], count: int = ALERT_TAIL_LINES) -> str:
    """The last non-empty lines of a screen, indented, for an alert."""
    rows = [line.rstrip() for line in rows if line.strip()][-count:]
    return "\n".join("    " + (line if len(line) <= 160 else line[:159] + "…") for line in rows)


def usage_limit(lines: list[str] | None) -> str | None:
    """The reset time ("" if not shown) when the pane's last LIMIT_LINES lines show Claude's usage limit, else None."""
    tail = (lines or [])[-LIMIT_LINES:]
    if not any(LIMIT_RE.search(line) for line in tail):
        return None
    reset = next((m for m in map(LIMIT_RESET_RE.search, reversed(tail)) if m), None)
    return reset.group(1).strip() if reset else ""


def login_expired(lines: list[str] | None) -> bool:
    """Whether the pane's last LIMIT_LINES lines show Claude's expired-login error."""
    return any(LOGIN_RE.search(line) for line in (lines or [])[-LIMIT_LINES:])


def agent_binary(argv: list[str] | None) -> str | None:
    """`claude` or `agy` when the command line runs one of them (directly, or as a script under node), else None."""
    argv = [a for a in argv or [] if a]
    if not argv:
        return None
    first = Path(argv[0]).name
    if first in INTERPRETERS and len(argv) > 1:
        first = Path(argv[1]).name
    return first if first in AGENT_BINARIES else None


def pane_probe(pane: str | None, kind: str | None) -> str | None:
    """What the pane's process table says about its worker: `missing` (no such pane), `alive` (a `kind` agent runs
    in its foreground), `dead` (only something else, such as the bare shell), or None when herdr can't say."""
    if not pane:
        return "missing"
    try:
        info = herdr("pane", "process-info", "--pane", pane, timeout=10).get("process_info") or {}
    except HerdrError as exc:
        return "missing" if exc.code == "pane_not_found" else None
    except MeshError:
        return None
    procs = info.get("foreground_processes")
    if not procs:
        return None
    want = (kind,) if kind in AGENT_BINARIES else AGENT_BINARIES
    return "alive" if any(agent_binary(p.get("argv")) in want for p in procs) else "dead"


def trust_keys(screen: str) -> list[str] | None:
    """Keys that select "Yes, … trust" in a folder-trust dialog, or None if it isn't one.

    The CLIs differ: agy highlights "Yes" by default, Claude Code highlights "No, exit".
    """
    if not TRUST_PROMPT_RE.search(screen):
        return None
    options = [line.strip() for line in screen.splitlines() if TRUST_OPTION_RE.match(line)]
    yes = next((i for i, line in enumerate(options) if line.lstrip("❯> ").startswith("Yes")), None)
    cursor = next((i for i, line in enumerate(options) if line[0] in "❯>"), None)
    if yes is None or cursor is None:
        return None
    step = "down" if yes > cursor else "up"
    return [step] * abs(yes - cursor) + ["enter"]


def startup_screen(screen: str) -> tuple[str, str | None]:
    """What a new agent waits at: ("trust", None), ("dialog", label) for one of STARTUP_DIALOGS, or ("unknown", None)."""
    if TRUST_PROMPT_RE.search(screen):
        return "trust", None
    for label, heading, option in STARTUP_DIALOGS:
        if heading.search(screen) and option.search(screen):
            return "dialog", label
    return "unknown", None


def startup_text(pane: str) -> str:
    """The pane's screen, read by pane, so it works before herdr has found the agent in it."""
    return herdr_text("pane", "read", pane, "--source", "detection", "--lines", "40") or ""


def startup_state(name: str, pane: str) -> str:
    """herdr's state for a starting agent; one herdr found without its name is given it."""
    try:
        return herdr("agent", "get", name)["agent"].get("agent_status", "unknown")
    except HerdrError as exc:
        if exc.code != "agent_not_found":
            return "unknown"
    try:
        state = herdr("agent", "get", pane)["agent"].get("agent_status", "unknown")
        herdr("agent", "rename", pane, name)
        return state
    except HerdrError:
        return "gone"


def accept_trust_prompt(pane: str, screen: str) -> bool:
    """Accept a folder-trust dialog (a directory mesh chose); False if the cursor never reaches "Yes".

    Claude Code highlights "No, exit", so the screen is read again after the arrows and Enter is pressed only
    with "Yes" selected: a lost arrow would otherwise quit the agent. The arrows are tried twice.
    """
    for attempt in range(3):
        keys = trust_keys(screen)
        if keys == ["enter"]:
            herdr("pane", "send-keys", pane, "enter")
            # The dialog itself reads `blocked`, so waiting for a state would return at once: first wait for
            # it to leave the screen, so a slow redraw isn't taken for another screen nor gets a second Enter.
            for _ in range(TRUST_GONE_READS):
                if not TRUST_PROMPT_RE.search(startup_text(pane)):
                    break
                time.sleep(0.5)
            else:
                return False
            try:  # `blocked` too: another startup screen can follow the trust dialog (a Settings Warning)
                herdr("agent", "wait", pane, "--until", "idle", "--until", "done", "--until", "blocked",
                      "--timeout", "60000")
            except HerdrError:
                pass  # clear_startup looks at the screen again
            time.sleep(3)  # the CLI redraws its welcome screen after the dialog; typing during it is lost
            return True
        if keys is None or attempt == 2:
            return False
        for key in keys[:-1]:
            herdr("pane", "send-keys", pane, key)
            time.sleep(0.3)
        screen = startup_text(pane)
    return False


def continue_selected(screen: str) -> bool:
    """A Settings Warning with its cursor on "Continue", which skips only the invalid settings."""
    return bool(SETTINGS_CONTINUE_RE.search(screen))


def continue_settings_warning(pane: str) -> bool:
    """Press Enter on a Settings Warning's "Continue" (a peer's: see clear_startup); True once it's gone."""
    herdr("pane", "send-keys", pane, "enter")
    for _ in range(TRUST_GONE_READS):
        if startup_screen(startup_text(pane)) != ("dialog", "Settings Warning"):
            time.sleep(3)  # as after the trust dialog: typing during the redraw is lost
            return True
        time.sleep(0.5)
    return False


def clear_startup(name: str, pane: str, peer: bool = False) -> dict:
    """Past `agent start`'s "not ready": accept folder-trust dialogs, then {} once the agent takes input, or
    {"held": label, "tail": …} for a screen only the user answers (see `hold`). A CLI that exited is an error.

    A peer asker (`peer`) also gets past a Settings Warning by its default "Continue": its repo is a clone
    of someone else's project that nobody here fixes, so the invalid rules are skipped as the user did by
    hand (design §14). Any other worker's repo is the user's to fix, so it holds there.
    """
    accepted, settle = 0, STARTUP_SETTLE_READS
    while True:
        screen = startup_text(pane)
        kind, label = startup_screen(screen)
        if kind == "trust":
            if accepted < STARTUP_SCREENS and accept_trust_prompt(pane, screen):
                accepted += 1
                continue
            label = "the folder-trust dialog"
        elif (peer and label == "Settings Warning" and accepted < STARTUP_SCREENS and continue_selected(screen)
              and continue_settings_warning(pane)):
            accepted += 1
            continue
        elif kind == "unknown":
            state = startup_state(name, pane)
            if state in ("idle", "done", "working"):
                return {}
            if settle:  # herdr may still show the last dialog's `blocked`, or not have found the agent yet
                settle -= 1
                time.sleep(1)
                continue
            if state == "gone":
                tail = screen_tail(screen.splitlines())
                raise MeshError(f"{name} exited during startup" + (f"; last lines of its pane:\n{tail}" if tail else ""))
            label = "a screen mesh doesn't know"
        return {"held": label, "tail": screen_tail(screen.splitlines())}


def start_agent(name: str, kind: str, pane: str, argv: list[str], attempts: int = 10, peer: bool = False) -> dict:
    """`herdr agent start`, retried while the new shell is still starting, then past any folder-trust dialog.

    {} once the agent takes input, or `clear_startup`'s {"held": …} when it waits at another startup screen.
    A `timeout` isn't retried: the CLI already runs in the pane.
    """
    last: HerdrError | None = None
    for _ in range(attempts):
        try:
            herdr("agent", "start", name, "--kind", kind, "--pane", pane, "--timeout", "120000", "--", *argv)
            return {}
        except HerdrError as exc:
            if exc.code in ("agent_not_ready", "timeout"):
                return clear_startup(name, pane, peer)
            last = exc
            time.sleep(1)
    raise MeshError(f"could not start {name}: {last}")


def hold(run_id: str, sender: str, name: str, mtype: str, body: str | None, started: dict,
         stored: Path | None = None) -> dict:
    """The delivery for a worker held at a startup screen: the message is stored now, and `release_held` rings
    its first doorbell once the agent takes input."""
    path = stored or (record(run_id, sender, name, mtype, body) if body else None)
    with editing_run(run_id) as run:
        run["agents"][name]["held"] = {"sender": sender, "type": mtype, "file": path.name if path else None,
                                       "screen": started["held"], "at": now_iso()}
    log_event(run_id, "held", name=name, screen=started["held"], file=path.name if path else None)
    return {"stored": str(path) if path else None, "rung": False, "type": mtype,
            "error": f"waiting at a startup screen ({started['held']})", "held": started["held"],
            "tail": started.get("tail", "")}


def held_alert(name: str, delivery: dict) -> str:
    """What a command that left a worker held prints, like watch's exit 4."""
    line = (f"ALERT {name} is waiting at a startup screen ({delivery['held']}) that mesh doesn't answer: "
            f"the user clears it in its pane (`herdr agent focus {name}`)")
    if delivery.get("stored"):
        line += (f". Its {delivery.get('type')} is stored, and a running `mesh watch` rings its doorbell once "
                 f"the screen is gone (or run `mesh ring {name}` then)")
    tail = delivery.get("tail")
    return f"{line}\n  last lines of its pane:\n{tail}" if tail else line


def report_held(name: str, delivery: dict | None) -> int | None:
    """Exit 4 with the alert when a start left the worker held; None otherwise."""
    if not (delivery or {}).get("held"):
        return None
    print(held_alert(name, delivery), file=sys.stderr)
    return 4


def held_doorbell(run: dict, name: str, held: dict, token: str) -> str:
    """The first doorbell, which says who the worker is: a held worker never heard it (agy's session lookup
    keys on it)."""
    return doorbell_text(run, held.get("sender"), name, held.get("type") or "messages", "", True, token)


def release_held(run_id: str, name: str, entry: dict, state: str) -> bool:
    """For a watch: ring a held worker's first doorbell once its startup screen is gone, if it has unread mail.

    True while the watch should stay quiet: still at the screen its start already reported (or working past
    it), or just rung. Gone (the user chose to exit) drops the hold, so the watch says so. A ring that fails
    keeps the hold, so the next poll or `mesh ring` tries the first doorbell again; after HELD_RING_TRIES
    polls the watch carries on, and its nudge (`deliver`) drops the stale hold and rings it.
    """
    if state not in ("idle", "done", "gone"):
        return True
    with editing_run(run_id) as run:  # whoever takes it rings: two watches don't both ring
        held = run["agents"][name].pop("held", None)
    if not held or state == "gone":
        return False
    paths = unread(run_id, name)
    if not paths:  # nothing waiting (it was read, or there never was a task)
        return True
    token = ring_token()
    rung = ring_stored(run_id, held.get("sender"), name, [name] + ([entry["pane"]] if entry.get("pane") else []),
                       held_doorbell(load_run(run_id), name, held, token), token, paths[-1],
                       read=tuple(paths))["rung"]
    log_event(run_id, "held_rung", name=name, rung=rung)
    with editing_run(run_id) as run:
        if rung:
            run["agents"][name].pop("swapped", None)
        else:
            run["agents"][name].setdefault("held", {**held, "tries": held.get("tries", 0) + 1})
    return rung or held.get("tries", 0) + 1 < HELD_RING_TRIES


# ── background sessions ──────────────────────────────────────────────────

# `claude agents` status of a running background session, in herdr's words.
BG_STATUS = {"busy": "working", "idle": "idle", "waiting": "blocked"}


class BgUntrusted(MeshError):
    """`claude --bg` refuses a folder Claude Code was never trusted in (a worktree of a trusted repo is fine)."""


def bg_row(entry: dict, rows: list[dict] | None = None) -> dict | None:
    session = entry.get("session")
    if not session:
        return None
    rows = claude_agents() if rows is None else rows
    return next((r for r in rows if r.get("sessionId") == session), None)


def bg_status(entry: dict, rows: list[dict] | None = None) -> str:
    """working / idle / blocked while the session's process runs; gone once it has exited or been stopped."""
    row = bg_row(entry, rows)
    if not row or not row.get("status"):
        return "gone"
    return BG_STATUS.get(row["status"], "unknown")


MESH_IDS = ("MESH_RUN", "MESH_SELF", "MESH_PARENT", "MESH_ROLE")
HERDR_IDS = ("HERDR_PANE_ID", "HERDR_TAB_ID", "HERDR_WORKSPACE_ID")
# Every MESH_* variable mesh reads as configuration; an empty one counts as unset.
MESH_CONFIG = ("MESH_HOME", "MESH_WORKTREES", "MESH_HERDR", "MESH_CLAUDE", "MESH_CC_SOCKS", "MESH_SIDE_PANES",
               "MESH_MIN_QUOTA", "MESH_QUOTA_STOP", "MESH_CLAUDE_USAGE", "MESH_COMPACT_AT", "MESH_AGY_COMPACT_AT", "MESH_AGY_SUMMARIES",
               "MESH_AGY_HISTORY", "MESH_AGY_CONVERSATIONS", "MESH_COPILOT_MODEL", "MESH_HANG_AFTER", "MESH_HELD_WAIT",
               "MESH_IDLE_RETIRE", "MESH_ROOT_RESET_AT", "MESH_ROOT_AUTORESET", "MESH_CACHE_TTL", "MESH_RESET_WAIT",
               "MESH_CONFIG_FILE", "MESH_PEERS_DIR", "MESH_REPOS_DIR")
# What Claude Code sets for the one session a process runs under (its tools inherit it): never pass it on.
CLAUDE_SESSION_VARS = ("CLAUDECODE", "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_CHILD_SESSION", "CLAUDE_CODE_SESSION_KIND",
                       "CLAUDE_CODE_SESSION_ATTENDED", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN",
                       "CLAUDE_PID", "CLAUDE_EFFORT", "CLAUDE_JOB_DIR", "CLAUDE_BG_BACKEND",
                       "CLAUDE_BG_SOCKET_TOKENS_PATH")


def env_without_identity(keep_herdr: bool) -> dict[str, str]:
    """This process's environment with no mesh identity. Without `keep_herdr` it also loses the pane's herdr ids,
    which `identity()` would otherwise map back to whoever owns this pane (the root)."""
    return {k: v for k, v in os.environ.items()
            if k not in MESH_IDS and (keep_herdr or k not in HERDR_IDS)}


def claude_env(strip_mesh: bool = False) -> dict[str, str]:
    """The environment for a `claude` CLI call. Any of them may start Claude Code's daemon, whose spare processes
    then run later background sessions with this environment, so it carries no mesh identity, no herdr pane ids
    and nothing of the calling Claude session; with `strip_mesh`, no MESH_* configuration either."""
    return {k: v for k, v in env_without_identity(keep_herdr=False).items()
            if k not in CLAUDE_SESSION_VARS and not (strip_mesh and k.startswith("MESH_"))}


HOOK_TIMEOUT = 30  # seconds Claude Code gives a worker's hook
REMINDER_SOURCES = ("compact", "clear", "resume")  # SessionStart sources that get `mesh whoami --reminder`
# Claude Code caps a hook's text (stdout, `additionalContext`, …) at 10,000 characters: past it, the session gets a
# file path and a 2,000-character preview, and is never told to read the file. The Stop hook's `reason` is held to it
# too. Hook text also carries no wall-clock time, so two renders of the same state match.
HOOK_OUTPUT_MAX = 10_000


def hook_command(*args: str) -> str:
    """A shell command running this script, by its absolute path, so a hook works whatever PATH the session has."""
    return shlex.join([str(Path(__file__).absolute()), *args])


def hook_text(text: str, limit: int = HOOK_OUTPUT_MAX - 1) -> str:
    """`text` within Claude Code's hook-output cap (less the newline `print` adds): cut from the middle at a line
    end, keeping the last line (the reminder's commands, which name the worker) when it fits."""
    if len(text) <= limit:
        return text
    more = "\n… (cut to fit a hook's output)\n"
    head, _, tail = text.rpartition("\n")
    if not head or len(tail) + len(more) > limit // 2:
        tail = ""
    room = max(0, limit - len(more) - len(tail))
    cut = text.rfind("\n", 0, room)
    return (text[:cut if cut > 0 else room] + more + tail)[:limit]


def worker_hooks(run_id: str, name: str) -> dict:
    """The hooks a Claude worker is started with (design, "The Stop hook"). The command names the worker,
    as only the sessions mesh starts for it carry these hooks: nothing has to be read from the hook's
    environment. Claude Code adds them to the user's and the repo's own hooks."""
    ident = ("--run", run_id, "--as", name)

    def group(command: str, matcher: str | None = None) -> dict:
        hook = {"type": "command", "command": command, "timeout": HOOK_TIMEOUT}
        return {**({"matcher": matcher} if matcher else {}), "hooks": [hook]}

    return {"Stop": [group(hook_command("hook", "stop", *ident))],
            "SessionStart": [group(hook_command("whoami", "--reminder", source, *ident), source)
                             for source in REMINDER_SOURCES]}


WORKER_INBOUND = "accept"  # the `crossSessionInbound` every Claude worker starts with (recorded as a bg one's `inbound`)


SHORT_CACHE = "5m"  # the prompt cache TTL of a worker that is asked once or works briefly (worker_cache_ttl)


def worker_cache_ttl(entry: dict) -> str | None:
    """`promptCacheTtl` for a Claude worker: SHORT_CACHE for a read-only one (an asker, a reviewer), a peer, or a
    trivial or small task, whose gaps between turns rarely reuse a 1 h cache and whose writes then cost 1.25×
    the input price instead of 2×; None (Claude Code's own choice, 1 h on a subscription) for a large change
    task, whose waits on the root a 5-minute cache wouldn't outlive (the cost study of run mb3c1: +8% there)."""
    if entry.get("read_only") or entry.get("peer") or entry.get("size") in ("trivial", "small"):
        return SHORT_CACHE
    return None


def worker_settings(env: dict[str, str], bg: bool) -> str:
    """`--settings` JSON for a Claude worker: its hooks, `crossSessionInbound: accept`, and for a background one
    its environment.

    A worker bypasses permissions, and Claude Code holds a cross-session message for a bypass session's approval
    when its sender asserts no permission mode (mesh writing a doorbell into its inbox) or another one (a root
    that prompts): a background session has no dialog, so the message expires. The flag accepts them, and beats
    the user's own setting; managed policy or the repo's settings can still tighten it (design §11).

    `claude --bg` runs the session in a spare process the daemon forked from its own environment, which is
    whoever's call started the daemon (an earlier worker, say), so the launch's own environment never reaches
    it. Settings `env` does, and overrides the spare's values, but can only set a variable: so every config
    key is set, empty when this launch has none, and the herdr ids are set empty, or a spare's stale values
    would stay (a pane id that `identity()` maps to its owner, another MESH_HOME). A pane has its environment.
    """
    settings: dict = {"hooks": worker_hooks(env["MESH_RUN"], env["MESH_SELF"]), "crossSessionInbound": WORKER_INBOUND}
    # From its entry as this launch wrote it (spawn, resume and swaps write it first), so a reopen for another
    # kind of task (a reviewer given a large change) gets that task's TTL.
    ttl = worker_cache_ttl(((maybe_run(env["MESH_RUN"]) or {}).get("agents") or {}).get(env["MESH_SELF"]) or {})
    if ttl:
        settings["promptCacheTtl"] = ttl
    if bg:
        settings["env"] = {**{k: "" for k in (*MESH_CONFIG, *HERDR_IDS)}, **env}
    return json.dumps(settings)


def settings_argv(kind: str, env: dict[str, str]) -> list[str]:
    """The `--settings` a pane worker of this kind starts with: Claude's hooks; agy has none."""
    return ["--settings", worker_settings(env, bg=False)] if kind == "claude" else []


def mesh_launched(argv: list[str], run_id: str, name: str) -> bool:
    """Whether a Claude command line is one mesh started for this worker of this run: its `--settings` carry the
    worker's own Stop hook (`worker_hooks`: a mesh script, by whatever path, naming the run and the worker).
    Every pane launch has it (spawn, resume, swaps), with the deny list the entry called for then; a herdr
    restore drops the settings with the list. The script's path and today's list aren't compared: either
    changes with an upgrade or another checkout's `bin/mesh`, which would take every running worker for a
    relaunched one."""
    want = ["hook", "stop", "--run", run_id, "--as", name]
    for settings in launch_settings(argv):
        try:
            groups = (settings.get("hooks") or {}).get("Stop") or []
            if any(shlex.split(str(h.get("command") or ""))[1:] == want for g in groups for h in g.get("hooks") or []):
                return True
        except (ValueError, AttributeError, TypeError):
            continue
    return False


def launch_settings(argv: list[str]):
    """Each `--settings` JSON object on a command line (one that doesn't parse, or isn't an object, is skipped)."""
    for flag, value in zip(argv, argv[1:]):
        if flag != "--settings":
            continue
        try:
            settings = json.loads(value)
        except ValueError:
            continue
        if isinstance(settings, dict):
            yield settings


UNREAD = object()  # a reading (`pane_claude`, `read_claude_agents`) the caller hasn't made yet


def pane_claude(entry: dict) -> dict | None:
    """The Claude process running a Claude pane worker's pane (herdr's foreground leader, or the pane's one Claude
    when herdr names no leader), or None: not such a worker (a root's Claude is the user's own, never started by
    mesh), herdr can't say, or no Claude leads the pane (or several, and no leader is named)."""
    if (entry.get("role") != "worker" or entry.get("kind") != "claude" or entry.get("view") in ("bg", "headless")
            or not entry.get("pane") or entry.get("status") == "starting"):
        return None
    info = pane_process_info(entry["pane"])
    leader = foreground_leader(info) if info else None
    if leader is None and info:
        claudes = [p for p in info.get("foreground_processes") or [] if agent_binary(p.get("argv")) == "claude"]
        leader = claudes[0] if len(claudes) == 1 else None
    return leader if leader is not None and agent_binary(leader.get("argv")) == "claude" else None


def relaunched_outside_mesh(run_id: str, name: str, entry: dict, claude=UNREAD) -> bool | None:
    """Whether the Claude in a pane worker's pane was started by something other than mesh, None if herdr can't
    say (or no Claude runs there). `claude`: its `pane_claude`, when the caller has read it already.

    A herdr restore relaunches a pane's agent as plain `claude --resume <session>`: same pane, same conversation,
    none of mesh's flags, so no hooks, no deny list (`claude_deny`), no model or effort (design §11). The pane's
    foreground leader's command line tells (`mesh_launched`).
    """
    claude = pane_claude(entry) if claude is UNREAD else claude
    return None if claude is None else not mesh_launched(claude.get("argv") or [], run_id, name)


def launched_accepting(argv: list[str]) -> bool:
    """Whether a Claude command line's `--settings` accept cross-session messages (`worker_settings` since mesh
    passes it): a worker started before then holds a doorbell written into its inbox (design §11)."""
    return any(settings.get("crossSessionInbound") == WORKER_INBOUND for settings in launch_settings(argv))


def launch_bg(name: str, cwd: str | Path, model: str, effort: str, env: dict[str, str], prompt: str,
              resume: str | None = None, extra: list[str] | tuple[str, ...] = ()) -> tuple[str, str]:
    """Start a background Claude session and return (short id, session id).

    `--bg` picks its own session id. With `resume`, the flags make it start a *copy* of that conversation under
    a new id, which is what a resume needs: a copy gets this launch's model and settings (the identity, see
    `worker_settings`), while continuing the old id would bring back the options it was first started with.
    """
    argv = [claude_bin(), "--bg", *(["--resume", resume] if resume else []), "-n", name, "--model", model,
            "--effort", effort, *extra, "--settings", worker_settings(env, bg=True), *skip_flags(), prompt]
    # No MESH_* in the process itself, so a daemon this launch starts, and its spares, carry none.
    proc = run_cli(argv, cwd=cwd, env=claude_env(strip_mesh=True), timeout=120)
    out = f"{proc.stdout}\n{proc.stderr}".strip()
    if "Workspace not trusted" in out:
        raise BgUntrusted(f"Claude Code doesn't trust {cwd} yet, so it can't run in the background there")
    started = BG_STARTED_RE.search(out)
    if proc.returncode != 0 or not started:
        raise MeshError(f"`claude --bg` did not start {name}: {out[:300]}")
    short = started.group(1)
    for _ in range(10):
        row = next((r for r in claude_agents() if r.get("id") == short), None)
        if row and row.get("sessionId"):
            return short, row["sessionId"]
        time.sleep(1)
    run_cli([claude_bin(), "stop", short], env=claude_env(), timeout=30)  # a stray session would do the task twice
    raise MeshError(f"{name} started as background session {short}, but `claude agents` doesn't list it")


def stop_bg(entry: dict) -> bool:
    """Stop a background worker's process; its conversation is kept (never `claude rm`)."""
    if not entry.get("bg_id"):
        return False
    return run_cli([claude_bin(), "stop", entry["bg_id"]], env=claude_env(), timeout=30).returncode == 0


def wait_bg_idle(entry: dict, wait_ms: int, strict: bool) -> None:
    """Wait for a background worker's turn to end, as `herdr agent wait --until idle` does for a pane."""
    deadline = time.monotonic() + wait_ms / 1000
    while True:
        state = bg_status(entry)
        if state in ("idle", "gone"):
            return
        if time.monotonic() > deadline:
            if strict:
                raise SwapNotStarted(f"background session {entry.get('bg_id')} is still {state}")
            return
        time.sleep(2)


# ── models ───────────────────────────────────────────────────────────────


def parse_agy_id(model_id: str) -> tuple[str, tuple[int, ...], str] | None:
    """(family, version, effort) of an agy model id, e.g. ("opus", (5, 5), "high")."""
    match = GEMINI_ID_RE.match(model_id)
    if match:
        version, family, effort = match.groups()
    else:
        match = CLAUDE_ID_RE.match(model_id)
        if not match:
            return None
        family, version, effort = match.groups()
    return family, tuple(int(part) for part in re.findall(r"\d+", version)), effort


def listing_names(listing: str) -> dict[str, str]:
    """Model id -> display name, from `agy models` output."""
    names = {}
    for line in listing.splitlines():
        model_id, _, display = line.partition("\t")
        if model_id.strip():
            names[model_id.strip()] = display.strip()
    return names


def pick_agy_model(listing: str, family: str, effort: str) -> str:
    """The newest `<family>` id with that effort in `agy models` output (argon, flash, opus, sonnet, ...)."""
    ids = list(listing_names(listing))
    if family in ids:
        return family
    candidates = []
    for model_id in ids:
        parsed = parse_agy_id(model_id)
        if parsed and parsed[0] == family and parsed[2] == effort:
            candidates.append((parsed[1], model_id))
    if not candidates:
        raise MeshError(f"no agy model matches family={family} effort={effort}; see `agy models`")
    return max(candidates)[1]


def agy_model_listing() -> str:
    """`agy models` output, cached: the command fetches over the network and can hang."""
    cache = mesh_home() / "agy-models.txt"
    if cache.exists() and time.time() - cache.stat().st_mtime < AGY_MODELS_TTL:
        return cache.read_text()
    try:
        proc = subprocess.run(["agy", "models"], capture_output=True, text=True, timeout=45)
        if proc.returncode == 0 and any(parse_agy_id(model_id) for model_id in listing_names(proc.stdout)):
            write_atomic(cache, proc.stdout)
            return proc.stdout
        problem = proc.stderr.strip() or "no models listed"
    except (subprocess.TimeoutExpired, FileNotFoundError) as exc:
        problem = type(exc).__name__
    if cache.exists():
        return cache.read_text()  # stale, but far better than failing the spawn
    raise MeshError(f"`agy models` failed ({problem}) and there is no cached list; pass an exact --model id")


def resolve_agy_model(family: str, effort: str) -> str:
    if parse_agy_id(family):
        return family  # an exact id needs no listing
    return pick_agy_model(agy_model_listing(), family, effort)


def parse_usage(text: str) -> list[dict]:
    """Rows of `agy -p /usage`: group, label, percent left and reset time, tab-separated."""
    rows = []
    for line in text.splitlines():
        fields = [f.strip() for f in line.split("\t")]
        if len(fields) >= 4 and re.fullmatch(r"\d+%", fields[2]):
            rows.append({"group": fields[0], "label": fields[1], "left": int(fields[2][:-1]), "resets": fields[3]})
    return rows


def agy_usage(force: bool = False) -> list[dict] | None:
    """agy's quota rows, cached for a few minutes; None when they can't be read."""
    cache = mesh_home() / "agy-usage.txt"
    failed = mesh_home() / "agy-usage.failed"
    if not force and cache.exists() and time.time() - cache.stat().st_mtime < AGY_USAGE_TTL:
        return parse_usage(cache.read_text()) or None
    if not force and failed.exists() and time.time() - failed.stat().st_mtime < AGY_USAGE_RETRY:
        return None  # a spawn must not wait on a command that just failed
    cache.parent.mkdir(parents=True, exist_ok=True)
    try:
        proc = subprocess.run(
            ["agy", "-p", "/usage", "--print-timeout", "40s", "--dangerously-skip-permissions"],
            capture_output=True, text=True, timeout=45, cwd=cache.parent,
        )
        rows = parse_usage(proc.stdout)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        rows = []
    if rows:
        write_atomic(cache, proc.stdout)
        failed.unlink(missing_ok=True)
    else:
        failed.touch()
    return rows or None


def quota_applies(group: str, model_id: str, display: str) -> bool:
    """"Claude and GPT models" covers ids by vendor prefix; "Gemini 4 Argon" covers that model by name."""
    if group.lower().endswith(" models"):
        vendors = group[: -len(" models")].lower().split(" and ")
        return any(model_id.startswith(f"{vendor.strip()}-") for vendor in vendors)
    return display.lower().startswith(group.lower())


def model_quota(model_id: str, display: str, rows: list[dict]) -> tuple[int, str] | None:
    """The tightest limit on a model: (percent left, reset time), or None if no row covers it."""
    limits = [(r["left"], r["resets"]) for r in rows if quota_applies(r["group"], model_id, display)]
    return min(limits) if limits else None


def quota_stop() -> int:
    """The percent of a quota used at which mesh starts nothing new on it (the reserve): MESH_QUOTA_STOP, else
    100 less the older MESH_MIN_QUOTA (percent left), else the config's `quota_stop`, else QUOTA_STOP."""
    return setting("quota_stop")


def min_quota() -> int:
    """The percent left under which an agy model counts as spent (the reserve, seen from the other side)."""
    return 100 - quota_stop()


def choose_agy_model(chain: tuple[str, ...], effort: str, skip: tuple[str, ...] = (), force: bool = False,
                     fallback: bool = True) -> tuple[str, list[str]]:
    """The first model of the chain with at least MESH_MIN_QUOTA% left, and notes on the ones passed over.

    Unreadable quotas count as available. With nothing above the threshold, `fallback` takes the
    model with the most left; without it the notes (with reset times) become the error.
    """
    rows = agy_usage(force)
    names = listing_names(agy_model_listing()) if rows else {}
    notes: list[str] = []
    best: tuple[int, str] | None = None
    for family in chain:
        model_id = resolve_agy_model(family, effort)
        if model_id in skip:
            continue
        quota = model_quota(model_id, names.get(model_id, ""), rows) if rows else None
        if quota is None or quota[0] > min_quota():  # at the reserve (MESH_QUOTA_STOP used) it counts as spent
            return model_id, notes
        notes.append(f"{model_id} has {quota[0]}% left (resets {quota[1]})")
        if best is None or quota[0] > best[0]:
            best = (quota[0], model_id)
    if fallback and best:
        return best[1], notes + [f"every model is under {min_quota()}%; using {best[1]}"]
    raise MeshError(f"no model with quota left over the reserve (mesh stops at {quota_stop()}% used): "
                    + ("; ".join(notes) or "every candidate was already tried"))


# The quota reserve (design §9): mesh starts nothing new on a quota once QUOTA_STOP% of it is used, so the user
# keeps some for their own sessions. agy's quotas are `agy -p /usage`'s rows; Claude's are its usage windows.


def claude_code_json() -> Path:
    """Claude Code's own state file: `.claude.json` in its config folder when CLAUDE_CONFIG_DIR is set, else home."""
    folder = os.environ.get("CLAUDE_CONFIG_DIR")
    return (Path(folder) if folder else Path.home()) / ".claude.json"


def fetch_claude_usage() -> dict | None:
    """Claude's usage as its endpoint gives it right now, or None (no login file, an expired token, any error).
    Reads the access token Claude Code keeps in `.credentials.json` and never refreshes it, since a refresh
    rotates the refresh token under Claude Code; macOS keeps it in the Keychain, so there only caches count."""
    try:
        oauth = json.loads((claude_home() / ".credentials.json").read_text()).get("claudeAiOauth") or {}
        token = oauth.get("accessToken")
        if not token or (oauth.get("expiresAt") or 0) / 1000 <= time.time():
            return None
        request = urllib.request.Request(CLAUDE_USAGE_URL, headers={
            "Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20", "User-Agent": "agent-mesh"})
        with urllib.request.urlopen(request, timeout=10) as response:
            data = json.load(response)
    except Exception:  # noqa: BLE001 - an undocumented endpoint: anything it does reads as unknown, never a crash
        return None
    return data if isinstance(data, dict) else None


def usage_windows(data: dict | None) -> dict[str, dict]:
    """{window: {"used": percent, "resets": ISO or None}} for the CLAUDE_WINDOWS a usage reading has."""
    windows = {}
    for key in CLAUDE_WINDOWS:
        window = (data or {}).get(key)
        if isinstance(window, dict) and isinstance(window.get("utilization"), (int, float)):
            windows[key] = {"used": float(window["utilization"]), "resets": window.get("resets_at")}
    return windows


def claude_usage(network: bool = True, force: bool = False) -> dict | None:
    """Claude's usage, {"windows": usage_windows, "fetched": epoch, "source": "live" or "cache"}, or None when
    nothing fresh enough can be read. A reading serves every mesh on the machine for CLAUDE_USAGE_TTL seconds;
    past that, one call to the endpoint, unless `network` is off (`mesh status`), MESH_CLAUDE_USAGE=off, or the
    last call failed under CLAUDE_USAGE_RETRY ago. Failing that, the newer of mesh's last reading and Claude
    Code's own cached copy (`cachedUsageUtilization`, refreshed only now and then) counts while under
    CLAUDE_USAGE_STALE old."""
    cache, failed = mesh_home() / "claude-usage.json", mesh_home() / "claude-usage.failed"
    try:
        ours = json.loads(cache.read_text())
    except (OSError, ValueError):
        ours = None
    now = time.time()
    if ours and now - ours.get("fetched", 0) < CLAUDE_USAGE_TTL and not force:
        return {**ours, "source": "live"}
    if (network and os.environ.get("MESH_CLAUDE_USAGE") != "off"
            and (force or not (failed.exists() and now - failed.stat().st_mtime < CLAUDE_USAGE_RETRY))):
        data = fetch_claude_usage()
        if data is not None:
            reading = {"windows": usage_windows(data), "fetched": now}
            write_atomic(cache, json.dumps(reading))
            failed.unlink(missing_ok=True)
            return {**reading, "source": "live"}
        failed.parent.mkdir(parents=True, exist_ok=True)
        failed.touch()
    readings = [ours] if ours else []
    try:
        theirs = json.loads(claude_code_json().read_text()).get("cachedUsageUtilization") or {}
        readings.append({"windows": usage_windows(theirs.get("utilization")),
                         "fetched": (theirs.get("fetchedAtMs") or 0) / 1000})
    except (OSError, ValueError, AttributeError):
        pass
    newest = max(readings, key=lambda r: r.get("fetched", 0), default=None)
    return {**newest, "source": "cache"} if newest and now - newest["fetched"] < CLAUDE_USAGE_STALE else None


FAMILY_WINDOWS = {"seven_day_opus": "opus", "seven_day_sonnet": "sonnet"}  # windows of one model family only


def claude_windows_for(usage: dict | None, model: str | None = None) -> dict[str, dict]:
    """Claude's windows that apply to a worker on `model`: the account's, plus a family's own weekly window
    (`seven_day_opus`, `seven_day_sonnet`) only for a model of that family (unknown model: the account's only)."""
    return {key: w for key, w in ((usage or {}).get("windows") or {}).items()
            if key not in FAMILY_WINDOWS or FAMILY_WINDOWS[key] in (model or "").lower()}


def claude_at_reserve(usage: dict | None, model: str | None = None) -> tuple[str, dict] | None:
    """The first of Claude's windows (for `model`) at or past the reserve, as (window, its reading); None when
    none is, or when nothing could be read (an unreadable quota never blocks, as agy's)."""
    return next(((key, w) for key, w in claude_windows_for(usage, model).items() if w["used"] >= quota_stop()),
                None)


def agy_hit_text(model: str, hit: tuple[int, str]) -> str:
    return f"agy's {model} has {hit[0]}% left (resets {reset_text(hit[1])})"


def claude_hit_text(key: str, window: dict) -> str:
    return f"Claude is at {window['used']:.0f}% of its {CLAUDE_WINDOWS[key]} (resets {reset_text(window['resets'])})"


def agy_at_reserve(model: str, effort: str | None = None) -> tuple[int, str] | None:
    """(percent left, reset) when the agy model (an id, or a family at `effort`) is at the reserve, else None."""
    try:
        rows = agy_usage()
        if not rows:
            return None
        model_id = model if parse_agy_id(model) else resolve_agy_model(model, effort or plan_effort_for("agy"))
        quota = model_quota(model_id, listing_names(agy_model_listing()).get(model_id, ""), rows)
    except MeshError:
        return None
    return quota if quota and quota[0] <= min_quota() else None


def reserve_off(run_id: str | None) -> bool:
    """Whether the user let this run go on past the reserve (`mesh reserve off`)."""
    return bool(((maybe_run(run_id) if run_id else None) or {}).get("over_reserve"))


def reset_text(stamp: str | None) -> str:
    """A reset time for a person: local `HH:MM` within a day, else with its date; as given if it isn't ISO."""
    try:
        when = datetime.fromisoformat(str(stamp).replace("Z", "+00:00")).astimezone()
    except ValueError:
        return str(stamp or "?")
    return when.strftime("%H:%M" if when.timestamp() - time.time() < 86400 else "%b %d %H:%M")


def reserve_hit(kind: str | None, model: str | None = None, effort: str | None = None) -> str | None:
    """What of `kind`'s quota is at the reserve, as a phrase ("Claude is at 92% of its five-hour window (resets
    07:20)"), or None. Copilot has no usage source, so never."""
    if quota_stop() >= 100:
        return None
    if kind == "claude":
        hit = claude_at_reserve(claude_usage(), model)
        if hit:
            return claude_hit_text(*hit)
    elif kind == "agy" and model:
        hit = agy_at_reserve(model, effort)
        if hit:
            return agy_hit_text(model, hit)
    return None


def reserve_guard(run_id: str | None, kind: str | None, model: str | None, effort: str | None, what: str) -> None:
    """Refuse to start `what` on a quota at its reserve (design §9), unless the run was let past it."""
    if reserve_off(run_id):
        return
    hit = reserve_hit(kind, model, effort)
    if hit:
        raise MeshError(f"{hit}: not starting {what}, since mesh keeps {100 - quota_stop()}% of every quota for "
                        f"the user (MESH_QUOTA_STOP={quota_stop()}). Nothing was started or sent. Tell the user; "
                        "`mesh reserve off` lets this run go on past it")


def agy_has_quota(size: str, model: str | None = None) -> tuple[bool, str]:
    """Whether a fresh agy reviewer of this size would run on a model over the quota reserve (MESH_QUOTA_STOP) (Flash for a
    trivial or small one, the plan chain for a large one), or `model` has (the one a reviewer asked again keeps),
    and why not. Unreadable quotas count as available, as for a spawn (choose_agy_model); agy not installed, or
    no model it can resolve, doesn't."""
    if not installed("agy"):
        return False, "agy isn't installed"
    if model:
        rows = agy_usage()
        names = listing_names(agy_model_listing()) if rows else {}
        quota = model_quota(model, names.get(model, ""), rows) if rows else None
        if quota is None or quota[0] > min_quota():  # at the reserve it counts as spent, as in choose_agy_model
            return True, ""
        return False, f"{model} has {quota[0]}% left (resets {quota[1]})"
    sized = size_policy("agy", size)  # at the effort it would run at: review.effort, or a plan's
    chain, effort = ((sized["model"],), setting("review.effort")) if sized else (plan_chain("agy"),
                                                                                plan_effort_for("agy"))
    try:
        choose_agy_model(chain, effort, fallback=False)
    except MeshError as exc:
        return False, str(exc)
    return True, ""


COPILOT_LIMIT_HOLD = 24 * 3600  # seconds Copilot counts as out after a quota error: it states no reset time


def copilot_limit_path() -> Path:
    return mesh_home() / "copilot-limit.json"


def copilot_limit() -> dict | None:
    """The quota error Copilot last answered with, while it still holds ({"at", "until", "message"}); machine-wide,
    like agy's quota cache."""
    try:
        limit = json.loads(copilot_limit_path().read_text())
        return limit if time.time() < float(limit["until"]) else None
    except (OSError, ValueError, KeyError, TypeError):
        return None


def copilot_quota_error(events: list[dict]) -> str | None:
    """The message of a quota error in Copilot's JSON events (HTTP 402 `quota_exceeded`, its monthly quota)."""
    for event in events:
        data = event.get("data")
        if event.get("type") == "session.error" and isinstance(data, dict) and (
                data.get("errorType") == "quota" or data.get("statusCode") == 402
                or data.get("errorCode") == "quota_exceeded"):
            return str(data.get("message") or "quota exceeded")
    return None


def note_copilot_limit(message: str) -> None:
    now = time.time()
    write_atomic(copilot_limit_path(), json.dumps({"at": now, "until": now + COPILOT_LIMIT_HOLD, "message": message}))


def reviewer_available(kind: str, size: str, model: str | None = None) -> tuple[bool, str]:
    """Whether `--reviewers auto` may pick this kind, and why not: its CLI is installed, and agy has quota on the
    model such a reviewer runs on (`model`: the one an earlier reviewer keeps), Copilot no recent quota error."""
    if kind == "agy":
        return agy_has_quota(size, model)
    if not installed(kind):
        return False, f"{CLI_NAMES[kind]} isn't installed"
    if kind == "copilot" and (limit := copilot_limit()):
        return False, (f"Copilot is over its quota ({limit.get('message')}); mesh tries it again after "
                       f"{datetime.fromtimestamp(limit['until']).astimezone().strftime('%Y-%m-%d %H:%M')}")
    return True, ""


def pick_slots(size: str, exclude: set[str], notes: list[str]) -> list[str]:
    """A first round's reviewers: each slot of `review.reviewers.<size>` takes its first candidate that is
    available and not picked or excluded; why each one passed over was, goes into `notes`."""
    picked: list[str] = []
    for slot in setting(f"review.reviewers.{'large' if size == 'large' else 'small'}"):
        passed = []
        for kind in slot:
            if kind in picked or kind in exclude:
                continue
            ok, why = reviewer_available(kind, size)
            if ok:
                picked.append(kind)
                break
            passed.append(f"{kind}: {why}" if kind == "agy" else why)
        else:
            if passed:
                notes.append("; ".join(passed) + ("" if picked else "; nobody left to review"))
            continue
        if passed:
            notes.append("; ".join(passed) + f"; {SHORT_NAMES[picked[-1]]} instead")
    return picked


def pick_reviewers(size: str, earlier: dict[str, dict] | None = None) -> tuple[list[str], list[str]]:
    """The reviewers' kinds `--reviewers auto` gives a review of this size, and notes on why (design §10, §21).

    A first round fills the size's slots (`review.reviewers.<size>`; built in: a small review gets one of agy,
    Copilot, Claude, a large one Claude plus agy or Copilot). Only an available kind is picked: its CLI installed,
    agy with quota, Copilot with no recent quota error. `earlier`: the PR's reviewers from an earlier round, by
    kind (their entries, earlier_reviewers). A re-review asks them again, except the kinds in
    `review.re_review.skip` (Copilot, whose credits are kept for first looks) and an unavailable one (an agy whose
    model is short of quota), adds `review.re_review.keep.<size>` (a large one always has Claude), and when that
    leaves nobody, fills the slots again without them. Nobody at all is an error."""
    notes: list[str] = []
    if not earlier:
        kinds = pick_slots(size, set(), notes)
    else:
        skip = set(setting("review.re_review.skip"))
        kinds, dropped = [], []
        for kind in ASK_KINDS:
            if kind not in earlier:
                continue
            if kind in skip:
                notes.append(f"a re-review leaves {SHORT_NAMES[kind]} out")
                continue
            ok, why = reviewer_available(kind, size, (earlier.get(kind) or {}).get("model"))
            if ok:
                kinds.append(kind)
            else:
                dropped.append((kind, why))
        fallback = [] if kinds else pick_slots(size, skip | {k for k, _ in dropped}, [] if dropped else notes)
        for kind, why in dropped:
            notes.append(f"{kind}: {why}; " + ("left out" if kinds or not fallback
                                                else " and ".join(SHORT_NAMES[k] for k in fallback) + " instead"))
        kinds = kinds or fallback
        keep = setting(f"review.re_review.keep.{'large' if size == 'large' else 'small'}")
        for kind in reversed(keep):
            if kind not in kinds and reviewer_available(kind, size)[0]:
                kinds.insert(0, kind)
    if not kinds:
        raise MeshError("no reviewer to start: " + "; ".join(notes or ["no review slots configured"])
                        + f" ({installed_text()}). Name the reviewers (`--reviewers <kinds>`), or change "
                        "`review.reviewers` (`mesh routing`)")
    return kinds, notes


def agent_argv(kind: str, model: str, effort: str, log: str | None = None) -> tuple[list[str], str, str | None]:
    """Native CLI arguments, the resolved model and the session id (Claude only) for a new agent."""
    if kind == "agy":
        resolved = resolve_agy_model(model, effort)
        return [*log_argv(log), "--model", resolved, *skip_flags()], resolved, None
    # Choosing the session id up front is what lets `mesh resume` find the conversation later.
    session = str(uuid.uuid4())
    argv = ["--session-id", session, "--model", model, "--effort", effort, *skip_flags()]
    return argv, model, session


def log_argv(log: str | None) -> list[str]:
    """agy writes its own log; one per worker is how `mesh watch` sees a quota hit."""
    return ["--log-file", log] if log else []


def resolve_model(kind: str, model: str, effort: str) -> str:
    """The id to start an agent of this kind with: agy families are resolved, Claude aliases pass through."""
    return resolve_agy_model(model, effort) if kind == "agy" else model


def claude_deny(entry: dict) -> list[str]:
    """`--disallowedTools` for a Claude worker on a read-only task (`read_only`) or planning one that `mesh approve`
    hasn't approved yet (`planning`), else nothing. The list is the same for both, so moving between the two
    reasons needs no reopen.

    Edits are denied by path, its worktree and the main checkout, so it can still write its report under
    `$(mesh dir)`; an `Edit` rule stops Write too. Deny rules win over `--dangerously-skip-permissions`, in
    a pane and in `--bg`, and aren't kept in the conversation: a reopen without them can edit (design §10).
    The flag takes several values, so callers put another flag after it.
    """
    if entry.get("kind") != "claude" or not (entry.get("read_only") or entry.get("planning")):
        return []
    paths = dict.fromkeys(str(Path(p).resolve()) for p in (entry.get("cwd"), entry.get("repo")) if p)
    return ["--disallowedTools", *(f"Edit(/{p}/**)" for p in paths), *(f"Bash({cmd}:*)" for cmd in PUBLISH_COMMANDS)]


def resume_argv(kind: str, session: str, model: str, effort: str) -> list[str]:
    """CLI arguments that reopen an agent's conversation (no permission flags)."""
    if kind == "agy":
        return ["--conversation", session, "--model", model]
    if kind == "copilot":
        return ["--resume", session, *copilot_model_argv(model, effort)]
    return ["--resume", session, "--model", model, "--effort", effort]


def resumed_model(entry: dict, model: str | None, effort: str | None) -> tuple[str, str]:
    """The model and effort a resumed agent runs on: what it had, unless overridden."""
    effort = effort or entry.get("effort") or plan_effort_for(entry.get("kind"))
    if entry.get("kind") == "copilot":
        return model or entry.get("requested_model") or setting("copilot_model"), effort
    if entry.get("kind") != "agy":
        return model or entry.get("model") or plan_chain("claude")[0], effort
    if not model:
        parsed = parse_agy_id(entry.get("model") or "")
        if parsed and parsed[2] == effort:
            return entry["model"], effort  # the exact id it ran on; no listing needed
        model = parsed[0] if parsed else exec_model_for("agy")
    return resolve_agy_model(model, effort), effort


# ── sessions ─────────────────────────────────────────────────────────────


def first_doorbell(name: str) -> str:
    """How every first doorbell to an agent starts (see doorbell_text), without the emoji."""
    return f"You are {name} ("


@lru_cache(maxsize=4)
def agy_history(path: str, mtime: float) -> list[dict]:
    entries = []
    for line in Path(path).read_text(errors="replace").splitlines():
        try:
            entries.append(json.loads(line))
        except ValueError:
            continue
    return entries


@lru_cache(maxsize=4)
def agy_summaries(path: str, mtime: float) -> list[dict]:
    """agy's own index of its conversations: id, first prompt (`preview`) and workspace, oldest first.

    It has a conversation's id from its first prompt on, while history.jsonl only gets one with a later prompt.
    Opened read-only; agy keeps it in WAL mode, so reading never blocks it.
    """
    try:
        import sqlite3  # here, so a Python built without it only loses this lookup
    except ImportError:
        return []
    try:
        db = sqlite3.connect(f"{Path(path).resolve().as_uri()}?mode=ro", uri=True, timeout=2)
        try:
            # Top-level conversations only: agy's subagents (`nesting_depth` > 0) share the workspace.
            rows = db.execute("SELECT conversation_id, preview, workspace_uris FROM conversation_summaries "
                              "WHERE nesting_depth = 0 AND step_count > 0 ORDER BY last_modified_time").fetchall()
        finally:
            db.close()
    except (sqlite3.Error, ValueError):
        return []
    entries = []
    for conversation, preview, uris in rows:
        try:
            workspaces = [urllib.parse.unquote(urllib.parse.urlparse(uri).path) for uri in json.loads(uris)]
        except (ValueError, TypeError, AttributeError):
            workspaces = []
        entries.append({"conversationId": conversation, "display": preview or "", "workspaces": workspaces})
    return entries


def agy_conversation(name: str, run_id: str, cwd: str | None, pinned_only: bool = False) -> str | None:
    """agy's conversation id for an agent, from agy's conversation index, else the prompt history it keeps.

    The first doorbell names the agent and its run, so it pins the conversation even when
    a restart (`-2`) shares the worktree; the newest conversation in that directory is the fallback
    (not with `pinned_only`). agy sometimes replaces the index's first prompt with the conversation's
    title, which is why a worker's conversation is recorded once it first writes (see record_session).
    """
    home = Path.home() / AGY_HOME
    sources = ((os.environ.get("MESH_AGY_SUMMARIES") or home / "conversation_summaries.db", agy_summaries),
               (os.environ.get("MESH_AGY_HISTORY") or home / "history.jsonl", agy_history))
    run_re = re.compile(rf"\brun {re.escape(run_id)}\b")
    cwds = []
    for source, read in sources:
        path = Path(source)
        try:  # agy's db takes new rows in its write-ahead log first, so that file's mtime counts too
            mtime = max(f.stat().st_mtime for f in (path, path.with_name(path.name + "-wal")) if f.exists())
        except (OSError, ValueError):  # gone, or its log removed as we looked
            continue
        by_cwd = None
        for entry in read(str(path), mtime):
            conversation, display = entry.get("conversationId"), entry.get("display") or ""
            if not conversation:
                continue
            if display.startswith(f"📬 [mesh] {first_doorbell(name)}") and run_re.search(display):
                return conversation
            if cwd and cwd in entry.get("workspaces", [entry.get("workspace")]):
                by_cwd = conversation
        cwds.append(by_cwd)
    return None if pinned_only else next((c for c in cwds if c), None)


def claude_sessions_dir(cwd: str) -> Path:
    """Where Claude Code keeps the sessions it ran in `cwd`."""
    return claude_home() / "projects" / re.sub(r"[^A-Za-z0-9]", "-", cwd)


def claude_session(name: str, cwd: str) -> str | None:
    """A Claude session id for agents spawned before mesh chose ids: Claude keeps sessions per cwd."""
    folder = claude_sessions_dir(cwd)
    if not folder.is_dir():
        return None
    for path in sorted(folder.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True):
        if first_doorbell(name) in path.read_text(errors="replace"):
            return path.stem
    return None


def find_session(run_id: str, name: str, entry: dict) -> str | None:
    if entry.get("session"):
        return entry["session"]
    cwd = entry.get("cwd")
    if entry.get("kind") == "agy":
        # A main checkout is shared with the user's own sessions: there only the doorbell counts.
        shared = bool(cwd and entry.get("repo")) and Path(cwd).resolve() == Path(entry["repo"]).resolve()
        return agy_conversation(name, run_id, None if shared else cwd)
    return claude_session(name, cwd) if cwd else None


def claude_transcript(entry: dict, session: str) -> Path | None:
    """A Claude worker's session file (JSONL, appended on every message, tool call and result), if it exists."""
    if not entry.get("cwd"):
        return None
    path = claude_sessions_dir(entry["cwd"]) / f"{session}.jsonl"
    return path if path.exists() else None


def agy_conversation_file(session: str) -> Path:
    base = os.environ.get("MESH_AGY_CONVERSATIONS") or Path.home() / AGY_HOME / "conversations"
    return Path(base) / f"{session}.db"


def progress_files(entry: dict, session: str | None) -> list[Path]:
    """The files a worker writes as it makes progress: Claude's session file; agy's conversation db (with the
    write-ahead log it takes new rows in first and its shared-memory index: the log vanishes at a checkpoint)
    and its own `--log-file`."""
    if entry.get("kind") == "agy":
        db = agy_conversation_file(session) if session else None
        files = [db, db.with_name(db.name + "-wal"), db.with_name(db.name + "-shm")] if db else []
        return [f for f in (*files, Path(entry["log"]) if entry.get("log") else None) if f]
    path = claude_transcript(entry, session) if session else None
    return [path] if path else []


def last_progress(entry: dict, session: str | None) -> float | None:
    """When the worker last wrote any of its `progress_files` (epoch seconds), or None if none can be read."""
    times = []
    for path in progress_files(entry, session):
        try:
            times.append(path.stat().st_mtime)
        except OSError:
            continue
    return max(times, default=None)


LIMIT_NOTE = "usage_limit_note"  # transcript_stop's code for Claude Code's usage-limit notice
LIMIT_OVER = "usage_limit_over"  # ...and for a usage limit it records as over (a `release`, a reply after the error)


def transcript_stop(entry: dict, session: str | None, tail: int = 1 << 20) -> tuple[str, str] | None:
    """What stopped a Claude worker, by its session file: the error code and text when its last reply is an API
    error, (LIMIT_NOTE, the notice) when it was told its usage limit was reached and that still holds, (LIMIT_OVER,
    "") when its newest usage-limit record says the limit is over, ("", "") when it holds none (or no reply yet),
    None when the file can't be read.

    Claude Code records an API error as a synthetic assistant entry (`isApiErrorMessage`, an `error` code such as
    `authentication_failed`, `rate_limit` or `server_error`, the text it showed). A usage limit reached mid-turn
    is instead a meta user entry, `usageLimitNote: "wrap_up"` ("[Usage limit reached; a short grace allowance
    remains…"): the worker goes on for a few steps, its turn ends, and the next turn after the reset opens with
    `usageLimitNote: "release"`. So the last reply decides an error, and the newest note a limit; the turn after
    the notice is judged only once the worker reads idle, which is when the watch asks. The tail is large because
    that grace turn can write a few hundred KB after the notice.
    """
    path = claude_transcript(entry, session) if session and entry.get("kind") == "claude" else None
    if not path:
        return None
    try:
        with open(path, "rb") as fh:
            fh.seek(max(0, fh.seek(0, os.SEEK_END) - tail))
            lines = fh.read().decode(errors="replace").splitlines()
    except OSError:
        return None
    replied = False
    for line in reversed(lines):
        if '"usageLimitNote"' not in line and ('"assistant"' not in line
                                                or replied and '"isApiErrorMessage"' not in line):
            continue
        try:
            event = json.loads(line)
        except ValueError:
            continue  # the first line of the tail is usually cut
        content = (event.get("message") or {}).get("content")
        text = " ".join(c.get("text") or "" for c in content if isinstance(c, dict)) if isinstance(content, list) \
            else str(content or "")
        if event.get("usageLimitNote"):
            return (LIMIT_NOTE, text) if event["usageLimitNote"] == "wrap_up" else (LIMIT_OVER, "")
        if event.get("type") != "assistant":
            continue
        if replied:
            if event.get("isApiErrorMessage") and LIMIT_RE.search(text):
                return LIMIT_OVER, ""  # a usage limit it went on after
            continue
        if event.get("isApiErrorMessage"):
            return str(event.get("error") or ""), text
        replied = True  # an ordinary reply: only a usage-limit notice before it still counts
    return "", ""


def error_limit(error: tuple[str, str] | None) -> tuple[str, str] | None:
    """What a `transcript_stop` reads as: ("login", "") for an expired login (`authentication_failed`, or its
    text), ("limit", the reset time or "") for a usage limit (its notice names none), else None.

    A usage limit's error code is `rate_limit` ("You've hit your session limit · resets 2:20am (…)"), but a plain
    rate limit may share it, so the text decides: it must match LIMIT_RE.
    """
    code, text = error or ("", "")
    if code == LIMIT_NOTE:
        return "limit", ""
    if code == LOGIN_ERROR or LOGIN_RE.search(text):
        return "login", ""
    if not LIMIT_RE.search(text):
        return None
    reset = LIMIT_RESET_RE.search(text)
    return "limit", reset.group(1).strip() if reset else ""


def context_tokens(entry: dict, session: str) -> int | None:
    """A worker's context size: the prompt of its last reply since its last compaction (0 right after one).

    None when its conversation file can't be read.
    """
    if entry.get("kind") == "agy":
        return agy_context_tokens(session)
    path = claude_transcript(entry, session)
    return transcript_tokens(path) if path else None


def line_tokens(line: bytes) -> int | None:
    """A session file line's context size: 0 for a compaction, an assistant reply's prompt, else None."""
    if b'"compact_boundary"' not in line and b'"usage"' not in line:
        return None
    try:
        event = json.loads(line)
    except ValueError:
        return None
    if event.get("type") == "system" and event.get("subtype") == "compact_boundary":
        return 0
    if event.get("type") == "assistant" and (usage := (event.get("message") or {}).get("usage")):
        return sum(int(usage.get(key) or 0) for key in
                   ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
    return None


TTL_LOOKBACK = 50  # replies past the newest that `transcript_usage` reads back for one that wrote to the cache
CACHE_WRITES = {"ephemeral_1h_input_tokens": 3600, "ephemeral_5m_input_tokens": 300}


def line_ttl(line: bytes) -> int | None:
    """The cache lifetime a session file line's reply wrote at (3600 or 300 seconds): None for a reply that wrote
    nothing (all of it read from cache), a subagent's (which gets 5 minutes whatever the session has), or any
    other line. Claude Code picks the main conversation's TTL once per session: 1 h on a subscription within its
    plan usage, 5 min on usage credits, an API key or a cloud provider."""
    if b'"cache_creation"' not in line:
        return None
    try:
        event = json.loads(line)
    except ValueError:
        return None
    if event.get("type") != "assistant" or event.get("isSidechain"):
        return None
    writes = ((event.get("message") or {}).get("usage") or {}).get("cache_creation") or {}
    return max((ttl for key, ttl in CACHE_WRITES.items() if int(writes.get(key) or 0) > 0), default=None)


def transcript_usage(path: Path, chunk: int = 1 << 20) -> tuple[int | None, int | None]:
    """(the newest reply's prompt since the last compaction, the cache TTL the newest reply that wrote to the
    cache used) in a Claude session file, read backwards from its end (a root's file grows to tens of MB, and
    every root command measures it). The TTL is looked for up to TTL_LOOKBACK replies past the newest; either
    is None when not found."""
    tokens = ttl = None
    replies = 0
    try:
        with open(path, "rb") as fh:
            end, rest = fh.seek(0, os.SEEK_END), b""
            while end > 0:
                start = max(0, end - chunk)
                fh.seek(start)
                lines = (fh.read(end - start) + rest).split(b"\n")
                rest = lines.pop(0) if start else b""  # cut by the chunk: it's finished with the next one
                for line in reversed(lines):
                    if tokens is None:
                        tokens = line_tokens(line)
                    if ttl is None:
                        ttl = line_ttl(line)
                        replies += b'"assistant"' in line and line_tokens(line) is not None
                    if tokens is not None and (ttl is not None or replies > TTL_LOOKBACK):
                        return tokens, ttl
                end = start
    except OSError:
        return None, None
    return tokens, ttl


def transcript_tokens(path: Path, chunk: int = 1 << 20) -> int | None:
    """The newest reply's prompt in a Claude session file since its last compaction (`transcript_usage`)."""
    return transcript_usage(path, chunk)[0]


AGY_COMPACTION_STEP = 23  # a step holding a compaction's <summary>: a `/compact`, or agy's own
AGY_STEP_DONE = 3  # a step's status once it has finished (tool steps that failed or were cancelled have others)


def protobuf_fields(blob: bytes) -> list[tuple[int, int | bytes]]:
    """(field number, value) of each field of one protobuf message: varints as ints, the rest as bytes.

    ValueError or IndexError when `blob` isn't one.
    """
    def varint(i: int) -> tuple[int, int]:
        n = shift = 0
        while True:
            byte = blob[i]
            n, i, shift = n | (byte & 0x7F) << shift, i + 1, shift + 7
            if not byte & 0x80:
                return n, i
    fields, i = [], 0
    while i < len(blob):
        key, i = varint(i)
        wire = key & 7
        if wire == 0:
            value, i = varint(i)
        elif wire in (1, 5):
            size = 8 if wire == 1 else 4
            value, i = blob[i:i + size], i + size
        elif wire == 2:
            size, i = varint(i)
            value, i = blob[i:i + size], i + size
        else:
            raise ValueError(f"protobuf wire type {wire}")
        if i > len(blob):
            raise ValueError("truncated protobuf")
        fields.append((key >> 3, value))
    return fields


def agy_context_tokens(session: str) -> int | None:
    """An agy conversation's context size: the prompt of its last model call since its last compaction.

    agy documents no format. Its conversation file is SQLite, and field 9 of a step's `metadata` protobuf is
    that call's usage: 2 the input read fresh, 5 the input read from cache, 3 the output. Checked against
    `agy -p --output-format json`, whose `usage` sums them over the whole conversation (so it can't tell
    the size). None when the file is missing or reads otherwise, and `--compact auto` falls back.
    """
    try:
        import sqlite3  # here, so a Python built without it only loses this reading
    except ImportError:
        return None
    path = agy_conversation_file(session)
    if not path.exists():
        return None
    try:
        db = sqlite3.connect(f"{path.resolve().as_uri()}?mode=ro", uri=True, timeout=2)
        try:
            # Newest first, read only as far as the first call or compaction.
            for step_type, status, metadata in db.execute("SELECT step_type, status, metadata FROM steps "
                                                          "ORDER BY idx DESC"):
                if step_type == AGY_COMPACTION_STEP and status == AGY_STEP_DONE:  # a failed one compacted nothing
                    return 0
                if not isinstance(metadata, bytes):
                    continue
                try:
                    usage = next((v for f, v in protobuf_fields(metadata) if f == 9 and isinstance(v, bytes)), b"")
                    counts = {f: v for f, v in protobuf_fields(usage) if isinstance(v, int)}
                except (ValueError, IndexError):
                    continue
                if 2 in counts:
                    return counts[2] + counts.get(5, 0)
        finally:
            db.close()
    except (sqlite3.Error, ValueError):
        return None
    return None


def compact_at(kind: str | None = None) -> int:
    key, default = ("MESH_AGY_COMPACT_AT", AGY_COMPACT_AT) if kind == "agy" else ("MESH_COMPACT_AT", COMPACT_AT)
    try:
        return int(os.environ.get(key) or default)
    except ValueError:
        return default


def should_compact(mode: str, entry: dict, tokens: int | None, read_only: bool, cross_run: bool,
                   peer: bool = False) -> bool:
    """`--compact auto`: compact a conversation that a resume would otherwise re-read in full, turn after turn.

    An old conversation's prompt cache has expired, so every turn of the follow-up pays for its whole
    context. A question or two doesn't repay a compaction, so read-only tasks get twice the threshold, except
    a standing peer asker's: it is asked question after question, each time cold (design §14).
    """
    if mode != "auto":
        return mode == "yes"
    if tokens is None and entry.get("kind") == "agy":
        return cross_run and not read_only  # no size to go on: compact what comes back from an earlier run
    return tokens is not None and tokens > compact_at(entry.get("kind")) * (2 if read_only and not peer else 1)


def compact_conversation(entry: dict, session: str, model: str, focus: str) -> tuple[bool, str]:
    """Compact a stopped worker's conversation headless, in its own directory, before it is reopened."""
    prompt = f"/compact {focus}"
    if entry.get("kind") == "agy":
        argv = ["agy", "--conversation", session, "--model", model, "--dangerously-skip-permissions", "-p", prompt]
    else:
        # A one-off turn whose summary the resumed worker reads at once: a 5-minute cache is all it needs.
        argv = [claude_bin(), "-p", "--resume", session, "--model", model, "--dangerously-skip-permissions",
                "--settings", json.dumps({"promptCacheTtl": SHORT_CACHE}), prompt]
    # No identity at all: the compaction turn must not message anyone, or pass for the root.
    proc = run_cli(argv, cwd=entry["cwd"], env=claude_env(), timeout=COMPACT_TIMEOUT)
    return proc.returncode == 0, (proc.stderr or proc.stdout).strip()[-300:]


# ── worktrees ────────────────────────────────────────────────────────────


def slugify(text: str, limit: int) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return slug[:limit].strip("-") or "x"


def default_base(repo_top: Path) -> str:
    try:
        return git("rev-parse", "--abbrev-ref", "origin/HEAD", cwd=repo_top)
    except MeshError:
        return "HEAD"


def add_worktree(run_id: str, repo_top: Path, slug: str, base: str | None) -> tuple[Path, str, str]:
    """A worktree on a new run branch; the base commit is kept so `mesh stop` can tell an untouched branch."""
    branch = f"mesh/{run_id}/{slug}"
    path = worktree_root() / run_id / f"{slugify(repo_top.name, 20)}-{slug}"
    sha = git("rev-parse", "--verify", f"{base or default_base(repo_top)}^{{commit}}", cwd=repo_top)
    path.parent.mkdir(parents=True, exist_ok=True)
    git("worktree", "add", "-b", branch, str(path), sha, cwd=repo_top)
    with editing_run(run_id) as run:
        run.setdefault("worktrees", []).append({"path": str(path), "repo": str(repo_top), "branch": branch, "base": sha})
    log_event(run_id, "worktree", path=str(path), branch=branch)
    return path, branch, sha


def undo_worktree(repo_top: Path, path: Path, branch: str | None, base: str | None, run_id: str | None = None) -> None:
    """Take back a worktree just made or recreated, with nothing new in it: the worktree, its branch while it has
    no commits (`untouched_branch`) and, once both are gone, `run_id`'s row for it. A git error surfaces and
    keeps the row, so the run's `mesh stop` still sees the worktree."""
    git("worktree", "remove", "--force", str(path), cwd=repo_top)
    if branch and untouched_branch({"repo": str(repo_top), "branch": branch, "base": base}):
        git("branch", "-D", branch, cwd=repo_top)
    if run_id:
        with editing_run(run_id) as run:
            run["worktrees"] = [w for w in run.get("worktrees", []) if Path(w["path"]) != Path(path)]
        log_event(run_id, "worktree_undone", path=str(path), branch=branch)


def undoing_worktree(repo_top: Path, path: Path, branch: str | None, base: str | None, run_id: str | None = None):
    """For an `except` that re-raises: `undo_worktree`, with its own failure printed rather than raised over the
    error that made it."""
    try:
        undo_worktree(repo_top, path, branch, base, run_id)
    except MeshError as exc:
        print(f"warning: {path} was left in place: {exc}", file=sys.stderr)


def entry_branch(run: dict, entry: dict) -> str | None:
    """An agent's branch; a restart with --cwd records none, so look its worktree up."""
    if entry.get("branch"):
        return entry["branch"]
    cwd = entry.get("cwd")
    return next((wt["branch"] for wt in run.get("worktrees", []) if cwd and Path(wt["path"]) == Path(cwd)), None)


def gone_clone(path, repo) -> MeshError:
    return MeshError(f"{path} is gone and so is its clone {repo}: clone it there again to ask it")


def ensure_worktree(entry: dict, branch: str | None) -> bool:
    """Bring a removed worktree back at its old path, where Claude looks for the session. True if recreated."""
    path = Path(entry["cwd"])
    if path.exists():
        return False
    if not branch and entry.get("peer") and entry.get("repo"):  # a peer's detached worktree, as `peers remove` left it
        if not Path(entry["repo"]).is_dir():
            raise gone_clone(path, entry["repo"])
        git("worktree", "prune", cwd=entry["repo"])
        path.parent.mkdir(parents=True, exist_ok=True)
        at = entry.get("base")
        for ref in () if at else ("refs/remotes/origin/HEAD", "HEAD"):  # never fetched: upstream, else the clone
            try:
                at = git("rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}", cwd=entry["repo"])
                break
            except MeshError:
                continue
        if not at:
            raise MeshError(f"{path} is gone, and its clone {entry['repo']} has no commit to recreate it at")
        git("worktree", "add", "--detach", str(path), at, cwd=entry["repo"])
        return True
    if not branch or not entry.get("repo"):
        raise MeshError(f"{path} is gone and no branch is recorded for it")
    try:
        git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", cwd=entry["repo"])
        new_branch = []
    except MeshError:
        if not entry.get("base"):
            raise MeshError(f"branch {branch} no longer exists in {entry['repo']}") from None
        new_branch = ["-b", branch]  # `mesh stop` deleted it because it had no commits: start it again at its base
    git("worktree", "prune", cwd=entry["repo"])
    path.parent.mkdir(parents=True, exist_ok=True)
    git("worktree", "add", *new_branch, str(path), *([entry["base"]] if new_branch else [branch]), cwd=entry["repo"])
    return True


# ── messaging ────────────────────────────────────────────────────────────


PREVIEW_DROP = str.maketrans({"`": None, "$": None, '"': None, "'": "’"})  # an apostrophe stays readable


def preview(body: str, limit: int = 100) -> str:
    """The body on one line, short, and with nothing a receiving agent could read as shell (backticks, `$`, quotes)."""
    line = " ".join(body.translate(PREVIEW_DROP).split())
    return line if len(line) <= limit else line[: limit - 1] + "…"


def store_message(run_id: str, sender: str, to: str, mtype: str, body: str) -> Path:
    path = inbox_dir(run_id, to) / f"{stamp()}-{sender}-{mtype}.md"
    header = f"---\nrun: {run_id}\nfrom: {sender}\nto: {to}\ntype: {mtype}\ntime: {now_iso()}\n---\n"
    write_atomic(path, header + body.rstrip() + "\n")
    return path


def was_read(path: Path) -> bool:
    return not path.exists() and (path.parent / "read" / path.name).exists()


@contextmanager
def ring_lock(key: str):
    """One ring at a time into a pane (herdr merges concurrent prompts), for at most RING_LOCK_WAIT, then unlocked.

    Yields whether it got the lock. flock releases it when its process dies, so a killed ring holds nothing.
    """
    path = mesh_home() / "locks" / f"ring-{re.sub(r'[^A-Za-z0-9_.-]', '_', key)}.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as fh:
        locked = False
        for _ in range(max(1, int(RING_LOCK_WAIT / RING_LOCK_POLL))):
            try:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                locked = True
                break
            except BlockingIOError:
                time.sleep(RING_LOCK_POLL)
        try:
            yield locked
        finally:
            if locked:
                fcntl.flock(fh, fcntl.LOCK_UN)


def ring(targets: list[str], text: str, token: str, read: tuple[Path, ...] = (),
         delays: tuple[int, ...] = RING_DELAYS) -> dict:
    """Type the doorbell into the first reachable target, retrying while it is busy, and say how it got through.

    `via` is "working" (herdr saw the agent start), "pane" (the doorbell's token showed up above the input box),
    or "read" (the messages in `read` were read meanwhile, so nothing more is typed). herdr can miss that a busy
    agent queued the text (it returns stalled or timeout), hence the pane check, after such an error and before
    each retry; a pane that couldn't be read before the first try is never checked, since a later read can't
    tell what was there before. A human's draft in the input box holds the try (herdr would submit the doorbell
    fused to it); an unclear box doesn't. `tries` counts the prompts herdr took (not those it refused before
    typing: `agent_not_found`, `agent_blocked`). One attempt holds the pane's ring lock, keyed by the last
    target (the pane id), never the backoff sleeps.
    """
    needle = ring_needle(token)
    before: dict[str, int | None] = {}  # copies of the token above each target's input box before it was typed
    last_error, tries = None, 0
    for delay in (0, *delays):
        if delay:
            time.sleep(delay)
        if read and all(was_read(path) for path in read):
            return {"rung": True, "error": None, "via": "read", "tries": tries}
        with ring_lock(targets[-1]):
            for target in targets:
                lines = pane_lines(target, ansi=True)
                plain = None if lines is None else [strip_sgr(line) for line in lines]
                if target not in before:
                    before[target] = doorbells_shown(plain, needle)
                elif before[target] is not None and (doorbells_shown(plain, needle) or 0) > before[target]:
                    return {"rung": True, "error": None, "via": "pane", "tries": tries}  # queued after the last try
                if human_draft(lines):
                    last_error = "human_draft"
                    break
                try:
                    # --until working confirms delivery: an idle agent that doesn't start working
                    # within 5s never got the text (agent_prompt_stalled), so it is retried. A busy
                    # agent queues the doorbell for after its current turn, but herdr may not see it
                    # as working (agy between steps, Claude running a command): hence the pane check.
                    herdr("agent", "prompt", target, text, "--wait", "--until", "working", "--timeout", "15000",
                          timeout=30)
                    return {"rung": True, "error": None, "via": "working", "tries": tries + 1}
                except HerdrError as exc:
                    last_error = exc.code
                    if exc.code not in UNTYPED_RING_ERRORS:
                        tries += 1
                    if exc.code == "agent_not_found":
                        continue  # try the next target (the pane id)
                    if exc.code in TYPED_RING_ERRORS and before[target] is not None:
                        shown = doorbells_shown(pane_lines(target), needle)
                        if shown is not None and shown > before[target]:
                            return {"rung": True, "error": None, "via": "pane", "tries": tries}
                    if exc.code not in RETRYABLE_RING_ERRORS:
                        return {"rung": False, "error": exc.code, "via": None, "tries": tries}
                    break
    return {"rung": False, "error": last_error, "via": None, "tries": tries}


def ring_stored(run_id: str, sender: str, to: str, targets: list[str], text: str, token: str, path: Path,
                delays: tuple[int, ...] = RING_DELAYS, read: tuple[Path, ...] = ()) -> dict:
    """Ring for a stored message (or the unread ones in `read`), and log how it went.

    The event has no `type` field: a ring is never counted as a send.
    """
    result = ring(targets, text, token, read=read or (path,), delays=delays)
    if result["rung"]:
        log_event(run_id, "rung", sender=sender, to=to, file=path.name, via=result["via"], tries=result["tries"])
    else:
        log_event(run_id, "doorbell_failed", sender=sender, to=to, file=path.name, error=result["error"],
                  tries=result["tries"])
    return result


def ring_token() -> str:
    return secrets.token_hex(3)


def doorbell_text(run: dict, sender: str, to: str, mtype: str, body: str, first: bool, token: str | None = None) -> str:
    """The one-line doorbell; a rung one carries its `token`, which ring() looks for in the pane.

    The token goes early, where a CLI that shortens a long queued prompt keeps it. The start of a first doorbell,
    up to `run <id>`, is how resume finds an agent's conversation (first_doorbell, agy_conversation): keep it.
    """
    ref = f" (ref {token})" if token else ""
    if first:
        entry = run["agents"][to]
        if entry.get("swapped") and ((entry.get("models") or [{}])[-1].get("why") == "relaunched"):
            return (
                f"📬 [mesh] You are {to} ({entry['role']}) again in agent-mesh run {run['id']}{ref}, reopened with "
                f"mesh's settings (hooks, permissions) after something relaunched you without them, such as a herdr "
                f"restore; same conversation, model, parent and worktree. Run `mesh inbox` for your {mtype}."
            )
        if entry.get("swapped"):
            return (
                f"📬 [mesh] You are {to} ({entry['role']}) again in agent-mesh run {run['id']}{ref}, now on "
                f"{entry.get('model')} at {entry.get('effort')} effort; same parent and worktree. Run `mesh inbox` for your {mtype}."
            )
        if (entry.get("resumed_from") or {}).get("run") == run["id"]:  # the prefix up to `run <id>` is what
            return (  # agy's conversation lookup matches: only the rest differs
                f"📬 [mesh] You are {to} ({entry['role']}) again, resumed into agent-mesh run {run['id']}{ref}, the "
                f"same run: same parent ({entry['parent']}), worktree and `mesh dir`. Background tasks from before "
                f"(`task-…` ids) are gone. Run `mesh inbox` for your {mtype}."
            )
        if entry.get("resumed_from"):
            return (
                f"📬 [mesh] You are {to} ({entry['role']}) again, resumed into agent-mesh run {run['id']}{ref}; your "
                f"parent is {entry['parent']}. The run id, parent and paths changed, and background tasks from "
                f"before (`task-…` ids) are gone: re-read {PROTOCOL_PATH}, then run `mesh inbox` for your {mtype}."
            )
        return (
            f"📬 [mesh] You are {to} ({entry['role']}) in agent-mesh run {run['id']}{ref}; your parent is "
            f"{entry['parent']}. Read {PROTOCOL_PATH}, then run `mesh inbox` for your {mtype}."
        )
    return f"📬 [mesh] {mtype} from {sender}{ref}: {preview(body)} (run `mesh inbox`)"


def record(run_id: str, sender: str, to: str, mtype: str, body: str) -> Path:
    """Store a message in `to`'s mailbox and log it, without telling anyone."""
    path = store_message(run_id, sender, to, mtype, body)
    log_event(run_id, "send", sender=sender, to=to, type=mtype, file=path.name)
    return path


def native_route(run: dict, sender: str, to: str, claude=UNREAD, rows=UNREAD) -> dict | None:
    """How `to` hears of a message without its pane being typed into (design §11): `{"socket": address}` for mesh
    to write the doorbell into its inbox, `{"send_message": address}` for a Claude sender to pass on with
    SendMessage, or None to ring its pane. `claude` (`pane_claude`) and `rows` (`read_claude_agents`, None when
    it failed) are passed by a caller that has read them already.

    A Claude worker whose process mesh started accepting cross-session messages (`worker_settings`: a pane
    leader's `--settings`, a background one's recorded `inbound`) is written to at its socket while it runs:
    a background one's process from `claude agents`, a pane one's the Claude leading its pane. One started
    before mesh passed that flag would hold such a frame (its mode isn't asserted, and it bypasses
    permissions): a background one takes a Claude sender's SendMessage, as before, and a pane one is typed to.
    A Claude root is written to when it takes a frame that asserts no permission mode: its settings say
    `accept`, or with none set the newest `permissionMode` in its session file is a prompting one. A root in
    bypass mode (or one whose mode can't be read) holds such a frame, but takes a Claude worker's SendMessage,
    which asserts the same class; a `hold` or `refuse` setting holds or refuses both. A background worker
    launched accepting that has no socket (none yet, or its record unread) or whose settings now hold gets no
    route, never a SendMessage, which it would hold too; its sender reports it unreached (`bg_unreached`).
    """
    entry = run["agents"][to]
    if entry.get("kind") != "claude":
        return None
    claude_sender = run["agents"].get(sender, {}).get("kind") == "claude"
    if entry.get("role") == "root":
        if not root_reachable(entry):
            return None
        setting = inbound_setting(entry.get("cwd"))[0]
        if setting == "accept" or (setting is None and root_class(entry) == "prompting"):
            return {"socket": entry["address"]}
        return {"send_message": entry["address"]} if setting is None and claude_sender else None
    if entry.get("view") == "bg":
        row = bg_row(entry, claude_agents() if rows is UNREAD else rows or [])
        if not (row and row.get("status")):
            return None
        address = socket_address(row.get("pid"))
        if entry.get("inbound"):  # launched accepting: by its socket, or not at all (SendMessage is held too)
            return {"socket": address} if address and worker_accepts(entry.get("cwd")) else None
        return {"send_message": address or to} if claude_sender else None
    claude = pane_claude(entry) if claude is UNREAD else claude
    argv = (claude or {}).get("argv") or []
    if not (mesh_launched(argv, run["id"], to) and launched_accepting(argv) and worker_accepts(entry.get("cwd"))):
        return None
    address = socket_address(claude.get("pid"))
    return {"socket": address} if address else None


def root_class(entry: dict) -> str | None:
    """A Claude root's permission class now, by the newest `permissionMode` in its session file (a prompt or a
    mode change records one; `transcript_mode`), or None."""
    session = entry.get("session")
    return mode_class(transcript_mode(root_transcript(entry, session))) if session else None


def bg_unreached(name: str, entry: dict, rows: list[dict] | None) -> str:
    """Why a message to a background worker wasn't rung (it has no pane to fall back on), by `rows` (one read of
    `claude agents`, None when it failed)."""
    if rows is None:
        return (f"mesh couldn't tell whether {name} runs (`claude agents` failed); it sees the message at its next "
                f"`mesh inbox`, or `mesh ring {name}` once that works again")
    if bg_status(entry, rows) == "gone":
        return f"{name} is not running; `mesh resume {name}` brings it back to read it"
    if not entry.get("inbound"):
        return (f"{name} was launched before mesh started workers accepting cross-session messages, so mesh can't "
                f"write into its inbox, and a background session has no pane to ring: `mesh retire {name}` then "
                f"`mesh resume {name}` relaunches it accepting them")
    return (f"{name} runs, but mesh couldn't write into its inbox (no socket yet, a failed write, or settings "
            "that hold cross-session messages), and a background session has no pane to ring; it sees the message "
            f"at its next `mesh inbox`, or `mesh ring {name}` retries")


INBOX_TIMEOUT = 2.0  # seconds to connect to a Claude inbox socket and write one frame


def write_inbox(address: str, text: str) -> str | None:
    """Write `text` into a Claude session's inbox socket, as one user frame; None once it's written, else why not.

    The socket never answers, so a write is all there is to go by. It is never retried: Claude Code delivers a
    repeated frame again. No auth line: Claude Code 2.1.310 requires one only on Windows. A path that isn't a
    socket owned by this user (a symlink, another user's) isn't written to.
    """
    path = address.removeprefix("uds:")
    try:
        found = os.lstat(path)
        if not stat.S_ISSOCK(found.st_mode) or found.st_uid != os.getuid():
            return "not a socket of this user"
        frame = json.dumps({"type": "user", "message": {"role": "user", "content": text}}) + "\n"
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
            conn.settimeout(INBOX_TIMEOUT)
            conn.connect(path)
            conn.sendall(frame.encode())
    except OSError as exc:  # EPERM/EACCES: a sandboxed sender, which the pane still reaches
        return errno.errorcode.get(exc.errno, str(exc)) if exc.errno else str(exc) or type(exc).__name__
    return None


def ring_inbox(run_id: str, sender: str, to: str, address: str, text: str, path: Path) -> dict | None:
    """Ring `to` by writing the doorbell into its inbox socket, and log how it went: the delivery once written,
    None (logged `inbox_failed`) when the caller should ring its pane instead."""
    error = write_inbox(address, text)
    if error:
        log_event(run_id, "inbox_failed", sender=sender, to=to, file=path.name, address=address, error=error)
        return None
    log_event(run_id, "rung", sender=sender, to=to, file=path.name, via="socket", tries=1)
    if load_run(run_id)["agents"][to].get("swapped"):
        with editing_run(run_id) as data:  # the doorbell that says it was reopened has rung
            data["agents"][to].pop("swapped", None)
    return {"stored": str(path), "rung": True, "error": None, "via": "socket"}


def inbound_warnings(run: dict) -> list[str]:
    """What Claude Code's cross-session policy (`crossSessionInbound`) costs this run's delivery, for `init` and
    `status` to say: never fixed by mesh, since the root's settings are the user's (design §11)."""
    found = []
    root = run["agents"].get(run.get("root")) or {}
    if root.get("kind") == "claude":
        value, source = inbound_setting(root.get("cwd"))
        if value in ("hold", "refuse"):
            fix = " (`accept` there changes that: your call)" if source == "user" else ""
            found.append(f"warning: your session's crossSessionInbound is {value} ({source} settings{fix}), so "
                         "workers' reports are typed into your pane instead of arriving as cross-session messages")
    value, source = inbound_setting(None, "accept")
    if value != "accept":
        found.append(f"warning: {source} settings set crossSessionInbound to {value} for every Claude session, so "
                     "Claude workers open in panes and their doorbells are typed into them")
    return found


def delivered(delivery: dict) -> bool:
    """Rung, handed back as a SendMessage, the opening prompt of a background session (`launched`), or a report
    a fan-out collects (`collected`)."""
    return bool(delivery.get("rung") or "send_message" in delivery or delivery.get("launched")
                or delivery.get("collected"))


def refuse_headless(name: str, entry: dict, what: str) -> None:
    """A Copilot asker has no pane, mailbox reader or model swap: only `mesh ask` reaches it."""
    if entry.get("view") == "headless":
        raise MeshError(f"{name} is a headless Copilot asker, which {what} doesn't reach: "
                        f"ask it again with `mesh ask {name} --body …`")


RELAUNCH_WAIT = 60  # seconds deliver waits for a relaunched pane worker's turn to end before reopening it


def reopen_relaunched(run_id: str, sender: str, to: str, mtype: str, body: str, entry: dict,
                      path: Path) -> dict | None:
    """Reopen a pane worker something else relaunched (`relaunched_outside_mesh`) with mesh's flags, keeping its
    deny list, before its doorbell rings: None when the caller may ring it now, else the delivery to return.

    One reopen per worker: the delivery that claims it (`relaunching`, honoured while its process lives) reopens
    it; another one meanwhile, or while the new pane is still starting or held at a startup screen, stores its
    message for the reopened worker's doorbell, and one that finds it already moved to a new pane and running
    rings that. A reopen that can't be done (a turn going on, herdr lost the agent) leaves the message unrung:
    ringing would hand it a turn without its list.
    """
    with editing_run(run_id) as data:
        e = data["agents"][to]
        mark = e.get("relaunching") or {}
        moved = e.get("pane") != entry.get("pane")
        busy = pid_alive(mark.get("pid"), mark.get("start")) or (
            moved and (e.get("status") == "starting" or bool(e.get("held"))))
        if moved and not busy:
            return None  # another delivery reopened it already
        if not busy:
            e["relaunching"] = {"pid": os.getpid(), "start": proc_start(os.getpid())}
    if busy:
        log_event(run_id, "doorbell_failed", sender=sender, to=to, file=path.name, error="being reopened")
        return {"stored": str(path), "rung": False,
                "error": f"{to} is being reopened with mesh's flags by another delivery, whose doorbell covers "
                         "this; if that fails, the next message retries"}
    try:
        swap = swap_model(run_id, to, entry.get("model") or plan_chain("claude")[0],
                          entry.get("effort") or plan_effort_for("claude"), "relaunched", wait_ms=RELAUNCH_WAIT * 1000,
                          message=(sender, mtype, body), stored=path, lost_ok=False)
    except MeshError as exc:
        error = (f"{to} runs a Claude mesh didn't start (a herdr restore?), without its hooks and deny list, and "
                 f"wasn't reopened with them ({exc}); the next message retries, or `mesh retire {to}` then "
                 f"`mesh resume {to}`")
        log_event(run_id, "doorbell_failed", sender=sender, to=to, file=path.name, error=error)
        return {"stored": str(path), "rung": False, "error": error}
    finally:
        with editing_run(run_id) as data:
            data["agents"][to].pop("relaunching", None)
    return swap.get("delivery")  # reopened at a startup screen: held, rung once it's gone


SETTLE_DEADLINES: dict[tuple[str, str], float] = {}  # one wait per worker and process (lift_read_only, deliver)


def settled_status(run_id: str, name: str) -> str | None:
    """`name`'s status, read under the run lock once a retire under way has ended (at most RETIRE_WAIT_MS and
    half a minute, shared by every call in this process, so a send doesn't wait twice)."""
    key = (run_id, name)
    deadline = SETTLE_DEADLINES.setdefault(key, time.monotonic() + RETIRE_WAIT_MS / 1000 + 30)
    while True:
        with run_lock(run_id):
            status = (load_run(run_id)["agents"].get(name) or {}).get("status")
        if status != "retiring":
            SETTLE_DEADLINES.pop(key, None)  # that retire is over: a later one gets a wait of its own
            return status
        if time.monotonic() > deadline:  # kept: this process's next call for it doesn't wait again
            return status
        time.sleep(1)


def deliver(run_id: str, sender: str, to: str, mtype: str, body: str, first: bool = False,
            stored=None, delays: tuple[int, ...] = RING_DELAYS) -> dict:
    """Store the message, then ring `to`'s doorbell: written into its inbox socket (`native_route`), else handed
    back as the SendMessage that tells it (`send_message`), else typed into its pane.

    `stored()` runs between the two: what the recipient may act on must be recorded before it hears. A worker
    retired by then isn't rung: the delivery says `retired`, for `mesh send` or `mesh ask` to resume it. A Claude
    pane worker that something other than mesh relaunched (`relaunched_outside_mesh`) is first reopened with
    its flags (`swap_model`, keeping its deny list), or not rung at all.
    """
    run = load_run(run_id)
    entry = agent_entry(run, to)
    refuse_headless(to, entry, f"a `{mtype}` message")
    path = record(run_id, sender, to, mtype, body)
    if stored:
        stored()
        run = load_run(run_id)
    status = settled_status(run_id, to) if entry.get("role") == "worker" else None
    if status == "retired":
        # Read after storing, under the lock auto-retire checks the mailbox under: either it saw this message
        # and stayed open, or this sees it retiring (waited out) or retired. The caller resumes it, or not.
        return {"stored": str(path), "rung": False, "error": f"{to} is retired", "retired": True}
    if status == "retiring":  # still closing past the wait: ringing would type into a pane about to go
        error = (f"{to} is still being retired; the {mtype} is stored: once it is retired, `mesh resume {to}`, "
                 f"then `mesh ring {to}`")
        log_event(run_id, "doorbell_failed", sender=sender, to=to, file=path.name, error=error)
        return {"stored": str(path), "rung": False, "error": error, "retiring": True}
    if mtype in FINAL_TYPES and collecting(run["agents"].get(sender) or {}, to):
        # `mesh ask --peers` collects it from the mailbox into one file: no doorbell, no SendMessage
        log_event(run_id, "collected", sender=sender, to=to, file=path.name)
        return {"stored": str(path), "rung": False, "error": None, "collected": True}
    if entry.get("held"):  # at a startup screen: typing would answer it; release_held rings once it's gone
        try:
            at_screen = agent_status(to, entry) in ("blocked", "unknown")
        except HerdrError:
            at_screen = True  # can't tell: holding never types into a dialog
        with editing_run(run_id) as run:
            held = run["agents"][to].get("held") if at_screen else run["agents"][to].pop("held", None)
            if held and at_screen and not held.get("file"):  # nothing stored to ring for yet: this one is
                held.update(sender=sender, type=mtype, file=path.name)
        if held and at_screen:
            return {"stored": str(path), "rung": False, "type": mtype, "held": held["screen"],
                    "error": f"waiting at a startup screen ({held['screen']})"}
        first = first or bool(held)  # the screen is gone but its first doorbell never rang
    claude = pane_claude(entry)  # one read of its pane's process, for both checks below
    if relaunched_outside_mesh(run_id, to, entry, claude):  # before it gets a turn without its deny list and hooks
        reopened = reopen_relaunched(run_id, sender, to, mtype, body, entry, path)
        if reopened is not None:
            return reopened
        run = load_run(run_id)
        entry = agent_entry(run, to)
        claude = UNREAD  # a new pane, maybe
    first = first or bool(entry.get("swapped"))  # until a doorbell rings, the worker hasn't heard it was reopened
    rows = read_claude_agents() if entry.get("view") == "bg" else UNREAD
    route = native_route(run, sender, to, claude, rows) or {}
    if "socket" in route:  # no token: nothing reads a pane for it
        rung = ring_inbox(run_id, sender, to, route["socket"], doorbell_text(run, sender, to, mtype, body, first), path)
        if rung:
            return rung
    if "send_message" in route:
        log_event(run_id, "native", sender=sender, to=to, address=route["send_message"], file=path.name)
        return {"stored": str(path), "rung": False, "error": None,
                "send_message": {"to": route["send_message"],
                                 "message": doorbell_text(run, sender, to, mtype, body, first)}}
    if entry.get("view") == "bg":
        error = bg_unreached(to, entry, rows)
        log_event(run_id, "doorbell_failed", sender=sender, to=to, file=path.name, error=error)
        return {"stored": str(path), "rung": False, "error": error}
    token = ring_token()
    targets = [to] + ([entry["pane"]] if entry.get("pane") else [])
    result = ring_stored(run_id, sender, to, targets, doorbell_text(run, sender, to, mtype, body, first, token),
                         token, path, delays)
    if result["rung"] and entry.get("swapped"):
        with editing_run(run_id) as run:
            run["agents"][to].pop("swapped", None)
    return {"stored": str(path), "rung": result["rung"], "error": result["error"], "via": result["via"]}


def collector(me: str) -> dict:
    """What `ask --peers` marks its askers with: who collects their answers, and the fan-out's process."""
    return {"to": me, "pid": os.getpid(), "start": proc_start(os.getpid())}


def collecting(entry: dict, to: str) -> bool:
    """A fan-out that is still running collects this worker's answer to `to`; a killed one's mark is stale."""
    mark = entry.get("collect")
    return isinstance(mark, dict) and mark.get("to") == to and pid_alive(mark.get("pid"), mark.get("start"))


def unread(run_id: str, name: str) -> list[Path]:
    folder = inbox_dir(run_id, name)
    return sorted(p for p in folder.glob("*.md")) if folder.exists() else []


def mark_read(path: Path) -> None:
    read = path.parent / "read"
    read.mkdir(parents=True, exist_ok=True)
    os.replace(path, read / path.name)


def parse_message(path: Path) -> tuple[dict, str]:
    text = path.read_text()
    meta: dict[str, str] = {}
    body = text
    if text.startswith("---\n"):
        head, _, body = text[4:].partition("\n---\n")
        for line in head.splitlines():
            key, _, value = line.partition(": ")
            meta[key] = value
    return meta, body


def unread_received(run_id: str, name: str) -> list[dict]:
    """The tasks and answers still unread in `name`'s mailbox: what it has yet to act on."""
    found = []
    for path in unread(run_id, name):
        if path.stem.rsplit("-", 1)[-1] not in RECEIVED_TYPES:
            continue
        meta, body = parse_message(path)
        found.append({"type": meta.get("type"), "from": meta.get("from"), "time": meta.get("time"),
                      "gist": first_line(body.strip(), 100)})
    return found


# ── resources: the memory floor and leftover processes ───────────────────


def meminfo() -> dict[str, int] | None:
    """`/proc/meminfo` (or `MESH_MEMINFO`) in kB by field, or None where it can't be read (no /proc)."""
    try:
        text = Path(os.environ.get("MESH_MEMINFO") or "/proc/meminfo").read_text()
    except OSError:
        return None
    info = {}
    for line in text.splitlines():
        key, _, rest = line.partition(":")
        if rest.split() and rest.split()[0].isdigit():
            info[key.strip()] = int(rest.split()[0])
    return info


def min_free_mb(info: dict[str, int]) -> int:
    """The floor under which no agent starts: `MESH_MIN_FREE_MB` (0 turns the guard off), else 10 % of RAM plus
    10 % of swap, where earlyoom (and, without it, the thrashing) begins, plus room for the agent itself."""
    try:
        return max(0, int(os.environ["MESH_MIN_FREE_MB"]))
    except (KeyError, ValueError):
        pass
    total = info.get("MemTotal", 0) + info.get("SwapTotal", 0)
    return max(MIN_FREE_LEAST_MB, total // 10 // 1024 + MIN_FREE_HEADROOM_MB)


def reservations_path() -> Path:
    return mesh_home() / "reservations.json"


def memory_guard(what: str, reserve: bool = True) -> str | None:
    """Refuse to start `what` (a new agent process) while memory plus swap is under the floor (design §17).

    An agent any `mesh` process let start in the last RESERVE_FOR seconds hasn't grown into MemAvailable yet,
    so each one's reservation (in `reservations.json`, machine-wide, under a lock) counts as AGENT_MB used.
    With `reserve`, a pass adds this one's and returns its id, which `release_memory` takes back when the start
    fails after all."""
    info = meminfo()
    if info is None or "MemAvailable" not in info:
        return None  # no /proc: nothing to tell by
    floor = min_free_mb(info)
    if not floor:
        return None
    path = reservations_path()
    with file_lock(mesh_home() / ".reservations.lock"):
        try:
            stored = json.loads(path.read_text())
            held = [r for r in stored if time.time() - r.get("time", 0) < RESERVE_FOR]
        except (OSError, ValueError, TypeError, AttributeError):
            stored, held = None, []
        free = (info["MemAvailable"] + info.get("SwapFree", 0)) // 1024 - len(held) * AGENT_MB
        if free < floor:
            starting = f", {len(held)} agent{'s' if len(held) > 1 else ''} still starting" if held else ""
            raise MeshError(
                f"not starting {what}: {max(free, 0)} MB of memory and swap left{starting}, under the {floor} MB "
                "floor (MESH_MIN_FREE_MB). Retire workers that have reported (`mesh status` shows them; `mesh "
                "retire <name>` keeps their conversations resumable) and stop leftover dev servers, then try "
                "again, or set MESH_MIN_FREE_MB=0 to start it anyway")
        rid = None
        if reserve:
            rid = secrets.token_hex(6)
            held.append({"id": rid, "time": time.time(), "pid": os.getpid(), "what": what})
        if held != stored:
            write_atomic(path, json.dumps(held))
        return rid


def refresh_memory(rid: str | None) -> None:
    """Restart a reservation's clock, at the launch it was taken for."""
    if not rid:
        return
    with file_lock(mesh_home() / ".reservations.lock"):
        try:
            held = json.loads(reservations_path().read_text())
            for r in held:
                if r.get("id") == rid:
                    r["time"] = time.time()
            write_atomic(reservations_path(), json.dumps(held))
        except (OSError, ValueError, TypeError, AttributeError):
            pass


def release_memory(ids: list[str | None]) -> None:
    """Take back the reservations of agents that didn't start after all."""
    ids = {i for i in ids if i}
    if not ids:
        return
    with file_lock(mesh_home() / ".reservations.lock"):
        try:
            held = json.loads(reservations_path().read_text())
            write_atomic(reservations_path(), json.dumps([r for r in held if r.get("id") not in ids]))
        except (OSError, ValueError, TypeError, AttributeError):
            pass


def process_table() -> list[dict]:
    """Every process this user can read, from one pass over /proc: {pid, ppid, tty, argv, cwd, start} ([]
    without /proc). `tty` is its controlling terminal (0: none). A process whose cwd can't be read has cwd None."""
    if not has_proc():
        return []
    table = []
    for folder in Path("/proc").iterdir():
        if not folder.name.isdigit():
            continue
        try:
            fields = (folder / "stat").read_text().rsplit(")", 1)[1].split()
            argv = [a for a in (folder / "cmdline").read_bytes().decode(errors="replace").split("\0") if a]
        except (OSError, IndexError):
            continue  # exited as we looked
        try:
            cwd = os.readlink(folder / "cwd")
        except OSError:
            cwd = None  # not ours
        table.append({"pid": int(folder.name), "ppid": int(fields[1]), "tty": int(fields[4]), "argv": argv,
                      "cwd": cwd, "start": fields[19]})
    return table


def command_table() -> list[dict]:
    """Every process's {pid, argv}: `process_table` with /proc, else `ps` (macOS), whose command line comes joined
    by spaces, so its argv is split on them (enough to tell `claude attach <id>`). [] when neither can be read."""
    if has_proc():
        return process_table()
    try:
        out = subprocess.run(["ps", "-axww", "-o", "pid=,command="], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    table = []
    for line in out.splitlines():
        pid, _, command = line.strip().partition(" ")
        if not pid.isdigit():
            continue
        words = command.split()
        # A binary's path may hold spaces (macOS `Application Support`): its first word naming a CLI ends it.
        end = next((i for i, w in enumerate(words) if Path(w).name in (*AGENT_BINARIES, *INTERPRETERS)), 0)
        argv = [" ".join(words[:end + 1])] if words else []
        if words and Path(words[end]).name in INTERPRETERS:  # `node /Application Support/…/claude attach b1`
            script = next((j for j in range(end + 1, len(words)) if Path(words[j]).name in AGENT_BINARIES), end)
            if script > end:
                argv.append(" ".join(words[end + 1:script + 1]))
                end = script
        table.append({"pid": int(pid), "argv": [*argv, *words[end + 1:]]})
    return table


def leftover_processes(top: Path, table: list[dict]) -> list[dict]:
    """The processes in `top` that nothing alive owns: each one's chain of parents inside `top` holds no agent
    CLI and hangs off an init (its own parent died), and no process of that tree, wherever its cwd, holds a
    terminal or is an agent. A live pane's shell, a live agent and its MCP servers, a background session under
    its daemon, this command, and a user's own terminal shell or tmux server (on WSL both hang off the same
    `/init` orphans go to, but they and their panes hold a tty; an orphaned tool shell and its server don't):
    all left alone."""
    by_pid = {p["pid"]: p for p in table}
    children: dict[int, list[dict]] = {}
    for p in table:
        children.setdefault(p["ppid"], []).append(p)

    def owned(root: dict) -> bool:  # someone's: a terminal or an agent anywhere in the tree
        todo, seen = [root], set()
        while todo:
            node = todo.pop()
            if node["pid"] in seen:
                continue
            seen.add(node["pid"])
            if node.get("tty") or agent_binary(node["argv"]):
                return True
            todo += children.get(node["pid"], [])
        return False

    found = []
    for proc in table:
        if not inside(proc["cwd"], top):
            continue
        node, chain_top, seen = proc, proc, set()
        while node and inside(node["cwd"], top) and node["pid"] not in seen:
            seen.add(node["pid"])
            if agent_binary(node["argv"]):
                break
            chain_top = node
            node = by_pid.get(node["ppid"]) if node["ppid"] > 1 else {"pid": 1, "argv": ["init"], "cwd": "/"}
        else:
            if (node and (node["pid"] == 1 or Path((node["argv"] or [""])[0]).name in INIT_NAMES)
                    and not owned(chain_top)):
                found.append(proc)
    return found


def kill_process(pid: int, sig: int) -> None:
    try:
        os.kill(pid, sig)
    except OSError:
        pass  # gone already, or not ours


def sweepable(entry: dict, root_cwd: str | None) -> Path | None:
    """A worker's worktree the sweep may clean: inside mesh's worktrees, at least `<run>/<slug>` deep, not its
    repo's main checkout and not holding the root's cwd. None for anything else."""
    cwd = entry.get("cwd")
    if not cwd:
        return None
    top, home = Path(cwd).resolve(), worktree_root().resolve()
    if home not in top.parents or len(top.relative_to(home).parts) < 2:
        return None
    if entry.get("repo") and Path(entry["repo"]).resolve() == top:
        return None
    return None if root_cwd and inside(root_cwd, top) else top


def agents_in(top: Path, table: list[dict]) -> list[dict]:
    return [p for p in table if agent_binary(p["argv"]) and inside(p["cwd"], top)]


def own_agent(proc: dict, entry: dict) -> bool:
    """Whether an agent CLI process runs this worker's conversation: its command line names the session (a
    Claude `--session-id`/`--resume`, agy's `--conversation`, a bg session's host) or, for agy, which starts
    without one, the worker's own `--log-file`. With neither recorded, any agent in its worktree may be it."""
    marks = [m for m in (entry.get("session"), entry.get("log")) if m]
    return not marks or any(m in arg for arg in proc["argv"] for m in marks)


def sweep_worktrees(run_id: str, workers: dict[str, dict]) -> dict[str, list[int]]:
    """Stop what retired or stopped workers left running in their worktrees (a dev server, a watcher): TERM,
    a short wait, then KILL, each logged as `killed`. Waits a little for each worker's own agent to exit first,
    so its children have been orphaned; an agent still there (its own, lingering, or another's) keeps its tree.
    Never raises: a failure here must not fail a retire or a stop."""
    try:
        run = load_run(run_id)
        root_cwd = run["agents"].get(run.get("root"), {}).get("cwd")
        tops = {name: top for name, entry in workers.items() if (top := sweepable(entry, root_cwd))}
        if not tops:
            return {}
        table = process_table()
        for _ in range(SWEEP_AGENT_TRIES):
            if not any(own_agent(p, workers[name]) for name, top in tops.items() for p in agents_in(top, table)):
                break
            time.sleep(SWEEP_AGENT_POLL)
            table = process_table()
        killed = {}
        for name, top in tops.items():
            procs = leftover_processes(top, table)  # an agent still there keeps its own tree
            if not procs:
                continue
            for proc in procs:
                kill_process(proc["pid"], signal.SIGTERM)
            for _ in range(SWEEP_KILL_TRIES):
                if not any(pid_alive(p["pid"], p["start"]) for p in procs):
                    break
                time.sleep(SWEEP_KILL_POLL)
            forced = [p["pid"] for p in procs if pid_alive(p["pid"], p["start"])]
            for pid in forced:
                kill_process(pid, signal.SIGKILL)
            shown = [f"{p['pid']} {' '.join(p['argv'])[:80]}" for p in procs]
            quietly(log_event, run_id, "killed", name=name, cwd=str(top), pids=[p["pid"] for p in procs],
                    commands=shown, forced=forced)
            print(f"mesh: stopped {len(procs)} leftover process{'es' if len(procs) > 1 else ''} {name} left in "
                  f"{top}: {', '.join(shown)}", file=sys.stderr)
            killed[name] = [p["pid"] for p in procs]
        return killed
    except (MeshError, OSError, ValueError, KeyError) as exc:
        print(f"mesh: couldn't sweep leftover processes: {exc}", file=sys.stderr)
        return {}


# ── commands ─────────────────────────────────────────────────────────────


def emit(data, as_json: bool = True) -> None:
    print(json.dumps(data, indent=2) if as_json else data)


# The folders PROTOCOL.md and ORCHESTRATE.md tell agents to write into (`$(mesh dir)/<folder>/…`).
RUN_FOLDERS = ("plans", "reports", "tasks")


def make_run_folders(run_id: str) -> None:
    for folder in RUN_FOLDERS:
        (run_dir(run_id) / folder).mkdir(parents=True, exist_ok=True)


def init_run(mode: str | None, request: str | None, run_id: str | None = None) -> dict:
    """Start a run with this pane's agent as its root (mode None: the root's own CLI)."""
    pane = os.environ.get("HERDR_PANE_ID")
    if os.environ.get("HERDR_ENV") != "1" or not pane:
        raise MeshError("mesh init must run inside a herdr pane (HERDR_ENV=1)")
    run_id = run_id or "m" + secrets.token_hex(2)
    if not NAME_RE.match(run_id) or len(run_id) > 12:
        raise MeshError("run id must be short, lowercase, start with a letter")
    if run_dir(run_id).exists():
        raise MeshError(f"run {run_id} already exists")
    agents = herdr("agent", "list").get("agents", [])
    me = next((a for a in agents if a.get("pane_id") == pane), None)
    if me is None:
        raise MeshError(f"herdr sees no agent in pane {pane}")
    if os.environ.get("CLAUDE_CODE_SESSION_ID") and pane_runs_this_claude(pane) is False:
        raise MeshError(f"Claude session {os.environ['CLAUDE_CODE_SESSION_ID']} isn't the process running in pane "
                        f"{pane}, so it can't be its root ({NOT_LEADER_HINT})")
    mode = mode or (me.get("agent") if me.get("agent") in MODES else default_kind())
    require_cli(mode, f"mode {mode}")
    inbox = claude_process() if me.get("agent") == "claude" else {"address": None}
    # A root you already named keeps its name; otherwise it becomes `<repo>-lead`.
    name = me.get("name") or agent_name(repo_name(me.get("cwd")), "lead", {a["name"] for a in agents if a.get("name")})
    if name != me.get("name"):
        herdr("agent", "rename", pane, name)
    run = {
        "id": run_id,
        "version": VERSION,
        "mode": mode,
        "created": now_iso(),
        "root": name,
        "request": request or "",
        "agents": {
            name: {
                "role": "root",
                "kind": me.get("agent"),
                "pane": pane,
                "tab": me.get("tab_id"),
                "workspace": me.get("workspace_id"),
                "cwd": me.get("cwd"),
                "parent": None,
                "status": "running",
                "renamed": name != me.get("name"),
                # Claude workers reach a Claude root at this address (see native_route), while the process at
                # this pid, started at `start`, still runs (a later one could reuse the pid and the socket path).
                **inbox,
                # Its conversation, by which a root reopened in another pane re-records its address.
                **({"session": os.environ.get("CLAUDE_CODE_SESSION_ID")} if me.get("agent") == "claude" else {}),
            }
        },
        "tabs": {},
        "worktrees": [],
    }
    make_run_folders(run_id)  # before run.json, so whoever finds the run finds them too
    with run_lock(run_id):
        save_run(run_id, run)
    write_atomic(mesh_home() / "by-pane" / f"{pane_key(pane)}.json", json.dumps({"run": run_id, "name": name}))
    log_event(run_id, "init", name=name, mode=mode)
    return {"run": run_id, "name": name, "dir": str(run_dir(run_id)), "mode": mode,
            "address": run["agents"][name]["address"]}


def cmd_init(args: argparse.Namespace) -> int:
    result = init_run(args.mode, args.request, args.run_id)
    emit(result)
    for line in inbound_warnings(load_run(result["run"])):
        print(line, file=sys.stderr)
    return 0


def spawn_suffix(args: argparse.Namespace, run: dict) -> str:
    """A worker is named for its worktree slug, so the name says what it works on."""
    if args.name:
        return args.name
    if args.worktree:
        return args.worktree
    if args.cwd:  # a restart in an earlier worker's worktree: reuse its slug (agent_name adds -2)
        cwd = Path(args.cwd).expanduser().resolve()
        for wt in run.get("worktrees", []):
            if Path(wt["path"]).resolve() == cwd and wt.get("branch"):
                return wt["branch"].rsplit("/", 1)[-1]
    return f"worker{sum(a['role'] == 'worker' for a in run['agents'].values()) + 1}"


def worker_log(run_id: str, name: str) -> str:
    """Where an agy worker's log goes (`mesh watch` reads quota errors from it)."""
    path = run_dir(run_id) / "logs" / f"{name}.log"
    path.parent.mkdir(parents=True, exist_ok=True)
    return str(path)


def mesh_env(run_id: str, name: str, parent: str, role: str) -> dict[str, str]:
    """A worker's identity, and the configuration this process runs with (only the keys that are set)."""
    env = {"MESH_RUN": run_id, "MESH_SELF": name, "MESH_PARENT": parent, "MESH_ROLE": role}
    env.update({key: os.environ[key] for key in MESH_CONFIG if os.environ.get(key)})
    env["MESH_CONFIG_FILE"] = str(config_path())  # the policy this launch read, whatever the worker's XDG dirs
    return env


def cmd_spawn(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    result = spawn_worker(args, run_id, me)
    emit(result)
    held = report_held(result["name"], result.get("delivery"))  # the alert first: only the user can clear it
    warn_unwatched(run_id)
    return held or 0


def spawn_worker(args: argparse.Namespace, run_id: str, me: str) -> dict:
    held: list[str | None] = []  # its memory reservation, taken back if it doesn't start
    try:
        return start_worker(args, run_id, me, held)
    except BaseException:
        quietly(release_memory, held)  # only while nothing was launched (start_worker empties it then)
        raise


def start_worker(args: argparse.Namespace, run_id: str, me: str, held: list[str | None]) -> dict:
    repo_top = resolve_repo(args.repo)
    run = load_run(run_id)
    taken = set(run["agents"]) | live_agent_names()
    name = getattr(args, "agent", None) or agent_name(repo_top.name, spawn_suffix(args, run), taken)
    if getattr(args, "agent", None) and name in taken:
        raise MeshError(f"{name} is taken in this run or by a live agent")
    peer = getattr(args, "peer", None)
    task = read_body(args.task, args.task_file)  # a missing file fails here, before any side effect

    # Resolve the model before any side effect, so a failed lookup leaves no orphan worktree.
    size = getattr(args, "size", None) or "large"
    user_review = getattr(args, "plan_review", None) == "user"
    if user_review:
        require_cli("claude", "--plan-review user (Claude Code's plan mode)")
    args.kind = args.kind or default_kind()
    require_cli(args.kind, f"a{'n' if args.kind == 'agy' else ''} {args.kind} worker")
    sized = size_policy(args.kind, size)
    if (sized or user_review) and (args.exec_model or args.exec_effort):
        raise MeshError(f"a {'user-reviewed' if user_review else size} task has no execution phase: "
                        "drop --exec-model / --exec-effort")
    if user_review and (args.kind != "claude" or sized):
        raise MeshError("--plan-review user is for a large Claude task (Opus in plan mode, in a pane)")
    named = args.model if args.model != "auto" else None  # `auto` names the plan chain, which these tasks skip
    if sized:  # one model for the whole task, and no plan phase
        auto, exec_model, exec_effort = False, None, None
        model, effort, notes = named or sized["model"], args.effort or sized["effort"], []
    elif user_review:  # Claude Code leaves plan mode when the user approves the plan, on the same model
        auto, exec_model, exec_effort = False, None, None
        model, effort, notes = named or setting("models.claude.user_review"), args.effort or plan_effort_for("claude"), []
    else:
        # `auto` plans on the best model with quota and switches to the exec model at `mesh approve`.
        auto = (args.model or "auto") == "auto"
        exec_model = args.exec_model or (exec_model_for(args.kind) if auto else None)
        if args.exec_effort and not exec_model:
            raise MeshError("--exec-effort needs an execution phase: drop --model, or add --exec-model")
        # A named --effort covers the whole task; --exec-effort alone overrides the execution phase.
        effort = args.effort or plan_effort_for(args.kind)
        exec_effort = (args.exec_effort or args.effort or exec_effort_for(args.kind)) if exec_model else None
        if exec_model:
            resolve_model(args.kind, exec_model, exec_effort)  # fail now, not after a whole planning phase
        model, notes = plan_model(args.kind, effort, run_id) if auto else (args.model, [])
    view = getattr(args, "view", None) or (sized["view"] if sized else "pane")
    if view == "bg" and (args.kind != "claude" or user_review):
        if getattr(args, "view", None):
            raise MeshError("--view bg is for Claude workers (agy has no background sessions; a user-reviewed "
                            "plan needs a pane)")
        view = "pane"
    # A named model or effort with no exec phase covers the whole task, a later one included (has_phases).
    # `mesh ask` says itself whether its effort was named (a sized reviewer's REVIEW_EFFORT isn't).
    pinned = getattr(args, "pinned", None)
    pinned = not exec_model and bool(named or args.effort if pinned is None else pinned)
    reserve_guard(run_id, args.kind, model, effort, name)
    held.append(memory_guard(name))  # the last check before any side effect
    log = worker_log(run_id, name) if args.kind == "agy" else None
    argv, model, session = agent_argv(args.kind, model, effort, log)
    if user_review:
        argv = [a for a in argv if a != "--dangerously-skip-permissions"]
        argv += ["--permission-mode", "plan", *(["--allow-dangerously-skip-permissions"] if skip_flags() else [])]
    named_bg, root = bool(getattr(args, "view", None)), run["agents"][run["root"]]
    view = background_view(view, named_bg, root, notes, "starting")  # refused before any side effect
    branch = base = None
    if args.worktree:
        cwd, branch, base = add_worktree(run_id, repo_top, slugify(args.worktree, 24), args.base)
    elif args.cwd:
        cwd = Path(args.cwd).expanduser().resolve()
    else:
        cwd = repo_top
    # Until the worker runs, any failure takes the fresh worktree back, so a retry under the same name works.
    launched = False
    try:
        # The worktree's own settings decide whether its worker hears from mesh (`.claude/settings.local.json`
        # is untracked, so the main checkout's may differ).
        view = settings_view(view, named_bg, cwd, notes, "starting")

        parent = args.parent or me
        if task and (sized or user_review) and not task.startswith(READ_ONLY_STARTS):
            task = f"{DIRECT_PREFIX if sized else USER_REVIEW_PREFIX}\n\n{task}"
        read_only = args.kind == "claude" and read_only_task(task)
        # A large task plans first, under the deny list until `mesh approve` lifts it; with no task yet, it will.
        planning = args.kind == "claude" and not (sized or user_review or read_only) and (not task or planned_task(task))
        deny = claude_deny({"kind": args.kind, "read_only": read_only, "planning": planning, "cwd": cwd, "repo": repo_top})
        env = mesh_env(run_id, name, parent, args.role)
        with editing_run(run_id) as run:
            run["agents"][name] = {
                "role": args.role, "kind": args.kind, "model": model, "effort": effort, "size": size, "view": view,
                "plan_review": "user" if user_review else None, "pinned": pinned, "read_only": read_only,
                "planning": planning,
                "repo": str(repo_top), "cwd": str(cwd), "branch": branch, "base": base, "session": session, "pane": None,
                "tab": None, "workspace": None, "parent": parent, "status": "starting", "spawned": now_iso(),
                "log": log, "phase": "plan" if exec_model else None, "exec_model": exec_model, "exec_effort": exec_effort,
                "models": [{"model": model, "effort": effort, "at": now_iso(), "why": "spawn"}],
                **({"peer": peer} if peer else {}),
                **({"collect": args.collect} if getattr(args, "collect", None) else {}),
            }
        result = {"name": name, "cwd": str(cwd), "branch": branch, "model": model, "effort": effort, "size": size,
                  "exec_model": exec_model, "notes": notes}

        task_path = None
        if view == "bg":
            # The task waits in the mailbox; the first doorbell is the session's opening prompt.
            task_path = record(run_id, me, name, "task", task) if task else None
            prompt = doorbell_text(load_run(run_id), me, name, "task", task or "", first=True)
            try:
                bg_id, session = launch_bg(name, cwd, model, effort, env, prompt, extra=deny)
            except MeshError as exc:  # untrusted folder, or a launch that didn't take
                notes.append(f"{exc}; starting a pane instead")
                view = "pane"
            else:
                with editing_run(run_id) as run:
                    run["agents"][name].update(bg_id=bg_id, session=session, status="running", inbound=WORKER_INBOUND)
                log_event(run_id, "spawn", name=name, kind=args.kind, role=args.role, model=model, view="bg",
                          bg_id=bg_id, parent=parent)
                result.update(view="bg", bg_id=bg_id, session=session)
                if task_path:
                    result["delivery"] = {"stored": str(task_path), "rung": False, "error": None, "launched": True}
                launched = True
                held.clear()  # it runs: its reservation stands

        if not launched:
            pane, tab, workspace_id, created_ws = place_pane(run_id, name, repo_top, cwd, env, bool(peer))
            with editing_run(run_id) as run:
                run["agents"][name].update(view="pane", pane=pane, tab=tab, workspace=workspace_id)
            log_event(run_id, "spawn", name=name, kind=args.kind, role=args.role, model=model, pane=pane,
                      parent=parent)
            held.clear()  # launching: its reservation stands
            started = start_agent(name, args.kind, pane, [*deny, *argv, *settings_argv(args.kind, env)],
                                  peer=bool(peer))
    except BaseException:
        if branch and not launched:
            undoing_worktree(repo_top, cwd, branch, base, run_id)
        raise
    if launched:  # in the background
        return result
    with editing_run(run_id) as run:
        run["agents"][name]["status"] = "running"

    result.update(view="pane", pane=pane, workspace=workspace_id, workspace_created=created_ws)
    if started.get("held"):  # at a startup screen: no ring now, the watch rings once it's gone
        result["delivery"] = hold(run_id, me, name, "task", task, started, stored=task_path)
    elif task_path:  # stored before a background launch that fell back to this pane
        token = ring_token()
        rang = ring_stored(run_id, me, name, [name, pane],
                           doorbell_text(load_run(run_id), me, name, "task", task, True, token), token, task_path)
        result["delivery"] = {"stored": str(task_path), "rung": rang["rung"], "error": rang["error"], "via": rang["via"]}
    elif task:
        result["delivery"] = deliver(run_id, me, name, "task", task, first=True)
    return result


def plan_model(kind: str, effort: str, run_id: str | None = None) -> tuple[str, list[str]]:
    """The model a task plans on. agy: the first of the chain over the reserve; with none, the one with the most
    left only when the run was let past the reserve (`mesh reserve off`), else an error."""
    if kind == "agy":
        return choose_agy_model(plan_chain("agy"), effort, fallback=reserve_off(run_id) or quota_stop() >= 100)
    return plan_chain("claude")[0], []


def swap_bg(run_id: str, name: str, entry: dict, session: str, model: str, effort: str, why: str,
            wait_ms: int, strict: bool, message: tuple[str, str, str], lift: bool) -> dict:
    """swap_model for a background worker: stop it, then start a copy of its conversation on the new model.

    The message goes into its mailbox first, since the copy's opening prompt is the doorbell for it.
    """
    wait_bg_idle(entry, wait_ms, strict)
    sender, mtype, body = message
    path = record(run_id, sender, name, mtype, body)
    with editing_run(run_id) as run:  # "starting" before the stop, so `mesh watch` doesn't take the gap for an exit
        e = run["agents"][name]
        e.update(model=model, effort=effort, status="starting", swapped=True, **lifted(entry, lift))
        e.setdefault("models", []).append({"model": model, "effort": effort, "at": now_iso(), "why": why})
    stop_bg(entry)
    prompt = doorbell_text(load_run(run_id), sender, name, mtype, body, first=True)
    try:
        bg_id, new_session = launch_bg(name, entry["cwd"], model, effort,
                                       mesh_env(run_id, name, entry["parent"], entry["role"]), prompt, resume=session,
                                       extra=claude_deny({**entry, **lifted(entry, lift)}))
    except MeshError as exc:
        with editing_run(run_id) as run:
            e = run["agents"][name]
            e.update(model=entry.get("model"), effort=entry.get("effort"), status="swap_failed",
                     **lifted(entry, False))
            e.pop("swapped", None)
            e["models"].pop()
        log_event(run_id, "swap_failed", name=name, model=model, effort=effort, why=why, error=str(exc))
        raise MeshError(f"{name} was not reopened on {model} ({exc}); its {mtype} is in its mailbox, retry") from exc
    with editing_run(run_id) as run:
        e = run["agents"][name]
        e.update(bg_id=bg_id, session=new_session, status="running", inbound=WORKER_INBOUND)
        e.pop("swapped", None)
        e.setdefault("sessions", []).append(session)  # the conversation it was copied from
    log_event(run_id, "swap", name=name, model=model, effort=effort, why=why, bg_id=bg_id, session=new_session)
    return {"name": name, "model": model, "bg_id": bg_id, "previous": entry.get("model"),
            "delivery": {"stored": str(path), "rung": False, "error": None, "launched": True}}


def lifted(entry: dict, lift: bool) -> dict:
    """The deny-list reasons (claude_deny) a reopen records: none when it lifts the list, else the entry's own."""
    return {key: False if lift else bool(entry.get(key)) for key in ("read_only", "planning")}


def swap_model(run_id: str, name: str, model: str, effort: str, why: str, wait_ms: int = 600_000,
               strict: bool = True, message: tuple[str, str, str] | None = None,
               lift: bool = False, stored: Path | None = None, lost_ok: bool = True) -> dict:
    """Restart a worker on another model or effort in the same conversation, pane by pane, keeping its name.

    Waits up to `wait_ms` for the worker's turn to end. `strict` fails if it doesn't; a worker that
    hit a quota is not strict, since its turn is already dead whatever herdr shows. A background worker
    gets `message` (sender, type, body) as its opening prompt (the result's `delivery`); for a pane the
    caller delivers it once the pane is back (`stored`: already in its mailbox). Without `lost_ok`, an agent herdr
    doesn't know isn't reopened, as its turn can't be waited for. `lift` reopens it without its deny list (claude_deny), clearing
    both of its reasons; otherwise it keeps whatever it had.
    """
    entry = agent_entry(load_run(run_id), name)
    refuse_headless(name, entry, "a model swap")
    session = find_session(run_id, name, entry)
    if not session:
        raise SwapNotStarted(f"can't find {name}'s {entry.get('kind')} conversation, so its model can't be switched; "
                             f"start a fresh worker with `mesh spawn --cwd {entry.get('cwd')}` if it must change")
    if entry.get("view") == "bg":
        return swap_bg(run_id, name, entry, session, model, effort, why, wait_ms, strict,
                       message or ("mesh", "info", f"You are now on {model} at {effort} effort."), lift)
    try:  # never cut a turn short: the conversation is only safe to reopen between turns
        herdr("agent", "wait", name, "--until", "idle", "--until", "done", "--timeout", str(wait_ms),
              timeout=wait_ms / 1000 + 10)
    except HerdrError as exc:
        if exc.code == "agent_not_found" and not lost_ok:
            raise SwapNotStarted(f"herdr doesn't know {name}, so its turn can't be waited for") from exc
        if exc.code != "agent_not_found" and (strict or exc.code not in ("timeout", "cli_error")):
            if exc.code == "timeout":
                raise SwapNotStarted(f"{name} didn't finish its turn ({exc})") from exc
            raise
    # The new pane opens beside the old one before that closes, so its tab survives: the root's, else the run's.
    env = mesh_env(run_id, name, entry["parent"], entry["role"])
    run = load_run(run_id)
    side = bool(entry.get("tab")) and entry["tab"] == run["agents"][run["root"]].get("tab")
    beside = side and beside_root(run_id, name, Path(entry["cwd"]), env, replacing=entry.get("pane"))
    if beside:
        pane, tab, workspace_id = beside
    else:  # a side worker's recorded workspace is the root's, so it goes to its project's (a peer's: the root's)
        workspace_id = ((not side and entry.get("workspace"))
                        or worker_workspace(run_id, Path(entry["repo"]), bool(entry.get("peer")))[0])
        pane, tab = new_pane(run_id, name, workspace_id, Path(entry["cwd"]), env)
    with editing_run(run_id) as run:  # "starting" first, so `mesh watch` doesn't take the gap for an exit
        e = run["agents"][name]
        e.update(model=model, effort=effort, pane=pane, tab=tab, workspace=workspace_id, session=session,
                 status="starting", swapped=True, **lifted(entry, lift))
        e.setdefault("models", []).append({"model": model, "effort": effort, "at": now_iso(), "why": why})
    argv = [*log_argv(entry.get("log")), *claude_deny({**entry, **lifted(entry, lift)}),
            *resume_argv(entry["kind"], session, model, effort), *skip_flags(),
            *settings_argv(entry["kind"], env)]
    try:
        try:
            herdr("pane", "close", entry["pane"])
        except HerdrError as exc:
            if exc.code not in ("pane_not_found", "agent_not_found"):
                raise
        log_event(run_id, "swap", name=name, model=model, effort=effort, why=why, pane=pane, session=session)
        started = start_agent(name, entry["kind"], pane, argv, peer=bool(entry.get("peer")))
    except MeshError as exc:
        with editing_run(run_id) as run:  # the old model is still the recorded one, so a retry swaps again
            e = run["agents"][name]
            e.update(model=entry.get("model"), effort=entry.get("effort"), status="swap_failed",
                     **lifted(entry, False))
            e.pop("swapped", None)
            e["models"].pop()
        log_event(run_id, "swap_failed", name=name, model=model, effort=effort, why=why, error=str(exc))
        raise MeshError(f"{name} was not reopened on {model} ({exc}); look at it with "
                        f"`herdr agent read {name}`, then retry") from exc
    with editing_run(run_id) as run:
        run["agents"][name]["status"] = "running"
    result = {"name": name, "model": model, "pane": pane, "previous": entry.get("model")}
    if started.get("held") and message:  # the caller would ring a pane at a startup screen: hold it instead
        result["delivery"] = hold(run_id, message[0], name, message[1], message[2], started, stored=stored)
    return result


def require_parent(run: dict, me: str, name: str, command: str) -> dict:
    """`name`'s entry, if `me` may run `mesh <command>` on it: its parent, or the run's root.

    `--as` is taken as given: what this stops is the accidental call, such as a worker approving its own plan.
    """
    entry = agent_entry(run, name)
    if entry.get("role") == "root":
        raise MeshError(f"{name} is the run's root, and `mesh {command}` acts on a worker "
                        "(`mesh stop` ends the run)")
    if me in (entry.get("parent"), run["root"]):
        return entry
    log_event(run["id"], "refused", name=me, command=command, agent=name)
    if me == name:
        raise MeshError(f"`mesh {command}` is for your parent ({entry.get('parent')}), not for you: send it a "
                        "`plan` or a `question` with `mesh send parent`, and wait for its answer")
    raise MeshError(f"only {name}'s parent ({entry.get('parent')}) runs `mesh {command}` on it, and this is {me} "
                    f"(acting for the parent from another terminal: pass --run {run['id']} --as {entry.get('parent')})")


def refuse_no_plan(run_id: str, name: str, entry: dict) -> None:
    """Approve only a plan that waits for its answer: the worker's newest report since its last task or answer.

    A worker whose bg swap failed at approval was already sent its approval, before the launch (`swap_bg`):
    the retry that ORCHESTRATE offers approves it again. Only that swap: a failed `mesh switch` while planning
    leaves the same status, with nothing approved. A pinned planner has no phase, but its `planning` says it.
    """
    events = read_log(run_id)
    if entry.get("status") == "swap_failed" and (entry.get("phase") == "plan" or entry.get("planning")):
        failed = [e for e in events if e.get("event") == "swap_failed" and e.get("name") == name]
        if failed and failed[-1].get("why") == "plan approved":
            return
    report, received = last_report(events, name)
    if report and report.get("type") == "plan":
        return
    if report:
        what = (f"answer it with `mesh send {name} --type answer`, and approve the plan it then sends again"
                if report["type"] == "question" else "there is nothing to approve")
        raise MeshError(f"{name} has no plan waiting: its newest report, at {report.get('time')}, is a "
                        f"{report['type']}; {what}")
    if received:
        hint = (f" (if that was the approval and its doorbell didn't ring, `mesh ring {name}`)"
                if received.get("type") == "answer" else "")
        raise MeshError(f"{name} has no plan waiting: it hasn't reported since the {received.get('type')} it got "
                        f"from {received.get('sender')} at {received.get('time')}{hint}")
    raise MeshError(f"{name} has no plan waiting: it hasn't sent one")


def cmd_approve(args: argparse.Namespace) -> int:
    """Approve a worker's plan; a worker on `auto` moves to its exec model first, keeping its conversation."""
    run_id, me = identity(args)
    entry = require_parent(load_run(run_id), me, args.agent, "approve")
    refuse_headless(args.agent, entry, "`mesh approve`")
    refuse_no_plan(run_id, args.agent, entry)
    reserve_guard(run_id, entry.get("kind"), entry.get("exec_model") or entry.get("model"),
                  entry.get("exec_effort") or entry.get("effort"), f"{args.agent}'s execution")
    result: dict = {"name": args.agent, "model": entry.get("model")}
    extra = read_body(args.body, args.file)
    body = "approved" + (f"\n\n{extra.strip()}" if extra and extra.strip() else "")
    # A Claude planner runs with its deny list until now: whatever else happens, the reopen lifts it (design §9).
    denied = bool(entry.get("planning") and claude_deny(entry))
    model, effort = entry.get("model"), entry.get("effort")
    if entry.get("phase") == "plan" and entry.get("exec_model"):
        if args.keep_model:  # asked for, never a fallback: it executes on what it planned on
            if not denied:  # else the reopen below records it, and logs this once it has started
                log_event(run_id, "approve_kept_model", name=args.agent, model=entry.get("model"))
            result["kept_model"] = True
        else:
            effort = entry.get("exec_effort") or exec_effort_for(entry["kind"])
            model = resolve_model(entry["kind"], entry["exec_model"], effort)
    if denied or (model, effort) != (entry.get("model"), entry.get("effort")):
        try:
            result["swap"] = swap_model(run_id, args.agent, model, effort, "plan approved",
                                        message=(me, "answer", body), lift=True)
        except SwapNotStarted as exc:
            if denied:  # --keep-model reopens it too: nothing gets its edits back but a reopen
                raise MeshError(f"{exc}. Nothing was sent. {args.agent} plans with its edits denied, and only "
                                f"reopening its conversation lifts that: run `mesh approve {args.agent}` again once "
                                "its turn has ended") from exc
            raise MeshError(f"{exc}. Nothing was sent. To approve it on {entry.get('model')} instead, run "
                            f"`mesh approve {args.agent} --keep-model`: it is then recorded as executing, so a "
                            f"later `mesh switch` moves it to {entry['exec_model']}") from exc
        result["model"] = model
        if result.get("kept_model"):
            log_event(run_id, "approve_kept_model", name=args.agent, model=model)
    if entry.get("phase") == "plan" and entry.get("exec_model"):
        with editing_run(run_id) as run:
            agent = run["agents"][args.agent]
            agent["phase"] = "exec"
            if "swap" not in result:  # no reopen recorded where execution starts
                agent.setdefault("models", []).append({"model": model, "effort": effort, "at": now_iso(),
                                                       "why": "plan approved",
                                                       **({"kept": True} if result.get("kept_model") else {})})
    result["delivery"] = (result.get("swap") or {}).pop("delivery", None) or deliver(
        run_id, me, args.agent, "answer", body, first="swap" in result)
    emit(result)
    held = report_held(args.agent, result["delivery"])
    warn_unwatched(run_id)
    return held or (0 if delivered(result["delivery"]) else 2)


def models_tried(entry: dict) -> tuple[str, ...]:
    """Every model the worker has run on in its current phase: `switch` never goes back to one."""
    models = entry.get("models", [])
    marker = "plan approved" if entry.get("phase") == "exec" else "planned task"
    start = next((i for i in range(len(models) - 1, -1, -1) if models[i].get("why") == marker), 0)
    return tuple({entry.get("model"), *(m["model"] for m in models[start:])})


def cmd_switch(args: argparse.Namespace) -> int:
    """Move a worker that hit a quota to the next model with quota left, and tell it to carry on."""
    run_id, me = identity(args)
    entry = require_parent(load_run(run_id), me, args.agent, "switch")
    refuse_headless(args.agent, entry, "`mesh switch`")
    effort = entry.get("effort") or plan_effort_for(entry["kind"])
    if entry.get("phase") == "exec" and not args.model:  # after `approve --keep-model` it still has the plan's
        effort = entry.get("exec_effort") or exec_effort_for(entry["kind"])
    notes: list[str] = []
    if args.model:
        model = resolve_model(entry["kind"], args.model, effort)
        parsed = parse_agy_id(model) if entry["kind"] == "agy" else None
        effort = parsed[2] if parsed else effort  # an exact id carries its own effort
    elif entry["kind"] != "agy":
        raise MeshError("only agy quotas are known to mesh; pass --model for a claude worker")
    else:
        chain = plan_chain("agy") if entry.get("phase") != "exec" else (entry.get("exec_model") or exec_model_for("agy"),)
        try:
            model, notes = choose_agy_model(chain, effort, skip=models_tried(entry), force=True, fallback=False)
        except MeshError as exc:  # nowhere to move it: it waits on its own model, and mesh continues it at the reset
            spent = agy_at_reserve(entry["model"]) if entry.get("model") else None
            due = schedule_continue(run_id, args.agent, "quota", epoch(spent[1]) or None if spent else None)
            emit({"name": args.agent, "switched": False, "continue_at": due.get("at"), "notes": [str(exc)]})
            print(f"mesh: {exc}. {args.agent} stays on {entry.get('model')}, and mesh continues it there "
                  f"{continue_text(due)}: tell the user, and send it nothing", file=sys.stderr)
            return 0
    body = (f"Your previous model ({entry.get('model')}) hit its quota; you are now on {model}, in the same "
            "conversation. Continue exactly where you stopped.")
    swap = swap_model(run_id, args.agent, model, effort, "quota", wait_ms=60_000, strict=False,
                      message=(me, "task", body))
    delivery = swap.pop("delivery", None) or deliver(run_id, me, args.agent, "task", body, first=True)
    emit({**swap, "notes": notes, "delivery": delivery})
    held = report_held(args.agent, delivery)
    warn_unwatched(run_id)
    return held or (0 if delivered(delivery) else 2)


def quota_hit(log: str | None, offset: int) -> tuple[str | None, int]:
    """(reset time or None, new offset): the reset time ("" if unknown) of a quota error agy logged after `offset`.

    Reads only the new bytes. A log that is shorter than `offset` was truncated by a restarted agy: read it afresh.
    """
    if not log or not Path(log).exists():
        return None, offset
    with open(log, "rb") as fh:
        size = fh.seek(0, os.SEEK_END)
        offset = 0 if size < offset else offset
        fh.seek(offset)
        hit = QUOTA_RE.search(fh.read().decode(errors="replace"))
    if not hit:
        return None, size
    reset = RESET_RE.search(hit.group(0))
    return (reset.group(1) if reset else ""), size


def read_body(body: str | None, file: str | None) -> str | None:
    if not file:
        return body
    try:
        return sys.stdin.read() if file == "-" else Path(file).expanduser().read_text()
    except (OSError, UnicodeDecodeError) as e:
        raise MeshError(f"can't read {'stdin' if file == '-' else file}: {getattr(e, 'strerror', None) or e}") from None


def lift_read_only(run_id: str, me: str, to: str, mtype: str, body: str, stored=None) -> dict | None:
    """A change task for a Claude worker under its deny list (claude_deny): the list follows the task.

    A task it plans first keeps the list until `mesh approve` lifts it: a read-only asker's reason just becomes
    `planning`, with no reopen. A direct task reopens its conversation without the list, on the same model and
    effort, by `swap_model` as `mesh approve` does, then delivers. None when it delivers as usual: not a task,
    a question or a review again, no deny list, or a planned task. `send` never reopens a worker to add the list.
    `stored` runs once the task is in its mailbox, as `deliver` runs it.
    """
    if mtype != "task" or read_only_task(body):
        return None
    entry = agent_entry(load_run(run_id), to)
    if entry.get("peer"):
        raise MeshError(f"{to} is a peer asker, which only answers questions about its project. Nothing was sent: "
                        f"ask it with `mesh ask {entry['peer']}`, and give a change to a worker in that repo")
    if entry.get("role") != "worker" or not claude_deny(entry):
        return None
    if entry.get("status") == "retiring" and settled_status(run_id, to) != "retired":
        entry = agent_entry(load_run(run_id), to)  # its retire failed: it's open, as it was
    if entry.get("status") in ("retiring", "retired"):
        return None  # `deliver` stores it, and `cmd_send` resumes it with the list the task calls for
    asker = bool(entry.get("read_only"))
    what = "a read-only asker" if asker else "planning"
    if planned_task(body):
        if asker:
            with editing_run(run_id) as run:
                run["agents"][to].update(read_only=False, planning=True)
            log_event(run_id, "deny_reason", name=to, reason="planning")
            print(f"mesh: {to} was a read-only asker; it plans this task under the same deny list, which "
                  "`mesh approve` lifts", file=sys.stderr)
        return None
    try:
        swap = swap_model(run_id, to, entry["model"], entry["effort"], "read-only lifted" if asker else "deny lifted",
                          message=(me, "task", body), lift=True)
    except SwapNotStarted as exc:
        raise MeshError(f"{exc}. Nothing was sent: {to} is {what}, under a deny list that a direct task "
                        f"reopens it without once its turn has ended; send it again then") from exc
    except MeshError as exc:
        if entry.get("view") != "bg":
            raise  # a pane is given its task only once it's back, so nothing was stored
        # A background worker's task went into its mailbox first, as the copy's opening prompt. That task is a
        # direct one, so neither reason holds any more: the resume this points to reopens it without the list.
        with editing_run(run_id) as run:
            run["agents"][to].update(read_only=False, planning=False)
        if stored:
            stored()
        raise MeshError(f"{exc}. The task is stored, so don't send it again: `mesh resume {to}` (no task) "
                        "reopens it without its deny list to read it") from exc
    log_event(run_id, "read_only_lifted" if asker else "deny_lifted", name=to)
    print(f"mesh: {to} was {what}; reopened it in the same conversation without its deny list, "
          "so it can now edit and push", file=sys.stderr)
    delivery = swap.pop("delivery", None)  # a background copy's opening prompt, or a task held at a screen
    if delivery and stored:
        stored()
    return {**(delivery or deliver(run_id, me, to, "task", body, first=True, stored=stored)),
            "read_only_lifted" if asker else "deny_lifted": True, "reopened": swap}


def cmd_send(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    body = read_body(args.body, args.file)
    if not body or not body.strip():
        raise MeshError("empty message: pass --body TEXT or --file PATH (- for stdin)")
    to = me_parent(run_id, me) if args.to == "parent" else args.to
    refuse_foreign_send(run_id, me, to)
    if args.type == "wait" or getattr(args, "until", None):
        return send_wait(args, run_id, me, to, body)
    if args.type in REPORT_TYPES and not args.unread_ok:
        refuse_stale_report(run_id, me, args.type)
    target = agent_entry(load_run(run_id), to)
    if target.get("status") in ("retiring", "retired") and (why := peer_pointer(to, target)):
        raise MeshError(f"{why}. Nothing was sent")
    if args.type == "task" and target.get("role") == "worker":  # new work; an answer finishes what it was doing
        reserve_guard(run_id, target.get("kind"), target.get("model"), target.get("effort"), f"a task for {to}")
    def stored() -> None:  # before the doorbell, so a root that approves at once sees the plan phase
        record_session(run_id, me)
        if args.type == "plan":
            enter_plan_phase(run_id, me, to)
        elif args.type == "task" and not planned_task(body) and not read_only_task(body):
            end_plan_phase(run_id, to)

    result = lift_read_only(run_id, me, to, args.type, body, stored) or deliver(run_id, me, to, args.type, body,
                                                                                stored=stored)
    if result.get("retired"):
        return send_resumed(run_id, me, to, args.type, body, Path(result["stored"]))
    if args.type in FINAL_TYPES and not result.get("collected") \
            and agent_entry(load_run(run_id), me).get("role") == "worker":
        quietly(ensure_retirer, run_id)  # its idle retire, whether or not a watch runs (design §18)
    emit(result)
    if result.get("retiring"):
        print(f"warning: stored, not rung: {result['error']}", file=sys.stderr)
        return 2
    if "send_message" in result:
        print(f"mesh: stored; now tell {to} with SendMessage: `to` and `message` exactly as in send_message",
              file=sys.stderr)
        return 0
    if not delivered(result):
        print(f"warning: stored, but the doorbell did not ring ({result['error']}); "
              f"{to} will see it on its next `mesh inbox`", file=sys.stderr)
        return 2
    return 0


def resume_stored(run_id: str, me: str, name: str, mtype: str, body: str, path: Path, **overrides) -> dict:
    """Resume a retired worker of this run for the message already stored for it (`path`): resume's rules
    decide its model and deny list from a task (a task it plans, a direct task, a question or review), and with
    any other message it carries on as it was. `overrides` are `ask`'s (model, effort, view, compact, focus…)."""
    resume = argparse.Namespace(**{
        "ref": name, "from_run": run_id, "model": None, "effort": None, "task": body if mtype == "task" else None,
        "task_file": None, "view": None, "compact": None, "focus": None, "read_only": False, "peer": None,
        "collect": None, **overrides, "stored": (path, mtype)})
    return resume_worker(resume, run_id, me)


RESUMING_TYPES = ("task", "answer", "question")  # what `mesh send` reopens a retired worker for (not an `info`)


def peer_pointer(name: str, entry: dict) -> str | None:
    """Why `send` doesn't reopen a retired peer asker: `mesh ask` refreshes its worktree first (prepare_peer)."""
    if not entry.get("peer"):
        return None
    return f"{name} is a retired peer asker: ask it with `mesh ask {entry['peer']}`, which refreshes its worktree first"


def unresumed_task(run_id: str, name: str, body: str) -> None:
    """A task stored for a worker whose resume failed: set its deny list and plan phase as that resume would have,
    so the `mesh resume` (no task) the error points to reopens it for that task."""
    with editing_run(run_id) as run:
        entry = run["agents"][name]
        claude = entry.get("kind") == "claude"
        if read_only_task(body):
            entry.update(read_only=claude, planning=False)
        elif planned_task(body):
            entry.update(read_only=False, planning=claude, phase="plan",
                         exec_model=entry.get("exec_model") or exec_model_for(entry.get("kind") or "claude"),
                         exec_effort=entry.get("exec_effort") or exec_effort_for(entry.get("kind")))
        else:  # a direct task: no list, no plan phase
            entry.update(read_only=False, planning=False, phase=None)


def send_resumed(run_id: str, me: str, to: str, mtype: str, body: str, path: Path) -> int:
    """`mesh send` to a retired worker: its message is stored; reopen it to read it (design §18). An `info`
    isn't worth a reopen: it waits for the next one."""
    why = peer_pointer(to, agent_entry(load_run(run_id), to))
    if mtype not in RESUMING_TYPES or why:
        emit({"stored": str(path), "rung": False, "resumed": False, "error": why or f"{to} is retired"})
        print(f"warning: stored, not rung: {why or f'{to} is retired, and reads it when it is next resumed'}",
              file=sys.stderr)
        return 2
    try:
        resumed = resume_stored(run_id, me, to, mtype, body, path)
    except MeshError as exc:
        if mtype == "task":
            unresumed_task(run_id, to, body)
        emit({"stored": str(path), "rung": False, "resumed": False, "error": str(exc)})
        print(f"error: {to} is retired and wasn't resumed: {exc}. The {mtype} is stored: `mesh resume {to}` "
              f"brings it back, then `mesh ring {to}` tells it", file=sys.stderr)
        return 1
    delivery = resumed.get("delivery") or {}
    emit({**delivery, "resumed": resumed})
    print(f"mesh: {to} was retired; resumed it in the same conversation to read its {mtype}", file=sys.stderr)
    held = report_held(resumed["name"], delivery)
    warn_unwatched(run_id)
    if held:
        return held
    if not delivered(delivery):
        print(f"warning: stored, but the doorbell did not ring ({delivery.get('error')}); "
              f"{resumed['name']} will see it on its next `mesh inbox`", file=sys.stderr)
        return 2
    return 0


def parse_until(text: str, now: datetime | None = None) -> datetime:
    """A wait's end, in UTC: a duration (`45m`, `1h30m`, `90s`), a local clock time (`14:30`, the next one), or
    ISO 8601 (local time without an offset)."""
    now = now or datetime.now(timezone.utc)
    text = text.strip()
    spans = UNTIL_RE.match(text.lower())
    if text and spans and any(spans.groups()):
        h, m, sec = (int(g or 0) for g in spans.groups())
        try:
            return now + timedelta(hours=h, minutes=m, seconds=sec)
        except OverflowError as exc:
            raise MeshError(f"--until {text} is more than {MAX_WAIT // 3600} h away") from exc
    if clock := re.fullmatch(r"(\d{1,2}):(\d{2})", text):
        local = now.astimezone()
        try:
            # naive local times, each given its own offset: tomorrow's may differ from today's across a DST change
            today = datetime(local.year, local.month, local.day, int(clock.group(1)), int(clock.group(2)))
        except ValueError as exc:
            raise MeshError(f"--until {text}: not a time of day") from exc
        at = today.astimezone()
        if at <= local:
            at = (today + timedelta(days=1)).astimezone()
        return at.astimezone(timezone.utc)
    try:
        at = datetime.fromisoformat(text[:-1] + "+00:00" if text[-1:] in "zZ" and text else text)  # 3.10 has no Z
    except ValueError as exc:
        raise MeshError(f"--until {text}: give a duration (45m, 1h30m), a local time (14:30) or ISO 8601") from exc
    return (at if at.tzinfo else at.astimezone()).astimezone(timezone.utc)


def send_wait(args: argparse.Namespace, run_id: str, me: str, to: str, body: str) -> int:
    """A worker declares a deliberate wait for its current task: until then the watch neither nudges nor
    alerts it for the turn end that declared it, and its Stop hook lets that turn end; the first turn end after
    a wake ends the wait (`wait_over`). Not a report, and no doorbell: it asks nothing of the parent, who sees
    it in `mesh inbox` (`declared_wait` reads it from the log)."""
    if args.type != "wait":
        raise MeshError("--until is for `--type wait`")
    if not args.until:
        raise MeshError("a wait needs --until: a duration (45m, 1h30m), a local time (14:30) or ISO 8601")
    entry = agent_entry(load_run(run_id), me)
    if entry.get("role") != "worker" or to != entry.get("parent"):
        raise MeshError("a wait is a worker's note to its parent: `mesh send parent --type wait`")
    until = parse_until(args.until)
    ahead = (until - datetime.now(timezone.utc)).total_seconds()
    if ahead <= 0:
        raise MeshError(f"--until {args.until} is in the past")
    if ahead > MAX_WAIT:
        raise MeshError(f"--until {args.until} is more than {MAX_WAIT // 3600} h away: wait at most that long, and "
                        "send another wait then if you still need one")
    refuse_stale_report(run_id, me, "wait")  # it would be the wait of a task it hasn't read
    stamp_iso = until.isoformat(timespec="seconds")
    text = f"Waiting until {until.astimezone():%H:%M} ({stamp_iso}): {body.strip()}"
    path = store_message(run_id, me, to, "wait", text)
    log_event(run_id, "send", sender=me, to=to, type="wait", file=path.name, until=stamp_iso)
    record_session(run_id, me)
    emit({"stored": str(path), "until": stamp_iso, "rung": False})
    print(f"mesh: stored for {to}, without a doorbell. Until {until.astimezone():%H:%M} the watch won't nudge or "
          "alert you for ending this turn. If you wake before then and are still waiting, send a fresh wait "
          "before you end that turn; report as usual when you're done", file=sys.stderr)
    return 0


def refuse_stale_report(run_id: str, me: str, mtype: str) -> None:
    """A report sent while a task or answer is unread would count as the reply to it (`since_last_task`), so
    the worker's next silent stop would go unnoticed. PROTOCOL rule 2 (read your mailbox right before
    reporting), in code. A wait (`send_wait`) is refused the same way, as it would hold off the watch for a
    task the worker hasn't read; only a report may pass with --unread-ok."""
    waiting = unread_received(run_id, me)
    if not waiting:
        return
    lines = "\n".join(f"  - {m['type']} from {m['from']} at {m['time']}: {m['gist']}" for m in waiting)
    report = mtype in REPORT_TYPES
    why = "count as your reply to them" if report else "hold off the watch for a task you haven't read"
    then = (f"then send one {mtype} that covers them too. Send anything that can't wait as `--type info`; pass "
            "--unread-ok to send this as it is anyway") if report else \
        "first. Send anything that can't wait as `--type info`"
    raise MeshError(f"not sent: your mailbox has {len(waiting)} unread task/answer message(s), and a {mtype} sent "
                    f"now would {why}:\n{lines}\nRun `mesh inbox` (not --peek) and act on them, {then}")


def pinned(entry: dict) -> bool:
    """Whether a named model or effort covers the worker's whole task (spawn and resume record it).

    A worker spawned before mesh recorded it: a large one with no exec model had its model named (`auto`
    always gives one), while a sized one ran on its size's defaults. A resumed one most likely got a task
    with no plan phase, which also leaves no exec model, so it isn't taken for pinned.
    """
    if "pinned" in entry:
        return bool(entry["pinned"])
    return not entry.get("exec_model") and entry.get("size") not in ("trivial", "small") \
        and not entry.get("resumed_from")


def has_phases(entry: dict | None) -> bool:
    """A worker that may plan and then execute on its exec model: not one whose model or effort was named
    for the whole task (`pinned`), nor one whose plan the user approves in its pane."""
    return bool(entry) and entry.get("role") == "worker" and entry.get("kind") in KINDS \
        and not pinned(entry) and entry.get("plan_review") != "user"


def enter_plan_phase(run_id: str, name: str, to: str) -> None:
    """A worker that sends its parent a plan while not planning (a small asker given a change, a worker that
    finished and got a new task) enters a plan phase, as `mesh resume` gives one, so `mesh approve` moves it
    to its exec model and effort. It is planning on the model it is on: `send` never reopens a worker.

    The trigger is the plan itself, not the task: a fix the worker just does keeps its exec phase.
    """
    entry = load_run(run_id)["agents"].get(name)
    if not has_phases(entry) or entry.get("phase") == "plan" or entry.get("parent") != to:
        return
    with editing_run(run_id) as run:
        entry = run["agents"][name]
        entry.update(phase="plan", exec_model=entry.get("exec_model") or exec_model_for(entry["kind"]),
                     exec_effort=entry.get("exec_effort") or exec_effort_for(entry["kind"]))
        # where this plan phase starts, for models_tried
        entry.setdefault("models", []).append({"model": entry.get("model"), "effort": entry.get("effort"),
                                               "at": now_iso(), "why": "planned task"})
    log_event(run_id, "plan_phase", name=name, exec_model=entry["exec_model"])


def end_plan_phase(run_id: str, name: str) -> None:
    """A direct task ends the plan phase its worker was in, deny list or not, so a resume with no task doesn't
    bring it back as a planner, and a quota `switch` doesn't walk the plan chain while it executes."""
    if (load_run(run_id)["agents"].get(name) or {}).get("phase") != "plan":
        return
    with editing_run(run_id) as run:
        run["agents"][name]["phase"] = None
    log_event(run_id, "plan_phase_ended", name=name)


def record_session(run_id: str, name: str) -> None:
    """Record an agy worker's conversation on its first message, while agy's index still holds its first
    doorbell: agy may later replace that with a title, and the worktree fallback can pick a restart's."""
    entry = load_run(run_id)["agents"].get(name)
    if not entry or entry.get("kind") != "agy" or entry.get("session") or entry.get("role") != "worker":
        return
    session = agy_conversation(name, run_id, None, pinned_only=True)
    if session:
        with editing_run(run_id) as run:
            e = run["agents"][name]
            e["session"] = e.get("session") or session
        log_event(run_id, "session", name=name, session=session)


def me_parent(run_id: str, me: str) -> str:
    parent = agent_entry(load_run(run_id), me).get("parent")
    if not parent:
        raise MeshError(f"{me} has no parent (it is the run's root)")
    return parent


RESET_SOURCES = ("clear", "compact")  # session starts that may have lost the task (`mesh inbox` shows it again)


def current_task(run_id: str, name: str, events: list[dict]) -> list[Path]:
    """The message files of `name`'s current task: the last `task` sent to it, and every `answer` since."""
    files: list[str] = []
    for e in events:
        if e.get("event") == "send" and e.get("to") == name and e.get("file"):
            if e.get("type") == "task":
                files = [e["file"]]
            elif e.get("type") == "answer" and files:
                files.append(e["file"])
    folder = inbox_dir(run_id, name)
    found = (next((f for f in (folder / file, folder / "read" / file) if f.exists()), None) for file in files)
    return [f for f in found if f]


def session_reset(events: list[dict], name: str) -> bool:
    """Whether `name`'s session was cleared or compacted (a `rebind`, or a `reminder` from one of those) since
    its last task or answer, and `mesh inbox` hasn't shown that task again since."""
    reset = False
    for e in events:
        if e.get("name") == name and (e.get("event") == "rebind" and e.get("session")
                                      or e.get("event") == "reminder" and e.get("source") in RESET_SOURCES):
            reset = True
        elif e.get("name") == name and e.get("event") == "inbox_again" \
                or e.get("event") == "send" and e.get("to") == name and e.get("type") in RECEIVED_TYPES:
            reset = False
    return reset


def quoted_body(text: str) -> str:
    """A message body to print under its `── … ──` header: a line of it starting with `──` is indented, so only
    a header starts a line with it and a body can't pass for a second message."""
    return "\n".join(f"  {line}" if line.startswith("──") else line for line in text.split("\n"))


def cmd_inbox(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    if not args.peek:
        file_orphans(run_id, me)  # an answer a killed `mesh ask` left with its Copilot asker
    folder = inbox_dir(run_id, me)
    paths = unread(run_id, me)
    if args.all and (folder / "read").exists():
        paths = sorted((folder / "read").glob("*.md")) + paths
    again: list[Path] = []
    if not args.peek and session_reset(events := read_log(run_id), me):
        # a task it already reported done or failed on needs no reminding; `--all` shows it in its place
        report, _ = last_report(events, me)
        if (report["type"] if report else None) not in FINAL_TYPES:
            again = current_task(run_id, me, events)
        log_event(run_id, "inbox_again", name=me, files=[p.name for p in again])
    shown = {p.name for p in paths}
    messages = []
    for path in (p for p in again if p.name not in shown):
        meta, body = parse_message(path)
        messages.append({"file": str(path), **meta, "body": body.strip(), "again": True})
    for path in paths:
        meta, body = parse_message(path)
        messages.append({"file": str(path), **meta, "body": body.strip(),
                         **({"again": True} if path in again and path.parent.name == "read" else {})})
        if not args.peek and path.parent == folder:
            mark_read(path)
    if not args.peek and (maybe_run(run_id) or {}).get("agents", {}).get(me, {}).get("held"):
        with editing_run(run_id) as run:  # reading mail proves it got past its startup screen
            run["agents"][me].pop("held", None)
    if args.json:
        emit(messages)
    elif not messages:
        print("No unread messages.")
    else:
        for msg in messages:
            note = " (again: your session was cleared or compacted since you read it)" if msg.get("again") else ""
            print(f"── {msg.get('type')} from {msg.get('from')} at {msg.get('time')}{note} ──")
            print(quoted_body(msg["body"]), end="\n\n")
    if (maybe_run(run_id) or {}).get("root") == me:
        root_hint(run_id)
    return 0


def cmd_ring(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    run = load_run(run_id)
    entry = agent_entry(run, args.agent)
    refuse_headless(args.agent, entry, "a doorbell")
    count = len(unread(run_id, args.agent))
    held = entry.get("held")
    if not count:
        if held:  # spawned with no task: nothing to ring, and nothing left to hold
            with editing_run(run_id) as data:
                data["agents"][args.agent].pop("held", None)
        print(f"{args.agent} has no unread messages" + ("; its startup hold is cleared." if held else "."))
        return 0
    claude = pane_claude(entry)
    if relaunched_outside_mesh(run_id, args.agent, entry, claude):
        raise MeshError(f"{args.agent} runs a Claude mesh didn't start (a herdr restore?), without its hooks and "
                        f"deny list, so its doorbell isn't rung: `mesh send {args.agent} …` reopens it with them "
                        "first, then rings")
    text = f"you have {count} unread message(s) (run `mesh inbox`)"
    rows = read_claude_agents() if entry.get("view") == "bg" else UNREAD
    # A held worker's first doorbell is typed.
    route = (native_route(run, me, args.agent, claude, rows) or {}) if not held else {}
    paths = unread(run_id, args.agent)
    if "socket" in route and (rung := ring_inbox(run_id, me, args.agent, route["socket"], f"📬 [mesh] {text}",
                                                 paths[-1])):
        emit({**rung, "unread": count})
        return 0
    if "send_message" in route:
        emit({"rung": False, "unread": count,
              "send_message": {"to": route["send_message"], "message": f"📬 [mesh] {text}"}})
        return 0
    if entry.get("view") == "bg":  # no pane to type into
        error = bg_unreached(args.agent, entry, rows)
        log_event(run_id, "doorbell_failed", sender=me, to=args.agent, file=paths[-1].name, error=error)
        emit({"rung": False, "unread": count, "error": error})
        print(f"warning: {error}", file=sys.stderr)
        return 2
    token = ring_token()
    targets = [args.agent] + ([entry["pane"]] if entry.get("pane") else [])
    # A held worker never heard its first doorbell, which says who it is.
    doorbell = held_doorbell(run, args.agent, held, token) if held else f"📬 [mesh] (ref {token}) {text}"
    result = ring_stored(run_id, me, args.agent, targets, doorbell, token, paths[-1], read=tuple(paths))
    if result["rung"] and held:
        with editing_run(run_id) as data:
            data["agents"][args.agent].pop("held", None)
            data["agents"][args.agent].pop("swapped", None)
    emit({**result, "unread": count})
    return 0 if result["rung"] else 2


def agent_status(name: str, entry: dict | None = None, bg_rows: list[dict] | None = None) -> str:
    """herdr's state for an agent's pane (working / idle / done / blocked / gone); a background worker's from Claude.

    herdr can lose a live agent's registration (seen after a Claude Code auto-update), so a pane worker herdr
    doesn't know is `gone` only unless its pane still runs its CLI (`pane_probe`): then it is `unknown`, which
    the watch neither nudges nor reports gone. When the pane can't be read, herdr's word stands.
    """
    if entry and entry.get("view") == "bg":
        return bg_status(entry, bg_rows)
    if entry and entry.get("view") == "headless":
        # A Copilot asker works while the `mesh ask` that asks it, or the copilot that one started, lives.
        return "working" if live_holder(name, entry) else "gone"
    try:
        return herdr("agent", "get", name)["agent"].get("agent_status", "unknown")
    except HerdrError as exc:
        if exc.code == "agent_not_found":
            return "unknown" if entry and pane_probe(entry.get("pane"), entry.get("kind")) == "alive" else "gone"
        raise


def ago(seconds: float) -> str:
    """A short age: 45s, 12m, 3h05m, 2d3h."""
    if seconds == float("inf"):
        return "?"
    s = max(0, int(seconds))
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h{s % 3600 // 60:02d}m"
    return f"{s // 86400}d{s % 86400 // 3600}h"


def message_file(run_id: str, to: str, file: str | None) -> Path | None:
    """A logged message's file in `to`'s mailbox, unread or read."""
    if not file:
        return None
    folder = inbox_dir(run_id, to)
    return next((p for p in (folder / file, folder / "read" / file) if p.exists()), None)


def message_body(run_id: str, event: dict | None) -> str:
    path = message_file(run_id, event.get("to"), event.get("file")) if event else None
    return parse_message(path)[1] if path else ""


PR_STATE_TTL = 120  # seconds `mesh status` reuses a PR's state from `<run>/pr-state.json`
PR_RETRY_TTL = 60  # seconds before a PR whose state `gh` couldn't read is tried again
PR_STATE_TIMEOUT = 10  # seconds one `gh pr view` may take: `mesh status` waits for it
CHECK_FAILED = ("FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE")


def checks_summary(rollup: list[dict] | None) -> str | None:
    """`gh`'s statusCheckRollup as one word: failing, pending or pass (None with no checks)."""
    seen = set()
    for check in rollup or ():
        if "conclusion" in check or "status" in check:  # a check run
            done = (check.get("status") or "").upper() == "COMPLETED"
            outcome = (check.get("conclusion") or "").upper()
        else:  # a commit status
            outcome = (check.get("state") or "").upper()
            done = outcome not in ("PENDING", "EXPECTED")
        seen.add("pending" if not done else "failing" if outcome in CHECK_FAILED else "pass")
    return next((word for word in ("failing", "pending", "pass") if word in seen), None)


def pr_state(url: str) -> dict | None:
    result = run_cli(["gh", "pr", "view", url, "--json", "state,isDraft,statusCheckRollup"], timeout=PR_STATE_TIMEOUT)
    try:
        data = json.loads(result.stdout) if result.returncode == 0 else None
    except ValueError:
        data = None
    if not isinstance(data, dict) or not data.get("state"):
        return None
    return {"state": data["state"].lower(), "draft": bool(data.get("isDraft")),
            "checks": checks_summary(data.get("statusCheckRollup"))}


def pr_states(run_id: str, urls: list[str]) -> dict[str, dict]:
    """Each PR's state, checks and draft flag from `gh`, fetched side by side and cached for PR_STATE_TTL.
    A failed fetch keeps the last state seen, else `unknown`, and is tried again after PR_RETRY_TTL, so a `gh`
    that can't reach GitHub slows `mesh status` once a minute, not on every call."""
    path = run_dir(run_id) / "pr-state.json"
    try:
        cache = json.loads(path.read_text())
    except (OSError, ValueError):
        cache = {}
    cache = {u: c for u, c in cache.items() if isinstance(c, dict)} if isinstance(cache, dict) else {}
    unknown = {"state": "unknown", "draft": False, "checks": None}

    def stale(url: str) -> bool:
        cached = cache.get(url, {})
        return time.time() - cached.get("at", 0) > (PR_STATE_TTL if cached.get("ok", True) else PR_RETRY_TTL)

    fetch = [u for u in dict.fromkeys(urls) if stale(u)]
    if fetch:
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(max_workers=min(8, len(fetch))) as pool:
            for url, state in zip(fetch, pool.map(pr_state, fetch)):
                last = {k: v for k, v in cache.get(url, unknown).items() if k in unknown}
                cache[url] = {**(state or last), "at": time.time(), "ok": bool(state)}
        write_atomic(path, json.dumps(cache, indent=2) + "\n")
    return {u: {k: cache.get(u, unknown).get(k, unknown[k]) for k in unknown} for u in urls}


def last_task(events: list[dict], name: str) -> dict | None:
    return next((e for e in reversed(events) if e.get("event") == "send" and e.get("to") == name
                 and e.get("type") == "task"), None)


def report_prs(run_id: str, name: str, entry: dict, report: dict, events: list[dict]) -> list[str]:
    """The PRs a `done` names (not ones the worker reviewed), else those of its newest earlier `done` that
    named any: a fix round's report may not repeat the link. Plans and questions don't count."""
    reviewed = set(entry.get("reviews") or ())
    dones = [e for e in events if e.get("event") == "send" and e.get("sender") == name and e.get("type") == "done"]
    for done in reversed(dones[: dones.index(report) + 1] if report in dones else [report]):
        prs = [u for u in dict.fromkeys(PR_RE.findall(message_body(run_id, done))) if u not in reviewed]
        if prs:
            return prs
    return []


def reviewing_pr(run_id: str, entry: dict, events: list[dict], name: str) -> str | None:
    """The PR a reviewer's current task reviews: the one its last review task names, or its newest review; None
    when that task isn't a review. A follow-up question (`mesh ask <reviewer> --body …`, no `--review`) is still
    about the review it follows, so questions are skipped back to that review, but never past a change task.
    `reviews` keeps every PR it ever reviewed."""
    tasks = [e for e in events if e.get("event") == "send" and e.get("to") == name and e.get("type") == "task"]
    body = ""
    for task in reversed(tasks):
        body = message_body(run_id, task).lstrip()
        if not body.startswith("Question (read-only)"):
            break
    if not body.startswith("Review (read-only)"):
        return None
    named = REVIEW_GIST_RE.match(body)
    pr = PR_RE.search(named.group(2)) if named else None
    reviews = entry.get("reviews") or []
    return pr.group(0) if pr else (reviews[-1] if reviews else None)


def doorbell_failed(events: list[dict], name: str, file: str | None) -> bool:
    """Whether the doorbell for this message failed, and no doorbell has rung for `name` since (a `rung`
    event, from `mesh ring` or a later send)."""
    failed = False
    for e in events:
        if e.get("event") == "doorbell_failed" and e.get("to") == name and e.get("file") == file:
            failed = True
        elif e.get("event") == "rung" and e.get("to") == name:
            failed = False
    return failed


def waiting_rows(run_id: str, run: dict, rows: list[dict], events: list[dict]) -> None:
    """Add to each status row what the worker owes or waits on, derived from the log, mailboxes, git and `gh`:
    `waiting` (what to show), `needs` (who acts next: root, worker or None), `since`, `report`, and for a
    `done` or `failed` its `prs` and work evidence."""
    folds = {r["name"]: last_report(events, r["name"]) for r in rows if r["role"] != "root"}
    pending = {}  # a done's PRs, fetched together below
    for row in rows:
        row.update(waiting="", needs=None, since=None, report=None)
        name, entry = row["name"], run["agents"][row["name"]]
        if row["role"] == "root":
            continue
        report, received = folds[name]
        if report and report.get("type") in FINAL_TYPES:
            row.update(work_evidence(run, entry))
            read_only = message_body(run_id, last_task(events, name)).lstrip().startswith(READ_ONLY_STARTS)
            if report["type"] == "done" and not read_only:
                pending[name] = report_prs(run_id, name, entry, report, events)
            row["read_only"] = read_only
    states = pr_states(run_id, [u for urls in pending.values() for u in urls]) if pending else {}
    reviewing: dict[str, list[str]] = {}  # PR → reviewers that haven't reported since their last task
    for name, entry in run["agents"].items():
        report = folds.get(name, (None, None))[0]
        if entry.get("reviews") and entry.get("status") != "retired" \
                and not (report and report.get("type") in FINAL_TYPES):
            if url := reviewing_pr(run_id, entry, events, name):
                reviewing.setdefault(url, []).append(name)
    for row in rows:
        if row["role"] == "root":
            continue
        name, entry = row["name"], run["agents"][row["name"]]
        report, received = folds[name]
        retired = row["state"] == "retired"
        if report:
            mtype, since = report["type"], report.get("time")
            unread_note = ", unread" if (inbox_dir(run_id, report["to"]) / str(report.get("file"))).exists() else ""
            needs = "root"
            if mtype in ("plan", "question"):
                text = f"{mtype} unanswered {ago(age_seconds(since))}{unread_note}"
            elif mtype == "failed":
                text = f"failed {ago(age_seconds(since))}{unread_note}"
            elif row.pop("read_only", False):
                text = f"answered {ago(age_seconds(since))}{unread_note}"
            else:
                urls = pending.get(name, [])
                row["prs"] = [{"url": u, "number": int(u.rsplit("/", 1)[1]), **states[u]} for u in urls]
                parts = [f"PR #{p['number']} {p['state']}" + (", draft" if p["draft"] else "")
                         + (f", checks {p['checks']}" if p["checks"] else "") for p in row["prs"]]
                if not urls:
                    commits = row.get("commits")
                    parts.append("no commits" if commits == 0 else f"{commits} commit(s)" if commits else "")
                    if commits and row.get("pushed") is False:
                        parts.append("not pushed")
                    parts.append("no PR")
                if row.get("dirty"):
                    parts.append("worktree dirty")
                reviewers = [r for u in urls for r in reviewing.get(u, []) if r != name]
                if reviewers:
                    parts.append(f"in review ({', '.join(dict.fromkeys(reviewers))})")
                    needs = "worker"
                text = f"done {ago(age_seconds(since))}{unread_note}: " + ", ".join(p for p in parts if p)
            row.pop("read_only", None)
        elif not received:
            text, since, needs = "no task", None, None
        else:
            mtype, since = received["type"], received.get("time")
            if retired:
                text, needs = "retired before reporting", None
            elif entry.get("view") == "headless" and entry.get("status") == "running" and row["state"] == "gone":
                text, needs = "report waiting: `mesh inbox` files it", "root"  # a killed `mesh ask` (file_orphan)
            elif (inbox_dir(run_id, name) / str(received.get("file"))).exists():
                text, needs = f"{mtype} unread {ago(age_seconds(since))}", "worker"
                if doorbell_failed(events, name, received.get("file")):
                    text, needs = f"{text}, doorbell failed", "root"
            else:
                text, needs = f"on {mtype} {ago(age_seconds(since))}", "worker"
                if until := waiting_until(events, name):  # a declared wait (`mesh send --type wait`)
                    text += f", waiting until {datetime.fromtimestamp(until).astimezone():%H:%M}"
            if needs == "worker" and (row["state"] in ("gone", "blocked") or entry.get("status") == "swap_failed"):
                needs = "root"  # it owes a report it can't send
                text += " (swap failed)" if entry.get("status") == "swap_failed" else ""
        held = entry.get("held")
        if held and not retired and (not report or str(report.get("time")) < str(held.get("at"))) and (
                not held.get("file") or (inbox_dir(run_id, name) / held["file"]).exists()):
            # A hold outlives its screen until a ring or its `mesh inbox` drops it: one reported past or read is stale.
            if row["state"] in ("blocked", "unknown"):  # `deliver`'s test for "at the screen": only the user clears it
                since = held.get("at")
                try:
                    clock = f" since {datetime.fromisoformat(since).astimezone():%H:%M}"
                except (TypeError, ValueError):
                    clock = ""
                text = f"held at a startup screen ({held.get('screen')}){clock} ({ago(age_seconds(since))})" + (
                    f", {held.get('type')} stored" if held.get("file") else "")
                needs = "root"
            elif row["state"] in ("idle", "done") and held.get("file"):  # past it, its first doorbell never rang
                text += f", its first doorbell never rang: `mesh ring {name}`"
                needs = "root"
        row.update(waiting=text, needs=None if retired else needs, since=since, report=report and report["type"])


def status_rows(run_id: str, run: dict) -> list[dict]:
    """`mesh status`'s rows: each agent's live state and what it owes or waits on, needing the root first."""
    rows = []
    bg_rows = claude_agents() if any(e.get("view") == "bg" for e in run["agents"].values()) else []
    for name, entry in run["agents"].items():
        live = "retired" if entry.get("status") == "retired" else agent_status(name, entry, bg_rows)
        rows.append({
            "name": name, "role": entry["role"], "kind": entry.get("kind"), "model": entry.get("model") or "",
            "size": entry.get("size") or "", "view": entry.get("view") or ("pane" if entry.get("pane") else ""),
            "state": live, "unread": len(unread(run_id, name)), "parent": entry.get("parent") or "",
            "branch": entry.get("branch") or "",
        })
    waiting_rows(run_id, run, rows, read_log(run_id))
    # What needs the root first, longest-waiting first; then what waits on a worker; the root's own row last.
    rank = {"root": 0, "worker": 1, None: 2}
    rows.sort(key=lambda r: (3 if r["role"] == "root" else rank[r["needs"]], r["since"] or "~"))
    return rows


def cmd_status(args: argparse.Namespace) -> int:
    run_id, me = caller(args, args.run_id)
    run = load_run(run_id)
    rows = status_rows(run_id, run)
    context = quietly(root_context, run, as_root=me == run["root"])
    if args.json:
        emit({"run": run_id, "mode": run["mode"], "agents": rows,
              "needs_root": [r["name"] for r in rows if r["needs"] == "root"], "root_context": context,
              "quota": quietly(quota_line, run)})
    else:
        print(f"run {run_id} ({run['mode']}), {run_dir(run_id)}" + (f" · {context_text(context)}" if context else ""))
        print(quietly(quota_line, run) or "quota: unknown")
        print_table(rows, ("name", "role", "kind", "model", "size", "view", "state", "unread", "waiting", "branch"))
    if me == run["root"]:
        for line in inbound_warnings(run):
            print(line, file=sys.stderr)
        root_hint(run_id)
    return 0


def run_folder(run_id: str) -> Path:
    """A run's folder, live or archived."""
    for folder in (run_dir(run_id), mesh_home() / "archive" / run_id):
        if (folder / "run.json").exists():
            return folder
    raise MeshError(f"unknown run {run_id} (no {run_dir(run_id)}, nor one in {mesh_home() / 'archive'})")


def log_path(run_id: str) -> Path:
    """A run's log, live or archived."""
    return run_folder(run_id) / "log.jsonl"


def run_stopped(run_id: str) -> bool:
    """Whether `mesh stop` has archived the run: no live folder, an archived one."""
    return not (run_dir(run_id) / "run.json").exists() and (mesh_home() / "archive" / run_id / "run.json").exists()


def stop_under_way(events: list[dict]) -> bool:
    """Whether a `mesh stop` is closing the run: its `stopping` is the newest of its kind and its process lives."""
    last = next((e for e in reversed(events) if e.get("event") in ("stopping", "stop_failed")), None)
    return bool(last and last["event"] == "stopping" and pid_alive(last.get("pid"), last.get("start")))


def stopped_line(run_id: str) -> str:
    return f"run {run_id} stopped; nothing left to watch"


REVIEW_GIST_RE = re.compile(r"^(Review \(read-only\) of (\S+?)(?: at \S+)?):\s")  # the PR, and the head it names
LOG_SKIP = ("time", "event", "name", "sender", "to", "type", "file")


def log_line(event: dict, folder: Path) -> str:
    """One event as a timeline line: local time, event, who, and the rest; a message shows its gist."""
    try:
        when = datetime.fromisoformat(event["time"]).astimezone().strftime("%H:%M:%S")
    except (KeyError, TypeError, ValueError):
        when = "--:--:--"
    kind = event.get("event", "?")
    if kind == "send":
        who = f"{event.get('sender')} → {event.get('to')}  {event.get('type')}"
        path = next((p for p in (folder / "inbox" / str(event.get("to")) / sub / str(event.get("file"))
                                 for sub in ("", "read")) if p.is_file()), None)
        body = parse_message(path)[1].strip() if path else ""
        review = REVIEW_GIST_RE.match(body)  # a review's notes may be only its diff: name the PR instead
        rest = review.group(1) if review else task_gist(body, 100)
    else:
        who = event.get("name") or (f"{event.get('sender')} → {event.get('to')}" if event.get("to") else "")
        rest = " ".join(f"{k}={v if isinstance(v, str) else json.dumps(v)}" for k, v in event.items()
                        if k not in LOG_SKIP and v not in (None, "", [], {}))
    return "  ".join(part for part in (when, f"{kind:<15}", who, rest) if part).rstrip()


def log_day(event: dict) -> str | None:
    try:
        return datetime.fromisoformat(event["time"]).astimezone().strftime("%Y-%m-%d")
    except (KeyError, TypeError, ValueError):
        return None


def cmd_log(args: argparse.Namespace) -> int:
    """The run's log.jsonl as a timeline; --follow keeps printing until the run stops."""
    run_id = args.run_id or identity(args)[0]
    path = log_path(run_id)

    if args.lines < 0:
        raise MeshError("--lines takes a count of events (0: all)")
    day = None

    def show(events: list[dict], last: int = 0) -> bool:
        """Print the events naming --agent (only the last `last` of them, if given); True once the run
        stopped, whoever an event names: `stop` names nobody."""
        nonlocal day
        shown = [e for e in events if not args.agent or args.agent in (e.get("name"), e.get("sender"), e.get("to"))]
        for event in shown[-last:] if last else shown:
            if log_day(event) and log_day(event) != day:
                day = log_day(event)
                print(f"── {day} ──")
            print(log_line(event, path.parent), flush=True)
        return any(e.get("event") == "stop" for e in events)

    text = path.read_text() if path.exists() else ""
    complete = text[: text.rfind("\n") + 1]  # a line still being written waits for its newline
    stopped = show(parse_log_lines(complete.splitlines(), path), args.lines)
    stopped = stopped or path.parent.parent == mesh_home() / "archive"  # nothing more comes
    if not args.follow:
        return 0
    offset, lineno = len(complete.encode()), complete.count("\n") + 1
    try:
        while not stopped:
            time.sleep(1)
            if not path.exists():  # `mesh stop` archived the run
                print("(run archived)")
                break
            with open(path, "rb") as fh:
                fh.seek(offset)
                chunk = fh.read()
            ended = chunk[: chunk.rfind(b"\n") + 1]
            if not ended:
                continue
            offset += len(ended)
            lines = ended.decode(errors="replace").splitlines()
            stopped = show(parse_log_lines(lines, path, lineno))
            lineno += len(lines)
    except KeyboardInterrupt:
        pass
    return 0


def sends_from(run_id: str, name: str, types: tuple[str, ...] = TYPES, events: list[dict] | None = None) -> int:
    events = read_log(run_id) if events is None else events
    return sum(1 for e in events if e.get("event") == "send" and e.get("sender") == name and e.get("type") in types)


def cmd_watch(args: argparse.Namespace) -> int:
    """Block until a child reports done/failed (exit 0) or something looks wrong (non-zero)."""
    run_id, me = caller(args, args.run_id)
    every, alerts = getattr(args, "any", False), getattr(args, "alerts", False)
    root = me == (maybe_run(run_id) or {}).get("root")  # the root's own watch may reset it (MESH_ROOT_AUTORESET)
    if bool(args.agent) == bool(every):
        raise MeshError("watch whom? name a worker, or pass --any for every live worker of the run")
    if every:
        run = load_run(run_id)
        workers = {name: e for name, e in run["agents"].items() if e["role"] != "root" and e.get("status") != "retired"}
        for name, e in workers.items():  # a gone worker's unread report is news too
            if kind := unread_report(run_id, e.get("parent"), name):
                print(unread_line(name, kind))
                return 0
        bg_rows = claude_agents() if any(e.get("view") == "bg" for e in workers.values()) else []
        # The rest join on the first poll if they owe a report or are starting (Roster.refresh); with none, the
        # watch still waits out a retire or resume under way before it says there's nothing to watch.
        names = [name for name, e in workers.items() if agent_status(name, e, bg_rows) != "gone"]
    else:
        names, run = [args.agent], None
    status, line = watch_agents(run_id, names, args.timeout, args.interval, args.grace, alerts_only=alerts,
                                hang=getattr(args, "hang", None), autoreset=root and autoreset_on(), every=run,
                                retire_after=idle_retire(), reserve=root)
    print(line)
    if root:
        root_hint(run_id)
    return status


def since_last_task(events: list[dict], name: str) -> tuple[int, int, str | None]:
    """(tasks and answers `name` has received, reports it has sent since the last of them, that last one's time)."""
    received = sent = 0
    at = None
    for event in events:
        if event.get("event") != "send":
            continue
        if event.get("to") == name and event.get("type") in RECEIVED_TYPES:
            received, sent, at = received + 1, 0, event.get("time")
        elif event.get("sender") == name and event.get("type") in REPORT_TYPES:
            sent += 1
    return received, sent, at


def owes_report(events: list[dict], name: str) -> bool:
    """Whether `name` got a task or answer and has reported nothing since."""
    received, sent, _ = since_last_task(events, name)
    return bool(received and not sent)


def last_report(events: list[dict], name: str) -> tuple[dict | None, dict | None]:
    """(the newest report `name` sent since its last task or answer, that last task or answer), as log events."""
    report = received = None
    for event in events:
        if event.get("event") != "send":
            continue
        if event.get("to") == name and event.get("type") in RECEIVED_TYPES:
            report, received = None, event
        elif event.get("sender") == name and event.get("type") in REPORT_TYPES:
            report = event
    return report, received


def retirable(run_id: str, name: str, entry: dict, events: list[dict]) -> dict | None:
    """The report (its `send` event) after which an idle worker may be retired: its newest report since its last
    task or answer is a `done` or `failed`, it runs, nothing waits in its mailbox, it declared no wait, and no
    fan-out is collecting it. How long it has been idle is the watch's to judge (Watch.maybe_retire)."""
    if (entry.get("role") != "worker" or entry.get("status") != "running" or entry.get("held")
            or entry.get("relaunching") or entry.get("view") == "headless"):
        return None
    report, _ = last_report(events, name)
    if not report or report.get("type") not in FINAL_TYPES or live_wait(events, name):
        return None
    if unread(run_id, name) or collecting(entry, str(entry.get("parent"))):
        return None
    return report


ATTACH_SCAN = 4  # how many of a `claude` process's first arguments `viewer` looks through for `attach`


def viewer(name: str, entry: dict, table: list[dict] | None = None) -> str | None:
    """Why the user may be looking at a worker, which holds its auto-retire (design §18, "Viewers"), else None.

    A background worker: a `claude attach` client of its session is running (`mesh open` runs one). Claude Code
    keeps its attach clients to itself, but the client is a process for as long as it is attached. Its argument
    is the job id, the session id or part of the session name (the worker's name), so a short part of a name may
    hold several workers: holding is the safe side. Without /proc (macOS) the clients are read from `ps`
    (`command_table`). A pane worker: herdr has its pane focused (one pane at a time). Anything unreadable (a
    herdr error, no process table) holds nothing."""
    if entry.get("view") == "bg":
        keys = [k for k in (entry.get("bg_id"), entry.get("session")) if k]
        for proc in command_table() if table is None else table:
            argv = [a for a in proc["argv"] if a]
            if agent_binary(argv) != "claude":
                continue
            args = argv[2:] if Path(argv[0]).name in INTERPRETERS else argv[1:]  # `node …/claude attach <id>`
            at = next((i for i, a in enumerate(args[:ATTACH_SCAN]) if a == "attach"), None)  # `--debug attach`
            if at is None or at + 1 >= len(args):
                continue
            target = args[at + 1]
            if target in keys or target.lower() in name.lower():
                return f"attached (`claude attach`, pid {proc['pid']})"
        return None
    if not entry.get("pane"):
        return None
    try:
        pane = herdr("pane", "get", entry["pane"]).get("pane") or {}
    except (HerdrError, MeshError):
        return None
    return "its pane is focused" if pane.get("focused") is True else None


def declared_wait(events: list[dict], name: str) -> dict | None:
    """The wait `name` declared for its current task (its `send` event, `until` in ISO): sent since its last task
    or answer and after its newest report. A new task or answer, or a report, ends it. `turned` is set once the
    turn end that declared it was let through (`wait_turn`), and `over` (a time) once a later turn end, after a
    wake, ended it (`wait_over`)."""
    found = None
    for event in events:
        kind = event.get("event")
        if kind in ("wait_turn", "wait_over"):
            if found and event.get("name") == name and event.get("file") == found.get("file"):
                found = {**found, **({"turned": True} if kind == "wait_turn" else {"over": event.get("time")})}
            continue
        if kind != "send":
            continue
        if (event.get("to") == name and event.get("type") in RECEIVED_TYPES) or (
                event.get("sender") == name and event.get("type") in REPORT_TYPES):
            found = None
        elif event.get("sender") == name and event.get("type") == "wait":
            found = event
    return found


def live_wait(events: list[dict], name: str) -> dict | None:
    """`name`'s declared wait while it holds: before its deadline, and before the turn end after a wake."""
    wait = declared_wait(events, name)
    return wait if wait and not wait.get("over") and epoch(wait.get("until")) > time.time() else None


def waiting_until(events: list[dict], name: str) -> float | None:
    """The epoch a deliberate wait of `name`'s current task ends, while it holds."""
    wait = live_wait(events, name)
    return epoch(wait.get("until")) if wait else None


def mark_wait(run_id: str, name: str, file: str, kind: str) -> bool:
    """Log `wait_turn` or `wait_over` for the wait stored as `file`, once (checked and logged under the run lock)."""
    with run_lock(run_id):
        if any(e.get("event") == kind and e.get("name") == name and e.get("file") == file
               for e in read_log(run_id)):
            return False
        log_event(run_id, kind, name=name, file=file)
        return True


def nudge_of(events: list[dict], name: str, received: int) -> dict | None:
    """The logged nudge for `name`'s current task, with `rung` (and `error` when it didn't ring) once its
    doorbell was tried."""
    found = None
    for e in events:
        if e.get("name") == name and e.get("received") == received:
            if e.get("event") == "nudge":
                found = dict(e)
            elif e.get("event") == "nudge_rung" and found:
                found.update(rung=e.get("rung"), error=e.get("error"))
    return found


def claim_nudge(run_id: str, name: str, received: int, via: str | None = None) -> bool:
    """Log the nudge for this task unless a watch or the worker's Stop hook already did (checked and logged
    under the run lock). A hook's nudge (`via`) is delivered as it is claimed."""
    with run_lock(run_id):
        if nudge_of(read_log(run_id), name, received):
            return False
        log_event(run_id, "nudge", name=name, received=received, **({"via": via, "rung": True} if via else {}))
        return True


HOOK_NUDGE = ("agent-mesh: you're ending your turn without a `mesh send` since your last task or answer. If the "
              "task is finished, run `mesh inbox`, then report `done` or `failed` with `mesh send parent`; if you're "
              "stuck, send a `question`. If you're deliberately waiting (a background command you started will "
              "wake you), declare it with `mesh send parent --type wait --until <time> --body …` and end your "
              "turn (a wait covers one turn end: if you woke during one and are still waiting, send a fresh one): "
              "this reminder comes once per task.")
WAIT_OVER_BODY = ("You woke during your declared wait and are ending your turn again without a `mesh send`. A "
                  "wait covers only the turn end that declared it. If you're still waiting, send a fresh one with "
                  "`mesh send parent --type wait --until <time> --body …` and end your turn; if the task is "
                  "finished, run `mesh inbox`, then report `done` or `failed` with `mesh send parent`; if you're stuck, "
                  "send a `question`.")
WAIT_OVER = "agent-mesh: " + WAIT_OVER_BODY  # the Stop hook's reason; the body is the agy watch's doorbell


def task_line(run_id: str, name: str, events: list[dict]) -> str:
    """A sentence naming `name`'s current task, for a nudge to a worker that may have been compacted since it
    read it: its gist past the standard prefixes, or a review's first line (which names the PR and head); empty
    when its file is gone."""
    files = current_task(run_id, name, events)
    body = parse_message(files[0])[1].strip() if files else ""
    review = REVIEW_GIST_RE.match(body)
    line = review.group(1) if review else task_gist(body)
    return f" Your current task: “{line}”." if line else ""


def stop_hook(run_id: str, name: str, payload: dict) -> str | None:
    """The reason a Claude worker's Stop hook keeps its turn going, or None to let it end.

    Once per task (the task's nudge, shared with the watch) or per new unread mail, never in plan mode (a plan
    the user approves in the pane, or a talk with the user), and only for a worker that got a task and has
    unread mail or hasn't reported since its last one. A turn that already continues because of a hook
    (`stop_hook_active`) can still get the nudge a mail block kept, but no mail block without new mail.
    """
    active = bool(payload.get("stop_hook_active"))
    if payload.get("permission_mode") == "plan":
        return None
    entry = ((maybe_run(run_id) or {}).get("agents") or {}).get(name)
    if not entry or entry.get("role") != "worker" or entry.get("status") in ("retiring", "retired"):
        return None
    if entry.get("plan_review") == "user" and "permission_mode" not in payload:
        return None  # can't tell whether it is still in plan mode: the watch judges it
    events = read_log(run_id)
    received, sent, _ = since_last_task(events, name)
    paths = unread(run_id, name)
    mail = [parse_message(p)[0].get("type") or "message" for p in paths]
    # A declared wait lets through the turn end that declared it; a later one (it woke) ends the wait and is
    # judged as if there were none, with one reminder (`WAIT_OVER` when the task's nudge is already spent).
    wait = live_wait(events, name)
    woke = bool(wait and wait.get("turned")) and mark_wait(run_id, name, wait["file"], "wait_over")
    sent = sent or bool(wait and not woke)

    def let_end() -> None:
        if wait and not woke:
            mark_wait(run_id, name, wait["file"], "wait_turn")
        return None

    if not received or (sent and not mail):
        return let_end()
    if mail and (sent or last_received_unread(run_id, name, events)):
        # Mail alone: the task's one nudge is kept for a silent turn end after the worker has read its task.
        # A mail block is deduped by the unread files instead, so the same mail never blocks twice.
        files = sorted(p.name for p in paths)
        with run_lock(run_id):
            last = next((e for e in reversed(read_log(run_id))
                         if e.get("event") == "hook_mail" and e.get("name") == name), None)
            # nothing new since the last mail block (in this continuation: no new file)
            seen = bool(last and (set(files) <= set(last.get("files") or ()) if active else last.get("files") == files))
            if not seen:
                log_event(run_id, "hook_mail", name=name, files=files)
        return let_end() if seen else mail_reason(mail)
    claimed = claim_nudge(run_id, name, received, via="stop-hook")
    if not claimed and not woke:
        return None
    reasons = [mail_reason(mail)] if mail else []
    reasons.append((HOOK_NUDGE if claimed else WAIT_OVER) + task_line(run_id, name, events))
    return "\n\n".join(reasons)


def mail_reason(mail: list[str]) -> str:
    kinds = ", ".join(dict.fromkeys(mail))
    return (f"agent-mesh: you have {len(mail)} unread mesh message{'s' if len(mail) > 1 else ''} ({kinds}): run "
            f"`mesh inbox` and handle {'them' if len(mail) > 1 else 'it'} before ending your turn.")


def last_received_unread(run_id: str, name: str, events: list[dict]) -> bool:
    """Whether the last task or answer `name` received is still in its mailbox, unread."""
    last = next((e for e in reversed(events) if e.get("event") == "send" and e.get("to") == name
                 and e.get("type") in RECEIVED_TYPES), None)
    return bool(last and last.get("file") and (inbox_dir(run_id, name) / last["file"]).exists())


def cmd_hook(args: argparse.Namespace) -> int:
    """A Claude worker's hook (`worker_hooks`). It always exits 0: a hook must never break a session."""
    try:
        payload = json.loads(sys.stdin.read() or "{}")
        payload = payload if isinstance(payload, dict) else {}
    except (ValueError, OSError):
        payload = {}
    try:
        reason = stop_hook(*identity(args), payload)
    except Exception as exc:  # noqa: BLE001 - anything else would show up in the worker's session as a hook error
        print(f"mesh hook {args.event}: {exc}", file=sys.stderr)
        return 0
    if reason:
        print(json.dumps({"decision": "block", "reason": hook_text(reason)}))
    return 0


def alerted(events: list[dict], name: str, received: int, kind: str = "stopped") -> bool:
    """Whether a watch already raised this alert for `name`'s current task: `stopped` (exit 3, the kind of an
    alert logged without one), `gone` (exit 5), `limit` (a Claude usage limit, exit 7), `login` (an expired Claude
    login, exit 7) or `hung` (exit 8)."""
    return any(e.get("event") == "alert" and e.get("name") == name and e.get("received") == received
               and e.get("kind", "stopped") == kind for e in events)


def record_alert(run_id: str, name: str, received: int, kind: str = "stopped") -> None:
    """Log this alert for this task, once (checked and logged under the run lock)."""
    with run_lock(run_id):
        if not alerted(read_log(run_id), name, received, kind):
            log_event(run_id, "alert", name=name, received=received, kind=kind)


def nudge(run_id: str, name: str, entry: dict, received: int, events: list[dict]) -> bool:
    """Remind a worker whose turn ended silently to report, through `deliver`, with a short ring schedule."""
    body = NUDGE_BODY + task_line(run_id, name, events)
    delivery = deliver(run_id, entry.get("parent") or me_parent(run_id, name), name, "info", body,
                       delays=NUDGE_RING_DELAYS)
    rung = bool(delivery.get("rung"))
    log_event(run_id, "nudge_rung", name=name, received=received, rung=rung,
              **({} if rung else {"error": delivery.get("error")}))
    return rung


def age_seconds(stamp_iso: str | None) -> float:
    try:
        return (datetime.now(timezone.utc) - datetime.fromisoformat(stamp_iso)).total_seconds()
    except (TypeError, ValueError):
        return float("inf")


def unread_report(run_id: str, parent: str | None, name: str) -> str | None:
    """The type of the oldest report (`plan`, `question`, `done`, `failed`) from `name` still unread by `parent`."""
    for path in unread(run_id, parent) if parent else ():
        meta, _ = parse_message(path)
        if meta.get("from") == name and meta.get("type") in REPORT_TYPES:
            return meta["type"]
    return None


def unread_line(name: str, kind: str) -> str:
    return f"{name} sent a {kind} you haven't read yet: read it with `mesh inbox`"


def epoch(stamp_iso: str | None) -> float:
    try:
        return datetime.fromisoformat(stamp_iso.replace("Z", "+00:00")).timestamp()  # 3.10 reads no `Z`
    except (TypeError, ValueError, AttributeError):
        return 0.0


def work_evidence(run: dict, entry: dict) -> dict:
    """What a worker's branch and worktree show of its work: commits past its base, whether the tip is pushed,
    whether the worktree has uncommitted changes. None where it can't be told (no branch, base or worktree)."""
    repo, branch, base, cwd = entry.get("repo"), entry_branch(run, entry), entry.get("base"), entry.get("cwd")
    found: dict = {"commits": None, "pushed": None, "dirty": None}
    if repo and branch:
        try:
            tip = git("rev-parse", f"refs/heads/{branch}", cwd=repo)
            if base:
                found["commits"] = int(git("rev-list", "--count", f"{base}..{tip}", cwd=repo))
            try:
                found["pushed"] = git("rev-parse", f"{branch}@{{upstream}}", cwd=repo) == tip
            except MeshError:
                found["pushed"] = False  # no upstream
        except (MeshError, ValueError):
            pass
    if cwd and Path(cwd).is_dir():
        try:
            found["dirty"] = bool(git("status", "--porcelain", cwd=cwd))
        except MeshError:
            pass
    return found


PR_LIST_TIMEOUT = 10  # seconds the `gh pr list` of an alert's evidence may take


def open_pr(run: dict, entry: dict) -> str | None:
    """`PR #n open` for an open PR from the worker's branch, `no open PR`, or `PR unknown` when gh can't say."""
    branch = entry_branch(run, entry)
    if not branch or not entry.get("repo"):
        return None
    result = run_cli(["gh", "pr", "list", "--head", branch, "--state", "open", "--json", "number,url"],
                     cwd=entry["repo"], timeout=PR_LIST_TIMEOUT)
    try:
        prs = json.loads(result.stdout) if result.returncode == 0 else None
    except ValueError:
        prs = None
    if not isinstance(prs, list):
        return "PR unknown"
    return ", ".join(f"PR #{pr.get('number')} open" for pr in prs if isinstance(pr, dict)) or "no open PR"


def evidence_line(run: dict, entry: dict) -> str:
    """What an exit 3/5 alert adds about the worker's work: commits past its base, pushed, an open PR (asked of
    gh only when there are commits), a dirty worktree. Empty when none of it can be told."""
    found = work_evidence(run, entry)
    commits, parts = found["commits"], []
    if commits is not None:
        parts.append("no commits past its base" if commits == 0 else f"{commits} commit(s) past its base")
    if commits and found["pushed"] is not None:
        parts.append("pushed" if found["pushed"] else "not pushed")
    if commits and (pr := open_pr(run, entry)):
        parts.append(pr)
    if found["dirty"] is not None:
        parts.append("worktree dirty" if found["dirty"] else "worktree clean")
    return f"\n  its work: {', '.join(parts)}" if parts else ""


def wait_note(events: list[dict], name: str) -> str:
    """Says so when the worker's current task had a declared wait, now over."""
    wait = declared_wait(events, name)
    if not wait:
        return ""
    if wait.get("over"):
        return f"; its wait until {wait.get('until')} ended when it woke {ago(age_seconds(wait['over']))} ago"
    return f"; its wait until {wait.get('until')} ended {ago(age_seconds(wait.get('until')))} ago"


class Watch:
    """One child's watchdog state between polls (see watch_agents)."""

    def __init__(self, run_id: str, name: str, grace: float, finals_at_start: int | None = None,
                 hang: float = HANG_AFTER, idle_retire: float = 0.0):
        entry = agent_entry(load_run(run_id), name)
        self.run_id, self.name, self.grace, self.hang = run_id, name, grace, hang
        self.idle_retire = idle_retire  # seconds idle after its report before this watch retires it (0: never)
        self.start_grace = max(START_GRACE_FACTOR * grace, SETTLE_GRACE)
        # Final sends before the watch started (or before its task was delivered) don't count.
        self.finals_at_start = sends_from(run_id, name, FINAL_TYPES) if finals_at_start is None else finals_at_start
        # ...but a report its parent hasn't read yet is news, whenever it was sent (not for `mesh ask`, whose
        # baseline is the count before its question, and which reads the reply itself).
        self.unread_report = None if finals_at_start is not None else unread_report(run_id, entry.get("parent"), name)
        self.log = entry.get("log")
        self.headless = entry.get("view") == "headless"
        self.log_offset = Path(self.log).stat().st_size if self.log and Path(self.log).exists() else 0
        self.session: str | None = None  # its conversation, once found (see conversation)
        self.session_tried: float | None = None
        self.prev: str | None = None
        self.state: str | None = None  # the last tick's reading, held or not (prev skips a held worker's)
        self.worked = False  # seen working since it last reported (or since it was nudged)
        self.idle_for: float | None = None  # seconds it has read idle in a row
        self.wait_idle = 0.0  # the same during a declared wait, when only a usage limit, an expired login or agy's
        # turn end is looked for
        self.woke: str | None = None  # the wait (its file) during which this watch saw an agy worker working again
        self.wait_file: str | None = None  # the wait `wait_idle` counts for
        self.blocked_polls = 0
        self.nudged: int | None = None  # the task (count of tasks and answers received) this watch nudged for
        self.reopening = 0.0  # seconds spent excusing a "gone" worker that is being reopened
        self.reported = False  # it reported since the watch started (an --alerts watch carries on)
        self.retired = False  # the root is retiring it, or has: whatever it does next is no news
        self.finished = False  # it reported, then its pane closed or its session ended; or it was retired
        self.idle_at: float | None = None  # when this watch first read it idle, in the current run of idle readings
        self.retire_tried: str | None = None  # the report (its file) this watch last tried to retire it after
        self.auto_retired = False  # this watch retired it, idle after its report
        self.retire_held: str | None = None  # the report (its file) whose retire a viewer held, logged once
        self.gone_polls = 0  # the run's retirer: polls in a row it read this worker gone (retire_poll)
        self.gone_after: str | None = None  # ...and the report after which it let it go as ended
        self.continue_failed: str | None = None  # the `continue_due` whose delivery this watch saw fail, logged once

    def tick(self, interval: float, alerts_only: bool = False, bg_rows: list[dict] | None = None,
             events: list[dict] | None = None) -> tuple[int, str] | None:
        """(status, line) once there is something to say, else None. `events` is this poll's read of the log."""
        run_id, name = self.run_id, self.name
        events = read_log(run_id) if events is None else events
        if self.headless and file_orphan(run_id, name):  # a killed `mesh ask` left its answer unfiled
            events = read_log(run_id)
        event = self.report_event(events, alerts_only) or self.quota_event()
        if event:
            return event
        entry = agent_entry(load_run(run_id), name)
        state = self.state = agent_status(name, entry, bg_rows)
        if agent_entry(load_run(run_id), name).get("status") in ("retiring", "retired"):  # read after the state
            self.retired = self.finished = True  # the root is closing it on purpose, report or not
            return None
        if self.retired:  # its retire failed, or it was resumed: watch it again
            self.retired = self.finished = False
        if due_continue(events, name):
            try:
                if continue_worker(run_id, name, entry, state, events) == "continued":
                    return None  # continued at its reset: judged afresh from the next poll
            except (MeshError, OSError) as exc:  # tried again at the next poll, as the retirer does
                due = due_continue(events, name) or {}
                if self.continue_failed != due.get("id"):
                    self.continue_failed = due.get("id")
                    log_event(run_id, "continue_failed", name=name, id=due.get("id"), error=str(exc)[-300:])
        if entry.get("held") and release_held(run_id, name, entry, state):
            return None  # at the startup screen its start already reported (exit 4), or its doorbell just rang
        if (state == "gone" and self.reopening < SWAP_GRACE
                and agent_entry(load_run(run_id), name).get("status") == "starting"):  # read after the state
            self.reopening += interval  # `mesh approve` / `mesh switch` is reopening it on another model
            return None  # nothing to judge meanwhile: its idle time doesn't count either
        if state != "gone":
            self.reopening = 0.0
        if state == "gone":
            if self.reported:
                self.finished = True  # nothing to alert
                return None
            record_alert(run_id, name, since_last_task(events, name)[0], "gone")
            return 5, (f"ALERT {name} is gone (pane closed or agent exited) without reporting done/failed"
                       + evidence_line(load_run(run_id), entry))
        bg = entry.get("view") == "bg"
        self.blocked_polls = self.blocked_polls + 1 if state == "blocked" else 0
        if self.blocked_polls >= 2 and entry.get("plan_review") != "user":  # that one waits for the user's approval
            limit = self.limited(entry, bg)
            if limit:  # Claude's usage-limit menu, or a login prompt
                return self.limit_alert(entry, bg, limit, events)
            look = f"`claude attach {entry['bg_id']}`" if bg else f"`herdr agent read {name}`"
            return 4, self.with_tail(f"ALERT {name} is blocked on a UI prompt; inspect it with {look}", bg, entry)
        self.prev = state
        wait = live_wait(events, name)
        if wait:  # a declared wait: a silent stop or a quiet transcript is expected
            self.idle_for = self.idle_at = None
            self.worked = self.worked or state == "working"
            if entry.get("kind") != "claude":  # no Stop hook: the watch sees its turn ends (idle for --grace)
                return self.agy_wait(entry, bg, wait, state, interval)
            if state not in ("idle", "done"):
                self.wait_idle = 0.0
                return None
            self.wait_idle += interval  # ...but not a usage limit or expired login: look once per `grace` of idle
            if self.wait_idle < self.grace:
                return None
            self.wait_idle = 0.0
            limit = self.limited(entry, bg)
            return self.limit_alert(entry, bg, limit, events) if limit else None
        self.wait_idle, self.wait_file = 0.0, None
        if state not in ("idle", "done"):
            self.idle_at = None
        if state in ("idle", "done"):
            # One idle reading isn't the end of a turn: agy shows no spinner for a few seconds between steps.
            self.idle_for = 0.0 if self.idle_for is None else self.idle_for + interval
            # A worker waiting on its reset (`continue_due`) is the continue's: a nudge would only cancel it.
            if self.idle_for >= self.grace and (self.worked or self.idle_from_start(events)) \
                    and not due_continue(events, name):
                event = self.stopped(entry, bg, events)
                if event:
                    return event
            self.idle_tick(entry, state, events)
            return None
        self.idle_for = None
        if state == "working":
            self.worked = True
        if state in ("working", "unknown"):
            return self.hung(entry, bg, state, events)
        return None

    def maybe_retire(self, entry: dict, bg: bool, events: list[dict], report: dict | None = None) -> None:
        """Retire a worker that reported `done` or `failed` and has been idle `idle_retire` seconds since (design
        §18): an idle process holds memory and buys nothing over a resume, which `mesh send` and `mesh ask` do.
        Idle since its report and its last transcript write (this watch's first idle reading when it has none
        to read), so a restarted watch doesn't start the count again. Not while a user's draft is in its pane,
        nor while the user looks at it (`viewer`: attached, or its pane focused).
        A failed retire is logged and not tried again for that report; one a new message called off is."""
        run_id, name = self.run_id, self.name
        if report is None:
            report = retirable(run_id, name, entry, events) if self.idle_retire else None
        if not report or report.get("file") == self.retire_tried:
            return
        progress = last_progress(entry, self.conversation(entry))
        idle = time.time() - max(epoch(report.get("time")), progress if progress is not None else self.idle_at or 0)
        if idle < self.idle_retire:
            return
        if not bg and human_draft(pane_lines(name, ansi=True)):
            return  # the user is typing to it
        why = viewer(name, entry)
        if why:  # the user is looking at it: retired once they leave, if it is still idle
            if self.retire_held != report.get("file"):
                self.retire_held = report.get("file")
                log_event(run_id, "retire_held", name=name, file=report.get("file"), why=why)
            return

        def still(agent: dict) -> bool:  # under the run lock: a message stored since stops it (see deliver)
            again = retirable(run_id, name, agent, read_log(run_id))
            return bool(again) and again.get("file") == report.get("file")

        try:
            if not retire_worker(run_id, name, entry, still=still):
                return  # a message came meanwhile: judged again once it is idle after it
        except (MeshError, OSError) as exc:
            self.retire_tried = report.get("file")
            log_event(run_id, "auto_retire_failed", name=name, file=report.get("file"), error=str(exc)[-300:])
            return
        log_event(run_id, "auto_retire", name=name, file=report.get("file"), idle=int(idle))
        self.auto_retired = True

    def idle_tick(self, entry: dict, state: str, events: list[dict], report: dict | None = None) -> None:
        """The retire half of `tick`'s idle branch, for the run's retirer too (retire_poll, which passes the
        `retirable` report it already has): no nudges, no alerts."""
        if state not in ("idle", "done"):
            self.idle_at = None
            return
        self.idle_at = self.idle_at or time.time()
        self.maybe_retire(entry, entry.get("view") == "bg", events, report)

    def report_event(self, events: list[dict], alerts_only: bool) -> tuple[int, str] | None:
        """A report nobody has read yet (first tick only), or a `done`/`failed` sent since the watch started."""
        run_id, name = self.run_id, self.name
        if self.unread_report:
            kind, self.unread_report = self.unread_report, None
            return 0, unread_line(name, kind)
        finals = sends_from(run_id, name, FINAL_TYPES, events)
        if finals > self.finals_at_start:
            last = [e for e in events if e.get("event") == "send" and e.get("sender") == name][-1]
            if not alerts_only:
                return 0, f"{name} reported {last['type']}: read it with `mesh inbox`"
            self.finals_at_start, self.reported = finals, True
        return None

    def quota_event(self) -> tuple[int, str] | None:
        """A quota error agy logged since the last poll."""
        reset, self.log_offset = quota_hit(self.log, self.log_offset)
        if reset is None:
            return None
        model = agent_entry(load_run(self.run_id), self.name).get("model")
        return 7, (f"ALERT {self.name} hit its quota on {model}" + (f" (resets in {reset})" if reset else "")
                   + f"; move it to the next model with `mesh switch {self.name}`")

    def conversation(self, entry: dict) -> str | None:
        """Its session or conversation id: recorded, or looked up (at most once every SESSION_RETRY seconds)."""
        if entry.get("session") or self.session:
            return entry.get("session") or self.session
        now = time.time()
        if self.session_tried is None or now - self.session_tried >= SESSION_RETRY:
            self.session_tried = now
            self.session = find_session(self.run_id, self.name, entry)
        return self.session

    def limited(self, entry: dict, bg: bool) -> tuple[str, str] | None:
        """("limit", the reset time or "") when a Claude worker is at its usage limit, ("login", "") when its login
        expired, else None: from its session file (`transcript_stop`, which a background worker has too), or, only
        when that can't be read, the pane's last lines. A readable file decides the login (a login line on the pane
        after a later reply is stale), and the usage limit when it holds a usage-limit record: a limit screen left
        on the pane after a `release` is stale, but with no record the screen counts (a limit menu may write none).
        """
        if entry.get("kind") != "claude":
            return None
        stop = transcript_stop(entry, self.conversation(entry))
        found = error_limit(stop)
        if found or bg or (stop and stop[0] == LIMIT_OVER):
            return found
        lines = pane_lines(self.name)
        if lines is None and entry.get("pane"):
            lines = pane_lines(entry["pane"])
        if stop is None and login_expired(lines):
            return "login", ""
        reset = usage_limit(lines)
        return ("limit", reset) if reset is not None else None

    def limit_alert(self, entry: dict, bg: bool, limit: tuple[str, str], events: list[dict]) -> tuple[int, str] | None:
        """Exit 7 for a Claude usage limit or an expired login, once per task; None when this task was already
        alerted on for it."""
        kind, reset = limit
        received = since_last_task(events, self.name)[0]
        if alerted(events, self.name, received, kind):
            return None  # the root knows, and sends a new task once it's solved, which re-arms this
        record_alert(self.run_id, self.name, received, kind)
        if kind == "login":
            where = f"its session (`mesh open {self.name}` attaches to it)" if bg else "its pane"
            return 7, (f"ALERT {self.name}'s Claude login expired; it can't go on until the user logs in: ask the "
                       f"user to run `/login` in {where}, then `mesh send {self.name} --type task "
                       f"--body \"You're logged in again: continue where you stopped.\"`")
        when = f" (resets {reset})" if reset else ""
        when_reset = claude_limit_reset(entry.get("model")) or parse_reset(reset)
        if when_reset is None and claude_usage() is None:  # nothing to tell the reset by: the 5-hour window's worst
            when_reset = time.time() + LIMIT_UNKNOWN_RESET
        due = schedule_continue(self.run_id, self.name, "limit", when_reset)
        how = "" if bg else " (Claude Code's own auto-continue first, in its pane)"
        return 7, (f"ALERT {self.name} hit Claude's usage limit{when}; mesh continues it after the reset"
                   f"{how}, {continue_text(due)}: tell the user, and send it nothing")

    def hung(self, entry: dict, bg: bool, state: str, events: list[dict]) -> tuple[int, str] | None:
        """Exit 8, once per task, when it reads working (or herdr lost it) with nothing reported since its last task
        or answer, and its transcript hasn't changed for `hang` seconds since then. The watch never stops it."""
        if not self.hang:
            return None
        run_id, name = self.run_id, self.name
        received, sent, at = since_last_task(events, name)
        if not received or not gone_counts(entry):
            # No task or answer in this run (a peer reopened for an ask, before it is asked: its transcript is the
            # last ask's), or being reopened: herdr names the new pane before its CLI runs in it.
            return None
        if sent or alerted(events, name, received, "hung"):
            return None  # it reported (herdr's `working` may be stale); or this task was already alerted on
        progress = last_progress(entry, self.conversation(entry))
        if progress is None:
            return None  # nothing to judge it by
        quiet = time.time() - max(progress, epoch(at))
        if quiet < self.hang:
            return None
        if any(alerted(events, name, received, kind) for kind in ("limit", "login")):
            limit = self.limited(entry, bg)
            if limit and alerted(events, name, received, limit[0]):
                return None  # still stopped by what this task was alerted on; once over, a hang counts again
        if not bg and pane_probe(entry.get("pane"), entry.get("kind")) in ("missing", "dead"):
            if self.reported:
                self.finished = True  # as in tick's gone branch: nothing to alert
                return None
            record_alert(run_id, name, received, "gone")
            return 5, (f"ALERT {name} is gone: herdr still reads it {state}, but its pane runs no "
                       f"{entry.get('kind') or 'agent'} process (it exited without reporting done/failed)"
                       + evidence_line(load_run(run_id), entry))
        limit = self.limited(entry, bg)
        if limit:
            return self.limit_alert(entry, bg, limit, events)
        record_alert(run_id, name, received, "hung")
        what = "herdr has lost track of it" if state == "unknown" else "it reads working"
        look = (f"`claude logs {entry['bg_id']}`" if bg
                else f"`herdr agent read {name} --source recent-unwrapped --lines 80`")
        line = (f"ALERT {name} may be hung: {what}, and its transcript hasn't changed for {int(quiet // 60)} min "
                f"(a tool call that never returns, such as a test or a server in watch mode?); inspect it with "
                f"{look}. The watch won't stop it, and won't raise this again for this task")
        return 8, self.with_tail(line, bg, entry)

    def idle_from_start(self, events: list[dict]) -> bool:
        """Never seen working, but its last task or answer is `start_grace` old (in the log, so a watch started
        late still judges it) with nothing reported since: its turn ended, or never began. A task some watch
        already alerted on isn't judged again (a restarted watch would re-alert every `--grace`); a new task or
        answer, or a `working` reading, re-arms it."""
        received, sent, at = since_last_task(events, self.name)
        # A worker held at a startup screen heard its task only once its released doorbell rang.
        released = next((e.get("time") for e in reversed(events)
                         if e.get("event") == "held_rung" and e.get("name") == self.name and e.get("rung")), None)
        return (bool(received) and not sent and min(age_seconds(at), age_seconds(released)) >= self.start_grace
                and not alerted(events, self.name, received))

    def agy_wait(self, entry: dict, bg: bool, wait: dict, state: str, interval: float) -> tuple[int, str] | None:
        """The Stop hook's wait rule, seen from outside: its first turn end under the wait is `wait_turn`, and a
        turn end after a `working` reading since then (it woke) is `wait_over`, judged as a silent stop. A wake
        shorter than one poll, within `--grace` of the turn end that declared the wait, or one no running watch
        saw is missed: the wait then holds until its deadline, as before waits ended at a wake."""
        if wait["file"] != self.wait_file:  # a fresh wait: its idle count starts again
            self.wait_idle, self.wait_file = 0.0, wait["file"]
        if state not in ("idle", "done"):
            self.wait_idle = 0.0
            if state == "working" and wait.get("turned"):
                self.woke = wait["file"]
            return None
        self.wait_idle += interval
        if self.wait_idle < self.grace:
            return None
        if self.woke != wait["file"]:
            if not wait.get("turned"):
                mark_wait(self.run_id, self.name, wait["file"], "wait_turn")
            return None
        if not mark_wait(self.run_id, self.name, wait["file"], "wait_over"):
            return None  # another watch ended it: the next poll judges it as usual
        return self.stopped(entry, bg, read_log(self.run_id), woke=True)

    def stopped(self, entry: dict, bg: bool, events: list[dict], woke: bool = False) -> tuple[int, str] | None:
        """Its turn has ended: fine if it reported since its last task or answer, else nudge it once, then alert.
        A turn end that ended a wait (`woke`) gets one reminder even when the task's nudge is spent."""
        run_id, name = self.run_id, self.name
        received, sent, _ = since_last_task(events, name)
        self.worked, self.idle_for = False, None
        if sent:
            return None  # a report, or a plan or question waiting for its answer
        limit = self.limited(entry, bg)
        if limit:  # nothing to nudge: it can't go on until the reset, or a new login
            return self.limit_alert(entry, bg, limit, events)
        def work() -> str:  # git and gh calls: only for an alert
            return wait_note(events, name) + evidence_line(load_run(run_id), entry)

        if bg:  # the watch can't reach a background session: only its Stop hook nudges it
            record_alert(run_id, name, received)
            if (nudge_of(events, name, received) or {}).get("via"):
                return 3, (f"ALERT {name} stopped working without sending a message (its Stop hook nudged it once"
                           f"{self.unread_note()}); inspect it with `claude logs {entry['bg_id']}`{work()}")
            return 3, (f"ALERT {name} stopped working without sending a message{self.unread_note(' (', ')')}; "
                       f"inspect it with `claude logs {entry['bg_id']}`, or nudge it once with `mesh send {name} --type info "
                       f"--body \"Report with mesh send\"`{work()}")
        if claim_nudge(run_id, name, received):
            self.nudged = received
            nudge(run_id, name, entry, received, events)
            self.worked, self.idle_for = True, 0.0  # alert if it stays idle, or goes idle again without a report
            return None
        if woke:
            delivery = deliver(run_id, entry.get("parent") or me_parent(run_id, name), name, "info",
                               WAIT_OVER_BODY + task_line(run_id, name, events), delays=NUDGE_RING_DELAYS)
            rung = bool(delivery.get("rung"))
            log_event(run_id, "wait_reminder", name=name, received=received, rung=rung,
                      **({} if rung else {"error": delivery.get("error")}))
            self.nudged = received
            self.worked, self.idle_for = True, 0.0
            return None
        events = read_log(run_id)
        done = nudge_of(events, name, received) or {}
        reminder = next((e for e in reversed(events) if e.get("event") == "wait_reminder"
                         and e.get("name") == name and e.get("received") == received), None)
        if reminder and epoch(reminder.get("time")) >= epoch(done.get("time")):
            done = {**reminder, "what": "reminder"}  # its newest reminder: the one at its wake
        if self.nudged != received and age_seconds(done.get("time")) < self.grace:
            # another watch just nudged it: give it the same time the nudger gives it
            self.worked, self.idle_for = True, 0.0
            return None
        what = done.get("what", "nudge")
        how = ("nudged once by its Stop hook" if done.get("via") else
               ("reminded once at its wake" if what == "reminder" else "nudged once") if done.get("rung")
               else self.undelivered_nudge(done.get("error"), what))
        how += self.unread_note()
        line = (f"ALERT {name} stopped working without sending a message ({how}); inspect it with "
                f"`herdr agent read {name} --source recent-unwrapped --lines 80`{work()}")
        record_alert(run_id, name, received)
        return 3, self.with_tail(line, bg, entry)

    @staticmethod
    def undelivered_nudge(error: str | None, what: str = "nudge") -> str:
        if error == "human_draft":  # `ring` doesn't type into a draft: the user is typing there
            return f"its {what} was not delivered: someone has a draft typed in its pane, so mesh didn't type over it"
        return f"its {what} was not delivered ({error})" if error else f"its {what} was not delivered"

    def unread_note(self, before: str = ", ", after: str = "") -> str:
        """Says so when a task or answer is still in its mailbox: it never picked it up."""
        types = {m["type"] for m in unread_received(self.run_id, self.name)}
        kinds = [t for t in RECEIVED_TYPES if t in types]
        if not kinds:
            return ""
        return f"{before}its {' and '.join(kinds)} {'are' if len(kinds) > 1 else 'is'} still unread{after}"

    def with_tail(self, line: str, bg: bool, entry: dict) -> str:
        tail = "" if bg else pane_tail(self.name) or (pane_tail(entry["pane"]) if entry.get("pane") else "")
        return f"{line}\n  last lines of its pane:\n{tail}" if tail else line


def watch_agents(run_id: str, names: list[str], timeout: float = 0, interval: float = 5.0, grace: float = SETTLE_GRACE,
                 finals_at_start: int | None = None, alerts_only: bool = False,
                 hang: float | None = None, autoreset: bool = False, every: dict | None = None,
                 retire_after: float = 0.0, reserve: bool = False) -> tuple[int, str]:
    """Wait for the first of `names` to report done/failed (0) or raise an alert (3-8), with the line that says which.

    A report one of them sent that its parent hasn't read yet returns 0 at once. `finals_at_start` (one name only)
    is the child's count of final sends before its task was delivered, so a report that lands before the watch
    starts still counts (and an unread one isn't news). `alerts_only` keeps watching through reports. `hang` is
    the transcript silence that raises exit 8 (default HANG_AFTER, or MESH_HANG_AFTER; 0 turns it off).
    `autoreset` (the root's own watch, unless MESH_ROOT_AUTORESET=0) resets an idle root over the threshold.
    `every` (`--any`: the run as read when `names` were picked) also watches the run's other workers that owe a
    report or come later, and lets retired ones go (see Roster). `retire_after` (`mesh watch`'s, MESH_IDLE_RETIRE)
    retires a worker idle that long after its `done` or `failed` (Watch.maybe_retire). `reserve` (the root's own
    watch) raises exit 7 once when a quota its live workers draw on reaches the reserve (`reserve_alert`).
    """
    hang = hang_after() if hang is None else hang
    watches = [Watch(run_id, name, grace, finals_at_start, hang, retire_after) for name in names]
    deadline = time.monotonic() + timeout if timeout else None
    held = dict(zip(names, hold_watch(run_id, names)))
    roster = Roster(run_id, grace, hang, held, every, names, retire_after) if every is not None else None
    try:
        return poll_watches(run_id, watches, timeout, interval, deadline, alerts_only, autoreset, roster, reserve)
    finally:
        for handle in held.values():
            handle.close()


class Roster:
    """What `mesh watch --any` re-reads each poll. Holds `ANY_WATCH`'s lock, so root commands know an unwatched
    worker is taken on at the next poll."""

    def __init__(self, run_id: str, grace: float, hang: float, held: dict, run: dict, names: list[str],
                 retire_after: float = 0.0):
        self.run_id, self.grace, self.hang, self.held, self.retire_after = run_id, grace, hang, held, retire_after
        # `spawned` as the watch found it: a new one means spawned or resumed since
        self.seen = {name: e.get("spawned") for name, e in run["agents"].items() if e["role"] != "root"}
        self.ever = set(names)  # every worker it has watched
        self.left: list[str] = []  # retired without a report since the watch started
        self.ended: list[str] = []  # retired after its report
        self.auto: list[str] = []  # retired by this watch, idle after its report
        held[ANY_WATCH] = hold_watch(run_id, [ANY_WATCH])[0]

    def refresh(self, run: dict, watches: list["Watch"], events: list[dict]) -> None:
        """Update `watches` in place from this poll's read of the run: a retired worker leaves, and a worker that
        isn't watched joins when it owes a report (one gone without it, and not yet alerted on, is then raised as
        gone), is starting (a spawn, resume or swap the watch's start may have read as gone) or has a new
        `spawned`. One retired and resumed between two polls gets a fresh Watch."""
        for watch in list(watches):
            entry = run["agents"].get(watch.name) or {}
            if entry.get("status") == "retired" or entry.get("spawned") != self.seen.get(watch.name):
                watches.remove(watch)
                self.held.pop(watch.name).close()
                if entry.get("status") == "retired":
                    (self.auto if watch.auto_retired else self.ended if watch.reported else self.left).append(
                        watch.name)
        watching = {w.name for w in watches}
        for name, entry in run["agents"].items():
            if (entry["role"] == "root" or name in watching or entry.get("status") in ("retiring", "retired")
                    or not self.joins(name, entry, events)):
                continue
            self.seen[name] = entry.get("spawned")
            self.held[name] = hold_watch(self.run_id, [name])[0]
            watches.append(Watch(self.run_id, name, self.grace, hang=self.hang, idle_retire=self.retire_after))
            self.ever.add(name)
            for past in (self.left, self.ended, self.auto):
                if name in past:
                    past.remove(name)

    def joins(self, name: str, entry: dict, events: list[dict]) -> bool:
        if entry.get("status") == "starting" or name not in self.seen or entry.get("spawned") != self.seen[name]:
            return True
        received, sent, _ = since_last_task(events, name)
        return bool(received) and not sent and not alerted(events, name, received, "gone")

    def settling(self, watches: list["Watch"]) -> bool:
        """Whether a worker may be about to come back: one retiring now (`retire_worker` waits for its turn to
        end before the `retire` event), one the next refresh takes on, retired in the last RETIRE_SETTLE seconds
        and not resumed since (the root resumes a group's worker right after retiring it), or being resumed
        (compaction can take minutes). Reads the run and log afresh: this poll's reads can predate a retire its
        ticks saw, or a resume that ended meanwhile."""
        run, events = load_run(self.run_id), read_log(self.run_id)
        watching = {w.name for w in watches}
        for name, entry in run["agents"].items():
            if entry["role"] == "root":
                continue
            if entry.get("status") == "retiring" or (name not in watching and entry.get("status") != "retired"
                                                     and self.joins(name, entry, events)):
                return True
        retired: dict[str, float] = {}
        pending: dict[tuple, float] = {}
        for e in events:
            kind = e.get("event")
            if kind == "retire":
                retired[e.get("name")] = age_seconds(e.get("time"))
            elif kind == "resuming":
                pending[(e.get("from_run"), e.get("name"))] = age_seconds(e.get("time"))
                if e.get("from_run") == self.run_id:
                    retired.pop(e.get("name"), None)
            elif kind in ("resume", "resume_failed"):
                pending.pop((e.get("from_run"), e.get("from_name")), None)
        return (any(age < RETIRE_SETTLE for age in retired.values())
                or any(age < COMPACT_TIMEOUT + RETIRE_SETTLE for age in pending.values()))


def poll_watches(run_id: str, watches: list["Watch"], timeout: float, interval: float, deadline: float | None,
                 alerts_only: bool, autoreset: bool = False, roster: Roster | None = None,
                 reserve: bool = False) -> tuple[int, str]:
    checked = float("-inf")  # when the root was last checked for an idle reset
    quotas = float("-inf")  # when the quotas were last looked at
    stopped = (0, stopped_line(run_id))
    while True:
        if run_stopped(run_id):  # `mesh stop` archived it under the watch: nothing more comes
            return stopped
        try:
            run = load_run(run_id)
            events = read_log(run_id)  # one read per poll, shared by every watch
            if stop_under_way(events):  # it's closing the panes: a worker reading gone now is no news
                return stopped
            if roster:
                roster.refresh(run, watches, events)
            # One `claude agents` call per poll, shared by every background worker.
            bg_rows = claude_agents() if any(run["agents"].get(w.name, {}).get("view") == "bg" for w in watches) else None
            if autoreset and time.monotonic() - checked >= AUTORESET_EVERY:
                checked = time.monotonic()
                quietly(maybe_autoreset, run_id, run, events)
            if reserve and time.monotonic() - quotas >= RESERVE_POLL:
                quotas = time.monotonic()
                alert = quietly(reserve_alert, run_id, run, events)
                if alert:
                    return alert
            for watch in watches:
                event = watch.tick(interval, alerts_only, bg_rows, events)
                if event:
                    # a stop that began during this poll: its closed panes read gone
                    return stopped if event[0] and stop_under_way(read_log(run_id)) else event
            over = all(w.finished for w in watches) and not (roster and roster.settling(watches))
        except (MeshError, OSError):
            if run_stopped(run_id):  # archived mid-poll: a read or write of the live run failed
                return stopped
            raise
        if over:
            # without --alerts only a retired worker finishes without returning
            left, ended, auto = (roster.left, roster.ended, roster.auto) if roster else ([], [], [])
            if roster and not roster.ever:
                return 0, "no live workers to watch"
            retired = [*left, *(w.name for w in watches if w.retired and not w.reported and not w.auto_retired)]
            auto = [*auto, *(w.name for w in watches if w.auto_retired)]
            if not retired and not auto:
                return 0, "every watched worker reported and has ended; nothing left to watch"
            said = ([f"retired {', '.join(retired)}"] if retired else []) + (
                [f"auto-retired {', '.join(auto)} (idle since its report)"] if auto else [])
            everyone = len(retired) + len(auto) == len(watches) + len(left) + len(ended) + len(roster.auto if roster else [])
            rest = "" if everyone else "; the rest reported and have ended"
            return 0, f"{' and '.join(said)}{rest}; nothing left to watch"
        if deadline and time.monotonic() > deadline:
            waiting = [w for w in watches if not w.reported and not w.retired]
            if not waiting:
                retired = any(w.retired for w in watches) or bool(roster and roster.left)
                return 0, f"every watched worker reported{' or was retired' if retired else ''} within {timeout}s"
            states = ", ".join(f"{w.name}: {w.prev}" for w in waiting)
            who = waiting[0].name if len(waiting) == 1 else f"{len(waiting)} workers"
            return 6, f"ALERT {who} has not reported within {timeout}s ({states})"
        time.sleep(interval)


def reserve_alert(run_id: str, run: dict, events: list[dict]) -> tuple[int, str] | None:
    """Exit 7 the first time a quota the run's live workers draw on reaches the reserve: once per window and reset
    (a `reserve` event). Nothing is stopped: the workers finish their current task, and the gates
    (`reserve_guard`) refuse new work meanwhile."""
    if reserve_off(run_id) or quota_stop() >= 100:
        return None
    live = [e for e in run["agents"].values()
            if e.get("role") == "worker" and e.get("status") not in ("retired", "retiring")]
    hits = []
    claude_models = {e.get("model") for e in live if e.get("kind") == "claude"}
    usage = claude_usage() if claude_models else None
    for model in sorted(claude_models, key=str):
        if hit := claude_at_reserve(usage, model):
            key, window = hit
            # The endpoint stamps `resets_at` with the request's own microseconds: the minute names the window.
            hits.append((f"claude:{key}:{str(window['resets'])[:16]}", "Claude", claude_hit_text(key, window)))
    for model, effort in sorted({(e["model"], e.get("effort")) for e in live if e.get("kind") == "agy" and e.get("model")}):
        if hit := agy_at_reserve(model, effort):
            hits.append((f"agy:{model}:{hit[1]}", "agy", agy_hit_text(model, hit)))
    seen = {e.get("key") for e in events if e.get("event") == "reserve"}
    for key, vendor, what in hits:
        if key in seen or not what:
            continue
        log_event(run_id, "reserve", key=key)
        return 7, (f"ALERT {what}: mesh keeps {100 - quota_stop()}% of every quota for the user "
                   f"(MESH_QUOTA_STOP={quota_stop()}), so it starts no new {vendor} work until then; running workers "
                   "finish their current task. Tell the user; don't stop or retire them (`mesh reserve off` lets "
                   "this run go on past it)")
    return None


ANY_WATCH = "--any"  # the lock a running `mesh watch --any` holds besides its workers'; no worker name starts with -


def watch_lock(run_id: str, name: str) -> Path:
    return run_dir(run_id) / "watching" / f"{name}.lock"


def hold_watch(run_id: str, names: list[str]) -> list:
    """A shared lock on each watched worker's lock file, held while the watch runs: the kernel drops it when the
    process dies, so `watched` never trusts a stale pid file."""
    held = []
    for name in names:
        path = watch_lock(run_id, name)
        path.parent.mkdir(parents=True, exist_ok=True)
        handle = path.open("a")
        fcntl.flock(handle, fcntl.LOCK_SH)
        held.append(handle)
    return held


def watched(run_id: str, name: str) -> bool:
    """Whether some running `mesh watch` (or `mesh ask`) watches `name`."""
    path = watch_lock(run_id, name)
    if not path.exists():
        return False
    with path.open("a") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(handle, fcntl.LOCK_UN)
    return False


def unwatched(run_id: str, skip: tuple[str, ...] = ()) -> list[str]:
    """The run's workers that owe a report (a task or answer with no report since) and that no watch covers,
    skipping one a watch already raised as gone (exit 5) on that task. No herdr or `claude` calls."""
    run = maybe_run(run_id)
    if not run:
        return []
    events = read_log(run_id)
    owing = []
    for name, entry in run["agents"].items():
        if (entry.get("role") != "worker" or name in skip or entry.get("view") == "headless"
                or entry.get("status") in ("retiring", "retired")):
            continue
        if owes_report(events, name) and not alerted(events, name, since_last_task(events, name)[0], "gone") \
                and not watched(run_id, name):
            owing.append(name)
    return owing


def warn_unwatched(run_id: str, skip: tuple[str, ...] = ()) -> None:
    """Root-side commands warn when a worker that owes a report has no watch, so a silent stop goes unseen. Only
    those are asked whether they're gone: `mesh watch --any` leaves a gone worker out, so it needs other advice.
    These commands start or hand out work, so the root is about to wait: the moment a reset pays most."""
    root_hint(run_id, about_to_wait=True)
    try:
        names = unwatched(run_id, skip)
    except (OSError, MeshError):
        return  # a warning must never fail the command that just did its work
    if not names:
        return

    def looks_gone(name: str, entry: dict, bg_rows: list[dict]) -> bool:
        try:
            return agent_status(name, entry, bg_rows) == "gone"
        except Exception:  # noqa: BLE001 - can't tell: warn as for a live one
            return False

    agents = load_run(run_id)["agents"]
    try:
        bg_rows = claude_agents() if any(agents[n].get("view") == "bg" for n in names) else []
    except Exception:  # noqa: BLE001
        bg_rows = []
    gone = [n for n in names if looks_gone(n, agents[n], bg_rows)]
    # A running --any watch takes on every worker `unwatched` names at its next poll (Roster.joins: it owes a
    # report and wasn't raised as gone), a gone one to raise it (exit 5): no need to start another.
    live = [] if watched(run_id, ANY_WATCH) else [n for n in names if n not in gone]
    if live:
        each = "each owes" if len(live) > 1 else "it owes"
        print(f"warning: no `mesh watch` covers {', '.join(live)} ({each} a report): start "
              f"`mesh watch --any --alerts` in the background", file=sys.stderr)
    for name in gone:
        print(f"warning: {name} looks gone without a report: `mesh watch {name}` (exit 5), or `mesh resume` / "
              f"`mesh retire` it", file=sys.stderr)


def hang_after() -> float:
    try:
        return float(os.environ.get("MESH_HANG_AFTER") or HANG_AFTER)
    except ValueError:
        return HANG_AFTER


def held_wait() -> float:
    try:
        return float(os.environ.get("MESH_HELD_WAIT") or HELD_WAIT)
    except ValueError:
        return HELD_WAIT


def idle_retire() -> float:
    """MESH_IDLE_RETIRE, where 0 or less means never."""
    try:
        return max(0.0, float(os.environ.get("MESH_IDLE_RETIRE") or IDLE_RETIRE))
    except ValueError:
        return IDLE_RETIRE


def watch_agent(run_id: str, name: str, timeout: float = 0, interval: float = 5.0, grace: float = SETTLE_GRACE,
                finals_at_start: int | None = None) -> tuple[int, str]:
    return watch_agents(run_id, [name], timeout, interval, grace, finals_at_start)


def cmd_retire(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    entry = require_parent(load_run(run_id), me, args.agent, "retire")
    retire_worker(run_id, args.agent, entry)
    emit({"retired": args.agent, "cwd": entry.get("cwd"), "branch": entry.get("branch")})
    return 0


def retire_worker(run_id: str, name: str, entry: dict, still=None) -> bool:
    """Close a worker's pane (or stop its background session); its conversation stays resumable. `still(agent)`,
    checked under the run lock before anything changes, can call it off (False)."""
    with editing_run(run_id) as run:  # first, so a watch never takes the closing pane for a crash
        agent = run["agents"][name]
        if still and not still(agent):
            return False
        before, agent["status"] = agent.get("status"), "retiring"
    try:
        if entry.get("view") == "bg":
            if entry.get("bg_id") and not stop_bg(entry) and bg_status(entry) != "gone":  # still running
                raise MeshError(f"couldn't stop {name}'s background session {entry['bg_id']}")
        elif entry.get("pane"):  # none if its pane never opened
            try:  # let it end the turn it reported in, so its conversation is saved whole (as in swap_model)
                herdr("agent", "wait", name, "--until", "idle", "--until", "done", "--timeout", str(RETIRE_WAIT_MS),
                      timeout=RETIRE_WAIT_MS / 1000 + 10)
            except HerdrError:
                pass  # gone already, or still busy: close it anyway
            try:
                herdr("pane", "close", entry["pane"])
            except HerdrError as exc:
                if exc.code not in ("pane_not_found", "agent_not_found"):
                    raise
    except BaseException:
        with editing_run(run_id) as run:  # still open: it isn't retired
            run["agents"][name]["status"] = before
        raise
    with editing_run(run_id) as run:
        run["agents"][name]["status"] = "retired"
    log_event(run_id, "retire", name=name)
    sweep_worktrees(run_id, {name: entry})  # what it left running there (design §17)
    return True


# The run's retirer (design §18): a detached process a worker's `done`/`failed` starts, so a worker is retired
# when idle whether or not a `mesh watch` runs (an agy root runs none, a Claude root's ends at its timeout).
RETIRER_POLL = 30.0  # seconds between its polls


def retirer_lock_path(run_id: str) -> Path:
    return run_dir(run_id) / "retirer.lock"


def ensure_retirer(run_id: str) -> int | None:
    """Start the run's retirer unless one runs (it holds the lock), or idle retire is off and no worker waits to be
    continued at a reset; its pid, or None. Called after the report (or the `continue_due`) is logged, so a
    retirer letting go of the lock re-checks and sees it (run_retirer)."""
    if not idle_retire():
        events = read_log(run_id)
        if not any(due_continue(events, n) for n in load_run(run_id)["agents"]):
            return None
    handle = retirer_lock_path(run_id).open("a")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        return None
    try:
        return start_retirer(run_id, handle)
    finally:
        handle.close()  # the child holds the lock now: same open file, its own descriptor


def start_retirer(run_id: str, handle) -> int:
    """Start `mesh retirer` detached, handing it the locked `handle` (as start_reset does). It runs as
    nobody: the starter is usually a worker, whose pane id `worker_caller` would map back to it (refused by
    `check_worker`), and from the run dir, since `sweep_worktrees` stops ttyless orphans in a worktree."""
    log = run_dir(run_id) / "logs" / "retirer.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    argv = [sys.executable, str(Path(__file__).absolute()), "retirer", "--run", run_id,
            "--lock-fd", str(handle.fileno())]
    with open(log, "a") as out:
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, env=claude_env(),
                                cwd=run_dir(run_id), start_new_session=True, pass_fds=(handle.fileno(),))
    log_event(run_id, "retirer_started", pid=proc.pid)
    return proc.pid


# ── continuing at a reset ────────────────────────────────────────────────
# A worker stopped by a usage limit (Claude) or a spent quota with no model left (agy) is continued at the reset by
# mesh itself, from the watch or the run's retirer, without waking the root (design §9, "Limits and resets").

LIMIT_UNKNOWN_RESET = 5 * 3600  # a limit with no reset time and no usage reading: continued after the longest window
CONTINUE_GRACE = 600  # seconds after a reset before mesh continues a worker: Claude Code's own continue goes first
LIMIT_CONTINUE = "The usage limit has reset: continue where you stopped."
QUOTA_CONTINUE = "Your model's quota has reset: continue where you stopped."
# Claude Code's armed auto-continue, as its pane shows it (`autoContinueAtUsageLimit`, on by default).
AUTO_CONTINUE_RE = re.compile(r"continuing automatically|Continuing shortly", re.IGNORECASE)
RESET_CLOCK_RE = re.compile(r"\b(\d{1,2})(?::(\d{2}))?\s*([ap]m)\b", re.IGNORECASE)
RESET_DATE_RE = re.compile(r"\b(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.?\s+\d|\d{1,2}/\d{1,2}",
                           re.IGNORECASE)
RESET_ZONE_RE = re.compile(r"\(([A-Za-z]+(?:/[A-Za-z0-9_+-]+)+|UTC)\)")


def parse_reset(text: str | None) -> float | None:
    """The epoch of a reset Claude names as a clock time (`7pm (America/Los_Angeles)`, `2:20am`): its next
    occurrence in that zone (else the local one); None when the text names no time or an unknown zone."""
    match = RESET_CLOCK_RE.search(text or "")
    if not match or RESET_DATE_RE.search(text or ""):
        return None  # no time, or a date it would read as today (`Oct 30, 7pm`): the caller has better sources
    zone = RESET_ZONE_RE.search(text or "")
    try:
        from zoneinfo import ZoneInfo
        tz = ZoneInfo(zone.group(1)) if zone else datetime.now().astimezone().tzinfo
    except (ImportError, ValueError, KeyError, OSError):
        return None
    hour = int(match.group(1)) % 12 + (12 if match.group(3).lower() == "pm" else 0)
    now = datetime.now(tz)
    at = now.replace(hour=hour, minute=int(match.group(2) or 0), second=0, microsecond=0)
    return (at if at > now else at + timedelta(days=1)).timestamp()


def claude_limit_reset(model: str | None = None) -> float | None:
    """When Claude's spent window (for `model`) resets, the latest of those at 100%, from its usage; None if none
    is or it's unknown."""
    windows = claude_windows_for(claude_usage(), model).values()
    # A reset already past is a stale reading's (a cache), not this limit's: the caller then has other sources.
    resets = [epoch(w["resets"]) for w in windows if w["used"] >= 100 and epoch(w.get("resets")) > time.time()]
    return max(resets, default=None)


def still_limited(entry: dict) -> bool:
    """Whether the quota that stopped a worker scheduled with no reset time still reads spent (unknown: no)."""
    if entry.get("kind") == "claude":
        return any(w["used"] >= 100 for w in claude_windows_for(claude_usage(), entry.get("model")).values())
    hit = agy_at_reserve(entry.get("model") or "", entry.get("effort")) if entry.get("model") else None
    return bool(hit and hit[0] <= 0)


def iso_at(when: float) -> str:
    return datetime.fromtimestamp(when, timezone.utc).isoformat(timespec="seconds")


def due_continue(events: list[dict], name: str) -> dict | None:
    """`name`'s pending `continue_due`: the newest one, until a `continued` or `continue_dropped` settles it."""
    found = None
    for event in events:
        if event.get("name") != name:
            continue
        if event.get("event") == "continue_due":
            found = event
        elif event.get("event") in ("continued", "continue_dropped") and found and event.get("id") == found.get("id"):
            found = None
    return found


def schedule_continue(run_id: str, name: str, why: str, reset: float | None) -> dict:
    """Log that `name` is to be continued CONTINUE_GRACE after `reset` (None: once its quota reads free), and make
    sure a retirer runs to do it when no watch does. Once per task: a pending one for the same task stands."""
    events = read_log(run_id)
    received = since_last_task(events, name)[0]
    pending = due_continue(events, name)
    if pending and pending.get("received") == received:
        return pending
    event = {"name": name, "why": why, "received": received, "id": secrets.token_hex(4),
             **({"at": iso_at(reset + CONTINUE_GRACE)} if reset else {})}
    log_event(run_id, "continue_due", **event)
    quietly(ensure_retirer, run_id)
    return event


def continue_text(due: dict) -> str:
    return f"at {reset_text(due['at'])}" if due.get("at") else "once its quota reads free again"


def continue_worker(run_id: str, name: str, entry: dict, state: str, events: list[dict]) -> str | None:
    """Continue `name` if its `continue_due` is due: "continued", "dropped" (logged with why), or None (not yet).

    Dropped, not deferred, once anything else moved it on: a newer task or answer, a report since (a plan or
    question waits on the root), working again, gone, retired, or (Claude) its session file shows the limit over,
    which Claude Code's own auto-continue (or the user) leaves. Held while a pane still shows Claude's armed
    auto-continue, which fires at about the reset, and while a quota with no known reset still reads spent. The
    `continue` is a task from its parent, stored and rung as any; the root isn't woken."""
    due = due_continue(events, name)
    if not due:
        return None
    received = since_last_task(events, name)[0]
    report, _ = last_report(events, name)
    why = None
    if entry.get("status") in ("retiring", "retired"):
        why = "it was retired"
    elif received != due.get("received"):
        why = "it got a newer task or answer"
    elif report:
        why = f"it sent a {report.get('type')} since"
    elif state == "working":
        why = "it is working again"
    elif state == "gone" and gone_counts(entry):
        why = "it is gone"
    elif entry.get("kind") == "claude":
        stop = transcript_stop(entry, entry.get("session"))
        if stop and stop[0] == LIMIT_OVER:
            why = "it was continued already (Claude Code's own auto-continue, or the user)"
    if why:
        log_event(run_id, "continue_dropped", name=name, id=due.get("id"), why=why)
        return "dropped"
    if due.get("at") and epoch(due["at"]) > time.time():
        return None
    if (not due.get("at") and still_limited(entry)) or state not in ("idle", "done", "blocked"):
        return None
    if entry.get("kind") == "claude" and entry.get("view") != "bg" and \
            AUTO_CONTINUE_RE.search("\n".join(pane_lines(name) or [])):
        return None  # Claude Code continues it itself
    body = LIMIT_CONTINUE if due.get("why") == "limit" else QUOTA_CONTINUE
    delivery = deliver(run_id, entry.get("parent"), name, "task", body)
    log_event(run_id, "continued", name=name, id=due.get("id"), rung=delivered(delivery))
    return "continued"


def continue_poll(run_id: str, run: dict, events: list[dict]) -> bool:
    """The retirer's other duty: continue the workers no watch covers whose `continue_due` is due. True while
    any worker's continue is still pending."""
    bg_rows = None
    for name, entry in run["agents"].items():
        if not due_continue(events, name) or watched(run_id, name):
            continue
        if entry.get("view") == "bg" and bg_rows is None:
            bg_rows = read_claude_agents()
            if bg_rows is None:
                continue  # `claude agents` failed: next poll
        try:
            continue_worker(run_id, name, entry, agent_status(name, entry, bg_rows or []), events)
        except (MeshError, OSError) as exc:
            print(f"{now_iso()} {name}: {exc}", flush=True)
    events = read_log(run_id)
    return any(due_continue(events, name) for name in run["agents"])


RETIRER_GONE_POLLS = 3  # polls in a row a reported worker must read gone before the retirer lets it go


def retire_pass(run_id: str, watches: dict[str, "Watch"]) -> bool:
    """One poll of the retirer; True while it should keep running (see retire_poll). A poll that fails on an
    error (the process table, a lock file) is tried again at the next one."""
    try:
        return retire_poll(run_id, watches)
    except (MeshError, OSError) as exc:
        print(f"{now_iso()} {exc}", flush=True)
        return True


def gone_counts(entry: dict) -> bool:
    """Whether a `gone` reading means the worker ended: not while it is being reopened (`starting` within
    STARTING_GRACE, `relaunching`, `held`) or retired (`retiring`)."""
    status = entry.get("status")
    if status == "retiring" or entry.get("relaunching") or entry.get("held"):
        return False
    return not (status == "starting" and seconds_since(last_launch(entry)) < STARTING_GRACE)


def retire_poll(run_id: str, watches: dict[str, "Watch"]) -> bool:
    """It keeps running for any worker whose newest report since its last task or answer is a `done` or `failed`,
    that isn't retired, whose retire after that report didn't fail (here or in a watch: `auto_retire_failed`) and
    that didn't read gone RETIRER_GONE_POLLS polls in a row: a state that only holds the retire for now (unread
    mail, a wait, held, starting, retiring) keeps it, as nothing would start it again. Each such worker no `mesh
    watch` covers is read every poll (a gone one too, while the retirer runs, so one resumed counts again); while
    `retirable` names it, the watch's own path retires it (`Watch.idle_tick`, then `maybe_retire`). A poll that
    can't read the background sessions (`read_claude_agents`) skips them. A worker that left (a new task, retired)
    loses its Watch, so a stale idle count never retires it after a burst of work. While a `mesh stop` is under
    way it retires nothing and keeps running, until the run is stopped (or the stop failed)."""
    run = maybe_run(run_id)
    if not run or run_stopped(run_id):
        return False
    events = read_log(run_id)
    continuing = continue_poll(run_id, run, events) if not stop_under_way(events) else False
    if not idle_retire():
        return continuing
    failed = {e.get("name"): e.get("file") for e in events if e.get("event") == "auto_retire_failed"}
    candidates, pending = {}, set()
    for name, entry in run["agents"].items():
        report, _ = last_report(events, name)
        if (entry.get("role") != "worker" or entry.get("view") == "headless" or entry.get("status") == "retired"
                or not report or report.get("type") not in FINAL_TYPES
                or report.get("file") in (failed.get(name), watches.get(name) and watches[name].retire_tried)):
            continue
        candidates[name] = (entry, report)
        if not (name in watches and watches[name].gone_after == report.get("file")):
            pending.add(name)
    for name in set(watches) - set(candidates):
        del watches[name]
    if stop_under_way(events):
        return True  # it is closing them: nothing to retire, and a failed stop leaves them to this retirer
    unwatched_ones = {n: c for n, c in candidates.items() if not watched(run_id, n)}
    for name in set(candidates) - set(unwatched_ones):
        if name in watches:
            watches[name].idle_at = None  # its watch judges it meanwhile
    bg_rows = read_claude_agents() if any(e.get("view") == "bg" for e, _ in unwatched_ones.values()) else []
    for name, (entry, report) in unwatched_ones.items():
        if entry.get("view") == "bg" and bg_rows is None:
            continue  # `claude agents` failed: can't tell this poll
        if name not in watches:
            watches[name] = Watch(run_id, name, SETTLE_GRACE, idle_retire=idle_retire())
        watch = watches[name]
        try:
            state = agent_status(name, entry, bg_rows or [])
        except (MeshError, OSError) as exc:  # herdr can't be read now: try at the next poll
            print(f"{now_iso()} {name}: {exc}", flush=True)
            continue
        if state == "gone" and gone_counts(entry):
            watch.idle_at, watch.gone_polls = None, watch.gone_polls + 1
            if watch.gone_polls >= RETIRER_GONE_POLLS:  # ended after its report: nothing to retire
                watch.gone_after = report.get("file")
                pending.discard(name)
            continue
        if watch.gone_polls or watch.gone_after:  # back (resumed with no task): count it again
            watch.gone_polls, watch.gone_after = 0, None
            pending.add(name)
        again = retirable(run_id, name, entry, events)
        if again:
            watch.idle_tick(entry, state, events, again)
        else:
            watch.idle_at = None  # may not be retired now (unread mail, a wait, held, starting…)
    return bool(pending) or continuing


def run_retirer(run_id: str, handle, poll: float = RETIRER_POLL, sleep=time.sleep) -> int:
    """The retirer's loop, holding the run's retirer lock (`handle`), until no worker may be retired, the run
    is gone or stopped, or idle retire is off. Before it exits it lets go of the lock and looks once more: a
    report logged before that look is seen, and a `send` logged after it finds the lock free and starts one."""
    watches: dict[str, Watch] = {}
    while True:
        if retire_pass(run_id, watches):
            sleep(poll)
            continue
        fcntl.flock(handle, fcntl.LOCK_UN)
        if not retire_pass(run_id, watches):
            return 0
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0  # a newer retirer has it
        sleep(poll)


def cmd_retirer(args: argparse.Namespace) -> int:
    """The run's retirer (started by a worker's report, `ensure_retirer`): retire its idle workers."""
    if args.lock_fd is not None:
        handle = os.fdopen(args.lock_fd, "a")
    else:  # by hand: only when none runs
        handle = retirer_lock_path(args.run).open("a")
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("mesh: this run's retirer is already running", file=sys.stderr)
            return 0
    with handle:
        return run_retirer(args.run, handle)


# ── past workers: agents, resume, open ───────────────────────────────────


def all_runs() -> list[tuple[dict, Path]]:
    """Every run, live and archived, newest first, with its directory."""
    home = mesh_home()
    runs = []
    for path in (*home.glob("*/run.json"), *home.glob("archive/*/run.json")):
        try:
            runs.append((json.loads(path.read_text()), path.parent))
        except (OSError, ValueError):
            continue
    return sorted(runs, key=lambda r: r[0].get("created", ""), reverse=True)


def worker_prs(folder: Path, name: str, entry: dict | None = None) -> list[str]:
    """PR links in the messages a worker sent; its `done` reports carry them. PRs it only reviewed don't count."""
    reviewed = set((entry or {}).get("reviews") or ())
    prs: list[str] = []
    for path in sorted((folder / "inbox").glob("**/*.md")):
        meta, body = parse_message(path)
        if meta.get("from") == name:
            prs += PR_RE.findall(body)
    return [url for url in dict.fromkeys(prs) if url not in reviewed]


def gh_json(argv: list[str], cwd: str | Path | None = None) -> tuple[object, str | None]:
    """`gh <argv>` with `--json` fields: what it printed, parsed, or None and why gh couldn't answer."""
    result = run_cli(["gh", *argv], cwd=cwd, timeout=30)
    if result.returncode:
        return None, (result.stderr.strip().splitlines() or [f"gh exited {result.returncode}"])[-1]
    try:
        return json.loads(result.stdout), None
    except ValueError:
        return None, "gh printed no JSON"


def github_repos(repo: str | Path) -> set[str] | None:
    """`owner/name` of each GitHub remote of `repo` (lowercase): empty when its remotes are elsewhere, None when
    it has none or git can't read them (the repo is gone)."""
    try:
        remotes = git("remote", cwd=repo).split()
        urls = [git("remote", "get-url", remote, cwd=repo) for remote in remotes]
    except MeshError:
        return None
    return {f"{m.group(1)}/{m.group(2)}".lower() for m in map(GITHUB_REMOTE_RE.search, urls) if m} if urls else None


def pr_head_branch(pr: str) -> str | None:
    """The branch a PR was opened from (`gh pr view`), or None when gh can't say."""
    data, _ = gh_json(["pr", "view", pr, "--json", "headRefName"])
    return data.get("headRefName") if isinstance(data, dict) else None


def worktree_branch(entry: dict) -> str | None:
    """The branch a worker's own worktree is on now (it may follow its repo's naming), not a main checkout's."""
    cwd, repo = entry.get("cwd"), entry.get("repo")
    if not cwd or not Path(cwd).is_dir() or (repo and Path(cwd).resolve() == Path(repo).resolve()):
        return None
    try:
        return git("branch", "--show-current", cwd=cwd) or None
    except MeshError:
        return None


def opened_pr(pr: str, head: str, run: dict, entry: dict, live_branch: bool = False) -> bool:
    """Whether this worker's branch is the PR's head, in the PR's repo (unless the worker's repo has no remotes)."""
    if live_branch and pr in (entry.get("reviews") or ()):
        return False  # a reviewer that checked the PR's branch out isn't its author (one reviewing its own PR is)
    branch = worktree_branch(entry) if live_branch else entry_branch(run, entry)
    if not branch or branch != head:
        return False
    repos = github_repos(entry["repo"]) if entry.get("repo") else None
    owner_repo = pr.split("github.com/", 1)[1].rsplit("/pull/", 1)[0].lower()
    return repos is None or owner_repo in repos


def find_worker(ref: str, from_run: str | None = None) -> tuple[dict, Path, str, dict]:
    """The newest worker whose name, branch or PR link is `ref`.

    A PR link names the worker whose branch is the PR's head (asked of `gh`): its recorded branch first, then
    the branch its worktree is on. Only when gh can't answer, or no branch matches, do the PR links in the
    workers' own messages count.
    """
    pr = PR_RE.search(ref)
    workers = [(run, folder, name, entry) for run, folder in all_runs() if not from_run or run["id"] == from_run
               for name, entry in reversed(run["agents"].items())  # a restart beats the agent it replaced
               if entry.get("role") != "root"]
    found = next((w for w in workers if ref in (w[2], entry_branch(w[0], w[3]))), None)
    head = pr_head_branch(pr.group(0)) if pr and not found else None
    for live_branch in (False, True) if head else ():
        found = found or next((w for w in workers if opened_pr(pr.group(0), head, w[0], w[3], live_branch)), None)
    if pr and not found:
        found = next((w for w in workers if pr.group(0) in worker_prs(w[1], w[2], w[3])), None)
    if found:
        return found
    raise MeshError(f"no worker matches {ref}" + (f" in run {from_run}" if from_run else "") + "; see `mesh agents`")


def proc_start(pid: int) -> str | None:
    """When a process started, which tells it from a later one given the same pid: its start time in clock
    ticks from /proc (field 22 of `stat`), else what `ps` says. None when it can't be read (or it's gone)."""
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        if Path("/proc/self/stat").exists():
            return None  # a /proc without this pid: it's gone
    try:
        out = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.strip() or None


def pid_alive(pid: int | None, start: str | None = None) -> bool:
    """Whether `pid` runs, and is still the process that started at `start` (proc_start) when that was recorded."""
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass  # alive, just not ours
    return not start or proc_start(pid) in (start, None)


def live_holder(name: str, entry: dict, agents: list[dict] | None = None,
                bg_rows: list[dict] | None = None, procs: list[dict] | None = None) -> dict | None:
    """A live agent that may hold this worker's conversation already.

    A background worker's own session, while it runs. Then any herdr agent in its own worktree (the user
    may have reopened it with `mesh open`); in a main checkout, which other sessions share, only an agent
    still carrying its name. herdr can lose a live agent's registration, so then any process that may hold
    it (`process_holder`). `procs` is one `agent_processes()` read, shared by a caller checking many workers.
    When herdr can't be asked (not installed, its server down, any failure), the process table alone answers;
    without one (no /proc) the herdr error is raised, since nothing could tell.
    """
    if entry.get("view") == "bg":
        row = bg_row(entry, bg_rows)
        if row and row.get("status"):
            return {"name": name, "pane_id": None, "bg_id": row.get("id")}
    if entry.get("view") == "headless":
        # Busy while the `mesh ask` running it lives, or the copilot it started, which a killed one leaves
        # running (copilot_ask); a `running` they both left is an answer file_orphan files.
        if entry.get("status") != "running":
            return None
        for key, answering in (("pid", "mesh process"), ("copilot_pid", "copilot process")):
            if pid_alive(entry.get(key), entry.get(f"{key}_start")):
                return {"name": name, "pane_id": None, "pid": entry[key], "answering": answering}
        return None
    cwd, unasked = entry.get("cwd"), None
    if agents is None:
        try:
            agents = herdr("agent", "list").get("agents", [])
        except MeshError as exc:
            if not has_proc():
                raise  # neither herdr nor a process table can say: don't guess
            agents, unasked = [], exc  # outside herdr (`mesh open` from a plain terminal): only the processes can tell
    if not cwd or (entry.get("repo") and Path(cwd).resolve() == Path(entry["repo"]).resolve()):
        holder = next((a for a in agents if a.get("name") == name), None) or process_holder(name, entry, None, procs)
    else:
        top = Path(cwd).resolve()
        holder = (next((a for a in agents if inside(a.get("cwd"), top) or inside(a.get("foreground_cwd"), top)), None)
                  or process_holder(name, entry, top, procs))
    if holder and unasked:
        holder["herdr_error"] = str(unasked)  # so a refusal doesn't claim herdr left it out
    return holder


def process_holder(name: str, entry: dict, top: Path | None, procs: list[dict] | None = None) -> dict | None:
    """A running `claude` / `agy` process of the worker's kind that may hold its conversation, herdr or not.

    In its own worktree (`top`), any one working there; in a shared checkout (`top` None), only one whose command
    line names its session. Without /proc, the pane it last ran in, if that still runs its CLI.
    """
    kind, session = entry.get("kind"), entry.get("session")
    if kind not in AGENT_BINARIES:
        return None  # a Copilot asker holds its session through its `mesh ask` pid (claim_copilot)
    procs = agent_processes() if procs is None else procs
    for proc in procs:
        if agent_binary(proc.get("argv")) != kind:
            continue
        if (inside(proc.get("cwd"), top) if top else bool(session) and session in proc.get("argv", [])):
            return {"name": name, "pane_id": None, "process": proc["pid"], "cwd": proc.get("cwd")}
    if top and not has_proc() and pane_probe(entry.get("pane"), kind) == "alive":
        return {"name": name, "pane_id": entry["pane"]}
    return None


def print_table(rows: list[dict], cols: tuple[str, ...]) -> None:
    widths = {c: max(len(c), *(len(str(r[c])) for r in rows)) for c in cols}
    print("  ".join(c.upper().ljust(widths[c]) for c in cols))
    for row in rows:
        print("  ".join(str(row[c]).ljust(widths[c]) for c in cols))


def cmd_agents(args: argparse.Namespace) -> int:
    try:
        live = herdr("agent", "list").get("agents", [])
    except MeshError:
        live = []  # outside herdr: every agent shows as gone
    query = (args.query or "").lower()
    pr = PR_RE.search(args.query or "")
    head = pr_head_branch(pr.group(0)) if pr else None  # a PR link also finds its author by the PR's branch
    rows = []
    runs = all_runs()
    bg_rows = claude_agents() if any(e.get("view") == "bg" for r, _ in runs for e in r["agents"].values()) else []
    procs = agent_processes()
    for run, folder in runs:
        if args.run and run["id"] != args.run:
            continue  # by run id, not branch: a worker resumed into a run keeps its old run's branch
        for name, entry in run["agents"].items():
            if entry.get("role") == "root":
                continue
            cwd, branch, prs = entry.get("cwd") or "", entry_branch(run, entry) or "", worker_prs(folder, name, entry)
            if head and pr.group(0) not in prs and any(opened_pr(pr.group(0), head, run, entry, live)
                                                       for live in (False, True)):
                prs.append(pr.group(0))
            reviews = entry.get("reviews") or []
            if query and not (any(query in str(v).lower() for v in (name, entry.get("repo"), branch, *prs, *reviews))
                              or (pr and pr.group(0) in prs)):
                continue
            rows.append({
                "name": name, "run": run["id"], "archived": folder.parent.name == "archive",
                "kind": entry.get("kind"), "model": entry.get("model") or "", "view": entry.get("view") or "pane",
                "repo": Path(entry["repo"]).name if entry.get("repo") else "", "branch": branch,
                "worktree": "present" if cwd and Path(cwd).exists() else "removed",
                "state": "live" if live_holder(name, entry, live, bg_rows, procs) else "gone",
                "session": "found" if find_session(run["id"], name, entry) else "missing",
                "prs": " ".join(prs), "reviews": " ".join(reviews), "cwd": cwd,
            })
    if args.json:
        emit(rows)
    elif not rows:
        scope = (f" match {args.query}" if query else "") + (f" in run {args.run}" if args.run else "")
        print(f"No workers{scope or ' found'}.")
    else:
        print_table(rows, ("name", "run", "kind", "model", "view", "repo", "branch", "worktree", "state", "session",
                           "prs", "reviews"))
    return 0


def resumable(ref: str, from_run: str | None, live_hint) -> tuple[dict, str, dict, str]:
    """Find a past worker and its conversation, refusing one that is still running."""
    run, _, name, entry = find_worker(ref, from_run)
    session = find_session(run["id"], name, entry)
    if not session:
        raise MeshError(
            f"can't find {name}'s {entry.get('kind')} conversation; start a fresh worker with "
            f"`mesh spawn --cwd {entry.get('cwd')}` and give it the old plan and report"
        )
    holder = live_hint(name, entry)
    if holder and holder.get("pid"):
        raise MeshError(f"{name} is still answering in {holder['answering']} {holder['pid']}; "
                        "ask it again once that finishes")
    if holder and holder.get("process"):
        raise MeshError(f"{name}'s conversation may still be open in process {holder['process']} (a {entry.get('kind')} "
                        f"running in {holder.get('cwd')}, "
                        + (f"while herdr can't be asked: {holder['herdr_error']}" if holder.get("herdr_error")
                           else "which herdr doesn't list")
                        + "); see it with "
                        f"`ps -o pid,args -p {holder['process']}`, and resume once it has ended")
    if holder:
        where = (f"background session {holder['bg_id']}" if holder.get("bg_id")
                 else f"pane {holder.get('pane_id')}")
        raise MeshError(f"{name} is still running in {where}; {holder['hint']}")
    return run, name, entry, session


def cmd_resume(args: argparse.Namespace) -> int:
    """Bring a past worker back, conversation and all, as a worker of this run."""
    run_id, me = identity(args)
    result = resume_worker(args, run_id, me)
    emit(result)
    held = report_held(result["name"], result.get("delivery"))  # the alert first: only the user can clear it
    warn_unwatched(run_id)
    return held or 0


READ_ONLY_STARTS = ("Question (read-only)", "Review (read-only)")


def read_only_task(task: str | None) -> bool:
    """A question or a review from `mesh ask` (PROTOCOL.md rule 7)."""
    return bool(task) and task.lstrip().startswith(READ_ONLY_STARTS)


def first_line(text: str | None, limit: int = 160) -> str:
    line = next((ln.strip() for ln in (text or "").splitlines() if ln.strip()), "")
    return line[:limit]


DIRECT_STARTS = ("Direct task (no plan)", "Plan review by the user")


def planned_task(task: str | None) -> bool:
    """A task the worker plans first: not a question, a review or a direct task."""
    return bool(task) and not task.lstrip().startswith(READ_ONLY_STARTS + DIRECT_STARTS)


def task_gist(task: str | None, limit: int = 160) -> str:
    """The line that says what a task is: the first one past the standard prefixes, without a heading's `#`."""
    for paragraph in re.split(r"\n\s*\n", task or ""):
        paragraph = paragraph.strip()
        if not paragraph or paragraph.startswith(READ_ONLY_STARTS + DIRECT_STARTS):
            continue
        line = first_line(paragraph.lstrip("#").strip())
        if line:
            return line[:limit]
    return ""


def maybe_compact(args: argparse.Namespace, entry: dict, session: str, model: str, task: str | None,
                  cross_run: bool, peer: bool = False) -> dict:
    """`--compact`: compact the conversation before it is reopened, if it's worth it (see should_compact)."""
    mode = getattr(args, "compact", None) or "auto"
    read_only = getattr(args, "read_only", False) or read_only_task(task)
    tokens = context_tokens(entry, session)
    report: dict = {"context_tokens": tokens, "compacted": False}
    if not should_compact(mode, entry, tokens, read_only, cross_run, peer):
        return report
    focus = getattr(args, "focus", None) or (
        PEER_FOCUS.format(repo=Path(entry.get("repo") or entry["cwd"]).name) if peer else COMPACT_FOCUS.format(
            task=task_gist(task) or "the follow-up task you are about to get"))
    ok, output = compact_conversation(entry, session, model, focus)
    report["compacted"] = ok
    if ok:
        report["context_tokens_after"] = context_tokens(entry, session)
    else:
        report["note"] = f"compaction failed, so it resumes as it was: {output}"
    return report


def finished_pr(repo: str | Path, branch: str, base: str | None = None) -> tuple[dict | None, str | None]:
    """The newest PR from `branch` once none from it is open (merged or closed), and why gh couldn't say.

    A PR counts only when its head commit is in the branch and not in `base`, the commit the worker started
    from, so an old PR from a reused branch name doesn't, merged into the default branch or not. One whose head
    commit isn't here (squash-merged and never fetched) still counts: telling would take a fetch.
    """
    data, error = gh_json(["pr", "list", "--head", branch, "--state", "all", "--json", "number,url,state,headRefOid"],
                          cwd=repo)
    if error or not isinstance(data, list):
        return None, error or "gh printed no list"

    def is_ancestor(oid: str, ref: str) -> bool:
        try:
            git("merge-base", "--is-ancestor", oid, ref, cwd=repo)
            return True
        except MeshError:
            return False

    def on_branch(pr: dict) -> bool:
        oid = pr.get("headRefOid")
        try:
            git("cat-file", "-e", f"{oid}^{{commit}}", cwd=repo)
        except MeshError:
            return True  # not here to compare
        return is_ancestor(oid, f"refs/heads/{branch}") and not (base and is_ancestor(oid, base))
    data = [pr for pr in data if pr.get("state") == "OPEN" or on_branch(pr)]
    if not data or any(pr.get("state") == "OPEN" for pr in data):
        return None, None
    return max(data, key=lambda pr: pr.get("number") or 0), None


def fetch_remote(repo: Path, remote: str, *refspecs: str) -> bool:
    """`git fetch`, never stopping for credentials and giving up after a minute (offline: the local copy will do)."""
    try:
        return subprocess.run(["git", "fetch", "-q", remote, *refspecs], cwd=repo, capture_output=True,
                              stdin=subprocess.DEVNULL, env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
                              timeout=60).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def pr_remote(repo: Path, pr: str) -> str | None:
    """The remote of `repo` that a PR link belongs to (`upstream` in a fork, say), if any."""
    match = re.search(r"github\.com/([\w.-]+/[\w.-]+)/pull/", pr)
    try:
        for remote in git("remote", cwd=repo).split():
            github = GITHUB_REMOTE_RE.search(git("remote", "get-url", remote, cwd=repo))
            if match and github and f"{github.group(1)}/{github.group(2)}".lower() == match.group(1).lower():
                return remote
    except MeshError:
        pass
    return None


def remote_default(repo: Path, remote: str, pr: str) -> str | None:
    """`<remote>/<its default branch>`: from `<remote>/HEAD`, else from `gh repo view`; None when neither says."""
    try:
        return git("rev-parse", "--abbrev-ref", f"{remote}/HEAD", cwd=repo)
    except MeshError:
        pass
    owner_repo = pr.split("github.com/", 1)[-1].rsplit("/pull/", 1)[0]
    data, _ = gh_json(["repo", "view", owner_repo, "--json", "defaultBranchRef"], cwd=repo)
    name = ((data or {}).get("defaultBranchRef") or {}).get("name") if isinstance(data, dict) else None
    try:
        return git("rev-parse", "--abbrev-ref", f"{remote}/{name}", cwd=repo) if name else None
    except MeshError:
        return None


def leave_finished_pr(args: argparse.Namespace, run_id: str, entry: dict, branch: str | None,
                      task: str | None) -> dict:
    """A change task for a worker whose PR is merged or closed goes on a new branch.

    Pushing to the old branch would update a dead PR (or recreate a branch deleted on merge). The worktree
    moves to `mesh/<run>/<slug>`: after a merge at the freshly fetched default branch, when the worktree is
    clean; after a close (the work never landed) at the old branch's tip, so its commits come along. In a main
    checkout, or a dirty worktree after a merge, the task tells the worker to do it. Only a resume with a change
    task is checked: without a task the worker would never hear of it, and the next resume with one checks again.
    Returns {} when there's nothing to say, else a `note` for the resume output, `task_note` for the task, and
    `branch` / `base` when the worktree moved. gh missing or failing never blocks a resume: it goes on as before,
    with a note.
    """
    read_only = getattr(args, "read_only", False) or read_only_task(task)
    current = worktree_branch(entry) or branch
    if not task or read_only or not current or not entry.get("repo") or not github_repos(entry["repo"]):
        return {}  # a question or review stays put; a repo off GitHub has no PR to check
    pr, error = finished_pr(entry["repo"], current, entry.get("base"))
    if error:
        return {"note": f"couldn't check whether {current} has a merged or closed PR (gh: {error}); "
                        f"resuming on it as before"}
    if not pr:
        return {}
    merged = pr.get("state") == "MERGED"
    what = f"PR #{pr.get('number')} ({pr.get('url')}) from `{current}` is {'merged' if merged else 'closed'}"
    cwd, repo = Path(entry["cwd"]), Path(entry["repo"])
    main_checkout = cwd.resolve() == repo.resolve()
    try:
        dirty = not main_checkout and bool(git("status", "--porcelain", cwd=cwd))
    except MeshError:
        dirty = True
    start = "the repo's default branch (fetch it first)" if merged else f"the tip of `{current}`"
    if main_checkout or (dirty and merged):
        why = "it runs in the main checkout" if main_checkout else "the worktree has uncommitted changes"
        return {"note": f"{what}, but {why}, so it stays on {current}; the task tells the worker to start a new branch",
                "task_note": f"Note from mesh: {what}. Don't push to that branch: start a new one from {start} "
                             f"and open a new PR for this task"
                             + (", and decide what to do with the uncommitted changes." if dirty else ".")}
    remote, oid = pr_remote(repo, pr.get("url") or ""), pr.get("headRefOid")

    def have(commit: str, inside: str | None = None) -> bool:
        try:
            git("cat-file", "-e", f"{commit}^{{commit}}", cwd=cwd)
            if inside:
                git("merge-base", "--is-ancestor", commit, inside, cwd=cwd)
            return True
        except MeshError:
            return False
    if merged:
        fetch_remote(repo, remote or "origin")
        start = (remote and remote_default(repo, remote, pr.get("url") or "")) or default_base(repo)
        told = f"`{start}`"
    else:
        # a dirty worktree keeps its changes: the new branch starts at the same commit
        start, told = "HEAD", f"the tip of `{current}`, so its commits come along"
        if oid and not have(oid, "HEAD"):  # its branch was deleted and recreated at its base: get the PR's head
            if remote:
                fetch_remote(repo, remote, f"pull/{pr.get('number')}/head")
            if have(oid):
                start, told = oid, f"the closed PR's head ({oid[:12]}, fetched from GitHub), so its commits come along"
            else:
                told = (f"the tip of `{current}`, but the closed PR's commits aren't here: its branch is gone and "
                        f"`pull/{pr.get('number')}/head` couldn't be fetched")
    sha = git("rev-parse", "--verify", f"{start}^{{commit}}", cwd=cwd)

    def taken(name: str) -> bool:
        try:
            git("rev-parse", "--verify", "--quiet", f"refs/heads/{name}", cwd=repo)
            return True
        except MeshError:
            return False
    slug = slugify(current.rsplit("/", 1)[-1], 24)
    slug, n = re.sub(r"-\d+$", "", slug) or slug, 2  # `fix-2` again makes `fix-3`, not `fix-2-2`
    new = f"mesh/{run_id}/{slug}"
    while new == current or taken(new):
        new, n = f"mesh/{run_id}/{slug}-{n}", n + 1
    try:
        git("switch", "-q", "-c", new, sha, cwd=cwd)
    except MeshError as exc:  # uncommitted changes that clash with the new start
        return {"note": f"{what}, but switching to a new branch failed ({exc}), so it stays on {current}; "
                        f"the task tells the worker to start a new branch",
                "task_note": f"Note from mesh: {what}. Don't push to that branch: start a new one from {told} "
                             f"and open a new PR for this task, and decide what to do with the uncommitted changes."}
    log_event(run_id, "branch", path=str(cwd), branch=new, left=current, pr=pr.get("url"))
    return {"branch": new, "base": sha, "pr": pr.get("url"),
            "note": f"{what}: {cwd} is now on a new branch, {new}, from {told}; {current} is kept",
            "task_note": f"Note from mesh: {what}, so this worktree is now on a new branch, `{new}`, started from "
                         f"{told}. Push that branch and open a new PR for this task; don't push to `{current}`"
                         + (" (its commits are still there if you need them)." if merged else ".")}


def owes_plan(run_id: str, name: str) -> bool:
    """Whether `name`, in a run live or archived, hasn't finished its current task: no `done` or `failed` since
    its last task or answer (a plan waiting for its answer still owes the work)."""
    path = log_path(run_id)
    events = parse_log_lines(path.read_text().splitlines(), path) if path.exists() else []
    report, _ = last_report(events, name)
    return not (report and report.get("type") in FINAL_TYPES)


def resume_worker(args: argparse.Namespace, run_id: str, me: str) -> dict:
    started: list[dict] = []  # its `resuming` event, once logged, with its memory reservation
    try:
        result = reopen_worker(args, run_id, me, started)
    except BaseException:
        # only while nothing was launched (reopen_worker drops it from the event then)
        quietly(release_memory, [event.get("reservation") for event in started])
        for event in started:  # so a `mesh watch --any` stops waiting for it
            quietly(log_event, run_id, "resume_failed", from_name=event["name"], from_run=event["from_run"])
        raise
    report, _ = last_report(read_log(run_id), result["name"])
    if report and report.get("type") in FINAL_TYPES:  # reopened with nothing new: idle after its report again
        quietly(ensure_retirer, run_id)
    return result


def reopen_worker(args: argparse.Namespace, run_id: str, me: str, started: list[dict]) -> dict:
    current = load_run(run_id)
    task = read_body(args.task, args.task_file)
    stored, mtype = getattr(args, "stored", None) or (None, "task")  # a message already in its mailbox

    def live_hint(name, entry):
        holder = live_holder(name, entry)
        if holder:
            held = holder.get("name")
            holder["hint"] = (f"`mesh retire {held}` once its `done` is in, then run this resume again, so it plans "
                              "the task at the planning effort (a Claude one under its deny list)"
                              if held in current["agents"] and planned_task(task)
                              else f"send it the task: `mesh send {held} --type task`" if held in current["agents"]
                              else f"attach to it with `mesh open {held}`" if holder.get("bg_id")
                              else f"go there with `herdr agent focus {held or holder.get('pane_id')}`")
        return holder

    old_run, old_name, old, session = resumable(args.ref, args.from_run, live_hint)
    # By the entry too: a resume that was given a `-2` name is still that peer.
    peer_name, peer = worker_peer(old_name, old, getattr(args, "peer", None))
    if old["kind"] == "copilot":
        raise MeshError(f"{old_name} is a Copilot asker, which only answers: ask it again with `mesh ask {old_name}`, "
                        "or give the change to the PR's author or a fresh worker")
    if peer_name and task and not read_only_task(task):  # a removed peer's conversation too
        raise MeshError(f"{old_name} is a peer asker, which only answers questions about its project: ask it with "
                        f"`mesh ask {peer_name if peer else old_name}`, and give a change to a worker in that repo "
                        f"(`mesh spawn --repo {old.get('repo')}`)")
    # A task it plans first plans where a spawn on `auto` would, whatever it last ran on, and gets the
    # execution phase, so `mesh approve` moves it on; a named model or effort covers the whole task, as in spawn.
    planned = planned_task(task) and not (args.model or args.effort)
    # Retired mid-plan and resumed with no task: still that planner, whichever way its plan phase began (a
    # spawn, a resume, or the plan a finished worker sent, which had no deny list), on the model it planned on,
    # unless it already reported `done` or `failed` on that task.
    mid_plan = not task and old.get("phase") == "plan" and owes_plan(old_run["id"], old_name)
    keeps_phase = mid_plan and not (args.model or args.effort)
    notes: list[str] = []
    if planned:
        effort = plan_effort_for(old["kind"])
        model, notes = plan_model(old["kind"], effort, run_id)
    else:
        model, effort = resumed_model(old, args.model, args.effort)
    view = getattr(args, "view", None) or old.get("view") or "pane"
    if view == "bg" and old["kind"] != "claude":
        raise MeshError("--view bg is for Claude workers; agy has no background sessions")
    named_bg, root = bool(getattr(args, "view", None)), current["agents"][current["root"]]
    view = background_view(view, named_bg, root, notes, "reopening in")  # before any side effect
    # A peer's worktree is detached: an adopted one's old run branch (still in that run's list) is long gone.
    branch = None if peer_name else entry_branch(old_run, old)
    taken = live_agent_names() | (set(current["agents"]) - ({old_name} if old_run["id"] == run_id else set()))
    name, n = old_name, 2
    while name in taken:
        name, n = f"{old_name[:29]}-{n}", n + 1
    if stored and name != old_name:
        raise MeshError(f"{old_name}'s name is taken by a live agent, and its {mtype} is in {old_name}'s mailbox: "
                        f"close that agent, then `mesh resume {old_name}`")

    if task or mtype == "task":  # new work; an answer, or a resume with no task, finishes what it was doing
        reserve_guard(run_id, old["kind"], model, effort, f"{old_name} again")
    reservation = memory_guard(f"{old_name} again")  # the last check before any side effect
    # Before the worktree and compaction steps, which can take minutes: a `mesh watch --any` waits for it.
    log_event(run_id, "resuming", name=old_name, from_run=old_run["id"])
    started.append({"name": old_name, "from_run": old_run["id"], "reservation": reservation})
    cwd, repo_top = old["cwd"], Path(old["repo"])
    if peer:  # its own detached worktree, which outlives runs: no branch, and no run's `mesh stop` removes it
        branch, recreated = None, ensure_peer_worktree({**peer, "cwd": cwd})
    else:
        recreated = ensure_worktree(old, branch)
    try:  # its worktree's settings, now that it's back, before a move to a new branch
        view = settings_view(view, named_bg, cwd, notes, "reopening in")
    except MeshError:
        if recreated:  # nothing owns it yet: take it back, keeping a branch with commits
            undoing_worktree(Path(peer["repo"]) if peer else repo_top, Path(cwd), branch, old.get("base"))
        raise
    moved = {} if peer else leave_finished_pr(args, run_id, old, branch, task)
    orphan = recreated and peer_name and not peer  # a removed peer's: no registry entry keeps it, so this run does
    if moved.get("note"):
        notes.append(moved["note"])
    if moved.get("task_note") and task:
        task = f"{task.rstrip()}\n\n{moved['task_note']}"
    branch, base_sha = moved.get("branch") or branch, moved.get("base") or old.get("base")
    with editing_run(run_id) as run:
        worktrees = run.setdefault("worktrees", [])
        known = next((w for w in worktrees if Path(w["path"]) == Path(cwd)), None)
        if known and moved.get("branch"):
            known.update(branch=branch, base=base_sha)
        elif branch and Path(cwd).resolve() != repo_top.resolve() and not known and not peer:
            # so this run's stop cleans it up (and drops the branch if it still has no commits)
            base = {"base": base_sha} if base_sha else {}
            worktrees.append({"path": cwd, "repo": str(repo_top), "branch": branch, **base})
        elif orphan and not known and Path(cwd).resolve() != repo_top.resolve():
            worktrees.append({"path": cwd, "repo": str(repo_top), "branch": None})  # detached: no branch to keep
    compaction = maybe_compact(args, old, session, model, task, cross_run=old_run["id"] != run_id,
                               peer=bool(peer_name))
    if compaction.get("note"):
        notes.append(compaction["note"])

    log = worker_log(run_id, name) if old["kind"] == "agy" else None
    env = mesh_env(run_id, name, me, "worker")
    # A question or a review is held by the deny list, and so is a task it plans first (a named model doesn't
    # skip the plan), until `mesh approve`; with no task, it carries on as it was: an asker still read-only, under
    # the list if it owes a plan. A direct task gets no list.
    read_only = old["kind"] == "claude" and (getattr(args, "read_only", False) or read_only_task(task)
                                             or bool(peer_name) or (not task and bool(old.get("read_only"))))
    planning = old["kind"] == "claude" and not read_only and (
        planned_task(task) if task else bool(old.get("planning") or mid_plan))
    deny = claude_deny({**old, "read_only": read_only, "planning": planning})
    exec_model = (old.get("exec_model") or exec_model_for(old["kind"])) if planned or keeps_phase else None
    exec_effort = (old.get("exec_effort") or exec_effort_for(old["kind"])) if planned or keeps_phase else None
    with editing_run(run_id) as run:
        run["agents"][name] = {
            "role": "worker", "kind": old["kind"], "model": model, "effort": effort, "base": base_sha,
            "size": old.get("size"), "view": view, "reviews": list(old.get("reviews") or []),
            "review_heads": dict(old.get("review_heads") or {}), "read_only": read_only, "planning": planning,
            **({"review_checkout": old["review_checkout"]} if old.get("review_checkout") else {}),
            "repo": str(repo_top), "cwd": cwd, "branch": branch, "session": session, "pane": None, "tab": None,
            "workspace": None, "parent": me, "status": "starting", "spawned": now_iso(),
            "resumed_from": {"run": old_run["id"], "name": old_name}, "log": log,
            "phase": "plan" if planned or keeps_phase else None, "exec_model": exec_model, "exec_effort": exec_effort,
            "pinned": bool(args.model or args.effort) or (not planned and bool(old.get("pinned"))),
            "models": [{"model": model, "effort": effort, "at": now_iso(), "why": "resume"}],
            **({"peer": peer_name} if peer_name else {}),
            **({"collect": args.collect} if getattr(args, "collect", None) else {}),
        }
    result = {"name": name, "view": view, "cwd": cwd, "branch": branch, "model": model,
              "resumed_from": {"run": old_run["id"], "name": old_name}, "worktree_recreated": recreated,
              "compaction": compaction, "notes": notes, **({"left_pr": moved["pr"]} if moved.get("pr") else {})}

    # The worktree and compaction steps may have outlasted the reservation: it counts from the launch.
    refresh_memory(started[-1].get("reservation"))
    if stored and moved.get("task_note"):  # the stored task can't take it: it goes as a message of its own
        record(run_id, me, name, "info", moved["task_note"])
    if view == "bg":
        # A copy of the conversation, so it gets this run's identity (see launch_bg); the task waits in its mailbox.
        path = stored or (record(run_id, me, name, "task", task) if task else None)
        prompt = doorbell_text(load_run(run_id), me, name, mtype, task or "", first=True)
        try:
            bg_id, new_session = launch_bg(name, cwd, model, effort, env, prompt, resume=session, extra=deny)
        except MeshError as exc:  # as in spawn_worker: the conversation reopens in a pane instead
            notes.append(f"{exc}; reopening in a pane instead")
        else:
            started[-1]["reservation"] = None  # it runs: its reservation stands
            with editing_run(run_id) as run:
                run["agents"][name].update(bg_id=bg_id, session=new_session, sessions=[session], status="running",
                                           inbound=WORKER_INBOUND)
            log_event(run_id, "resume", name=name, kind=old["kind"], model=model, view="bg", bg_id=bg_id, parent=me,
                      from_run=old_run["id"], from_name=old_name, session=new_session)
            result.update(bg_id=bg_id, session=new_session)
            if path:
                result["delivery"] = {"stored": str(path), "rung": False, "error": None, "launched": True}
            return result
    else:
        path = stored

    pane, tab, workspace_id, _ = place_pane(run_id, name, repo_top, Path(cwd), env, bool(peer_name))
    with editing_run(run_id) as run:
        run["agents"][name].update(view="pane", pane=pane, tab=tab, workspace=workspace_id)
    result["view"] = "pane"
    log_event(run_id, "resume", name=name, kind=old["kind"], model=model, pane=pane, parent=me,
              from_run=old_run["id"], from_name=old_name, session=session)

    started[-1]["reservation"] = None  # launching: its reservation stands
    started = start_agent(name, old["kind"], pane, [*log_argv(log), *deny, *resume_argv(old["kind"], session, model, effort),
                                                    *skip_flags(), *settings_argv(old["kind"], env)],
                          peer=bool(peer_name))
    with editing_run(run_id) as run:
        run["agents"][name]["status"] = "running"

    result.update(pane=pane, workspace=workspace_id, session=session)
    if started.get("held"):  # as in spawn_worker
        result["delivery"] = hold(run_id, me, name, mtype, task, started, stored=path)
    elif path:  # stored before: by the sender, or before a background launch that fell back to this pane
        token = ring_token()
        rang = ring_stored(run_id, me, name, [name, pane],
                           doorbell_text(load_run(run_id), me, name, mtype, task or "", True, token), token, path)
        result["delivery"] = {"stored": str(path), "rung": rang["rung"], "error": rang["error"], "via": rang["via"]}
    elif task:
        result["delivery"] = deliver(run_id, me, name, "task", task, first=True)
    return result


def cmd_open(args: argparse.Namespace) -> int:
    """Reopen a past worker's conversation in this terminal, outside any run, for the user.

    A background worker that is still running is attached to instead (`claude attach`): that is how the
    user watches one, or types into it, from any herdr pane.
    """
    _, _, name, entry = find_worker(args.ref, args.from_run)
    holder = live_holder(name, entry, agents=[]) if entry.get("view") == "bg" else None
    if holder and holder.get("bg_id"):
        print(f"mesh: attaching to {name}, a background session ({holder['bg_id']}); detaching leaves it running",
              file=sys.stderr)
        os.execvp(claude_bin(), [claude_bin(), "attach", holder["bg_id"]])

    def live_hint(name, entry):
        try:
            holder = live_holder(name, entry)
        except MeshError as exc:  # herdr can't be asked and there's no /proc (macOS outside herdr)
            print(f"mesh: can't tell whether {name} is still running ({exc}); make sure it isn't, or its "
                  "conversation will be open twice", file=sys.stderr)
            return None
        if holder:
            holder["hint"] = f"go there with `herdr agent focus {holder.get('name') or holder.get('pane_id')}`"
        return holder

    run, name, entry, session = resumable(args.ref, args.from_run, live_hint)
    model, effort = resumed_model(entry, args.model, args.effort)
    # As in resume_worker: a peer's worktree is detached, whatever branch an adopted one's old run still lists.
    peer_name, peer = worker_peer(name, entry)
    branch = None if peer_name else entry_branch(run, entry)
    recreated = ensure_peer_worktree({**peer, "cwd": entry["cwd"]}) if peer else ensure_worktree(entry, branch)
    extra = args.extra[1:] if args.extra[:1] == ["--"] else args.extra
    argv = [entry["kind"], *resume_argv(entry["kind"], session, model, effort), *extra]
    note = (f"; the worktree was recreated, remove it with `git worktree remove {entry['cwd']}` when done"
            if recreated and not peer else "")
    print(f"mesh: opening {name} from run {run['id']} ({entry['kind']} {model}) in {entry['cwd']}"
          f" on {branch or 'its checkout'}{note}", file=sys.stderr)
    env = {k: v for k, v in os.environ.items() if not k.startswith("MESH_")}
    os.chdir(entry["cwd"])
    os.execvpe(argv[0], argv, env)
    return 0  # not reached


# ── questions and reviews ────────────────────────────────────────────────


def pr_ref(review: str, repo: Path) -> tuple[str, int]:
    """A PR's link and number, from a link or from a number and the repo's GitHub remote."""
    match = PR_RE.search(review)
    if match:
        return match.group(0), int(match.group(0).rsplit("/", 1)[1])
    if not review.lstrip("#").isdigit():
        raise MeshError(f"--review takes a PR link or number, not {review}")
    try:
        remote = git("remote", "get-url", "origin", cwd=repo)
    except MeshError:
        remote = "none"
    github = GITHUB_REMOTE_RE.search(remote)
    if not github:
        raise MeshError(f"{repo}'s origin ({remote}) is not on GitHub; pass the PR link")
    number = int(review.lstrip("#"))
    return f"https://github.com/{github.group(1)}/{github.group(2)}/pull/{number}", number


def review_remote(repo: Path, pr: str) -> str:
    """The remote of `repo` a PR under review belongs to (`upstream` in a fork), refusing another repo's PR."""
    github_remotes = {}
    for remote in git("remote", cwd=repo).split():
        github = GITHUB_REMOTE_RE.search(git("remote", "get-url", remote, cwd=repo))
        if github:
            github_remotes[remote] = f"github.com/{github.group(1)}/{github.group(2)}/pull/".lower()
    remote = next((r for r, prefix in github_remotes.items() if prefix in pr.lower()), None)
    if not remote:
        if github_remotes:
            raise MeshError(f"{pr} is not a PR of {repo.name} (remotes: {', '.join(github_remotes)}); "
                            f"pass that PR's repo")
        remote = "origin"  # not on GitHub (a mirror, say): trust that it serves pull/<n>/head
    return remote


def fetch_commit(repo: Path, remote: str, src: str) -> str:
    """Fetch `src` from `remote` and return its commit, through a ref of this call's own (deleted after), not
    FETCH_HEAD: parallel asks on one clone (`/delegate-review`) would read each other's, and the user's too."""
    ref = f"refs/mesh/fetch/{os.getpid()}-{uuid.uuid4().hex[:8]}"
    git("fetch", "-q", "--no-write-fetch-head", remote, f"+{src}:{ref}", cwd=repo)
    try:
        return git("rev-parse", ref, cwd=repo)
    finally:
        git("update-ref", "-d", ref, cwd=repo)


def pr_head(repo: Path, pr: str, number: int) -> str:
    """Fetch a PR's head commit from the remote it belongs to (`review_remote`)."""
    return fetch_commit(repo, review_remote(repo, pr), f"pull/{number}/head")


ASK_SLUG_SKIP = {"a", "an", "and", "are", "can", "do", "does", "for", "how", "in", "is", "it", "of", "on", "the",
                 "to", "we", "what", "when", "where", "which", "who", "why", "with"}


def free_slug(run_id: str, repo_top: Path, slug: str) -> str:
    """`slug`, or `slug-2`, `-3`… when its run branch already exists (a retired asker keeps its branch), or
    another ask of this run has claimed it but not yet made the branch.

    A named one (`--name`) too, since `/delegate-review` always passes one. Picked and claimed under the run
    lock, so two asks of one kind for one PR started at the same moment get different slugs, and with them
    different agent names.
    """
    def taken(candidate: str, claimed: list[str]) -> bool:
        if candidate in claimed:
            return True
        try:
            git("rev-parse", "--verify", "--quiet", f"refs/heads/mesh/{run_id}/{candidate}", cwd=repo_top)
            return True
        except MeshError:
            return False
    slug = slugify(slug, 24)
    with editing_run(run_id) as run:
        claimed = run.setdefault("slugs", {}).setdefault(str(repo_top), [])
        found, n = slug, 2
        while taken(found, claimed):  # cut to fit `-N` in an agent name's suffix, so the name differs too
            found, n = f"{slug[:19 - len(str(n))].rstrip('-')}-{n}", n + 1
        claimed.append(found)
    return found


def ask_slug(body: str) -> str:
    """`ask-` plus the question's first telling words, within an agent name's 20-character suffix."""
    slug = "ask"
    for word in re.findall(r"[a-z0-9]+", body.lower()):
        if word in ASK_SLUG_SKIP:
            continue
        if len(slug) + 1 + len(word) > 20:
            break
        slug += f"-{word}"
    return slug


def head_diff(repo: Path, pr: str, head: str) -> tuple[str, str] | None:
    """`git diff` from the merge base with the PR's base branch (fetched from the PR's remote) to `head`, and that
    range (`<merge base>..<head>`); None when gh can't name the base branch, git can't fetch or diff it, or the
    diff is empty (the base already holds the head, as after a merge commit: then only gh still shows the PR)."""
    data, _ = gh_json(["pr", "view", pr, "--json", "baseRefName"])
    base_ref = data.get("baseRefName") if isinstance(data, dict) else None
    if not base_ref:
        return None
    try:
        base = fetch_commit(repo, review_remote(repo, pr), f"refs/heads/{base_ref}")
        merge_base = git("merge-base", base, head, cwd=repo)
        diff = git("diff", "--no-color", "--no-ext-diff", merge_base, head, cwd=repo) if merge_base != head else ""
    except (MeshError, OSError):
        return None
    return (diff, f"{merge_base}..{head}") if diff.strip() else None


def pr_diff(pr: str, head: str | None = None, built: tuple[str, str] | None = None) -> str:
    """The PR's diff for a review task, so the reviewer starts from the whole change; a note when it doesn't fit.

    Of the head the task names, from git (`built`, by `head_diff`), since `gh pr diff` shows the PR as it is now,
    which an author's push since may have moved past `head`; from `gh pr diff` without it (`head` is then only
    for that note)."""
    note = ""
    if built:
        diff, command = built[0], f"git diff {built[1]}"
    else:
        result = run_cli(["gh", "pr", "diff", pr], timeout=60)
        if result.returncode:
            return ""
        diff, command = result.stdout, f"gh pr diff {pr}"
        note = f", the PR as it is now, which may be past {head}" if head else ""
    if not diff.strip():
        return ""
    if len(diff) > REVIEW_DIFF_MAX:
        return f"The diff is too long to include here ({len(diff):,} characters): read it with `{command}`."
    return f"The change (`{command}`{note}):\n\n````diff\n{diff.rstrip()}\n````"


def ask_task(body: str, pr: str | None, number: int | None, fresh: bool, head: str | None = None,
             last: str | None = None, kind: str | None = None, narrow: bool = True, repo: Path | None = None,
             size: str | None = None) -> str:
    """The read-only task; a review names the head it is of, and `last`, the head this reviewer read before
    (`narrow`: the commits since are only fixes, see `fix_commits`). A Claude reviewer with the head is also asked
    to run `/code-review`, on the range from the merge base to `head`, which git resolves the same in a fork (a bare
    PR number is gh's guess at the repo: it stays only where the PR's remote is `origin`, else the PR's link). The
    embedded diff, and the command the task names for it, are of `head`, built in `repo` (`pr_diff`). `size` is
    the review's, which sets `/code-review`'s level (REVIEW_LEVEL; high when unknown)."""
    skill = ""
    built = head_diff(repo, pr, head) if pr and repo and head else None
    if pr:
        own = REVIEW_OWN_AT if head else REVIEW_OWN
        show = f"git diff {built[1]}" if built else f"gh pr diff {pr}"
        where = (REVIEW_FRESH if fresh else own).format(pr=pr, n=number, head=head, show=show)
        again = bool(last and head and last != head)
        if again:
            where += " " + (REVIEW_AGAIN if narrow else REVIEW_AGAIN_WHOLE).format(last=last, head=head)
        task = REVIEW_PREFIX.format(pr=pr, at=f" at {head}" if head else "", where=where)
        if kind == "claude" and head:
            whole = built[1] if built else number if pr_remote_is_origin(repo, pr) else pr
            skill = CODE_REVIEW.format(level=setting(f"review.level.{size if size in SIZES else 'large'}"), target=f"{last}..{head}" if again and narrow else whole)
            skill += (CODE_REVIEW_AGAIN if again and narrow else "")
            skill += "" if fresh else CODE_REVIEW_OWN.format(head=head)
    else:
        task = ASK_PREFIX
    diff = pr_diff(pr, head, built) if pr else ""
    return task + "".join(f"\n\n{part}" for part in (skill, body, diff) if part)


def pr_remote_is_origin(repo: Path | None, pr: str) -> bool:
    """Whether a bare PR number names `pr` to gh in `repo`: its remote is `origin` (not a fork's `upstream`)."""
    try:
        return bool(repo) and review_remote(repo, pr) == "origin"
    except (MeshError, OSError):
        return False


def fix_commits(repo: Path, last: str, head: str) -> bool:
    """Whether `last..head` holds only commits on top of what was reviewed: `last` is an ancestor of `head` and
    no merge came in between (a merged base would bring its changes along). False when git can't tell."""
    try:
        git("merge-base", "--is-ancestor", last, head, cwd=repo)
        return not git("rev-list", "--merges", f"{last}..{head}", cwd=repo)
    except (MeshError, OSError):
        return False


REVIEW_STAYS = ("Your worktree is still at {at}, not the new head, because {why}: read the new head with "
                "`git show {head}:<path>`.")


def plan_move(run_id: str, target: tuple, pr: str, head: str | None) -> tuple[dict | None, str]:
    """Whether a fresh reviewer asked again can be moved to the PR's head, as `ask --repo` started it: its run
    branch at the head, recorded as its `base`. Only its own review checkout of this PR (`review_checkout`, or
    for an older entry a `base` that is the head it last reviewed), still at that `base` (clean, no commits of its
    own), and not running mid-task in any run. Nothing is changed here (`apply_move`, after everything that can
    fail before the reach). (the move, or None; why not, for the task, empty when there's nothing to say). A move
    with no `git` is one already at the head: only its `base` is set."""
    old_run, _, name, entry = target
    cwd, repo, branch, base = entry.get("cwd"), entry.get("repo"), entry_branch(old_run, entry), entry.get("base")
    mine = entry.get("review_checkout") == pr or base == (entry.get("review_heads") or {}).get(pr)
    if (not head or not base or not mine or entry.get("peer") or not branch or not repo or not cwd
            or Path(cwd).resolve() == Path(repo).resolve()):
        return None, ""
    move = {"run": old_run["id"], "name": name, "cwd": cwd, "repo": repo, "branch": branch, "from": base,
            "to": head, "exists": Path(cwd).exists(), "git": base != head, "entry": entry}
    try:
        if move["exists"]:
            at = git("rev-parse", "HEAD", cwd=cwd)
            if at == head:
                return {**move, "git": False}, ""  # already there
            if at != base:
                return None, "it has moved off the head you last reviewed"
            if git("status", "--porcelain", cwd=cwd):
                return None, "it has uncommitted changes"
        else:  # stopped: `mesh stop` removed the clean worktree, and an untouched branch with it
            try:
                move["tip"] = git("rev-parse", "--verify", "--quiet", f"refs/heads/{branch}", cwd=repo)
            except MeshError:
                move["tip"] = None
            if move["tip"] and move["tip"] not in (base, head):
                return None, f"its branch {branch} has moved off the head you last reviewed"
            if move["tip"] == head or base == head:
                return {**move, "git": False}, ""
        holder = live_holder(name, entry)
    except (MeshError, OSError) as e:
        return None, f"mesh couldn't check it ({e})"
    if holder:  # a running agent mid-task could be reading the files a checkout changes
        if old_run["id"] != run_id or entry.get("status") == "retired":
            return None, f"you were still running in run {old_run['id']}"
        if agent_status(name, entry) not in ("idle", "done"):
            return None, "you were busy when this task was sent"
        report, received = last_report(read_log(run_id), name)
        if received and not (report and report.get("type") in FINAL_TYPES):  # a declared wait too
            return None, "you hadn't reported on your last task yet"
    return move, ""


def apply_move(move: dict, undo: bool = False) -> None:
    """Move the reviewer's checkout (`plan_move`) to its new head, or with `undo` back where it was."""
    at, other = (move["from"], move["to"]) if undo else (move["to"], move["from"])
    if move["git"] and move["exists"]:
        git("reset", "-q", "--keep", at, cwd=move["cwd"])
    elif move["git"] and move.get("tip"):
        git("branch", "-f", move["branch"], at, cwd=move["repo"])
    with editing_run(move["run"]) as run:  # so `mesh stop` still sees the branch untouched, and a resume uses it
        run["agents"][move["name"]]["base"] = at
        for wt in run.get("worktrees", []):
            if Path(wt["path"]) == Path(move["cwd"]) and wt.get("base") in (other, at):
                wt["base"] = at
    move["entry"]["base"] = at  # the entry ask_copilot reuses (resume_worker reads the run again)


def moving(move: dict | None, reach: Callable[[], object]) -> object:
    """`reach()` with the reviewer moved first (`apply_move`), and moved back if the reach refuses or fails, so
    a failed ask leaves its checkout and `base` as they were."""
    if move:
        apply_move(move)
    try:
        return reach()
    except BaseException:
        if move:
            apply_move(move, undo=True)
        raise


def record_review(run_id: str, name: str, pr: str, head: str | None, checkout: bool = False) -> None:
    """The PR in `reviews`, so `mesh resume <pr>` still finds the author, not the reviewer, and the head it
    read in `review_heads`, so asking it again names what changed since. `checkout`: a fresh reviewer, whose
    worktree is its review checkout of `pr` (`review_checkout`, which `plan_move` moves)."""
    with editing_run(run_id) as run:
        entry = run["agents"][name]
        if checkout:
            entry["review_checkout"] = pr
        reviews = entry.setdefault("reviews", [])
        if pr not in reviews:
            reviews.append(pr)
        if head:
            entry.setdefault("review_heads", {})[pr] = head


def take_reply(run_id: str, me: str, sender: str, folder: Path | None = None) -> tuple[dict, str] | None:
    """The last done/failed `sender` sent me, marked read. Found through the log, since the doorbell
    it rang may already have had me read it with `mesh inbox`. `folder`: the run's (default: live or archived)."""
    if folder is None:
        try:
            folder = run_folder(run_id)
        except MeshError:
            folder = run_dir(run_id)
    sends = [e for e in read_log(run_id, folder) if e.get("event") == "send" and e.get("sender") == sender
             and e.get("to") == me and e.get("type") in FINAL_TYPES]
    if not sends:
        return None
    folder = folder / "inbox" / me
    path = next((p for p in (folder / sends[-1]["file"], folder / "read" / sends[-1]["file"]) if p.exists()), None)
    if not path:
        return None
    meta, body = parse_message(path)
    if path.parent == folder:
        try:  # not with mark_read's parents: a live folder archived under it must not come back half-made
            (folder / "read").mkdir(exist_ok=True)
            os.replace(path, folder / "read" / path.name)
        except FileNotFoundError:
            pass  # archived meanwhile: the answer is in hand, unread in the archive
    return meta, body.strip()


def copilot_model_argv(model: str, effort: str) -> list[str]:
    # Auto picks the model per prompt and refuses an effort; it takes a routing profile instead.
    return ["--model", model, *(["--auto-tier", COPILOT_TIER] if model == "auto" else ["--reasoning-effort", effort])]


def json_events(lines: list[str]) -> list[dict]:
    """The events among Copilot's JSON lines (its output, or its session's events file), skipping any other line."""
    events = []
    for line in lines:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(event, dict):
            events.append(event)
    return events


def turn_answer(events: list[dict]) -> tuple[str, str | None]:
    """The last thing Copilot said in these events and the model it said it on."""
    text, model = "", None
    for event in events:
        data = event.get("data")
        if event.get("type") == "assistant.message" and isinstance(data, dict) and (data.get("content") or "").strip():
            text, model = data["content"].strip(), data.get("model") or model
    return text, model


def copilot_answer(stdout: str) -> tuple[str, str | None]:
    """The last thing Copilot said and the model it said it on, from its `--output-format json` lines."""
    return turn_answer(json_events(stdout.splitlines()))


@contextmanager
def signals_raise(*signums: int):
    """Turn these signals into SystemExit while inside, so `finally` and `except` clauses (run_cli's
    kill) run as they do on Ctrl-C; the previous handlers come back after. Outside the main thread, a no-op."""
    def interrupted(signum, frame):
        raise SystemExit(128 + signum)
    try:
        previous = {signum: signal.signal(signum, interrupted) for signum in signums}
    except ValueError:  # not the main thread
        previous = {}
    try:
        yield
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)


def copilot_ask(run_id: str, me: str, name: str, task: str, timeout: float) -> None:
    """Put one read-only task to a Copilot asker, headless, and file its answer as its `done` (or `failed`).

    The caller has marked the entry `running` with this process's pid (`claim_copilot`), and copilot's own
    pid joins it while it runs, in a session of its own: a killed `mesh ask` leaves it answering, live_holder
    then still finds it busy, and file_orphan files its answer once it exits. Every task goes
    under the session id recorded at spawn, which starts the session the first time and
    resumes it after, so the asker keeps what it read. The prompt goes on stdin: a review's diff can be
    larger than one command-line argument may be.
    """
    entry = agent_entry(load_run(run_id), name)
    mark_read(record(run_id, me, name, "task", task))  # kept as the record; it reaches Copilot as the prompt
    argv = ["copilot", "--output-format", "json", "--allow-all-tools", "--deny-tool", *COPILOT_DENY, "--no-ask-user",
            "--session-id", entry["session"], *copilot_model_argv(entry["requested_model"], entry["effort"])]
    log_event(run_id, "copilot", name=name)

    def started(pid: int) -> None:
        with editing_run(run_id) as run:
            run["agents"][name].update(copilot_pid=pid, copilot_pid_start=proc_start(pid))

    report = None
    try:
        # No mesh identity: it answers through its output, never with `mesh send`.
        with signals_raise(signal.SIGTERM, signal.SIGHUP):  # so a killed or hung-up `mesh ask` takes copilot with it
            result = run_cli(argv, cwd=entry["cwd"], env=env_without_identity(keep_herdr=False),
                             timeout=timeout or None, input=f"{task}\n\n{COPILOT_NOTE}", started=started)
        events = json_events(result.stdout.splitlines())
        text, model = turn_answer(events)
        quota = copilot_quota_error(events)
        if quota:  # a monthly quota: no auto round picks Copilot until it may have reset (copilot_limit)
            note_copilot_limit(quota)
            report = ("failed", f"Copilot is over its quota: {quota}. mesh leaves it out of `--reviewers auto` "
                                f"for {COPILOT_LIMIT_HOLD // 3600} h", None)
        elif text and result.returncode == 0:
            report = ("done", text, model)
        elif result.returncode == 0:
            report = ("failed", "copilot gave no answer (exit 0)", None)
        else:
            error = result.stderr.strip().splitlines()[-1:] or [f"exit {result.returncode}"]
            report = ("failed", f"copilot exited {result.returncode}: {error[0]}", None)
    finally:
        # Ctrl-C, a SIGTERM or a hang-up stopped it (run_cli killed copilot): say so now, not as an orphan later.
        report = report or ("failed", "interrupted: its `mesh ask` was stopped before copilot answered", None)
        # The answer is filed while the entry still counts as working, so a `mesh watch` on it sees the report.
        with editing_run(run_id) as run:
            release_copilot(run_id, run, name, lambda agent, asked: report)


def release_copilot(run_id: str, run: dict, name: str,
                    report: Callable[[dict, str], tuple[str, str, str | None]]) -> str | None:
    """Release a Copilot asker (`run` held with editing_run), filing first the report it owes on its last task:
    `report(entry, task)` gives it as (type, body, model). Nothing is filed when that task has its report already
    (a `mesh ask` killed between filing and releasing), or when there is none (killed before recording it).
    The type filed, or None."""
    agent = run["agents"][name]
    last, received = last_report(read_log(run_id), name)
    filed = None
    if received and received.get("type") == "task" and not (last and last.get("type") in FINAL_TYPES):
        filed, body, model = report(agent, message_body(run_id, received))
        record(run_id, name, received["sender"], filed, body)
        agent["model"] = model or agent["model"]
    agent["status"] = "retired"
    for key in CLAIM_KEYS:
        agent.pop(key, None)
    return filed


def copilot_turn(entry: dict, task: str) -> tuple[str, str, str | None]:
    """The report copilot_ask would have filed for `task`, read back from the asker's session events once copilot
    has exited: (type, body, model). Copilot writes each ask there as a `user.message` holding the prompt mesh
    piped in, then the turn's events, then `session.shutdown` when it exits on its own (none when it is killed).
    Only what it wrote since the claim counts (`events`, `events_from`), and only its last ask, so an earlier
    turn asking the same is never taken for this one."""
    path = Path(entry["events"]) if entry.get("events") else copilot_events(entry)
    try:
        with path.open("rb") as f:
            f.seek(entry.get("events_from") or 0)
            events = json_events(f.read().decode(errors="replace").splitlines())
    except OSError:
        events = []
    asked = [i for i, e in enumerate(events) if e.get("type") == "user.message"]
    data = events[asked[-1]].get("data") if asked else None
    if not (isinstance(data, dict) and str(data.get("content") or "").lstrip().startswith(task.strip())):
        return "failed", "copilot never got the task: its `mesh ask` was killed", None
    turn = events[asked[-1] + 1:]
    end = next((i for i, e in enumerate(turn) if e.get("type") == "session.shutdown"), None)
    if end is None:
        return "failed", "copilot stopped before it finished answering: its `mesh ask` was killed", None
    text, model = turn_answer(turn[:end])
    if not text:
        return "failed", "copilot gave no answer (exit 0)", None
    return "done", text, model


def orphaned(name: str, entry: dict) -> bool:
    """A Copilot asker still marked `running` whose `mesh ask` and copilot are both gone."""
    return entry.get("view") == "headless" and entry.get("status") == "running" and not live_holder(name, entry)


def file_orphan(run_id: str, name: str) -> str | None:
    """File the report a Copilot asker owes when a SIGKILLed `mesh ask` left copilot answering and copilot has
    exited since (copilot_turn), and release the asker as copilot_ask would. Under the run lock, and only while the
    entry is still `running` with neither process alive, so whoever finds it first (the next ask, a watch, the
    root's inbox, stop) files it, once. The type filed, or None."""
    entry = (maybe_run(run_id) or {}).get("agents", {}).get(name)  # None once archived
    if not entry or not orphaned(name, entry):
        return None  # checked without the lock first: a watch asks on every poll
    with editing_run(run_id) as run:
        if not orphaned(name, run["agents"][name]):
            return None
        filed = release_copilot(run_id, run, name, copilot_turn)
    if filed:
        log_event(run_id, "copilot_filed", name=name, type=filed)
        print(f"mesh: filed {name}'s `{filed}` from its Copilot session, which a killed `mesh ask` left answering "
              "(`mesh inbox` shows it)", file=sys.stderr)
    return filed


def file_orphans(run_id: str, parent: str | None = None) -> None:
    """file_orphan for each Copilot asker of the run (of `parent`'s only, when given) that may be one."""
    for name, entry in (maybe_run(run_id) or {}).get("agents", {}).items():
        if entry.get("view") == "headless" and entry.get("status") == "running" \
                and (parent is None or entry.get("parent") == parent):
            file_orphan(run_id, name)


def refuse_busy(name: str, entry: dict) -> None:
    holder = live_holder(name, entry)
    if holder and holder.get("pid"):
        raise MeshError(f"{name} is still answering in {holder['answering']} {holder['pid']}; "
                        "ask it again once that finishes")


def claim_copilot(entry: dict) -> None:
    """Mark a Copilot asker busy for this `mesh ask` (see live_holder); copilot_ask releases it. Its session's
    events file and where it ends now are recorded too, so whoever files the answer of a copilot this `mesh ask`
    leaves (file_orphan) reads the file it writes, and only this ask in it (copilot_turn)."""
    for key in CLAIM_KEYS:
        entry.pop(key, None)  # a copilot a killed `mesh ask` left is gone by now (refuse_busy), its answer filed
    events = copilot_events(entry)
    try:
        size = events.stat().st_size
    except OSError:
        size = 0  # a session copilot hasn't started yet
    entry.update(status="running", pid=os.getpid(), pid_start=proc_start(os.getpid()), events=str(events),
                 events_from=size)


def open_peek(run_id: str, name: str, cwd: Path) -> str | None:
    """A pane beside the root that follows a Copilot asker (`mesh peek --follow`), so the user sees it work.

    Only beside the root, where the user is looking; None when that tab is full or gone, or herdr refuses.
    """
    if stale := agent_entry(load_run(run_id), name).get("pane"):  # left by a `mesh ask` that was killed
        close_peek(run_id, name, stale)
    env = {key: os.environ[key] for key in ("MESH_HOME", "COPILOT_HOME") if os.environ.get(key)}
    try:
        beside = beside_root(run_id, name, cwd, env)
    except MeshError:
        return None
    if not beside:
        return None
    pane, tab, workspace = beside
    try:
        herdr("pane", "rename", pane, f"{name} (Copilot)")
        herdr("pane", "run", pane, shlex.join(["mesh", "peek", name, "--from-run", run_id, "--follow"]))
    except MeshError:
        close_peek(run_id, name, pane)
        return None
    with editing_run(run_id) as run:
        run["agents"][name].update(pane=pane, tab=tab, workspace=workspace)
    return pane


def close_peek(run_id: str, name: str, pane: str) -> None:
    try:
        herdr("pane", "close", pane)
    except MeshError:
        pass  # the user closed it already
    with editing_run(run_id) as run:
        run["agents"][name].update(pane=None, tab=None, workspace=None)


def ask_copilot(args: argparse.Namespace, run_id: str, me: str, repo: Path, target, task: str,
                pr: str | None, number: int | None, base: str | None, body: str, head: str | None = None) -> int:
    """`mesh ask` for Copilot: no pane and no doorbell, the answer is what `copilot` prints (copilot_ask)."""
    ignored = [flag for flag, on in (("--keep", args.keep), ("--no-wait", args.no_wait), ("--wait", args.wait),
                                     ("--view", args.view), ("--compact", args.compact != "auto"),
                                     ("--focus", args.focus)) if on]
    if ignored:
        print(f"mesh: {', '.join(ignored)} don't apply to a headless Copilot asker", file=sys.stderr)
    name, how = copilot_asker(args, run_id, me, repo, target, pr, number, base, body, head)
    peek = open_peek(run_id, name, Path(agent_entry(load_run(run_id), name)["cwd"]))
    follow = f"in pane {peek}" if peek else f"with `mesh peek {name} --follow`"
    print(f"mesh: {how} {name} (Copilot, headless); waiting for its answer (follow it {follow})", file=sys.stderr)
    try:
        copilot_ask(run_id, me, name, task, args.timeout)
    finally:
        if peek:
            close_peek(run_id, name, peek)
    meta, text = take_reply(run_id, me, name)
    print(f"── {meta.get('type')} from {name} ──\n{quoted_body(text)}\n")
    print(f"(ask again: `mesh ask {name} --body …`, which resumes its Copilot session)")
    return 0 if meta.get("type") == "done" else 1


def copilot_asker(args: argparse.Namespace, run_id: str, me: str, repo: Path, target, pr: str | None,
                  number: int | None, base: str | None, body: str, head: str | None = None) -> tuple[str, str]:
    """The Copilot asker `mesh ask` puts its task to, claimed for this process (claim_copilot): `target` brought
    into this run, or a fresh one in its own worktree. (name, how: "asked" or "started")."""
    if target:
        old_run, _, old_name, old = target
        file_orphan(old_run["id"], old_name)  # its last answer first, so this one isn't taken for it
        old = agent_entry(load_run(old_run["id"]), old_name)
        if old_run["id"] != run_id:
            refuse_busy(old_name, old)
        branch = entry_branch(old_run, old)
        ensure_worktree(old, branch)
        name = old_name
        with editing_run(run_id) as run:
            if old_run["id"] != run_id:
                # A Copilot asker from an earlier run comes back as this run's, as `mesh resume` brings a worker.
                taken, n = set(run["agents"]) | live_agent_names(), 2
                while name in taken:
                    name, n = f"{old_name[:29]}-{n}", n + 1
                run["agents"][name] = {**old, "parent": me, "resumed_from": {"run": old_run["id"], "name": old_name}}
                worktrees = run.setdefault("worktrees", [])
                if branch and not any(Path(w["path"]) == Path(old["cwd"]) for w in worktrees):
                    base_sha = {"base": old["base"]} if old.get("base") else {}
                    worktrees.append({"path": old["cwd"], "repo": old["repo"], "branch": branch, **base_sha})
            else:
                refuse_busy(name, run["agents"][name])  # checked and claimed under one lock (below)
            if args.model or args.effort:
                run["agents"][name].update(requested_model=args.model or old["requested_model"],
                                           effort=args.effort or old["effort"])
            claim_copilot(run["agents"][name])
        how = "asked"
    else:
        taken = set(load_run(run_id)["agents"]) | live_agent_names()
        slug = free_slug(run_id, repo, args.name or (f"review-{number}-copilot" if pr else ask_slug(body)))
        name = agent_name(repo.name, slug, taken)
        cwd, branch, base = add_worktree(run_id, repo, slugify(slug, 24), base)
        model = args.model or setting("copilot_model")
        size = args.size or "small"
        effort = args.effort or COPILOT_EFFORT[size]
        with editing_run(run_id) as run:
            run["agents"][name] = {
                "role": "worker", "kind": "copilot", "model": model, "requested_model": model, "effort": effort,
                "size": size, "view": "headless", "repo": str(repo), "cwd": str(cwd), "branch": branch,
                "base": base, "session": str(uuid.uuid4()), "pane": None, "tab": None, "workspace": None,
                "parent": me, "status": "starting", "spawned": now_iso(), "log": None, "phase": None,
                "models": [{"model": model, "effort": effort, "at": now_iso(), "why": "spawn"}],
            }
            claim_copilot(run["agents"][name])
        log_event(run_id, "spawn", name=name, kind="copilot", role="worker", model=model, view="headless", parent=me)
        how = "started"
    if pr:
        record_review(run_id, name, pr, head, checkout=how == "started")
    return name, how


def copilot_events(entry: dict) -> Path:
    """The file Copilot writes every event of an asker's session to."""
    home = Path(os.environ.get("COPILOT_HOME") or Path.home() / ".copilot")
    return home / "session-state" / entry["session"] / "events.jsonl"


def peek_line(line: str) -> str | None:
    """One Copilot event as a line of `mesh peek`: a tool it started, or something it said."""
    try:
        event = json.loads(line)
    except json.JSONDecodeError:
        return None
    if not isinstance(event, dict) or not isinstance(event.get("data"), dict):
        return None
    data, at = event["data"], str(event.get("timestamp") or "")[11:19]
    if event.get("type") == "tool.execution_start":
        args = data.get("arguments") if isinstance(data.get("arguments"), dict) else {}
        what = next((args[k] for k in ("description", "command", "path", "pattern") if args.get(k)), "")
        return f"{at} {data.get('toolName')}: {first_line(str(what), 140)}"
    if event.get("type") == "assistant.message" and (data.get("content") or "").strip():
        return f"{at} says: {first_line(data['content'], 140)}"
    return None


def cmd_peek(args: argparse.Namespace) -> int:
    """Show what a Copilot asker is doing, from its session's events, since it has no pane to look at."""
    _, folder, name, entry = find_worker(args.ref, args.from_run)
    if entry.get("kind") != "copilot":
        look = f"`claude attach {entry['bg_id']}`" if entry.get("bg_id") else f"`herdr agent read {name}`"
        raise MeshError(f"{name} is a {entry.get('kind')} worker; look at it with {look}")
    path = copilot_events(entry)
    while args.follow and not path.exists() and agent_status(name, entry) == "working":
        time.sleep(1)  # Copilot writes the file once the session starts
        entry = json.loads((folder / "run.json").read_text())["agents"][name]
    if not path.exists():
        raise MeshError(f"{name} has no Copilot session yet ({path})")
    with path.open() as f:
        lines = [shown for shown in map(peek_line, f) if shown]
        offset = f.tell()
    for shown in lines[-args.lines:]:
        print(shown)
    if not args.follow:
        return 0
    pending = ""  # a line Copilot is still writing
    while True:
        with path.open() as f:
            f.seek(offset)
            pending += f.read()
            offset = f.tell()
        *complete, pending = pending.split("\n")
        for shown in map(peek_line, complete):
            if shown:
                print(shown, flush=True)
        entry = json.loads((folder / "run.json").read_text())["agents"][name]
        if agent_status(name, entry) != "working":
            print(f"({name} is not answering now: its answer is what `mesh ask` printed, or `mesh inbox`)")
            return 0
        time.sleep(1)


def ask_identity(args: argparse.Namespace, body: str, mode: str | None) -> tuple[str, str]:
    """The asking root, with a run started for it when there is none (`mode` None: the root's own)."""
    try:
        run_id, me = identity(args)
    except MeshError as err:
        if getattr(args, "run", None) or isinstance(err, PaneRefused):
            raise
        started = init_run(mode, (body.splitlines() or ["a question"])[0][:200])
        run_id, me = started["run"], started["name"]
        print(f"mesh: started run {run_id}", file=sys.stderr)
    if agent_entry(load_run(run_id), me)["role"] != "root":
        raise MeshError("only the root asks: a worker sends its parent a `question` instead")
    return run_id, me


def not_live(target: tuple | None) -> bool:
    """Whether asking a worker `find_worker` / `peer_worker` gave (None: none yet) will start an agent: it has
    none, or it is retired or in an archived run. Read from the record alone, before the asking run is known."""
    return not target or target[3].get("status") == "retired" or target[1].parent.name == "archive"


def reach_worker(args: argparse.Namespace, run_id: str, me: str, target: tuple, task: str, gist: str,
                 peer: str | None = None, collect: dict | None = None,
                 events: list[dict] | None = None, state: str | None = None) -> tuple[dict, int, str]:
    """Give a worker `ask` found its read-only task: send it to a live one, else resume it. (result, its count of
    final sends before the task, how: "asked" or "resumed"). `events` (the target's run log) and `state` (its
    asker_status, given only for a worker open in this run), when the caller has read them."""
    old_run, folder, name, entry = target
    if state is None:
        state = (asker_status(name, entry) if old_run["id"] == run_id and entry.get("status") != "retired"
                 else "gone")
    events = read_log(old_run["id"], folder) if events is None else events
    # It owes a reply to an earlier task: its next `done` must be this answer. Not while it works on that one.
    if state != "working" and owes_report(events, name):
        task = f"{task.rstrip()}\n\n{UNANSWERED_NOTE}"
    if state != "gone":
        finals = sends_from(run_id, name, FINAL_TYPES)
        if state == "working" and not args.no_wait:
            # Its next `done` would be for the task it's on, not this question.
            print(f"mesh: {name} is busy, so its answer will come after its current task", file=sys.stderr)
            args.no_wait = True
        if not collect and collecting(entry, me):
            raise MeshError(f"{name} is answering a `mesh ask --peers` (process {entry['collect']['pid']}), which "
                            "collects its answer: ask it again once that has finished")
        with editing_run(run_id) as run:  # a single ask clears a stale mark, so its answer rings as usual
            if collect:
                run["agents"][name]["collect"] = collect
            else:
                run["agents"][name].pop("collect", None)
        delivery = deliver(run_id, me, name, "task", task)
        if delivery.get("retiring"):  # no answer can come: say what to do instead of waiting for one
            raise MeshError(delivery["error"])
        if not delivery.get("retired"):
            return {"name": name, "delivery": delivery}, finals, "asked"
        stored = Path(delivery["stored"])  # retired since its state was read (auto-retire): resume it for that
    else:
        stored = None
        # Counted before the task goes out, so a quick answer still counts (a same-run resume keeps the name).
        finals = sends_from(run_id, name, FINAL_TYPES) if old_run["id"] == run_id else 0
    # A peer compacts with PEER_FOCUS (maybe_compact) unless the root named a focus; a removed one too.
    focus = args.focus or (None if peer or entry.get("peer") else COMPACT_FOCUS.format(task=gist))
    resume = argparse.Namespace(ref=name, from_run=old_run["id"], model=args.model, effort=args.effort,
                                task=task, task_file=None, view=args.view, compact=args.compact,
                                focus=focus, read_only=True, peer=peer, collect=collect,
                                stored=(stored, "task") if stored else None)
    result = resume_worker(resume, run_id, me)
    return result, finals if result["name"] == name else 0, "resumed"


def spawn_peer(args: argparse.Namespace, run_id: str, me: str, name: str, peer: dict, task: str,
               collect: dict | None = None) -> dict:
    """A peer's first asker: a fresh worker in the peer's own worktree, under the peer's name."""
    spawn = argparse.Namespace(
        kind=peer.get("kind") or "claude", role="worker", repo=peer["repo"], model=args.model, exec_model=None,
        effort=args.effort, exec_effort=None, name=None, agent=name, worktree=None, cwd=peer["cwd"], base=None,
        parent=None, task=task, task_file=None, size=args.size, view=args.view, plan_review=None,
        pinned=bool((args.model and args.model != "auto") or args.effort), peer=name, collect=collect)
    return spawn_worker(spawn, run_id, me)


def asker_task(args: argparse.Namespace, run_id: str, repo: Path, target: tuple | None, kind: str, body: str,
               pr: str | None, number: int | None, head: str | None, last: str | None) -> tuple[str, dict | None, str]:
    """The read-only task for one asker, the move of its review checkout to `head` (plan_move; None when it
    stays or has none) and the body with a note on why it stays, for `mesh ask` and a review round alike."""
    narrow = not (last and head and last != head) or fix_commits(repo, last, head)
    move, stays = plan_move(run_id, target, pr, head) if pr and target else (None, "")
    if stays:
        at = target[3].get("base")
        print(f"mesh: {target[2]}'s worktree stays at {at} ({stays})", file=sys.stderr)
        body = "\n\n".join(part for part in (body, REVIEW_STAYS.format(at=at, head=head, why=stays)) if part)
    size = args.size or (target[3].get("size") if target else None)
    task = ask_task(body, pr, number, fresh=bool(args.repo) or bool(move), head=head, last=last, kind=kind,
                    narrow=narrow, repo=repo, size=size)
    return task, move, body


def fresh_asker(args: argparse.Namespace, run_id: str, me: str, repo: Path, kind: str, task: str, body: str,
                pr: str | None, number: int | None, base: str | None, collect: dict | None = None) -> dict:
    """A fresh Claude or agy asker in `repo` (a reviewer: a pane at the PR head, at REVIEW_EFFORT when its
    size has no plan phase), spawned with its task; `collect` marks it for a fan-out."""
    slug = free_slug(run_id, repo, args.name or (f"review-{number}-{kind}" if pr else ask_slug(body)))
    # A large reviewer already plans at DEFAULT_EFFORT; passing REVIEW_EFFORT there would read as a named
    # effort and carry into the execution phase of a fix it is later given.
    sized = size_policy(kind, args.size or "large") is not None
    spawn = argparse.Namespace(
        kind=kind, role="worker", repo=str(repo), model=args.model,
        exec_model=None, effort=args.effort or (setting("review.effort") if pr and sized else None), exec_effort=None,
        name=args.name and slug, worktree=slug,  # a taken --name gets the same -2 as its branch
        cwd=None, base=base, parent=None, task=task, task_file=None, size=args.size,
        view=args.view or ("pane" if pr else None), plan_review=None,  # the user watches a review
        pinned=bool((args.model and args.model != "auto") or args.effort), collect=collect)
    return spawn_worker(spawn, run_id, me)


def cmd_ask(args: argparse.Namespace) -> int:
    """Ask a worker, or a fresh agent in a repo, a question or for a PR review, and wait for the answer."""
    if getattr(args, "peers", None):
        return ask_peers(args)
    if getattr(args, "reviewers", None):
        return ask_reviewers(args)
    if bool(args.ref) == bool(args.repo):
        raise MeshError("ask whom? pass a worker (name, branch or PR link, see `mesh agents`), --repo for a fresh "
                        "agent, or --peers for the peer askers")
    if args.kind and args.ref:
        raise MeshError("--kind is for a fresh agent (--repo); a worker keeps its own CLI")
    copilot = args.kind == "copilot"
    if args.kind:
        require_cli(args.kind, f"`--kind {args.kind}`")
    body = (read_body(args.body, args.file) or "").strip()
    if not body and not args.review:
        raise MeshError("empty question: pass --body TEXT or --file PATH (- for stdin), or --review PR")

    # Resolve everything that can fail before anything is started.
    target = peer = prep = None
    if args.repo:
        repo = resolve_repo(args.repo)
    elif args.ref in load_peers()["peers"]:
        peer = load_peers()["peers"][args.ref]
        refuse_unaskable_peer(args.ref, peer)
        if args.review:
            raise MeshError(f"{args.ref} is a peer asker, which answers questions about its project; a review goes "
                            "to a reviewer (`mesh ask --repo <path> --review <PR>`)")
        target, repo = peer_worker(args.ref, peer), Path(peer["repo"])
    else:
        target = find_worker(args.ref)
        repo = Path(target[3]["repo"]) if target[3].get("repo") else Path.cwd()
        copilot = target[3].get("kind") == "copilot"
        cwd = target[3].get("cwd")
        if cwd and not Path(cwd).exists() and not repo.is_dir():  # nothing to recreate its worktree from
            raise gone_clone(cwd, repo)
    pr, number = pr_ref(args.review, repo) if args.review else (None, None)
    head = last = None
    if pr and args.repo:
        head = pr_head(repo, pr, number)  # what the fresh reviewer's worktree starts at
    elif pr:
        try:  # into the shared object store, so the worker can read it; a review without it still goes out
            head = pr_head(repo, pr, number) if target[3].get("repo") else None
        except (MeshError, OSError):
            pass
        last = (target[3].get("review_heads") or {}).get(pr)
    gist = first_line(body) or f"a review of {pr}"
    # Sure (or, for a worker that isn't live, likely) to start an agent: refuse before a run is made.
    if args.repo or copilot or (peer and not target) or (target and not_live(target)):
        memory_guard(args.ref or f"an asker in {repo.name}", reserve=False)
    # The reserve, before a run is made (a fresh agy agent is checked again by its spawn, once its model is known).
    # A peer's registry entry records no model, so an agy peer's model is checked when its resume picks one.
    own_run = (quietly(identity, args) or (None,))[0]
    if target and not copilot:
        reserve_guard(own_run, target[3].get("kind"), target[3].get("model"), target[3].get("effort"),
                      f"a question for {target[2]}")
    elif peer:
        reserve_guard(own_run, peer.get("kind") or "claude", peer.get("model"), None, f"a question for {args.ref}")
    elif not copilot and (args.kind or ((maybe_run(own_run) or {}).get("mode") if own_run else None)) == "claude":
        reserve_guard(own_run, "claude", args.model if args.model not in (None, "auto") else plan_chain("claude")[0],
                      args.effort, f"an asker in {repo.name}")
    # a Copilot asker's run is in the root's own mode
    run_id, me = ask_identity(args, body or f"review {pr}", None if copilot else args.kind or default_kind())
    if peer:  # only once the caller is known to be a root: it fetches and moves the peer's checkout
        prep = prepare_peer(args.ref, peer, refresh=not args.no_refresh)
        body = f"{body}\n\n{prep['note']}"
    # A worker keeps its CLI; a fresh agent is of --kind, else the run's mode.
    kind = "copilot" if copilot else ((target[3].get("kind") if target else None) or args.kind
                                      or load_run(run_id)["mode"])
    task, move, body = asker_task(args, run_id, repo, target, kind, body, pr, number, head, last)
    base = head if args.repo else None
    if copilot:  # it starts a copilot process either way, which is gone once it has answered
        reservation = memory_guard(target[2] if target else f"a Copilot asker in {repo.name}")
        try:
            return moving(move, lambda: ask_copilot(args, run_id, me, repo, target, task, pr, number, base, body,
                                                    head))
        finally:
            release_memory([reservation])

    if args.repo:
        result, finals, how = fresh_asker(args, run_id, me, repo, kind, task, body, pr, number, base), 0, "started"
    elif peer and not target:
        result, finals, how = spawn_peer(args, run_id, me, args.ref, peer, task), 0, "started"
    else:
        result, finals, how = moving(move, lambda: reach_worker(args, run_id, me, target, task, gist,
                                                                peer=args.ref if peer else None))
    name = result["name"]
    if pr:
        record_review(run_id, name, pr, head, checkout=bool(args.repo))
    if peer:
        record_peer_ask(args.ref, prep, run_id, name)

    delivery = result.get("delivery") or {}
    if "send_message" in delivery:  # a background worker launched before mesh started workers accepting
        emit(result)
        warn_unwatched(run_id)
        back = ("comes back as a cross-session message" if native_route(load_run(run_id), name, me)
                else "is typed into your pane")
        # Not even with --wait: a watch would block the caller, who has to pass the SendMessage on first.
        print(f"mesh: stored; now send it to {name} with SendMessage (`to` and `message` as in send_message). "
              f"Its answer {back}" + (f"; to wait for it, `mesh watch {name}` after that." if args.wait else "."),
              file=sys.stderr)
        return 0
    if delivery.get("held"):  # only the user can clear it: say so now rather than wait silently
        emit(result)
        status = report_held(name, delivery)
        print(f"mesh: `mesh watch {name}` rings it once the screen is gone, and waits for its answer", file=sys.stderr)
        return status
    if not delivered(delivery):
        emit(result)
        print(f"warning: stored, but the doorbell did not ring ({delivery.get('error')}); "
              f"retry with `mesh ring {name}`, then `mesh watch {name}`", file=sys.stderr)
        return 2
    entry = agent_entry(load_run(run_id), name)
    if (not args.wait and entry.get("kind") == "claude"
            and native_route(load_run(run_id), name, me)):  # its answer reaches this session as a cross-session message
        args.no_wait = True
    warn_unwatched(run_id, skip=() if args.no_wait else (name,))  # without --no-wait this call watches it
    if args.no_wait:
        emit(result)
        return 0
    print(f"mesh: {how} {name}; waiting for its answer", file=sys.stderr)
    status, line = watch_agent(run_id, name, args.timeout, finals_at_start=finals)
    reply = take_reply(run_id, me, name) if status == 0 else None
    if not reply:
        print(line)
        return 1 if status == 0 and line == stopped_line(run_id) else status  # stopped with no answer: no success
    meta, text = reply
    print(f"── {meta.get('type')} from {name} ──\n{quoted_body(text)}\n")
    is_peer = bool(peer) or bool(entry.get("peer"))  # a removed peer's conversation is still a peer's
    change = (f"a change to that project goes to a worker there (`mesh spawn --repo {repo}`)" if is_peer
              else f"give it a change with `mesh resume {name} --task-file …`")
    if how != "asked" and not args.keep:  # an asker this call opened is done; one already at work stays
        try:
            retire_worker(run_id, name, agent_entry(load_run(run_id), name))
        except (MeshError, OSError) as exc:  # the answer is in: closing it is housekeeping
            print(f"warning: couldn't close {name} ({exc}); `mesh retire {name}` when you're done with it",
                  file=sys.stderr)
        else:
            print(f"({name} is closed. Ask again with `mesh ask {name} --body …`, which reopens its conversation; "
                  f"{change})")
    else:
        print(f"(ask again: `mesh ask {name} --body …`; "
              + (change if is_peer else f"give it a change to make: `mesh send {name} --type task`") + ")")
    return 0


def watch_each(run_id: str, finals: dict[str, int], timeout: float = 0, interval: float = 5.0,
               grace: float = SETTLE_GRACE, on_outcome: Callable[[str, int, str], None] | None = None,
               held_for: float | None = None) -> dict[str, tuple[int, str]]:
    """watch_agents for a fan-out: every name gets its own outcome, (0, …) for a done/failed or the watch's
    alert (3-8), and the rest are watched on. A plan or question it sends instead ends its watch too (3), as
    does the timeout (6). `finals` is each one's count of final sends before its task was delivered.

    A watch stays quiet while its worker is held at a startup screen (`release_held`: the root was told at the
    start), so one still at it `held_for` seconds (held_wait()) after its hold gets its own exit 4 instead of
    keeping the others' answers waiting until the timeout. A worker given up on (any outcome but an answer) is
    let go at once: its watch lock closes and its `collect` mark goes, so what it sends later rings as usual
    and the root is told it's unwatched.

    A `mesh stop` under way holds the ticks (the panes it closes would read as alerts), though an answer still
    counts, until it ends: archived, each one left gets its answer from the archive or (1, …), and the run is
    left alone (`fan_out` reads the archive); failed, watching goes on, and an alert held back meanwhile comes."""
    hang = hang_after()
    held_for = held_wait() if held_for is None else held_for
    watches = {name: Watch(run_id, name, grace, count, hang) for name, count in finals.items()}
    outcomes: dict[str, tuple[int, str]] = {}
    deadline = time.monotonic() + timeout if timeout else None

    def decide(name: str, outcome: tuple[int, str]) -> None:
        outcomes[name] = outcome
        watches.pop(name)
        if outcome[0]:
            held.pop(name).close()
            try:
                with editing_run(run_id) as data:
                    if name in data["agents"]:
                        data["agents"][name].pop("collect", None)
            except FileNotFoundError:  # archived: the mark dies with this process's pid
                if not run_stopped(run_id):
                    raise
        if on_outcome:
            on_outcome(name, *outcome)

    def stopped() -> None:
        archived = read_log(run_id, run_folder(run_id))
        for name, watch in list(watches.items()):
            answered = watch.report_event(archived, False)
            outcomes[name] = answered or (1, f"run {run_id} stopped before {name} answered")
            watches.pop(name)

    kept: dict[str, tuple[int, str]] = {}  # alerts a stop that began mid-poll held back, for if it fails

    held = dict(zip(watches, hold_watch(run_id, list(watches))))
    try:
        while watches:
            if run_stopped(run_id):
                stopped()
                break
            try:
                run = load_run(run_id)
                events = read_log(run_id)
                agents = {}
                if stop_under_way(events):  # only answers, from the log
                    ticked = {name: watch.report_event(events, False) for name, watch in watches.items()}
                else:
                    bg_rows = claude_agents() if any(run["agents"].get(n, {}).get("view") == "bg" for n in watches) else None
                    ticked = {name: watch.tick(interval, False, bg_rows, events) for name, watch in watches.items()}
                    agents = load_run(run_id)["agents"]  # after the ticks, which may release a hold
                    # a stop that held these back has failed: what they alerted on has been alerted on once
                    ticked.update({n: kept.pop(n) for n in list(kept) if n in ticked and not ticked[n]})
                if any(event and event[0] for event in ticked.values()):
                    if run_stopped(run_id):
                        raise FileNotFoundError(run_dir(run_id))  # archived since this poll's reads
                    if stop_under_way(read_log(run_id)):
                        # a stop that began during this poll: keep only the answers, and wait for how it ends
                        kept.update({n: e for n, e in ticked.items() if e and e[0]})
                        ticked = {name: event for name, event in ticked.items() if event and not event[0]}
            except (MeshError, OSError):
                if run_stopped(run_id):  # archived mid-poll
                    stopped()
                    break
                raise
            for name, event in ticked.items():
                watch = watches[name]
                at_screen = (agents.get(name) or {}).get("held")
                # Still at the screen: not retired, not past it (reading working, or idle with a ring to retry)
                if (not event and not watch.finished and at_screen and not at_screen.get("tries")
                        and watch.state in ("blocked", "unknown") and seconds_since(at_screen.get("at")) >= held_for):
                    event = 4, (f"ALERT {name} is still waiting at a startup screen ({at_screen.get('screen')}): the "
                                f"user clears it in its pane (`herdr agent focus {name}`), then `mesh ring {name}`, "
                                "and its answer comes to your inbox")
                report, _ = last_report(events, name)
                if not event and report and report.get("type") not in FINAL_TYPES:
                    event = 3, (f"ALERT {name} sent a {report['type']} instead of an answer: read it with "
                                f"`mesh inbox`, answer it with `mesh send {name} --type answer`")
                if not event and watch.finished:
                    event = 5, f"ALERT {name} was retired before it answered"
                if event:
                    decide(name, event)
            if watches and deadline and time.monotonic() > deadline:
                for name, watch in list(watches.items()):
                    decide(name, (6, f"ALERT {name} has not answered within {timeout}s ({watch.prev})"))
            if watches:
                time.sleep(interval)
    finally:
        for handle in held.values():
            handle.close()
    return outcomes


def ask_peers(args: argparse.Namespace) -> int:
    """`mesh ask --peers`: one question to several peer askers at once, each told what changed
    upstream, their answers collected into one file and a line each printed (design §14)."""
    if args.ref or args.repo or args.review or args.kind:
        raise MeshError("--peers asks the peer askers: drop the worker, --repo, --review and --kind")
    body = (read_body(args.body, args.file) or "").strip()
    if not body:
        raise MeshError("empty question: pass --body TEXT or --file PATH (- for stdin)")
    registry = load_peers()["peers"]
    names = select_peers(registry, args.peers)
    if any(not_live(quietly(peer_worker, n, registry[n])) for n in names):  # one will start: before a run is made
        memory_guard(f"the askers of {', '.join(names)}", reserve=False)
    own_run = (quietly(identity, args) or (None,))[0]  # the reserve, before a run is made
    for peer in sorted(names):
        entry = registry[peer] if isinstance(registry[peer], dict) else {}
        worker = (quietly(peer_worker, peer, entry) or (None, None, None, {}))[3]  # its last conversation's model
        reserve_guard(own_run, worker.get("kind") or entry.get("kind") or "claude", worker.get("model"),
                      worker.get("effort"), f"the askers of {', '.join(names)}")
    run_id, me = ask_identity(args, body, None)
    mark = collector(me)
    asked: dict[str, str] = {}  # peer → the name its asker has in this run
    try:
        with signals_raise(signal.SIGTERM, signal.SIGHUP):  # a killed fan-out still clears its marks
            return fan_out(args, run_id, me, body, registry, names, mark, asked)
    finally:
        clear_marks(run_id, list(asked.values()))


def clear_marks(run_id: str, names: list[str]) -> None:
    """Take a fan-out's `collect` mark off these askers, so their next report rings as usual."""
    for name in names:
        try:
            with editing_run(run_id) as run:
                if name in run["agents"]:
                    run["agents"][name].pop("collect", None)
        except FileNotFoundError:  # archived: its marks die with this process's pid
            if not run_stopped(run_id):
                raise
            break


def reached_outcomes(reached: dict[str, tuple], what: str) -> tuple[dict[str, int], dict[str, tuple[int, str]]]:
    """A fan-out's reach results by key (a peer, a reviewer's kind) as (result, finals, how): each reached
    asker's count of final sends before its task (what watch_each takes), and the outcome of each key that
    wasn't; a held or unrung one is told on stderr. `what` names the task in that warning."""
    finals: dict[str, int] = {}
    outcomes: dict[str, tuple[int, str]] = {}
    for key, (result, count, how) in reached.items():
        if result is None:
            outcomes[key] = 1, f"{key}: not asked ({how})"
            continue
        asker, delivery = result["name"], result.get("delivery") or {}
        if "send_message" in delivery:  # a fan-out blocks its caller, who can't pass a SendMessage on
            outcomes[key] = 2, (f"{key}: not reached: {asker} was launched before mesh started workers accepting "
                                f"cross-session messages; `mesh retire {asker}` then `mesh resume {asker}` relaunches "
                                "it accepting them, then ask again")
            continue
        finals[asker] = count
        if delivery.get("held"):  # only the user can clear it; the watch rings it once they have
            print(held_alert(asker, delivery), file=sys.stderr)
        elif not delivered(delivery):
            print(f"warning: {asker}'s {what} is stored, but its doorbell did not ring "
                  f"({delivery.get('error')}); `mesh ring {asker}` retries it", file=sys.stderr)
    return finals, outcomes


CLAUDE_AGENTS_RETRY = 1.0  # seconds before asker_status asks `claude agents` again after a failed call


def record_answers(run_id: str, path: Path, answered: list[str]) -> None:
    """Keep the answers file, for `mesh peers` to name without remembering the run: the newest of any round,
    and on each peer that answered, its own last one. As run and path in its folder, which `answers_file`
    finds again once `mesh stop` has moved the run to the archive."""
    ref = {"run": run_id, "file": f"reports/{path.name}"}
    with editing_peers() as data:
        data["answers"] = ref
        for name in answered:
            if isinstance(data["peers"].get(name), dict):
                data["peers"][name]["answers"] = ref


def answers_file(ref) -> Path | None:
    """Where an `answers` record of peers.json is now, live or archived; None for none or a run gone. An
    older peers.json stored the absolute path in the live folder: one `mesh stop` archived is found too."""
    if isinstance(ref, dict) and isinstance(ref.get("run"), str) and isinstance(ref.get("file"), str):
        try:
            path = run_folder(ref["run"]) / ref["file"]
        except MeshError:
            return None
        return path if path.exists() else None
    if not isinstance(ref, str) or not ref:
        return None
    path = Path(ref)
    if path.exists():
        return path
    try:
        moved = mesh_home() / "archive" / path.relative_to(mesh_home())
    except ValueError:
        return None
    return moved if moved.exists() else None


def asker_status(name: str, entry: dict) -> str:
    """agent_status, but `unknown` for a background worker whose `claude agents` call failed twice, a second
    apart: it can't be told gone, and resuming a live one would run two processes on one conversation."""
    if entry.get("view") != "bg":
        return agent_status(name, entry)
    rows = read_claude_agents()
    if rows is None:  # once more: a passing failure shouldn't leave a gone worker unknown
        time.sleep(CLAUDE_AGENTS_RETRY)
        rows = read_claude_agents()
    return "unknown" if rows is None else agent_status(name, entry, rows)


def owes_answer(run_id: str, name: str, entry: dict, events: list[dict] | None = None,
                state: str | None = None) -> bool:
    """A worker of this run still on its last task: it got one and has reported nothing since (by the log,
    since an idle blip in its pane doesn't mean it's done), or it reads working. One that is gone owes
    nothing: it will never answer, and asking reopens its conversation. `events` (the run's log) and `state`
    (asker_status), when the caller has read them."""
    if entry.get("status") == "retired":
        return False
    state = asker_status(name, entry) if state is None else state
    if state == "gone":
        return False
    return owes_report(read_log(run_id) if events is None else events, name) or state == "working"


def fan_out(args: argparse.Namespace, run_id: str, me: str, body: str, registry: dict, names: list[str],
            mark: dict, asked: dict[str, str]) -> int:
    """ask_peers' work; `asked` is filled in as peers are reached, for its caller to clear their marks."""
    from concurrent.futures import ThreadPoolExecutor

    def prepare(name: str) -> dict:
        try:
            return prepare_peer(name, registry[name], refresh=not args.no_refresh)
        except (MeshError, OSError) as exc:  # a broken entry or a gone clone: that peer's outcome, not the fan-out's
            return {"failed": str(exc)}

    def reach(name: str) -> tuple:
        prep, peer = preps[name], registry[name]
        try:
            task = ask_task(f"{body}\n\n{prep['note']}", None, None, fresh=False)
            target = peer_worker(name, peer)
            events = read_log(target[0]["id"], target[1]) if target else None  # once, for both checks
            live = target and target[0]["id"] == run_id and target[3].get("status") != "retired"
            state = asker_status(target[2], target[3]) if live else None  # one reading, as for the log
            if live and owes_answer(run_id, target[2], target[3], events, state):
                # Its next `done` answers the question it's on: filing that as this one's would be wrong.
                return None, 0, "busy with its previous question; ask again once it answers"
            ask = argparse.Namespace(**{**vars(args), "no_wait": True})  # the fan-out watches them all
            if target:
                result, finals, how = reach_worker(ask, run_id, me, target, task, first_line(body), peer=name,
                                                   collect=mark, events=events, state=state)
            else:
                result, finals, how = spawn_peer(ask, run_id, me, name, peer, task, collect=mark), 0, "started"
        except MeshError as exc:
            return None, 0, str(exc)
        record_peer_ask(name, prep, run_id, result["name"])
        return result, finals, how

    def reached_one(name: str) -> tuple:
        result = reach(name)
        if result[0]:
            asked[name] = result[0]["name"]
        return result

    with ThreadPoolExecutor(max_workers=min(PEER_THREADS, len(names))) as pool:
        preps = dict(zip(names, pool.map(prepare, names)))
        ready = [n for n in names if "failed" not in preps[n]]
        reached = dict(zip(ready, pool.map(reached_one, ready)))

    finals, outcomes = reached_outcomes(reached, "question")
    outcomes.update({n: (1, f"{n}: {preps[n]['failed']}") for n in names if n not in ready})
    opened = {asked[n] for n, (_, _, how) in reached.items() if n in asked and how != "asked"}
    warn_unwatched(run_id, skip=tuple(finals))
    if finals:
        print(f"mesh: asked {', '.join(finals)}; waiting for their answers", file=sys.stderr)
    by_asker = {v: k for k, v in asked.items()}
    watched = watch_each(run_id, finals, args.timeout,
                         on_outcome=lambda n, status, line: status and print(line.splitlines()[0], file=sys.stderr))
    for asker, outcome in watched.items():
        outcomes[by_asker[asker]] = outcome

    folder = run_folder(run_id)  # archived by a `mesh stop`, which closed the askers: the answers are in it
    replies: dict[str, tuple[dict, str] | None] = {}
    for name in names:
        asker = asked.get(name)
        replies[name] = take_reply(run_id, me, asker, folder) if asker and outcomes[name][0] == 0 else None
    asked_groups = {registry[n].get("group") if isinstance(registry[n], dict) else None for n in names}
    group_about = ((load_peers().get("groups") or {}).get(next(iter(asked_groups))) or {}).get("about") \
        if len(asked_groups) == 1 else None
    parts = [f"# Peer answers: {first_line(body, 120)}", "",
             f"Asked {now_iso()} in run {run_id}, of {len(names)} peer{'s' if len(names) > 1 else ''}: "
             f"{', '.join(names)}.", *(["", f"{next(iter(asked_groups))}: {group_about}"] if group_about else []),
             "", "## Question", "", body, ""]
    lines = []
    for name in names:
        prep, reply = preps[name], replies[name]
        status, line = outcomes[name]
        entry = registry[name] if isinstance(registry[name], dict) else {}
        where = Path(str(entry.get("repo") or name)).name  # a hand-edited entry's repo may be anything
        if prep.get("head"):
            where += f" at {prep['head'][:9]}" + (f", upstream +{prep['new']} since last asked" if prep.get("new") else "")
        about = entry.get("about")
        section, what = render_answer(reply, line)
        parts += [f"## {name}", "", f"*{where}*", *(["", f"*{about}*"] if about else []), "", *section]
        lines.append(f"  {name:<28} {what}" + (f"  (upstream +{prep['new']})" if prep.get("new") else ""))
    path = write_answers(run_id, "peers", parts)
    retire_answered(run_id, [asked[n] for n in names if replies[n] and asked[n] in opened and not args.keep])
    stopped = run_stopped(run_id)
    if stopped:
        print(stopped_line(run_id), file=sys.stderr)
    record_answers(run_id, path, [n for n in names if replies[n]])
    answered = sum(1 for r in replies.values() if r)
    print(f"{answered} of {len(names)} peers answered: {first_line(body, 100)}")
    print("\n".join(lines))
    print(f"answers: {path}")
    if answered < len(names) and stopped:
        print(f"(run {run_id} stopped, closing a peer that didn't answer: `mesh ask <peer> --body …` reopens it)")
    elif answered < len(names):
        print("(a peer that didn't answer is still open: follow it up as its line says, then `mesh retire` it)")
    failed = [outcomes[n][0] for n in names if not replies[n]]
    return failed[0] if failed else 0


def render_answer(reply: tuple[dict, str] | None, line: str) -> tuple[list[str], str]:
    """One asker's section in a fan-out's answers file, and its summary on stdout: its reply, or `line` (why
    there is none)."""
    if reply:
        meta, text = reply
        return ([text if meta.get("type") == "done" else f"**{meta.get('type')}:** {text}", ""],
                f"{meta.get('type')}, {len(text.split()):,} words")
    return [f"No answer: {line}", ""], line.splitlines()[0]


def parse_reviewers(spec: str) -> list[str] | None:
    """`--reviewers`: None for `auto`, else the kinds `all` or a comma list names."""
    words = [word.strip() for word in spec.split(",") if word.strip()]
    if words == ["auto"]:
        return None
    if words == ["all"]:  # every installed one
        kinds = [kind for kind in ASK_KINDS if installed(kind)]
        if not kinds:
            raise MeshError(f"--reviewers all: {installed_text()}")
        return kinds
    if not words or any(word not in ASK_KINDS for word in words):
        raise MeshError(f"--reviewers takes auto, all, or a comma list of {', '.join(ASK_KINDS)} (got {spec!r})")
    for word in words:
        require_cli(word, f"a {word} reviewer")
    return list(dict.fromkeys(words))


def earlier_reviewers(pr: str) -> dict[str, tuple[dict, Path, str, dict]]:
    """The newest reviewer of each kind that `ask --repo` started at `pr`'s head (`review_checkout`, which a
    resume carries along), across every run, live or archived, as a target (run, folder, name, entry)."""
    found: dict[str, tuple[dict, Path, str, dict]] = {}
    for run, folder in all_runs():  # newest first; within a run, the latest of a kind
        for name, entry in reversed(run["agents"].items()):
            if entry.get("review_checkout") == pr and entry.get("role") == "worker":
                found.setdefault(entry.get("kind"), (run, folder, name, entry))
    return found


def stop_copilot(run_id: str, name: str) -> None:
    """Stop the copilot a Copilot asker's `mesh ask` started (its own process group), so its thread files a
    `failed` before the asker is released."""
    entry = ((maybe_run(run_id) or {}).get("agents") or {}).get(name) or {}
    pid = entry.get("copilot_pid")
    if pid and pid_alive(pid, entry.get("copilot_pid_start")):
        try:
            os.killpg(pid, signal.SIGTERM)
        except OSError:
            pass


REVIEW_KEYS = ("reviews", "review_heads", "review_checkout")  # what record_review writes on an asker's entry
COPILOT_STOP_WAIT = 5.0  # seconds an interrupted review round waits for its Copilot thread to file its `failed`


def ask_reviewers(args: argparse.Namespace) -> int:
    """`mesh ask --repo <checkout> --review <PR> --reviewers …`: one review round, its reviewers picked by the
    review's size and agy's quota (`auto`, pick_reviewers) or named, all at once; their answers are collected
    into one file, so the root wakes once (design §10). A reviewer an earlier round of the PR started (in the
    newest run that has one, `earlier_reviewers`) is asked again, on the commits since; any other is fresh."""
    if args.ref or not args.repo or not args.review or args.kind or args.name:
        raise MeshError("--reviewers runs a review round: pass --repo and --review, and drop the worker, --kind "
                        "and --name")
    named = parse_reviewers(args.reviewers)  # a typo fails before anything starts
    ignored = [flag for flag, on in (("--wait", args.wait), ("--no-wait", args.no_wait)) if on]
    if ignored:
        print(f"mesh: {', '.join(ignored)} don't apply to a review round, which always waits for its reviewers",
              file=sys.stderr)
    body = (read_body(args.body, args.file) or "").strip()
    repo = resolve_repo(args.repo)
    pr, number = pr_ref(args.review, repo)
    earlier = earlier_reviewers(pr)
    # no --size: the size the PR's earlier reviewers were given, else large (as a spawn)
    size = args.size or next((t[3]["size"] for t in earlier.values() if t[3].get("size")), None) or "large"
    kinds, notes = (named, []) if named else pick_reviewers(size, {k: t[3] for k, t in earlier.items()})
    if len(kinds) > 1 and (args.model or args.view):
        raise MeshError(f"--model and --view are one CLI's: a round of {', '.join(kinds)} can't take them; name one "
                        "reviewer (`--reviewers <kind>`), or drop them")
    head = pr_head(repo, pr, number)  # what a fresh reviewer's worktree starts at
    memory_guard(f"the reviewers of {pr}", reserve=False)
    run_id, me = ask_identity(args, body or f"review {pr}", None)
    for note in notes:
        print(f"mesh: {note}", file=sys.stderr)
    targets = {kind: earlier[kind] for kind in kinds if kind in earlier}
    print(f"mesh: reviewers of {pr}: " + ", ".join(f"{targets[k][2]} again" if k in targets else f"a fresh {k}"
                                                  for k in kinds), file=sys.stderr)
    mark = collector(me)
    asked: dict[str, str] = {}  # kind → the reviewer's name
    stopping = threading.Event()  # set once the round ends, so a Copilot thread not yet asking never starts
    helpers: list[threading.Thread] = []
    try:
        with signals_raise(signal.SIGTERM, signal.SIGHUP):  # a killed round still clears its marks
            return review_round(args.__class__(**{**vars(args), "size": size}), run_id, me, repo, pr, number, head,
                                body, kinds, targets, mark, asked, stopping, helpers)
    finally:
        stopping.set()
        clear_marks(run_id, [name for kind, name in list(asked.items()) if kind != "copilot"])
        for helper in helpers:  # still asking only when interrupted: stop it, and let it file its `failed`
            for _ in range(2):  # again, for a copilot that recorded its pid during the first wait
                if not helper.is_alive():
                    break
                if "copilot" in asked:
                    stop_copilot(run_id, asked["copilot"])
                helper.join(COPILOT_STOP_WAIT)


def review_round(args: argparse.Namespace, run_id: str, me: str, repo: Path, pr: str, number: int | None,
                 head: str, body: str, kinds: list[str], targets: dict[str, tuple], mark: dict,
                 asked: dict[str, str], stopping: threading.Event, helpers: list[threading.Thread]) -> int:
    """ask_reviewers' work; `asked` is filled in as reviewers are reached, and `helpers` with the Copilot thread,
    for its caller to clean up after. Claude and agy reviewers are reached in threads under the `collect` mark
    and watched with watch_each; Copilot answers in a thread of its own, headless, as `mesh ask` runs it, and
    starts only while `stopping` isn't set."""
    from concurrent.futures import ThreadPoolExecutor

    outcomes: dict[str, tuple[int, str]] = {}

    def prepared(kind: str) -> tuple:
        """(ask, target, task, move, body): a re-ask is of a worker, as `mesh ask <name> --review` is: no --repo,
        so its task reads as one, built in its own clone with the head fetched there (as cmd_ask does); the
        round's size goes to each, so a Copilot's effort follows it too."""
        target, where, at = targets.get(kind), repo, head
        last = (target[3].get("review_heads") or {}).get(pr) if target else None
        if target and target[3].get("repo") and Path(target[3]["repo"]).resolve() != repo:
            where = Path(target[3]["repo"])
            try:  # into its clone's object store; a review without it still goes out
                at = pr_head(where, pr, number)
            except (MeshError, OSError):
                at = None
        ask = argparse.Namespace(**{**vars(args), "no_wait": True, "kind": kind, "repo": None if target else args.repo})
        return (ask, target, *asker_task(ask, run_id, where, target, kind, body, pr, number, at, last), at)

    def start(kind: str) -> tuple:
        try:
            ask, target, task, move, text, at = prepared(kind)
            if target:
                events = read_log(target[0]["id"], target[1])  # once, for both checks
                live = target[0]["id"] == run_id and target[3].get("status") != "retired"
                state = asker_status(target[2], target[3]) if live else None
                if live and owes_answer(run_id, target[2], target[3], events, state):
                    return None, 0, "busy with its previous task; ask it again once it answers"
                if target[3].get("kind") != "copilot":
                    reserve_guard(run_id, target[3].get("kind"), target[3].get("model"), target[3].get("effort"),
                                  f"a review by {target[2]}")
                result, finals, how = moving(move, lambda: reach_worker(ask, run_id, me, target, task,
                                                                        f"a review of {pr}", collect=mark,
                                                                        events=events, state=state))
            else:
                result, finals, how = (fresh_asker(ask, run_id, me, repo, kind, task, text, pr, number, head,
                                                   collect=mark), 0, "started")
        except MeshError as exc:
            return None, 0, str(exc)
        asked[kind] = result["name"]
        record_review(run_id, result["name"], pr, at, checkout=not target)
        return result, finals, how

    def copilot() -> None:
        try:
            if stopping.is_set():
                raise MeshError("the round was stopped first")
            ask, target, task, move, text, at = prepared("copilot")
            reservation = memory_guard(target[2] if target else f"a Copilot asker in {repo.name}")
            try:
                before = {key: target[3][key] for key in REVIEW_KEYS if key in target[3]} if target else {}
                name, how = moving(move, lambda: copilot_asker(ask, run_id, me, repo, target, pr, number,
                                                               None if target else head, text, at))
                asked["copilot"] = name
                if stopping.is_set():  # claimed, never asked: release it, with no review recorded
                    with editing_run(run_id) as run:
                        release_copilot(run_id, run, name, lambda agent, task: ("failed", "interrupted", None))
                        entry = run["agents"][name]
                        for key in REVIEW_KEYS:
                            entry.pop(key, None)
                        entry.update(before)
                    raise MeshError("the round was stopped before copilot started")
                peek = open_peek(run_id, name, Path(agent_entry(load_run(run_id), name)["cwd"]))
                print(f"mesh: {how} {name} (Copilot, headless)" + (f", followed in pane {peek}" if peek else ""),
                      file=sys.stderr)
                try:
                    copilot_ask(run_id, me, name, task, args.timeout)
                finally:
                    if peek:
                        close_peek(run_id, name, peek)
            finally:
                release_memory([reservation])
        except Exception as exc:  # noqa: BLE001 - that reviewer's outcome, not the round's
            outcomes["copilot"] = 1, f"copilot: not asked ({exc})"

    if "copilot" in kinds:  # a daemon: an interrupted round waits for it only COPILOT_STOP_WAIT, twice
        helpers.append(threading.Thread(target=copilot, name="copilot-review", daemon=True))
        helpers[0].start()
    panes = [kind for kind in kinds if kind != "copilot"]
    reached: dict[str, tuple] = {}
    if panes:
        with ThreadPoolExecutor(max_workers=len(panes)) as pool:
            reached = dict(zip(panes, pool.map(start, panes)))

    finals, missed = reached_outcomes(reached, "review task")
    outcomes.update(missed)
    opened = {result["name"] for result, _, how in reached.values() if result and how != "asked"}
    warn_unwatched(run_id, skip=tuple(finals))
    if finals:
        print(f"mesh: asked {', '.join(finals)}; waiting for their reviews", file=sys.stderr)
    by_name = {name: kind for kind, name in list(asked.items())}
    watched = watch_each(run_id, finals, args.timeout,
                         on_outcome=lambda n, status, line: status and print(line.splitlines()[0], file=sys.stderr))
    for name, outcome in watched.items():
        outcomes[by_name[name]] = outcome
    for helper in helpers:
        helper.join()
        outcomes.setdefault("copilot", (0, ""))

    folder = run_folder(run_id)  # archived by a `mesh stop`, which closed the reviewers: the answers are in it
    replies = {kind: take_reply(run_id, me, asked[kind], folder) if kind in asked and outcomes[kind][0] == 0
               else None for kind in kinds}
    names = [asked.get(kind, kind) for kind in kinds]
    parts = [f"# Review of {pr} at {head}", "",
             f"Asked {now_iso()} in run {run_id}, size {args.size}, of {len(kinds)} reviewer{'s' if len(kinds) > 1 else ''}: "
             f"{', '.join(names)}.", *(["", "## Notes to the reviewers", "", body] if body else []), ""]
    lines, failed = [], []
    for kind, name in zip(kinds, names):
        reply = replies[kind]
        status, line = outcomes.get(kind) or (1, "")
        section, what = render_answer(reply, line or f"{kind}: no answer")
        parts += [f"## {name} ({kind})", "", *section]
        if not reply or reply[0].get("type") != "done":
            failed.append(1 if reply else status or 1)
        lines.append(f"  {name:<28} {what}")
    path = write_answers(run_id, f"review-{number or 'pr'}", parts)
    retire_answered(run_id, [asked[k] for k in panes if replies[k] and asked[k] in opened and not args.keep])
    stopped = run_stopped(run_id)
    if stopped:
        print(stopped_line(run_id), file=sys.stderr)
    answered = sum(1 for reply in replies.values() if reply)
    print(f"{answered} of {len(kinds)} reviewers answered: {pr} at {head[:9]}")
    print("\n".join(lines))
    print(f"answers: {path}")
    if answered < len(kinds) and not stopped:
        print("(a reviewer that didn't answer is still open: follow it up as its line says, then `mesh retire` it)")
    print("(ask one again: `mesh ask <name> --body …`; after a fix, run this round again for the re-review)")
    return failed[0] if failed else 0


def write_answers(run_id: str, prefix: str, parts: list[str]) -> Path:
    """A fan-out's answers file, `reports/<prefix>-<stamp>.md`, in the run's folder: the live one, or the archive
    a `mesh stop` meanwhile moved it to."""
    for _ in range(2):
        path = run_folder(run_id) / "reports" / f"{prefix}-{stamp()}.md"
        try:  # never with parents: a live folder `mesh stop` just archived must not come back half-made
            path.parent.mkdir(exist_ok=True)
            write_atomic(path, "\n".join(parts))
            return path
        except FileNotFoundError:
            if not run_stopped(run_id):
                raise
    raise MeshError(f"couldn't write the {prefix} report under {run_folder(run_id)}")


def retire_answered(run_id: str, names: list[str]) -> None:
    """Close the askers a fan-out opened once their answers are in its file (not during a `mesh stop`, which
    closes them itself)."""
    for asker in names if not stop_under_way(read_log(run_id)) else ():
        try:
            retire_worker(run_id, asker, agent_entry(load_run(run_id), asker))
        except (MeshError, OSError) as exc:
            if run_stopped(run_id):  # a stop now must not lose the report
                break
            print(f"warning: couldn't close {asker} ({exc}); `mesh retire {asker}` it", file=sys.stderr)


# ── peers: standing askers ───────────────────────────────────────────────


def peers_path() -> Path:
    return mesh_home() / "peers.json"


def load_peers() -> dict:
    """The registry of standing peer askers (design §14): config that outlives runs, nothing a run records."""
    path = peers_path()
    data = json.loads(path.read_text()) if path.exists() else {}
    data.setdefault("peers", {})
    return data


@contextmanager
def editing_peers():
    with file_lock(mesh_home() / "locks" / "peers.lock"):
        data = load_peers()
        yield data
        write_atomic(peers_path(), json.dumps(data, indent=2) + "\n")


def peers_dir() -> Path:
    return Path(setting("peers_dir")).expanduser()


def peer_upstream(repo: Path) -> dict:
    """The remote and branch a clone follows: `origin` (else its first remote) and that remote's HEAD branch, else
    the branch checked out. No remote: the clone's own branch, which nothing moves."""
    remotes = git("remote", cwd=repo).split()
    remote = "origin" if "origin" in remotes else (remotes[0] if remotes else None)
    branch = None
    if remote:
        try:
            branch = git("symbolic-ref", "--short", f"refs/remotes/{remote}/HEAD", cwd=repo).split("/", 1)[1]
        except (MeshError, IndexError):
            pass
    branch = branch or git("branch", "--show-current", cwd=repo) or "main"
    try:
        url = git("remote", "get-url", remote, cwd=repo) if remote else None
    except MeshError:  # a remote with no URL: nothing to fetch from, and no GitHub description
        url = None
    return {"remote": remote, "branch": branch, "url": url}


def upstream_ref(peer: dict) -> str:
    up = peer["upstream"]
    return f"refs/remotes/{up['remote']}/{up['branch']}" if up.get("remote") else f"refs/heads/{up['branch']}"


def upstream_head(peer: dict) -> str | None:
    """The upstream commit as of the last fetch, from local refs only."""
    try:
        return git("rev-parse", "--verify", "--quiet", f"{upstream_ref(peer)}^{{commit}}", cwd=peer["repo"])
    except (MeshError, OSError):  # OSError: the clone is gone
        return None


def fetch_peer(peer: dict) -> str | None:
    """`git fetch` the clone's upstream; None, or why it failed (which never stops an ask)."""
    remote = peer["upstream"].get("remote")
    if not Path(peer["repo"]).is_dir():
        return f"its clone {peer['repo']} is gone"
    if not remote:
        return None
    result = run_cli(["git", "fetch", "--quiet", remote], cwd=peer["repo"], timeout=FETCH_TIMEOUT)
    if result.returncode:
        return (result.stderr.strip().splitlines() or [f"git fetch exited {result.returncode}"])[-1]
    return None


def commits_between(repo: str, old: str | None, new: str | None) -> int:
    if not old or not new or old == new:
        return 0
    try:
        return int(git("rev-list", "--count", f"{old}..{new}", cwd=repo))
    except (MeshError, OSError, ValueError):
        return 0


def ensure_peer_worktree(peer: dict) -> bool:
    """The asker's own worktree, detached (no branch to keep or delete), at the commit it last read. True if
    it had to be (re)created; its path never changes, since Claude keys the conversation by it."""
    cwd = Path(peer["cwd"])
    if cwd.exists() or peer.get("in_clone"):
        return False
    if not Path(peer["repo"]).is_dir():
        raise gone_clone(cwd, peer["repo"])
    at = peer.get("seen") or upstream_head(peer) or git("rev-parse", "HEAD", cwd=peer["repo"])
    git("worktree", "prune", cwd=peer["repo"])
    cwd.parent.mkdir(parents=True, exist_ok=True)
    git("worktree", "add", "--detach", str(cwd), at, cwd=peer["repo"])
    return True


def prepare_peer(name: str, peer: dict, refresh: bool = True) -> dict:
    """Before a peer is asked: fetch its upstream, move its clean worktree to the new head, and write the note
    that tells it what changed since it last looked. Returns {note, head (what it reads), upstream, new, error}."""
    refuse_unaskable_peer(name, peer)
    repo, seen = peer["repo"], peer.get("seen")
    error = fetch_peer(peer) if refresh else None
    ensure_peer_worktree(peer)
    cwd = peer["cwd"]
    head = upstream_head(peer) or seen
    at = git("rev-parse", "HEAD", cwd=cwd)
    seen = seen or at
    dirty = bool(git("status", "--porcelain", cwd=cwd))
    in_clone = bool(peer.get("in_clone"))  # it runs in the clone's own checkout, which mesh never moves
    if head and head != at and not dirty and not in_clone:
        git("checkout", "--quiet", "--detach", head, cwd=cwd)
        at = head
    up = peer["upstream"]
    where = f"{up['remote']}/{up['branch']}" if up.get("remote") else up["branch"]
    new = commits_between(repo, seen, head)
    lines = []
    if error:
        lines.append(f"Couldn't fetch {up.get('url') or where} ({error}), so this is upstream as of the last fetch.")
    if new:
        log = git("log", "--oneline", "--no-decorate", f"-{PEER_LOG_LINES}", f"{seen}..{head}", cwd=repo)
        more = f"\n… and {new - PEER_LOG_LINES} more" if new > PEER_LOG_LINES else ""
        stat = git("diff", "--shortstat", seen, head, cwd=repo)
        lines.append(f"Upstream moved since you last looked: {new} commit{'s' if new > 1 else ''} on {where}, "
                     f"{seen[:9]}..{head[:9]} ({stat or 'no file changes'}). Re-check what your answer relies on "
                     f"against them (`git log --stat {seen[:9]}..{head[:9]}`):\n\n```\n{log}{more}\n```")
    elif not error:
        lines.append(f"Upstream ({where}) hasn't changed since you last looked.")
    if at == head:
        lines.append(f"Your checkout is at {at[:9]}.")
    elif in_clone:
        lines.append(f"You run in the clone's own checkout, which stays at {at[:9]}; upstream is at "
                     f"{(head or '?')[:9]}: read the newer code with `git show {(head or '')[:9]}:<path>`.")
    else:
        lines.append(f"Your checkout has local changes, so it stays at {at[:9]}; upstream is at {(head or '?')[:9]}: "
                     f"read the newer code with `git show {(head or '')[:9]}:<path>`.")
    return {"note": "\n\n".join(lines), "head": at, "upstream": head, "new": new, "error": error}


def refuse_unaskable_peer(name: str, peer) -> None:
    """Refuse a peer that can't be asked, a broken entry or a gone clone, before anything is started for it."""
    problem = peer_problem(peer)
    if problem:
        raise MeshError(f"{name}'s registry entry is broken ({problem}): `mesh peers remove {name}` and add it again")
    if not Path(peer["repo"]).is_dir():
        raise MeshError(f"{name}'s clone {peer['repo']} is gone: put it back, or `mesh peers remove {name}`")


def peer_problem(peer) -> str | None:
    """What makes a registry entry unusable (edited by hand, or written half), or None."""
    if not isinstance(peer, dict):
        return f"not an entry but {type(peer).__name__} {str(peer)[:30]!r}"
    missing = [key for key in ("repo", "cwd") if not peer.get(key)]
    up = peer.get("upstream")
    if not isinstance(up, dict) or not up.get("branch"):
        missing.append("upstream branch")
    problems = [f"no {', '.join(missing)} recorded"] if missing else []
    problems += [f"{key} {peer[key]!r} is not a path" for key in ("repo", "cwd")
                 if peer.get(key) and not isinstance(peer[key], str)]
    if isinstance(up, dict) and up.get("branch") and not isinstance(up["branch"], str):
        problems.append(f"upstream branch {up['branch']!r} is not a branch name")
    return "; ".join(problems) or None


def peer_of(name: str, entry: dict) -> dict | None:
    """The registry entry of the peer this worker is, if it is one (same name, same clone)."""
    peer = load_peers()["peers"].get(name)
    if peer and not peer_problem(peer) and entry.get("repo") \
            and Path(entry["repo"]).resolve() == Path(peer["repo"]).resolve():
        return peer
    return None


def worker_peer(name: str, entry: dict, given: str | None = None) -> tuple[str | None, dict | None]:
    """(the peer a worker's conversation is: `given`, its entry's `peer` (a `-2` copy, or a removed peer), else
    the registered peer of its name and clone; that peer's registry entry, None once removed, broken, or the name
    is another clone's now)."""
    peer_name = given or entry.get("peer") or (name if peer_of(name, entry) else None)
    peer = load_peers()["peers"].get(peer_name) if peer_name else None
    if peer is None or peer_problem(peer) or not entry.get("repo") \
            or Path(entry["repo"]).resolve() != Path(peer["repo"]).resolve():
        return peer_name, None  # a name reused for another clone isn't this conversation's peer
    return peer_name, peer


def peer_worker(name: str, peer: dict) -> tuple[dict, Path, str, dict] | None:
    """The peer's newest conversation: the entry its last ask left (`run`, `as`), else the newest worker by its
    name in its clone. None while it was never asked."""
    for ref, run_id in ((peer.get("as") or name, peer.get("run")), (name, None)):
        try:
            found = find_worker(ref, run_id)
        except MeshError:
            continue
        if found[3].get("repo") and Path(found[3]["repo"]).resolve() == Path(peer["repo"]).resolve():
            return found
    return None


def record_peer_ask(name: str, prep: dict, run_id: str, as_name: str) -> None:
    """What the asker has now been told: the upstream commit, and where its conversation lives on."""
    with editing_peers() as data:
        peer = data["peers"].get(name)
        if peer is not None:
            peer.update(seen=prep.get("upstream") or prep.get("head") or peer.get("seen"), run=run_id, asked=now_iso())
            peer["as"] = as_name
    if prep.get("head"):  # what its checkout is at, for ensure_worktree should the registry entry go
        with editing_run(run_id) as run:
            if as_name in run["agents"]:
                run["agents"][as_name]["base"] = prep["head"]


NO_PEERS = "no peers yet: add one with `mesh peers add <git-url | path>`"


def about_text(text: str | None) -> str:
    """A peer's or group's description, one paragraph, at most ABOUT_MAX characters."""
    text = " ".join((text or "").split())
    if len(text) > ABOUT_MAX:
        raise MeshError(f"--about is {len(text)} characters; keep it to {ABOUT_MAX}: what the project is, its shape in "
                        "a line, and what it's worth asking about")
    return text


def github_about(url: str | None) -> str | None:
    """The upstream's GitHub description, as a peer's default `about`; None off GitHub or when gh can't say."""
    github = GITHUB_REMOTE_RE.search(url or "")
    if not github:
        return None
    data, _ = gh_json(["repo", "view", f"{github.group(1)}/{github.group(2)}", "--json", "description"])
    text = " ".join(((data or {}).get("description") or "").split()) if isinstance(data, dict) else ""
    return text[:ABOUT_MAX] or None


def peer_groups(data: dict) -> set[str]:
    return {p.get("group") for p in data["peers"].values() if isinstance(p, dict)} | set(data.get("groups") or {})


def select_peers(registry: dict, spec: str) -> list[str]:
    """`all`, or a comma list of peer names and groups, in registry order."""
    if not registry:
        raise MeshError(NO_PEERS)
    wanted = {part.strip() for part in spec.split(",") if part.strip()}
    if not wanted:
        raise MeshError("which peers? pass `all`, a group or peer names (comma-separated); see `mesh peers`")
    # A broken entry stays in: whoever asks reports it (peer_problem), rather than it vanishing silently.
    groups = {n: p.get("group") if isinstance(p, dict) else None for n, p in registry.items()}
    if "all" in wanted:
        return list(registry)
    unknown = wanted - set(registry) - set(groups.values())
    if unknown:
        raise MeshError(f"no peer or group named {', '.join(sorted(unknown))}; see `mesh peers`")
    return [n for n in registry if n in wanted or groups[n] in wanted]


def same_url(a: str | None, b: str) -> bool:
    """Whether two remote URLs name the same repo, ignoring a trailing `/` or `.git`."""
    def norm(url: str) -> str:  # git@github.com:o/r and https://github.com/o/r are the same repo
        github = GITHUB_REMOTE_RE.search(url.strip())
        return f"github:{github.group(1)}/{github.group(2)}".lower() if github else re.sub(r"(\.git)?/*$", "", url.strip())
    return bool(a) and norm(a) == norm(b)


def clone_target(url: str, group: str) -> Path:
    stem = re.sub(r"\.git$", "", url.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1]) or "repo"
    return peers_dir() / group / stem


def release_worktree(run_id: str, cwd: Path) -> None:
    """Take an adopted asker's worktree off its live run's `mesh stop` list. Its run branch goes too when
    untouched, as `mesh stop` would delete it: the peer's worktree is detached from now on. The git steps go
    first: should one fail, the add fails and the run still owns the worktree."""
    def ours(wt: dict) -> bool:
        return Path(wt["path"]).resolve() == cwd.resolve()
    for wt in filter(ours, load_run(run_id).get("worktrees", [])):
        if wt.get("branch") and untouched_branch(wt) and cwd.exists():
            git("checkout", "--quiet", "--detach", cwd=cwd)
            git("branch", "-D", wt["branch"], cwd=wt["repo"])
    with editing_run(run_id) as run:
        run["worktrees"] = [w for w in run.get("worktrees", []) if not ours(w)]


def peers_add(args: argparse.Namespace) -> int:
    if len(args.targets) != 1:
        raise MeshError("add what? `mesh peers add <git-url | path>`")
    source, group = args.targets[0], args.group or "peers"
    brief = read_body(args.body, args.file)  # an unreadable brief fails here, before anything is registered
    path = Path(source).expanduser()
    if not path.exists():  # a URL: clone it, unless it was cloned there already
        path = clone_target(source, group)
        if path.exists():
            try:
                there = git("remote", "get-url", "origin", cwd=path)
            except MeshError:
                there = None
            if not same_url(there, source):
                raise MeshError(f"{path} is already a clone of {there or 'something else'}: add this one with "
                                "another --group, or clone it yourself and `mesh peers add <path>`")
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            result = run_cli(["git", "clone", "--quiet", source, str(path)], timeout=CLONE_TIMEOUT)
            if result.returncode:
                raise MeshError(f"git clone {source}: {result.stderr.strip()[-300:]}")
            print(f"mesh: cloned {source} into {path}", file=sys.stderr)
    repo = Path(git("rev-parse", "--show-toplevel", cwd=path)).resolve()
    name = args.name or agent_name(repo.name, "research", set())
    if not NAME_RE.match(name):
        raise MeshError(f"bad peer name {name!r} (lowercase letters, digits, - and _, at most 32)")
    if name in load_peers()["peers"]:
        raise MeshError(f"{name} is a peer already; see `mesh peers`")
    peer = {"repo": str(repo), "group": group, "upstream": peer_upstream(repo), "added": now_iso()}
    try:
        old_run, folder, _, entry = find_worker(name)
    except MeshError:
        entry = None
    adopted = bool(entry and entry.get("repo") and Path(entry["repo"]).resolve() == repo and entry.get("cwd"))
    live_run = adopted and folder.parent.name != "archive"
    if live_run and entry.get("status") != "retired":
        # prepare_peer would move its worktree under it, and its run would lose track of it
        raise MeshError(f"{name} is still open in run {old_run['id']}: `mesh retire {name}` there first, then add it")
    if adopted:  # its conversation is the valuable part: keep it, at the path Claude keys it by
        peer.update(kind=entry.get("kind"), cwd=entry["cwd"], seen=entry.get("base"))
        if Path(entry["cwd"]).resolve() == repo:  # it ran in the clone itself: never a worktree to move or remove
            peer["in_clone"] = True
    else:
        peer.update(kind=args.kind or default_kind("claude"), cwd=str(worktree_root() / "peers" / name), seen=upstream_head(peer))
    if args.about:
        peer["about"] = about_text(args.about)
    else:
        about = github_about(peer["upstream"].get("url"))
        if about:  # a project's own pitch: `mesh peers edit` replaces it with what its asker found
            peer.update(about=about, about_from="github")
    ensure_peer_worktree(peer)
    peer["seen"] = peer.get("seen") or git("rev-parse", "HEAD", cwd=peer["cwd"])
    with editing_peers() as data:
        if name in data["peers"]:  # added meanwhile by another `peers add`
            raise MeshError(f"{name} is a peer already; see `mesh peers`")
        if live_run and not peer.get("in_clone"):  # last, once nothing can refuse the add any more
            release_worktree(old_run["id"], Path(entry["cwd"]))  # its run's `mesh stop` would remove what it now keeps
        data["peers"][name] = peer
    emit({"name": name, "adopted": adopted, **peer})
    if brief:  # the first research brief
        argv = ["ask", name, "--size", args.size or "large", "--body", brief, *(["--run", args.run] if args.run else []),
                *(["--as", args.as_] if args.as_ else [])]
        return cmd_ask(build_parser().parse_args(argv))
    if not adopted:
        print(f"mesh: {name} isn't briefed yet: `/harvest-peers` gives it its first research round when you want",
              file=sys.stderr)
    return 0


def set_worker_base(folder: Path, name: str, base: str, peer: str) -> None:
    """Mark a removed peer's newest worker entry, in a run's folder live or archived: its `base` is the code it
    last read, `peer` keeps it refusing a change task once the registry forgets it, and no `branch`, since its
    worktree is detached (an adopted one's run branch is long gone)."""
    with editing_run(folder.name, folder) as data:
        if name in data.get("agents", {}):
            data["agents"][name].update(base=base, peer=peer, branch=None)


def peers_remove(args: argparse.Namespace) -> int:
    if not args.targets:
        raise MeshError("remove which peer? `mesh peers remove <name>`")
    for name in args.targets:
        registry = load_peers()["peers"]
        if name not in registry:
            raise MeshError(f"no peer named {name}; see `mesh peers`")
        peer, problem = registry[name], peer_problem(registry[name])
        if problem:  # nothing to clean up that we can trust: drop the entry, say what may be left
            with editing_peers() as data:
                data["peers"].pop(name, None)
            left = peer.get("cwd") if isinstance(peer, dict) else None
            print(f"{name}: removed its broken entry ({problem})"
                  + (f"; its checkout at {left} may still be there" if left else ""))
            continue
        cwd, kept = Path(peer["cwd"]), None
        found = peer_worker(name, peer)  # from run.json alone, so a gone clone still counts as running
        holder = live_holder(found[2], found[3]) if found and found[3].get("status") != "retired" else None
        if holder:
            raise MeshError(f"{name} is still running ({holder.get('name') or holder.get('pane_id') or 'a process'}): "
                            f"`mesh retire {found[2]}` in run {found[0]['id']} first, then remove it")
        if peer.get("in_clone"):
            kept = "it is the clone's own checkout"
        elif cwd.exists() and not Path(peer["repo"]).is_dir():
            kept = "git can't remove it without its clone: delete it by hand"
        elif cwd.exists():
            if git("status", "--porcelain", cwd=cwd):
                kept = "it has local changes"
            else:
                git("worktree", "remove", str(cwd), cwd=peer["repo"])
        if found and peer.get("seen"):  # its conversation, asked again, comes back at the code it last read
            set_worker_base(found[1], found[2], peer["seen"], name)
        with editing_peers() as data:
            data["peers"].pop(name, None)
        clone = (f"its clone stays at {peer['repo']}" if Path(peer["repo"]).is_dir()
                 else f"its clone at {peer['repo']} is gone")
        print(f"{name}: removed; {clone}"
              + (f", and its checkout at {cwd} ({kept})" if kept else "")
              + f". Its conversation is still there: `mesh ask {name}` finds it as a past worker.")
    return 0


def peers_edit(args: argparse.Namespace) -> int:
    """`mesh peers edit <peer|group> [--about] [--group]`: a peer's description or group, or a group's description."""
    if len(args.targets) != 1:
        raise MeshError("edit what? `mesh peers edit <peer | group> --about TEXT`")
    target = args.targets[0]
    if args.about is None and not args.group:
        raise MeshError("nothing to change: pass --about TEXT, or --group G for a peer")
    with editing_peers() as data:
        is_peer, is_group = target in data["peers"], target in peer_groups(data)
        if is_peer and is_group:
            raise MeshError(f"{target} is both a peer and a group; rename one with `mesh peers edit <peer> --group`")
        if is_peer:
            peer = data["peers"][target]
            if not isinstance(peer, dict):
                raise MeshError(f"{target}'s registry entry is broken ({peer_problem(peer)}): `mesh peers remove "
                                f"{target}` and add it again")
            if args.about is not None:
                peer["about"] = about_text(args.about)
                peer.pop("about_from", None)
            if args.group:
                peer["group"] = args.group
            changed = {k: peer.get(k) for k in ("group", "about")}
        elif is_group:
            if args.group:
                raise MeshError(f"{target} is a group: --group moves a peer, not a group")
            data.setdefault("groups", {}).setdefault(target, {})["about"] = about_text(args.about)
            changed = {"about": data["groups"][target]["about"]}
        else:
            raise MeshError(f"no peer or group named {target}; see `mesh peers`")
    emit({"name": target, "kind": "peer" if is_peer else "group", **changed})
    return 0


def peers_refresh(args: argparse.Namespace) -> int:
    registry = load_peers()["peers"]
    names = select_peers(registry, ",".join(args.targets) or "all")
    from concurrent.futures import ThreadPoolExecutor
    broken = {n: peer_problem(registry[n]) for n in names}
    fine = [n for n in names if not broken[n]]
    with ThreadPoolExecutor(max_workers=max(1, min(PEER_THREADS, len(fine)))) as pool:
        errors = dict(zip(fine, pool.map(lambda n: fetch_peer(registry[n]), fine)))
    for name in names:
        if broken[name]:
            print(f"{name}: broken entry ({broken[name]}); `mesh peers remove {name}` and add it again")
            continue
        peer = registry[name]
        head, seen = upstream_head(peer), peer.get("seen")
        new = commits_between(peer["repo"], seen, head)
        what = (f"fetch failed ({errors[name]})" if errors[name]
                else f"+{new} commit{'s' if new != 1 else ''} since it last looked ({(seen or '?')[:9]}..{(head or '?')[:9]})"
                if new else "unchanged")
        print(f"{name}: {what}")
    return 0


def peer_row(name: str, peer: dict) -> dict:
    """One `mesh peers` row: the registry entry, with what its conversation and upstream say now."""
    problem = peer_problem(peer)
    if problem:
        raise MeshError(problem)
    if not Path(peer["repo"]).is_dir():
        raise MeshError(f"clone gone: {peer['repo']}")
    found = peer_worker(name, peer)
    session = find_session(found[0]["id"], found[2], found[3]) if found else None
    tokens = context_tokens(found[3], session) if session else None
    head, up = upstream_head(peer), peer["upstream"]
    return {
        "name": name, "group": peer.get("group") or "", "kind": peer.get("kind") or "",
        "upstream": f"{up['remote']}/{up['branch']}" if up.get("remote") else up["branch"],
        "seen": (peer.get("seen") or "")[:9], "new": commits_between(peer["repo"], peer.get("seen"), head),
        "context": f"{tokens // 1000}k" if tokens else "", "session": "found" if session else "none yet",
        "worktree": "present" if Path(peer["cwd"]).exists() else "removed", "asked": (peer.get("asked") or "")[:16],
        "about": peer.get("about") or "", "repo": peer["repo"], "cwd": peer["cwd"], "run": peer.get("run"),
        "answers": answers_path(peer.get("answers")),
    }


def answers_path(ref) -> str | None:
    path = answers_file(ref)
    return str(path) if path else None


def peers_list(args: argparse.Namespace) -> int:
    data = load_peers()
    rows = []
    for name, peer in data["peers"].items():
        try:
            rows.append(peer_row(name, peer))
        except (MeshError, OSError, KeyError, TypeError, AttributeError) as exc:  # a hand-edited or torn entry
            entry = peer if isinstance(peer, dict) else {}
            rows.append({"name": name, "group": entry.get("group") or "", "kind": entry.get("kind") or "",
                         "upstream": "", "seen": "", "new": "", "context": "", "session": "",
                         "worktree": f"broken ({type(exc).__name__}: {exc})"[:60], "asked": "",
                         "about": entry.get("about") or "", "repo": entry.get("repo"), "cwd": entry.get("cwd"),
                         "run": entry.get("run"), "answers": answers_path(entry.get("answers"))})
    groups = data.get("groups") or {}
    newest = answers_path(data.get("answers"))
    if args.json:
        emit({"peers": rows, "groups": groups, "answers": newest})
        return 0
    if not rows:
        print(f"{NO_PEERS[0].upper()}{NO_PEERS[1:]}.")
        return 0
    for n, group in enumerate(dict.fromkeys(r["group"] for r in rows)):
        about = (groups.get(group) or {}).get("about")
        print(("\n" if n else "") + f"{group or '(no group)'}" + (f": {about}" if about else ""))
        mine = [r for r in rows if r["group"] == group]
        print_table(mine, ("name", "kind", "upstream", "seen", "new", "context", "session", "worktree", "asked"))
        described = [r for r in mine if r["about"]]
        if described:
            print("\nAbout:")
            for row in described:
                print(textwrap.fill(row["about"], 116, initial_indent=f"  {row['name']}: ", subsequent_indent="    "))
        files: dict[str, list[str]] = {}  # each peer's last `ask --peers` answers, one line per file
        for row in mine:
            if row["answers"]:
                files.setdefault(row["answers"], []).append(row["name"])
        if files:
            print("\nLast answers:")
            for path, who in files.items():
                print(f"  {path}: {', '.join(who)}")
    if newest:
        print(f"\nnewest answers: {newest}")
    return 0


def cmd_peers(args: argparse.Namespace) -> int:
    return {"list": peers_list, "add": peers_add, "edit": peers_edit, "remove": peers_remove,
            "refresh": peers_refresh}[args.action](args)


def cmd_worktree(args: argparse.Namespace) -> int:
    run_id, _ = identity(args)
    repo_top = resolve_repo(args.repo)
    path, branch, _ = add_worktree(run_id, repo_top, slugify(args.slug, 24), args.base)
    emit({"path": str(path), "branch": branch})
    return 0


def untouched_branch(wt: dict) -> bool:
    """A run branch still at the commit it started from and never pushed: deleting it loses nothing,
    and `ensure_worktree` can start it again from that base."""
    if not wt.get("base"):
        return False  # runs before 0.6 recorded no base
    try:
        if git("rev-parse", f"refs/heads/{wt['branch']}", cwd=wt["repo"]) != wt["base"]:
            return False
    except MeshError:
        return False
    try:
        git("rev-parse", "--abbrev-ref", f"{wt['branch']}@{{upstream}}", cwd=wt["repo"])
        return False
    except MeshError:
        return True


def merge_conflicts(repo: str, ours: str, theirs: str) -> list[str] | None:
    """Files that conflict when `theirs` merges into `ours`, without touching any checkout; None if it's clean."""
    proc = subprocess.run(["git", "merge-tree", "--write-tree", "--name-only", "--no-messages", ours, theirs],
                          cwd=repo, capture_output=True, text=True, env=git_env())
    if proc.returncode == 0:
        return None
    if proc.returncode == 1:
        return [line for line in proc.stdout.splitlines()[1:] if line.strip()]
    if "write-tree" in proc.stderr or "usage" in proc.stderr:
        raise MeshError("`mesh conflicts` needs git 2.38 or newer (`git merge-tree --write-tree`)")
    raise MeshError(f"git merge-tree {ours} {theirs}: {proc.stderr.strip()}")


class Ancestry:
    """`git merge-base --is-ancestor` for one repo within one `mesh conflicts` call. `stacked` asks it of every pair
    of branches both ways, which repeats the same questions (4,175 asked, 870 distinct, on a run with 49 worktrees),
    so each ref is resolved to its commit once and each pair of commits asked once. A ref that names no commit
    contains nothing and is in nothing; any other git error raises."""

    def __init__(self, repo: str, tips: dict[str, str]):
        # ref -> its commit, None if it names none; a tip's own id needs no lookup either
        self.repo, self.commits = repo, {**{tip: tip for tip in tips.values()}, **tips}
        self.known: dict[tuple[str, str], bool] = {}

    def commit(self, ref: str) -> str | None:
        if ref not in self.commits:
            try:
                self.commits[ref] = git("rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}", cwd=self.repo)
            except MeshError:
                self.commits[ref] = None
        return self.commits[ref]

    def contains(self, ancestor: str, ref: str) -> bool:
        pair = (self.commit(ancestor), self.commit(ref))
        if None in pair:
            return False
        if pair[0] == pair[1]:
            return True
        if pair not in self.known:
            proc = subprocess.run(["git", "merge-base", "--is-ancestor", *pair], cwd=self.repo, capture_output=True,
                                  text=True, env=git_env())
            if proc.returncode not in (0, 1):
                raise MeshError(f"git merge-base --is-ancestor {' '.join(pair)}: {proc.stderr.strip()}")
            self.known[pair] = proc.returncode == 0
        return self.known[pair]


def changed_files(ancestry: Ancestry, wt: dict, target: str) -> set[str]:
    """Paths a worker has touched: its own commits, plus, while its worktree exists, what is staged,
    unstaged or untracked there. Its commits start at its recorded base, so a stacked worker doesn't
    claim its parent's files, or the commits of a base it shares with others; a branch since rebased
    onto a newer `target` starts there instead. Its commits are read at `wt["tip"]`, the tip `mesh conflicts`
    read once for every check."""
    repo, tip = ancestry.repo, wt["tip"]
    start = git("merge-base", target, tip, cwd=repo)
    if wt.get("base"):
        own = git("merge-base", wt["base"], tip, cwd=repo)
        if not ancestry.contains(own, start):
            start = own
    # Raw NUL-separated paths, as `status -z` gives them, and both sides of a rename.
    diff = subprocess.run(["git", "diff", "--name-only", "-z", "--no-renames", start, tip],
                          cwd=repo, capture_output=True, text=True, env=git_env())
    if diff.returncode != 0:
        raise MeshError(f"git diff {start} {tip}: {diff.stderr.strip()}")
    files = set(diff.stdout.split("\0"))
    if Path(wt["path"]).is_dir():
        out = subprocess.run(["git", "status", "--porcelain=v2", "-z", "--untracked-files=all"],
                             cwd=wt["path"], capture_output=True, text=True, env=git_env()).stdout
        fields = iter(out.split("\0"))
        for field in fields:
            kind = field[:1]
            if kind == "1":  # changed: 8 fields, then the path
                files.add(field.split(" ", 8)[-1])
            elif kind == "2":  # renamed or copied: 9 fields and the path, then the path it came from
                files.add(field.split(" ", 9)[-1])
                files.add(next(fields, ""))
            elif kind == "u":  # unmerged: 10 fields, then the path
                files.add(field.split(" ", 10)[-1])
            elif kind == "?":
                files.add(field[2:])
    return {f for f in files if f}


def stacked(ancestry: Ancestry, parent: dict, child: dict, target: str) -> bool:
    """Whether `child` is built on `parent`'s commits: it contains them, or it started from a commit
    on `parent`'s branch past `parent`'s own start (which still holds once `parent` commits again).
    What it builds on must lie past `target`: a worker started from `target` after `parent` was rebased
    onto it, or after `parent` fast-forwarded to it, isn't stacked."""
    contains = ancestry.contains
    if (parent["committed"] and not contains(parent["branch"], target)
            and contains(parent["branch"], child["branch"])):
        return True
    base, own = child.get("base"), parent.get("base")
    return bool(base and own and base != own and contains(own, base)
                and not contains(base, target) and contains(base, parent["branch"]))


def cmd_conflicts(args: argparse.Namespace) -> int:
    """Which run branches with commits conflict with their repo's default branch, or with each other,
    and which workers' changes, committed or not, touch the same files."""
    run_id = args.run_id or identity(args)[0]
    by_repo: dict[str, dict[str, dict]] = {}  # repo -> branch -> its worktree record
    for wt in load_run(run_id).get("worktrees", []):
        if not wt.get("branch"):
            continue  # a removed peer's detached worktree
        try:
            tip = git("rev-parse", f"refs/heads/{wt['branch']}", cwd=wt["repo"])
        except MeshError:
            continue  # deleted
        seen = by_repo.setdefault(wt["repo"], {})
        if wt["branch"] not in seen or Path(wt["path"]).is_dir():  # a resumed worker's live worktree wins
            seen[wt["branch"]] = {**wt, "tip": tip, "committed": tip != wt.get("base")}
    rows, overlaps = [], []
    for repo, wts in by_repo.items():
        target = default_base(Path(repo))
        ancestry = Ancestry(repo, {b: wt["tip"] for b, wt in wts.items()})
        branches = list(wts)
        committed = [b for b in branches if wts[b]["committed"]]
        # Stacked branches (one built on the other's commits) are meant to overlap: skip those pairs.
        # Two branches still at the same commit contain each other, but aren't stacked.
        apart = [(a, b) for i, a in enumerate(branches) for b in branches[i + 1:]
                 if not stacked(ancestry, wts[a], wts[b], target) and not stacked(ancestry, wts[b], wts[a], target)]
        pairs = [(b, target) for b in committed]
        pairs += [(a, b) for i, a in enumerate(committed) for b in committed[i + 1:]
                  if not ancestry.contains(a, b) and not ancestry.contains(b, a)]
        conflicting: dict[tuple[str, str], list[str]] = {}
        for branch, against in pairs:
            files = merge_conflicts(repo, wts[against]["tip"] if against in wts else against, wts[branch]["tip"])
            if files is not None:
                rows.append({"repo": Path(repo).name, "branch": branch, "against": against, "files": files})
                conflicting[(branch, against)] = files
        # Overlap is an early warning: it also sees uncommitted work, which merge-tree can't.
        touched: dict[str, set[str]] = {}
        for b in branches:
            try:
                touched[b] = changed_files(ancestry, wts[b], target)
            except MeshError as e:  # e.g. its recorded base was garbage-collected
                print(f"mesh conflicts: no overlap check for {b}: {e}", file=sys.stderr)
        for a, b in apart:
            if a not in touched or b not in touched:
                continue
            shared = sorted((touched[a] & touched[b]) - set(conflicting.get((a, b), [])))
            if shared:
                overlaps.append({"repo": Path(repo).name, "branch": a, "against": b, "files": shared,
                                 "kind": "overlap"})
    if args.json:
        emit([{**r, "kind": "conflict"} for r in rows] + overlaps)
        return 0
    if rows:
        print_table([{**r, "files": " ".join(r["files"])} for r in rows], ("repo", "branch", "against", "files"))
    else:
        checked = sum(wt["committed"] for wts in by_repo.values() for wt in wts.values())
        print(f"No conflicts among {checked} branch(es) with commits.")
    if overlaps:
        print("\nNote: these workers change the same files (committed or not); nothing to do now; after a merge, the "
              "root has each affected worker rebase:")
        print_table([{**r, "files": " ".join(r["files"])} for r in overlaps], ("repo", "branch", "against", "files"))
    return 0


def is_worker(run_id: str | None, name: str | None) -> bool:
    return bool(run_id and name) and (((maybe_run(run_id) or {}).get("agents") or {}).get(name) or {}).get(
        "role") == "worker"


# What a worker may run (`check_worker`, at dispatch): its own messages and readings. Everything else starts
# agents or changes another agent's or the machine's mesh state, so it's the root's (or the user's).
WORKER_COMMANDS = frozenset({"send", "inbox", "whoami", "dir", "hook", "status", "log", "agents", "conflicts",
                             "peek", "brief", "model", "usage", "cost", "routing", "peers list"})
# Commands that tell a worker apart themselves: `stop` also looks at the run it is asked to stop.
OWN_WORKER_CHECK = frozenset({"stop"})
# What a worker refused a command is told: trying mesh out goes in a sandbox, never the real state.
SANDBOX_HINT = ("To try mesh commands out (reviewing agent-mesh itself, say), point MESH_HOME, MESH_WORKTREES and "
                "MESH_PEERS_DIR at temp dirs, and MESH_HERDR and MESH_CLAUDE at a missing binary: the defaults are "
                "this machine's real state, which every agent uses. The user in a shell left with a worker's "
                "variables runs `env -u MESH_RUN -u MESH_SELF -u MESH_PARENT -u MESH_ROLE mesh …`.")


def command_name(args: argparse.Namespace) -> str:
    name = args.func.__name__.removeprefix("cmd_")
    return f"peers {args.action}" if name == "peers" else name


def worker_caller(args: argparse.Namespace, *runs: str) -> tuple[str, str] | None:
    """(run, name) when the caller is a worker of a live run in this MESH_HOME, else None.

    Read from the flags and the environment, without `identity`'s side effects: the pane map names only roots,
    but a pane worker herdr restored without its variables is found by its pane (`pane_worker_entries`, in any
    run, confirmed as the pane's process; matching several, it's taken as the first). It is a worker of any run
    named (`--run`, `MESH_RUN`, then `runs`). An environment identity `inherited_identity` rejects (a Claude
    session that inherited a worker's variables) isn't that worker. Under a temp MESH_HOME the run isn't there,
    so a worker trying mesh out in a sandbox isn't one.
    """
    flag_name = getattr(args, "as_", None)
    name, vouched = flag_name or os.environ.get("MESH_SELF"), bool(flag_name)
    candidates = dict.fromkeys(r for r in (getattr(args, "run", None), os.environ.get("MESH_RUN"), *runs) if r)
    pane = os.environ.get("HERDR_PANE_ID") or ""
    if not name and (found := pane_worker_entries(pane)) and pane_runs_this_claude(pane) is True:
        candidates, name, vouched = {found[0][0]: None, **candidates}, found[0][1], True
    for run_id in candidates:
        run = maybe_run(run_id)
        if (((run or {}).get("agents") or {}).get(name) or {}).get("role") != "worker":
            continue
        if vouched or not inherited_identity(run_id, name, run):
            return run_id, name
    return None


def check_worker(args: argparse.Namespace) -> None:
    """Refuse a worker every command not in WORKER_COMMANDS (design §10, "Mesh state is guarded by `mesh`
    itself"): one check for all, so a command added later is the root's until it is listed."""
    command = command_name(args)
    if command in WORKER_COMMANDS or command in OWN_WORKER_CHECK:
        return
    if found := worker_caller(args):
        run_id, name = found
        log_event(run_id, "refused", name=name, command=command)
        raise MeshError(f"{name} is a worker of run {run_id}, and only a root runs `mesh {command}`: send your "
                        f"parent a `question` instead. {SANDBOX_HINT}")


def refuse_foreign_send(run_id: str, me: str, to: str) -> None:
    """A worker sends only to its parent: a task to itself or a sibling would reopen it without its deny list
    (`lift_read_only`), and nothing else a worker sends is for anyone else."""
    entry = agent_entry(load_run(run_id), me)
    if entry.get("role") == "worker" and to != entry.get("parent"):
        log_event(run_id, "refused", name=me, command="send", to=to)
        raise MeshError(f"{me} is a worker of run {run_id}, and a worker sends only to its parent "
                        f"({entry.get('parent')}): `mesh send parent …`")


def stopping_worker(args: argparse.Namespace) -> tuple[str, str, str]:
    """(run to stop, caller's run, caller's name): a worker never stops a run (its root does).

    With a run id to stop, the caller only has to be told apart from a worker (`worker_caller`, as at dispatch),
    and is refused as a worker of any run it names (`--run`, `MESH_RUN`) or of the target. With neither a name
    nor a run, it's the user in a plain shell. Without a run id, the caller's identity is the run.
    """
    if not args.run_id:
        run_id, me = identity(args)
        return run_id, run_id, me
    flag_run = getattr(args, "run", None)
    if flag_run and flag_run != args.run_id:
        raise MeshError(f"--run {flag_run} names another run than the one to stop ({args.run_id})")
    found = worker_caller(args, args.run_id)
    return args.run_id, *(found or ("", getattr(args, "as_", None) or os.environ.get("MESH_SELF") or ""))


def cmd_stop(args: argparse.Namespace) -> int:
    run_id, caller_run, caller = stopping_worker(args)
    if is_worker(caller_run, caller):
        log_event(caller_run, "refused", name=caller, command="stop", run=run_id)
        raise MeshError(f"{caller} is a worker of run {caller_run}, and only a root stops a run: report "
                        "`done` to your parent, which stops it (the root, if this isn't a worker: pass --as <root>)")
    run = load_run(run_id)
    for name, entry in run["agents"].items():
        if entry.get("view") == "headless":
            # Removing its worktree and archiving the run under it would lose the answer.
            holder = live_holder(name, entry)
            if holder:
                kill = "kill it" if holder["answering"] == "mesh process" else f"kill it with `kill -- -{holder['pid']}`"
                raise MeshError(f"{name} is still answering in {holder['answering']} {holder['pid']}; wait for "
                                f"it to finish (or {kill}), then stop the run")
    # Watches end with 0 from here (`stop_under_way`), not with alerts on the panes this closes; a stop that
    # fails says so, and one killed outright stops counting with its process.
    log_event(run_id, "stopping", pid=os.getpid(), start=proc_start(os.getpid()))
    try:
        return stop_run(args, run_id, run)
    except BaseException as exc:
        if not run_stopped(run_id):
            quietly(log_event, run_id, "stop_failed", error=str(exc) or type(exc).__name__)
        raise


def stop_run(args: argparse.Namespace, run_id: str, run: dict) -> int:
    """`mesh stop` past its checks: close the agents, remove clean worktrees, archive the run."""
    file_orphans(run_id)  # into the run's mailboxes, archived with it, rather than lost
    closed, kept, removed, deleted = [], [], [], []
    for name, entry in run["agents"].items():
        if entry.get("view") == "headless" and entry.get("pane"):  # a peek pane a killed `mesh ask` left open
            close_peek(run_id, name, entry["pane"])
        if entry["role"] == "root" or entry.get("status") == "retired" or entry.get("view") == "headless":
            continue
        if entry.get("view") == "bg":
            if stop_bg(entry):  # the conversation is kept, so it can be resumed
                closed.append(name)
            continue
        try:
            herdr("pane", "close", entry["pane"])
            closed.append(name)
        except HerdrError:
            pass
    for tab in run.get("tabs", {}).values():
        try:
            herdr("tab", "close", tab)
        except HerdrError:
            pass
    # What workers left running in their worktrees, retired ones too, before those are removed (design §17).
    sweep_worktrees(run_id, {name: entry for name, entry in run["agents"].items() if entry["role"] != "root"})
    # A registered peer's worktree outlives runs, and a clone's own checkout is never removed.
    keep = {Path(p["cwd"]).resolve() for p in load_peers()["peers"].values() if not peer_problem(p)}
    for wt in run.get("worktrees", []):
        path = Path(wt["path"])
        if not path.exists() or path.resolve() in keep or path.resolve() == Path(wt["repo"]).resolve():
            continue
        dirty = subprocess.run(["git", "status", "--porcelain"], cwd=path, capture_output=True, text=True,
                               env=git_env()).stdout.strip()
        if dirty or args.keep_worktrees:
            kept.append({"path": str(path), "branch": wt["branch"], "dirty": bool(dirty)})
            continue
        git("worktree", "remove", str(path), cwd=wt["repo"])
        removed.append({"path": str(path), "branch": wt["branch"]})
        if wt.get("branch") and untouched_branch(wt):
            git("branch", "-D", wt["branch"], cwd=wt["repo"])
            deleted.append(wt["branch"])
    run_worktrees = worktree_root() / run_id
    if run_worktrees.is_dir() and not any(run_worktrees.iterdir()):
        run_worktrees.rmdir()
    root = run["agents"][run["root"]]
    if root.get("renamed", True):
        try:
            herdr("agent", "rename", root["pane"], "--clear")
        except HerdrError:
            pass
    (mesh_home() / "by-pane" / f"{pane_key(root['pane'])}.json").unlink(missing_ok=True)
    log_event(run_id, "stop", closed=closed, kept=[k["path"] for k in kept])
    archive = mesh_home() / "archive" / run_id
    archive.parent.mkdir(parents=True, exist_ok=True)
    os.replace(run_dir(run_id), archive)
    emit({"run": run_id, "closed": closed, "worktrees_removed": removed, "worktrees_kept": kept,
          "archive": str(archive), "branches_deleted": deleted,
          "branches_kept": [w["branch"] for w in run.get("worktrees", [])
                            if w.get("branch") and w["branch"] not in deleted]})
    return 0


def worker_phase(entry: dict, events: list[dict], name: str, task: str | None) -> str:
    """Where a worker stands on its current task, in a line it can act on."""
    report, _ = last_report(events, name)
    if last := report["type"] if report else None:
        return {"plan": "your plan is waiting for its answer: change nothing until it says approved",
                "question": "your question is waiting for its answer"}.get(
            last, f"you reported `{last}` on it: wait for a new task or answer")
    if (task or "").startswith(READ_ONLY_STARTS):
        return "a read-only task: change nothing, and report one `done` with the answer"
    if (task or "").startswith(DIRECT_STARTS[1]):  # before the direct task: it plans first
        return ("a plan the user reviews: if the user hasn't approved your plan in your pane yet, plan in plan "
                "mode and change nothing; once it's approved, make the change, verify it, open the PR and report "
                "`done`")
    if (task or "").startswith(DIRECT_STARTS):
        return "a direct task (no plan review by your parent): make the change, verify it, open the PR, report `done`"
    if entry.get("phase") == "plan" or entry.get("planning"):
        return "planning: research, write the plan, run the `check-plan` skill on it, then send it as a `plan`, and change nothing until it is approved" + (
            " (until then mesh denies edits to your worktree and `git push`: a denial is expected, not something to "
            "work around)" if claude_deny(entry) else "")
    if entry.get("phase") == "exec":
        return "executing your approved plan: finish, verify, open the PR, then report `done`"
    return "working on it: report `done` or `failed` with `mesh send parent` when it's finished (stuck: send a `question`)"


def reminder(run_id: str, me: str, source: str) -> str:
    """What `mesh whoami --reminder` prints, for a session that may have lost its context (SessionStart hook).
    Its wording must not match `first_doorbell`, which agy's conversation lookup searches for."""
    run = load_run(run_id)
    entry = agent_entry(run, me)
    events = read_log(run_id)
    files = current_task(run_id, me, events)
    task = parse_message(files[0])[1].strip() if files else None
    lines = [f"agent-mesh reminder ({source}): you are {me}, a {entry['role']} in run {run_id}, and your parent is "
             f"{entry.get('parent')}. Run dir: {run_dir(run_id)}. Protocol: {PROTOCOL_PATH}."]
    if files:
        meta = parse_message(files[-1])[0]
        lines.append(f"Current task: {task_gist(task) or '(see the file)'} ({files[0]}"
                     + (f"; latest answer {files[-1]}, from {meta.get('from')} at {meta.get('time')}" if len(files) > 1
                        else f", from {meta.get('from')} at {meta.get('time')}") + ").")
        lines.append(f"Phase: {worker_phase(entry, events, me, task)}.")
    else:
        lines.append("No task yet.")
    report, _ = last_report(events, me)
    again = (" (it shows your current task again)" if files and source in RESET_SOURCES
             and (report["type"] if report else None) not in FINAL_TYPES else "")
    ident = f"--run {run_id} --as {me}"  # a background session cleared has a new id and no pane to rebind by
    lines.append(f"Report with `mesh send parent {ident} …`. Run `mesh inbox {ident}` now{again}.")
    return "\n".join(lines)


def cmd_whoami(args: argparse.Namespace) -> int:
    if args.reminder:  # a SessionStart hook: never an error that would break the session
        try:
            run_id, me = identity(args)
            text = reminder(run_id, me, args.reminder)
            log_event(run_id, "reminder", name=me, source=args.reminder)
        except Exception as exc:  # noqa: BLE001
            print(f"mesh whoami --reminder: {exc}", file=sys.stderr)
            return 0
        print(hook_text(text))
        return 0
    run_id, me = identity(args)
    entry = agent_entry(load_run(run_id), me)
    run = load_run(run_id)
    to_parent = native_route(run, me, entry["parent"]) if entry.get("parent") in run["agents"] else None
    emit({"run": run_id, "name": me, "role": entry["role"], "parent": entry.get("parent"),
          "dir": str(run_dir(run_id)), "unread": len(unread(run_id, me)), "view": entry.get("view"),
          "reports_by": None if entry["role"] == "root" else "socket" if "socket" in (to_parent or {})
                        else "SendMessage" if to_parent else "doorbell"})
    return 0


def cmd_dir(args: argparse.Namespace) -> int:
    run_id = identity(args)[0]
    if (run_dir(run_id) / "run.json").exists():  # a live run started before init_run made them; never a stopped one
        try:
            make_run_folders(run_id)
        except OSError as e:
            print(f"mesh: can't make the folders in {run_dir(run_id)}: {e.strerror or e}", file=sys.stderr)
    print(run_dir(run_id))
    return 0


def cmd_model(args: argparse.Namespace) -> int:
    args.kind = args.kind or default_kind()
    args.effort = args.effort or plan_effort_for(args.kind)
    if (args.model or "auto") == "auto":
        model, notes = plan_model(args.kind, args.effort)
        for note in notes:
            print(f"mesh: {note}", file=sys.stderr)
    else:
        model = args.model
    print(agent_argv(args.kind, model, args.effort)[1])
    return 0


def claude_usage_text(usage: dict | None) -> str:
    """One line of Claude's windows: `five-hour window 28% (resets 07:20) · weekly window 16% (…)`, with the
    reading's age when it came from a cache."""
    if not usage or not usage.get("windows"):
        return "unknown (no reading: see `mesh usage`)"
    parts = [f"{CLAUDE_WINDOWS[k]} {w['used']:.0f}% (resets {reset_text(w['resets'])})"
             for k, w in usage["windows"].items()]
    age = time.time() - usage.get("fetched", 0)
    return " · ".join(parts) + ("" if usage.get("source") == "live" else f" [cached {ago(age)} ago]")


def quota_line(run: dict | None = None) -> str:
    """`mesh status`'s quota line, from what mesh already read (no network): Claude's windows, the agy limits at
    the reserve, the reserve, and whether this run was let past it."""
    parts = [f"Claude {claude_usage_text(claude_usage(network=False))}"]
    try:
        rows = parse_usage((mesh_home() / "agy-usage.txt").read_text())
    except OSError:
        rows = []
    spent = [f"{r['group']} {r['label'].lower()} {r['left']}% left" for r in rows if r["left"] <= min_quota()]
    if spent:
        parts.append("agy at the reserve: " + ", ".join(spent))
    tail = f"reserve: mesh stops at {quota_stop()}% used"
    if (run or {}).get("over_reserve"):
        tail += " (off for this run: `mesh reserve on`)"
    return "quota: " + "; ".join(parts) + f"; {tail}"


def cmd_usage(args: argparse.Namespace) -> int:
    args.effort, args.exec_effort = args.effort or plan_effort_for("agy"), args.exec_effort or exec_effort_for("agy")
    claude = claude_usage(force=args.refresh)
    rows = agy_usage(force=args.refresh)
    plan = execute = exec_quota = None
    notes: list[str] = []
    if rows:
        try:
            plan, notes = choose_agy_model(plan_chain("agy"), args.effort, fallback=False)
        except MeshError as exc:
            notes = [str(exc)]
        execute = resolve_agy_model(exec_model_for("agy"), args.exec_effort)
        exec_quota = model_quota(execute, listing_names(agy_model_listing()).get(execute, ""), rows)
    if args.json:
        emit({"claude": claude, "rows": rows, "plan": plan, "exec": execute, "exec_left": exec_quota and exec_quota[0],
              "notes": notes, "quota_stop": quota_stop(), "min_quota": min_quota()})
        return 0
    spent = [CLAUDE_WINDOWS[k] for k, w in ((claude or {}).get("windows") or {}).items() if w["used"] >= quota_stop()]
    print(f"Claude: {claude_usage_text(claude)}" + (f" — at the reserve: {', '.join(spent)}" if spent else ""))
    if rows:
        print()
        print_table(rows, ("group", "label", "left", "resets"))
        print(f"\nplan on {plan or 'nothing (every model is at the reserve)'}, execute on {execute}"
              + (f" ({exec_quota[0]}% left)" if exec_quota else ""))
        for note in notes:
            print(f"  {note}")
    else:
        print("agy: `agy -p /usage` gave no quota rows")
    print(f"\nreserve: mesh starts nothing new on a quota once {quota_stop()}% of it is used (MESH_QUOTA_STOP)")
    return 0


def cmd_reserve(args: argparse.Namespace) -> int:
    """Let this run go on past the quota reserve, or hold it to it again (root only)."""
    run_id, me = identity(args)
    if (load_run(run_id)["agents"].get(me) or {}).get("role") != "root":
        raise MeshError("only the run's root lets its run past the quota reserve")
    if args.state:
        with editing_run(run_id) as run:
            run["over_reserve"] = args.state == "off"
        log_event(run_id, "reserve_" + args.state, name=me)
    print(quota_line(load_run(run_id)))
    return 0


# ── root context: measuring, resetting and briefing the root ─────────────


CACHE_TTL = 3600  # seconds a prompt cache lives when the session file doesn't say (`line_ttl`), and for agy
ROOT_RESET_AT = 200_000  # root context tokens past which mesh suggests `mesh reset`, and its watch resets it idle
RESET_WAIT = 1800  # seconds a reset waits for the root's turn to end and its input box to empty
RESET_POLL = 2.0
RESET_QUIET_READS = 2  # idle reads in a row before typing: a gap between two tool calls isn't the turn's end
CLEAR_CONFIRM = 15  # seconds for a typed /clear to show up as a new session
CLEAR_FILE_GRACE = 5  # seconds the root's process file gets to follow a /clear herdr has already reported
AUTORESET_EVERY = 60  # seconds between a root watch's idle-reset checks
AUTORESET_BACKOFF = 3600  # seconds before a root watch starts another idle reset (a failing one shouldn't repeat)
AUTORESET_QUIET = 300  # seconds a root must have been still after a turn mesh started before its watch resets it
AUTORESET_USER_QUIET = 1800  # ...after a turn the user started (or when that can't be told): it may wait on them
BLOCKING_TYPES = ("plan", "question")  # unread reports that keep the root from resetting: a worker waits on them
QUIET_STATES = ("idle", "done")
# herdr's `--lines N` is the screen's last N rows, blank ones under the content included: on a tall pane with
# little on it (a root just cleared) the box sits higher than PANE_READ_LINES reaches.
RESET_READ_LINES = 200


def quietly(fn, *args, **kwargs):
    """`fn(...)`, or None if it fails: for readings and hints that must never fail the command that asked."""
    try:
        return fn(*args, **kwargs)
    except Exception:  # noqa: BLE001
        return None


def caller(args: argparse.Namespace, run_id: str | None) -> tuple[str, str | None]:
    """(run, own name) for a command that may name another run than the caller's: the name is None unless the
    caller is an agent of that run. Its own identity is resolved as any command's, so nothing of the named run
    is touched (no rebind, no address) when it isn't the caller's."""
    if not run_id:
        return identity(args)
    try:
        own_run, name = identity(args)
    except MeshError:
        return run_id, None
    return run_id, name if own_run == run_id else None


def env_int(key: str, default: int) -> int:
    try:
        return int(os.environ.get(key) or default)
    except ValueError:
        return default


def cache_ttl(session_ttl: int | None = None) -> int:
    """The root's cache lifetime: MESH_CACHE_TTL when set (a live check fakes a short one), else what its session
    file says Claude Code used (`line_ttl`), else CACHE_TTL."""
    if os.environ.get("MESH_CACHE_TTL"):
        return env_int("MESH_CACHE_TTL", CACHE_TTL)
    return session_ttl or CACHE_TTL


def root_reset_at() -> int:
    return env_int("MESH_ROOT_RESET_AT", ROOT_RESET_AT)


def autoreset_on() -> bool:
    """The root's watch resets an idle root (design §15): on unless MESH_ROOT_AUTORESET=0."""
    return os.environ.get("MESH_ROOT_AUTORESET") != "0"


def last_turn_by_user(path: Path, chunk: int = 1 << 20, limit: int = 8 << 20) -> bool | None:
    """Whether the newest turn of a Claude session file was started by the user: True for a prompt typed in the
    pane (`origin.kind` "human", or none), False for one mesh or a tool brought (a socket doorbell is a `peer`
    meta entry, a background watch's exit a `task-notification`, a typed doorbell starts with `📬 [mesh]`), None
    when no prompt is found in the last `limit` bytes. Meta entries, tool results, interrupts and local command
    output aren't prompts (they carry no origin). A doorbell that lands mid-turn is queued into the turn the user
    started, so a mesh prompt with a typed one before it and no finished reply (`end_turn`) between still makes
    the turn the user's."""
    mesh_seen = False
    try:
        with open(path, "rb") as fh:
            end, rest = fh.seek(0, os.SEEK_END), b""
            stop = max(0, end - limit)
            while end > stop:
                start = max(stop, end - chunk)
                fh.seek(start)
                lines = (fh.read(end - start) + rest).split(b"\n")
                rest = lines.pop(0) if start else b""
                for line in reversed(lines):
                    if mesh_seen and b'"end_turn"' in line and b'"assistant"' in line:
                        return False  # a finished reply before the mesh prompt: the turn was mesh's
                    if b'"user"' not in line:
                        continue
                    try:
                        event = json.loads(line)
                    except ValueError:
                        continue
                    if event.get("type") != "user":
                        continue
                    kind = (event.get("origin") or {}).get("kind")
                    if kind not in (None, "human"):
                        mesh_seen = True
                        continue
                    content = (event.get("message") or {}).get("content")
                    if event.get("isMeta") or event.get("toolUseResult") is not None or (
                            isinstance(content, list) and any(isinstance(c, dict) and c.get("type") == "tool_result"
                                                              for c in content)):
                        continue
                    text = content if isinstance(content, str) else " ".join(
                        c.get("text") or "" for c in content or [] if isinstance(c, dict))
                    text = text.lstrip()
                    if mesh_seen and text.startswith("[Request interrupted"):
                        return False  # the turn before the mesh prompt ended there
                    if not text or text.startswith(("[Request interrupted", "<local-command")):
                        continue
                    if text.startswith("📬 [mesh]"):
                        mesh_seen = True
                        continue
                    return True
                end = start
    except OSError:
        return None
    return False if mesh_seen else None


def pane_agent(pane: str) -> dict:
    """herdr's record of a pane's agent ({} if it has none)."""
    try:
        return herdr("agent", "get", pane).get("agent") or {}
    except HerdrError:
        return {}


def reported_session(pane: str) -> str | None:
    """The session herdr's Claude integration last reported for the pane (anything in it can report one)."""
    return (pane_agent(pane).get("agent_session") or {}).get("value")


def root_session(entry: dict, as_root: bool = False,
                 recorded: Callable[[], str | None] | None = None) -> str | None:
    """The root's current conversation. Claude: the session of the Claude process leading the root's pane
    (`leader_session`), which nothing else in the pane can change. When that can't be told, what herdr's
    Claude integration reports for the pane (it follows a /clear: seen live); a command the root itself runs
    (`as_root`) may use the session it runs under when herdr agrees or can't say. When they disagree, either
    can be stale: a root watch that outlived a reset runs under the old session, and herdr takes a session
    report from anything in the pane (a nested `claude -c -p`). `recorded()`, the session the root's last reset
    confirmed (read only when needed), joins them, so a caller with no session of its own (the watch, a
    detached reset) doesn't have herdr's word alone. The root's is then the one whose session file was written
    last: a root command runs inside a live turn, which has just written its own, and an idle root's last turn
    came after a nested run it started.
    Never the caller's session otherwise: a worker's isn't the root's. agy: the one its last `mesh reset`
    recorded, as nothing ties an agy conversation to a pane before."""
    if entry.get("kind") == "agy":
        return entry.get("session")
    if current := leader_session(entry["pane"]):
        return current
    reported = reported_session(entry["pane"])
    own = os.environ.get("CLAUDE_CODE_SESSION_ID") if as_root else None
    if own and reported in (None, own):
        return own
    if not own and not reported:
        return None
    choices = [s for s in dict.fromkeys((own, reported, recorded() if recorded else None)) if s]  # ties: first

    def written(session: str) -> float:
        path = root_transcript(entry, session)
        try:
            return path.stat().st_mtime if path else float("-inf")
        except OSError:
            return float("-inf")

    return max(choices, key=written)


def root_transcript(entry: dict, session: str) -> Path | None:
    """A Claude root's session file: under its cwd's project folder, else wherever Claude started it."""
    if path := claude_transcript(entry, session):
        return path
    return next(iter(sorted((claude_home() / "projects").glob(f"*/{session}.jsonl"))), None)


def root_context(run: dict, as_root: bool = False) -> dict | None:
    """The root's context size and cache state, or None when it can't be read (an agy root before its first
    reset, a session file not found). The cache is cold once the conversation has been still for its TTL: its
    next turn then rewrites every token but the ~25k static prefix (system prompt and tools, cached machine-wide)
    at the cache-write price, where a warm one reads them all at a twentieth of the input price."""
    entry = run["agents"].get(run.get("root")) or {}
    session = root_session(entry, as_root, lambda: reset_session(run["id"], run.get("root"))) \
        if entry.get("pane") else None
    if not session:
        return None
    session_ttl = None
    if entry.get("kind") == "agy":
        tokens, files = agy_context_tokens(session), progress_files({"kind": "agy"}, session)
        transcript = agy_conversation_file(session)
    else:
        transcript = root_transcript(entry, session)
        tokens, session_ttl = transcript_usage(transcript) if transcript else (None, None)
        files = [transcript] if transcript else []
    if tokens is None:
        return None
    last = max((f.stat().st_mtime for f in files if f.exists()), default=None)
    idle = time.time() - last if last else None
    ttl = cache_ttl(session_ttl)
    return {"kind": entry.get("kind"), "session": session, "transcript": str(transcript), "tokens": tokens,
            "last_turn": datetime.fromtimestamp(last, timezone.utc).isoformat(timespec="seconds") if last else None,
            "idle": round(idle) if idle is not None else None, "ttl": ttl,
            "cold": idle is not None and idle > ttl, "reset_at": root_reset_at()}


def kilo(tokens: int) -> str:
    return f"{tokens / 1000:.0f}k"


def context_text(context: dict) -> str:
    """`root context 452k, cache cold since 14:02` (or warm, with how long it has been still)."""
    text = f"root context {kilo(context['tokens'])}"
    if context.get("last_turn") is None:
        return text
    if context["cold"]:
        since = datetime.fromisoformat(context["last_turn"]) + timedelta(seconds=context["ttl"])
        return f"{text}, cache cold since {since.astimezone():%H:%M}"
    return f"{text}, cache warm ({ago(context['idle'])} since its last turn)"


def root_mail(run_id: str, root: str, types: tuple[str, ...] = REPORT_TYPES) -> list[dict]:
    """The root's unread reports of these types (who sent which), oldest first."""
    found = []
    for path in unread(run_id, root):
        meta, _ = parse_message(path)
        if meta.get("type") in types:
            found.append(meta)
    return found


def mail_text(mail: list[dict]) -> str:
    return ", ".join(f"a {m.get('type')} from {m.get('from')}" for m in mail)


# `reset_noted`: a root command showed the root that its last reset failed or was cancelled (once is enough).
RESET_EVENTS = ("reset_requested", "reset", "reset_failed", "reset_cancelled", "reset_noted")


def last_reset(events: list[dict]) -> dict | None:
    return next((e for e in reversed(events) if e.get("event") in RESET_EVENTS), None)


def reset_session(run_id: str, root: str | None) -> str | None:
    """The session the root's last reset confirmed (`root_session` weighs it against herdr's report)."""
    return next((e.get("new_session") for e in reversed(read_log(run_id))
                 if e.get("event") == "reset" and e.get("name") == root), None)


def reset_lock_path(run_id: str) -> Path:
    return run_dir(run_id) / "reset.lock"


def reset_pending(run_id: str) -> bool:
    """Whether a detached reset is running: it holds the run's reset lock until it ends."""
    path = reset_lock_path(run_id)
    if not path.exists():
        return False
    with path.open("a") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(handle, fcntl.LOCK_UN)
    return False


def root_line(run_id: str, about_to_wait: bool = False) -> tuple[str | None, bool]:
    """The hint a root command prints about the root's own context, or None (design §15).

    A `/clear` never re-reads the old context, so a reset costs the fresh session's small prefix whenever it
    happens; what it saves is the next turns of the big one: all but its static prefix rewritten at the
    cache-write price once the cache is cold, all of it at a twentieth while warm (design §15 says why the
    threshold compares the whole size). Hence: reset now when cold, or when about to wait (the next report may well
    come after the cache expired); while warm, only when very big, at a quiet point. The second value says
    whether the line reports a failed or cancelled reset, which it does once.
    """
    run = load_run(run_id)
    events = read_log(run_id)
    notes = []
    last = last_reset(events)
    if reset_pending(run_id):
        return None, False
    failure = bool(last and last["event"] in ("reset_failed", "reset_cancelled"))
    if failure:
        what = "failed" if last["event"] == "reset_failed" else "was cancelled"
        notes.append(f"the last `mesh reset` {what} {ago(age_seconds(last['time']))}: {last.get('reason')}")
    context = root_context(run, as_root=True)
    at = root_reset_at()
    if context and context["tokens"] > at:
        reset = 'write notes.md, then run `mesh reset --next "<what you do next>"` and end your turn'
        waits = root_mail(run_id, run["root"])
        if context["cold"]:
            notes.append(f"{context_text(context)}: its next turn re-reads all of it at the cache-write price; {reset}"
                         + (f", once you've handled {mail_text(waits)}" if waits else ""))
        elif about_to_wait and not waits:
            notes.append(f"{context_text(context)}, and you're about to wait on workers: a report that wakes you "
                         f"after the cache expires ({ago(context['ttl'])}) re-reads all of it at the cache-write price; {reset}")
        elif context["tokens"] > 2 * at:
            notes.append(f"{context_text(context)}: at your next quiet point (a phase boundary, nothing waiting "
                         f"on you), {reset}")
    return "; ".join(notes) or None, failure


def root_hint(run_id: str, about_to_wait: bool = False) -> None:
    """Print `root_line` on stderr; never fails the command (like `warn_unwatched`). For root commands only."""
    line, failure = quietly(root_line, run_id, about_to_wait) or (None, False)
    if line:
        print(f"mesh: {line} (see ORCHESTRATE.md, \"Your own context\")", file=sys.stderr)
    if failure:
        quietly(log_event, run_id, "reset_noted", name=(maybe_run(run_id) or {}).get("root"))


def start_reset(run_id: str, root: str, next_task: str | None, compact: str | None, via: str) -> int:
    """Start the detached process that resets the root once its turn ends, holding the run's reset lock.

    The lock is taken here and handed down (the child inherits the open file through `pass_fds` and holds it
    until it exits), so two `mesh reset` calls can't both start one. The child gets
    no Claude session variables: it is nobody's tool, and names the root with --run/--as.
    """
    path = reset_lock_path(run_id)
    handle = path.open("a")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        raise MeshError("a reset is already pending for this run (`mesh log` shows how it goes)")
    log = run_dir(run_id) / "logs" / "reset.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    argv = [sys.executable, str(Path(__file__).absolute()), "reset", "--run", run_id, "--as", root,
            "--detached", "--via", via,
            *(["--next", next_task] if next_task else []), *(["--compact", compact] if compact is not None else [])]
    env = {k: v for k, v in os.environ.items() if k not in CLAUDE_SESSION_VARS and k not in MESH_IDS}
    try:
        with open(log, "a") as out:
            proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, env=env,
                                    start_new_session=True, pass_fds=(handle.fileno(),))
    finally:
        handle.close()  # the child holds the lock now: same open file, its own descriptor
    log_event(run_id, "reset_requested", name=root, via=via, next=next_task, compact=compact, pid=proc.pid)
    return proc.pid


def cmd_reset(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    if args.detached:
        return reset_root(run_id, me, args.next, args.compact, args.via)
    run = load_run(run_id)
    entry = run["agents"].get(me) or {}
    if entry.get("role") != "root":
        raise MeshError("only a run's root resets itself: `mesh reset` clears its own pane (a worker's context "
                        "is compacted by `mesh resume`)")
    if entry.get("kind") not in KINDS or not entry.get("pane"):
        raise MeshError(f"{me} has no Claude or agy pane to reset")
    if waits := root_mail(run_id, me, BLOCKING_TYPES):
        raise MeshError(f"{mail_text(waits)} waits on you: answer it first (`mesh inbox`), then reset")
    pid = start_reset(run_id, me, args.next, args.compact, via="command")
    emit({"pending": True, "pid": pid, "next": args.next, "compact": args.compact,
          "log": str(run_dir(run_id) / "logs" / "reset.log"),
          "then": "end your turn now: once it has ended (and the box is empty), mesh types "
                  f"{'/compact' if args.compact is not None else '/clear'} into your pane, then a prompt that "
                  "points you at `mesh brief`"})
    return 0


# A Claude process's own `status` (`process_record`) when its turn is over: `idle`, or `shell` (idle with a
# background shell task, such as the root's own watch). `busy` covers a foreground tool call; `waiting` is a
# dialog, a permission prompt or a question to the user, which a typed /clear would answer.
TURN_OVER = ("idle", "shell")
STATUS_STILL = 5  # seconds a lost root's process must have read TURN_OVER before its turn counts as ended
LOST_AFTER = 30  # seconds herdr must read the root `unknown` before a reset that can't judge it gives up
LOST_ROOT = "herdr has lost track of this root's pane: restart herdr's agent detection or /clear by hand"


class LostRoot(MeshError):
    """herdr reads the root `unknown` and nothing else can tell whether its turn has ended."""


def lost_root_quiet(entry: dict) -> tuple[bool, str]:
    """For a Claude root herdr reads `unknown` (an agent it lost): whether its turn has ended, from the status
    Claude itself keeps in the process file of the Claude still leading its pane (TURN_OVER for STATUS_STILL
    seconds). Raises LostRoot when that can't be told: no such Claude, or an agy root."""
    record = leader_record(entry["pane"]) if entry.get("kind") == "claude" else None
    if not record or not record.get("status"):
        raise LostRoot(LOST_ROOT)
    try:
        still = max(0.0, time.time() - float(record.get("statusUpdatedAt") or 0) / 1000)
    except (TypeError, ValueError):
        still = 0.0
    if record["status"] not in TURN_OVER or still < STATUS_STILL:
        return False, f"herdr has lost track of it, and its process reads {record['status']}"
    return True, ""


def quiet_box(pane: str, entry: dict | None = None, lost_ok: bool = True) -> tuple[bool, str]:
    """Whether the pane's agent has ended its turn with an empty input box, and if not, why not.

    Claude runs a typed /clear at once even mid-turn, throwing the turn away (live test, design §15), so the
    check is positive: herdr reads idle or done, and the box reads empty (ghost text is dim, not typed). A
    draft, or a box that can't be read, holds it. A Claude root herdr reads `unknown` is judged by its process's
    own status instead (`lost_root_quiet`, given its `entry`), unless `lost_ok` is false (a compaction, which
    waits on herdr's status): then, as when its process can't tell, it raises LostRoot (which `reset_root`
    takes as final only once `unknown` has lasted LOST_AFTER).
    """
    agent = pane_agent(pane)
    status = agent.get("agent_status")
    if not agent:
        return False, "its pane has no agent"
    if status == "unknown" and entry is not None:
        if not lost_ok:
            raise LostRoot(f"{LOST_ROOT} (a --compact needs herdr to see the compaction run)")
        ok, why = lost_root_quiet(entry)
        if not ok:
            return ok, why
    elif status not in QUIET_STATES:
        return False, f"it reads {status}"
    lines = pane_lines(pane, RESET_READ_LINES, ansi=True)
    typed = typed_text(lines) if lines is not None else None
    if typed is None:
        return False, "its input box can't be read"
    if typed:
        return False, "a draft is in its input box"
    return True, ""


def agy_conversations() -> set[str]:
    folder = agy_conversation_file("x").parent
    return {p.stem for p in folder.glob("*.db")} if folder.is_dir() else set()


def cleared_session(entry: dict, file_before: str | None, agy_before: set[str],
                    reported_before: str | None = None) -> set[str]:
    """The new conversation(s) a typed /clear started, once one shows; empty if none showed in time.

    Claude: the root's process file (`leader_session`) moving off `file_before`, its session before the clear,
    which a nested Claude can't fake. herdr's report moving to a session that is neither `reported_before` nor
    `file_before` counts too, as it did before the file was read: at once when there is no file, else once the
    file has had CLEAR_FILE_GRACE more seconds to follow, so a file that is slow to follow never fails a reset
    that worked. The first such report is kept, as herdr's next reads may flicker. agy: conversation files that
    weren't there before (another agy may have started one meanwhile: `agy_root_conversation` tells them
    apart)."""
    seen_at, seen = None, None  # when herdr first reported a new session, and which
    for second in range(CLEAR_CONFIRM + CLEAR_FILE_GRACE):
        if seen_at is None and second >= CLEAR_CONFIRM:
            break
        if entry.get("kind") == "agy":
            if new := agy_conversations() - agy_before:
                return new
        else:
            current = leader_session(entry["pane"])
            if current and file_before and current != file_before:
                return {current}
            reported = reported_session(entry["pane"])
            if seen is None and reported and reported not in (reported_before, file_before):
                seen_at, seen = second, reported
            if seen and (file_before is None and current is None or second - seen_at >= CLEAR_FILE_GRACE):
                return {seen}
        time.sleep(1)
    return set()


def agy_root_conversation(before: set[str], token: str) -> str | None:
    """Which new agy conversation (not in `before`) is the root's: the one whose first prompt (agy's index keeps
    it as `preview`) is the bootstrap carrying this reset's token. A lone new one isn't taken on trust: another
    agy may have started it while the root's own isn't indexed yet, so the index is polled for a while; None
    when it never shows."""
    source = Path(os.environ.get("MESH_AGY_SUMMARIES") or Path.home() / AGY_HOME / "conversation_summaries.db")
    for _ in range(CLEAR_CONFIRM):
        try:
            mtime = max(f.stat().st_mtime for f in (source, source.with_name(source.name + "-wal")) if f.exists())
        except (OSError, ValueError):
            mtime = None
        if mtime is not None:
            for row in agy_summaries(str(source), mtime):
                if row["conversationId"] not in before and f"(ref {token})" in row["display"]:
                    return row["conversationId"]
        time.sleep(1)
    return None


def bootstrap_text(run_id: str, root: str, next_task: str | None, compacted: bool, token: str,
                   via: str = "command") -> str:
    """The prompt a reset root wakes to. It is a doorbell (so `human_draft` takes a leftover copy for ours), but
    a root's: it has no parent to report to. After the watch's idle reset, the root may have been waiting on the
    user: ORCHESTRATE has it write such a question to notes.md, and the prompt says to look there."""
    what = "compacted your session" if compacted else "gave you a fresh session (your earlier context is gone)"
    then = next_task or "carry on from the next step in your notes"
    if via == "watch":
        then += ("; if notes.md says you were waiting on an answer from the user, ask the user again rather "
                 "than going on without it")
    return (f"{DOORBELL_PREFIX} (ref {token}) You are {root}, the root of agent-mesh run {run_id}, and `mesh reset` "
            f"just {what}. You have no parent to report to. Run `mesh brief` and rebuild your picture from it, "
            f"not from memory. Then: {then}")


def reset_root(run_id: str, root: str, next_task: str | None, compact: str | None, via: str = "command") -> int:
    """The detached half of `mesh reset`: wait for the root's turn to end, type /clear (or /compact), confirm it,
    then type the bootstrap prompt. Every outcome is a `reset*` event, which the root's next command shows."""
    run = load_run(run_id)
    entry = run["agents"][root]
    pane, kind = entry["pane"], entry.get("kind")
    context = quietly(root_context, run)
    deadline = time.monotonic() + env_int("MESH_RESET_WAIT", RESET_WAIT)
    quiet, why = 0, "it never read idle"

    def failed(event: str, reason: str) -> int:
        log_event(run_id, event, name=root, reason=reason)
        print(f"mesh reset: {event}: {reason}", flush=True)
        return 1

    lost_since = None  # when herdr began reading it `unknown` with nothing else to judge it by

    def quiet_now() -> tuple[bool, str]:
        """quiet_box, with a LostRoot final only once it has lasted LOST_AFTER: herdr may be re-detecting."""
        nonlocal lost_since
        try:
            ok, why = quiet_box(pane, entry, lost_ok=compact is None)
        except LostRoot:
            lost_since = time.monotonic() if lost_since is None else lost_since
            if time.monotonic() - lost_since >= LOST_AFTER:
                raise
            return False, "it reads unknown"
        lost_since = None
        return ok, why

    while True:
        try:
            ok, why = quiet_now()
        except LostRoot as exc:
            return failed("reset_failed", str(exc))
        quiet = quiet + 1 if ok else 0
        if quiet >= RESET_QUIET_READS:
            with ring_lock(pane) as locked:  # nothing else types into the pane meanwhile
                try:
                    ok, why = quiet_now() if locked else (False, "another ring holds its pane")
                except LostRoot as exc:
                    return failed("reset_failed", str(exc))
                if ok:
                    if waits := root_mail(run_id, root, BLOCKING_TYPES):  # a report on its way rings after this
                        return failed("reset_cancelled", f"{mail_text(waits)} arrived")
                    reported_before = reported_session(pane) if kind != "agy" else None
                    file_before = leader_session(pane) if kind != "agy" else None
                    before = entry.get("session") if kind == "agy" else file_before or reported_before
                    agy_before = agy_conversations() if kind == "agy" else set()
                    command = f"/compact {compact}".strip() if compact is not None else "/clear"
                    try:
                        if compact is not None:  # a compaction is a turn: it starts working, then ends
                            herdr("agent", "prompt", pane, command, "--wait", "--until", "working",
                                  "--timeout", "15000", timeout=30)
                        else:  # a clear is no turn: herdr sees no change and would call it stalled
                            herdr("agent", "prompt", pane, command, timeout=30)
                    except HerdrError as exc:
                        return failed("reset_failed", f"typing {command} failed: {exc.code}")
                    break
            quiet = 0
        if time.monotonic() > deadline:
            return failed("reset_failed", f"gave up after waiting {ago(env_int('MESH_RESET_WAIT', RESET_WAIT))}: "
                                          f"{why}")
        time.sleep(RESET_POLL)
    if compact is not None:
        try:
            herdr("agent", "wait", pane, "--until", "idle", "--until", "done", "--timeout",
                  str(COMPACT_TIMEOUT * 1000), timeout=COMPACT_TIMEOUT + 30)
        except HerdrError as exc:
            return failed("reset_failed", f"the compaction didn't finish: {exc.code}")
        candidates = {before} if before else set()  # a compaction keeps the conversation
    else:
        candidates = cleared_session(entry, file_before, agy_before, reported_before)
        if not candidates:
            return failed("reset_failed", "the /clear didn't show up as a new session; no prompt typed")
    token = ring_token()
    result = ring([pane], bootstrap_text(run_id, root, next_task, compact is not None, token, via), token)
    if not result["rung"]:
        return failed("reset_failed", f"its session was reset, but the prompt to run `mesh brief` didn't get "
                                      f"through ({result['error']})")
    note = None
    if compact is not None:
        new = before
    elif kind == "agy":
        new = agy_root_conversation(agy_before, token)
        if new is None:
            note = "couldn't tell which new agy conversation is the root's; it isn't measured until its next reset"
    else:
        new = next(iter(candidates), None)
    if kind == "agy":  # recorded so it is measured from now on; a guess would measure someone else's
        with editing_run(run_id) as data:
            data["agents"][root]["session"] = new
    log_event(run_id, "reset", name=root, via=via, compact=compact, next=next_task, old_session=before,
              new_session=new, tokens=(context or {}).get("tokens"),
              transcript=(context or {}).get("transcript"), **({"note": note} if note else {}))
    print(f"mesh reset: done ({before} → {new})", flush=True)
    return 0


def maybe_autoreset(run_id: str, run: dict, events: list[dict]) -> bool:
    """The root's own watch (unless MESH_ROOT_AUTORESET=0): reset a root that is over the threshold, idle, owed
    nothing and quiet, warm or cold (design §15). Quiet is AUTORESET_QUIET since its last turn when mesh started
    that turn, AUTORESET_USER_QUIET when the user did or it can't be told (`last_turn_by_user`): a root answering
    the user may be waiting on them. Stricter than `mesh reset`: any unread report holds it, since it acts without
    the root's say.
    A Claude root herdr reads `unknown` counts as idle when its own process says its turn is over
    (`lost_root_quiet`); when that can't be told, nothing starts, and the next poll looks again."""
    root = run.get("root")
    entry = run["agents"].get(root) or {}
    if entry.get("kind") not in KINDS or not entry.get("pane") or reset_pending(run_id):
        return False
    last = next((e for e in reversed(events) if e.get("event") == "reset_requested"), None)
    if last and age_seconds(last["time"]) < AUTORESET_BACKOFF:
        return False  # a failing one shouldn't repeat every minute (nor every 5 on a 5-minute cache)
    context = root_context(run)
    if not context or context["tokens"] <= root_reset_at() or context.get("idle") is None or root_mail(run_id, root):
        return False
    by_user = last_turn_by_user(Path(context["transcript"])) if entry.get("kind") == "claude" else None
    if context["idle"] < (AUTORESET_QUIET if by_user is False else AUTORESET_USER_QUIET):
        return False
    status = pane_agent(entry["pane"]).get("agent_status")
    if status == "unknown" and entry.get("kind") == "claude":
        try:
            if not lost_root_quiet(entry)[0]:
                return False
        except LostRoot:
            return False
    elif status not in QUIET_STATES:
        return False
    start_reset(run_id, root, "carry on supervising: your watch reset you while you were idle",
                None, via="watch")
    return True


BRIEF_TEXT = 4000  # characters of board.md and of notes.md a brief carries
BRIEF_REQUEST = 1000  # characters of the run's request
BRIEF_ROWS = 25
BRIEF_MAIL = 10


def capped(text: str, limit: int, more: str) -> str:
    """`text` up to `limit` characters, cut at a line end, then what was left out and where to read it."""
    if len(text) <= limit:
        return text
    cut = text.rfind("\n", 0, limit)
    cut = cut if cut > limit // 2 else limit
    return f"{text[:cut].rstrip()}\n… {len(text) - cut} more characters: {more}"


def capped_list(items: list[str], limit: int, more: str) -> list[str]:
    return items if len(items) <= limit else [*items[:limit], f"… {len(items) - limit} more: {more}"]


def brief(run_id: str, me: str) -> dict:
    """What a fresh root needs, in one bounded read (design §15): the run's request and procedure, the notes and
    board it kept, each worker's derived state, what waits on it, its PRs, unread mail headers and the last
    reset. Each part is capped, and says where the rest is."""
    run = load_run(run_id)
    folder = run_dir(run_id)
    events = read_log(run_id)
    rows = status_rows(run_id, run)
    root = run.get("root")
    workers = [r for r in rows if r["role"] != "root"]
    lines = []
    for r in workers:
        line = f"{r['name']} ({r['kind']} {r['model'] or '?'}, {r['size'] or 'large'}, {r['view']}): {r['state']}"
        line += f"; {r['waiting']}" if r["waiting"] else ""
        line += " ← needs you" if r["needs"] == "root" else ""
        lines.append(line)
    prs = [f"{p['url']}: {p['state']}" + (f", checks {p['checks']}" if p.get("checks") else "")
           + f" (by {r['name']})" for r in workers for p in r.get("prs") or []]
    mail = []
    for path in unread(run_id, me):
        meta, body = parse_message(path)
        mail.append(f"{meta.get('type')} from {meta.get('from')} at {meta.get('time')}: {first_line(body, 120)}")
    texts = {}
    for name in ("notes.md", "board.md"):
        path = folder / name
        texts[name] = {"path": str(path),
                       "text": capped(path.read_text(errors="replace").strip(), BRIEF_TEXT, f"cat {path}")
                       if path.exists() else None}
    reset = next((e for e in reversed(events) if e.get("event") == "reset"), None)
    context = quietly(root_context, run, as_root=me == root)
    procedure = ("you are the run's root: follow ~/.config/agent-mesh/ORCHESTRATE.md (Root, and Task lists or "
                 "Questions and reviews as this run needs) and PROTOCOL.md; read them again now if this session "
                 "hasn't") if me == root else (f"you are {me}, not this run's root ({root}): this is its view of "
                                               "the run, and nothing in it is yours to act on")
    return {
        "run": run_id, "mode": run["mode"], "dir": str(folder), "you": me, "root": root,
        "request": capped(run.get("request") or "", BRIEF_REQUEST,
                          f"python3 -c 'import json; print(json.load(open(\"{folder / 'run.json'}\"))[\"request\"])'"),
        "procedure": procedure,
        "root_context": context, "notes": texts["notes.md"], "board": texts["board.md"],
        "workers": capped_list(lines, BRIEF_ROWS, "mesh status"),
        "needs_root": [r["name"] for r in rows if r["needs"] == "root"],
        "prs": capped_list(prs, BRIEF_ROWS, "mesh agents --run " + run_id),
        "unread": capped_list(mail, BRIEF_MAIL, "mesh inbox --peek"),
        "unwatched": quietly(unwatched, run_id) or [],
        "any_watch": bool(quietly(watched, run_id, ANY_WATCH)),
        "last_reset": reset and {"time": reset["time"], "next": reset.get("next"),
                                 "old_transcript": reset.get("transcript")},
        "repos_dir": [str(d) for d in quietly(repos_dirs) or []],
    }


def render_brief(b: dict) -> str:
    out = [f"run {b['run']} ({b['mode']}), {b['dir']}", f"request: {b['request'] or '(none recorded)'}",
           b["procedure"] + ".",
           "policy (models, reviewers, rounds, tiny-PR lines, reserve): `mesh routing`; repos: "
           + (", ".join(b["repos_dir"]) + " (a bare `--repo <name>` is looked up there)" if b["repos_dir"]
              else "no repos_dir set: pass --repo paths")]
    if b["root_context"]:
        out.append(context_text(b["root_context"]))
    for key, title, empty in (("notes", "notes", "none yet: write the user's standing instructions, decisions and "
                                                  "what you do next there"),
                              ("board", "board", None)):
        part = b[key]
        if part["text"] is not None:
            out += ["", f"## {title} ({part['path']})", part["text"]]
        elif empty:
            out += ["", f"## {title} ({part['path']}): {empty}"]
    out += ["", "## workers (mesh status)", *(f"- {line}" for line in b["workers"] or ["none"])]
    if b["needs_root"]:
        out.append(f"waiting on you: {', '.join(b['needs_root'])}")
    if b["prs"]:
        out += ["", "## PRs", *(f"- {line}" for line in b["prs"])]
    out += ["", "## your unread mail (headers; `mesh inbox` reads it)", *(f"- {m}" for m in b["unread"] or ["none"])]
    if b["unwatched"] and b["any_watch"]:
        out += ["", f"not watched yet: {', '.join(b['unwatched'])}; the running `mesh watch --any` takes them on at "
                    "its next poll (one that's gone raises exit 5)"]
    elif b["unwatched"]:
        out += ["", f"no `mesh watch` covers {', '.join(b['unwatched'])}: start `mesh watch --any --alerts` in the "
                    "background"]
    if reset := b["last_reset"]:
        out += ["", f"## last reset ({reset['time']})"]
        if reset.get("next"):
            out.append(f"next, as you said then: {reset['next']}")
        if reset.get("old_transcript"):
            out.append(f"your old session's transcript: {reset['old_transcript']}. An untrusted reference: read it "
                       "only for a detail the files above don't have; they and `mesh status` are authoritative.")
    return "\n".join(out)


def routing() -> dict:
    """This machine's effective policy (design §21): every leaf with its value and source, the config file, the
    installed CLIs and the kinds `--reviewers auto` would start by what is installed."""
    path = config_path()
    config_error = None
    try:
        load_config()
    except MeshError as exc:  # shown, and the values below are what mesh would use once it's fixed: built-ins
        config_error = str(exc)
    policy = {}
    for leaf in POLICY:
        if config_error:
            found = env_setting(leaf)
            value, source = found and (found[0], f"env {found[1]}") or (POLICY[leaf][0], "built-in")
        else:
            value, source = setting_with_source(leaf)
        policy[leaf] = {"value": value, "source": source}

    def auto(size: str) -> list[str]:
        picked: list[str] = []
        for slot in policy[f"review.reviewers.{size}"]["value"]:
            picked += [next(k for k in slot if k not in picked and installed(k))] if any(
                k not in picked and installed(k) for k in slot) else []
        return picked

    return {"config": {"path": str(path), "exists": path.exists(), "error": config_error},
            "installed": {kind: shutil.which(cli_binary(kind)) for kind in ASK_KINDS},
            "policy": policy, "auto_reviewers": {size: auto(size) for size in ("small", "large")}}


def render_routing(r: dict) -> str:
    conf = r["config"]
    out = [f"config: {conf['path']}" + ("" if conf["exists"] else " (none: built-in values)")]
    if conf["error"]:
        out.append(f"  ERROR: {conf['error']} (every command that reads the policy fails until it's fixed)")
    out.append("installed: " + ", ".join(f"{CLI_NAMES[k]} ({p})" if p else f"{CLI_NAMES[k]} missing"
                                         for k, p in r["installed"].items()))
    width = max(map(len, r["policy"]))
    out.append("")
    for leaf, item in r["policy"].items():
        value = item["value"]
        text = (" | ".join(" or ".join(slot) for slot in value) if leaf.startswith("review.reviewers.")
                else ", ".join(value) if isinstance(value, list) else json.dumps(value) if isinstance(value, bool)
                else str(value))
        out.append(f"{leaf.ljust(width)}  {text or '(none)'}  [{item['source']}]")
    out.append("")
    out.append("--reviewers auto, by what's installed (a round also needs agy's quota and Copilot with no recent "
               "quota error):")
    for size, kinds in r["auto_reviewers"].items():
        out.append(f"  {size}: {' + '.join(kinds) or 'nobody: a round of this size is refused'}")
    return "\n".join(out)


def cmd_routing(args: argparse.Namespace) -> int:
    data = routing()
    if args.json:
        emit(data)
    else:
        print(render_routing(data))
    return 1 if data["config"]["error"] else 0


def cmd_brief(args: argparse.Namespace) -> int:
    run_id, me = identity(args)
    data = brief(run_id, me)
    if args.json:
        emit(data)
    else:
        print(render_brief(data))
    return 0


# ── cost: spend per agent from session files ─────────────────────────────


# $ per million tokens: input, cache write 5 min, cache write 1 h, cache read, output. Checked 2026-10-28 against
# the `claude-api` skill of Claude Code 2.1.312 (its model table cached 2026-10-06; writes are 1.25x the input
# price at 5 min, 2x at 1 h). It states no Haiku read price: 0.1x, as the cost study took it. A model is priced by
# its family, at that family's newest model's price (an older Opus as Opus 5.5, though Opus 4.x cost $5/$25),
# and a model no family names as Opus. API prices stand in for what the
# subscription limit counts, which is undocumented (docs/cost-research/README.md, "Method").
PRICES = {
    "fable": (10.0, 12.5, 20.0, 0.25, 50.0),
    "opus": (4.0, 5.0, 8.0, 0.20, 20.0),
    "sonnet": (2.0, 2.5, 4.0, 0.20, 10.0),
    "haiku": (0.10, 0.125, 0.20, 0.01, 0.50),
}
PRICES_AS_OF = "2026-10-28, claude-api skill (Claude Code 2.1.312)"
COLD_WRITE_MIN = 20_000  # cache-write tokens past which a call after a gap longer than the TTL reads as a cold resume
# A root command at the start of a shell command (`cd x && mesh spawn …`, `for …; do mesh ask …`, `timeout 900
# mesh watch`, `X=1 mesh ask`), not quoted in other text (`grep "mesh spawn"`).
ROOT_COMMAND_RE = re.compile(r"(?:^|[;&|(]|\b(?:do|then|else|time)\b)\s*(?:timeout\s+\S+\s+)?(?:\w+=\S*\s+)*"
                             r"mesh (?:spawn|init|ask|approve|resume|switch|watch)\b", re.M)
TOKEN_KEYS = ("input", "w5", "w1", "read", "output")


def call_cost(call: dict) -> float:
    """A call's price in dollars (`PRICES`); agy calls have none."""
    if call["model"] == "agy":
        return 0.0
    prices = next((p for family, p in PRICES.items() if family in call["model"]), PRICES["opus"])
    return sum(call[key] * price for key, price in zip(TOKEN_KEYS, prices)) / 1e6


def stamp_epoch(stamp: str | None) -> float | None:
    try:
        return datetime.fromisoformat(stamp[:-1] + "+00:00" if stamp[-1:] in "zZ" else stamp).timestamp()
    except (TypeError, ValueError):
        return None


def prompt_text(content) -> str | None:
    """A user record's typed text: a string, or its text blocks; None for tool results."""
    if isinstance(content, str):
        return content
    texts = [c.get("text") or "" for c in content or () if isinstance(c, dict) and c.get("type") == "text"]
    return " ".join(texts) if texts else None


def claude_calls(path: Path) -> tuple[list[dict], dict]:
    """Every API call in a Claude session file, oldest first, and what the file says of its session: its
    `entrypoint` (`sdk-cli` for `claude -p`), `cwd`, whether its first prompt was a mesh doorbell and whether it
    ran a root command (`ROOT_COMMAND_RE` in a Bash call).

    Claude Code writes one record per content block of a reply (thinking, text, each tool call), each with the
    reply's whole usage, so calls are folded by `message.id`: summing records counts most calls two or three times
    (Gas Town's ledger did, until it deduped). Read line by line with no length limit: a reply holding a big tool
    call is one line of megabytes (Gas Town's 64 KB scanner dropped those). A call's context is what `line_tokens`
    sums; a write with no TTL split is taken as 1 h.
    """
    calls, seen = [], set()
    info = {"entrypoint": None, "cwd": None, "doorbell": False, "root_commands": False}
    prompted = False
    try:
        with open(path, "rb") as fh:
            for line in fh:
                reply = b'"usage"' in line and b'"assistant"' in line
                if not reply and (prompted or b'"user"' not in line):
                    continue
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(event, dict):
                    continue
                info["entrypoint"] = info["entrypoint"] or event.get("entrypoint")
                info["cwd"] = info["cwd"] or event.get("cwd")
                message = event.get("message") or {}
                if event.get("type") == "user" and not prompted and not event.get("isMeta"):
                    text = prompt_text(message.get("content"))
                    if text is not None:
                        prompted, info["doorbell"] = True, text.lstrip().startswith("📬 [mesh]")
                    continue
                if event.get("type") != "assistant":
                    continue
                content = message.get("content")
                for block in content if isinstance(content, list) else ():
                    if isinstance(block, dict) and block.get("name") == "Bash" and ROOT_COMMAND_RE.search(
                            str((block.get("input") or {}).get("command") or "")):
                        info["root_commands"] = True
                usage, key = message.get("usage"), message.get("id") or event.get("requestId")
                at = stamp_epoch(event.get("timestamp"))
                if not usage or key in seen or message.get("model") == "<synthetic>" or at is None:
                    continue
                if key:
                    seen.add(key)
                writes = usage.get("cache_creation") or {}
                w5, w1 = (int(writes.get(f"ephemeral_{ttl}_input_tokens") or 0) for ttl in ("5m", "1h"))
                w1 += max(0, int(usage.get("cache_creation_input_tokens") or 0) - w5 - w1)
                calls.append({"id": key, "t": at, "model": message.get("model") or "", "input": int(usage.get("input_tokens") or 0),
                              "w5": w5, "w1": w1, "read": int(usage.get("cache_read_input_tokens") or 0),
                              "output": int(usage.get("output_tokens") or 0)})
    except OSError:
        return [], info
    calls.sort(key=lambda c: c["t"])
    return calls, info


def agy_calls(session: str) -> list[dict]:
    """An agy conversation's model calls, oldest first, in tokens: a step's time is field 1 of its `metadata`
    (a protobuf Timestamp, seconds first) and its usage field 9, as `agy_context_tokens` reads it (2 the input read
    fresh, 5 read from cache, 3 the output)."""
    try:
        import sqlite3  # here, so a Python built without it only loses agy's rows
    except ImportError:
        return []
    path = agy_conversation_file(session)
    if not path.exists():
        return []
    try:
        db = sqlite3.connect(f"{path.resolve().as_uri()}?mode=ro", uri=True, timeout=2)
        try:
            rows = db.execute("SELECT metadata FROM steps ORDER BY idx").fetchall()
        finally:
            db.close()
    except (sqlite3.Error, ValueError):
        return []
    calls = []
    for (metadata,) in rows:
        if not isinstance(metadata, bytes):
            continue
        try:
            fields = protobuf_fields(metadata)
            usage = next((v for f, v in fields if f == 9 and isinstance(v, bytes)), b"")
            stamp = next((v for f, v in fields if f == 1 and isinstance(v, bytes)), b"")
            counts = {f: v for f, v in protobuf_fields(usage) if isinstance(v, int)}
            seconds = next((v for f, v in protobuf_fields(stamp) if f == 1 and isinstance(v, int)), None)
        except (ValueError, IndexError):
            continue
        if 2 in counts and seconds:
            calls.append({"id": None, "t": float(seconds), "model": "agy", "input": counts[2], "w5": 0, "w1": 0,
                          "read": counts.get(5, 0), "output": counts.get(3, 0)})
    return calls


def cost_kind(name: str, entry: dict, root: bool) -> str:
    """The kind an agent's spend is counted under, as the cost study classified sessions."""
    if root:
        kind = "root"
    elif entry.get("peer"):
        kind = "peer"
    elif entry.get("review_heads") or entry.get("reviews") or re.search(r"-review-\d+", name):
        kind = "reviewer"
    elif entry.get("read_only"):
        kind = "asker"
    else:
        kind = f"worker {entry.get('size') or '?'} {entry.get('view') or 'pane'}"
    return f"agy {kind}" if entry.get("kind") == "agy" else kind


def reviewed_pr(name: str, entry: dict) -> list[str]:
    """The PR a reviewer's spend is for: the one its name gives (`<repo>-review-<n>`, one reviewer per PR and
    vendor), else the last it recorded. `reviews` alone over-counts: a resume carries the earlier ones along."""
    if not (entry.get("review_heads") or entry.get("reviews") or re.search(r"-review-\d+", name)):
        return []
    if number := re.search(r"-review-(\d+)", name):
        return [f"{Path(entry.get('repo') or '').name}#{number.group(1)}"]
    return list(entry.get("reviews") or ())[-1:]


def phase_marks(name: str, entry: dict, events: list[dict]) -> list[tuple[float, str]]:
    """(time, phase) where an agent's phase changes: `plan`, `exec`, or "" (no plan phase).

    Its entry starts at its spawn or resume (a resume writes a fresh one). The first change after it tells what it
    started in: a `plan approved` or a `plan_phase_ended` ends a plan phase, a `planned task` starts one; with
    none, its current `phase` is still the one it started in.
    """
    start = epoch(entry.get("spawned"))
    changes = sorted([(epoch(m.get("at")), {"plan approved": "exec", "planned task": "plan"}[m["why"]])
                      for m in entry.get("models") or () if m.get("why") in ("plan approved", "planned task")]
                     + [(epoch(e.get("time")), "") for e in events
                        if e.get("event") == "plan_phase_ended" and e.get("name") == name
                        and epoch(e.get("time")) >= start])
    if changes:
        first = "" if changes[0][1] == "plan" else "plan"
    else:
        first = "plan" if entry.get("phase") == "plan" else ""
    return [(start, first), *changes]


def phase_at(marks: list[tuple[float, str]], t: float) -> str:
    """The phase at `t`; "" before the first mark (a worker resumed in its own run: the fresh entry's marks start
    at the resume, and what came before is unknown)."""
    phase = ""
    for at, value in marks:
        if at <= t:
            phase = value
    return phase


def cost_segments() -> tuple[dict[str, list[dict]], dict[str, dict]]:
    """Where each conversation's calls belong, from every run, live and archived: {session: [segment]} and
    {run: its window}.

    A segment is one agent of one run under one of its sessions: its run, name, kind, phase marks, and when it
    started (a worker's first spawn or resume in its run; a root's run `created`) and ended (its run's last `stop`;
    a run never stopped, `CACHE_TTL` after its last event or at the next run in its root's directory). A worker's sessions are its `session` and the ones swaps copied from (`sessions`), an agy one found
    pinned by its first doorbell when none is recorded; a root's also every `reset`'s old and new session.
    """
    segments: dict[str, list[dict]] = {}
    windows: dict[str, dict] = {}
    runs = all_runs()
    came_from = {(run["id"], name): (entry["resumed_from"].get("run"), entry["resumed_from"].get("name"))
                 for run, _ in runs for name, entry in run["agents"].items()
                 if isinstance(entry.get("resumed_from"), dict)}

    def first_name(key: tuple) -> str:
        """The name an agent had before any resume renamed it (`<name>-2`)."""
        for _ in range(len(came_from) + 1):
            if key not in came_from or came_from[key] == key:
                break
            key = came_from[key]
        return key[1]

    for run, folder in runs:
        events = read_log(run["id"], folder)
        stops = [epoch(e.get("time")) for e in events if e.get("event") == "stop"]
        last = max((epoch(e.get("time")) for e in events), default=epoch(run.get("created")))
        window = {"start": epoch(run.get("created")), "end": max(stops) if stops else last + CACHE_TTL,
                  "root": run.get("root"), "cwd": (run["agents"].get(run.get("root")) or {}).get("cwd"),
                  "stopped": bool(stops),
                  "resets": [epoch(e.get("time")) for e in events if e.get("event") == "reset"]}
        windows[run["id"]] = window
        for name, entry in run["agents"].items():
            if entry.get("kind") not in KINDS:
                continue  # Copilot keeps no session file of ours to read
            root = entry.get("role") == "root"
            sessions = [entry.get("session"), *(s if isinstance(s, str) else (s or {}).get("session")
                                                for s in entry.get("sessions") or ())]
            if root:
                sessions += [e.get(key) for e in events if e.get("event") == "reset" and e.get("name") == name
                             for key in ("old_session", "new_session")]
            elif entry.get("kind") == "agy" and not entry.get("session"):
                sessions.append(quietly(agy_conversation, name, run["id"], None, True))
            # A resume in the same run writes a fresh entry: the log keeps when the agent first started in it.
            starts = [epoch(t) for t in (entry.get("spawned"), *(m.get("at") for m in entry.get("models") or ()),
                                         *(e.get("time") for e in events
                                           if e.get("event") in ("spawn", "resume") and e.get("name") == name))
                      if epoch(t)]
            segment = {"run": run["id"], "name": name, "kind": cost_kind(name, entry, root), "root": root,
                       "start": window["start"] if root else min(starts, default=window["start"]),
                       "end": window["end"], "marks": [] if root else phase_marks(name, entry, events),
                       "agy": entry.get("kind") == "agy", "prs": reviewed_pr(name, entry), "cwd": entry.get("cwd"),
                       "who": first_name((run["id"], name))}
            for session in dict.fromkeys(s for s in sessions if s):
                segments.setdefault(session, []).append(segment)
    # A run never stopped ends a cache lifetime after its last event, or where the next run in its root's
    # directory starts, if sooner. A fixed end (never "still open"), so a report doesn't change with the clock.
    for run_id, window in windows.items():
        if not window.pop("stopped"):
            later = [w["start"] for w in windows.values() if w["cwd"] == window["cwd"] and w["start"] > window["start"]]
            window["end"] = min([window["end"], *later])
    return segments, windows


def segment_at(segments: list[dict], t: float) -> dict | None:
    """The segment a call at `t` belongs to: a root's while its run is open, else the worker segment that started
    last before it. A call before a worker segment's start but after the one before it ended (a resume's headless
    `/compact`, run before the reopen is recorded) goes to the later one; one before every segment (the session's
    life before mesh adopted it) to none."""
    for segment in segments:
        if segment["root"] and segment["start"] <= t and (segment["end"] is None or t <= segment["end"]):
            return segment
    chosen = None
    for segment in sorted((s for s in segments if not s["root"]), key=lambda s: s["start"]):
        if segment["start"] <= t:
            chosen = segment
        elif chosen is None:
            return None
        elif chosen["end"] is not None and t > chosen["end"]:
            return segment
        else:
            break
    return chosen


def root_fallback(windows: dict[str, dict], cwd: str | None, t: float) -> dict | None:
    """A root segment for a session no run names that ran root commands in a root's cwd while its run was open
    (a `/clear` typed by hand starts one; only `mesh reset` records it)."""
    for run_id, window in windows.items():
        if cwd and window["cwd"] == cwd and window["start"] <= t and (window["end"] is None or t <= window["end"]):
            return {"run": run_id, "name": window["root"], "kind": "root", "root": True, "marks": [], "prs": []}
    return None


def parse_since(text: str, now: datetime | None = None) -> float:
    """A window's edge, in epoch seconds: a span back from now (`7d`, `36h`, `90m`) or ISO 8601 (local time
    without an offset, a date alone at its midnight)."""
    now = now or datetime.now(timezone.utc)
    if span := re.fullmatch(r"(\d+)([dhm])", text.strip().lower()):
        return (now - timedelta(**{{"d": "days", "h": "hours", "m": "minutes"}[span.group(2)]: int(span.group(1))})
                ).timestamp()
    try:
        at = datetime.fromisoformat(text[:-1] + "+00:00" if text[-1:] in "zZ" else text)
    except ValueError as exc:
        raise MeshError(f"{text}: give a span back from now (7d, 36h) or ISO 8601 (2026-11-04, 2026-11-04T09:00)") \
            from exc
    return (at if at.tzinfo else at.astimezone()).timestamp()


class CostTally:
    """Sums calls by agent and by kind, with cold resumes and each new session's first call (its static prefix)."""

    def __init__(self):
        self.agents: dict[tuple, dict] = {}
        self.kinds: dict[str, dict] = {}

    @staticmethod
    def blank() -> dict:
        return {"sessions": set(), "calls": 0, **{k: 0 for k in TOKEN_KEYS}, "usd": 0.0, "ctx": 0,
                "plan": 0.0, "exec": 0.0, "cold": 0, "cold_usd": 0.0, "sub_usd": 0.0, "firsts": []}

    def add(self, session: str, call: dict, kind: str, agent: tuple, phase: str, sub: bool, cold: bool,
            first: bool) -> None:
        usd = call_cost(call)
        rows = [self.kinds.setdefault(kind + (" subagents" if sub else ""), self.blank())]
        row = self.agents.setdefault(agent, {**self.blank(), "kind": kind})
        if sub:
            row["sub_usd"] += usd
        else:
            rows.append(row)
        for r in rows:
            r["sessions"].add(session)
            r["calls"] += 1
            r["usd"] += usd
            r["ctx"] += call["input"] + call["w5"] + call["w1"] + call["read"]
            for key in TOKEN_KEYS:
                r[key] += call[key]
            if phase in ("plan", "exec"):
                r[phase] += usd
            if cold:
                r["cold"] += 1
                r["cold_usd"] += usd
            if first:
                r["firsts"].append(call["input"] + call["w5"] + call["w1"] + call["read"])


def tally_session(tally: CostTally, session: str, calls: list[dict], sub: bool, place, since: float | None,
                  until: float | None, seen: set[str]) -> None:
    """Add one session file's calls to the tally: `place(call)` gives (kind, agent key, phase) or None to skip it.
    A call whose id is in `seen` was counted in an earlier file (the one a copy was made from): it is skipped, but
    still times the gaps, so the copy's first own call after it can read as a cold resume.

    A cold resume is a main-conversation call after a gap longer than the cache's TTL (what the previous writing
    call wrote at, `CACHE_WRITES`, else `CACHE_TTL`) that writes at least `COLD_WRITE_MIN` tokens."""
    ttl, last = CACHE_TTL, None
    for index, call in enumerate(calls):
        cold = not sub and last is not None and call["t"] - last > ttl and call["w5"] + call["w1"] >= COLD_WRITE_MIN
        last = call["t"]
        if call["w1"] or call["w5"]:
            ttl = CACHE_WRITES["ephemeral_1h_input_tokens" if call["w1"] else "ephemeral_5m_input_tokens"]
        if call["id"]:
            if call["id"] in seen:
                continue
            seen.add(call["id"])
        if (since is not None and call["t"] < since) or (until is not None and call["t"] >= until):
            continue
        if placed := place(call):
            kind, agent, phase = placed
            tally.add(session, call, kind, agent, phase, sub, cold, first=index == 0 and not sub)


def session_files(session: str, cwd: str | None) -> list[Path]:
    """A Claude session's file (under its cwd's project folder, else wherever Claude started it), if any."""
    if cwd and (path := claude_sessions_dir(cwd) / f"{session}.jsonl").exists():
        return [path]
    return sorted((claude_home() / "projects").glob(f"*/{session}.jsonl"))[:1]


def recent_files(paths, since: float | None) -> set[Path]:
    """The files written at or after `since` (all with None); one removed meanwhile is skipped."""
    found = set()
    for path in paths:
        try:
            if since is None or path.stat().st_mtime >= since:
                found.add(path)
        except OSError:
            continue
    return found


def subagent_files(path: Path) -> list[Path]:
    return sorted(path.with_suffix("").glob("subagents/*.jsonl"))


def run_cost(run_id: str | None, since: float | None, until: float | None) -> dict:
    """Spend per agent and per kind: of one run's agents (`run_id`), or of every session in [since, until)."""
    segments, windows = cost_segments()
    if run_id and run_id not in windows:
        raise MeshError(f"unknown run {run_id} (`mesh agents` lists runs)")
    tally, agy_tally = CostTally(), CostTally()
    worktrees = re.sub(r"[^A-Za-z0-9]", "-", str(worktree_root()))
    reviewed: dict[str, set] = {}

    def placer(session: str, info: dict, path: Path, sub: bool):
        mine = segments.get(session, [])

        def place(call: dict):
            segment = segment_at(mine, call["t"]) if mine else None
            if not segment and info.get("root_commands"):
                segment = root_fallback(windows, info.get("cwd"), call["t"])
            if segment:
                if run_id and segment["run"] != run_id:
                    return None
                for pr in segment["prs"]:
                    reviewed.setdefault(pr, set()).add(segment.get("who") or segment["name"])  # one through resumes
                return segment["kind"], (segment["run"], segment["name"]), phase_at(segment["marks"], call["t"])
            if run_id:
                return None
            if worktrees in path.parent.name or info.get("doorbell"):
                kind = "worker (unmapped)"
            else:
                kind = "headless" if info.get("entrypoint") == "sdk-cli" else "user"
            return kind, ("", kind), ""
        return place

    if run_id:  # the run's sessions, and what its root's project folder holds of its window
        window = windows[run_id]
        claude = {s: seg["cwd"] for s, segs in segments.items() for seg in segs
                  if seg["run"] == run_id and not seg["agy"]}
        files = {path for s, cwd in claude.items() for path in session_files(s, cwd)}
        if window["cwd"]:
            files |= recent_files(claude_sessions_dir(window["cwd"]).glob("*.jsonl"), window["start"])
        agy = {s for s, segs in segments.items() for seg in segs if seg["run"] == run_id and seg["agy"]}
    else:
        files = recent_files((claude_home() / "projects").glob("*/*.jsonl"), since)
        agy = {p.stem for p in recent_files(agy_conversation_file("x").parent.glob("*.db"), since)}
    # A background swap or resume copies the conversation into a new session file, its calls' ids included, and so
    # do other forks (a `/resume` that branches, a relaunch): each call counts once. A file run state names goes
    # first (its calls belong to that agent), then the one whose calls start first, or on a tie (a copy keeps the
    # timestamps) end first: the original stopped where the copy goes on.
    read = []
    for path in files:
        calls, info = claude_calls(path)
        read.append((path, calls, info, False, path.stem))
        read += [(sub, claude_calls(sub)[0], info, True, path.stem) for sub in subagent_files(path)]
    seen: set[str] = set()
    for path, calls, info, sub, session in sorted(read, key=lambda r: (r[4] not in segments, *((r[1][0]["t"], r[1][-1]["t"]) if r[1] else (0, 0)),
                                                       str(r[0]))):
        tally_session(tally, session, calls, sub, placer(session, info, path, sub), since, until, seen)
    for session in sorted(agy):
        mine = segments.get(session, [])

        def place_agy(call: dict, mine=mine):
            segment = segment_at(mine, call["t"]) if mine else None
            if segment:
                if run_id and segment["run"] != run_id:
                    return None
                return segment["kind"], (segment["run"], segment["name"]), phase_at(segment["marks"], call["t"])
            return None if run_id else ("agy user", ("", "agy user"), "")
        tally_session(agy_tally, session, agy_calls(session), False, place_agy, since, until, set())
    resets = [t for r, w in windows.items() if not run_id or r == run_id for t in w["resets"]
              if (since is None or t >= since) and (until is None or t < until)]
    return cost_report(tally, agy_tally, reviewed, len(resets))


def cost_report(tally: CostTally, agy_tally: CostTally, reviewed: dict[str, set], resets: int) -> dict:
    total = sum(r["usd"] for r in tally.kinds.values())

    def kind_row(kind: str, r: dict) -> dict:
        writes = r["w5"] + r["w1"]
        firsts = sorted(r["firsts"])
        return {"kind": kind, "sessions": len(r["sessions"]), "calls": r["calls"], "usd": round(r["usd"], 2),
                "share": round(100 * r["usd"] / total, 1) if total else 0.0,
                "usd_per_call": round(r["usd"] / r["calls"], 4) if r["calls"] else 0.0,
                "ctx_per_call": r["ctx"] // r["calls"] if r["calls"] else 0,
                "out_per_call": r["output"] // r["calls"] if r["calls"] else 0,
                **{key: r[key] for key in TOKEN_KEYS},
                "write_5m_share": round(100 * r["w5"] / writes, 1) if writes else 0.0,
                "first_ctx_median": firsts[len(firsts) // 2] if firsts else None,
                "cold": r["cold"], "cold_usd": round(r["cold_usd"], 2)}

    agents = [{"run": run, "name": name, "kind": r["kind"], "calls": r["calls"],
               **{key: r[key] for key in TOKEN_KEYS}, "usd": round(r["usd"], 2), "plan_usd": round(r["plan"], 2),
               "exec_usd": round(r["exec"], 2), "sub_usd": round(r["sub_usd"], 2), "cold": r["cold"],
               "cold_usd": round(r["cold_usd"], 2)}
              for (run, name), r in tally.agents.items()]
    review_usd = sum(r["usd"] for k, r in tally.kinds.items() if k.startswith("reviewer"))
    return {"prices_as_of": PRICES_AS_OF, "usd": round(total, 2),
            "agents": sorted(agents, key=lambda a: -(a["usd"] + a["sub_usd"])),
            "kinds": sorted((kind_row(k, r) for k, r in tally.kinds.items()), key=lambda r: -r["usd"]),
            "agy": sorted(({"kind": k, "sessions": len(r["sessions"]), "calls": r["calls"], "input": r["input"],
                            "read": r["read"], "output": r["output"]} for k, r in agy_tally.kinds.items()),
                          key=lambda r: -(r["input"] + r["read"])),
            "reviews": {"prs": len(reviewed), "usd": round(review_usd, 2),
                        "usd_per_pr": round(review_usd / len(reviewed), 2) if reviewed else None,
                        "reviewers_per_pr": round(sum(map(len, reviewed.values())) / len(reviewed), 1)
                        if reviewed else None},
            "resets": resets}


def tokens_text(n: int) -> str:
    return f"{n / 1e6:.1f}M" if n >= 1e6 else f"{n / 1e3:.0f}k"


def cmd_cost(args: argparse.Namespace) -> int:
    since = parse_since(args.since) if args.since else None
    until = parse_since(args.until) if args.until else None
    if since is not None and until is not None and since >= until:
        raise MeshError(f"--since {args.since} is not before --until {args.until}")
    run_id = args.run_id
    if not run_id and since is None:
        try:
            run_id = identity(args)[0]
        except MeshError as exc:
            raise MeshError("name a run, or a window with --since (`mesh cost --since 7d`)") from exc
    report = run_cost(run_id, since, until)
    scope = f"run {run_id}" if run_id else "every session"
    if since is not None or until is not None:
        def edge(t: float | None, none: str) -> str:
            return datetime.fromtimestamp(t).astimezone().strftime("%Y-%m-%d %H:%M") if t else none
        scope += f", {edge(since, 'start')} → {edge(until, 'now')}"
    report["scope"] = scope
    if args.json:
        emit(report)
        return 0
    print(f"{scope}: ${report['usd']:,.2f} at API prices ({PRICES_AS_OF})")
    if (run_id or args.agents) and report["agents"]:
        print()
        print_table([{**a, "agent": f"{a['name']}" if run_id else f"{a['run']}:{a['name']}" if a["run"] else a["name"],
                      "$": f"{a['usd']:.2f}", "plan/exec": f"{a['plan_usd']:.2f}/{a['exec_usd']:.2f}",
                      "sub $": f"{a['sub_usd']:.2f}", "cold": f"{a['cold']} (${a['cold_usd']:.2f})" if a["cold"] else "",
                      **{k: tokens_text(a[k]) for k in TOKEN_KEYS}} for a in report["agents"]],
                    ("agent", "kind", "calls", "input", "w1", "w5", "read", "output", "$", "plan/exec", "sub $",
                     "cold"))
    if report["kinds"]:
        print()
        print_table([{**k, "$": f"{k['usd']:.2f}", "%": f"{k['share']}", "$/call": f"{k['usd_per_call']:.3f}",
                      "ctx/call": tokens_text(k["ctx_per_call"]), "out/call": k["out_per_call"],
                      "5m %": k["write_5m_share"], "prefix": tokens_text(k["first_ctx_median"])
                      if k["first_ctx_median"] is not None else "",
                      "cold": f"{k['cold']} (${k['cold_usd']:.2f})" if k["cold"] else ""} for k in report["kinds"]],
                    ("kind", "sessions", "calls", "$", "%", "$/call", "ctx/call", "out/call", "5m %", "prefix",
                     "cold"))
    if report["agy"]:
        print("\nagy (tokens; no prices):")
        print_table([{**a, **{k: tokens_text(a[k]) for k in ("input", "read", "output")}} for a in report["agy"]],
                    ("kind", "sessions", "calls", "input", "read", "output"))
    reviews = report["reviews"]
    if reviews["prs"]:
        print(f"\nreviews: {reviews['prs']} PRs, ${reviews['usd']:.2f} (${reviews['usd_per_pr']:.2f} per PR, "
              f"{reviews['reviewers_per_pr']} Claude reviewers per PR)")
    print(f"root resets: {report['resets']}")
    return 0


# ── CLI ──────────────────────────────────────────────────────────────────


def compact_args(p: argparse.ArgumentParser) -> None:
    p.add_argument("--compact", choices=("auto", "yes", "no"), default="auto",
                   help=f"compact the conversation before reopening it (auto: over {COMPACT_AT:,} tokens for Claude, "
                        f"{AGY_COMPACT_AT:,} for agy, twice that for a question unless asked of a peer; an agy one whose size can't be "
                        "read when it comes from another run)")
    p.add_argument("--focus", help="what the compaction keeps (default: what the task needs)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="mesh", description=__doc__.split("\n\n")[0])
    parser.add_argument("--version", action="version", version=f"mesh {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    def ident(p):
        p.add_argument("--run", help="run id (default: $MESH_RUN or this pane's run)")
        p.add_argument("--as", dest="as_", help="act as this agent (default: $MESH_SELF)")
        return p

    p = sub.add_parser("init", help="start a run with this pane's agent as its root")
    p.add_argument("--mode", choices=MODES, required=True)
    p.add_argument("--request", help="the user's request, kept in run.json")
    p.add_argument("--run-id", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_init)

    p = ident(sub.add_parser("spawn", help="start a worker agent in a herdr pane, or in the background"))
    p.add_argument("--kind", choices=KINDS, help="default: agy, or claude when agy isn't installed")
    p.add_argument("--role", choices=ROLES, default="worker")
    p.add_argument("--repo", default=".", help="repo the agent works on (default: cwd)")
    p.add_argument("--model", help="auto (default: plan on the best model with quota, execute on --exec-model), "
                                    "or one model throughout: claude alias, agy family (argon, flash, opus, sonnet) or exact id")
    p.add_argument("--exec-model", help="model after `mesh approve` (default with auto: the kind's exec model, "
                                         "`mesh routing`)")
    p.add_argument("--effort", choices=EFFORTS,
                   help="effort for the whole task, planning and execution (default: the kind's plan_effort "
                        "planning, exec_effort executing, `mesh routing`)")
    p.add_argument("--exec-effort", choices=EFFORTS,
                   help="effort after `mesh approve` (default: --effort, else the kind's exec_effort)")
    p.add_argument("--name", help="what goes after the repo in the agent's name (default: the worktree slug)")
    where = p.add_mutually_exclusive_group()
    where.add_argument("--worktree", metavar="SLUG", help="create a worktree on branch mesh/<run>/<SLUG>")
    where.add_argument("--cwd", help="start in an existing directory, e.g. an earlier worker's worktree")
    p.add_argument("--base", help="base ref for --worktree (default: origin/HEAD)")
    p.add_argument("--parent", help="parent agent (default: you)")
    p.add_argument("--task", help="first task message")
    p.add_argument("--task-file", help="first task message from a file (- for stdin)")
    p.add_argument("--size", choices=SIZES, help="trivial / small: one model, no plan phase (claude: opus, "
                                                  "in the background); large (default): plan, review, execute")
    p.add_argument("--view", choices=VIEWS, help="pane (herdr) or bg (`claude --bg`, Claude only; default by size)")
    p.add_argument("--plan-review", choices=("user",),
                   help="user: the user approves the plan in the worker's pane (claude, opus in plan mode)")
    p.set_defaults(func=cmd_spawn)

    p = ident(sub.add_parser("send", help="send a message (mailbox first, then the doorbell)"))
    p.add_argument("to", help="agent name, or `parent`")
    p.add_argument("--type", choices=TYPES, required=True)
    p.add_argument("--until", help="a `wait`'s end: a duration (45m, 1h30m), a local time (14:30) or ISO 8601")
    p.add_argument("--unread-ok", action="store_true",
                   help="send a plan/question/done/failed even though a task or answer is still unread")
    p.add_argument("--body")
    p.add_argument("--file", help="message body from a file (- for stdin)")
    p.set_defaults(func=cmd_send)

    p = ident(sub.add_parser("inbox", help="print unread messages and mark them read"))
    p.add_argument("--peek", action="store_true", help="do not mark as read")
    p.add_argument("--all", action="store_true", help="include already-read messages")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_inbox)

    p = ident(sub.add_parser("ring", help="re-ring an agent that has unread messages"))
    p.add_argument("agent")
    p.set_defaults(func=cmd_ring)

    p = ident(sub.add_parser("status", help="agents of a run with live herdr state"))
    p.add_argument("run_id", nargs="?")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_status)

    p = ident(sub.add_parser("log", help="the run's events as a timeline (sends, nudges, alerts, swaps…)"))
    p.add_argument("run_id", nargs="?", help="a live or archived run (default: yours)")
    p.add_argument("--agent", help="only events naming this agent")
    p.add_argument("--lines", type=int, default=0, help="only the last N events (default: all)")
    p.add_argument("--follow", action="store_true", help="keep printing new events until the run stops")
    p.set_defaults(func=cmd_log)

    p = ident(sub.add_parser("watch", help="watchdog: exits when a child reports or stalls"))
    p.add_argument("agent", nargs="?")
    p.add_argument("--any", action="store_true", help="every live worker of the run: exit on the first event")
    p.add_argument("--alerts", action="store_true",
                   help="alerts only: keep watching through done/failed (for cross-session reports)")
    p.add_argument("--run-id")
    p.add_argument("--timeout", type=int, default=0, help="seconds (0 = none)")
    p.add_argument("--interval", type=float, default=5.0)
    p.add_argument("--grace", type=float, default=SETTLE_GRACE,
                   help="seconds a worker must stay idle before it counts as stopped (default %(default)s)")
    p.add_argument("--hang", type=float, default=None,
                   help="seconds a worker may read working with its transcript unchanged before exit 8 "
                        f"(default MESH_HANG_AFTER or {int(HANG_AFTER)}; 0 = never)")
    p.set_defaults(func=cmd_watch)

    p = ident(sub.add_parser("approve", help="approve a worker's plan, moving an auto worker to its exec model"))
    p.add_argument("agent")
    p.add_argument("--body", help="notes to go with the approval")
    p.add_argument("--file", help="notes from a file (- for stdin)")
    p.add_argument("--keep-model", action="store_true",
                   help="execute on the current model: for when the swap can't start (no conversation found, busy)")
    p.set_defaults(func=cmd_approve)

    p = ident(sub.add_parser("switch", help="move a worker that hit a quota to the next model with quota left"))
    p.add_argument("agent")
    p.add_argument("--model", help="this model instead of the next in the chain")
    p.set_defaults(func=cmd_switch)

    p = ident(sub.add_parser("retire", help="close a child's pane (its worktree stays)"))
    p.add_argument("agent")
    p.set_defaults(func=cmd_retire)
    p = sub.add_parser("retirer", help="internal: the run's retirer, which a worker's report starts")
    p.add_argument("--run", required=True)
    p.add_argument("--lock-fd", type=int, help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_retirer)

    p = sub.add_parser("agents", help="past and present workers of every run, with branches and PRs")
    p.add_argument("query", nargs="?", help="filter on name, repo, branch or PR link")
    p.add_argument("--run", help="only this run's workers, resumed ones included")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_agents)

    p = ident(sub.add_parser("resume", help="bring a past worker back, with its conversation, into this run"))
    p.add_argument("ref", help="the worker's name, branch or PR link (see `mesh agents`)")
    p.add_argument("--from-run", help="look only in this run (default: the newest match)")
    p.add_argument("--model", help="override the model it ran on (same CLI)")
    p.add_argument("--effort", choices=EFFORTS)
    p.add_argument("--task", help="the follow-up task")
    p.add_argument("--task-file", help="the follow-up task from a file (- for stdin)")
    compact_args(p)
    p.add_argument("--view", choices=VIEWS, help="reopen in a pane or in the background (default: as before)")
    p.set_defaults(func=cmd_resume)

    p = sub.add_parser("open", help="reopen a past worker's conversation in this terminal, outside the mesh")
    p.add_argument("ref", help="the worker's name, branch or PR link (see `mesh agents`)")
    p.add_argument("--from-run", help="look only in this run (default: the newest match)")
    p.add_argument("--model", help="override the model it ran on")
    p.add_argument("--effort", choices=EFFORTS)
    p.add_argument("extra", nargs=argparse.REMAINDER, help="after --: more arguments for the CLI")
    p.set_defaults(func=cmd_open)

    p = sub.add_parser("peek", help="show what a Copilot asker is doing: its latest tool calls and messages")
    p.add_argument("ref", help="the asker's name or branch (see `mesh agents`)")
    p.add_argument("--from-run", help="look only in this run (default: the newest match)")
    p.add_argument("--lines", type=int, default=15, help="how many past events to show (default: 15)")
    p.add_argument("--follow", action="store_true", help="keep printing new events until it stops answering")
    p.set_defaults(func=cmd_peek)

    p = ident(sub.add_parser("ask", help="ask a worker, or a fresh agent in a repo, a question or for a PR review, "
                                         "and wait for the answer"))
    p.add_argument("ref", nargs="?", help="an existing worker: name, branch or PR link (see `mesh agents`)")
    p.add_argument("--repo", help="start a fresh agent in this repo instead")
    p.add_argument("--review", metavar="PR", help="ask for a review of this PR (link, or number in --repo)")
    p.add_argument("--body", help="the question, or notes for the review")
    p.add_argument("--file", help="the question from a file (- for stdin)")
    p.add_argument("--kind", choices=ASK_KINDS,
                   help="a fresh agent's CLI (default: the run's mode, or agy); copilot runs headless, read-only")
    p.add_argument("--model", help="a fresh agent's model (default: auto), or a resumed worker's")
    p.add_argument("--effort", choices=EFFORTS,
                   help="default: the size's, or review.effort for a fresh reviewer (not Copilot; `mesh routing`)")
    p.add_argument("--name", help="what goes after the repo in a fresh agent's name (default: ask-<question>)")
    p.add_argument("--size", choices=SIZES, help="a fresh agent's size (see `mesh spawn --size`)")
    p.add_argument("--view", choices=VIEWS, help="a fresh or resumed agent's view")
    compact_args(p)
    p.add_argument("--no-wait", action="store_true", help="return once the task is delivered")
    p.add_argument("--keep", action="store_true",
                   help="leave the agent open after its answer (default: an agent this call opened is closed)")
    p.add_argument("--wait", action="store_true",
                   help="wait even for a Claude worker under a Claude root, answering by a cross-session message")
    p.add_argument("--timeout", type=int, default=1800, help="seconds to wait for the answer (0 = none)")
    p.add_argument("--reviewers", metavar="auto|all|KINDS",
                   help="with --repo and --review: run a review round, its reviewers picked by --size and agy's quota "
                        "(auto) or named (a comma list of claude, agy, copilot): one combined answers file")
    p.add_argument("--peers", metavar="all|GROUP|NAMES",
                   help="ask the peer askers at once (all, a group, or a comma list): one combined answer file")
    p.add_argument("--no-refresh", action="store_true", help="don't fetch a peer's upstream first")
    p.set_defaults(func=cmd_ask)

    p = ident(sub.add_parser("peers", help="the standing peer askers: list, add, refresh, remove"))
    p.add_argument("action", nargs="?", choices=("list", "add", "edit", "refresh", "remove"), default="list")
    p.add_argument("targets", nargs="*", help="add: a git URL or a clone's path; edit: a peer or a group; "
                                              "refresh, remove: peer names")
    p.add_argument("--about", help=f"add, edit: what the project (or group) is and what to ask it, at most "
                                   f"{ABOUT_MAX} characters (add's default: its GitHub description)")
    p.add_argument("--name", help="add: the asker's name (default: <repo>-research)")
    p.add_argument("--group", help="add, edit: a group to ask together (`mesh ask --peers <group>`; default: peers); "
                                   "a URL is cloned into $MESH_PEERS_DIR/<group> (default ~/research)")
    p.add_argument("--kind", choices=KINDS, help="add: a new asker's CLI (default: claude)")
    p.add_argument("--body", help="add: its first research brief, asked at once")
    p.add_argument("--file", help="add: the brief from a file (- for stdin)")
    p.add_argument("--size", choices=SIZES, help="add: the brief's size (default: large)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_peers)

    p = ident(sub.add_parser("worktree", help="create a run worktree, e.g. for integration"))
    p.add_argument("--repo", default=".")
    p.add_argument("--slug", required=True)
    p.add_argument("--base")
    p.set_defaults(func=cmd_worktree)

    p = ident(sub.add_parser("conflicts", help="which of the run's branches conflict with their base or each other, and which workers share files"))
    p.add_argument("run_id", nargs="?")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_conflicts)

    p = ident(sub.add_parser("stop", help="close the run's panes, remove clean worktrees, archive"))
    p.add_argument("run_id", nargs="?")
    p.add_argument("--keep-worktrees", action="store_true")
    p.set_defaults(func=cmd_stop)

    p = ident(sub.add_parser("whoami", help="this agent's run, name, role and parent"))
    p.add_argument("--reminder", nargs="?", const="manual", metavar="SOURCE",
                   help="print a reminder of who you are, your phase and your task instead (a SessionStart hook "
                        "passes compact, clear or resume)")
    p.set_defaults(func=cmd_whoami)
    p = ident(sub.add_parser("hook", help="a Claude worker's hook (Claude Code runs it)"))
    p.add_argument("event", choices=("stop",))
    p.set_defaults(func=cmd_hook)
    ident(sub.add_parser("dir", help="print the run directory")).set_defaults(func=cmd_dir)

    p = ident(sub.add_parser("reset", help="root only: once your turn ends, clear your own pane and point the "
                                           "fresh session at `mesh brief`"))
    p.add_argument("--next", help="what the fresh session does after `mesh brief` (default: the next step in "
                                  "notes.md)")
    p.add_argument("--compact", nargs="?", const="", metavar="FOCUS",
                   help="type /compact [FOCUS] instead of /clear: for a root with its own repo's work in flight")
    p.add_argument("--detached", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--via", default="command", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_reset)

    p = sub.add_parser("routing", help="this machine's policy (models, efforts, reviewers, rounds, reserve, folders), "
                                       "where each value comes from, and the installed CLIs")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_routing)

    p = ident(sub.add_parser("brief", help="one bounded view of the run for a fresh root: request, notes, board, "
                                           "workers, PRs, unread mail"))
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_brief)

    p = sub.add_parser("model", help="resolve the model a spawn would use")
    p.add_argument("--kind", choices=KINDS, help="default: as for spawn")
    p.add_argument("--model", help="default: auto")
    p.add_argument("--effort", choices=EFFORTS, help="default: the kind's plan_effort")
    p.set_defaults(func=cmd_model)

    p = sub.add_parser("usage", help="Claude's and agy's quotas, the reserve, and the models `auto` would plan and "
                                     "execute on")
    p.add_argument("--effort", choices=EFFORTS, help="planning effort (default: agy's plan_effort)")
    p.add_argument("--exec-effort", choices=EFFORTS, help="default: agy's exec_effort")
    p.add_argument("--refresh", action="store_true", help="skip the caches (agy's 5 minutes, Claude's 2)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_usage)

    p = ident(sub.add_parser("cost", help="spend per agent, kind and phase, from the session files"))
    p.add_argument("run_id", nargs="?", help="a run, live or archived (default: your own)")
    p.add_argument("--since", help="every session from then on (7d, 36h, or ISO: 2026-11-04)")
    p.add_argument("--until", help="the window's end (default: now)")
    p.add_argument("--agents", action="store_true", help="the per-agent table in window mode too")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_cost)

    p = ident(sub.add_parser("reserve", help="root only: let this run go on past the quota reserve (off), or hold "
                                             "it to the reserve again (on); no argument shows the quotas"))
    p.add_argument("state", nargs="?", choices=("off", "on"))
    p.set_defaults(func=cmd_reserve)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        check_worker(args)
        return args.func(args)
    except MeshError as exc:
        print(f"mesh: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
