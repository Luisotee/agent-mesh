# The agent-mesh daemon as a systemd user unit. `install.sh` copies it to ~/.config/systemd/user/ with
# agent-mesh-term.service, next to a drop-in (agent-mesh.service.d/path.conf) holding the installer's PATH, so the
# agents' CLIs are found. The state dir is ~/.local/state/agent-mesh-daemon.
[Unit]
Description=agent-mesh daemon (meshd)
Wants=agent-mesh-term.service
After=agent-mesh-term.service

[Service]
ExecStart=%h/.local/lib/agent-mesh/bin/meshd --state %S/agent-mesh-daemon --term-launch systemd --term-unit agent-mesh-term.service
Restart=on-failure
RestartSec=2
# Bounded shutdown: meshd ends its event streams and stops within a few seconds.
TimeoutStopSec=15

[Install]
WantedBy=default.target
