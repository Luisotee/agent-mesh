# The agent-mesh daemon as a systemd user unit. Shipped, not installed: `install.sh --daemon` (coming) copies it to ~/.config/systemd/user/
# with agent-mesh-term.service once the daemon replaces bin/mesh. The state dir is not the live mesh's
# (~/.local/state/agent-mesh) until the switchover.
[Unit]
Description=agent-mesh daemon (meshd)
Wants=agent-mesh-term.service
After=agent-mesh-term.service

[Service]
ExecStart=%h/.local/lib/agent-mesh/bin/meshd --state %S/agent-mesh-daemon --term-launch systemd --term-unit agent-mesh-term.service
Restart=on-failure
RestartSec=2
# Bounded shutdown: meshd ends its event streams and stops within a few seconds.
TimeoutStopSec=15

[Install]
WantedBy=default.target
