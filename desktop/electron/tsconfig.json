{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "outDir": "../dist-electron",
    "rootDir": "..",
    "types": ["node"]
  },
  "include": ["./**/*.ts", "./**/*.cts", "../shared/**/*.ts"],
  "exclude": ["./**/*.test.ts"]
}
