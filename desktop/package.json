{
  "name": "agent-mesh-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "agent-mesh desktop app",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "gen": "buf generate ../proto --template buf.gen.yaml",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json",
    "test": "vitest run",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "e2e": "scripts/e2e.sh",
    "start": "electron .",
    "pack": "node scripts/make-icons.mjs --app build/icon.png && pnpm build && electron-builder",
    "pack:dir": "node scripts/make-icons.mjs --app build/icon.png && pnpm build && electron-builder --dir",
    "pack:check": "node scripts/check-package.mjs",
    "pack:win": "node scripts/make-icons.mjs --app build/icon.png && pnpm build && electron-builder --win zip"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@bufbuild/protobuf": "^2.17.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.79.0",
    "motion": "^14.14.0",
    "playwright-core": "^1.65.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "4.6.0",
    "streamdown": "2.8.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "author": "agent-mesh developers",
  "homepage": "https://github.com/Luisotee/agent-mesh",
  "desktopName": "agent-mesh-desktop.desktop"
}
